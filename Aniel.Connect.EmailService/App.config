<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>
  <appSettings>
    <add key="horaExecucaoInicio" value="00:00:00" />
    <add key="horaExecucaoFim" value="22:00:00" />
    <add key="intervaloMinutos" value="1" />
    <add key="Assemblys.Map" value="Sinapse.DAO;Aniel.Connect.DAO" />
    <add key="Assemblys.MapLog" value="Sinapse.DAOLog;Aniel.Connect.DAOLog" />
    <add key="Assemblys.T5" value="Sinapse.T5.DAO;Aniel.T5.DAO" />
    
    <add key="CaminhoFisico" value="D:\Checkouts\ProjetosWeb\AnielConnect\Aniel.Connect.EmailService\bin\Debug" />
    <add key="CaminhoFisicoConnect" value="D:\Checkouts\ProjetosWeb\AnielConnect\Aniel.Connect" />
    <add key="UrlConnectAPI" value="http://localhost/Aniel.ConnectAPI" />
    <add key="UrlPortalConnect" value="http://localhost/Aniel.Connect" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />

 
    <add key="IMPORTAR_ATENDIMENTO" value="N" />
    <add key="IMPORTAR_OSDIGITAL" value="S" />
    <add key="Assemblys.Foto" value="Aniel.Foto.DAO" />
    <add key="IMPORTAR_OSDIGITAL_APENASDATA" value="N" />
    <add key="EMAILS_OSDIGITAL" value="[          {'OSDIGITAL_SERVIDORIMAP' : 'imap.grupoeletronet.com.br','OSDIGITAL_EMAIL' : 'iqi.fraeletronet@grupoeletronet.com.br','OSDIGITAL_SENHA' : 'Eletro@2709','OSDIGITAL_PORTA' : '993','OSDIGITAL_USASSL' : 'S','IMPORTAR_ATENDIMENTO' : 'N','IMPORTAR_OSDIGITAL' : 'S' },          {'OSDIGITAL_SERVIDORIMAP' : 'imap.grupoeletronet.com.br','OSDIGITAL_EMAIL' : 'iqi.ribeletronet@grupoeletronet.com.br','OSDIGITAL_SENHA' : 'Eletro@2709','OSDIGITAL_PORTA' : '993','OSDIGITAL_USASSL' : 'S','IMPORTAR_ATENDIMENTO' : 'N','IMPORTAR_OSDIGITAL' : 'S' },          {'OSDIGITAL_SERVIDORIMAP' : 'imap.grupoeletronet.com.br','OSDIGITAL_EMAIL' : 'iqi.srreletronet@grupoeletronet.com.br','OSDIGITAL_SENHA' : 'Eletro@2709','OSDIGITAL_PORTA' : '993','OSDIGITAL_USASSL' : 'S','IMPORTAR_ATENDIMENTO' : 'N','IMPORTAR_OSDIGITAL' : 'S' }     ]" />


  </appSettings>
  <log4net xsi:noNamespaceSchemaLocation="http://csharptest.net/downloads/schema/log4net.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <!-- loggers-->
    <logger name="Aniel.Connect.EmailService">
      <level value="ALL" />
      <appender-ref ref="LogErro" />
    </logger>
    <appender name="LogErro" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogErro.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; [%t]; %-5p; %c; %m%n" />
      </layout>
    </appender>
  </log4net>
