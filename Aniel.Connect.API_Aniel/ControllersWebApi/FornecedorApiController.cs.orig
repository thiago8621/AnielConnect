using Aniel.Connect.API_Aniel.Models;
using Aniel.Connect.Core;
using Aniel.T5.Model.nhibernate;
using NHibernate;
using Sinapse.DAO.repository;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Web.Http;

namespace Aniel.Connect.API_Aniel.ControllersWebApi
{
    public class FornecedorApiController : BaseApiController
    {
        /// <summary>
        /// Retorna a Listagem de Fornecedores dentro do Aniel 
        /// </summary>
        /// <param name="request"></param>
        /// <returns></returns>
        [HttpPost]
        [Route("api/FornecedorApi/GetAll")]
        public async Task<ApiResponse<FornecedorListaModel>> GetAll(ApiRequest request)
        {
            List<FornecedorListaModel> retorno = new List<FornecedorListaModel>();
            try
            {
                using (var api = new UsuarioApiController())
                {
                    if (!(await api.GetUsuarioValido(request.settings)).Ok)
                    {
                        throw new Exception("Usuário e/ou Senha e/ou Token Invalidos");
                    }
                }

                using (ISession sessionT5 = HibernateUtil.GetSessionT5())
                {
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    using (var com = sessionT5.Connection.CreateCommand())
                    {

                        #region Sql

                        StringBuilder sql = new StringBuilder();
                        sql.AppendLine("  SELECT * FROM TB_FORNECEDOR ");


                        #endregion

                        using (var reader = await CommandHelper.ExecuteReaderFirst(com, sql, parametros, sessionT5.Connection, null, request.settings.length, request.settings.start))
                        {
                            while (await reader.ReadAsync())
                            {
                                retorno.Add(new FornecedorListaModel
                                {
                                    Cod_Fornecedor = reader["COD_FORNECEDOR"] == DBNull.Value ? "" : Convert.ToString(reader["COD_FORNECEDOR"]),
                                    Cnpj = !String.IsNullOrEmpty(Convert.ToString(reader["CNPJ"])) ? Convert.ToString(reader["CNPJ"]) : "-",
                                    Fornecedor = !String.IsNullOrEmpty(Convert.ToString(reader["FORNECEDOR"])) ? Convert.ToString(reader["FORNECEDOR"]) : "-",
                                    Razao_Social = !String.IsNullOrEmpty(Convert.ToString(reader["RAZAO_SOCIAL"])) ? Convert.ToString(reader["RAZAO_SOCIAL"]) : "-",
                                    Endereco = !String.IsNullOrEmpty(Convert.ToString(reader["ENDERECO"])) ? Convert.ToString(reader["ENDERECO"]) : "-",
                                    Bairro = !String.IsNullOrEmpty(Convert.ToString(reader["BAIRRO"])) ? Convert.ToString(reader["BAIRRO"]) : "-",
                                    Municipio = !String.IsNullOrEmpty(Convert.ToString(reader["MUNICIPIO"])) ? Convert.ToString(reader["MUNICIPIO"]) : "-",
                                    Cep = !String.IsNullOrEmpty(Convert.ToString(reader["CEP"])) ? Convert.ToString(reader["CEP"]) : "-",
                                    Uf = !String.IsNullOrEmpty(Convert.ToString(reader["UF"])) ? Convert.ToString(reader["UF"]) : "-",
                                    Pais = !String.IsNullOrEmpty(Convert.ToString(reader["PAIS"])) ? Convert.ToString(reader["PAIS"]) : "-",
                                    Telefone = !String.IsNullOrEmpty(Convert.ToString(reader["TELEFONE"])) ? Convert.ToString(reader["TELEFONE"]) : "-",
                                    Telefone2 = !String.IsNullOrEmpty(Convert.ToString(reader["TELEFONE2"])) ? Convert.ToString(reader["TELEFONE2"]) : "-",
                                    Telefone3 = !String.IsNullOrEmpty(Convert.ToString(reader["TELEFONE3"])) ? Convert.ToString(reader["TELEFONE3"]) : "-",
                                    Telefone4 = !String.IsNullOrEmpty(Convert.ToString(reader["TELEFONE4"])) ? Convert.ToString(reader["TELEFONE4"]) : "-",
                                    Fax = !String.IsNullOrEmpty(Convert.ToString(reader["FAX"])) ? Convert.ToString(reader["FAX"]) : "-",
                                    Contato = !String.IsNullOrEmpty(Convert.ToString(reader["CONTATO"])) ? Convert.ToString(reader["CONTATO"]) : "-",
                                    Contato2 = !String.IsNullOrEmpty(Convert.ToString(reader["CONTATO2"])) ? Convert.ToString(reader["CONTATO2"]) : "-",
                                    Insc_Municipal = !String.IsNullOrEmpty(Convert.ToString(reader["INSC_MUNICIPAL"])) ? Convert.ToString(reader["INSC_MUNICIPAL"]) : "-",
                                    Observacao = !String.IsNullOrEmpty(Convert.ToString(reader["OBSERVACAO"])) ? Convert.ToString(reader["OBSERVACAO"]) : "-",
                                    Complemento = !String.IsNullOrEmpty(Convert.ToString(reader["COMPLEMENTO"])) ? Convert.ToString(reader["COMPLEMENTO"]) : "-",
                                    Celular = !String.IsNullOrEmpty(Convert.ToString(reader["CELULAR"])) ? Convert.ToString(reader["CELULAR"]) : "-",
                                    Celular2 = !String.IsNullOrEmpty(Convert.ToString(reader["CELULAR2"])) ? Convert.ToString(reader["CELULAR2"]) : "-",
                                    Site = !String.IsNullOrEmpty(Convert.ToString(reader["SITE"])) ? Convert.ToString(reader["SITE"]) : "-",
                                    Historico = !String.IsNullOrEmpty(Convert.ToString(reader["HISTORICO"])) ? Convert.ToString(reader["HISTORICO"]) : "-",
                                    Banco = !String.IsNullOrEmpty(Convert.ToString(reader["BANCO"])) ? Convert.ToString(reader["BANCO"]) : "-",
                                    Agencia = !String.IsNullOrEmpty(Convert.ToString(reader["AGENCIA"])) ? Convert.ToString(reader["AGENCIA"]) : "-",
                                    Conta = !String.IsNullOrEmpty(Convert.ToString(reader["CONTA"])) ? Convert.ToString(reader["CONTA"]) : "-",
                                    Micro_Empresa = !String.IsNullOrEmpty(Convert.ToString(reader["MICRO_EMPRESA"])) ? Convert.ToString(reader["MICRO_EMPRESA"]) : "-",
                                    Cod_Atividade = !String.IsNullOrEmpty(Convert.ToString(reader["COD_ATIVIDADE"])) ? Convert.ToString(reader["COD_ATIVIDADE"]) : "-",
                                    Tipo = !String.IsNullOrEmpty(Convert.ToString(reader["TIPO"])) ? Convert.ToString(reader["TIPO"]) : "-",
                                    Opcao_Func = !String.IsNullOrEmpty(Convert.ToString(reader["OPCAO_FUNC"])) ? Convert.ToString(reader["OPCAO_FUNC"]) : "-",
                                    Integracao = !String.IsNullOrEmpty(Convert.ToString(reader["INTEGRACAO"])) ? Convert.ToString(reader["INTEGRACAO"]) : "-",
                                    Conta_Contabil = !String.IsNullOrEmpty(Convert.ToString(reader["CONTA_CONTABIL"])) ? Convert.ToString(reader["CONTA_CONTABIL"]) : "-",
                                    Codaux_For = !String.IsNullOrEmpty(Convert.ToString(reader["CODAUX_FOR"])) ? Convert.ToString(reader["CODAUX_FOR"]) : "-",
                                    Usuario_Criacao = !String.IsNullOrEmpty(Convert.ToString(reader["USUARIO_CRIACAO"])) ? Convert.ToString(reader["USUARIO_CRIACAO"]) : "-",
                                    Data_Cadastro = !String.IsNullOrEmpty(Convert.ToString(reader["DATA_CADASTRO"])) ? Convert.ToString(reader["DATA_CADASTRO"]) : "-",
                                    Hora_Criacao = !String.IsNullOrEmpty(Convert.ToString(reader["HORA_CRIACAO"])) ? Convert.ToString(reader["HORA_CRIACAO"]) : "-",
                                    Usuario_Alteracao = !String.IsNullOrEmpty(Convert.ToString(reader["USUARIO_ALTERACAO"])) ? Convert.ToString(reader["USUARIO_ALTERACAO"]) : "-",
                                    Data_Alteracao = !String.IsNullOrEmpty(Convert.ToString(reader["DATA_ALTERACAO"])) ? Convert.ToString(reader["DATA_ALTERACAO"]) : "-",
                                    Hora_Alteracao = !String.IsNullOrEmpty(Convert.ToString(reader["HORA_ALTERACAO"])) ? Convert.ToString(reader["HORA_ALTERACAO"]) : "-",
                                    Situacao = !String.IsNullOrEmpty(Convert.ToString(reader["SITUACAO"])) ? Convert.ToString(reader["SITUACAO"]) : "-",
                                    Data_Inativo = !String.IsNullOrEmpty(Convert.ToString(reader["DATA_INATIVO"])) ? Convert.ToString(reader["DATA_INATIVO"]) : "-",
                                    NF_Parcial = !String.IsNullOrEmpty(Convert.ToString(reader["NF_PARCIAL"])) ? Convert.ToString(reader["NF_PARCIAL"]) : "-",
                                    Responsavel_Fornecedor = !String.IsNullOrEmpty(Convert.ToString(reader["RESPONSAVEL_FORNECEDOR"])) ? Convert.ToString(reader["RESPONSAVEL_FORNECEDOR"]) : "-",
                                    Situacao_Integra = !String.IsNullOrEmpty(Convert.ToString(reader["SITUACAO_INTEGRA"])) ? Convert.ToString(reader["SITUACAO_INTEGRA"]) : "-",
                                    Id_Municipio = !String.IsNullOrEmpty(Convert.ToString(reader["ID_MUNICIPIO"])) ? Convert.ToString(reader["ID_MUNICIPIO"]) : "-",
                                    Endereco_Numero = !String.IsNullOrEmpty(Convert.ToString(reader["ENDERECO_NUMERO"])) ? Convert.ToString(reader["ENDERECO_NUMERO"]) : "-",
                                    UsuarioCriacao = !String.IsNullOrEmpty(Convert.ToString(reader["USUARIOCRIACAO"])) ? Convert.ToString(reader["USUARIOCRIACAO"]) : "-",
                                    DataHora_Criacao = !String.IsNullOrEmpty(Convert.ToString(reader["DATAHORACRIACAO"])) ? Convert.ToString(reader["DATAHORACRIACAO"]) : "-",
                                    UsuarioAlteracao = !String.IsNullOrEmpty(Convert.ToString(reader["USUARIOALTERACAO"])) ? Convert.ToString(reader["USUARIOALTERACAO"]) : "-",
                                    DataHora_Alteracao = !String.IsNullOrEmpty(Convert.ToString(reader["DATAHORAALTERACAO"])) ? Convert.ToString(reader["DATAHORAALTERACAO"]) : "-",
                                    Token = !String.IsNullOrEmpty(Convert.ToString(reader["TOKEN"])) ? Convert.ToString(reader["TOKEN"]) : "-",
                                    Descricao = !String.IsNullOrEmpty(Convert.ToString(reader["DESCRICAO"])) ? Convert.ToString(reader["DESCRICAO"]) : "-",
                                    Numero = !String.IsNullOrEmpty(Convert.ToString(reader["NUMERO"])) ? Convert.ToString(reader["NUMERO"]) : "-",
                                    Email = !String.IsNullOrEmpty(Convert.ToString(reader["EMAIL"])) ? Convert.ToString(reader["EMAIL"]) : "-",
                                    Iso9000 = !String.IsNullOrEmpty(Convert.ToString(reader["ISO9000"])) ? Convert.ToString(reader["ISO9000"]) : "-",
                                });
                            }
                        }
                    }

                }

                return new ApiResponse<FornecedorListaModel>()
                {
                    draw = request.settings.length,
                    recordsFiltered = retorno.Count,
                    data = retorno,
                    error = ""
                };

            }
            catch (Exception e)
            {
                return new ApiResponse<FornecedorListaModel>()
                {
                    draw = request.settings.length,
                    recordsFiltered = retorno.Count,
                    data = retorno,
                    error = e.Message
                };
            }
        }

        /// <summary>
        /// Grava ou atualiza um Fornecedor 
        /// </summary>
        /// <param name="request"></param>
        /// <returns></returns>
        [HttpPost]
        [Route("api/FornecedorApi/GravarFornecedor")]
        public async Task<ApiResponse<FornecedorListaModel>> GravarFornecedor(ForncedorCadastroModel request)
        {
            List<FornecedorListaModel> retorno = new List<FornecedorListaModel>();

            try
            {
                using (var api = new UsuarioApiController())
                {
                    if (!(await api.GetUsuarioValido(request.settings)).Ok)
                    {
                        throw new Exception("Usuário e/ou Senha e/ou Token Invalidos");
                    }
                }

                if (string.IsNullOrEmpty(request.Cnpj))
                {
                    throw new Exception("CNPJ é obrigatório");
                }

                using (ISession sessionT5 = HibernateUtil.GetSessionT5())
                using (var repoFornecedor = new Conexao<Fornecedor>(sessionT5))
                {

                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    IList<Fornecedor> fornecedorBancoLista = await repoFornecedor.select(x => x.Cnpj == request.Cnpj);

                    Fornecedor fornecedorBanco;

                    if (fornecedorBancoLista.Count == 0)
                    {
                        fornecedorBanco = new Fornecedor();
                    }
                    else
                    {
                        fornecedorBanco = fornecedorBancoLista.First();
                    }

                    if (fornecedorBancoLista.Count == 0)
                    {
                        if (string.IsNullOrEmpty(request.Cod_Fornecedor))
                        {
                            throw new Exception("Código do fornecedor é obrigatório");
                        }

                        fornecedorBanco.Cod_Fornecedor = request.Cod_Fornecedor;
                    }


                    #region BindModel

                    fornecedorBanco.Bairro = fornecedorBanco.Bairro;
                    fornecedorBanco.Cep = request.Cep;
                    fornecedorBanco.Cnpj = request.Cnpj;
                    fornecedorBanco.Complemento = request.Complemento;
                    fornecedorBanco.Descricao = request.Descricao;
                    fornecedorBanco.Email = request.Email;
                    fornecedorBanco.Endereco = request.Endereco;
                    fornecedorBanco.fornecedor = request.fornecedor;
                    fornecedorBanco.Insc_Estadual = request.Insc_Estadual;
                    fornecedorBanco.Municipio = request.Municipio;
                    fornecedorBanco.Numero = request.Numero;
                    fornecedorBanco.Pais = request.Pais;
                    fornecedorBanco.RazaoSocial = request.RazaoSocial;
                    fornecedorBanco.Telefone = request.Telefone;
                    fornecedorBanco.Uf = request.Uf;

                    #endregion

                    await repoFornecedor.SaveOrUpdate(fornecedorBanco);



                    return new ApiResponse<FornecedorListaModel>()
                    {
                        draw = request.settings.length,
                        data = retorno,
                        error = ""
                    };
                }
            }


            catch (Exception e)
            {

                return new ApiResponse<FornecedorListaModel>()
                {
                    draw = request.settings.length,
                    data = retorno,
                    error = e.Message
                };
            }
        }

    }
}



