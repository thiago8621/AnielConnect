  <!-- Log4Net Início -->
  <log4net noNamespaceSchemaLocation="http://csharptest.net/downloads/schema/log4net.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <!-- loggers-->
    <logger name="Aniel.Connect.API_Aniel">
      <level value="ERROR" />
      <appender-ref ref="LogErro" />
    </logger>
    <logger name="Aniel.Connect.API_Aniel.IXC">
      <level value="ERROR" />
      <appender-ref ref="LogIXC" />
    </logger>
    <logger name="Aniel.Connect.API_Aniel.IManager">
      <level value="ERROR" />
      <appender-ref ref="LogIManager" />
    </logger>
	  <logger name="Aniel.Connect.API_Aniel.Voalle">
		  <level value="ERROR" />
		  <appender-ref ref="LogVoalle" />
	  </logger>
    <logger name="Aniel.Connect.API_Aniel.INFO">
      <level value="INFO" />
      <appender-ref ref="LogInfo" />
    </logger>
    <logger name="NHibernate">
      <level value="ERROR" />
      <appender-ref ref="LogSql" />
    </logger>
    <logger name="Sinapse">
      <level value="ERROR" />
      <appender-ref ref="LogErro" />
    </logger>
    <appender name="LogErro" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogErro.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    </appender>
    <appender name="LogSql" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogSql.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    </appender>
    <appender name="LogIXC" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogIXC.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    </appender>
    <appender name="LogIManager" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogIManager.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    </appender>
	  <appender name="LogIManager" type="log4net.Appender.RollingFileAppender">
		  <param name="File" value="log/LogVoalle.log" />
		  <appendToFile value="true" />
		  <rollingStyle value="Composite" />
		  <datePattern value="yyyyMMdd" />
		  <maxSizeRollBackups value="10" />
		  <maximumFileSize value="10MB" />
		  <layout type="log4net.Layout.PatternLayout">
			  <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
		  </layout>
		  <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
	  </appender>
	  <appender name="LogInfo" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogInfo.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    </appender>
	  <appender name="LogGeoGrid" type="log4net.Appender.RollingFileAppender">
		  <param name="File" value="log/LogGeoGrid.log" />
		  <appendToFile value="true" />
		  <rollingStyle value="Composite" />
		  <datePattern value="yyyyMMdd" />
		  <maxSizeRollBackups value="10" />
		  <maximumFileSize value="10MB" />
		  <layout type="log4net.Layout.PatternLayout">
			  <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
		  </layout>
		  <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
	  </appender>
  </log4net>
