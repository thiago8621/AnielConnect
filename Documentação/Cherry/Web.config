  <!-- Log4Net Início -->
  <log4net noNamespaceSchemaLocation="http://csharptest.net/downloads/schema/log4net.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <!-- loggers-->
    <logger name="NHibernate">
      <level value="ALL" />
      <appender-ref ref="LogSql" />
    </logger>
    <logger name="Aniel.Cherry">
      <level value="ALL" />
      <appender-ref ref="LogErro" />
    </logger>
    <appender name="LogRequest" type="log4net.Appender.RollingFileAppender">
      <file value="log/LogsRequest.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; [%t]; %-5p; %c; %m%n" />
      </layout>
    </appender>
    <appender name="LogFileAppender" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogsAppp.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
    </appender>
    <appender name="LogFileAppenderDal" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogsApppDal.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
    </appender>
    <appender name="LogErros" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogErros.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
    </appender>
    <appender name="LogErro" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogErro.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
    </appender>
    <appender name="LogSql" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogSql.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
    </appender>
    <appender name="DebugSQL" type="log4net.Appender.DebugAppender">
      <immediateFlush value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%logger - %message%newline" />
      </layout>
    </appender>
  </log4net>
</configuration>