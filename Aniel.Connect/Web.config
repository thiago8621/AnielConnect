<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="owin:appStartup" value="AnielConnectConfig" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />  
    <add key="Assemblys.Map" value="Sinapse.DAO;Aniel.Connect.DAO" />
    <add key="Assemblys.MapLog" value="Sinapse.DAOLog;Aniel.Connect.DAOLog" />
    <add key="Assemblys.Radius" value="Aniel.Radius.DAO" />
    <add key="Assemblys.T5" value="Sinapse.T5.DAO;Aniel.T5.DAO" />
    <add key="Assemblys.Foto" value="Aniel.Foto.DAO" />
    <add key="CaminhoFisico" value="D:\Checkouts\AnielConnect\Aniel.Connect" />
    <add key="URLPortal" value="http://localhost/Aniel.Connect" />
    <add key="URLPortalFinanceiro" value="http://10.128.0.10/3050/home/ISP/Web/Aniel.EVA" />
    <add key="PaginacaoRegistros" value="10" />
    <add key="SIGLA_MODULO" value="CONNECT" />
    <add key="TrataErro" value="N" />
    <add key="CHANGELOG" value="S" />
    <add key="CaminhoProjetoTouch" value="http://192.168.0.7:8888/AnielTouchRepresentantesTeste/AnielTV.Touch.WebApi" />
    <add key="CaminhoProjetoWebApi" value="http://192.168.0.7:8888/AnielTouchRepresentantesTeste/AnielTV.Touch.WebApi" />
    <add key="URLROUTE" value="http://router.project-osrm.org/route/v1/driving/" />
    


		<add key="Email_De" value="aniel@sinapseinformatica.com.br" />
		<add key="Email_Smtp" value="smtp.sinapseinformatica.com.br" />
		<add key="Email_Senha" value="S1n4ps#@2019" />
		<add key="Email_Porta" value="587" />
	<add key="Email_UsaSsl" value="N" />
		<add key="EnableOptimizations" value="N" />

	</appSettings>
	<system.web>
		<customErrors mode="Off" />
		<authentication mode="Forms">
			<forms loginUrl="/Account/Login" name=".ASPXFORMSAUTH" protection="All" path="/" domain="sinapseinformatica.com.br" timeout="30" />
		</authentication>
		<!-- Validation and decryption keys must exactly match and cannot
         be set to "AutoGenerate". The validation and decryption
         algorithms must also be the same. -->
		<machineKey validationKey="C50B3C89CB21F4F1422FF158A5B42D0E8DB8CB5CDA1742572A487D9401E3400267682B202B746511891C1BAF47F8D25C07F6C39A104696DB51F17C529AD3CABE" decryptionKey="8A9BE8FD67AF6979E7D20198CFEA50DD3D3799C77AF2B72F" validation="SHA1" />
    <compilation debug="true" targetFramework="4.6.2" />
    <httpRuntime targetFramework="4.6.2" maxRequestLength="104857600" executionTimeout="900000" appRequestQueueLimit="100" />
    <globalization
      fileEncoding="utf-8"
      requestEncoding="utf-8"
      responseEncoding="utf-8" />
  </system.web>


	<system.web.extensions>
		<scripting>
			<webServices>
				<jsonSerialization maxJsonLength="999999999" />
			</webServices>
		</scripting>
	</system.web.extensions>
	<system.webServer>
		<urlCompression doStaticCompression="true" doDynamicCompression="true" dynamicCompressionBeforeCache="true" />
		<modules>
			<remove name="FormsAuthentication" />
		</modules>
		<handlers>
			<remove name="ExtensionlessUrlHandler-Integrated-4.0" />
			<remove name="OPTIONSVerbHandler" />
			<remove name="TRACEVerbHandler" />
			<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
		</handlers>
		<security>
			<requestFiltering>
				<requestLimits maxAllowedContentLength="104857600" maxQueryString="65536" maxUrl="2097151" />
				<hiddenSegments>
					<remove segment="bin"></remove>
				</hiddenSegments>
			</requestFiltering>
		</security>
		<httpProtocol>
			<customHeaders>

			</customHeaders>
		</httpProtocol>
		<caching>
			<profiles>
				<!--<add extension=".js" kernelCachePolicy="DontCache" policy="DontCache" />
        <add extension=".css" kernelCachePolicy="DontCache" policy="DontCache" />
        <add extension=".cshtml" kernelCachePolicy="DontCache" policy="DontCache" />-->
			</profiles>
		</caching>
