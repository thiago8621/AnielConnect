	<!-- Log4Net Início -->
	<log4net noNamespaceSchemaLocation="http://csharptest.net/downloads/schema/log4net.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
		<!-- loggers-->
		<logger name="Aniel.Connect">
			<level value="ERROR" />
			<appender-ref ref="LogErro" />
		</logger>
		<logger name="NHibernate">
			<level value="ERROR" />
			<appender-ref ref="LogSql" />
		</logger>
		<logger name="Sinapse">
			<level value="ERROR" />
			<appender-ref ref="LogErro" />
		</logger>
		<appender name="LogErro" type="log4net.Appender.RollingFileAppender">
			<param name="File" value="log/LogErro.log" />
			<appendToFile value="true" />
			<rollingStyle value="Composite" />
			<datePattern value="yyyyMMdd" />
			<maxSizeRollBackups value="10" />
			<maximumFileSize value="10MB" />
			<layout type="log4net.Layout.PatternLayout">
				<param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
			</layout>
			<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
		</appender>
		<appender name="LogSql" type="log4net.Appender.RollingFileAppender">
			<param name="File" value="log/LogSql.log" />
			<appendToFile value="true" />
			<rollingStyle value="Composite" />
			<datePattern value="yyyyMMdd" />
			<maxSizeRollBackups value="10" />
			<maximumFileSize value="10MB" />
			<layout type="log4net.Layout.PatternLayout">
				<param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
			</layout>
			<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
		</appender>

	  <logger name="Comercial">
		  <level value="ERROR" />
		  <appender-ref ref="LogErro" />
	  </logger>
	  <appender name="Comercial" type="log4net.Appender.RollingFileAppender">
		  <param name="File" value="log/LogComercial.log" />
		  <appendToFile value="true" />
		  <rollingStyle value="Composite" />
		  <datePattern value="yyyyMMdd" />
		  <maxSizeRollBackups value="10" />
		  <maximumFileSize value="1024MB" />
		  <layout type="log4net.Layout.PatternLayout">
			  <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
		  </layout>
		  <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
	  </appender>

    <logger name="Aniel.Connect.Tasks">
      <level value="ALL" />
      <appender-ref ref="LogHangfire" />
    </logger>
    <appender name="LogHangfire" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogHangfire.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; [%t]; %p; %m%n" />
      </layout>
    </appender>

    <logger name="IntegracaoOLT">
      <level value="INFO" />
      <appender-ref ref="LogIntegracaoOLT" />
    </logger>
    <appender name="LogIntegracaoOLT" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogIntegracaoOLT.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    </appender>
	  <httpRuntime requestValidationMode="2.0" />
  </log4net>
</configuration>
