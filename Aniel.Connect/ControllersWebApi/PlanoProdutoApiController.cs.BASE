        private async Task BindViewToObjLogin(ISession session, LoginRadius objBanco, AlterarLoginRadiusViewModel view)
        {
            using (var repository = new Conexao<LoginRadius>(session))
            using (var repoPlanoProduto = new Conexao<Cliente_PlanoProduto>(session))
            using (var repoConcentradora = new Conexao<Concentradora>(session))
            using (var repoPoolIp = new Conexao<Pool_Ip>(session))
            {
                objBanco.Status = Status_Default.Ativo;

                if (objBanco.Id == 0)
                {
                    var loginExiste = repository.selectFirst(p => p.Login == view.Login).Result != null;

                    if (loginExiste)
                        throw new Exception("O login informado já foi cadastrado");
                    else
                        objBanco.Login = view.Login;
                }
                else
                {
                    objBanco.Login = view.Login;
                }

                objBanco.SenhaPPPOE = view.Senha;

                objBanco.VLAN = view.VLAN;
                objBanco.Concentradora = await repoConcentradora.selectFirst(p => p.Id == view.IdConcentradora);

                var planoProduto = await repoPlanoProduto.selectFirst(p => p.Id == view.IdPlanoProduto);

                if (view.IdPool.HasValue)
                {
                    planoProduto.Pool_Ip = await repoPoolIp.selectFirst(p => p.Id == view.IdPool);
                    await repoPlanoProduto.SaveOrUpdate(planoProduto);
                }

                objBanco.Cliente_PlanoProduto = planoProduto;
                objBanco.Cliente = objBanco.Cliente_PlanoProduto.Cliente;
            }
        }

        [HttpGet()]
        [Route("api/PlanoProdutoApi/GetListByCampanha")]
        public async Task<GetApiRetorno<List<PlanoProdutoListModel>>> GetListByCampanha(Int64 Id_Campanha)
        {
            GetApiRetorno<List<PlanoProdutoListModel>> retorno = new GetApiRetorno<List<PlanoProdutoListModel>>
            {
                Objeto = new List<PlanoProdutoListModel>()
            };

            using (ISession session = HibernateUtil.GetSession())
            using (var repoCampanha_PlanoProduto = new Conexao<Campanha_PlanoProduto>(session))
            using (var repoPlano = new Conexao<Plano>(session))
            using (var repoProduto = new Conexao<Produto>(session))
            {
                try
                {
                    var listaCampanha = await repoCampanha_PlanoProduto.queryover().Where(p => p.Campanha.Id == Id_Campanha).ListAsync();

                    var listaPlanos = await repoPlano.queryover().Where(p => p.SituacaoPlano == Situacao_plano.Ativo).ListAsync();
                    var listaProdutos = await repoProduto.queryover().Where(p => p.Situacao == Situacao_Produto.Ativo).ListAsync();

                    List<Plano> planosFiltrados = new List<Plano>();
                    List<Produto> produtosFiltrados = new List<Produto>();

                    foreach (var campanha in listaCampanha)
                    {
                        if (campanha.Plano != null)
                        {
                            planosFiltrados.AddRange(listaPlanos.Where(p => p.Id == campanha.Plano.Id).ToList());

                            foreach (var plano in planosFiltrados)
                            {
                                retorno.Objeto.Add(new PlanoProdutoListModel
                                {
                                    Id = plano.Id,
                                    Descricao = plano.Descricao,
                                    Codigo = plano.Codigo,
                                    ValorPlanoProduto = Convert.ToString(plano.ValorPlano),
                                    AutenticacaoRadius = plano.AutenticacaoRadius ? Resources.RsBase.SIM : Resources.RsBase.NAO,
                                    ValorInstalacao = Convert.ToString(plano.ValorInstalacao),
                                    Tipo = PlanoProdutoEnum.Plano,
                                    //Informações Presentes no Modelo de Contrato
                                    //Teste_Gratis = plano.TesteGratis,
                                    //Qtde_Dias = plano.DiasTeste,
                                    Periodo_Carencia = plano.Periodo_Carencia,
                                    Meses_Carencia = plano.Modelo_Contrato?.Periodo_Carencia,
                                    Numero_Parcelas = plano.QtdParcelas,
                                    Id_Campanha = campanha.Campanha.Id,
                                    Id_Modelo_Contrato = plano.Modelo_Contrato?.Id,

                                    Detalhes = plano.DetalhesPlano,
                                    VelocidadeDownload = plano.VelocidadeDownload,
                                    VelocidadeDownloadReduzida = plano.VelocidadeDownloadReduzida,
                                    VelocidadeUpload = plano.VelocidadeUpload,
                                    Id_Tecnologia = plano.Tecnologia.Id,
                                    VelocidadeUploadReduzida = plano.VelocidadeUploadReduzida,
                                    VelocidadeNominal = plano.VelocidadeNominal
                                });
                            }

                            planosFiltrados.RemoveRange(0, planosFiltrados.Count);
                        }

                        if (campanha.Produto != null)
                        {
                            produtosFiltrados.AddRange(listaProdutos.Where(p => p.Id == campanha.Produto.Id).ToList());


                            foreach (var produto in produtosFiltrados)
                            {
                                retorno.Objeto.Add(new PlanoProdutoListModel
                                {
                                    Id = produto.Id,
                                    Descricao = produto.Descricao,
                                    Codigo = produto.Codigo,
                                    ValorPlanoProduto = Convert.ToString(produto.ValorProduto),
                                    ValorInstalacao = null,
                                    Tipo = PlanoProdutoEnum.Produto,
                                    Id_Campanha = campanha.Campanha.Id,
                                    Id_Modelo_Contrato = produto.ModeloContratoProduto?.Id,

                                    Detalhes = produto.Detalhes
                                });
                            }

                            produtosFiltrados.RemoveRange(0, produtosFiltrados.Count);
                        }

                    }



                    //retorno.Objeto.AddRange(listaPlanos.Select(p => new PlanoProdutoListModel
                    //{
                    //    Id = p.Id,
                    //    Descricao = p.Descricao,
                    //    Codigo = p.Codigo,
                    //    ValorPlanoProduto = Convert.ToString(p.ValorPlano),
                    //    AutenticacaoRadius = p.AutenticacaoRadius,
                    //    ValorInstalacao = Convert.ToString(p.ValorInstalacao),
                    //    Tipo = PlanoProdutoEnum.Plano,
                    //    Teste_Gratis = p.TesteGratis,
                    //    Qtde_Dias = p.DiasTeste,
                    //    Periodo_Carencia = p.Modelo_Contrato == null ? false : p.Modelo_Contrato.Tem_Carencia,
                    //    Meses_Carencia = p.Modelo_Contrato?.Periodo_Carencia,
                    //    Numero_Parcelas = p.QtdParcelas,
                    //    Id_Campanha = new Conexao<Campanha_PlanoProduto>(session).selectFirst(u => u.Plano.Id == p.Id).Result?.Campanha.Id 

                    //}));



                    //var listaProdutos = await new Conexao<Produto>(session).queryover().Where(p => p.Situacao == Situacao_Produto.Ativo).ListAsync();

                    //retorno.Objeto.AddRange(listaProdutos.Select(p => new PlanoProdutoListModel
                    //{
                    //    Id = p.Id,
                    //    Descricao = p.Descricao,
                    //    Codigo = p.Codigo,
                    //    ValorPlanoProduto = Convert.ToString(p.ValorProduto),
                    //    ValorInstalacao = null,
                    //    Tipo = PlanoProdutoEnum.Produto,
                    //    Id_Campanha = new Conexao<Campanha_PlanoProduto>(session).selectFirst(u => u.Produto.Id == p.Id).Result.Campanha.Id
                    //}));

                    retorno.Ok = true;
                }
                catch (Exception ex)
                {
                    retorno.Mensagem = ex.Message;
                    if (ex.InnerException != null) retorno.InnerException += ex.InnerException.Message;
                }
            }
            return retorno;

        }

        #region Mobile
        [HttpGet()]
        [Route("api/PlanoProdutoApi/GetListByCampanhaMobile")]
        public async Task<GetApiRetorno<List<PlanoProdutoListModel>>> GetListByCampanhaMobile(Int64 Id_Campanha)
        {
            GetApiRetorno<List<PlanoProdutoListModel>> retorno = new GetApiRetorno<List<PlanoProdutoListModel>>
            {
                Objeto = new List<PlanoProdutoListModel>()
            };

            using (ISession session = HibernateUtil.GetSession())
            using (var repoCampanha_PlanoProduto = new Conexao<Campanha_PlanoProduto>(session))
            using (var repoPlano = new Conexao<Plano>(session))
            using (var repoProduto = new Conexao<Produto>(session))
            {
                try
                {
                    List<Campanha_PlanoProduto> listaCampanhaPlanoProduto = (await repoCampanha_PlanoProduto.select(p => p.Campanha.Id == Id_Campanha))
                        .Where(p => p.Id_Plano_Produto != null).ToList();


                    foreach (Campanha_PlanoProduto campanhaPP in listaCampanhaPlanoProduto)
                    {
                        if (campanhaPP.IsPlanProd == PlanoProdutoEnum.Plano)
                        {
                            Plano PlanoSelecionado = (await repoPlano.selectFirst(prop => prop.Id == campanhaPP.Id_Plano_Produto));

                            //Plano Execution
                            retorno.Objeto.Add(new PlanoProdutoListModel
                            {
                                Id = PlanoSelecionado.Id,
                                Descricao = PlanoSelecionado.Descricao,
                                Codigo = PlanoSelecionado.Codigo,
                                ValorPlanoProduto = Convert.ToString(PlanoSelecionado.ValorPlano),
                                AutenticacaoRadius = PlanoSelecionado.AutenticacaoRadius ? Resources.RsBase.SIM : Resources.RsBase.NAO,
                                ValorInstalacao = Convert.ToString(PlanoSelecionado.ValorInstalacao),
                                Tipo = PlanoProdutoEnum.Plano,
                                Periodo_Carencia = PlanoSelecionado.Periodo_Carencia,
                                Meses_Carencia = PlanoSelecionado.Modelo_Contrato?.Periodo_Carencia,
                                Numero_Parcelas = PlanoSelecionado.QtdParcelas,
                                Id_Campanha = campanhaPP.Campanha.Id,
                                Id_Modelo_Contrato = PlanoSelecionado.Modelo_Contrato?.Id,
                                Detalhes = PlanoSelecionado.DetalhesPlano,
                                VelocidadeDownload = PlanoSelecionado.VelocidadeDownload,
                                VelocidadeDownloadReduzida = PlanoSelecionado.VelocidadeDownloadReduzida,
                                VelocidadeUpload = PlanoSelecionado.VelocidadeUpload,
                                Id_Tecnologia = PlanoSelecionado.Tecnologia != null ? PlanoSelecionado.Tecnologia.Id : -1,
                                VelocidadeUploadReduzida = PlanoSelecionado.VelocidadeUploadReduzida,
                                VelocidadeNominal = PlanoSelecionado.VelocidadeNominal
                            });
                        }
                        else if (campanhaPP.IsPlanProd == PlanoProdutoEnum.Produto)
                        {
                            //Produto Execution
                            Produto ProdutoSelecionado = (await repoProduto.selectFirst(prop => prop.Id == campanhaPP.Id_Plano_Produto));
                            retorno.Objeto.Add(new PlanoProdutoListModel
                            {
                                Id = ProdutoSelecionado.Id,
                                Descricao = ProdutoSelecionado.Descricao,
                                Codigo = ProdutoSelecionado.Codigo,
                                ValorPlanoProduto = Convert.ToString(ProdutoSelecionado.ValorProduto),
                                ValorInstalacao = null,
                                Tipo = PlanoProdutoEnum.Produto,
                                Id_Campanha = campanhaPP.Campanha.Id,
                                Id_Modelo_Contrato = ProdutoSelecionado.ModeloContratoProduto?.Id,

                                Detalhes = ProdutoSelecionado.Detalhes
                            });
                        }
                        else
                        {
                            throw new Exception("E_PLANO_PRODUTO não cadastrado na tabela.");
                        }

                    }

                    retorno.Ok = true;
                }

                catch (Exception ex)
                {
                    retorno.Mensagem = ex.Message;
                    if (ex.InnerException != null) retorno.InnerException += ex.InnerException.Message;
                }
            }
            return retorno;

        }
        #endregion

        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetList")]
        public async Task<GetApiRetorno<List<PlanoProdutoListModel>>> GetList()
        {
            GetApiRetorno<List<PlanoProdutoListModel>> retorno = new GetApiRetorno<List<PlanoProdutoListModel>>
            {
                Objeto = new List<PlanoProdutoListModel>()
            };

            using (ISession session = HibernateUtil.GetSession())
            using (var repoPlano = new Conexao<Plano>(session))
            using (var repoProduto = new Conexao<Produto>(session))
            using (var repoModelo_Contrato = new Conexao<Modelo_Contrato>(session))
            {
                try
                {
                    var listaPlanos = await repoPlano.select(p => p.SituacaoPlano == Situacao_plano.Ativo);

                    retorno.Objeto.AddRange(listaPlanos.Select(p => new PlanoProdutoListModel
                    {
                        Id = p.Id,
                        Descricao = p.Descricao,
                        Codigo = p.Codigo,
                        ValorPlanoProduto = Convert.ToString(p.ValorPlano),
                        Id_Modelo_Contrato = p.Modelo_Contrato != null ? p.Modelo_Contrato.Id : (Int64?)null,
                        AutenticacaoRadius = p.AutenticacaoRadius ? Resources.RsBase.SIM : Resources.RsBase.NAO,
                        ValorInstalacao = Convert.ToString(p.ValorInstalacao),
                        ValorInstalacao_Final = Convert.ToString(p.ValorInstalacaoFinal),
                        Tipo = PlanoProdutoEnum.Plano,
                        //Informações Presentes no Modelo de Contrato
                        //Teste_Gratis = p.TesteGratis,
                        //Qtde_Dias = p.DiasTeste,
                        ValorPlanoProduto_Final = Convert.ToString(p.ValorPlanoFinal),
                        Periodo_Carencia = p.Periodo_Carencia,
                        Meses_Carencia = p.Modelo_Contrato?.Periodo_Carencia,
                        Numero_Parcelas = p.QtdParcelas,
                        Status_PlanoProduto = p.StatusInicial,
                        Status_PlanoProduto_Str = HtmlEnumExtensions.GetEnumDescription<Status_PlanoProduto>(p.StatusInicial.Value),
                        Detalhes = p.DetalhesPlano,
                        VelocidadeDownload = p.VelocidadeDownload,
                        VelocidadeDownloadReduzida = p.VelocidadeDownloadReduzida,
                        VelocidadeUpload = p.VelocidadeUpload,
                        VelocidadeUploadReduzida = p.VelocidadeUploadReduzida,
                        VelocidadeNominal = p.VelocidadeNominal,
                        Id_Tecnologia = p.Tecnologia != null ? p.Tecnologia.Id : (Int64?)null,

                    }));



                    var listaProdutos = await repoProduto.select(p => p.Situacao == Situacao_Produto.Ativo);

                    retorno.Objeto.AddRange(listaProdutos.Select(p => new PlanoProdutoListModel
                    {
                        Id = p.Id,
                        Descricao = p.Descricao,
                        Codigo = p.Codigo,
                        Id_Modelo_Contrato = p.ModeloContratoProduto != null ? repoModelo_Contrato.selectFirst(u => u.Id == p.ModeloContratoProduto.Id).Result.Id : (Int64?)null,
                        ValorPlanoProduto = Convert.ToString(p.ValorProduto),
                        ValorPlanoProduto_Final = Convert.ToString(p.ValorProdutoFinal),
                        ValorInstalacao = null,
                        Tipo = PlanoProdutoEnum.Produto,
                        Status_PlanoProduto = p.Status_Inicial,
                        Status_PlanoProduto_Str = HtmlEnumExtensions.GetEnumDescription<Status_PlanoProduto>(p.Status_Inicial),

                        Detalhes = p.Detalhes
                    }));

                    retorno.Ok = true;
                }
                catch (Exception ex)
                {
                    retorno.Mensagem = ex.Message;
                    if (ex.InnerException != null) retorno.InnerException += ex.InnerException.Message;
                }
            }
            return retorno;

        }

        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetComboPlanoProdutoAreaCobertura")]
        public async Task<ObjCombo<Int64>> GetComboPlanoProdutoAreaCobertura(RequestObjComboPai<Int64?, List<int?>> request)
        {
            ObjCombo<Int64> retorno = new ObjCombo<Int64>
            {
                results = new List<IObjComboResult<Int64>>()
            };

            using (ISession session = HibernateUtil.GetSession())
            using (ISession sessionT5 = HibernateUtil.GetSessionT5())
            {
                var ids = new List<long>();
                var planoProdutoAreaCoberturaCombo = new List<PlanoProdutoAreaCoberturaCombo>();

                try
                {
                    //Filtros 
                    var parametros = new Dictionary<string, object>();

                    var sqlFromPlano = new StringBuilder("FROM TB_AREA_COBERTURA_PLANO_PROD A ");
                    var planoProduto = new List<PlanoProdutoComboModels>();

                    var condicoesPlano = new List<String>();

                    // Caso a lista de IDs de Área de cobertura venha vazia, não há planos nem produtos para exibir.
                    if ((request.idpai != null) && (!request.idpai.Contains(null)))
                    {
                        string listaIds = string.Join(", ", request.idpai.Where(p => !string.IsNullOrEmpty(Convert.ToString(p))).Select(p => string.Format("{0}", p)));
                        //throw new Exception("Não existem planos referente a essa geolocalização");
                        condicoesPlano.Add($"A.ID_AREA_COBERTURA IN ({listaIds})");
                        sqlFromPlano.AppendLine($" WHERE ( {String.Join(" AND ", condicoesPlano)} ) ");

                        //Verificar o id do plano pela area de cobertura
                        using (var com = sessionT5.Connection.CreateCommand())
                        {
                            var sql = new StringBuilder("SELECT A.ID, A.ID_AREA_COBERTURA, A.DESCRICAO,COD_PLANO_PRODUTO ");
                            sql.AppendLine(sqlFromPlano.ToString());
                            sql.AppendLine("ORDER BY UPPER(A.DESCRICAO) ");

                            using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, sessionT5.Connection, null, request.page))
                            {
                                while (await reader.ReadAsync())
                                {
                                    long id = 0;
                                    if (reader["COD_PLANO_PRODUTO"] != DBNull.Value)
                                    {
                                        id = Convert.ToInt64(reader["COD_PLANO_PRODUTO"]);
                                    }
                                    ids.Add(id);

                                    var obj = new PlanoProdutoAreaCoberturaCombo
                                    {
                                        Id = id,
                                        Text = Convert.ToString(reader["DESCRICAO"]),
                                        Id_area_cobertura = Convert.ToString(reader["ID_AREA_COBERTURA"]),
                                    };

                                    planoProdutoAreaCoberturaCombo.Add(obj);

                                }
                            }
                        }

                        if (ids.Count > 0)
                        {
                            using (var com_union = session.Connection.CreateCommand())
                            {
                                #region Plano

                                StringBuilder sqlPlano = new StringBuilder();
                                sqlPlano.AppendLine(@$"SELECT P.ID, P.CODIGO, P.DESCRICAO, P.VALORPLANO, P.ID_MODELOCONTRATO, P.AUTENTICACAORADIUS,
                                          P.VALORINSTALACAO, P.VALORINSTALACAOFINAL, P.TESTEGRATIS, P.VALORPLANOFINAL, P.DIASTESTE,
                                          P.PERIODO_CARENCIA, P.QTDPARCELAS, P.STATUSINICIAL, P.DETALHESPLANO, P.VELOCIDADEDOWNLOAD, 
                                          P.VELOCIDADEDOWNLOADREDUZIDA, P.VELOCIDADEUPLOAD, P.VELOCIDADEUPLOADREDUZIDA, 
                                          P.VELOCIDADENOMINAL
                                          FROM TB_PLANO P WHERE P.ID IN ({String.Join(",", ids)})");
                                sqlPlano.AppendLine("ORDER BY UPPER(P.DESCRICAO)");
                                using (var readerPlan = await CommandHelper.ExecuteReader(com_union, sqlPlano, parametros, session.Connection, null))
                                {
                                    while (await readerPlan.ReadAsync())
                                    {
                                        var obj = new PlanoProdutoComboModels
                                        {
                                            Id = Convert.ToInt64(readerPlan["ID"]),
                                            Text = Convert.ToString(readerPlan["DESCRICAO"]),
                                            ValorPlanoProduto = readerPlan["VALORPLANO"] != DBNull.Value ? Convert.ToDouble(readerPlan["VALORPLANO"]).ToString("N2") : "0.00",
                                            Id_Modelo_Contrato = readerPlan["ID_MODELOCONTRATO"] != DBNull.Value ? Convert.ToInt64(readerPlan["ID_MODELOCONTRATO"]) : (Int64?)null,
                                            AutenticacaoRadius = readerPlan["AUTENTICACAORADIUS"] != DBNull.Value ? Convert.ToBoolean(readerPlan["AUTENTICACAORADIUS"]) : false,
                                            ValorInstalacao = readerPlan["VALORINSTALACAO"] != DBNull.Value ? Convert.ToDouble(readerPlan["VALORINSTALACAO"]).ToString("N2") : "0.00",
                                            ValorInstalacao_Final = readerPlan["VALORINSTALACAOFINAL"] != DBNull.Value ? Convert.ToDouble(readerPlan["VALORINSTALACAOFINAL"]).ToString("N2") : "0.00",
                                            Tipo = PlanoProdutoEnum.Plano,
                                            Teste_Gratis = readerPlan["TESTEGRATIS"] != DBNull.Value ? Convert.ToBoolean(readerPlan["TESTEGRATIS"]) : false,
                                            ValorPlanoProduto_Final = readerPlan["VALORPLANOFINAL"] != DBNull.Value ? Convert.ToDouble(readerPlan["VALORPLANOFINAL"]).ToString("N2") : "0.00",
                                            Qtde_Dias = readerPlan["DIASTESTE"] != DBNull.Value ? Convert.ToInt64(readerPlan["DIASTESTE"]) : (Int64?)null,
                                            Periodo_Carencia = readerPlan["PERIODO_CARENCIA"] != DBNull.Value ? Convert.ToBoolean(readerPlan["PERIODO_CARENCIA"]) : false,

                                            Numero_Parcelas = readerPlan["QTDPARCELAS"] != DBNull.Value ? Convert.ToInt64(readerPlan["QTDPARCELAS"]) : (Int64?)null,
                                            Status_PlanoProduto = readerPlan["STATUSINICIAL"] != DBNull.Value ? (Status_PlanoProduto)Enum.Parse(typeof(Status_PlanoProduto), readerPlan["STATUSINICIAL"].ToString()) : (Status_PlanoProduto?)null,
                                            Detalhes = Convert.ToString(readerPlan["DETALHESPLANO"]),
                                            VelocidadeDownload = Convert.ToString(readerPlan["VELOCIDADEDOWNLOAD"]),
                                            VelocidadeDownloadReduzida = Convert.ToString(readerPlan["VELOCIDADEDOWNLOADREDUZIDA"]),
                                            VelocidadeUpload = Convert.ToString(readerPlan["VELOCIDADEUPLOAD"]),
                                            VelocidadeUploadReduzida = Convert.ToString(readerPlan["VELOCIDADEUPLOADREDUZIDA"]),
                                            VelocidadeNominal = Convert.ToString(readerPlan["VELOCIDADENOMINAL"]),

                                        };
                                        planoProduto.Add(obj);

                                    }
                                }
                                #endregion

                                #region produto 

                                StringBuilder sqlProduto = new StringBuilder(@$"SELECT M.ID, M.CODIGO, M.DESCRICAO, M.ID_CONTRATO, M.VALORPRODUTO,
                    M.VALORPRODUTOFINAL, M.STATUS_INICIAL, M.DETALHES, M.DIAS_TESTE_PRODUTO, M.TEM_TESTE_GRATIS
                    FROM TB_PRODUTO M WHERE M.ID IN ({String.Join(", ", ids)})");
                                sqlProduto.AppendLine("ORDER BY UPPER(M.DESCRICAO)");
                                using (var readerProd = await CommandHelper.ExecuteReader(com_union, sqlProduto, parametros, session.Connection, null))
                                {
                                    while (await readerProd.ReadAsync())
                                    {

                                        var obj = new PlanoProdutoComboModels
                                        {
                                            Id = Convert.ToInt64(readerProd["ID"]),
                                            Text = Convert.ToString(readerProd["DESCRICAO"]),
                                            Id_Modelo_Contrato = readerProd["ID_CONTRATO"] != DBNull.Value ? Convert.ToInt64(readerProd["ID_CONTRATO"]) : (Int64?)null,
                                            Teste_Gratis = readerProd["TEM_TESTE_GRATIS"] != DBNull.Value ? Convert.ToBoolean(readerProd["TEM_TESTE_GRATIS"]) : false,
                                            Qtde_Dias = readerProd["DIAS_TESTE_PRODUTO"] != DBNull.Value ? Convert.ToInt64(readerProd["DIAS_TESTE_PRODUTO"]) : (Int64?)null,

                                            ValorPlanoProduto = readerProd["VALORPRODUTO"] != DBNull.Value ? Convert.ToDouble(readerProd["VALORPRODUTO"]).ToString("N2") : "0.00",
                                            ValorPlanoProduto_Final = readerProd["VALORPRODUTOFINAL"] != DBNull.Value ? Convert.ToDouble(readerProd["VALORPRODUTOFINAL"]).ToString("N2") : "0.00",
                                            ValorInstalacao = null,
                                            Tipo = PlanoProdutoEnum.Produto,
                                            Status_PlanoProduto = readerProd["STATUS_INICIAL"] != DBNull.Value ? (Status_PlanoProduto)Enum.Parse(typeof(Status_PlanoProduto), readerProd["STATUS_INICIAL"].ToString()) : (Status_PlanoProduto?)null,
                                            Detalhes = Convert.ToString(readerProd["DETALHES"])
                                        };
                                        planoProduto.Add(obj);

                                    }
                                }

                                #endregion

                                var Uniao_PlanoProd_AreaCobertura = planoProduto.Zip(planoProdutoAreaCoberturaCombo, (p, x) => new { obj = p, id_plano = x.Id });

                                foreach (var planoProdutoCombo in planoProdutoAreaCoberturaCombo)
                                {
                                    PlanoProdutoComboModels objPlanoProduto = Uniao_PlanoProd_AreaCobertura.Where(p => p.id_plano == planoProdutoCombo.Id).FirstOrDefault().obj;

                                    planoProdutoCombo.ValorInstalacao = objPlanoProduto.ValorInstalacao;
                                    planoProdutoCombo.ValorInstalacao_Final = objPlanoProduto.ValorInstalacao_Final;
                                    planoProdutoCombo.ValorPlanoProduto = objPlanoProduto.ValorPlanoProduto;
                                    planoProdutoCombo.ValorPlanoProduto_Final = objPlanoProduto.ValorPlanoProduto_Final;
                                    planoProdutoCombo.Qtde_Dias = objPlanoProduto.Qtde_Dias;
                                    planoProdutoCombo.Numero_Parcelas = objPlanoProduto.Numero_Parcelas;
                                    planoProdutoCombo.Text = objPlanoProduto.Text;
                                    planoProdutoCombo.Tipo = objPlanoProduto.Tipo;

                                    retorno.results.Add(planoProdutoCombo);
                                }
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    string Message = ex.Message;
                }
            }
            return retorno;

        }

        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetCombo")]
        public async Task<ObjCombo<Int64>> GetCombo(RequestObjComboPaiConfig<Int64?, Int64?, long?> request)
        {
            ObjCombo<Int64> retorno = new ObjCombo<Int64>
            {
                results = new List<IObjComboResult<Int64>>()
            };

            using (ISession session = HibernateUtil.GetSession())
            {
                try
                {
                    #region Plano
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    StringBuilder sqlFromPlano = new StringBuilder("FROM TB_PLANO A ")
                                                        .AppendLine("LEFT JOIN TB_MODELO_CONTRATO B ")
                                                        .AppendLine("ON(A.ID_MODELOCONTRATO = B.ID) ")
                                                        .AppendLine("LEFT JOIN TB_RADIUS D ")
                                                        .AppendLine("ON(A.ID_RADIUS = D.ID) ");
                    if (request.idpai.HasValue)
                    {
                        sqlFromPlano.AppendLine($"LEFT JOIN TB_CAMPANHA_PLANO_PRODUTO C " +
                                                $"ON(C.ID_PLANO_PRODUTO = A.ID AND C.E_PLANO_PRODUTO = 1)");
                    }

                    List<String> condicoesPlano = new List<String>();
                    if (request.config.HasValue)
                    {

                        if (request.config.Value < 1 || request.config.Value > 5)
                        {
                            throw new Exception("Valor Inserido é não permitido para esta configuração");
                        }
                        else
                        {
                            condicoesPlano.Add($"TIPO_TECNOLOGIA = {request.config.Value}");
                            condicoesPlano.Add("B.ID IS NOT NULL");
                        }
                    }

                    if (request.soativos)
                    {
                        condicoesPlano.Add($"SITUACAOPLANO = 1");
                    }

                    if (request.id.HasValue)
                    {
                        condicoesPlano.Add($"UPPER(A.ID) = {request.id}");
                    }

                    if (request.idpai.HasValue)
                    {
                        condicoesPlano.Add($"UPPER(C.ID_CAMPANHA) = {request.idpai}");
                    }

                    if (request != null && !String.IsNullOrEmpty(request.q))
                    {
                        condicoesPlano.Add($"( UPPER(A.CODIGO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 20)}%' OR " +
                                       $" UPPER(A.DESCRICAO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 100)}%' OR " +
                                       $" UPPER(A.NOME_VENDA) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 100)}%')");
                    }

                    if (condicoesPlano.Count() > 0)
                    {
                        sqlFromPlano.AppendLine($" WHERE ( {String.Join(" AND ", condicoesPlano)} ) ");
                    }

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) AS CO ");
                        sql.AppendLine(sqlFromPlano.ToString());

                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            if (await reader.ReadAsync())
                                retorno.total_count = Convert.ToInt32(reader["CO"]);
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder(" SELECT A.ID, A.CODIGO, CASE")
                                                  .AppendLine(" WHEN A.nome_venda is NULL THEN A.DESCRICAO      ")
                                                  .AppendLine(" WHEN A.NOME_VENDA IS NOT NULL THEN A.NOME_VENDA ")
                                                  .AppendLine(" END AS DESCRICAO, A.VALORPLANO, A.ID_MODELOCONTRATO, A.AUTENTICACAORADIUS, ")
                                                  .AppendLine(" A.VALORINSTALACAO, A.VALORINSTALACAOFINAL, A.TESTEGRATIS, A.VALORPLANOFINAL, A.DIASTESTE, ")
                                                  .AppendLine(" A.PERIODO_CARENCIA, A.QTDPARCELAS, A.STATUSINICIAL, A.DETALHESPLANO, A.VELOCIDADEDOWNLOAD, ")
                                                  .AppendLine(" A.VELOCIDADEDOWNLOADREDUZIDA, A.VELOCIDADEUPLOAD, A.VELOCIDADEUPLOADREDUZIDA, A.DISPONIBILIZA_TELEFONIA, ")
                                                  .AppendLine(" A.VELOCIDADENOMINAL, B.PERIODO_CARENCIA AS PERIODO_CARENCIA_MODELO, A.TIPO_TECNOLOGIA, D.ID AS ID_RADIUS, A.COBRANCAINSTALACAO ");
                        sql.AppendLine(sqlFromPlano.ToString());
                        sql.AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new PlanoProdutoComboModels
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"]),
                                    ValorPlanoProduto = reader["VALORPLANO"] != DBNull.Value ? Convert.ToDouble(reader["VALORPLANO"]).ToString("N2") : "0.00",
                                    Id_Modelo_Contrato = reader["ID_MODELOCONTRATO"] != DBNull.Value ? Convert.ToInt64(reader["ID_MODELOCONTRATO"]) : (Int64?)null,
                                    AutenticacaoRadius = reader["AUTENTICACAORADIUS"] != DBNull.Value ? Convert.ToBoolean(reader["AUTENTICACAORADIUS"]) : false,
                                    CobraInstalacao = Convert.ToBoolean(reader["COBRANCAINSTALACAO"]),
                                    ValorInstalacao = reader["VALORINSTALACAO"] != DBNull.Value ? Convert.ToDouble(reader["VALORINSTALACAO"]).ToString("N2") : "0.00",
                                    ValorInstalacao_Final = reader["VALORINSTALACAOFINAL"] != DBNull.Value ? Convert.ToDouble(reader["VALORINSTALACAOFINAL"]).ToString("N2") : "0.00",
                                    Tipo = PlanoProdutoEnum.Plano,
                                    Teste_Gratis = reader["TESTEGRATIS"] != DBNull.Value ? Convert.ToBoolean(reader["TESTEGRATIS"]) : false,
                                    ValorPlanoProduto_Final = reader["VALORPLANOFINAL"] != DBNull.Value ? Convert.ToDouble(reader["VALORPLANOFINAL"]).ToString("N2") : "0.00",
                                    Qtde_Dias = reader["DIASTESTE"] != DBNull.Value ? Convert.ToInt64(reader["DIASTESTE"]) : (Int64?)null,
                                    Periodo_Carencia = reader["PERIODO_CARENCIA"] != DBNull.Value ? Convert.ToBoolean(reader["PERIODO_CARENCIA"]) : false,
                                    Meses_Carencia = reader["PERIODO_CARENCIA_MODELO"] != DBNull.Value ? Convert.ToInt64(reader["PERIODO_CARENCIA_MODELO"]) : (Int64?)null,
                                    Numero_Parcelas = reader["QTDPARCELAS"] != DBNull.Value ? Convert.ToInt64(reader["QTDPARCELAS"]) : (Int64?)null,
                                    Status_PlanoProduto = reader["STATUSINICIAL"] != DBNull.Value ? (Status_PlanoProduto)Enum.Parse(typeof(Status_PlanoProduto), reader["STATUSINICIAL"].ToString()) : (Status_PlanoProduto?)null,
                                    Detalhes = Convert.ToString(reader["DETALHESPLANO"]),
                                    VelocidadeDownload = Convert.ToString(reader["VELOCIDADEDOWNLOAD"]),
                                    VelocidadeDownloadReduzida = Convert.ToString(reader["VELOCIDADEDOWNLOADREDUZIDA"]),
                                    VelocidadeUpload = Convert.ToString(reader["VELOCIDADEUPLOAD"]),
                                    VelocidadeUploadReduzida = Convert.ToString(reader["VELOCIDADEUPLOADREDUZIDA"]),
                                    VelocidadeNominal = Convert.ToString(reader["VELOCIDADENOMINAL"]),
                                    Id_Radius = reader["ID_RADIUS"] != DBNull.Value ? Convert.ToInt64(reader["ID_RADIUS"]) : (Int64?)null,
                                    Tipo_Tecnologia = reader["TIPO_TECNOLOGIA"] != DBNull.Value ? Convert.ToInt32(reader["TIPO_TECNOLOGIA"]) : (int?)null,
                                    Tipo_TecnologiaStr = reader["TIPO_TECNOLOGIA"] != DBNull.Value ? HtmlEnumExtensions.GetEnumDescription((Tipo_Tecnologia)Convert.ToInt32(reader["TIPO_TECNOLOGIA"])) : null,
                                    Disponibiliza_Telefonia = reader["DISPONIBILIZA_TELEFONIA"] != DBNull.Value ? Convert.ToString(reader["DISPONIBILIZA_TELEFONIA"]) : String.Empty
                                };

                                obj.Status_PlanoProduto_Str = HtmlEnumExtensions.GetEnumDescription<Status_PlanoProduto>(obj.Status_PlanoProduto.Value);

                                retorno.results.Add(obj);
                            }
                        }
                    }
                    #endregion

                    #region Produto
                    //Filtros 
                    StringBuilder sqlFromProduto = new StringBuilder("FROM TB_PRODUTO A ")
                                                        .AppendLine("LEFT JOIN TB_MODELO_CONTRATO B ")
                                                        .AppendLine("ON(A.ID_CONTRATO = B.ID) ");
                    if (request.idpai.HasValue)
                    {
                        sqlFromProduto.AppendLine($"LEFT JOIN TB_CAMPANHA_PLANO_PRODUTO C " +
                                                  $"ON(C.ID_PLANO_PRODUTO = A.ID AND C.E_PLANO_PRODUTO = 2)");
                    }

                    List<String> condicoesProduto = new List<String>();

                    if (request.soativos)
                    {
                        condicoesProduto.Add($"SITUACAO = 1");
                    }
                    if (request.config.HasValue)
                    {

                        if (request.config.Value != 5)
                        {
                            //throw new Exception("Valor Inserido é não permitido para esta configuração");
                        }
                        else
                        {
                            condicoesProduto.Add($"TIPO_PRODUTO = 0");
                        }
                    }

                    if (request.id.HasValue)
                    {
                        condicoesProduto.Add($"UPPER(A.ID) = {request.id}");
                    }

                    if (request.idpai.HasValue)
                    {
                        condicoesProduto.Add($"UPPER(C.ID_CAMPANHA) = {request.idpai}");
                    }

                    if (request != null && !String.IsNullOrEmpty(request.q))
                    {
                        condicoesProduto.Add($"( UPPER(A.CODIGO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 20)}%' OR " +
                                       $" UPPER(A.DESCRICAO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 100)}%')");
                    }

                    if (condicoesProduto.Count() > 0)
                    {
                        sqlFromProduto.AppendLine($" WHERE ( {String.Join(" AND ", condicoesProduto)} ) ");
                    }

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) AS CO ");
                        sql.AppendLine(sqlFromProduto.ToString());

                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            if (await reader.ReadAsync())
                                retorno.total_count += Convert.ToInt32(reader["CO"]);
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT A.ID, A.CODIGO, A.DESCRICAO, A.ID_CONTRATO, A.VALORPRODUTO, A.COBRANCA_INSTALACAO, ")
                        .AppendLine(" A.VALORPRODUTOFINAL, A.STATUS_INICIAL, A.DETALHES, A.DIAS_TESTE_PRODUTO, A.TEM_TESTE_GRATIS, A.TIPO_PRODUTO, B.PERIODO_CARENCIA, B.TEM_CARENCIA ");

                        sql.AppendLine(sqlFromProduto.ToString());
                        sql.AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new PlanoProdutoComboModels
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"]),
                                    Id_Modelo_Contrato = reader["ID_CONTRATO"] != DBNull.Value ? Convert.ToInt64(reader["ID_CONTRATO"]) : (Int64?)null,
                                    Teste_Gratis = reader["TEM_TESTE_GRATIS"] != DBNull.Value ? Convert.ToBoolean(reader["TEM_TESTE_GRATIS"]) : false,
                                    Qtde_Dias = reader["DIAS_TESTE_PRODUTO"] != DBNull.Value ? Convert.ToInt64(reader["DIAS_TESTE_PRODUTO"]) : (Int64?)null,
                                    Periodo_Carencia = reader["TEM_CARENCIA"] != DBNull.Value ? Convert.ToBoolean(reader["TEM_CARENCIA"]) : false,
                                    Meses_Carencia = reader["PERIODO_CARENCIA"] != DBNull.Value ? Convert.ToInt64(reader["PERIODO_CARENCIA"]) : (Int64?)null,

                                    ValorPlanoProduto = reader["VALORPRODUTO"] != DBNull.Value ? Convert.ToDouble(reader["VALORPRODUTO"]).ToString("N2") : "0.00",
                                    ValorPlanoProduto_Final = reader["VALORPRODUTOFINAL"] != DBNull.Value ? Convert.ToDouble(reader["VALORPRODUTOFINAL"]).ToString("N2") : "0.00",
                                    CobraInstalacao = Convert.ToBoolean(reader["COBRANCA_INSTALACAO"]),
                                    ValorInstalacao = null,
                                    Tipo = PlanoProdutoEnum.Produto,
                                    Status_PlanoProduto = reader["STATUS_INICIAL"] != DBNull.Value ? (Status_PlanoProduto)Enum.Parse(typeof(Status_PlanoProduto), reader["STATUS_INICIAL"].ToString()) : (Status_PlanoProduto?)null,
                                    Detalhes = Convert.ToString(reader["DETALHES"]),
                                    Tipo_Tecnologia = reader["TIPO_PRODUTO"] != DBNull.Value ? Convert.ToInt32(reader["TIPO_PRODUTO"]) : (int?)null,
                                    Tipo_TecnologiaStr = reader["TIPO_PRODUTO"] != DBNull.Value ? HtmlEnumExtensions.GetEnumDescription((Tipo_Produto)Convert.ToInt32(reader["TIPO_PRODUTO"])) : null,

                                };

                                obj.Status_PlanoProduto_Str = HtmlEnumExtensions.GetEnumDescription<Status_PlanoProduto>(obj.Status_PlanoProduto.Value);

                                retorno.results.Add(obj);
                            }
                        }
                    }
                    #endregion
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }
            return retorno;

        }
        
        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetComboPlano")]
        public async Task<ObjCombo<Int64>> GetComboPlano(RequestObjComboPaiConfig<Int64?, Int64?, long?> request)
        {
            ObjCombo<Int64> retorno = new ObjCombo<Int64>
            {
                results = new List<IObjComboResult<Int64>>()
            };

            using (ISession session = HibernateUtil.GetSession())
            {
                try
                {
                    #region Plano
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    StringBuilder sqlFromPlano = new StringBuilder("FROM TB_PLANO A ")
                                                        .AppendLine("LEFT JOIN TB_MODELO_CONTRATO B ")
                                                        .AppendLine("ON(A.ID_MODELOCONTRATO = B.ID) ")
                                                        .AppendLine("LEFT JOIN TB_RADIUS D ")
                                                        .AppendLine("ON(A.ID_RADIUS = D.ID) ");
                    if (request.idpai.HasValue)
                    {
                        sqlFromPlano.AppendLine($"LEFT JOIN TB_CAMPANHA_PLANO_PRODUTO C " +
                                                $"ON(C.ID_PLANO_PRODUTO = A.ID AND C.E_PLANO_PRODUTO = 1)");
                    }

                    List<String> condicoesPlano = new List<String>();
                    if (request.config.HasValue)
                    {

                        if (request.config.Value < 1 || request.config.Value > 5)
                        {
                            throw new Exception("Valor Inserido é não permitido para esta configuração");
                        }
                        else
                        {
                            condicoesPlano.Add($"TIPO_TECNOLOGIA = {request.config.Value}");
                            condicoesPlano.Add("B.ID IS NOT NULL");
                        }
                    }

                    if (request.soativos)
                    {
                        condicoesPlano.Add($"SITUACAOPLANO = 1");
                    }

                    if (request.id.HasValue)
                    {
                        condicoesPlano.Add($"UPPER(A.ID) = {request.id}");
                    }

                    if (request.idpai.HasValue)
                    {
                        condicoesPlano.Add($"UPPER(C.ID_CAMPANHA) = {request.idpai}");
                    }

                    if (request != null && !String.IsNullOrEmpty(request.q))
                    {
                        condicoesPlano.Add($"( UPPER(A.CODIGO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 20)}%' OR " +
                                       $" UPPER(A.DESCRICAO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 100)}%' OR " +
                                       $" UPPER(A.NOME_VENDA) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 100)}%')");
                    }

                    if (condicoesPlano.Count() > 0)
                    {
                        sqlFromPlano.AppendLine($" WHERE ( {String.Join(" AND ", condicoesPlano)} ) ");
                    }

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) AS CO ");
                        sql.AppendLine(sqlFromPlano.ToString());

                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            if (await reader.ReadAsync())
                                retorno.total_count = Convert.ToInt32(reader["CO"]);
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder(" SELECT A.ID, A.CODIGO, CASE")
                                                  .AppendLine(" WHEN A.nome_venda is NULL THEN A.DESCRICAO      ")
                                                  .AppendLine(" WHEN A.NOME_VENDA IS NOT NULL THEN A.NOME_VENDA ")
                                                  .AppendLine(" END AS DESCRICAO, A.VALORPLANO, A.ID_MODELOCONTRATO, A.AUTENTICACAORADIUS, ")
                                                  .AppendLine(" A.VALORINSTALACAO, A.VALORINSTALACAOFINAL, A.TESTEGRATIS, A.VALORPLANOFINAL, A.DIASTESTE, ")
                                                  .AppendLine(" A.PERIODO_CARENCIA, A.QTDPARCELAS, A.STATUSINICIAL, A.DETALHESPLANO, A.VELOCIDADEDOWNLOAD, ")
                                                  .AppendLine(" A.VELOCIDADEDOWNLOADREDUZIDA, A.VELOCIDADEUPLOAD, A.VELOCIDADEUPLOADREDUZIDA, A.DISPONIBILIZA_TELEFONIA, ")
                                                  .AppendLine(" A.VELOCIDADENOMINAL, B.PERIODO_CARENCIA AS PERIODO_CARENCIA_MODELO, A.TIPO_TECNOLOGIA, D.ID AS ID_RADIUS, A.COBRANCAINSTALACAO ");
                        sql.AppendLine(sqlFromPlano.ToString());
                        sql.AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new PlanoProdutoComboModels
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"]),
                                    ValorPlanoProduto = reader["VALORPLANO"] != DBNull.Value ? Convert.ToDouble(reader["VALORPLANO"]).ToString("N2") : "0.00",
                                    Id_Modelo_Contrato = reader["ID_MODELOCONTRATO"] != DBNull.Value ? Convert.ToInt64(reader["ID_MODELOCONTRATO"]) : (Int64?)null,
                                    AutenticacaoRadius = reader["AUTENTICACAORADIUS"] != DBNull.Value ? Convert.ToBoolean(reader["AUTENTICACAORADIUS"]) : false,
                                    CobraInstalacao = Convert.ToBoolean(reader["COBRANCAINSTALACAO"]),
                                    ValorInstalacao = reader["VALORINSTALACAO"] != DBNull.Value ? Convert.ToDouble(reader["VALORINSTALACAO"]).ToString("N2") : "0.00",
                                    ValorInstalacao_Final = reader["VALORINSTALACAOFINAL"] != DBNull.Value ? Convert.ToDouble(reader["VALORINSTALACAOFINAL"]).ToString("N2") : "0.00",
                                    Tipo = PlanoProdutoEnum.Plano,
                                    Teste_Gratis = reader["TESTEGRATIS"] != DBNull.Value ? Convert.ToBoolean(reader["TESTEGRATIS"]) : false,
                                    ValorPlanoProduto_Final = reader["VALORPLANOFINAL"] != DBNull.Value ? Convert.ToDouble(reader["VALORPLANOFINAL"]).ToString("N2") : "0.00",
                                    Qtde_Dias = reader["DIASTESTE"] != DBNull.Value ? Convert.ToInt64(reader["DIASTESTE"]) : (Int64?)null,
                                    Periodo_Carencia = reader["PERIODO_CARENCIA"] != DBNull.Value ? Convert.ToBoolean(reader["PERIODO_CARENCIA"]) : false,
                                    Meses_Carencia = reader["PERIODO_CARENCIA_MODELO"] != DBNull.Value ? Convert.ToInt64(reader["PERIODO_CARENCIA_MODELO"]) : (Int64?)null,
                                    Numero_Parcelas = reader["QTDPARCELAS"] != DBNull.Value ? Convert.ToInt64(reader["QTDPARCELAS"]) : (Int64?)null,
                                    Status_PlanoProduto = reader["STATUSINICIAL"] != DBNull.Value ? (Status_PlanoProduto)Enum.Parse(typeof(Status_PlanoProduto), reader["STATUSINICIAL"].ToString()) : (Status_PlanoProduto?)null,
                                    Detalhes = Convert.ToString(reader["DETALHESPLANO"]),
                                    VelocidadeDownload = Convert.ToString(reader["VELOCIDADEDOWNLOAD"]),
                                    VelocidadeDownloadReduzida = Convert.ToString(reader["VELOCIDADEDOWNLOADREDUZIDA"]),
                                    VelocidadeUpload = Convert.ToString(reader["VELOCIDADEUPLOAD"]),
                                    VelocidadeUploadReduzida = Convert.ToString(reader["VELOCIDADEUPLOADREDUZIDA"]),
                                    VelocidadeNominal = Convert.ToString(reader["VELOCIDADENOMINAL"]),
                                    Id_Radius = reader["ID_RADIUS"] != DBNull.Value ? Convert.ToInt64(reader["ID_RADIUS"]) : (Int64?)null,
                                    Tipo_Tecnologia = reader["TIPO_TECNOLOGIA"] != DBNull.Value ? Convert.ToInt32(reader["TIPO_TECNOLOGIA"]) : (int?)null,
                                    Tipo_TecnologiaStr = reader["TIPO_TECNOLOGIA"] != DBNull.Value ? HtmlEnumExtensions.GetEnumDescription((Tipo_Tecnologia)Convert.ToInt32(reader["TIPO_TECNOLOGIA"])) : null,
                                    Disponibiliza_Telefonia = reader["DISPONIBILIZA_TELEFONIA"] != DBNull.Value ? Convert.ToString(reader["DISPONIBILIZA_TELEFONIA"]) : String.Empty
                                };

                                obj.Status_PlanoProduto_Str = HtmlEnumExtensions.GetEnumDescription<Status_PlanoProduto>(obj.Status_PlanoProduto.Value);

                                retorno.results.Add(obj);
                            }
                        }
                    }
                    #endregion
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }
            return retorno;

        }

