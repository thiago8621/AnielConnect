        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetAll")]
        public async Task<DataTableResponse<PlanoProdutoIndexModel>> GetAll(DataTableRequest request)
        {

            List<PlanoProdutoIndexModel> retorno = new List<PlanoProdutoIndexModel>();
            Int32 recordsTotal = 0;

            using (ISession session = HibernateUtil.GetSession())
            {

                Dictionary<String, Object> parametros = new Dictionary<string, object>();

                //Count
                using (var com = session.Connection.CreateCommand())
                {
                    StringBuilder sql = new StringBuilder();

                    sql.AppendLine("SELECT SUM(C.CO) AS CO FROM "); // A.DETALHESPLANO
                    sql.AppendLine("(SELECT COUNT(A.ID) AS CO"); // A.DETALHESPLANO
                    sql.AppendLine(" FROM TB_PLANO A ");
                    //   sql.AppendLine(" WHERE A.SITUACAOPLANO = 1 ");

                    sql.AppendLine(" UNION ");

                    sql.AppendLine("SELECT COUNT(B.ID) AS CO");
                    sql.AppendLine(" FROM TB_PRODUTO B ) C ");
                    //   sql.AppendLine(" WHERE B.SITUACAO = 1 ) C");

                    using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                    {
                        if (await reader.ReadAsync())
                        {
                            recordsTotal = Convert.ToInt32(reader["CO"]);
                        }
                    }
                }

                //Ordenacao


                //Select
                using (var com = session.Connection.CreateCommand())
                {

                    StringBuilder sql = new StringBuilder();

                    sql.AppendLine("SELECT * FROM ( ");
                    sql.AppendLine("SELECT A.ID, A.CODIGO, A.DESCRICAO, A.SITUACAOPLANO AS SITUACAO,1 TIPO,");
                    sql.AppendLine(HtmlEnumExtensions.getEnumDescriptionInSql<Situacao_plano>("A.SITUACAOPLANO", "SITUACAO_ORDENAR"));
                    sql.AppendLine(", '" + HtmlEnumExtensions.GetEnumDescription<PlanoProdutoEnum>("1") + "' AS TIPO_ORDENAR");
                    sql.AppendLine(" FROM TB_PLANO A ");
                    //   sql.AppendLine(" WHERE A.SITUACAOPLANO = 1 ");

                    if (!String.IsNullOrEmpty(request.search.value))
                    {
                        sql.AppendLine(" WHERE ((UPPER(A.DESCRICAO) LIKE UPPER(@SEARCH))) ");

                    }

                    sql.AppendLine(" UNION ");

                    sql.AppendLine("SELECT B.ID, B.CODIGO, B.DESCRICAO, B.SITUACAO AS SITUACAO,2 TIPO,");
                    sql.AppendLine(HtmlEnumExtensions.getEnumDescriptionInSql<Situacao_plano>("B.SITUACAO", "SITUACAO_ORDENAR"));
                    sql.AppendLine(", '" + HtmlEnumExtensions.GetEnumDescription<PlanoProdutoEnum>("2") + "' AS TIPO_ORDENAR");
                    sql.AppendLine(" FROM TB_PRODUTO B ");
                    //    sql.AppendLine(" WHERE B.SITUACAO = 1 ");

                    if (!String.IsNullOrEmpty(request.search.value))
                    {
                        sql.AppendLine(" WHERE ((UPPER(B.DESCRICAO) LIKE UPPER(@SEARCH))) ");

                    }
                    sql.AppendLine(" ) AS X"); ;
                    parametros.Add("@SEARCH", String.Format("%{0}%", request.search.value));



                    if (request.order != null && request.order.Any())
                    {
                        int sortColumnIndex = request.order[0].column;
                        string sortDirection = request.order[0].dir;
                        switch (sortColumnIndex)
                        {
                            case 1:     // Id
                                {
                                    if (sortDirection == "asc")
                                        sql.AppendLine(" ORDER BY X.ID ");
                                    else
                                        sql.AppendLine(" ORDER BY X.ID DESC");
                                    break;
                                }

                            case 2:     // DESCRICAO
                                {
                                    if (sortDirection == "asc")
                                        sql.AppendLine(" ORDER BY X.DESCRICAO ");
                                    else
                                        sql.AppendLine(" ORDER BY X.DESCRICAO DESC");
                                    break;
                                }

                            case 3:     // SITUACAO
                                {
                                    if (sortDirection == "asc")
                                        sql.AppendLine(" ORDER BY X.TIPO_ORDENAR ");
                                    else
                                        sql.AppendLine(" ORDER BY X.TIPO_ORDENAR DESC");
                                    break;
                                }
                            case 4:     // SITUACAO
                                {
                                    if (sortDirection == "asc")
                                        sql.AppendLine(" ORDER BY X.SITUACAO_ORDENAR ");
                                    else
                                        sql.AppendLine(" ORDER BY X.SITUACAO_ORDENAR DESC");
                                    break;
                                }

                        }
                    }

                    //sql.AppendLine(" WHERE A.STATUS = 1");

                    //Busca com paginacao
                    using (var reader = await CommandHelper.ExecuteReaderFirst(com, sql, parametros, session.Connection, null, request.length, request.start))
                    {
                        while (await reader.ReadAsync())
                        {
                            retorno.Add(new PlanoProdutoIndexModel
                            {
                                Id = Convert.ToInt64(reader["ID"]),
                                Descricao = Convert.ToString(reader["DESCRICAO"]),
                                Codigo = Convert.ToString(reader["CODIGO"]),
                                Tipo = HtmlEnumExtensions.GetEnumDescription<PlanoProdutoEnum>(Convert.ToString(reader["TIPO"])),
                                Situacao = HtmlEnumExtensions.GetEnumDescription<Situacao_plano>(Convert.ToString(reader["SITUACAO"])),
                            });
                        }
                    }

                }
            }


            //Page e retornando DataTable
            return new DataTableResponse<PlanoProdutoIndexModel>
            {
                draw = request.draw,
                //recordsTotal = recordsTotal,
                recordsFiltered = recordsTotal,
                data = retorno,
                error = ""
            };

        }


        [HttpGet()]
        [Route("api/PlanoProdutoApi/busca")]
        public async Task<List<ObjBusca<Int64>>> busca(String term)
        {
            List<ObjBusca<Int64>> retorno = new List<ObjBusca<Int64>>();

            using (ISession session = HibernateUtil.GetSession())
            {
                try
                {
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder();

                        sql.AppendLine("SELECT A.ID, A.DESCRICAO");
                        sql.AppendLine("FROM TB_PLANO A");
                        sql.AppendLine("WHERE (UPPER(A.DESCRICAO) LIKE @VALOR) ");
                        parametros.Add("@VALOR", $"%{term.ToUpperInvariant()}%");

                        using (var reader = await CommandHelper.ExecuteReaderFirst(com, sql, parametros, session.Connection, null, 10, null))
                        {
                            while (await reader.ReadAsync())
                            {
                                retorno.Add(new ObjBusca<Int64>
                                {
                                    Value = Convert.ToInt64(reader["ID"]),
                                    Label = Convert.ToString(reader["DESCRICAO"])
                                });
                            }
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder();

                        sql.AppendLine("SELECT A.ID, A.DESCRICAO");
                        sql.AppendLine("FROM TB_PRODUTO A");
                        sql.AppendLine("WHERE (UPPER(A.DESCRICAO) LIKE @VALOR) ");

                        using (var reader = await CommandHelper.ExecuteReaderFirst(com, sql, parametros, session.Connection, null, 10, null))
                        {
                            while (await reader.ReadAsync())
                            {
                                retorno.Add(new ObjBusca<Int64>
                                {
                                    Value = Convert.ToInt64(reader["ID"]),
                                    Label = Convert.ToString(reader["DESCRICAO"])
                                });
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }

            return retorno;
        }

        [HttpGet()]
        [Route("api/PlanoProdutoApi/getByCliente")]
        public async Task<List<PlanoProdutoComboAntendimentoViewModel>> getByCliente(Int64 IdCliente)
        {
            List<PlanoProdutoComboAntendimentoViewModel> retorno = new List<PlanoProdutoComboAntendimentoViewModel>();

            using (ISession session = HibernateUtil.GetSession())
            using (ISession sessionT5 = HibernateUtil.GetSessionT5())
            {
                try
                {
                    //Filtros 
                    var parametros = new Dictionary<string, object>();

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        var sql = new StringBuilder();

                        sql.AppendLine("SELECT CPP.STATUS, CPP.ID AS ID_CLIENTE_PLAN_PROD,");
                        sql.AppendLine("       COALESCE(PLANO.ID_TIPO_SERVICO, PROD.ID_TIPO_SERVICO) AS ID_TIPO_SERVICO,");
                        sql.AppendLine("       COALESCE(PLANO.ID_SUBTIPO_SERVICO, PROD.ID_SUBTIPO_SERVICO) AS ID_SUBTIPO_SERVICO,");
                        sql.AppendLine("       COALESCE(PLANO.ID, PROD.ID, COMBO.ID) AS ID,");
                        sql.AppendLine("       COALESCE(PLANO.DESCRICAO, PROD.DESCRICAO, COMBO.DESCRICAO) AS DESCRICAO,");
                        sql.AppendLine("       CPP.LOGIN_RADIUS, CPP.COD_ESCRITORIO, CPP.COD_AREA, CPP.COD_LOCALIDADE,");
                        sql.AppendLine("       CPP.LOCALIDADE, ");
                        sql.AppendLine("       COALESCE(END_CLI.ENDERECO_CEP, END_LOG.CEP) AS ENDERECO_CEP,");
                        sql.AppendLine("       COALESCE(END_CLI.ENDERECO_LOGRADOURO, END_LOG.DESCRICAO) AS ENDERECO_LOGRADOURO,");
                        sql.AppendLine("       END_CLI.ENDERECO_NUMERO, ");
                        sql.AppendLine("       COALESCE(END_CLI.ENDERECO_BAIRRO, B.DESCRICAO) AS ENDERECO_BAIRRO,");
                        sql.AppendLine("       COALESCE(END_CLI.ENDERECO_CIDADE, C.DESCRICAO) AS ENDERECO_CIDADE,");
                        sql.AppendLine("       COALESCE(END_CLI.ENDERECO_UF, UF.DESCRICAO) AS ENDERECO_UF,");
                        sql.AppendLine("       END_CLI.ENDERECO_PONTO_REFERENCIA, END_CLI.ENDERECO_COMPLEMENTO,");
                        sql.AppendLine("       TP_IMOVEL.DESCRICAO AS TIPO_IMOVEL, CPP.VALOR_FINAL_TOTAL,");
                        sql.AppendLine("       (CASE");
                        sql.AppendLine("            WHEN PLANO.ID IS NOT NULL THEN 1");
                        sql.AppendLine("            WHEN PROD.ID IS NOT NULL THEN 2");
                        sql.AppendLine("            ELSE NULL");
                        sql.AppendLine("        END) AS TIPO,");
                        sql.AppendLine("END_CLI.BLOCO, END_CLI.APARTAMENTO");
                        sql.AppendLine("FROM TB_CLIENTE_PLANO_PRODUTO CPP");

                        sql.AppendLine("LEFT JOIN TB_PLANO PLANO");
                        sql.AppendLine("ON(CPP.ID_PLANO = PLANO.ID)");

                        sql.AppendLine("LEFT JOIN TB_PRODUTO PROD");
                        sql.AppendLine("ON(CPP.ID_PRODUTO = PROD.ID)");
                        
                        sql.AppendLine("LEFT JOIN TB_COMBO COMBO");
                        sql.AppendLine("ON(CPP.ID_COMBO = COMBO.ID)");
                        
                        sql.AppendLine("LEFT JOIN TB_ENDERECO_CLIENTE END_CLI");
                        sql.AppendLine("ON(CPP.ID_ENDERECO_INSTALACAO = END_CLI.ID)");
                        
                        sql.AppendLine("LEFT JOIN TB_ENDERECO_LOGRADOURO END_LOG");
                        sql.AppendLine("ON(END_CLI.ID_ENDERECO_LOGRADOURO = END_LOG.ID)");

                        sql.AppendLine("LEFT JOIN TB_PAIS P");
                        sql.AppendLine("ON(END_LOG.ID_PAIS = P.ID)");
                        
                        sql.AppendLine("LEFT JOIN TB_UF UF");
                        sql.AppendLine("ON(END_LOG.ID_UF = UF.ID)");
                        
                        sql.AppendLine("LEFT JOIN TB_CIDADE C");
                        sql.AppendLine("ON(END_LOG.ID_CIDADE = C.ID)");
                        
                        sql.AppendLine("LEFT JOIN TB_BAIRRO B");
                        sql.AppendLine("ON(END_LOG.ID_BAIRRO = B.ID)");
                        
                        sql.AppendLine("LEFT JOIN TB_TIPO_IMOVEL TP_IMOVEL");
                        sql.AppendLine("ON(END_CLI.ID_TIPO_IMOVEL = TP_IMOVEL.COD_TIPO_IMOVEL)");
                        
                        sql.AppendLine("WHERE CPP.ID_CLIENTE = @ID_CLIENTE");


                        parametros.Add("@ID_CLIENTE", IdCliente);

                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            while (await reader.ReadAsync())
                            {
                                String endereco = String.Empty;                              

                                if (reader["ENDERECO_LOGRADOURO"] != DBNull.Value)
                                    endereco = $"{reader["ENDERECO_LOGRADOURO"]} {" , "} {reader["ENDERECO_NUMERO"]} {" - "} {reader["ENDERECO_BAIRRO"]} {" - "} {reader["ENDERECO_CIDADE"]}";
                                                                                                                              
                                var descricaoArea = "";
                                var descricaoEscritorio = "";

                                using (var comArea = sessionT5.Connection.CreateCommand())
                                {
                                    var paramArea = new Dictionary<string, object>();
                                    var sqlArea = new StringBuilder();

                                    sqlArea.AppendLine("SELECT A.DESCRICAO AS AREA_DESC, B.DESCRICAO AS ESCRITORIO_DESC");
                                    sqlArea.AppendLine("FROM TB_AREA A");

                                    sqlArea.AppendLine("INNER JOIN TB_ESCRITORIO B");
                                    sqlArea.AppendLine("ON(A.COD_ESCRITORIO = B.COD_ESCRITORIO)");

                                    sqlArea.AppendLine("WHERE A.COD_ESCRITORIO = @COD_ESCRITORIO AND A.COD_AREA = @COD_AREA");

                                    paramArea.Add("@COD_ESCRITORIO", Convert.ToString(reader["COD_ESCRITORIO"]));
                                    paramArea.Add("@COD_AREA", Convert.ToString(reader["COD_AREA"]));

                                    using (var readerArea = await CommandHelper.ExecuteReader(comArea, sqlArea, paramArea, sessionT5.Connection, null))
                                    {
                                        if (await readerArea.ReadAsync())
                                        {
                                            descricaoArea = Convert.ToString(readerArea["AREA_DESC"]);
                                            descricaoEscritorio = Convert.ToString(readerArea["ESCRITORIO_DESC"]);
                                        }
                                    }
                                }


                                (string contrato, string projeto) contratoProjeto =
                                    await GetContratoProjeto(
                                        reader["COD_ESCRITORIO"],
                                        reader["COD_AREA"],
                                        reader["COD_LOCALIDADE"]
                                    );

                                retorno.Add(new PlanoProdutoComboAntendimentoViewModel
                                {
                                    Id_Cliente_PlanoProduto = Convert.ToInt64(reader["ID_CLIENTE_PLAN_PROD"]),
                                    Status_PlanoProduto = !String.IsNullOrEmpty(Convert.ToString(reader["STATUS"])) ? (Status_PlanoProduto)Enum.Parse(typeof(Status_PlanoProduto), Convert.ToString(reader["STATUS"])) : (Status_PlanoProduto?)null,
                                    Value = Convert.ToInt64(reader["ID"]),
                                    Label = reader["DESCRICAO"] != DBNull.Value ? Convert.ToString(reader["DESCRICAO"]) : String.Empty,
                                    Login_Radius = reader["LOGIN_RADIUS"] != DBNull.Value ? Convert.ToString(reader["LOGIN_RADIUS"]) : String.Empty,
                                    Endereco = endereco,
                                    Valor_Final = reader["VALOR_FINAL_TOTAL"] != DBNull.Value ? String.Format("{0:N2}", Convert.ToDouble(reader["VALOR_FINAL_TOTAL"])) : String.Empty,
                                    Tipo =
                                        reader["TIPO"] != DBNull.Value ?
                                            (PlanoProdutoEnum)Enum.Parse(typeof(PlanoProdutoEnum), Convert.ToString(reader["TIPO"])) :
                                            (PlanoProdutoEnum?)null,
                                    Tipo_Imovel = reader["TIPO_IMOVEL"] != DBNull.Value ? Convert.ToString(reader["TIPO_IMOVEL"]) : String.Empty,
                                    Complemento = reader["ENDERECO_COMPLEMENTO"] != DBNull.Value ? Convert.ToString(reader["ENDERECO_COMPLEMENTO"]) : String.Empty,
                                    Ponto_Referencia_Cliente = reader["ENDERECO_PONTO_REFERENCIA"] != DBNull.Value ? Convert.ToString(reader["ENDERECO_PONTO_REFERENCIA"]) : String.Empty,
                                    Cep = reader["ENDERECO_CEP"] != DBNull.Value ? Convert.ToString(reader["ENDERECO_CEP"]) : String.Empty,
                                    Cod_Escritorio = reader["COD_ESCRITORIO"] != DBNull.Value ? Convert.ToString(reader["COD_ESCRITORIO"]) : String.Empty,
                                    Desc_Escritorio = descricaoEscritorio,
                                    Desc_Area = descricaoArea,
                                    Cod_Area = reader["COD_AREA"] != DBNull.Value ? Convert.ToString(reader["COD_AREA"]) : String.Empty,
                                    Cod_Localidade = reader["COD_LOCALIDADE"] != DBNull.Value ? Convert.ToInt32(reader["COD_LOCALIDADE"]) : (Int32?)null,
                                    Localidade = reader["LOCALIDADE"] != DBNull.Value ? Convert.ToString(reader["LOCALIDADE"]) : String.Empty,
                                    CodCt = contratoProjeto.contrato,
                                    Projeto = contratoProjeto.projeto,
                                    IdTipoServico = reader["ID_TIPO_SERVICO"] != DBNull.Value ? Convert.ToInt32(reader["ID_TIPO_SERVICO"]) : (int?)null,
                                    IdSubTipoServico = reader["ID_SUBTIPO_SERVICO"] != DBNull.Value ? Convert.ToString(reader["ID_SUBTIPO_SERVICO"]) : null,
                                    Bloco = reader["BLOCO"] != DBNull.Value ? Convert.ToString(reader["BLOCO"]) : String.Empty,
                                    Apartamento = reader["APARTAMENTO"] != DBNull.Value ? Convert.ToString(reader["APARTAMENTO"]) : String.Empty,
                            });

                                retorno = retorno.Where(p => p.Status_PlanoProduto != Status_PlanoProduto.Venda_Cancelada && p.Status_PlanoProduto != Status_PlanoProduto.Aguardando_Aprovacao_Venda).ToList();
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }

            return retorno;
        }


        [HttpGet()]
        [Route("api/PlanoProdutoApi/getPlanoAtivoCliente")]
        public async Task<List<string>> getPlanoAtivoCliente(Int64? IdCliente)
        {
            List<string> retorno = new List<string>();
            string mensagemRetorno = "";

            using (ISession session = HibernateUtil.GetSession())
            using (ISession sessionT5 = HibernateUtil.GetSessionT5())
            {
                try
                {
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT A.STATUS,A.ID_PLANO AS ID, B.DESCRICAO AS DESCRICAO, A.LOGIN_RADIUS, A.COD_ESCRITORIO, A.COD_AREA, A.COD_LOCALIDADE,A.LOCALIDADE,")
                        .AppendLine("       C.ENDERECO_CEP, C.ENDERECO_LOGRADOURO, C.ENDERECO_NUMERO, ")
                        .AppendLine("       C.ENDERECO_BAIRRO, C.ENDERECO_CIDADE, C.ENDERECO_UF, C.ENDERECO_PONTO_REFERENCIA, ")
                        .AppendLine("       C.ENDERECO_COMPLEMENTO, D.DESCRICAO AS TIPO_IMOVEL, A.VALOR_FINAL_TOTAL, 1 TIPO ")
                        .AppendLine(" FROM TB_CLIENTE_PLANO_PRODUTO A ")
                        .AppendLine("INNER JOIN TB_PLANO B ")
                        .AppendLine("   ON (A.ID_PLANO = B.ID) ")
                        .AppendLine(" LEFT JOIN TB_ENDERECO_CLIENTE C ")
                        .AppendLine("   ON (A.ID_ENDERECO_INSTALACAO = C.ID) ")
                        .AppendLine(" LEFT JOIN TB_TIPO_IMOVEL D ")
                        .AppendLine("   ON (C.ID_TIPO_IMOVEL = D.COD_TIPO_IMOVEL) ")

                        .AppendLine("WHERE A.ID_CLIENTE = @ID_CLIENTE")

                        .AppendLine("UNION ")

                        .AppendLine("SELECT A.STATUS,A.ID_PRODUTO AS ID, B.DESCRICAO AS DESCRICAO, '' AS LOGIN_RADIUS, A.COD_ESCRITORIO, A.COD_AREA, A.COD_LOCALIDADE,A.LOCALIDADE,")
                        .AppendLine("       C.ENDERECO_CEP, C.ENDERECO_LOGRADOURO, C.ENDERECO_NUMERO, ")
                        .AppendLine("       C.ENDERECO_BAIRRO, C.ENDERECO_CIDADE, C.ENDERECO_UF, C.ENDERECO_PONTO_REFERENCIA, ")
                        .AppendLine("       C.ENDERECO_COMPLEMENTO, D.DESCRICAO AS TIPO_IMOVEL, A.VALOR_FINAL_TOTAL, 2 TIPO ")
                        .AppendLine(" FROM TB_CLIENTE_PLANO_PRODUTO A ")
                        .AppendLine("INNER JOIN TB_PRODUTO B ")
                        .AppendLine("   ON (A.ID_PRODUTO = B.ID) ")
                        .AppendLine(" LEFT JOIN TB_ENDERECO_CLIENTE C ")
                        .AppendLine("   ON (A.ID_ENDERECO_INSTALACAO = C.ID) ")
                        .AppendLine(" LEFT JOIN TB_TIPO_IMOVEL D ")
                        .AppendLine("     ON (C.ID_TIPO_IMOVEL = D.COD_TIPO_IMOVEL) ")
                        .AppendLine("WHERE A.ID_CLIENTE = @ID_CLIENTE");

                        parametros.Add("@ID_CLIENTE", IdCliente);

                        int count = 0;
                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            while (await reader.ReadAsync())
                            {
                                count++;
                                var descricao = Convert.ToString(reader["DESCRICAO"]);
                                var idPlanoProduto = Convert.ToString(reader["ID"]);

                                if (!String.IsNullOrEmpty(descricao))
                                {
                                    mensagemRetorno += ("\r\n" + idPlanoProduto + " - " + descricao);
                                }
                            }

                            if (String.IsNullOrEmpty(mensagemRetorno))
                            {
                                mensagemRetorno = ("Não foram encontrados planos para o cliente");
                            }

                            retorno.Add(mensagemRetorno);
                        }
                    }
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }

            return retorno;
        }


        private async Task<String> GetContrato(Object Cod_Escritorio, Object Cod_Area, Object Cod_Localidade)
        {
            if (Cod_Escritorio == DBNull.Value || Cod_Area == DBNull.Value || Cod_Localidade == DBNull.Value)
                return String.Empty;

            using (ISession session = HibernateUtil.GetSessionT5())
            {
                try
                {
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder();

                        sql.AppendLine("SELECT A.CODCT  ");
                        sql.AppendLine("FROM TB_LOCALIDADE A ");
                        sql.AppendLine("WHERE A.COD_ESCRITORIO = @COD_ESCRITORIO AND A.COD_AREA = @COD_AREA AND A.COD_LOCALIDADE = @COD_LOCALIDADE");

                        parametros.Add("@COD_ESCRITORIO", Convert.ToString(Cod_Escritorio));
                        parametros.Add("@COD_AREA", Convert.ToString(Cod_Area));
                        parametros.Add("@COD_LOCALIDADE", Convert.ToInt32(Cod_Localidade));

                        using (var reader = await CommandHelper.ExecuteReaderFirst(com, sql, parametros, session.Connection, null, 10, null))
                        {
                            if (await reader.ReadAsync())
                            {
                                return reader["CODCT"] != DBNull.Value ? Convert.ToString(reader["CODCT"]) : String.Empty;
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }

            return String.Empty;
        }

        private async Task<(String codct, String projeto)> GetContratoProjeto(Object Cod_Escritorio, Object Cod_Area, Object Cod_Localidade)
        {
            if (Cod_Escritorio == DBNull.Value || Cod_Area == DBNull.Value || Cod_Localidade == DBNull.Value)
                return (String.Empty, String.Empty);

            using (ISession session = HibernateUtil.GetSessionT5())
            {
                try
                {
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder();

                        sql.AppendLine("SELECT A.CODCT,A.PROJETO  ");
                        sql.AppendLine("FROM TB_LOCALIDADE A ");
                        sql.AppendLine("WHERE A.COD_ESCRITORIO = @COD_ESCRITORIO AND A.COD_AREA = @COD_AREA AND A.COD_LOCALIDADE = @COD_LOCALIDADE");

                        parametros.Add("@COD_ESCRITORIO", Convert.ToString(Cod_Escritorio));
                        parametros.Add("@COD_AREA", Convert.ToString(Cod_Area));
                        parametros.Add("@COD_LOCALIDADE", Convert.ToInt32(Cod_Localidade));

                        using (var reader = await CommandHelper.ExecuteReaderFirst(com, sql, parametros, session.Connection, null, 10, null))
                        {
                            if (await reader.ReadAsync())
                            {
                                string codct = reader["CODCT"] != DBNull.Value ? Convert.ToString(reader["CODCT"]) : String.Empty;
                                string projeto = reader["PROJETO"] != DBNull.Value ? Convert.ToString(reader["PROJETO"]) : String.Empty; ;
                                return (codct, projeto);
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }

            return (String.Empty, String.Empty);
        }

        [HttpGet()]
        [Route("api/PlanoProdutoApi/AtendimentogetByCliente")]
        public async Task<List<PlanoProdutoComboAntendimentoViewModel>> AtendimentogetByCliente(Int64 IdCliente)
        {
            List<PlanoProdutoComboAntendimentoViewModel> retorno = new List<PlanoProdutoComboAntendimentoViewModel>();

            using (ISession session = HibernateUtil.GetSession())
            {
                try
                {
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder();

                        sql.AppendLine("SELECT A.ID, B.DESCRICAO AS DESCRICAO, A.LOGIN_RADIUS, ");
                        sql.AppendLine("       C.ENDERECO_CEP, C.ENDERECO_LOGRADOURO, C.ENDERECO_NUMERO, ");
                        sql.AppendLine("       C.ENDERECO_BAIRRO, C.ENDERECO_CIDADE, C.ENDERECO_UF, C.ENDERECO_PONTO_REFERENCIA, ");
                        sql.AppendLine("       C.ENDERECO_COMPLEMENTO, D.DESCRICAO AS TIPO_IMOVEL, A.VALOR_FINAL_TOTAL, 1 TIPO, A.COD_ESCRITORIO, ");
                        sql.AppendLine("       A.COD_AREA, A.COD_LOCALIDADE, A.LOCALIDADE ");
                        sql.AppendLine("FROM TB_CLIENTE_PLANO_PRODUTO A ");
                        sql.AppendLine("INNER JOIN TB_PLANO B ");
                        sql.AppendLine("ON(A.ID_PLANO = B.ID) ");
                        sql.AppendLine("LEFT JOIN TB_ENDERECO_CLIENTE C ");
                        sql.AppendLine("ON(A.ID_ENDERECO_INSTALACAO = C.ID) ");
                        sql.AppendLine("   LEFT JOIN TB_TIPO_IMOVEL D ");
                        sql.AppendLine("     ON (C.ID_TIPO_IMOVEL = D.COD_TIPO_IMOVEL) ");
                        sql.AppendLine("WHERE A.ID_CLIENTE = @ID_CLIENTE");

                        sql.AppendLine("UNION ");

                        sql.AppendLine("SELECT A.ID, B.DESCRICAO AS DESCRICAO, '' AS LOGIN_RADIUS, ");
                        sql.AppendLine("       C.ENDERECO_CEP, C.ENDERECO_LOGRADOURO, C.ENDERECO_NUMERO, ");
                        sql.AppendLine("       C.ENDERECO_BAIRRO, C.ENDERECO_CIDADE, C.ENDERECO_UF, C.ENDERECO_PONTO_REFERENCIA, ");
                        sql.AppendLine("       C.ENDERECO_COMPLEMENTO, D.DESCRICAO AS TIPO_IMOVEL, A.VALOR_FINAL_TOTAL, 2 TIPO, A.COD_ESCRITORIO, ");
                        sql.AppendLine("       A.COD_AREA, A.COD_LOCALIDADE, A.LOCALIDADE ");
                        sql.AppendLine("FROM TB_CLIENTE_PLANO_PRODUTO A ");
                        sql.AppendLine("INNER JOIN TB_PRODUTO B ");
                        sql.AppendLine("ON(A.ID_PRODUTO = B.ID) ");
                        sql.AppendLine("LEFT JOIN TB_ENDERECO_CLIENTE C ");
                        sql.AppendLine("ON(A.ID_ENDERECO_INSTALACAO = C.ID) ");
                        sql.AppendLine("   LEFT JOIN TB_TIPO_IMOVEL D ");
                        sql.AppendLine("     ON (C.ID_TIPO_IMOVEL = D.COD_TIPO_IMOVEL) ");
                        sql.AppendLine("WHERE A.ID_CLIENTE = @ID_CLIENTE");


                        parametros.Add("@ID_CLIENTE", IdCliente);

                        using (var reader = await CommandHelper.ExecuteReaderFirst(com, sql, parametros, session.Connection, null, 10, null))
                        {
                            while (await reader.ReadAsync())
                            {
                                String endereco = String.Empty;

                                if (reader["ENDERECO_LOGRADOURO"] != DBNull.Value)
                                    endereco = $"{reader["ENDERECO_LOGRADOURO"]} {" , "} {reader["ENDERECO_NUMERO"]} {" - "} {reader["ENDERECO_BAIRRO"]} {" - "} {reader["ENDERECO_CIDADE"]}";


                                retorno.Add(new PlanoProdutoComboAntendimentoViewModel
                                {
                                    Value = Convert.ToInt64(reader["ID"]),
                                    Label = reader["DESCRICAO"] != DBNull.Value ? Convert.ToString(reader["DESCRICAO"]) : String.Empty,
                                    Login_Radius = reader["LOGIN_RADIUS"] != DBNull.Value ? Convert.ToString(reader["LOGIN_RADIUS"]) : String.Empty,
                                    Endereco = endereco,
                                    Valor_Final = reader["VALOR_FINAL_TOTAL"] != DBNull.Value ? String.Format("{0:N2}", Convert.ToDouble(reader["VALOR_FINAL_TOTAL"])) : String.Empty,
                                    Tipo = (PlanoProdutoEnum)Enum.Parse(typeof(PlanoProdutoEnum), Convert.ToString(reader["TIPO"])),
                                    Tipo_Imovel = reader["TIPO_IMOVEL"] != DBNull.Value ? Convert.ToString(reader["TIPO_IMOVEL"]) : String.Empty,
                                    Complemento = reader["ENDERECO_COMPLEMENTO"] != DBNull.Value ? Convert.ToString(reader["ENDERECO_COMPLEMENTO"]) : String.Empty,
                                    Ponto_Referencia_Cliente = reader["ENDERECO_PONTO_REFERENCIA"] != DBNull.Value ? Convert.ToString(reader["ENDERECO_PONTO_REFERENCIA"]) : String.Empty,
                                    Cep = reader["ENDERECO_CEP"] != DBNull.Value ? Convert.ToString(reader["ENDERECO_CEP"]) : String.Empty,
                                    Cod_Escritorio = reader["COD_ESCRITORIO"] != DBNull.Value ? Convert.ToString(reader["COD_ESCRITORIO"]) : String.Empty,
                                    Cod_Area = reader["COD_AREA"] != DBNull.Value ? Convert.ToString(reader["COD_AREA"]) : String.Empty,
                                    Cod_Localidade = reader["COD_LOCALIDADE"] != DBNull.Value ? Convert.ToInt32(reader["COD_LOCALIDADE"]) : (Int32?)null,
                                    Localidade = reader["LOCALIDADE"] != DBNull.Value ? Convert.ToString(reader["LOCALIDADE"]) : String.Empty
                                });
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }

            return retorno;
        }


        [HttpGet()]
        [Route("api/clienteapi/FindLoginByPlano")]
        public async Task<GetApiRetorno<AlterarLoginRadiusViewModel>> FindLoginByPlano(Int64 IdPlanoProduto)
        {
            var retorno = new GetApiRetorno<AlterarLoginRadiusViewModel>();
            retorno.Objeto = new AlterarLoginRadiusViewModel();

            using (ISession session = HibernateUtil.GetSession())
            using (var repoLoginRadius = new Conexao<LoginRadius>(session))
            {
                try
                {
                    var loginRadius = await repoLoginRadius.selectFirst(p => p.Cliente_PlanoProduto.Id == IdPlanoProduto);

                    if (loginRadius != null)
                        retorno.Objeto = GetViewObjLogin(loginRadius);
                    else
                        retorno.Objeto = new AlterarLoginRadiusViewModel
                        {
                            IdPlanoProduto = IdPlanoProduto
                        };

                    retorno.Ok = true;
                }
                catch (Exception ex)
                {
                    retorno.Mensagem = ex.Message;
                    if (ex.InnerException != null) retorno.InnerException += ex.InnerException.Message;
                }

                return retorno;
            }
        }

