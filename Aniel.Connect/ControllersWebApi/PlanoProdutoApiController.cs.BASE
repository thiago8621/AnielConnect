        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetComboModeloContrato")]
        public async Task<ObjCombo<Int64>> GetComboModeloContrato(RequestObjCombo<Int64?> request)
        {
            ObjCombo<Int64> retorno = new ObjCombo<Int64>
            {
                results = new List<IObjComboResult<Int64>>()
            };

            using (ISession session = HibernateUtil.GetSession())
            {
                try
                {
                    #region Plano
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    if(request.id.HasValue)
                        parametros.Add("contrato",request.id.HasValue);

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder(" SELECT C.ID, C.DESCRICAO ");
                        sql.AppendLine(" FROM TB_MODELO_CONTRATO A ");
                        sql.AppendLine(" INNER JOIN TB_MODELO_CONTRATO_PLANOPROD B ");
                        sql.AppendLine(" ON (B.ID_CONTRATO = A.ID) ");
                        sql.AppendLine(" INNER JOIN TB_PLANO C ");
                        sql.AppendLine(" ON (C.ID = B.ID_PLANO) ");

                        if (request.id.HasValue)
                            sql.AppendLine(" WHERE A.ID = @contrato ");

                        sql.AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, 0))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new ObjComboResult<Int64>()
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"]),
                                };

                                retorno.results.Add(obj);
                            }
                        }
                    }
                    #endregion

                    #region Produto

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder(" SELECT C.ID, C.DESCRICAO ");
                        sql.AppendLine("  FROM TB_MODELO_CONTRATO A ");
                        sql.AppendLine(" INNER JOIN TB_MODELO_CONTRATO_PLANOPROD B ");
                        sql.AppendLine(" ON (B.ID_CONTRATO = A.ID) ");
                        sql.AppendLine(" INNER JOIN TB_PRODUTO C ");
                        sql.AppendLine(" ON (C.ID = B.ID_PRODUTO) ");

                        if (request.id.HasValue)
                            sql.AppendLine(" WHERE A.ID = @contrato ");

                        sql.AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new ObjComboResult<Int64>()
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"]),
                                };

                                retorno.results.Add(obj);
                            }
                        }
                    }
                    #endregion
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }
            return retorno;

        }

        [AcceptVerbs("get", "post")]
        [Route("api/PlanoProdutoApi/GetCombo_MontagemCombo")]
        public async Task<ObjCombo<Int64>> GetCombo_MontagemCombo(RequestObjComboPai_Obj_Combo_Montagem<string[], Tipo_Tecnologia[]> request)
        {
            ObjCombo<Int64> retorno = new ObjCombo<Int64>
            {
                results = new List<IObjComboResult<Int64>>()
            };

            var param = new List<int>();
            using (ISession session = HibernateUtil.GetSession())
            {
                try
                {
                    #region Plano
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    StringBuilder sqlFromPlano = new StringBuilder("FROM TB_MODELO_CONTRATO_PLANOPROD  A ")
                                                        .AppendLine("LEFT JOIN TB_MODELO_CONTRATO B ")
                                                        .AppendLine("ON(A.ID_CONTRATO = B.ID) ")
                                                        .AppendLine(" LEFT JOIN TB_PLANO C ON A.ID_PLANO = C.ID ")
                                                        .AppendLine("LEFT JOIN TB_PRODUTO D ON A.ID_PRODUTO = D.ID");


                    List<String> condicoesPlano = new List<String>();

                    if (request.soativos)
                    {
                        condicoesPlano.Add($"C.SITUACAOPLANO = 1");
                    }

                    if (request.id.HasValue)
                    {
                        condicoesPlano.Add($"UPPER(A.ID) = {request.id}");
                    }
                    foreach (String objetoReference in request.idpai)
                    {
                        if (!String.IsNullOrEmpty(objetoReference))
                        {
                            condicoesPlano.Add($"B.ID IN (SELECT B.ID FROM TB_MODELO_CONTRATO B LEFT JOIN TB_MODELO_CONTRATO_PLANOPROD  A ON(A.ID_CONTRATO = B.ID) WHERE  A.DESCRICAO LIKE '%{objetoReference}%')");
                        }

                    }

                    if (request.config != null)
                    {

                        param = request.config.Select(p => Convert.ToInt32(p)).ToList();
                        condicoesPlano.Add($"C.TIPO_TECNOLOGIA IN  ({String.Join(",", param)})");
                    }

                    if (request != null && !String.IsNullOrEmpty(request.q))
                    {
                        condicoesPlano.Add($" UPPER(A.DESCRICAO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 100)}%'");
                    }

                    if (condicoesPlano.Count() > 0)
                    {
                        sqlFromPlano.AppendLine($" WHERE B.PLANO_ESPECIFICO_COMBO = 1 AND ( {String.Join(" AND ", condicoesPlano)} ) ");
                    }

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) AS CO ");
                        sql.AppendLine(sqlFromPlano.ToString());

                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            if (await reader.ReadAsync())
                                retorno.total_count = Convert.ToInt32(reader["CO"]);
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder(" SELECT A.ID, A.DESCRICAO, B.DESCRICAO AS DESCRICAO_CONTRATO, B.ID ID_CONTRATO ")
                        .AppendLine(sqlFromPlano.ToString())
                        .AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new ObjComboResultIdContrato
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"]),
                                    DescricaoContrato = Convert.ToString(reader["DESCRICAO_CONTRATO"]),
                                    Id_Contrato = Convert.ToInt64(reader["ID_CONTRATO"]),
                                    Reference = new List<String>()
                                };
                                obj.Reference.AddRange(request.idpai.Where(p => p != null));
                                obj.Reference.Add(obj.Text);
                                //obj.Status_PlanoProduto_Str = HtmlEnumExtensions.GetEnumDescription<Status_PlanoProduto>(obj.Status_PlanoProduto.Value);

                                retorno.results.Add(obj);
                            }
                        }
                    }

                    #endregion                
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }
            return retorno;

        }

        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetComboClassificacaoTributaria")]
        public async Task<ObjCombo<Int64?>> GetCombo(RequestObjCombo<Int64?> request)
        {
            ObjCombo<Int64?> retorno = new ObjCombo<Int64?>
            {
                results = new List<IObjComboResult<Int64?>>()
            };

            using (ISession session = HibernateUtil.GetSession())
            {
                try
                {
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    StringBuilder sqlFrom = new StringBuilder("FROM TB_CONFIGURACAO_TRIBUTARIA A ");

                    List<String> condicoes = new List<String>();


                    if (request.id.HasValue)
                    {
                        condicoes.Add($"UPPER(A.ID) = {request.id}");
                    }

                    if (request != null && !String.IsNullOrEmpty(request.q))
                    {
                        condicoes.Add($"( UPPER(A.CODIGO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 5)}%' OR " +
                                      $" UPPER(A.DESCRICAO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 100)}%')");
                    }

                    if (request.soativos)
                    {
                        condicoes.Add("A.STATUS = 1");
                    }

                    if (condicoes.Count() > 0)
                    {
                        sqlFrom.AppendLine($"WHERE ( {String.Join(" AND ", condicoes)} ) ");
                    }

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) AS CO ");
                        sql.AppendLine(sqlFrom.ToString());

                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            if (await reader.ReadAsync())
                                retorno.total_count = Convert.ToInt32(reader["CO"]);
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT A.ID, A.CODIGO, A.DESCRICAO ");
                        sql.AppendLine(sqlFrom.ToString());
                        sql.AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new ObjComboResult<Int64?>
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = $"{Convert.ToString(reader["CODIGO"])} - {Convert.ToString(reader["DESCRICAO"])}"
                                };

                                retorno.results.Add(obj);
                            }
                        }
                    }
                }

                catch (Exception ex)
                {
                    throw ex;
                }
            }
            return retorno;

        }

