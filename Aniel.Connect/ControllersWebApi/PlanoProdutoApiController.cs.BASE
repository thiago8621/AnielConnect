                    Cliente_Plano_ProdutoViewModel modelo = GetViewObj(await repository.selectFirst(p => p.Id == Id));
                    retorno.Objeto = new Cliente_Plano_ProdutoViewModel
                    {
                        Id = modelo.Id,
                        Cod_Area = modelo.Cod_Area,
                        Cod_Escritorio = modelo.Cod_Escritorio,
                        Cod_Localidade = modelo.Cod_Localidade,
