                        {
                            if (await reader.ReadAsync())
                                retorno.total_count += Convert.ToInt32(reader["CO"]);
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT B.ID, A.CODIGO, A.DESCRICAO ");
                        sql.AppendLine(sqlFromProduto.ToString());
                        sql.AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new ClienteVinculoONUCombo
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"]),

                                };

                                retorno.results.Add(obj);
                            }
                        }
                    }
                    #endregion
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }
            return retorno;

        }

        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetList")]
        public async Task<GetApiRetorno<List<Cliente_ListaLoginRadius>>> GetListLogin(Int64 Id_Cliente)
        {
            GetApiRetorno<List<Cliente_ListaLoginRadius>> retorno = new GetApiRetorno<List<Cliente_ListaLoginRadius>>
            {
                Objeto = new List<Cliente_ListaLoginRadius>()
            };

            using (ISession session = HibernateUtil.GetSession())
            using (var repoCliente_PlanoProduto = new Conexao<Cliente_PlanoProduto>(session))
            {
                try
                {
                    var listaPlanos = await repoCliente_PlanoProduto.queryover().Where(p => p.Cliente.Id == Id_Cliente && p.Status != Status_PlanoProduto.Cancelado).ListAsync();

                    retorno.Objeto.AddRange(listaPlanos.Select(p => new Cliente_ListaLoginRadius
                    {
                        Login = p.Login_Radius,
                        Plano = p.Plano.Descricao
                    }));

                    retorno.Ok = true;
                }
                catch (Exception ex)
                {
                    retorno.Mensagem = ex.Message;
                    if (ex.InnerException != null) retorno.InnerException += ex.InnerException.Message;
                }
            }
            return retorno;

        }

