        [HttpPost()]
        [Route("api/PlanoProdutoapi/AlterarStatus")]
        public async Task<GetApiRetorno<Int64>> AlterarStatus(AlterarStatusViewModel value)
        {
            GetApiRetorno<Int64> retorno = new GetApiRetorno<Int64>();
            try
            {
                Response responseRadius = new Response();
                Cliente_PlanoProduto atualizarPlano = new Cliente_PlanoProduto();
                using (ISession session = HibernateUtil.GetSession())
                {
                    using (var repoPlanoProduto = new Conexao<Cliente_PlanoProduto>(session))
                    using (var repoStatusLog = new Conexao<Cliente_PlanoProduto_StatusLog>(session))
                    using (var repoMotivoCanc = new Conexao<Motivo_Cancelamento_PlanoProduto>(session))
                    using (var repoClienteContrato = new Conexao<ClienteContrato>(session))
                    {
                        //var planos = await repoPlanoProduto.select(p => p.ClienteContrato.Id.IsIn(value.ids));

                        var planos = (await repoPlanoProduto.select(p => p.Id.IsIn(value.ids)));                                                                        
                        Cliente_PlanoProduto_StatusLog atualizaPlanoLog = new Cliente_PlanoProduto_StatusLog();                                               

                        foreach (var obj in planos)
                        {                            
                            ClienteContrato clienteContrato = await repoClienteContrato.selectFirst(contrato => contrato.Id == obj.ClienteContrato.Id);                           

                            if (value.status == 8)  //Status passado p/ mudança de Plano
                            {
                                List<Cliente_PlanoProduto_StatusLog> statusLogLista = (await repoStatusLog.select(p => p.PlanoProduto.Id == clienteContrato.Id)).ToList();
                                Cliente_PlanoProduto_StatusLog statusAnteriorLog = statusLogLista.OrderBy(p => p.DataHoraAcao).LastOrDefault();

                                Status_PlanoProduto? statusAnterior = statusAnteriorLog?.NovoStatus;

                                atualizaPlanoLog = new Cliente_PlanoProduto_StatusLog
                                {
                                    AntigoStatus = statusAnterior,
                                    NovoStatus = obj.Status,
                                    PlanoProduto = obj,
                                    ClienteContrato = clienteContrato,
                                    DataHoraAcao = DateTime.Now
                                };

                                obj.Status = statusAnterior;
                            }
                            else
                            {
                                atualizaPlanoLog = new Cliente_PlanoProduto_StatusLog
                                {
                                    AntigoStatus = obj.Status,
                                    NovoStatus = (Status_PlanoProduto)value.status,
                                    PlanoProduto = obj,
                                    ClienteContrato = clienteContrato,
                                    DataHoraAcao = DateTime.Now
                                };

                                obj.Status = (Status_PlanoProduto)value.status;
                            

                                switch((Status_PlanoProduto)value.status)
                                {
                                    case Status_PlanoProduto.Cancelado:
                                        if(value.id_motivo_cancelamento.HasValue)
                                        {
                                            Motivo_Cancelamento_PlanoProduto motivo = (await repoMotivoCanc.selectFirst(p => p.Id == value.id_motivo_cancelamento));
                                            obj.Motivo_Cancelamento = motivo;
                                        }

                                        if (obj?.Cliente?.Id != null && obj?.Plano?.Id != null && obj?.ClienteContrato?.Id != null)
                                        {
                                            using (var webHook = new WebHookApiController())
                                            {
                                                await webHook.ExecutaCancelamentoPlano(User.Identity.GetUserId(), obj.Cliente.Id, obj.Plano.Id, obj.ClienteContrato.Id, DateTime.Now);
                                            }

                                            if (obj.Plano?.AutenticacaoRadius == true) 
                                            {
                                                using (var apiRadius = new IntegracaoRadiusApiController())
                                                {
                                                    responseRadius = await apiRadius.BloquearUsuario(new PlanoProdutoRadiusRequest
                                                    {
                                                        IdClientePlanoProduto = obj.Id
                                                    });

                                                    if (!responseRadius.result)
                                                        responseRadius.message = "Status do plano foi alterado porém não foi possível bloquear o Login.";
                                                }
                                            }                                            

                                            if (obj.Plano.Tipo_Tecnologia == Tipo_Tecnologia.Servicos_Adicionais && 
                                                !String.IsNullOrEmpty(obj.Plano.ProductId))
                                            {
                                                IIntegracaoExternaRepository repoIntegracaoExterna = new IntegracaoExternaRepository(session);
                                                var integracaoExternaBusiness = new IntegracaoExternaBusiness(repoIntegracaoExterna);

                                                IntegracoesExternas dadosIntegracaoPlayhub =
                                                    integracaoExternaBusiness.GetIntegracaoExterna(EnumTipoIntegracao.OUTROS, IntegracaoExterna.PLAYHUB);

                                                if (dadosIntegracaoPlayhub != null)
                                                {
                                                    if (String.IsNullOrEmpty(dadosIntegracaoPlayhub.ApiKey) ||
                                                        String.IsNullOrEmpty(dadosIntegracaoPlayhub.ApiSecret))
                                                    {
                                                        throw new Exception("Integração com a API do Playhub não configurada corretamente");
                                                    }

                                                    IPlayhubRepository repoPlayhub = new PlayhubApiRepository(dadosIntegracaoPlayhub.ApiKey, dadosIntegracaoPlayhub.ApiSecret);
                                                    var playhubBusiness = new PlayhubBusiness(repoPlayhub);

                                                    if (!String.IsNullOrEmpty(obj.Cliente.UsuarioPlayhub))
                                                    {
                                                        playhubBusiness.RemoverPlanoUsuario(obj.Cliente.UsuarioPlayhub, obj.Plano.ProductId);
                                                    }
                                                }
                                            }
                                        }

                                        break;
                                    case Status_PlanoProduto.Habilitado:
                                        if(obj.Plano?.AutenticacaoRadius == true) 
                                        {
                                            using (var apiRadius = new IntegracaoRadiusApiController())
                                            {
                                                responseRadius = await apiRadius.DesbloquearUsuario(new PlanoProdutoRadiusRequest
                                                {
                                                    IdClientePlanoProduto = obj.Id
                                                });

                                                if (!responseRadius.result)
                                                    responseRadius.message = "Status do plano foi alterado porém não foi possível desbloquear o Login.";
                                            }
                                        }                                        
                                        break;
                                    case Status_PlanoProduto.Suspenso_Empresa:
                                        if (obj.Plano?.AutenticacaoRadius == true) 
                                        {
                                            using (var apiRadius = new IntegracaoRadiusApiController())
                                            {
                                                responseRadius = await apiRadius.BloquearUsuario(new PlanoProdutoRadiusRequest
                                                {
                                                    IdClientePlanoProduto = obj.Id
                                                });

                                                if (!responseRadius.result)
                                                    responseRadius.message = "Status do plano foi alterado porém não foi possível bloquear o Login.";
                                            }
                                        }                                        
                                        break;
                                }
                            }
                            
                            obj.Atualiza_Ola = true;
                            atualizarPlano = obj;

                            await repoPlanoProduto.SaveOrUpdate(atualizarPlano);
                            await repoStatusLog.SaveOrUpdate(atualizaPlanoLog);                            
                        }                        
                    }
                }
                retorno.Objeto = (Int64)atualizarPlano.Status;

                //Se o Radius não conseguir desbloquear/bloquear o login com sucesso, 
                //permite realizar a mudança de status mas traz notificação do ocorrido.
                if (!responseRadius.result)
                    retorno.Mensagem = responseRadius.message;

                retorno.Ok = true;
            }
            catch (Exception ex)
            {
                retorno.Ok = false;
                retorno.Mensagem = ex.Message;
                retorno.InnerException = ex.InnerException != null ? ex.InnerException.Message : String.Empty;
                CONSTANTES.log4Net.Error(ex.Message, ex);
            }

            return retorno;
        }

        [HttpPost()]
        [Route("api/PlanoProdutoApi/excluirlista")]
        public async Task<PostApiRetorno<Int64>> ExcluirLista(ExcluirListaViewModel value)
        {
            PostApiRetorno<Int64> retorno = new PostApiRetorno<Int64>();
            try
            {
                using (ISession session = HibernateUtil.GetSession())
                {
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();
                    using (var com = session.Connection.CreateCommand())
                    {
                        String _ids = $"({String.Join(",", value.ids)})";

                        StringBuilder sql = new StringBuilder($"DELETE FROM TB_DESCONTO WHERE ID IN {_ids}");

                        await CommandHelper.ExecuteNonQuery(com, sql, new Dictionary<String, Object>(), session.Connection, null);

                        retorno.Ok = true;
                    }
                }
            }
            catch (Exception ex)
            {
                retorno.Mensagem = ex.Message;
                retorno.InnerException = ex.InnerException != null ? ex.InnerException.Message : String.Empty;
            }

            return retorno;
        }

        [HttpPost()]
        [Route("api/PlanoProdutoApi/AlterarDetalhesPlanoProduto")]
        public async Task<PostApiRetorno<Int64>> AlterarDetalhesPlanoProduto(PlanoProdutoListModel value, Forma_Pagamento_ClienteModels forma_Pagamento_Cliente = null, Int64? idCliente = null)
        {
            PostApiRetorno<Int64> retorno = new PostApiRetorno<Int64>();
            try
            {
                using (ISession session = HibernateUtil.GetSession())
                using (var repository = new Conexao<Cliente_PlanoProduto>(session))
                using (var repoForma_Pagamento_Cliente = new Conexao<Forma_Pagamento_Cliente>(session))
                {
                    var plano_produto = await repository.selectFirst(p => p.Id == value.Id);
                    plano_produto.Meses_Carencia = value.Meses_Carencia;
                    plano_produto.Parcelas_Instalacao = value.Numero_Parcelas;
                    plano_produto.Dias_Teste_Gratis = value.Qtde_Dias;
                    plano_produto.Valor_Final = Convert.ToDouble(value.ValorPlanoProduto_Final);
                    plano_produto.Valor_Instalacao_Final = Convert.ToDouble(value.ValorInstalacao_Final);
                    plano_produto.Valor_Final_Total = plano_produto.Valor_Final + plano_produto.Valor_Instalacao_Final;

                    if (forma_Pagamento_Cliente != null && idCliente.HasValue)
                    {
                        plano_produto.Forma_Pagamento_Cliente = await bindObjFormaPagamentoCliente(forma_Pagamento_Cliente, idCliente);
                    }

                    await repository.SaveOrUpdate(plano_produto);

                    retorno.Ok = true;
                }
            }
            catch (Exception ex)
            {
                retorno.Mensagem = ex.Message;
                retorno.InnerException = ex.InnerException != null ? ex.InnerException.Message : String.Empty;
            }

            return retorno;
        }

        [HttpPost]
        [Route("api/Plano_Produtoapi/AlterarFormaPagtoPlanoProduto")]
        public async Task<PostApiRetorno<Int64>> AlterarFormaPagtoPlanoProduto(Forma_Pagamento_ClienteModels value)
        {
            PostApiRetorno<Int64> retorno = new PostApiRetorno<Int64>();
            try
            {
                using (ISession session = HibernateUtil.GetSession())
                using (var repository = new Conexao<Cliente_PlanoProduto>(session))
                using (var repoForma_Pagamento_Cliente = new Conexao<Forma_Pagamento_Cliente>(session))
                {
                    var plano_produto = await repository.selectFirst(p => p.Id == value.Id_PlanoProduto);
                    Forma_Pagamento_Cliente forma_Pagamento_Cliente = await bindObjFormaPagamentoCliente(value, value.Id_Cliente);

                    if (value.Id == 0)
                    {
                        await repoForma_Pagamento_Cliente.SaveOrUpdate(forma_Pagamento_Cliente);
                        forma_Pagamento_Cliente = await repoForma_Pagamento_Cliente.selectFirst(p => p.Cliente.Id == value.Id_Cliente && p.Forma_Pagamento.Id == value.Id_Forma_Pagamento);
                    }

                    plano_produto.Forma_Pagamento_Cliente = forma_Pagamento_Cliente;

                    await repository.SaveOrUpdate(plano_produto);
                    retorno.IdObjeto = forma_Pagamento_Cliente.Id;
                    retorno.Ok = true;

                }
            }
            catch (Exception ex)
            {
                retorno.Mensagem = ex.Message;
                retorno.InnerException = ex.InnerException != null ? ex.InnerException.Message : String.Empty;
            }

            return retorno;
        }

        [HttpPost]
        [Route("api/Plano_Produtoapi/AlterarPlanoProduto")]
        public async Task<PostApiRetorno<Int64>> AlterarPlanoProduto(Cliente_Plano_ProdutoViewModel value)
        {
            PostApiRetorno<Int64> retorno = new PostApiRetorno<Int64>();
            try
            {
                using (ISession session = HibernateUtil.GetSession())
                using (var repository = new Conexao<Cliente_PlanoProduto>(session))
                using (var repoForma_Pagamento_Cliente = new Conexao<Forma_Pagamento_Cliente>(session))
                {
                    var plano_produto = await repository.selectFirst(p => p.Id == Convert.ToInt64(value.Id_Plano_Produto));
                    Cliente_PlanoProduto plano_Produto_Clietne = await BindObjPlanoProdutoCliente(value, value.Id_Cliente);
                    //Forma_Pagamento_Cliente forma_Pagamento_Cliente = await bindObjFormaPagamentoCliente(value, value.Cliente.Id);

                    if (value.Id == 0)
                    {
                        await repository.SaveOrUpdate(plano_Produto_Clietne);
                        plano_Produto_Clietne = await repository.selectFirst(p => p.Cliente.Id == value.Id_Cliente && (p.Plano.Id == Convert.ToInt64(value.Id_Plano_Produto) || p.Produto.Id == Convert.ToInt64(value.Id_Plano_Produto)));
                    }

                    plano_produto.Id = plano_Produto_Clietne.Id;
                    plano_produto.Valor_Final = plano_Produto_Clietne.Valor_Final;
                    plano_produto.Plano.Id = plano_Produto_Clietne.Plano.Id;

                    await repository.SaveOrUpdate(plano_produto);
                    retorno.IdObjeto = plano_Produto_Clietne.Id;
                    retorno.Ok = true;

                }
            }
            catch (Exception ex)
            {
                retorno.Mensagem = ex.Message;
                retorno.InnerException = ex.InnerException != null ? ex.InnerException.Message : String.Empty;
            }

            return retorno;
        }

        [Route("api/Plano_Produtoapi/ExcluirGrid")]
        [HttpGet()]
        public async Task<DeleteApiRetorno<Int64>> ExcluirGrid(Int64 value, String usuario)
        {
            DeleteApiRetorno<Int64> retorno = new DeleteApiRetorno<Int64>();

            try
            {
                using (ISession session = HibernateUtil.GetSession())
                {
                    using (var repository = new Conexao<Cliente_PlanoProduto>(session))
                    {

                        Cliente_PlanoProduto modelo = null;
                        if (value != 0)
                        {
                            modelo = (await repository.select(p => p.Id == value)).FirstOrDefault();
                            modelo.Status = Status_PlanoProduto.Cancelado;
                            modelo.UsuarioAlteracao = usuario;

                            await repository.SaveOrUpdate(modelo);

                            //repository.Remove(modelo);

                            retorno.IdObjeto = modelo.Id;
                            retorno.Ok = true;
                        }
                        else
                        {
                            throw new Exception(Resources.RsBase.NAOENCONTRADO);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                retorno.IdObjeto = 0;
                retorno.Mensagem = ex.Message;
                if (ex.InnerException != null) retorno.InnerException = ex.InnerException.Message;
            }

            return retorno;
        }

        [HttpGet()]
        [Route("api/Planoproduto/PossuiPlanoProduto")]
        public async Task<GetApiRetorno<Boolean>> PossuiPlanoProduto(Int64? Id_Plano_Produto, Int64 Id_Cliente)
        {
            GetApiRetorno<Boolean> retorno = new GetApiRetorno<Boolean>();

            using (ISession session = HibernateUtil.GetSession())
            using (var repoCliente_PlanoProduto = new Conexao<Cliente_PlanoProduto>(session))
            {
                try
                {
                    var planos_produtos = await repoCliente_PlanoProduto.select(p => p.Cliente.Id == Id_Cliente);
                    planos_produtos = planos_produtos.Where(p => p.Status != Status_PlanoProduto.Venda_Cancelada).ToList();
                    var planos = planos_produtos.Where(p => p.Plano != null).Where(p => p.Plano.Id == Id_Plano_Produto);
                    var produtos = planos_produtos.Where(p => p.Produto != null).Where(p => p.Produto.Id == Id_Plano_Produto);

                    if (produtos.Count() > 0 || planos.Count() > 0)
                    {
                        retorno.Objeto = true;
                    }
                    else
                    {
                        retorno.Objeto = false;

                    }
                    retorno.Ok = true;

                }
                catch (Exception ex)
                {
                    retorno.Ok = false;
                    throw ex;

                }
            }

            return retorno;
        }

        public async Task InativarPlanoProdutoForaValidade()
        {
            using (ISession session = HibernateUtil.GetSession())
            using (var reposioryPlano = new Conexao<Plano>(session))
            using (var reposioryProduto = new Conexao<Produto>(session))
            {
                try
                {
                    var lista_planos_desativados = (await reposioryPlano.select(p => p.Validade != null && p.Validade <= DateTime.Now && p.SituacaoPlano == Situacao_plano.Ativo)).
                                                    Select(plano => { plano.SituacaoPlano = Situacao_plano.Inativo; plano.Validade = null; return plano; });

                    var lista_produtos_desativados = (await reposioryProduto.select(p => p.Data_Validade != null && p.Data_Validade <= DateTime.Now && p.Situacao == Situacao_Produto.Ativo))
                                                    .Select(produto => { produto.Situacao = Situacao_Produto.Inativo; produto.Data_Validade = null; return produto; });

                    await reposioryPlano.SaveOrUpdate(lista_planos_desativados.ToList());
                    await reposioryProduto.SaveOrUpdate(lista_produtos_desativados.ToList());

                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }
        }

        public async Task<Forma_Pagamento_Cliente> bindObjFormaPagamentoCliente(Forma_Pagamento_ClienteModels Forma_Pagto_ClienteModel, Int64? idCliente)
        {
            Endereco_Cliente enderecoCobranca = new Endereco_Cliente();

            using (ISession session = HibernateUtil.GetSession())
            using (var repoBanco = new Conexao<Banco>(session))
            using (var repoPais = new Conexao<Pais>(session))
            using (var repoTipoImovel = new Conexao<Tipo_Imovel>(session))
            using (var repoForma_Pagamento = new Conexao<Forma_Pagamento>(session))
            using (var repoVencimento = new Conexao<Vencimento>(session))
            using (var repoCliente = new Conexao<Cliente>(session))
            using (var repoForma_Pagamento_Cliente = new Conexao<Forma_Pagamento_Cliente>(session))
            {
                if (Forma_Pagto_ClienteModel.Id != 0)
                {
                    return await repoForma_Pagamento_Cliente.selectFirst(f => f.Id == Forma_Pagto_ClienteModel.Id);
                }
                else
                {
                    if (Forma_Pagto_ClienteModel.End_Cobranca_Igual_Principal)
                    {
                        var cliente = await repoCliente.selectFirst(c => c.Id == idCliente.Value);
                        enderecoCobranca.Pais = cliente.Endereco_Principal.Pais;
                        enderecoCobranca.Tipo_Imovel = cliente.Endereco_Principal.Tipo_Imovel;
                        enderecoCobranca.Id_Bairro = cliente.Endereco_Principal?.Id_Bairro;
                        enderecoCobranca.Id_Cidade = cliente.Endereco_Principal?.Id_Cidade;
                        enderecoCobranca.Bairro = cliente.Endereco_Principal?.Bairro;
                        enderecoCobranca.Cep = cliente.Endereco_Principal?.Cep;
                        enderecoCobranca.Cidade = cliente.Endereco_Principal?.Cidade;
                        enderecoCobranca.Complemento = cliente.Endereco_Principal?.Complemento;
                        enderecoCobranca.Latitude = cliente.Endereco_Principal?.Latitude;
                        enderecoCobranca.Longitude = cliente.Endereco_Principal?.Longitude;
                        enderecoCobranca.Logradouro = cliente.Endereco_Principal?.Logradouro;
                        enderecoCobranca.Numero = cliente.Endereco_Principal?.Numero;
                        enderecoCobranca.Ponto_Referencia = cliente.Endereco_Principal?.Ponto_Referencia;
                        enderecoCobranca.UF = cliente.Endereco_Principal?.UF;
                    }
                    else
                    {
                        enderecoCobranca.Pais = Forma_Pagto_ClienteModel.Id_PaisCobranca != null ? repoPais.selectFirst(p => p.Id == Forma_Pagto_ClienteModel.Id_PaisCobranca.Value).Result : null;
                        enderecoCobranca.Tipo_Imovel = Forma_Pagto_ClienteModel.Id_Tipo_ImovelCobranca != null ? repoTipoImovel.selectFirst(p => p.Cod_Tipo_Imovel == Forma_Pagto_ClienteModel.Id_Tipo_ImovelCobranca.Value).Result : null;
                        enderecoCobranca.Id_Bairro = Forma_Pagto_ClienteModel?.Id_BairroCobranca;
                        enderecoCobranca.Id_Cidade = Forma_Pagto_ClienteModel?.Id_CidadeCobranca;
                        enderecoCobranca.Bairro = Forma_Pagto_ClienteModel?.BairroCobranca;
                        enderecoCobranca.Cep = Forma_Pagto_ClienteModel?.CEPCobranca;
                        enderecoCobranca.Cidade = Forma_Pagto_ClienteModel?.CidadeCobranca;
                        enderecoCobranca.Complemento = Forma_Pagto_ClienteModel?.ComplementoCobranca;
                        enderecoCobranca.Latitude = Forma_Pagto_ClienteModel?.LatitudeCobranca != null ? Convert.ToDouble(Forma_Pagto_ClienteModel?.LatitudeCobranca?.Replace('.', ',')) : (Double?)null;
                        enderecoCobranca.Longitude = Forma_Pagto_ClienteModel?.LongitudeCobranca != null ? Convert.ToDouble(Forma_Pagto_ClienteModel?.LongitudeCobranca?.Replace('.', ',')) : (Double?)null;
                        enderecoCobranca.Logradouro = Forma_Pagto_ClienteModel?.LogradouroCobranca;
                        enderecoCobranca.Numero = Forma_Pagto_ClienteModel?.NumeroCobranca;
                        enderecoCobranca.Ponto_Referencia = Forma_Pagto_ClienteModel?.Ponto_ReferenciaCobranca;
                        enderecoCobranca.UF = Forma_Pagto_ClienteModel?.UFCobranca;
                    }

                    return new Forma_Pagamento_Cliente
                    {
                        Cliente = idCliente.HasValue ? repoCliente.selectFirst(p => p.Id == idCliente).Result : null,
                        Agencia = Forma_Pagto_ClienteModel.Agencia,
                        Banco = Forma_Pagto_ClienteModel.Id_Banco.HasValue ? repoBanco.selectFirst(p => p.Id == Forma_Pagto_ClienteModel.Id_Banco.Value).Result : null,
                        Conta_Corrente = Forma_Pagto_ClienteModel.Conta_Corrente,
                        Dia_Vencimento = Forma_Pagto_ClienteModel.Dia_Vencimento,
                        Digito = Forma_Pagto_ClienteModel.Digito,
                        Forma_Envio = Forma_Pagto_ClienteModel.Forma_Envio,
                        Forma_Pagamento = Forma_Pagto_ClienteModel.Id_Forma_Pagamento.HasValue ? repoForma_Pagamento.selectFirst(p => p.Id == Forma_Pagto_ClienteModel.Id_Forma_Pagamento.Value).Result : null,
                        Vencimento = Forma_Pagto_ClienteModel.Id_Vencimento.HasValue ? repoVencimento.selectFirst(p => p.Id == Forma_Pagto_ClienteModel.Id_Vencimento.Value).Result : null,
                        Status = Status_Default.Ativo,
                        Endereco_Cobranca = enderecoCobranca
                    };
                }
            }
        }
