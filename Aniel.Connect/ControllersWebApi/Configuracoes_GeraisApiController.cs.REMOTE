            objBanco.Padrao_Login_Ultimo = Padrao_Login_RegexReplacer(view.Padrao_Login_Ultimo);

            objBanco.Usuario_APIANIEL = view.UsuarioApiAniel;
            objBanco.Senha_APIANIEL = view.SenhaApiAniel;
            objBanco.Token_APIANIEL = view.TokenApiAniel;
                
            objBanco.Criacao_Atendimento_Email = view.Utilizar_Criacao_Email_Atendimento;
            objBanco.Criacao_Atendimento_DominioEmail = view.Utilizar_Criacao_Dominio_Email_Atendimento;

            //objBanco.Trava_Atendimento_OS = view.Trava_Atendimento_OS;
