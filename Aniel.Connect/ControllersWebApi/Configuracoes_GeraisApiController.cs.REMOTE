        [HttpGet]
        [Route("api/Configuracoes_Geraisapi/Venda_Atendimento")]
        public async Task<GetApiRetorno<bool>> getConfigAtendimento()
        {
            var retorno = new GetApiRetorno<bool>();
            try
            {
                using (ISession session = HibernateUtil.GetSession())
                using (var comm = session.Connection.CreateCommand())
                {

                    var sql = new StringBuilder();
                    sql.AppendLine("SELECT First 1 A.GERAR_ATEND_APOS_VENDA AS ATENDIMENTO FROM TB_CONFIGURACOES A");

                    using (var reader = await CommandHelper.ExecuteReader(comm, sql, session.Connection, null))
                        if (await reader.ReadAsync())
                        {
                            retorno.Objeto = Convert.ToBoolean(reader["ATENDIMENTO"]);
                        }
                    retorno.Ok = true;
                }
            }
            catch (Exception err)
            {
                retorno.Ok = false;
                retorno.Objeto = false;
                retorno.Mensagem = err.Message;
            }
            return retorno;
        }

        [Route("api/Configuracoes_Geraisapi/ContaEmailEditar")]
        [HttpPost()]
        public async Task<PostApiRetorno<Int64>> ContaEmailEditar(EmailListaModel request)
        {
            PostApiRetorno<Int64> retorno = new PostApiRetorno<Int64>();
            retorno.Ok = true;

            try
            {
                using (ISession session = HibernateUtil.GetSession())
                using (var repository = new Conexao<Conta_Email>(session))
                {

                    Conta_Email conta = await repository.selectFirst(p => p.Id == request.Id);

                    if (conta != null)
                    {
                        conta.Email = request.Email;
                        conta.Senha = request.Senha;
                        conta.Servidor_Smtp = request.ServidorEnvio;
                        conta.Porta_Smtp = Convert.ToInt32(request.PortaEnvio);
                        conta.Servidor_Imap = request.ServidorRecebimento;
                        conta.Porta_Imap = Convert.ToInt32(request.PortaRecebimento);
                        conta.Utilizar_Ssl_Imap = request.Utilizar_SSL_Imap;
                        conta.Utilizar_Ssl_Smtp = request.Utilizar_SSL_Smtp;
                        conta.AuthMethodImap = request.AuthMethodImap;
                        conta.Principal = request.Principal;
                        await repository.Update(conta);
                    }
                    else
                    {
                        throw new Exception(Resources.RsBase.NAOENCONTRADO);
                    }

                }
            }
            catch (Exception ex)
            {
                retorno.IdObjeto = 0;
                retorno.Mensagem = ex.Message;
                if (ex.InnerException != null) retorno.InnerException = ex.InnerException.Message;
            }

            return retorno;
        }

        /// <summary>
        /// Endpoint específico para captura de informações para Baixa de Os no local do cliente
        /// </summary>
        /// <returns></returns>
        [AllowAnonymous]
        [HttpGet]
        [Route("api/Configuracoes_Geraisapi/GetConfigEspacoBaixaOS")] 
        public GetApiRetorno<ConfiguracoesRestricoesLocalBaixaOs> GetConfigEspacoBaixaOS() 
        {            
            var retorno = new GetApiRetorno<ConfiguracoesRestricoesLocalBaixaOs>();
            ConfiguracoesRestricoesLocalBaixaOs dados = new ConfiguracoesRestricoesLocalBaixaOs();

            try 
            {
                using (ISession session = HibernateUtil.GetSession())
                using (var repository = new Conexao<Configuracoes_Gerais>(session))
                using (var DbCommand = session.Connection.CreateCommand())
                {
                    IConfiguracoesGeraisRepository repo = new ConfiguracoesGeraisRepository(session);
                    var config = repo.GetConfiguracoesGerais();

                    dados.CriticarBaixaLocalServico = config.CriticarBaixaLocalServico;
                    dados.LimiteDistanciaBaixa = config.LimiteDistanciaBaixa;

                }
            }
            catch (Exception ex) 
            {
                retorno.Ok = false;
                retorno.Mensagem = ex.Message;
            }
            finally 
            {
                retorno.Objeto = dados;
            }            
            return retorno;
        }

