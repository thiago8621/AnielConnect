        private String Padrao_Login_RegexReplacer(string param)
        {
            return String.IsNullOrEmpty(param) ? String.Empty : String.Concat(param.Where(character => !Char.IsWhiteSpace(character)));
        }

        [HttpPost()]
        [Route("api/Configuracoes_Geraisapi/AlterarStatus")]
        public async Task<PostApiRetorno<Int64>> AlterarStatus(AlterarStatusViewModel value)
        {
            PostApiRetorno<Int64> retorno = new PostApiRetorno<Int64>();
            try
            {
                using (ISession session = HibernateUtil.GetSession())
                {
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();
                    using (var com = session.Connection.CreateCommand())
                    {
                        String _ids = $"({String.Join(",", value.ids)})";

                        StringBuilder sql = new StringBuilder($"UPDATE TB_CONFIGURACOES_GERAIS SET STATUS = {value.status}, ATUALIZA_OLA = 1 WHERE ID IN {_ids}");

                        await CommandHelper.ExecuteNonQuery(com, sql, new Dictionary<String, Object>(), session.Connection, null);

                        retorno.Ok = true;
                    }
                }
            }
            catch (Exception ex)
            {
                retorno.Mensagem = ex.Message;
                retorno.InnerException = ex.InnerException != null ? ex.InnerException.Message : String.Empty;
            }

            return retorno;
        }


        [HttpGet()]
        [Route("api/Configuracoes_Geraisapi/FindById")]
        public async Task<GetApiRetorno<Configuracoes_GeraisCadastroModel>> FindById(Int64 Id)
        {
            GetApiRetorno<Configuracoes_GeraisCadastroModel> retorno = new GetApiRetorno<Configuracoes_GeraisCadastroModel>();

            using (ISession session = HibernateUtil.GetSession())
            using (var repositoryContaEmail = new Conexao<Conta_Email>(session))
            using (var repositoryIntegracaoExterna = new Conexao<IntegracoesExternas>(session))
            using (var repository = new Conexao<Configuracoes_Gerais>(session))
            using (var repositoryAcoesTermo = new Conexao<Acoes_Prova_Vida_Termo>(session))
            using (ISession sessionT5 = HibernateUtil.GetSessionT5())
            using (var masterRepository = new Conexao<Master>(sessionT5))
            {
                try
                {
                    retorno.Objeto = GetViewObj(await repository.selectFirst(p => p.Id == Id), await masterRepository.selectFirst());


                    var emails = repositoryContaEmail.select(p => p.Status == Status_Default.Ativo).Result;
                    retorno.Objeto.Emails = (emails.Count() == 0) ? new List<EmailListaModel>() :
                                                   emails.Select(p => new EmailListaModel
                                                   {
                                                       Id = p.Id,
                                                       Email = p.Email,
                                                       ServidorEnvio = p.Servidor_Smtp,
                                                       PortaEnvio = Convert.ToString(p.Porta_Smtp),
                                                       ServidorRecebimento = Convert.ToString(p.Servidor_Imap),
                                                       PortaRecebimento = Convert.ToString(p.Porta_Imap),
                                                       Utilizar_SSL_Imap = p.Utilizar_Ssl_Imap,
                                                       Utilizar_SSL_Smtp = p.Utilizar_Ssl_Smtp,
                                                       Principal = p.Principal,
                                                       Senha = p.Senha,
                                                       AuthMethodImap = p.AuthMethodImap,
                                                       AuthMethodImap_Descricao = HtmlEnumExtensions.GetEnumDescription<AuthMethodImap>(p.AuthMethodImap)
                                                   }).ToList();
                    
                    var integracoes = await repositoryIntegracaoExterna.select();
                    retorno.Objeto.Utilizar_Integracao_Externa = integracoes.Count() > 0;
                    retorno.Objeto.Integracoes = integracoes.Select(p => new IntegracoesExternasListaModel
                    {
                        Id = p.Id,
                        Usuario = p.Usuario ?? String.Empty,
                        UrlApi = p.UrlApi ?? String.Empty,
                        TipoIntegracaoDesc = HtmlEnumExtensions.GetEnumDescription<EnumTipoIntegracao>(p.TipoIntegracao) ?? String.Empty,
                        TipoIntegracao = p.TipoIntegracao,
                        IntegracaoDesc = HtmlEnumExtensions.GetEnumDescription<IntegracaoExterna>(p.IntegracaoExterna) ?? String.Empty,
                        Integracao = p.IntegracaoExterna,
                        Senha = p.Senha ?? String.Empty,
                        Token = p.TokenAcesso ?? String.Empty,
                        ApiKey = p.ApiKey ?? String.Empty,
                        ApiSecret = p.ApiSecret ?? String.Empty,
                        HeaderIntegracaoExterna1 = p.HeaderIntegracaoExterna1 ?? String.Empty
                    }).ToList();


                    if (retorno.Objeto.Tipo_Comprovante_Termo == Tipo_Comprovante_Termo.ProvaVida)
                    {
                        var acoes = await repositoryAcoesTermo.select();
                        string jsonString = JsonConvert.SerializeObject(acoes);
                        retorno.Objeto.Acoes_Prova_Vida = jsonString;
                    }

                    retorno.Ok = true;
                }
                catch (Exception ex)
                {
                    retorno.Mensagem = ex.Message;
                    if (ex.InnerException != null) retorno.InnerException += ex.InnerException.Message;
                }
            }
            return retorno;
        }

        [HttpGet]
        [Route("api/Configuracoes_GeraisApi/GetNomeEmpresa")]
        public String GetNomeEmpresa()
        {
            using (ISession session = HibernateUtil.GetSession())
            {
                var conf_gerais = new Conexao<Configuracoes_Gerais>(session).selectFirst().Result;

                return conf_gerais?.Nome_Cliente_Sinapse;
            }
        }

        [HttpPost()]
        [Route("api/Configuracoes_GeraisApi/Gravar")]
        public async Task<PostApiRetorno<Int64>> Gravar([FromBody] ParamWebApi<Configuracoes_GeraisCadastroModel> value)
        {
            PostApiRetorno<Int64> retorno = new PostApiRetorno<Int64>();

            try
            {
                Configuracoes_Gerais modelo = null;
                //   Configuracoes_Gerais modeloAnterior = null;

                using (ISession session = HibernateUtil.GetSession())

                {
                    using (var repository = new Conexao<Configuracoes_Gerais>(session))
                    using (ISession sessionLog = HibernateUtil.GetSessionLog())
                    using (var repositoryContaEmail = new Conexao<Conta_Email>(session))
                    using (var repositoryIntegracoesExterna = new Conexao<IntegracoesExternas>(session))
                    using (var repositoryAcoes = new Conexao<Acoes_Prova_Vida_Termo>(session))
                    using (var repositoryLog = new Conexao<LogConfigGeraisAniel>(sessionLog))
                    {
                        modelo = await repository.selectFirst();

                        IConfiguracoesGeraisRepository configuracoesGeraisRepository = new ConfiguracoesGeraisRepository(session);
                        ConfiguracoesGeraisBusiness business = new ConfiguracoesGeraisBusiness(configuracoesGeraisRepository);


                        if (modelo == null)
                        {
                            modelo = new Configuracoes_Gerais
                            {
                                //Status = Connect.Model.enumerado.Status_Default.Ativo
                                UsuarioCriacao = value.Usuario
                            };

                        }
                        else
                        {
                            //modelo.Status = value.Objeto.Status ? Status_Default.Ativo : Status_Default.Inativo;
                            modelo.UsuarioAlteracao = value.Usuario;
                        }


                        BindViewToObj(session, modelo, value.Objeto);
                        modelo.Atualiza_Ola = true;

                        if(String.IsNullOrEmpty(modelo.Uuid_Provedor_Ola))
                        {
                            modelo.Uuid_Provedor_Ola = Guid.NewGuid().ToString();
                        }

                        var emails = value.Objeto.Emails.Select(p => new Conta_Email
                        {
                            Id = p.Id,
                            Email = p.Email,
                            Porta_Imap = Convert.ToInt32(p.PortaRecebimento),
                            Servidor_Imap = p.ServidorRecebimento,
                            Servidor_Smtp = p.ServidorEnvio,
                            Porta_Smtp = Convert.ToInt32(p.PortaEnvio),
                            Senha = p.Senha,
                            Descricao = p.Email,
                            Status = Status_Default.Ativo,
                            Utilizar_Ssl_Imap = p.Utilizar_SSL_Imap,
                            Utilizar_Ssl_Smtp = p.Utilizar_SSL_Smtp,
                            Principal = p.Principal,
                            AuthMethodImap = p.AuthMethodImap
                        }).ToList();

                        var integracoes = value.Objeto.Integracoes.Select(p => new IntegracoesExternas
                        {
                            Id = p.Id,
                            TokenAcesso = p.Token,
                            Senha = p.Senha,
                            Usuario = p.Usuario,
                            UrlApi = p.UrlApi,

                            ApiKey = p.ApiKey,
                            ApiSecret = p.ApiSecret,

                            IntegracaoExterna = p.Integracao,
                            TipoIntegracao = p.TipoIntegracao,
                            EnviarTodosParametros = p.EnviarTodosParametros,

                            HeaderIntegracaoExterna1 = p.HeaderIntegracaoExterna1,

                        }).ToList();

                        var logs = modelo.GeraLog(modelo, value.Usuario, value.NomeUsuario, Sinapse.ModelLog.TipoOperLog.Alteracao);
                        await repositoryLog.Save(logs);


                        //Verificar configurações
                        var listaSalvar = new List<Acoes_Prova_Vida_Termo>();
                        var listaExistente = await repositoryAcoes.select();
                        if (value.Objeto.Tipo_Comprovante_Termo == Tipo_Comprovante_Termo.ProvaVida &&
                             !string.IsNullOrEmpty(value.Objeto.Acoes_Prova_Vida))
                        {
                            Dictionary<string, string> seuDicionario = JsonConvert.DeserializeObject<Dictionary<string, string>>(value.Objeto.Acoes_Prova_Vida);

                            foreach (var item in seuDicionario)
                            {
                                var acoes_prova = new Acoes_Prova_Vida_Termo
                                {
                                    Ordem = item.Key,
                                    Valor = item.Value
                                };

                                listaSalvar.Add(acoes_prova);
                            }

                            // Encontrar itens a serem inseridos
                            var itensParaInserir = listaSalvar.Where(item => !listaExistente.Any(existingItem => existingItem.Valor == item.Valor && existingItem.Ordem == item.Ordem));

                            // Encontrar itens a serem excluir
                            var itensParaExcluir = listaExistente.Where(existingItem => !listaSalvar.Any(item => item.Valor == existingItem.Valor && item.Ordem == existingItem.Ordem));

                            await repositoryAcoes.Remove(itensParaExcluir);
                            await repositoryAcoes.SaveOrUpdate(itensParaInserir);
                        }

                        try
                        {
                            
                            await repositoryIntegracoesExterna.SaveOrUpdate(integracoes);
                            await repositoryContaEmail.SaveOrUpdate(emails);
                            await repository.SaveOrUpdate(modelo);
                            business.AtualizarProvedor(CONSTANTES.SenhaOla, modelo);
                        }
                        catch (Exception ex)
                        {
                            CONSTANTES.log4Net.Error(ex.Message, ex);
                            Console.WriteLine(ex.Message);
                        }
                    }
                    retorno.IdObjeto = modelo.Id;
                    retorno.Ok = true;
                }

                using (ISession session = HibernateUtil.GetSessionT5())
                {
                    using (var repository = new Conexao<Master>(session))
                    {
                        Master master = await repository.selectFirst();
                        master.SLA_Data_Abertura = value.Objeto.SLA_Data_Abertura;
                        master.SLA_Servico_Padrao = modelo.SLA_Servico_Padrao;
                        master.Usa_Roteirizacao = modelo.Empresa_Roteirizacao_Servico ? "S" : "N";
                        master.Encerrar_Atendimento_OS = modelo.Encerrar_Atendimento_Junto_OS ? "S" : "N";
                        master.Deslocamento_Dinamico = modelo.Checkin_Checkout_Auto ? "S" : "N";
                        master.ConfigParalisaOS = value.Objeto.ConfigParalisaOS ? "S" : "N";
                        master.Autoriza_Baixa_Servico_Backoffice = value.Objeto.AutorizaBaixaServicoBackoffice ? "S" : "N";
                        await repository.SaveOrUpdate(master);

                    }
                }

            }
            catch (Exception ex)
            {
                retorno.IdObjeto = 0;
                retorno.Mensagem = ex.Message;
                if (ex.InnerException != null) retorno.InnerException = ex.InnerException.Message;
            }

            return retorno;
        }

        [HttpGet()]
