                }
            }
            return retorno;
        }

        [Route("api/Configuracoes_Geraisapi/ContaEmailExcluir")]
        [HttpGet()]
        public async Task<DeleteApiRetorno<Int64>> Excluir(Int64 id)
        {
            DeleteApiRetorno<Int64> retorno = new DeleteApiRetorno<Int64>();

            try
            {
                using (ISession session = HibernateUtil.GetSession())
                {
                    using (var repository = new Conexao<Conta_Email>(session))
                    using (var repositoryEmail = new Conexao<Email_Atendimento>(session))
                    {

                        Conta_Email modelo = null;
                        if (id != 0)
                        {

                            modelo = (await repository.select(p => p.Id == id)).FirstOrDefault();
                            var emails = await repositoryEmail.select(p => p.Conta_Email == modelo);
                            await repositoryEmail.Remove(emails);
                            await repository.Remove(modelo);

                            retorno.IdObjeto = modelo.Id;
                            retorno.Ok = true;
                        }

                        else
                        {
                            throw new Exception(Resources.RsBase.NAOENCONTRADO);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                retorno.IdObjeto = 0;
                retorno.Mensagem = ex.Message;
                if (ex.InnerException != null) retorno.InnerException = ex.InnerException.Message;
            }

            return retorno;
        }
        [Route("api/Configuracoes_Geraisapi/Excluir_IntegracaoExterna")]
