                catch (Exception ex)
                {
                    retorno.Mensagem = ex.Message;
                    if (ex.InnerException != null) retorno.InnerException += ex.InnerException.Message;
                }

                return retorno;
            }

        }

        private AlterarLoginRadiusViewModel GetViewObjLogin(Model.nhibernate.LoginRadius obj)
        {
            return new AlterarLoginRadiusViewModel
            {
                Id = obj.Id,

                IdPlanoProduto = obj.Cliente_PlanoProduto.Id,

                Login = obj.Login,
                Senha = obj.SenhaPPPOE,

                IdConcentradora = obj?.Concentradora?.Id,
                IdPool = obj?.Cliente_PlanoProduto?.Pool_Ip?.Id,
                Id_Pool_Ip_Endereco = obj?.Pool_Ip_Endereco?.Id
            };
        }

        private Cliente_Plano_ProdutoViewModel GetViewObj(Cliente_PlanoProduto obj)
        {
            using (ISession session = HibernateUtil.GetSession())
            using (var repository = new Conexao<Endereco_Cliente>(session))
            {
                return new Cliente_Plano_ProdutoViewModel
                {
                    Id = obj.Id,
                    Cod_Area = obj.Cod_Area,
                    Cod_Escritorio = obj.Cod_Escritorio,
                    Cod_Localidade = obj.Cod_Localidade,
                    Endereco_Instalacao = obj.Endereco_Instalacao != null ? repository.selectFirst(p => p.Id == obj.Endereco_Instalacao.Id).Result : null,

                };
            }

        }

        [HttpPost()]
        [Route("api/PlanoProdutoapi/GravarLogin")]
        public async Task<PostApiRetorno<Int64>> GravarLogin([FromBody] ParamWebApi<AlterarLoginRadiusViewModel> value)
        {
            PostApiRetorno<Int64> retorno = new PostApiRetorno<Int64>();
            try
            {
                Model.nhibernate.LoginRadius modelo = null;

                using (ISession session = HibernateUtil.GetSession())
                {
                    using (var apiIntegracao = new IntegracaoRadiusApiController())
                    using (var repository = new Conexao<Model.nhibernate.LoginRadius>(session))
                    {   
                        if (value.Objeto.Id != 0)
                            modelo = (await repository.select(p => p.Id == value.Objeto.Id)).FirstOrDefault();

                        if (modelo == null)
                        {
                            throw new Exception("Falha ao tentar encontrar o login. Por favor, tente novamente.");
                        }
                        else
                        {

                            var getView = new LoginRadiusApiController().GetViewObj(modelo, null);


                            getView.Login = value.Objeto.Login;
                            getView.SenhaPPPOE = value.Objeto.Senha;

                            if (value.Objeto.IdConcentradora.HasValue)
                            {
                                getView.Id_Concentradora = value.Objeto.IdConcentradora;
                            }

                            if (value.Objeto.IdPool.HasValue)
                            {
                                getView.Id_Pool = value.Objeto.IdPool.Value;

                                if (value.Objeto.Id_Pool_Ip_Endereco.HasValue)
                                {
                                    getView.Id_Pool_Ip_Endereco = value.Objeto.Id_Pool_Ip_Endereco;
                                }
                            }

                            ParamWebApi<LoginRadiusCadastroModel> paramWebApi = new ParamWebApi<LoginRadiusCadastroModel>
                            {
                                Objeto = getView,
                                Usuario = value.Objeto.Usuario

                            };

                            var gravarLoginRadius = await new LoginRadiusApiController().Gravar(paramWebApi);

                            if (gravarLoginRadius.Ok == true)
                            {
                                retorno.Ok = true;
                            }
                            else
                            {
                                throw new Exception(gravarLoginRadius.Mensagem ?? "Erro ao tentar gravar o login. Por favor, tente novamente mais tarde.", new Exception(gravarLoginRadius.Mensagem ?? gravarLoginRadius.InnerException));
                            }

                        }

                        retorno.IdObjeto = modelo.Id;

                    }
                }
            }
            catch (Exception ex)
            {
                CONSTANTES.log4Net.Error(ex.Message, ex);
                if (ex.Message == "Unable to connect to any of the specified MySQL hosts.")
                    retorno.Mensagem = Resources.RsCadastros.NAO_FOI_POSSIVEL_CONECTAR_RADIUS;
                else
                    retorno.Mensagem = ex.Message;

                retorno.InnerException = ex.InnerException != null ? ex.InnerException.Message : String.Empty;
            }

            return retorno;
        }

        [HttpPost()]
        [Route("api/PlanoProdutoapi/GravarPontoAcesso")]
        public async Task<PostApiRetorno<Int64>> GravarPontoAcesso([FromBody] ParamWebApi<AlterarPontoAcesso> value)
        {
            PostApiRetorno<Int64> retorno = new PostApiRetorno<Int64>();
            try
            {
                Cliente_PlanoProduto modelo = null;

                using (ISession session = HibernateUtil.GetSession())
                {
                    using (var repository_NAS = new Conexao<NAS>(session))
                    using (var repository_Pool_Ip = new Conexao<Model.nhibernate.Pool_Ip>(session))
                    using (var repository = new Conexao<Cliente_PlanoProduto>(session))
                    {
                        modelo = (await repository.select(p => p.Id == value.Objeto.Id)).FirstOrDefault();
                        modelo.UsuarioAlteracao = value.Usuario;
                        modelo.Pool_Ip = await repository_Pool_Ip.selectFirst(p => p.Id == value.Objeto.Id_Pool_Ip);
                        modelo.NasObjeto = await repository_NAS.selectFirst(p => p.Id == value.Objeto.Id_Ponto_Acesso);
                        await repository.SaveOrUpdate(modelo);

                        retorno.IdObjeto = modelo.Id;
                        retorno.Ok = true;
                    }
                }
            }
            catch (Exception ex)
            {
                retorno.Mensagem = ex.Message;
                retorno.InnerException = ex.InnerException != null ? ex.InnerException.Message : String.Empty;
            }

            return retorno;
        }

        private void ValidaPlanoRadius(Cliente_PlanoProduto clientePlanoProduto)
        {
            if (clientePlanoProduto.Pool_Ip == null)
                throw new Exception("O Plano não possui Pool de Ip vinculado, não será possível realizar o Provisionamento");
            if (clientePlanoProduto.NasObjeto == null)
                throw new Exception("O Plano não possui Ponto de Acesso vinculado, não será possível realizar o Provisionamento");
            if (String.IsNullOrEmpty(clientePlanoProduto.Login_Radius) || String.IsNullOrEmpty(clientePlanoProduto.Senha_Radius))
                throw new Exception("O Plano não possui Login e Senha, não será possível realizar o Provisionamento");

        }

