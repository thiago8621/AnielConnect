        #region Mobile
        [AllowAnonymous]
        [OlaAuthorize]
        [HttpGet()]
        [Route("api/PlanoProdutoApi/GetByClienteMobile")]
        public async Task<GetApiRetorno<List<PlanoProdutoComboAntendimentoViewModel>>> GetByClienteMobile(Int64 IdCliente)
        {
            GetApiRetorno<List<PlanoProdutoComboAntendimentoViewModel>> retorno = new GetApiRetorno<List<PlanoProdutoComboAntendimentoViewModel>>();

            using (ISession session = HibernateUtil.GetSession())
            using (ISession sessionT5 = HibernateUtil.GetSessionT5())
            {
                try
                {
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder();

                        sql.AppendLine("SELECT A.ID, B.DESCRICAO AS DESCRICAO, B.ID_TIPO_SERVICO AS ID_TIPO_SERVICO, A.LOGIN_RADIUS, A.COD_ESCRITORIO, A.COD_AREA, A.COD_LOCALIDADE,A.LOCALIDADE,");
                        sql.AppendLine("       C.ENDERECO_CEP, C.ENDERECO_LOGRADOURO, C.ENDERECO_NUMERO, ");
                        sql.AppendLine("       C.ENDERECO_BAIRRO, C.ENDERECO_CIDADE, C.ENDERECO_UF, C.ENDERECO_PONTO_REFERENCIA, ");
                        sql.AppendLine("       C.ENDERECO_COMPLEMENTO, D.DESCRICAO AS TIPO_IMOVEL, A.VALOR_FINAL_TOTAL, 1 TIPO ");
                        sql.AppendLine(" FROM TB_CLIENTE_PLANO_PRODUTO A ");
                        sql.AppendLine("INNER JOIN TB_PLANO B ");
                        sql.AppendLine("   ON (A.ID_PLANO = B.ID) ");
                        sql.AppendLine(" LEFT JOIN TB_ENDERECO_CLIENTE C ");
                        sql.AppendLine("   ON (A.ID_ENDERECO_INSTALACAO = C.ID) ");
                        sql.AppendLine(" LEFT JOIN TB_TIPO_IMOVEL D ");
                        sql.AppendLine("   ON (C.ID_TIPO_IMOVEL = D.COD_TIPO_IMOVEL) ");

                        sql.AppendLine("WHERE A.ID_CLIENTE = @ID_CLIENTE");

                        sql.AppendLine("UNION ");

                        sql.AppendLine("SELECT A.ID, B.DESCRICAO AS DESCRICAO, B.ID_TIPO_SERVICO AS ID_TIPO_SERVICO, '' AS LOGIN_RADIUS, A.COD_ESCRITORIO, A.COD_AREA, A.COD_LOCALIDADE,A.LOCALIDADE,");
                        sql.AppendLine("       C.ENDERECO_CEP, C.ENDERECO_LOGRADOURO, C.ENDERECO_NUMERO, ");
                        sql.AppendLine("       C.ENDERECO_BAIRRO, C.ENDERECO_CIDADE, C.ENDERECO_UF, C.ENDERECO_PONTO_REFERENCIA, ");
                        sql.AppendLine("       C.ENDERECO_COMPLEMENTO, D.DESCRICAO AS TIPO_IMOVEL, A.VALOR_FINAL_TOTAL, 2 TIPO ");
                        sql.AppendLine(" FROM TB_CLIENTE_PLANO_PRODUTO A ");
                        sql.AppendLine("INNER JOIN TB_PRODUTO B ");
                        sql.AppendLine("   ON (A.ID_PRODUTO = B.ID) ");
                        sql.AppendLine(" LEFT JOIN TB_ENDERECO_CLIENTE C ");
                        sql.AppendLine("   ON (A.ID_ENDERECO_INSTALACAO = C.ID) ");
                        sql.AppendLine(" LEFT JOIN TB_TIPO_IMOVEL D ");
                        sql.AppendLine("     ON (C.ID_TIPO_IMOVEL = D.COD_TIPO_IMOVEL) ");
                        sql.AppendLine("WHERE A.ID_CLIENTE = @ID_CLIENTE");


                        parametros.Add("@ID_CLIENTE", IdCliente);

                        using (var reader = await CommandHelper.ExecuteReaderFirst(com, sql, parametros, session.Connection, null, 10, null))
                        {
                            retorno.Objeto = new List<PlanoProdutoComboAntendimentoViewModel>();

                            while (await reader.ReadAsync())
                            {
                                String endereco = String.Empty;

                                if (reader["ENDERECO_LOGRADOURO"] != DBNull.Value)
                                    endereco = $"{reader["ENDERECO_LOGRADOURO"]} {" , "} {reader["ENDERECO_NUMERO"]} {" - "} {reader["ENDERECO_BAIRRO"]} {" - "} {reader["ENDERECO_CIDADE"]}";

                                retorno.Objeto.Add(new PlanoProdutoComboAntendimentoViewModel
                                {
                                    Value = Convert.ToInt64(reader["ID"]),
                                    Label = reader["DESCRICAO"] != DBNull.Value ? Convert.ToString(reader["DESCRICAO"]) : String.Empty,
                                    Login_Radius = reader["LOGIN_RADIUS"] != DBNull.Value ? Convert.ToString(reader["LOGIN_RADIUS"]) : String.Empty,
                                    Endereco = endereco,
                                    Valor_Final = reader["VALOR_FINAL_TOTAL"] != DBNull.Value ? String.Format("{0:N2}", Convert.ToDouble(reader["VALOR_FINAL_TOTAL"])) : String.Empty,
                                    Tipo = (PlanoProdutoEnum)Enum.Parse(typeof(PlanoProdutoEnum), Convert.ToString(reader["TIPO"])),
                                    Tipo_Imovel = reader["TIPO_IMOVEL"] != DBNull.Value ? Convert.ToString(reader["TIPO_IMOVEL"]) : String.Empty,
                                    Complemento = reader["ENDERECO_COMPLEMENTO"] != DBNull.Value ? Convert.ToString(reader["ENDERECO_COMPLEMENTO"]) : String.Empty,
                                    Ponto_Referencia_Cliente = reader["ENDERECO_PONTO_REFERENCIA"] != DBNull.Value ? Convert.ToString(reader["ENDERECO_PONTO_REFERENCIA"]) : String.Empty,
                                    Cep = reader["ENDERECO_CEP"] != DBNull.Value ? Convert.ToString(reader["ENDERECO_CEP"]) : String.Empty,
                                    Cod_Escritorio = reader["COD_ESCRITORIO"] != DBNull.Value ? Convert.ToString(reader["COD_ESCRITORIO"]) : String.Empty,
                                    Cod_Area = reader["COD_AREA"] != DBNull.Value ? Convert.ToString(reader["COD_AREA"]) : String.Empty,
                                    Cod_Localidade = reader["COD_LOCALIDADE"] != DBNull.Value ? Convert.ToInt32(reader["COD_LOCALIDADE"]) : (Int32?)null,
                                    Localidade = reader["LOCALIDADE"] != DBNull.Value ? Convert.ToString(reader["LOCALIDADE"]) : String.Empty,
                                    CodCt = await GetContrato(reader["COD_ESCRITORIO"], reader["COD_AREA"], reader["COD_LOCALIDADE"]),
                                    IdTipoServico = reader["ID_TIPO_SERVICO"] != DBNull.Value ? Convert.ToInt32(reader["ID_TIPO_SERVICO"]) : (Int32?)null
                                });
                            }

                            retorno.Ok = true;
                        }
                    }
                }
                catch (Exception ex)
                {
                    retorno.Mensagem = ex.Message;
                    if (ex.InnerException != null) retorno.InnerException += ex.InnerException.Message;
                }
            }

            return retorno;
        }

        [AllowAnonymous]
        [HttpGet]
        [Route("api/PlanoProdutoApi/ConsultaPlanoByIdPlanoProduto")]
        public async Task<GetApiRetorno<PlanosListaModels>> ConsultaPlanoByIdPlanoProduto(long id_plano_produto)
        {
            GetApiRetorno<PlanosListaModels> retorno = new GetApiRetorno<PlanosListaModels>();
            try
            {

                using (ISession session = HibernateUtil.GetSession())
                using (var com = session.Connection.CreateCommand())
                {
                    StringBuilder sql = new StringBuilder();
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    sql.Append("SELECT ID_CLIENTE_CONTRATO FROM TB_CLIENTE_PLANO_PRODUTO WHERE ID = @ID");
                    com.CommandText = sql.ToString();
                    com.Parameters.Clear();
                    com.Parameters.Add(new FbParameter("@ID", id_plano_produto));


                    int idClienteContrato = 0;

                    using (var reader = await CommandHelper.ExecuteReaderFirst(com, sql, new Dictionary<string, object> { { "@ID", id_plano_produto } }, session.Connection, null, 10, null))
                    {
                        await reader.ReadAsync();
                        idClienteContrato = Convert.IsDBNull(reader["ID_CLIENTE_CONTRATO"]) ? default(int) : Convert.ToInt32(reader["ID_CLIENTE_CONTRATO"]);
                    }

                    sql.Clear();
                    sql.Append("SELECT CP.ID, CP.ID_CLIENTE, CP.ID_CLIENTE_CONTRATO, CP.ID_TROCA_PLANO, ")
                       .Append("CP.ID_COMBO, P.DESCRICAO, P.CODIGO, P.VALORPLANO, P.SITUACAOPLANO, ")
                       .Append("P.ID_TIPO_SERVICO, P.INTEGRACAO_EXTERNA, P.UTILIZA_INTEGRACAO_EXTERNA, P.CODIGO_AUXILIAR, ")
                       .Append("P.OS_MUDANCA_PLANO, P.PRODUCT_ID, P.CODIGO_TIPO_PLANO_INTEGRACAO, P.CODIGO_INTEGRACAO, ")
                       .Append("P.CODIGO_INTEGRACAO_AUX, P.DETALHESPLANO ")
                       .Append("FROM TB_CLIENTE_PLANO_PRODUTO CP LEFT JOIN TB_PLANO P ON CP.ID_PLANO = P.ID ")
                       .Append("WHERE CP.ID_CLIENTE_CONTRATO = @ID_CLIENTE_CONTRATO");

                    com.CommandText = sql.ToString();
                    com.Parameters.Clear();
                    com.Parameters.Add(new FbParameter("@ID_CLIENTE_CONTRATO", idClienteContrato));



                    using (var reader = await CommandHelper.ExecuteReaderFirst(com, sql, new Dictionary<string, object> { { "@ID_CLIENTE_CONTRATO", idClienteContrato } }, session.Connection, null, 10, null))
                    {
                        if (reader.HasRows)
                        {
                            var planoPrincipal = new ConsultaDetalhePlanoModels();
                            var planosAdicionais = new List<ConsultaDetalhePlanoModels>();

                            while (await reader.ReadAsync())
                            {
                                var detalhePlano = new ConsultaDetalhePlanoModels
                                {
                                    id = Convert.IsDBNull(reader["ID"]) ? default(int) : Convert.ToInt32(reader["ID"]),
                                    id_cliente = Convert.IsDBNull(reader["ID_CLIENTE"]) ? default(int) : Convert.ToInt32(reader["ID_CLIENTE"]),
                                    //status = Convert.IsDBNull(reader["STATUS"]) ? default(int) : Convert.ToInt32(reader["STATUS"]),
                                    id_cliente_contrato = Convert.IsDBNull(reader["ID_CLIENTE_CONTRATO"]) ? default(int) : Convert.ToInt32(reader["ID_CLIENTE_CONTRATO"]),
                                    id_combo = Convert.IsDBNull(reader["ID_COMBO"]) ? default(int) : Convert.ToInt32(reader["ID_COMBO"]),
                                    id_troca_plano = Convert.IsDBNull(reader["ID_TROCA_PLANO"]) ? default(int) : Convert.ToInt32(reader["ID_TROCA_PLANO"]),
                                    //is_plano_adicional = Convert.IsDBNull(reader["IS_PLANO_ADICIONAL"]) ? default(int) : Convert.ToInt32(reader["IS_PLANO_ADICIONAL"]),
                                    //id_plano_atrelado = Convert.IsDBNull(reader["ID_PLANO_ATRELADO"]) ? default(int) : Convert.ToInt32(reader["ID_PLANO_ATRELADO"]),
                                    descricao = Convert.IsDBNull(reader["DESCRICAO"]) ? null : Convert.ToString(reader["DESCRICAO"]),
                                    codigo = Convert.IsDBNull(reader["CODIGO"]) ? null : Convert.ToString(reader["CODIGO"]),
                                    valorplano = Convert.IsDBNull(reader["VALORPLANO"]) ? default(double) : Convert.ToDouble(reader["VALORPLANO"]),
                                    situacaoplano = Convert.IsDBNull(reader["SITUACAOPLANO"]) ? default(int) : Convert.ToInt32(reader["SITUACAOPLANO"]),
                                    id_tipo_servico = Convert.IsDBNull(reader["ID_TIPO_SERVICO"]) ? default(int) : Convert.ToInt32(reader["ID_TIPO_SERVICO"]),
                                    integracao_externa = Convert.IsDBNull(reader["INTEGRACAO_EXTERNA"]) ? default(int) : Convert.ToInt32(reader["INTEGRACAO_EXTERNA"]),
                                    utiliza_integracao_externa = Convert.IsDBNull(reader["UTILIZA_INTEGRACAO_EXTERNA"]) ? default(int) : Convert.ToInt32(reader["UTILIZA_INTEGRACAO_EXTERNA"]),
                                    codigo_auxiliar = Convert.IsDBNull(reader["CODIGO_AUXILIAR"]) ? null : Convert.ToString(reader["CODIGO_AUXILIAR"]),
                                    os_mudanca_plano = Convert.IsDBNull(reader["OS_MUDANCA_PLANO"]) ? default(int) : Convert.ToInt32(reader["OS_MUDANCA_PLANO"]),
                                    product_id = Convert.IsDBNull(reader["PRODUCT_ID"]) ? null : Convert.ToString(reader["PRODUCT_ID"]),
                                    codigo_tipo_plano_integracao = Convert.IsDBNull(reader["CODIGO_TIPO_PLANO_INTEGRACAO"]) ? null : Convert.ToString(reader["CODIGO_TIPO_PLANO_INTEGRACAO"]),
                                    codigo_integracao = Convert.IsDBNull(reader["CODIGO_INTEGRACAO"]) ? null : Convert.ToString(reader["CODIGO_INTEGRACAO"]),
                                    //tipo = Convert.IsDBNull(reader["TIPO"]) ? default(int) : Convert.ToInt32(reader["TIPO"]),
                                    codigo_integracao_aux = Convert.IsDBNull(reader["CODIGO_INTEGRACAO_AUX"]) ? null : Convert.ToString(reader["CODIGO_INTEGRACAO_AUX"]),
                                    detalhesplano = Convert.IsDBNull(reader["DETALHESPLANO"]) ? null : Convert.ToString(reader["DETALHESPLANO"]),
                                    //usa_plano_adicional = Convert.IsDBNull(reader["USA_PLANO_ADICIONAL"]) ? default(int) : Convert.ToInt32(reader["USA_PLANO_ADICIONAL"])
                                };

                                if (Convert.ToInt32(reader["ID"]) == id_plano_produto)
                                {
                                    planoPrincipal = detalhePlano;
                                }
                                else
                                {
                                    planosAdicionais.Add(detalhePlano);
                                }



                            }

                            var planosLista = new PlanosListaModels
                            {
                                PlanoPrincipal = planoPrincipal,
                                PlanosAdicionais = planosAdicionais
                            };

                            retorno.Objeto = planosLista;
                            retorno.Ok = true;
                        }

                    }
                }

            }
            catch (Exception ex)
            {
                retorno.Ok = false;
                retorno.Mensagem = ex.Message;
            }

            return retorno;
        }
        #endregion

        [HttpPost]
        [Route("api/PlanoProdutoApi/RelatorioPlanosClientes")]
        public async Task<DataTableResponse<PlanosClientesRelatorio>> RelatorioPlanosClientes(PlanosClientesRelatorioRequest request)
        {
            try
            {
                var retorno = new List<PlanosClientesRelatorio>();
                int recordsTotal = 0;

                using (ISession session = HibernateUtil.GetSession())
                using (var com = session.Connection.CreateCommand())
                {
                    var sql = new StringBuilder();
                    var sqlFrom = new StringBuilder();
                    var sqlWhere = new StringBuilder();


                    Dictionary<string, object> parametros = new Dictionary<string, object>();


                    if (!string.IsNullOrEmpty(request.Inicio) && !string.IsNullOrEmpty(request.Fim))
                    {
                        DateTime inicio = DateTime.Parse(request.Inicio);
                        DateTime fim = DateTime.Parse(request.Fim);

                        parametros.Add("@DATA_INICIO", inicio.ToString("dd/MM/yyyy HH:mm:ss"));
                        parametros.Add("@DATA_FIM", inicio.ToString("dd/MM/yyyy 23:59:59"));
                    }

                    sql.AppendLine(" SELECT DISTINCT A.ID_CLIENTE,A.ID_CLIENTE_CONTRATO,A.ID_PLANO,A.ID_VENDA,B.NOMEFANTASIA,C.DATAHORACRIACAO, ");
                    sql.AppendLine(" A.DATA_HABILITADO,A.CARENCIA_CONTRATO, A.STATUS , D.VALORPLANO, D.DESCRICAO, D.TIPO , E.NOME AS VENDEDOR, ");
                    sql.AppendLine(" F.ENDERECO_BAIRRO,F.ENDERECO_CIDADE, ");
                    sql.AppendLine(@"(
                                    SELECT FIRST 1 DATAHORA_ACAO FROM TB_CLIENTE_PLANO_PRODUTO_STLOG G
                                    WHERE G.ID_PLANO_PRODUTO = A.ID AND (G.NOVO_STATUS = 5 OR G.NOVO_STATUS = 7 OR G.NOVO_STATUS = 8) ");

                    if (!string.IsNullOrEmpty(request.TipoData) && request.TipoData == "3")
                        sql.AppendLine(" AND (G.DATAHORA_ACAO BETWEEN @DATA_INICIO AND @DATA_FIM) ");

                    sql.AppendLine(@" ORDER BY G.DATAHORA_ACAO DESC ) AS DATA_CANCELAMENTO,");

                    sql.AppendLine(@"(
                                    SELECT FIRST 1 DATAHORA_ACAO FROM TB_CLIENTE_PLANO_PRODUTO_STLOG G
                                    WHERE G.ID_PLANO_PRODUTO = A.ID AND (G.NOVO_STATUS = 3 OR G.NOVO_STATUS = 4) ");

                    if (!string.IsNullOrEmpty(request.TipoData) && request.TipoData == "4")
                        sql.AppendLine(" AND (G.DATAHORA_ACAO BETWEEN @DATA_INICIO AND @DATA_FIM) ");

                    sql.AppendLine("ORDER BY G.DATAHORA_ACAO DESC ) AS DATA_SUSPENSAO ");

                    sqlFrom.AppendLine(@"   FROM TB_CLIENTE_PLANO_PRODUTO A
                                        INNER JOIN TB_CLIENTE B
                                        ON B.ID = A.ID_CLIENTE 
                                        LEFT JOIN TB_VENDA C
                                        ON C.ID = A.ID
                                        INNER JOIN TB_PLANO D
                                        ON D.ID = A.ID_PLANO 
                                        LEFT JOIN TB_FUNCIONARIO E
                                        ON E.ID = C.ID_VENDEDOR
                                        INNER JOIN TB_ENDERECO_CLIENTE F
                                        ON F.ID = A.ID_ENDERECO_INSTALACAO 
                                        LEFT JOIN TB_CLIENTE_PLANO_PRODUTO_STLOG G
                                        ON (G.ID_PLANO_PRODUTO = A.ID) 
                                        LEFT JOIN TB_LOGIN_RADIUS H
                                        ON (H.ID_CLIENTE = B.ID AND H.ID_PLANO_PRODUTO = A.ID)");

                    sql.Append(sqlFrom);

                    #region Filtros

                    sqlWhere.AppendLine(" WHERE A.ID_CLIENTE IS NOT NULL ");

                    if (!string.IsNullOrEmpty(request.IdCliente))
                    {
                        sqlWhere.AppendLine(" AND A.ID_CLIENTE = @idCliente ");
                        parametros.Add("idCliente", request.IdCliente);
                    }

                    if (!string.IsNullOrEmpty(request.Contrato))
                    {
                        sqlWhere.AppendLine(" AND A.ID_CLIENTE_CONTRATO = @contrato ");
                        parametros.Add("contrato", request.Contrato);
                    }

                    if (!string.IsNullOrEmpty(request.TipoPlano))
                    {
                        sqlWhere.AppendLine(" AND D.TIPO = @tipo ");
                        parametros.Add("tipo", request.TipoPlano);
                    }

                    if (!string.IsNullOrEmpty(request.IdPlano))
                    {
                        sqlWhere.AppendLine(" AND D.ID = @idPlano ");
                        parametros.Add("idPlano", request.IdPlano);
                    }

                    if (!string.IsNullOrEmpty(request.IdCidade))
                    {
                        sqlWhere.AppendLine(" AND F.ID_CIDADE = @idCidade ");
                        parametros.Add("idCidade", request.IdCidade);
                    }

                    if (!string.IsNullOrEmpty(request.IdBairro))
                    {
                        sqlWhere.AppendLine(" AND F.ID_BAIRRO = @idBairro ");
                        parametros.Add("idBairro", request.IdBairro);
                    }

                    if (!string.IsNullOrEmpty(request.IdLogin))
                    {
                        sqlWhere.AppendLine(" AND H.ID = @idLogin ");
                        parametros.Add("idLogin", request.IdLogin);
                    }

                    if (!string.IsNullOrEmpty(request.TipoData))
                    {
                        switch (request.TipoData)
                        {
                            case "0": //aprov
                                sqlWhere.AppendLine(" AND (C.DATAHORACRIACAO BETWEEN @DATA_INICIO AND @DATA_FIM) ");
                                break;

                            case "1": //ativ
                                sqlWhere.AppendLine(" AND (A.DATA_HABILITADO BETWEEN @DATA_INICIO AND @DATA_FIM) ");
                                break;
                            case "3": //canc
                                sqlWhere.AppendLine(" AND (G.DATAHORA_ACAO BETWEEN @DATA_INICIO AND @DATA_FIM) ");
                                sqlWhere.AppendLine(" AND (G.NOVO_STATUS = 5 OR G.NOVO_STATUS = 8 OR G.NOVO_STATUS = 7) ");
                                break;
                            case "4": //susp
                                sqlWhere.AppendLine(" AND (G.DATAHORA_ACAO BETWEEN @DATA_INICIO AND @DATA_FIM) ");
                                sqlWhere.AppendLine(" AND (G.NOVO_STATUS = 3 OR G.NOVO_STATUS = 4) ");
                                break;

                        }
                    }


                    if (request.StatusSelecionados != null)
                    {
                        //todos
                        if (request.StatusSelecionados.Any(x => x == "10"))
                        {
                            sqlWhere.AppendLine(" AND A.STATUS IN (0,1,2,3,4,5,6,7,8) ");
                        }
                        else
                        {
                            sqlWhere.AppendLine($" AND A.STATUS IN ({String.Join(",", request.StatusSelecionados)}) ");
                        }
                    }
                    else
                    {
                        sqlWhere.AppendLine(" AND A.STATUS IS NOT NULL ");
                    }


                    sql.AppendLine(sqlWhere.ToString());

                    #endregion

                    using (var comCount = session.Connection.CreateCommand())
                    {
                        var sqlCount = new StringBuilder();

                        sqlCount.AppendLine($"SELECT COUNT(*) AS QTD_REGISTROS FROM ({sql.ToString()}) ");

                        using (var reader = await CommandHelper.ExecuteReader(comCount, sqlCount, parametros, session.Connection, null))
                        {
                            if (reader.Read())
                            {
                                recordsTotal = Convert.ToInt32(reader["QTD_REGISTROS"]);
                            }
                        }
                    }

                    using (var reader = await CommandHelper.ExecuteReaderFirst(com, sql, parametros, session.Connection, null, request.length, request.start))
                    {
                        while (await reader.ReadAsync())
                        {
                            var registro = new PlanosClientesRelatorio
                            {
                                CodCliente = Convert.ToString(reader["ID_CLIENTE"]),
                                CodContrato = Convert.ToString(reader["ID_CLIENTE_CONTRATO"]),
                                CodPlanoProduto = Convert.ToString(reader["ID_PLANO"]),
                                Venda = Convert.ToString(reader["ID_VENDA"]),
                                Cliente = Convert.ToString(reader["NOMEFANTASIA"]),
                                DataAprovacaoVenda = Convert.ToString(reader["DATAHORACRIACAO"]),
                                DataAtivacao = Convert.ToString(reader["DATA_HABILITADO"]),
                                DataFimCarencia = Convert.ToString(reader["CARENCIA_CONTRATO"]),
                                DataCancelamento = reader["DATA_CANCELAMENTO"] != DBNull.Value ? Convert.ToDateTime(reader["DATA_CANCELAMENTO"]).ToString("dd/MM/yyyy") : "",
                                DataSuspensao = reader["DATA_SUSPENSAO"] != DBNull.Value ? Convert.ToDateTime(reader["DATA_SUSPENSAO"]).ToString("dd/MM/yyyy") : "",
                                StatusPlano = reader["STATUS"] != DBNull.Value ? HtmlEnumExtensions.GetEnumDescription<Status_PlanoProduto>(Convert.ToString(reader["STATUS"])) : String.Empty,
                                ValorPlano = $"R$ {Convert.ToString(reader["VALORPLANO"])}",
                                NomePlano = Convert.ToString(reader["DESCRICAO"]),
                                TipoPlano = reader["TIPO"] != DBNull.Value ? HtmlEnumExtensions.GetEnumDescription<TipoPlanoProdutoAniel>(Convert.ToString(reader["TIPO"])) : RsCadastros.PLANO,
                                Cidade = Convert.ToString(reader["ENDERECO_CIDADE"]),
                                Bairro = Convert.ToString(reader["ENDERECO_BAIRRO"]),
                                Vendedor = Convert.ToString(reader["VENDEDOR"])
                            };

                            retorno.Add(registro);
                        }
                    }
                }

                return new DataTableResponse<PlanosClientesRelatorio>
                {
                    data = retorno,
                    recordsFiltered = recordsTotal,
                    draw = request.draw
                };
            }
            catch (Exception ex)
            {
                throw;
            }
        }
    }
}