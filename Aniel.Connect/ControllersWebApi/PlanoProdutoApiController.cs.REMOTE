        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetComboPlanosByContrato")]
        public async Task<ObjCombo<Int64>> GetComboPlanosByContrato(RequestObjComboPai<Int64?, Int64?> request)
        {
            ObjCombo<Int64> retorno = new ObjCombo<Int64>
            {
                results = new List<IObjComboResult<Int64>>()
            };

            using (ISession session = HibernateUtil.GetSession())
            using (var repoClientePlano = new Conexao<Cliente_PlanoProduto>(session))
            {
                var validarStatus = new[]
                {
                    Status_PlanoProduto.Cancelado,
                    Status_PlanoProduto.Cancelado_Mudanca_Plano
                };



                var planos = await repoClientePlano.select(a => a.ClienteContrato.Id == request.idpai);

                //São selecionados somente planos que não estão cancelados
                //e possuem nota fiscal como comprovante de pagamento
                var idsPlanos = planos
                    .Where(a => !validarStatus.Contains(a.Status.Value)
                             && a.Plano.ComprovantePagamento.Value == Comprovante_Pagamento.Nota_Fiscal)
                    .Select(a => new PlanoInfo { PlanoId = a.Plano.Id, PlanoProdutoId = a.Id })
                    .ToList();





                try
                {
                    #region Plano
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    StringBuilder sqlFromPlano = new StringBuilder("FROM TB_PLANO A ");
                   
                    if (idsPlanos.Any())
                    {
                        var planoIds = idsPlanos.Select(p => p.PlanoId);
                        var planoProdutoIds = idsPlanos.Select(p => p.PlanoProdutoId);
                        sqlFromPlano.AppendLine("LEFT JOIN TB_CLIENTE_PLANO_PRODUTO B");
                        sqlFromPlano.AppendLine($" ON B.ID_PLANO = A.ID");
                        sqlFromPlano.AppendLine($" WHERE (A.ID IN ( {String.Join(",", planoIds)} )) ");
                        sqlFromPlano.AppendLine($" AND (B.ID IN ( {String.Join(",", planoProdutoIds)} )) ");
                    }

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) AS CO ");
                        sql.AppendLine(sqlFromPlano.ToString());

                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            if (await reader.ReadAsync())
                                retorno.total_count = Convert.ToInt32(reader["CO"]);
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT A.ID, A.DESCRICAO, A.VALORPLANO, B.VALOR_FINAL_TOTAL ");
                        sql.AppendLine(sqlFromPlano.ToString());
                        sql.AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new PlanoProdutoComboModels
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"]),
                                    ValorPlanoProduto = Convert.ToDouble(reader["VALORPLANO"]).ToString("F2"),
                                    ValorPlanoProduto_Final = Convert.ToDouble(reader["VALOR_FINAL_TOTAL"]).ToString("F2")
                                };
                                retorno.results.Add(obj);
                            }
                        }
                    }
                    #endregion
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }
            return retorno;
        }


        [HttpPost()]
        [Route("api/PlanoProdutoApi/ObterConfigNotaFiscalPlano")]
        public async Task<ConfiguracaoNfPlanoModels> ObterConfigNotaFiscalPlano (long? idPlano)
        {
            var response = new ConfiguracaoNfPlanoModels();
            using (var session = HibernateUtil.GetSession())
            using (var repoPlano = new Conexao<Plano>(session))
            {
                var obj = await repoPlano.selectFirst(x => x.Id == idPlano);

                if (obj != null)
                {
                    response.ConfiguracaoNF = obj.Config_NF_PlanoProduto.Where(p => !p.Instalacao).Select(p => new PlanoProdutoConfigNfCadastroModel
                    {
                        Id = p.Id,
                        PlanoId = obj.Id,
                        ModeloNotaFiscal = p.ModeloNotaFiscal,
                        DescModeloNotaFiscal = HtmlEnumExtensions.GetEnumDescription(p.ModeloNotaFiscal),

                        IdClassificacaoTributaria = p.Configuracao_Tributaria?.Id,
                        DescClassificacaoTributaria = p.Configuracao_Tributaria?.Descricao ?? "",

                        ValorDiscriminado = p.ValorDiscriminado.HasValue ? p.ValorDiscriminado?.ToString("N2") : (0).ToString("N2"),
                        //To Do fix percentual
                        PercentualDiscriminado = p.PercentualDiscriminado.HasValue ? p.PercentualDiscriminado?.ToString() + "%" : "%",
                        Id_Produtos_Comp = p.ProdutosComp?.Id,
                        DescProduto = p.ProdutosComp?.Descricao,
                        ValorDiscriminadoNf = p.ValorDiscriminadoNf.HasValue ? p.ValorDiscriminadoNf?.ToString("N2") : (0).ToString("N2"),
                        Id_Empresa = p.Empresa?.Id,
                        DescEmpresa = p.Empresa?.Nome,
                        Id_Filial = p.Filial?.Id,
                        DescFilial = p.Filial?.Nome

                    }).ToList();
                }
            }
            return response;
        }
        
        
        [HttpPost()]
        [Route("api/PlanoProdutoApi/ObterConfigNotaFiscalPlano")]
        public async Task<List<ComposicaoNotaCliModels>> ObterConfigNotaFiscalCliente (long? idCliente)
        {
            List<ComposicaoNotaCliModels> response = new List<ComposicaoNotaCliModels>();

            using (var session = HibernateUtil.GetSession())
            {
                Dictionary<string, object> parametros = new Dictionary<string, object>();
                StringBuilder sqlFrom = new StringBuilder();
                long retorno = 0;

                sqlFrom.AppendLine("FROM TB_COMP_NF_CLIENTE A ");
                sqlFrom.AppendLine("LEFT JOIN TB_EMPRESA B ");
                sqlFrom.AppendLine("ON (B.ID = A.ID_EMPRESA) ");
                sqlFrom.AppendLine("LEFT JOIN TB_FILIAL C ");
                sqlFrom.AppendLine("ON (C.ID = A.ID_FILIAL) ");
                sqlFrom.AppendLine("LEFT JOIN TB_PRODUTOS_COMP E ");
                sqlFrom.AppendLine("ON (E.ID = A.ID_PRODUTO_COMP) ");
                sqlFrom.AppendLine("LEFT JOIN TB_CONFIGURACAO_TRIBUTARIA F ");
                sqlFrom.AppendLine("ON (F.ID = A.ID_CONFIG_TRIBU) ");
                sqlFrom.AppendLine("LEFT JOIN TB_CLIENTE_PLANO_PRODUTO G ");
                sqlFrom.AppendLine("ON (G.ID = A.ID_CLIENTE_PLANO) ");
                sqlFrom.AppendLine("LEFT JOIN TB_PLANO D ");
                sqlFrom.AppendLine("ON (D.ID = G.ID_PLANO) ");
                sqlFrom.AppendLine("LEFT JOIN TB_CLIENTE_CONTRATO H ");
                sqlFrom.AppendLine("ON (H.ID = A.ID_CLIENTE_CONTRATO) ");
                sqlFrom.AppendLine("WHERE A.ID_CLIENTE = @ID_CLIENTE ");
                parametros.Add("@ID_CLIENTE", idCliente);

                using (var com = session.Connection.CreateCommand())
                {
                    StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) AS CO ");
                    sql.AppendLine(sqlFrom.ToString());

                    using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                    {
                        if (await reader.ReadAsync())
                            retorno = Convert.ToInt32(reader["CO"]);
                    }
                }

                //Select
                using (var com = session.Connection.CreateCommand())
                {
                    StringBuilder sql = new StringBuilder();
                    sql.AppendLine("SELECT A.ID AS ID_COMP, B.ID AS ID_EMPRESA, C.CODFILIAL AS ID_FILIAL, F.ID AS ID_CONFIG, H.ID AS ID_CTT, D.ID AS ID_PLANO, E.ID AS ID_PRODCOMP, ");
                    sql.AppendLine("A.VALOR_DISCRIMINADO, A.VALOR_NF_DISCRIMINADO, A.PERCENTUAL_DISCRIMINADO, ");
                    sql.AppendLine("A.MODELO_NOTA, A.INSTALACAO, B.RAZAO_SOCIAL AS EMPRESA, C.RAZAO_SOCIAL AS FILIAL, D.DESCRICAO AS PLANO, ");
                    sql.AppendLine("E.DESCRICAO AS PRODUTOCOMP, F.DESCRICAO AS CONFIG_TRIB, G.VALOR_FINAL_TOTAL, H.DESCRICAO AS DESC_CTT ");
                    sql.AppendLine(sqlFrom.ToString());
                    sql.AppendLine("GROUP BY A.ID, B.ID, C.CODFILIAL, F.ID, H.ID, D.ID, E.ID, A.VALOR_DISCRIMINADO, A.VALOR_NF_DISCRIMINADO,");
                    sql.AppendLine("A.PERCENTUAL_DISCRIMINADO, A.MODELO_NOTA, A.INSTALACAO, B.RAZAO_SOCIAL, C.RAZAO_SOCIAL, D.DESCRICAO, ");
                    sql.AppendLine("E.DESCRICAO, F.DESCRICAO, G.VALOR_FINAL_TOTAL, H.DESCRICAO ");

                    using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                    {

                        while (await reader.ReadAsync())
                        {
                            var compCliente = new ComposicaoNotaCliModels();

                            string Descricao = Convert.ToString(reader["ID_CTT"]) + " - " + Convert.ToString(reader["DESC_CTT"]);

                            compCliente.DescricaoEmpresa = reader["EMPRESA"] != DBNull.Value ? Convert.ToString(reader["Empresa"]) : "-";
                            compCliente.DescricaoFilial = reader["FILIAL"] != DBNull.Value ? Convert.ToString(reader["FILIAL"]) : "-";
                            compCliente.DescricaoPlano = reader["PLANO"] != DBNull.Value ? Convert.ToString(reader["PLANO"]) : "-";
                            compCliente.DescricaoProdutoComp = reader["PRODUTOCOMP"] != DBNull.Value ? Convert.ToString(reader["PRODUTOCOMP"]) : "-";
                            compCliente.DescricaoClassificacao = reader["CONFIG_TRIB"] != DBNull.Value ? Convert.ToString(reader["CONFIG_TRIB"]) : "-";
                            compCliente.ModeloNota = reader["MODELO_NOTA"] != DBNull.Value ? HtmlEnumExtensions.GetEnumDescription<Modelo_NotaFiscal>(Convert.ToString(reader["MODELO_NOTA"])) : "-";
                            compCliente.Valor = reader["VALOR_DISCRIMINADO"] != DBNull.Value ? Convert.ToDouble(reader["VALOR_DISCRIMINADO"]).ToString("F2") : "-";
                            compCliente.ValorFinalTotal = reader["VALOR_FINAL_TOTAL"] != DBNull.Value ? Convert.ToDouble(reader["VALOR_FINAL_TOTAL"]).ToString("F2") : "-";
                            compCliente.ValorDiscriminadoNf = reader["VALOR_NF_DISCRIMINADO"] != DBNull.Value ? Convert.ToDouble(reader["VALOR_NF_DISCRIMINADO"]).ToString("F2") : "-";
                            compCliente.PercentualRateio = reader["PERCENTUAL_DISCRIMINADO"] != DBNull.Value ? String.Concat(Convert.ToDouble(reader["PERCENTUAL_DISCRIMINADO"]).ToString("F2"), "%") : "-";
                            compCliente.DescricaoContrato = Descricao;
                            compCliente.IdProdutoComp = reader["ID_PRODCOMP"] != DBNull.Value ? Convert.ToInt64(reader["ID_PRODCOMP"]) : 0;
                            compCliente.IdPlano = reader["ID_PLANO"] != DBNull.Value ? Convert.ToInt64(reader["ID_PLANO"]) : 0;
                            compCliente.IdContrato = reader["ID_CTT"] != DBNull.Value ? Convert.ToInt64(reader["ID_CTT"]) : 0;
                            compCliente.IdConfigTributaria = reader["ID_CONFIG"] != DBNull.Value ? Convert.ToInt64(reader["ID_CONFIG"]) : 0;
                            compCliente.IdEmpresa = reader["ID_EMPRESA"] != DBNull.Value ? Convert.ToInt64(reader["ID_EMPRESA"]) : 0;
                            compCliente.IdFilial = reader["ID_FILIAL"] != DBNull.Value ? Convert.ToInt64(reader["ID_FILIAL"]) : 0;
                            compCliente.Instalacao = reader["INSTALACAO"] != DBNull.Value ? Convert.ToBoolean(reader["INSTALACAO"]) : false;
                            compCliente.Id = reader["ID_COMP"] != DBNull.Value ? Convert.ToInt64(reader["ID_COMP"]) : 0;

                            response.Add(compCliente);
                        }              
                    }                  
                }                      
            }

            return response;
        }


        [Route("api/PlanoProdutoApi/ExcluirConfigNF")]
        [HttpGet()]
        public async Task<DeleteApiRetorno<Int64>> ExcluirConfigNF(Int64 value)
        {
            DeleteApiRetorno<Int64> retorno = new DeleteApiRetorno<Int64>();

            try
            {
                using (ISession session = HibernateUtil.GetSession())
                {
                    using (var repository = new Conexao<ComposicaoNotaFiscalCliente>(session))
                    {

                        ComposicaoNotaFiscalCliente modelo = null;
                        if (value != 0)
                        {
                            modelo = (await repository.select(p => p.Id == value)).FirstOrDefault();

                            await repository.Remove(modelo);

                            retorno.IdObjeto = modelo.Id;
                            retorno.Ok = true;
                        }
                        else
                        {
                            throw new Exception(Resources.RsBase.NAOENCONTRADO);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                retorno.IdObjeto = 0;
                retorno.Mensagem = ex.Message;
                if (ex.InnerException != null) retorno.InnerException = ex.InnerException.Message;
            }

            return retorno;
        }



        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetComboPlanoProdutoConnectAniel")]
        public async Task<ObjCombo<Int64>> GetComboPlanoProdutoConnectAniel(RequestObjCombo<Int64?> request)
        {

            ObjCombo<Int64> retorno = new ObjCombo<Int64>
            {
                results = new List<IObjComboResult<Int64>>()
            };

            using (ISession session = HibernateUtil.GetSession())
            {
                try
                {
                    #region Plano
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    StringBuilder sqlFromPlano = new StringBuilder(" FROM TB_PLANO A ");
                    StringBuilder sqlFromProduto = new StringBuilder("FROM TB_PRODUTO B ");



                    List<String> condicoesPlano = new List<String>();

                    //if (request.soativos)
                    //{
                    //    condicoesPlano.Add($"SITUACAOPLANO = 1");
                    //}

                    if (request.id.HasValue)
                    {
                        condicoesPlano.Add($"UPPER(A.ID) = {request.id}");
                    }

                    if (request != null && !String.IsNullOrEmpty(request.q))
                    {
                        condicoesPlano.Add($"( UPPER(A.CODIGO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 20)}%' OR " +
                                       $" UPPER(A.DESCRICAO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 100)}%')");
                    }

                    if (condicoesPlano.Count() > 0)
                    {
                        sqlFromPlano.AppendLine($" WHERE ( {String.Join(" AND ", condicoesPlano)} ) ");
                    }

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) AS CO ");
                        sql.AppendLine(sqlFromPlano.ToString());

                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            if (await reader.ReadAsync())
                                retorno.total_count = Convert.ToInt32(reader["CO"]);
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT A.ID, A.VALIDADE, A.CODIGO, A.DESCRICAO, A.SITUACAOPLANO AS SITUACAO,1 TIPO");
                        sql.AppendLine(sqlFromPlano.ToString());
                        sql.AppendLine("WHERE A.SITUACAOPLANO = 1 AND A.VALIDADE > CURRENT_TIMESTAMP OR (A.SITUACAOPLANO = 1 AND A.VALIDADE IS NULL)");
                        sql.AppendLine("UNION");
                        sql.AppendLine("SELECT B.ID, B.DATA_VALIDADE, B.CODIGO, B.DESCRICAO, B.SITUACAO AS SITUACAO,2 TIPO");
                        sql.AppendLine(sqlFromProduto.ToString());
                        sql.AppendLine("WHERE B.SITUACAO = 1 AND B.DATA_VALIDADE > CURRENT_TIMESTAMP OR (B.SITUACAO = 1 AND B.data_validade IS NULL)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new PlanoProdutoComboModels
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"])
                                };
                                retorno.results.Add(obj);
                            }
                        }
                    }
                    #endregion


                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }
            return retorno;

        }

        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetComboVinculoONUCliente")]
        public async Task<ObjCombo<Int64>> GetComboVinculoONUCliente(RequestObjComboPai<Int64?, Int64?> request)
        {
            ObjCombo<Int64> retorno = new ObjCombo<Int64>
            {
                results = new List<IObjComboResult<Int64>>()
            };

            using (ISession session = HibernateUtil.GetSession())
            {
                try
                {
                    #region Plano
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    StringBuilder sqlFromPlano = new StringBuilder("FROM TB_PLANO A ")
                        .AppendLine("LEFT JOIN TB_CLIENTE_PLANO_PRODUTO B ")
                        .AppendLine("ON(B.ID_PLANO = A.ID)");


                    List<String> condicoesPlano = new List<String>();

                    if (request.soativos)
                    {
                        condicoesPlano.Add($"SITUACAOPLANO = 1 AND 0 = (SELECT COUNT(ID) FROM TB_ONU WHERE ID_CLIENTE_PLANO_PRODUTO = B.ID) ");
                    }

                    if (request.id.HasValue)
                    {
                        condicoesPlano.Add($"UPPER(A.ID) = {request.id}");
                    }

                    if (request.idpai.HasValue)
                    {
                        condicoesPlano.Add($"UPPER(B.ID_CLIENTE) = {request.idpai}");
                    }

                    if (request != null && !String.IsNullOrEmpty(request.q))
                    {
                        condicoesPlano.Add($"( UPPER(A.CODIGO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 20)}%' OR " +
                                       $" UPPER(A.DESCRICAO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 100)}%')");
                    }

                    if (condicoesPlano.Count() > 0)
                    {
                        sqlFromPlano.AppendLine($" WHERE ( {String.Join(" AND ", condicoesPlano)} ) ");
                    }

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) AS CO ");
                        sql.AppendLine(sqlFromPlano.ToString());

                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            if (await reader.ReadAsync())
                                retorno.total_count = Convert.ToInt32(reader["CO"]);
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT A.ID, A.CODIGO, A.DESCRICAO, A.VALORPLANO, B.LOGIN_RADIUS, B.SENHA_RADIUS ");
                        sql.AppendLine(sqlFromPlano.ToString());
                        sql.AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new ClienteVinculoONUCombo
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"]),
                                    Login = Convert.ToString(reader["LOGIN_RADIUS"]),
                                    Senha = Convert.ToString(reader["SENHA_RADIUS"])
                                };

                                retorno.results.Add(obj);
                            }
                        }
                    }
                    #endregion

                    #region Produto
                    //Filtros 
                    StringBuilder sqlFromProduto = new StringBuilder("FROM TB_PRODUTO A ")
                                                .AppendLine("LEFT JOIN TB_CLIENTE_PLANO_PRODUTO B ")
                                                .AppendLine("ON(B.ID_PRODUTO = A.ID)");

                    List<String> condicoesProduto = new List<String>();

                    if (request.soativos)
                    {
                        condicoesProduto.Add($"SITUACAO = 1 AND 0 = (SELECT COUNT(ID) FROM TB_ONU WHERE ID_CLIENTE_PLANO_PRODUTO = B.ID)");
                    }

                    if (request.id.HasValue)
                    {
                        condicoesProduto.Add($"UPPER(A.ID) = {request.id}");
                    }

                    if (request.idpai.HasValue)
                    {
                        condicoesProduto.Add($"UPPER(B.ID_CLIENTE) = {request.idpai}");
                    }

                    if (request != null && !String.IsNullOrEmpty(request.q))
                    {
                        condicoesProduto.Add($"( UPPER(A.CODIGO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 20)}%' OR " +
                                       $" UPPER(A.DESCRICAO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 100)}%')");
                    }

                    if (condicoesProduto.Count() > 0)
                    {
                        sqlFromProduto.AppendLine($" WHERE ( {String.Join(" AND ", condicoesProduto)} ) ");
                    }

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) AS CO ");
                        sql.AppendLine(sqlFromProduto.ToString());

                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            if (await reader.ReadAsync())
                                retorno.total_count += Convert.ToInt32(reader["CO"]);
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT A.ID, A.CODIGO, A.DESCRICAO, B.LOGIN_RADIUS, B.SENHA_RADIUS ");
                        sql.AppendLine(sqlFromProduto.ToString());
                        sql.AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new ClienteVinculoONUCombo
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"]),
                                    Login = Convert.ToString(reader["LOGIN_RADIUS"]),
                                    Senha = Convert.ToString(reader["SENHA_RADIUS"])
                                };

                                retorno.results.Add(obj);
                            }
                        }
                    }
                    #endregion
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }
            return retorno;

        }

