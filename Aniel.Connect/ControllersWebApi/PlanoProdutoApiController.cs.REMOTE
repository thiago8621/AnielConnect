        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetListPon")]
        public async Task<GetApiRetorno<List<ObjBusca<Int64>>>> GetListPon()
        {
            GetApiRetorno<List<ObjBusca<Int64>>> retorno = new GetApiRetorno<List<ObjBusca<Int64>>>
            {
                Objeto = new List<ObjBusca<Int64>>()
            };

            using (ISession session = HibernateUtil.GetSession())
            using (var repoCliente_PlanoProduto = new Conexao<Cliente_PlanoProduto>(session))
            {
                try
                {
                    var lista = await repoCliente_PlanoProduto.queryover().ListAsync();

                    retorno.Objeto.AddRange(lista.Select(p => new ObjBusca<Int64>
                    {
                        Label = p.Plano?.Descricao == null ? p.Produto?.Descricao : p.Plano.Descricao,
                        Value = p.Id

                    }));

                    retorno.Ok = true;
                }
                catch (Exception ex)
                {
                    retorno.Mensagem = ex.Message;
                    if (ex.InnerException != null) retorno.InnerException += ex.InnerException.Message;
                }
            }
            return retorno;

        }

