            using (var repoPais = new Conexao<Pais>(session))
            using (var repoModeloContrato = new Conexao<Modelo_Contrato>(session))
            using (var repoPLano_Cliente = new Conexao<Cliente_PlanoProduto>(session))
            using (var repoTipoImovel = new Conexao<Tipo_Imovel>(session))
            using (var repoForma_Pagamento = new Conexao<Forma_Pagamento>(session))
            using (var repoVencimento = new Conexao<Vencimento>(session))
            using (var repoCliente = new Conexao<Cliente>(session))
            using (var repoForma_Pagamento_Cliente = new Conexao<Forma_Pagamento_Cliente>(session))
            {
                if (PlanoProduto_ClienteModel.Id != 0)
                {
                    return await repoPLano_Cliente.selectFirst(f => f.Id == PlanoProduto_ClienteModel.Id);
                }
                else
                {
                    if (PlanoProduto_ClienteModel.End_Instalacao_Igual_Principal)
                    {
                        var cliente = await repoCliente.selectFirst(c => c.Id == idCliente.Value);
                        enderecoCobranca.Pais = cliente.Endereco_Principal.Pais;
                        enderecoCobranca.Tipo_Imovel = cliente.Endereco_Principal.Tipo_Imovel;
                        enderecoCobranca.Id_Bairro = cliente.Endereco_Principal?.Id_Bairro;
                        enderecoCobranca.Id_Cidade = cliente.Endereco_Principal?.Id_Cidade;
                        enderecoCobranca.Bairro = cliente.Endereco_Principal?.Bairro;
                        enderecoCobranca.Cep = cliente.Endereco_Principal?.Cep;
                        enderecoCobranca.Cidade = cliente.Endereco_Principal?.Cidade;
                        enderecoCobranca.Complemento = cliente.Endereco_Principal?.Complemento;
                        enderecoCobranca.Latitude = cliente.Endereco_Principal?.Latitude;
                        enderecoCobranca.Longitude = cliente.Endereco_Principal?.Longitude;
                        enderecoCobranca.Logradouro = cliente.Endereco_Principal?.Logradouro;
                        enderecoCobranca.Numero = cliente.Endereco_Principal?.Numero;
                        enderecoCobranca.Ponto_Referencia = cliente.Endereco_Principal?.Ponto_Referencia;
                        enderecoCobranca.UF = cliente.Endereco_Principal?.UF;
                    }
                    else
                    {
                        enderecoCobranca.Pais = PlanoProduto_ClienteModel.Endereco_Instalacao.Pais != null ? repoPais.selectFirst(p => p.Id == PlanoProduto_ClienteModel.Endereco_Instalacao.Pais.Id).Result : null;
                        enderecoCobranca.Tipo_Imovel = Convert.ToString(PlanoProduto_ClienteModel.Endereco_Instalacao.Tipo_Imovel.Id) != null ? repoTipoImovel.selectFirst(p => p.Cod_Tipo_Imovel == PlanoProduto_ClienteModel.Endereco_Instalacao.Tipo_Imovel.Id).Result : null;
                        enderecoCobranca.Id_Bairro = PlanoProduto_ClienteModel?.Endereco_Instalacao.Id_Bairro;
                        enderecoCobranca.Id_Cidade = PlanoProduto_ClienteModel?.Endereco_Instalacao.Id_Cidade;
                        enderecoCobranca.Bairro = PlanoProduto_ClienteModel?.Endereco_Instalacao.Bairro;
                        enderecoCobranca.Cep = PlanoProduto_ClienteModel?.Endereco_Instalacao.Cep;
                        enderecoCobranca.Cidade = PlanoProduto_ClienteModel?.Endereco_Instalacao.Cidade;
                        enderecoCobranca.Complemento = PlanoProduto_ClienteModel?.Endereco_Instalacao.Complemento;
                        //enderecoCobranca.Latitude = PlanoProduto_ClienteModel?.Endereco_Instalacao.Latitude != null ? Convert.ToDouble(PlanoProduto_ClienteModel?.Endereco_Instalacao.Latitude?.Replace('.', ',')) : (Double?)null;
                        //enderecoCobranca.Longitude = PlanoProduto_ClienteModel?.Endereco_Instalacao.Longitude != null ? Convert.ToDouble(PlanoProduto_ClienteModel?. Endereco_Instalacao.Longitude?.Replace('.', ',')) : (Double?)null;
                        enderecoCobranca.Logradouro = PlanoProduto_ClienteModel?.Endereco_Instalacao.Logradouro;
                        enderecoCobranca.Numero = PlanoProduto_ClienteModel?.Endereco_Instalacao.Numero;
                        enderecoCobranca.Ponto_Referencia = PlanoProduto_ClienteModel?.Endereco_Instalacao.Ponto_Referencia;
                        enderecoCobranca.UF = PlanoProduto_ClienteModel?.Endereco_Instalacao.UF;
                    }

                    return new Cliente_PlanoProduto
                    {
                        Cliente = idCliente.HasValue ? repoCliente.selectFirst(p => p.Id == idCliente).Result : null,
                        VelocidadeDownlaod = PlanoProduto_ClienteModel.VelocidadeDownlaod,
                        VelocidadeNominal = PlanoProduto_ClienteModel.VelocidadeNominal,
                        Meses_Carencia = PlanoProduto_ClienteModel.Meses_Carencia,
                        Data_Habilitado = PlanoProduto_ClienteModel.Data_Habilitado,
                        Cod_Area = PlanoProduto_ClienteModel.Cod_Area,
                        Cod_Escritorio = PlanoProduto_ClienteModel.Cod_Escritorio,
                        Localidade = PlanoProduto_ClienteModel.Localidade,
                        Plano = PlanoProduto_ClienteModel.Plano,
                        Produto = PlanoProduto_ClienteModel.Produto,
                        Valor_Real = PlanoProduto_ClienteModel.Valor_Real,
                        Valor_Final = PlanoProduto_ClienteModel.Valor_Final,
                        Parcelas_Instalacao = PlanoProduto_ClienteModel.Parcelas_Instalacao,
                        Dias_Teste_Gratis = PlanoProduto_ClienteModel.Dias_Teste_Gratis,
                        Status = PlanoProduto_ClienteModel.Status,
                        Endereco_Instalacao = enderecoCobranca,

                        //Dias_Teste_Gratis = PlanoProduto_ClienteModel.Dias_Teste_Gratis,
                        //Periodo_Carencia = PlanoProduto_ClienteModel.Periodo_Carencia,

                        //Valor_Final = PlanoProduto_ClienteModel.Valor_Final,
                        //Valor_Final_Total = PlanoProduto_ClienteModel.Valor_Final_Total,
                        //Modelo_Contrato = PlanoProduto_ClienteModel.Modelo_Contrato.HasValue ? repoModeloContrato.selectFirst(p => p.Id == PlanoProduto_ClienteModel.Modelo_Contrato.Id).Result :null,
                        //Forma_Pagamento = PlanoProduto_ClienteModel.Id_Forma_Pagamento.HasValue ? repoForma_Pagamento.selectFirst(p => p.Id == Forma_Pagto_ClienteModel.Id_Forma_Pagamento.Value).Result : null,
                        //Forma_Pagamento = PlanoProduto_ClienteModel.Id_Forma_Pagamento.HasValue ? repoForma_Pagamento.selectFirst(p => p.Id == Forma_Pagto_ClienteModel.Id_Forma_Pagamento.Value).Result : null,
                        //Vencimento = PlanoProduto_ClienteModel.Id_Vencimento.HasValue ? repoVencimento.selectFirst(p => p.Id == Forma_Pagto_ClienteModel.Id_Vencimento.Value).Result : null,
                        //Status = Status_Default.Ativo,
                        //Endereco_Cobranca = enderecoCobranca
                    };
                }
            }
        }

        [HttpGet()]
        [Route("api/planoprodutoapi/GetDadosContrato")]
        public async Task<GetApiRetorno<IEnumerable<GetDadosPlanoProdutoModel>>> GetDadosContrato(Int64 IdClienteContrato, Int64 IdClientePlanoProduto)
        {
            GetApiRetorno<IEnumerable<GetDadosPlanoProdutoModel>> retorno = new GetApiRetorno<IEnumerable<GetDadosPlanoProdutoModel>>();
            using (ISession session = HibernateUtil.GetSession())
            using (var repoClienteContrato = new Conexao<ClienteContrato>(session))
            using (var repoCliente = new Conexao<Cliente>(session))
            using (var repoModelo = new Conexao<Modelo_Contrato>(session))
            using (var repoFormaPagamengo = new Conexao<Forma_Pagamento_Cliente>(session))
            using (var repoPlanoProduto = new Conexao<Cliente_PlanoProduto>(session))
            using (var repoEndCliente = new Conexao<Endereco_Cliente>(session))
            using (var repoEndLogradouro = new Conexao<Endereco_Logradouro>(session))
            using (var repoONU = new Conexao<ONU>(session))
            using (var repoPOP = new Conexao<POP>(session))
            using (var repoLoginRadius = new Conexao<Model.nhibernate.LoginRadius>(session))
            {
                try
                {
                    ClienteContrato clienteContrato = await repoClienteContrato.selectFirst(p => p.Id == IdClienteContrato);
                    Cliente cliente = await repoCliente.selectFirst(z => z.Id == clienteContrato.Cliente.Id);
                    Forma_Pagamento_Cliente formaPagamento = await repoFormaPagamengo.selectFirst(x => x.Cliente.Id == cliente.Id);
                    Modelo_Contrato modeloContrato = await repoModelo.selectFirst(y => y.Id == clienteContrato.ModeloContrato.Id);

                    //planoProduto = await repoPlanoProduto.selectFirst(z => z.Cliente.Id == clienteContrato.Cliente.Id && z.ClienteContrato.Id == clienteContrato.Id);
                    //lista = await repoPlanoProduto.select(z => z.Cliente.Id == cliente.Id && z.ClienteContrato.Id == clienteContrato.Id);

                    var planoProduto = await repoPlanoProduto.selectFirst(z => z.Id == IdClientePlanoProduto);
                    var lista = await repoPlanoProduto.select(z => z.Id == IdClientePlanoProduto);

                    ONU onu = await repoONU.selectFirst(x => x.Cliente_PlanoProduto.Id == IdClientePlanoProduto);
                    Model.nhibernate.LoginRadius radius = await repoLoginRadius.selectFirst(w => w.Cliente.Id == planoProduto.Cliente.Id);

                    var listaPlanos = new List<GetDadosPlanoProdutoModel>();

                    foreach (var obj in lista)
                    {
                        GetDadosPlanoProdutoModel temp = new GetDadosPlanoProdutoModel();
                        {

                            //Contrato
                            temp.Forma_Pagamento_Utilizada = obj?.Forma_Pagamento_Cliente?.Forma_Pagamento?.Descricao;
                            temp.Forma_Pagamento_Contrato = formaPagamento?.Forma_Pagamento?.Descricao;
                            temp.Forma_Envio_Contrato = HtmlEnumExtensions.GetEnumDescription<Cliente_FormaEnvio>(formaPagamento?.Forma_Envio.ToString());
                            temp.Data_Vencimento_Contrato = formaPagamento?.Dia_Vencimento;
                            temp.Dias_Teste_Contrato = clienteContrato?.DiasTeste != null ? clienteContrato?.DiasTeste?.ToString() : "0";
                            temp.Periodo_Carencia_Contrato = clienteContrato?.TemCarencia == true ? "SIM" : "NÃO";
                            temp.Meses_Carencia_Carencia = clienteContrato?.PeriodoCarencia;
                            temp.Multa_Rescisao_Contrato = modeloContrato?.Multa_Carencia;
                            temp.Data_Assinatura = Convert.ToString(obj?.Data_Habilitado);
                            temp.ValorSubTotal = String.Format("{0:N2}", obj?.Valor_Real);


                            //Plao
                            temp.Id_Plano_Produto = obj?.Plano?.Id != null ? obj?.Plano?.Id : obj?.Produto?.Id;
                            temp.Nome_Plano_Produto = obj?.Plano?.Descricao != null ? obj?.Plano?.Descricao : obj?.Produto?.Descricao;
                            temp.Id_Cliente_Plano_Produto = obj?.Id;
                            temp.Numero_Contrato = obj?.ClienteContrato?.NumeroContrato;
                            temp.Valor_Final_Plano = String.Format("{0:N2}", obj?.Valor_Final);
                            temp.Forma_Pagamento_Utilizada = obj?.Forma_Pagamento_Cliente?.Forma_Pagamento?.Descricao;
                            temp.Banco = obj?.Forma_Pagamento_Cliente?.Banco?.ToString();
                            temp.Dia_Vencimento = obj?.Forma_Pagamento_Cliente?.Dia_Vencimento;
                            temp.Forma_Envio = obj?.Forma_Pagamento_Cliente?.Forma_Envio?.ToString();
                            temp.Dias_Teste_Gratis = obj?.Dias_Teste_Gratis != null ? obj?.Dias_Teste_Gratis?.ToString() : "0";
                            temp.Periodo_Carencia = obj?.Periodo_Carencia == true ? "SIM" : "NÃO";
                            temp.Meses_Carencia = obj?.Meses_Carencia;
                            temp.Multa_Rescisao = obj?.Multa_Rescisao;

                            //Plano / Produto - Informações Técnicas
                            temp.Login_Radius = radius?.Login ?? obj?.Login_Radius;
                            temp.Senha_Radius = radius?.SenhaPPPOE ?? obj?.Senha_Radius;
                            temp.ONU = onu?.Serial;
                            temp.id_ONU = onu?.Id;
                            temp.PON = onu?.PON?.Descricao;
                            temp.OLT = onu?.OLT?.Descricao;
                            temp.Slot = onu?.Slot?.Descricao;
                            temp.POP = radius?.POP?.Nome ?? onu?.OLT?.POP?.Nome;
                            using (ISession sessionT5 = HibernateUtil.GetSessionT5())
                            using (var _repoElementoRede = new Conexao<Elemento_Rede>(sessionT5))
                            using (var _repoElementoRedePorta = new Conexao<Elemento_Rede_Porta>(sessionT5))
                            {
                                temp.Caixa_FTTH = radius?.Id_Caixa_FTTH > 0 ? _repoElementoRede.selectFirst(x => x.Id == radius.Id_Caixa_FTTH)?.Result?.Descricao : String.Empty;
                                temp.Porta_FTTH = radius?.Id_Porta_FTTH > 0 ? Convert.ToString(_repoElementoRedePorta.selectFirst(x => x.Id == radius.Id_Porta_FTTH)?.Result?.Porta) : String.Empty;
                            }
                            temp.Velocidade_Download = obj?.Plano?.VelocidadeDownload;
                            temp.Velocidade_Upload = obj.Plano?.VelocidadeUpload;
                            temp.Velocidade_Nominal = obj?.Plano?.VelocidadeNominal;
                            temp.Velocidade_Download_Reduzida = obj.Plano?.VelocidadeDownloadReduzida;
                            temp.Velocidade_Upload_Reduzida = obj.Plano?.VelocidadeUploadReduzida;
                            temp.Observacoes = radius?.Observacoes ?? "Sem observações";
                            temp.VelocidadeReduzida = obj?.Velocidade_Reduzida ?? false;
                            temp.Pool_Cliente = obj?.Pool_Ip?.Descricao;
                            if (radius?.Pool_Ip_Endereco?.Pool_Ip?.IsPoolIpFixo == true)
                            {
                            temp.Ip_Cliente = radius?.Pool_Ip_Endereco?.Ip;
                            }
                            else
                            {
                                temp.Ip_Cliente = radius?.EnderecoIPV4;
                            }

                            temp.Status_PlanoProduto = obj?.Status;
                            temp.Status_PlanoProdutoStr = HtmlEnumExtensions.GetEnumDescription<Status_PlanoProduto>(obj.Status.ToString());
                            temp.Status_Contrato = clienteContrato?.Status_Contrato;
                            temp.Status_ContratoStr = clienteContrato.Status_Contrato != null ? HtmlEnumExtensions.GetEnumDescription<Status_Contrato>(clienteContrato.Status_Contrato.ToString()) : HtmlEnumExtensions.GetEnumDescription<Status_Contrato>(Status_Contrato.Sem_Status);
                            if (planoProduto.Endereco_Instalacao != null)
                            {
                                var enderecoIntalacao = obj?.Endereco_Instalacao;
                                var enderecoCliente = await repoEndCliente.selectFirst(z => z.Id == planoProduto.Endereco_Instalacao.Id);

                                if (enderecoCliente.Busca_Endereco != null)
                                {
                                    var enderecoLogradouro = enderecoCliente.Endereco_Logradouro != null ? await repoEndLogradouro.selectFirst(z => z.Id == enderecoCliente.Endereco_Logradouro.Id) : null;
                                    temp.CepInstalacao = enderecoLogradouro?.Cep;
                                    temp.LogradouroInstalacao = enderecoLogradouro?.Descricao;
                                    temp.NumeroInstalacao = enderecoIntalacao?.Numero;
                                    temp.UFInstalacao = enderecoLogradouro?.UF?.Descricao;
                                    temp.CidadeInstalacao = enderecoLogradouro?.Cidade?.Descricao;
                                    temp.BairroInstalacao = enderecoLogradouro?.Bairro?.Descricao;
                                    temp.TipoImovelInstalacao = enderecoIntalacao?.Tipo_Imovel?.Descricao;
                                    temp.PaisInstalacao = enderecoLogradouro?.Pais?.Nome;
                                    temp.ComplementoInstalacao = enderecoIntalacao?.Complemento;
                                    temp.PontoReferenciaInstalacao = enderecoIntalacao?.Ponto_Referencia;
                                }
                                else
                                {

                                    temp.CepInstalacao = enderecoIntalacao.Cep;
                                    temp.LogradouroInstalacao = enderecoIntalacao.Logradouro;
                                    temp.NumeroInstalacao = enderecoIntalacao.Numero;
                                    temp.UFInstalacao = enderecoIntalacao.UF;
                                    temp.CidadeInstalacao = enderecoIntalacao.Cidade;
                                    temp.BairroInstalacao = enderecoIntalacao.Bairro;
                                    temp.TipoImovelInstalacao = enderecoIntalacao.Tipo_Imovel?.Descricao;
                                    temp.PaisInstalacao = enderecoIntalacao.Pais?.Nome;
                                    temp.ComplementoInstalacao = enderecoIntalacao.Complemento;
                                    temp.PontoReferenciaInstalacao = enderecoIntalacao.Ponto_Referencia;
                                }
                            }
                        };
                        listaPlanos.Add(temp);

                    }
                    retorno.Objeto = listaPlanos;
                    retorno.Ok = true;
                }
                catch (Exception ex)
                {
                    retorno.Ok = false;
                    retorno.Mensagem = ex.Message;
                    if (ex.InnerException != null) retorno.InnerException = ex.InnerException.Message;
                }
            }

            return retorno;

        }

        [HttpGet()]
        [Route("api/planoprodutoapi/GetDadosPlanoProduto")]
        public async Task<GetApiRetorno<GetDadosPlanoProdutoModel>> GetDadosPlanoProduto(Int64 IdClientePlanoProduto, Int64? IdAtendimento)
        {
            GetApiRetorno<GetDadosPlanoProdutoModel> retorno = new GetApiRetorno<GetDadosPlanoProdutoModel>();
            using (ISession session = HibernateUtil.GetSession())
            using (ISession sessionT5 = HibernateUtil.GetSessionT5())
            using (var repoPlanoProduto = new Conexao<Cliente_PlanoProduto>(session))
            using (var repoONU = new Conexao<ONU>(session))
            using (var repoPOP = new Conexao<POP>(session))
            using (var repoLoginRadius = new Conexao<Model.nhibernate.LoginRadius>(session))
            using (var repoAtendimento = new Conexao<Atendimento>(session))
            using (var repoEnderecoCliente = new Conexao<Endereco_Cliente>(session))
            using (var repoTipoServicoEquipe = new Conexao<Tipo_Servico_EquipeAniel>(sessionT5))
            {
                try
                {

                    Cliente_PlanoProduto planoProduto = await repoPlanoProduto.selectFirst(p => p.Id == IdClientePlanoProduto);
                    ONU onu = repoONU.selectFirst(x => x.Cliente_PlanoProduto.Id == planoProduto.Id).Result;
                    Model.nhibernate.LoginRadius radius = repoLoginRadius.selectFirst(w => w.Cliente.Id == planoProduto.Cliente.Id).Result;

                    GetDadosPlanoProdutoModel obj = new GetDadosPlanoProdutoModel();
                    obj.Id_Plano_Produto = planoProduto?.Plano?.Id != null ? planoProduto?.Plano?.Id : planoProduto?.Produto?.Id;
                    obj.Nome_Plano_Produto = planoProduto?.Plano?.Descricao != null ? planoProduto?.Plano?.Descricao : planoProduto?.Produto?.Descricao;
                    obj.Id_Cliente_Plano_Produto = planoProduto?.Id;
                    obj.Numero_Contrato = planoProduto?.ClienteContrato?.NumeroContrato;
                    obj.Valor_Final_Plano = String.Format("{0:N2}", planoProduto?.Valor_Final);
                    obj.Forma_Pagamento_Utilizada = planoProduto?.Forma_Pagamento_Cliente?.Forma_Pagamento?.Descricao;
                    obj.Banco = planoProduto?.Forma_Pagamento_Cliente?.Banco?.ToString();
                    obj.Dia_Vencimento = planoProduto?.Forma_Pagamento_Cliente?.Dia_Vencimento;
                    obj.Forma_Envio = planoProduto?.Forma_Pagamento_Cliente?.Forma_Envio?.ToString();
                    obj.Dias_Teste_Gratis = planoProduto?.Dias_Teste_Gratis != null ? planoProduto?.Dias_Teste_Gratis?.ToString() : "0";
                    obj.Periodo_Carencia = planoProduto?.Periodo_Carencia == true ? "SIM" : "NÃO";
                    obj.Meses_Carencia = planoProduto?.Meses_Carencia;
                    obj.Multa_Rescisao = planoProduto?.Multa_Rescisao;

                    //Plano / Produto - Informações Técnicas
                    obj.Login_Radius = radius?.Login ?? planoProduto?.Login_Radius;
                    obj.Senha_Radius = radius?.SenhaPPPOE ?? planoProduto?.Senha_Radius;
                    obj.ONU = onu?.Serial;
                    obj.id_ONU = onu?.Id;
                    obj.PON = onu?.PON?.Descricao;
                    obj.OLT = onu?.OLT?.Descricao;
                    obj.Slot = onu?.Slot?.Descricao;
                    obj.POP = radius?.POP?.Nome ?? onu?.OLT?.POP?.Nome;
                    obj.Caixa_FTTH = radius?.Id_Caixa_FTTH?.ToString();
                    obj.Porta_FTTH = radius?.Id_Porta_FTTH?.ToString();
                    obj.Velocidade_Download = planoProduto?.Plano?.VelocidadeDownload;
                    obj.Velocidade_Upload = planoProduto.Plano?.VelocidadeUpload;
                    obj.Velocidade_Nominal = planoProduto?.Plano?.VelocidadeNominal;
                    obj.Velocidade_Download_Reduzida = planoProduto.Plano?.VelocidadeDownloadReduzida;
                    obj.Velocidade_Upload_Reduzida = planoProduto.Plano?.VelocidadeUploadReduzida;
                    obj.VelocidadeReduzida = planoProduto?.Velocidade_Reduzida ?? false;
                    obj.Pool_Cliente = planoProduto?.Pool_Ip?.Descricao;
                    obj.Ip_Cliente = radius?.Pool_Ip_Endereco?.Ip;
                    obj.Status_PlanoProduto = planoProduto?.Status;
                    obj.Status_PlanoProdutoStr = HtmlEnumExtensions.GetEnumDescription<Status_PlanoProduto>(planoProduto.Status.ToString());

                    if (planoProduto.Endereco_Instalacao != null)
                    {
                        var enderecoIntalacao = planoProduto?.Endereco_Instalacao;
                        obj.CepInstalacao = enderecoIntalacao.Cep;
                        obj.LogradouroInstalacao = enderecoIntalacao.Logradouro;
                        obj.NumeroInstalacao = enderecoIntalacao.Numero;
                        obj.UFInstalacao = enderecoIntalacao.UF;
                        obj.CidadeInstalacao = enderecoIntalacao.Cidade;
                        obj.BairroInstalacao = enderecoIntalacao.Bairro;
                        obj.TipoImovelInstalacao = enderecoIntalacao.Tipo_Imovel?.Descricao;
                        obj.PaisInstalacao = enderecoIntalacao.Pais?.Nome;
                        obj.ComplementoInstalacao = enderecoIntalacao.Complemento;
                        obj.PontoReferenciaInstalacao = enderecoIntalacao.Ponto_Referencia;
                        obj.CepInstalacao = enderecoIntalacao.Cep;
                    }

                    if (IdAtendimento > 0)
                    {
                        var objAtendimento = await repoAtendimento.selectFirst(x => x.Id == Convert.ToInt64(IdAtendimento));
                        if (objAtendimento != null)
                        {
                            if (objAtendimento?.Endereco_Mudanca != null)
                            {
                                var objEnd = await repoEnderecoCliente.selectFirst(x => x.Id == objAtendimento.Endereco_Mudanca.Id);
                                obj.Cod_Area = objEnd.Cod_Area;
                                obj.Cod_Escritorio = objEnd.Cod_Escritorio;
                                obj.Cod_Localidade = objEnd.Cod_Localidade;
                            }
                            else
                            {
                                obj.Cod_Area = "";
                                obj.Cod_Escritorio = "";
                                obj.Cod_Localidade = 0;
                            }
                        }
                    }
                    else
                    {
                        if (planoProduto?.Endereco_Mudanca_Cliente != null)
                        {
                            obj.Cod_Area = planoProduto?.Endereco_Mudanca_Cliente?.Cod_Area;
                            obj.Cod_Escritorio = planoProduto?.Endereco_Mudanca_Cliente?.Cod_Escritorio;
                            obj.Cod_Localidade = planoProduto?.Endereco_Mudanca_Cliente?.Cod_Localidade;
                        }
                        else
                        {
                            obj.Cod_Area = "";
                            obj.Cod_Escritorio = "";
                            obj.Cod_Localidade = 0;
                        }
                    }

                    if (!String.IsNullOrEmpty(obj.Cod_Escritorio) && !String.IsNullOrEmpty(obj.Cod_Area) && !String.IsNullOrEmpty(Convert.ToString(obj.Cod_Localidade)))
                    {
                        ILocalidadeAnielRepository _repo = new LocalidadeAnielRepository(sessionT5);
                        var localidadeAniel = _repo.GetByCodigo(obj.Cod_Escritorio, obj.Cod_Area, (int)obj.Cod_Localidade);
                        if (localidadeAniel != null)
                        {
                            obj.Projeto = localidadeAniel.Projeto;
                            obj.Contrato = localidadeAniel.CodCt;
                        }

                        var objTipoEquipe = await repoTipoServicoEquipe.selectFirst(x => x.CodCt == obj.Contrato && x.Mudanca_Endereco == "S");
                        if (objTipoEquipe != null)
                        {
                            obj.Id_Tipo_Servico = Convert.ToString(objTipoEquipe.Cod_Tipo_Serv);
                        }
                    }

                    retorno.Objeto = obj;
                    retorno.Ok = true;
                }
                catch (Exception ex)
                {
                    retorno.Ok = false;
                    retorno.Mensagem = ex.Message;
                    if (ex.InnerException != null) retorno.InnerException = ex.InnerException.Message;
                }
            }

            return retorno;

        }

        [HttpGet()]
        [Route("api/planoprodutoapi/GetDadosPlanoProduto_Atendimento")]
        public async Task<bool> GetDadosPlanoProduto_Atendimento(Int64? IdAtendimento, Int64? IdPlano)
        {
            var retorno = false;
            using (ISession session = HibernateUtil.GetSession())
            using (var repoAtendimento = new Conexao<Atendimento>(session))
            using (var repoPlano = new Conexao<Plano>(session))
            {
                try
                {
                    if (IdAtendimento > 0)
                    {
                        var obj = await repoAtendimento.selectFirst(x => x.Id == IdAtendimento);
                        if (obj.PlanoProduto?.Plano != null)
                        {
                            if (obj.PlanoProduto.Plano.OSTrocaEndereco)
                            {
                                retorno = true;
                            }
                            else
                            {
                                retorno = false;
                            }
                        }
                    }
                    else if (IdPlano > 0)
                    {
                        var obj = await repoPlano.selectFirst(x => x.Id == IdPlano);
                        if (obj != null)
                        {
                            if (obj.OSTrocaEndereco)
                            {
                                retorno = true;
                            }
                            else
                            {
                                retorno = false;
                            }
                        }
                    }
                }
                catch (Exception)
                {
                    retorno = false;
                }
            }
            return retorno;
        }

        [HttpPost()]
        [Route("api/PlanoProdutoApi/GetComboTelefonia")]
        public async Task<ObjCombo<Int64>> GetComboTelefonia(RequestObjComboPaiConfig<Int64?, Int64?, long?[]> request)
        {
            ObjCombo<Int64> retorno = new ObjCombo<Int64>
            {
                results = new List<IObjComboResult<Int64>>()
            };

            using (ISession session = HibernateUtil.GetSession())
            {
                try
                {
                    #region Plano
                    //Filtros 
                    Dictionary<String, Object> parametros = new Dictionary<string, object>();

                    StringBuilder sqlFromPlano = new StringBuilder("FROM TB_PLANO A ")
                                                        .AppendLine("LEFT JOIN TB_MODELO_CONTRATO B ")
                                                        .AppendLine("ON(A.ID_MODELOCONTRATO = B.ID) ")
                                                        .AppendLine("LEFT JOIN TB_RADIUS D ")
                                                        .AppendLine("ON(A.ID_RADIUS = D.ID) ");
                    if (request.idpai.HasValue)
                    {
                        sqlFromPlano.AppendLine($"LEFT JOIN TB_CAMPANHA_PLANO_PRODUTO C " +
                                                $"ON(C.ID_PLANO = A.ID)");
                    }

                    List<String> condicoesPlano = new List<String>();
                    if (request.config != null)
                    {
                        List<String> Opcoes = request.config.ToList().Select(p => { return Convert.ToString(p.Value); }).ToList();
                        condicoesPlano.Add($"TIPO_TECNOLOGIA IN ({String.Join(",", Opcoes)})");
                        condicoesPlano.Add("B.ID IS NOT NULL");

                    }

                    if (request.soativos)
                    {
                        condicoesPlano.Add($"SITUACAOPLANO = 1");
                    }

                    if (request.id.HasValue)
                    {
                        condicoesPlano.Add($"UPPER(A.ID) = {request.id}");
                    }

                    if (request.idpai.HasValue)
                    {
                        condicoesPlano.Add($"UPPER(C.ID_CAMPANHA) = {request.idpai}");
                    }

                    if (request != null && !String.IsNullOrEmpty(request.q))
                    {
                        condicoesPlano.Add($"( UPPER(A.CODIGO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 20)}%' OR " +
                                       $" UPPER(A.DESCRICAO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 100)}%')");
                    }

                    if (condicoesPlano.Count() > 0)
                    {
                        sqlFromPlano.AppendLine($" WHERE ( {String.Join(" AND ", condicoesPlano)} ) ");
                    }

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) AS CO ");
                        sql.AppendLine(sqlFromPlano.ToString());

                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            if (await reader.ReadAsync())
                                retorno.total_count = Convert.ToInt32(reader["CO"]);
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT A.ID, A.CODIGO, A.DESCRICAO, A.VALORPLANO, A.ID_MODELOCONTRATO, A.AUTENTICACAORADIUS, ")
                                                  .AppendLine("       A.VALORINSTALACAO, A.VALORINSTALACAOFINAL, A.TESTEGRATIS, A.VALORPLANOFINAL, A.DIASTESTE, ")
                                                  .AppendLine("       A.PERIODO_CARENCIA, A.QTDPARCELAS, A.STATUSINICIAL, A.DETALHESPLANO, A.VELOCIDADEDOWNLOAD, ")
                                                  .AppendLine("       A.VELOCIDADEDOWNLOADREDUZIDA, A.VELOCIDADEUPLOAD, A.VELOCIDADEUPLOADREDUZIDA, A.DISPONIBILIZA_TELEFONIA, ")
                                                  .AppendLine("       A.VELOCIDADENOMINAL, B.PERIODO_CARENCIA AS PERIODO_CARENCIA_MODELO, A.TIPO_TECNOLOGIA, D.ID AS ID_RADIUS ");
                        sql.AppendLine(sqlFromPlano.ToString());
                        sql.AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new PlanoProdutoComboModels
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"]),
                                    ValorPlanoProduto = reader["VALORPLANO"] != DBNull.Value ? Convert.ToDouble(reader["VALORPLANO"]).ToString("N2") : "0.00",
                                    Id_Modelo_Contrato = reader["ID_MODELOCONTRATO"] != DBNull.Value ? Convert.ToInt64(reader["ID_MODELOCONTRATO"]) : (Int64?)null,
                                    AutenticacaoRadius = reader["AUTENTICACAORADIUS"] != DBNull.Value ? Convert.ToBoolean(reader["AUTENTICACAORADIUS"]) : false,
                                    ValorInstalacao = reader["VALORINSTALACAO"] != DBNull.Value ? Convert.ToDouble(reader["VALORINSTALACAO"]).ToString("N2") : "0.00",
                                    ValorInstalacao_Final = reader["VALORINSTALACAOFINAL"] != DBNull.Value ? Convert.ToDouble(reader["VALORINSTALACAOFINAL"]).ToString("N2") : "0.00",
                                    Tipo = PlanoProdutoEnum.Plano,
                                    Teste_Gratis = reader["TESTEGRATIS"] != DBNull.Value ? Convert.ToBoolean(reader["TESTEGRATIS"]) : false,
                                    ValorPlanoProduto_Final = reader["VALORPLANOFINAL"] != DBNull.Value ? Convert.ToDouble(reader["VALORPLANOFINAL"]).ToString("N2") : "0.00",
                                    Qtde_Dias = reader["DIASTESTE"] != DBNull.Value ? Convert.ToInt64(reader["DIASTESTE"]) : (Int64?)null,
                                    Periodo_Carencia = reader["PERIODO_CARENCIA"] != DBNull.Value ? Convert.ToBoolean(reader["PERIODO_CARENCIA"]) : false,
                                    Meses_Carencia = reader["PERIODO_CARENCIA_MODELO"] != DBNull.Value ? Convert.ToInt64(reader["PERIODO_CARENCIA_MODELO"]) : (Int64?)null,
                                    Numero_Parcelas = reader["QTDPARCELAS"] != DBNull.Value ? Convert.ToInt64(reader["QTDPARCELAS"]) : (Int64?)null,
                                    Status_PlanoProduto = reader["STATUSINICIAL"] != DBNull.Value ? (Status_PlanoProduto)Enum.Parse(typeof(Status_PlanoProduto), reader["STATUSINICIAL"].ToString()) : (Status_PlanoProduto?)null,
                                    Detalhes = Convert.ToString(reader["DETALHESPLANO"]),
                                    VelocidadeDownload = Convert.ToString(reader["VELOCIDADEDOWNLOAD"]),
                                    VelocidadeDownloadReduzida = Convert.ToString(reader["VELOCIDADEDOWNLOADREDUZIDA"]),
                                    VelocidadeUpload = Convert.ToString(reader["VELOCIDADEUPLOAD"]),
                                    VelocidadeUploadReduzida = Convert.ToString(reader["VELOCIDADEUPLOADREDUZIDA"]),
                                    VelocidadeNominal = Convert.ToString(reader["VELOCIDADENOMINAL"]),
                                    Id_Radius = reader["ID_RADIUS"] != DBNull.Value ? Convert.ToInt64(reader["ID_RADIUS"]) : (Int64?)null,
                                    Tipo_Tecnologia = reader["TIPO_TECNOLOGIA"] != DBNull.Value ? Convert.ToInt32(reader["TIPO_TECNOLOGIA"]) : (int?)null,
                                    Tipo_TecnologiaStr = reader["TIPO_TECNOLOGIA"] != DBNull.Value ? HtmlEnumExtensions.GetEnumDescription((Tipo_Tecnologia)Convert.ToInt32(reader["TIPO_TECNOLOGIA"])) : null,
                                    Disponibiliza_Telefonia = reader["DISPONIBILIZA_TELEFONIA"] != DBNull.Value ? Convert.ToString(reader["DISPONIBILIZA_TELEFONIA"]) : String.Empty
                                };

                                obj.Status_PlanoProduto_Str = HtmlEnumExtensions.GetEnumDescription<Status_PlanoProduto>(obj.Status_PlanoProduto.Value);

                                retorno.results.Add(obj);
                            }
                        }
                    }
                    #endregion

                    #region Produto
                    //Filtros 
                    StringBuilder sqlFromProduto = new StringBuilder("FROM TB_PRODUTO A ")
                                                        .AppendLine("LEFT JOIN TB_MODELO_CONTRATO B ")
                                                        .AppendLine("ON(A.ID_CONTRATO = B.ID) ");
                    if (request.idpai.HasValue)
                    {
                        sqlFromProduto.AppendLine($"LEFT JOIN TB_CAMPANHA_PLANO_PRODUTO C " +
                                                  $"ON(C.ID_PRODUTO = A.ID)");
                    }

                    List<String> condicoesProduto = new List<String>();

                    if (request.soativos)
                    {
                        condicoesProduto.Add($"SITUACAO = 1");
                    }
                    if (request.config != null)
                    {

                        if (request.config.Any(p => p.Value == 5 || p.Value == 0))
                        {
                            condicoesProduto.Add($"TIPO_PRODUTO = 0");
                        }
                    }

                    if (request.id.HasValue)
                    {
                        condicoesProduto.Add($"UPPER(A.ID) = {request.id}");
                    }

                    if (request.idpai.HasValue)
                    {
                        condicoesProduto.Add($"UPPER(C.ID_CAMPANHA) = {request.idpai}");
                    }

                    if (request != null && !String.IsNullOrEmpty(request.q))
                    {
                        condicoesProduto.Add($"( UPPER(A.CODIGO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 20)}%' OR " +
                                       $" UPPER(A.DESCRICAO) LIKE '%{StringService.Truncate(request.q.ToUpperInvariant(), 100)}%')");
                    }

                    if (condicoesProduto.Count() > 0)
                    {
                        sqlFromProduto.AppendLine($" WHERE ( {String.Join(" AND ", condicoesProduto)} ) ");
                    }

                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) AS CO ");
                        sql.AppendLine(sqlFromProduto.ToString());

                        using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                        {
                            if (await reader.ReadAsync())
                                retorno.total_count += Convert.ToInt32(reader["CO"]);
                        }
                    }

                    //Select
                    using (var com = session.Connection.CreateCommand())
                    {
                        StringBuilder sql = new StringBuilder("SELECT A.ID, A.CODIGO, A.DESCRICAO, A.ID_CONTRATO, A.VALORPRODUTO, ")
                        .AppendLine(" A.VALORPRODUTOFINAL, A.STATUS_INICIAL, A.DETALHES, A.DIAS_TESTE_PRODUTO, A.TEM_TESTE_GRATIS, A.TIPO_PRODUTO, B.PERIODO_CARENCIA, B.TEM_CARENCIA ");

                        sql.AppendLine(sqlFromProduto.ToString());
                        sql.AppendLine("ORDER BY UPPER(A.DESCRICAO)");

                        using (var reader = await CommandHelper.ExecuteReaderPage(com, sql, parametros, session.Connection, null, request.page))
                        {
                            while (await reader.ReadAsync())
                            {
                                var obj = new PlanoProdutoComboModels
                                {
                                    Id = Convert.ToInt64(reader["ID"]),
                                    Text = Convert.ToString(reader["DESCRICAO"]),
                                    Id_Modelo_Contrato = reader["ID_CONTRATO"] != DBNull.Value ? Convert.ToInt64(reader["ID_CONTRATO"]) : (Int64?)null,
                                    Teste_Gratis = reader["TEM_TESTE_GRATIS"] != DBNull.Value ? Convert.ToBoolean(reader["TEM_TESTE_GRATIS"]) : false,
                                    Qtde_Dias = reader["DIAS_TESTE_PRODUTO"] != DBNull.Value ? Convert.ToInt64(reader["DIAS_TESTE_PRODUTO"]) : (Int64?)null,
                                    Periodo_Carencia = reader["TEM_CARENCIA"] != DBNull.Value ? Convert.ToBoolean(reader["TEM_CARENCIA"]) : false,
                                    Meses_Carencia = reader["PERIODO_CARENCIA"] != DBNull.Value ? Convert.ToInt64(reader["PERIODO_CARENCIA"]) : (Int64?)null,

                                    ValorPlanoProduto = reader["VALORPRODUTO"] != DBNull.Value ? Convert.ToDouble(reader["VALORPRODUTO"]).ToString("N2") : "0.00",
                                    ValorPlanoProduto_Final = reader["VALORPRODUTOFINAL"] != DBNull.Value ? Convert.ToDouble(reader["VALORPRODUTOFINAL"]).ToString("N2") : "0.00",
                                    ValorInstalacao = null,
                                    Tipo = PlanoProdutoEnum.Produto,
                                    Status_PlanoProduto = reader["STATUS_INICIAL"] != DBNull.Value ? (Status_PlanoProduto)Enum.Parse(typeof(Status_PlanoProduto), reader["STATUS_INICIAL"].ToString()) : (Status_PlanoProduto?)null,
                                    Detalhes = Convert.ToString(reader["DETALHES"]),
                                    Tipo_Tecnologia = reader["TIPO_PRODUTO"] != DBNull.Value ? Convert.ToInt32(reader["TIPO_PRODUTO"]) : (int?)null,
                                    Tipo_TecnologiaStr = reader["TIPO_PRODUTO"] != DBNull.Value ? HtmlEnumExtensions.GetEnumDescription((Tipo_Produto)Convert.ToInt32(reader["TIPO_PRODUTO"])) : null,

                                };

                                obj.Status_PlanoProduto_Str = HtmlEnumExtensions.GetEnumDescription<Status_PlanoProduto>(obj.Status_PlanoProduto.Value);

                                retorno.results.Add(obj);
                            }
                        }
                    }
                    #endregion
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }
            return retorno;

        }

        [HttpPost()]
        [Route("api/PlanoProdutoapi/GetAllConfigConexao")]
        public async Task<DataTableResponse<ConfigConexaoPlano>> GetAllConfigConexao(ConfigConexaoPlano_DataTableRequest request)
        {

            List<ConfigConexaoPlano> retorno = new List<ConfigConexaoPlano>();
            IOrderedEnumerable<ConfigConexaoPlano> listaOrdenada = null;
            Int32 recordsTotal = 0;

            using (ISession session = HibernateUtil.GetSession())
            {

                Dictionary<String, Object> parametros = new Dictionary<string, object>();

                //Sql From
                StringBuilder sqlFrom = new StringBuilder();

                sqlFrom.AppendLine(" FROM TB_CLIENTE_PLANO_PRODUTO A ");
                sqlFrom.AppendLine(" LEFT JOIN TB_CLIENTE B ON (A.ID_CLIENTE = B.ID) ");
                sqlFrom.AppendLine(" LEFT JOIN TB_CLIENTE_CONTRATO C ON (A.ID_CLIENTE_CONTRATO = C.ID) ");
                sqlFrom.AppendLine(" LEFT JOIN TB_PLANO D ON (A.ID_PLANO = D.ID) ");
                sqlFrom.AppendLine(" LEFT JOIN TB_LOGIN_RADIUS E ON (A.ID = E.ID_PLANO_PRODUTO)");
                sqlFrom.AppendLine(" WHERE A.ID > 0 ");

                //Filtrando                    
                if (!String.IsNullOrEmpty(request.search.value))
                {
                    if (request.search.option == "num_contrato")
                    {
                        sqlFrom.AppendLine(" AND (C.NUMERO_CONTRATO LIKE @SEARCH) ");
                        parametros.Add("@SEARCH", String.Format("%{0}%", request.search.value.ToUpper()));
                    }
                    else if (request.search.option == "cliente")
                    {
                        sqlFrom.AppendLine(" AND ((UPPER(B.NOMEFANTASIA) LIKE UPPER(@SEARCH))) ");
                        parametros.Add("@SEARCH", String.Format("%{0}%", request.search.value.ToUpper()));
                    }
                }


                if (request.Id_Cliente_Plano_Produto.HasValue)
                {
                    sqlFrom.AppendLine("AND (A.ID = @ID_CLIENTE_PLANOPRODUTO)");
                    parametros.Add("@ID_CLIENTE_PLANOPRODUTO", request.Id_Cliente_Plano_Produto);
                }

                //Count
                using (var com = session.Connection.CreateCommand())
                {
                    StringBuilder sql = new StringBuilder("SELECT COUNT(A.ID) CO ");
                    sql.Append(sqlFrom.ToString());

                    using (var reader = await CommandHelper.ExecuteReader(com, sql, parametros, session.Connection, null))
                    {
                        if (await reader.ReadAsync())
                        {
                            recordsTotal = Convert.ToInt32(reader["CO"]);
                        }
                    }
                }

                //Select
                using (var com = session.Connection.CreateCommand())
                {

                    StringBuilder sql = new StringBuilder();

                    sql.AppendLine(" SELECT A.ID AS ID_CLIENTE_PLANOPRODUTO, B.NOMEFANTASIA, C.NUMERO_CONTRATO, D.DESCRICAO AS DESCRICAO_PLANO, E.LOGIN AS LOGIN_RADIUS ");
                    sql.Append(sqlFrom.ToString());

                    //Busca com paginacao
                    using (var reader = await CommandHelper.ExecuteReaderFirst(com, sql, parametros, session.Connection, null, request.length, request.start))
                    {
                        while (await reader.ReadAsync())
                        {
                            retorno.Add(new ConfigConexaoPlano
                            {
                                Id_Cliente_Plano_Produto = Convert.ToInt64(reader["ID_CLIENTE_PLANOPRODUTO"]),
                                Nome_Cliente = Convert.ToString(reader["NOMEFANTASIA"]),
                                Numero_Contrato = Convert.ToString(reader["NUMERO_CONTRATO"]),
                                Nome_Plano_Produto = Convert.ToString(reader["DESCRICAO_PLANO"]),
                                Desc_Login_Radius = reader["LOGIN_RADIUS"] != DBNull.Value ? Convert.ToString(reader["LOGIN_RADIUS"]) : "-",
                                //Situacao = reader["STATUS"] != DBNull.Value ? Convert.ToInt64(reader["STATUS"]) == 1 ? Resources.RsCadastros.ATIVO : Resources.RsCadastros.INATIVO : String.Empty
                            });
                        }
                    }

                }
            }

            //Ordenacao
            if (request.order != null && request.order.Any())
            {
                int sortColumnIndex = request.order[0].column;
                string sortDirection = request.order[0].dir;
                switch (sortColumnIndex)
                {
                    case 1:     // Nome
                        {
                            if (sortDirection == "asc")
                                listaOrdenada = retorno.OrderBy(p => p.Id_Cliente_Plano_Produto);
                            else
                                listaOrdenada = retorno.OrderByDescending(p => p.Id_Cliente_Plano_Produto);
                            break;
                        }
                    default:
                        {
                            listaOrdenada = retorno.OrderBy(p => p.Id_Cliente_Plano_Produto);
                            break;
                        }
                }
            }

            //Page e retornando DataTable
            return new DataTableResponse<ConfigConexaoPlano>
            {
                draw = request.draw,
                //recordsTotal = recordsTotal,
                recordsFiltered = recordsTotal,
                data = listaOrdenada,
                error = ""
            };

        }

        [HttpPost()]
        [Route("api/PlanoProdutoapi/GravarConfigConexao")]
        public async Task<PostApiRetorno<Int64>> GravarConfigConexao([FromBody] ParamWebApi<ConfigConexaoPlano> value)
        {
            PostApiRetorno<Int64> retorno = new PostApiRetorno<Int64>();
            try
            {
                using (ISession session = HibernateUtil.GetSession())
                {
                    using (var repository = new Conexao<Cliente_PlanoProduto>(session))
                    {
                        var objBanco = (await repository.select(p => p.Id == value.Objeto.Id_Cliente_Plano_Produto)).FirstOrDefault();
                        objBanco.VLAN_Uplink = value.Objeto.Vlan_Plano_Produto;
                        objBanco.DataHoraAlteracao = DateTime.Now;
                        objBanco.UsuarioAlteracao = value.NomeUsuario;

                        await repository.SaveOrUpdate(objBanco);

                        retorno.IdObjeto = objBanco.Id;
                        retorno.Ok = true;
                    }
                }
            }
            catch (Exception ex)
            {
                CONSTANTES.log4Net.Error(ex.Message, ex);
                retorno.Mensagem = ex.Message;
                retorno.InnerException = ex.InnerException != null ? ex.InnerException.Message : String.Empty;
            }

            return retorno;
        }

        [HttpGet]
        [Route("api/PlanoProdutoapi/FindConfigConexaoById")]
        public async Task<GetApiRetorno<ConfigConexaoPlano>> FindConfigConexaoById(long id)
        {
            GetApiRetorno<ConfigConexaoPlano> retorno = new GetApiRetorno<ConfigConexaoPlano>();
            try
            {
                using (ISession session = HibernateUtil.GetSession())
                {
                    using (var repository = new Conexao<Cliente_PlanoProduto>(session))
                    using (var repoLogin = new Conexao<Model.nhibernate.LoginRadius>(session))
                    {
                        var objBanco = (await repository.select(p => p.Id == id)).FirstOrDefault();

                        var model = new ConfigConexaoPlano();
                        model.Id_Cliente_Plano_Produto = objBanco.Id;
                        model.Nome_Cliente = objBanco.Cliente?.NomeFantasia;
                        model.Nome_Plano_Produto = objBanco.Plano?.Descricao;
                        model.Numero_Contrato = objBanco.ClienteContrato?.NumeroContrato;
                        model.Vlan_Plano_Produto = objBanco.VLAN_Uplink;
                        model.Desc_Login_Radius = (await repoLogin.selectFirst(p => p.Cliente_PlanoProduto.Id == objBanco.Id))?.Login;

                        retorno.Objeto = model;
                        retorno.Ok = true;
                    }
                }
            }
            catch (Exception ex)
            {
                CONSTANTES.log4Net.Error(ex.Message, ex);
                retorno.Mensagem = ex.Message;
                retorno.InnerException = ex.InnerException != null ? ex.InnerException.Message : String.Empty;
            }

            return retorno;
        }

        [HttpGet]
        [Route("api/PlanoProdutoapi/DuplicarPlanoProduto")]
        #region [DuplicarPlanoProduto]
        public async Task<PostApiRetorno<Int64>> DuplicarPlanoProduto(Int64 planoProdutoId, Int64 qtdeDuplicidade)
        {
            PostApiRetorno<Int64> retorno = new PostApiRetorno<Int64>();

            try
            {
                using (ISession session = HibernateUtil.GetSession())
                using (var repoPlano = new Conexao<Plano>(session))
                using (var repoProduto = new Conexao<Produto>(session))
                {
                    var controllerPlano = new PlanoApiController();
                    var controllerProduto = new ProdutoApiController();

                    var plano = await repoPlano.selectFirst(x => x.Id == planoProdutoId);
                    var produto = await repoProduto.selectFirst(x => x.Id == planoProdutoId);

                    var objPlano = new ParamWebApi<PlanoCadastroModel>();
                    var objProduto = new ParamWebApi<ProdutoCadastroModel>();

                    for (int i = 1; i <= qtdeDuplicidade; i++)
                    {
                        if (plano != null)
                        {
                            objPlano.Objeto = await BindViewToObjPlano(session, plano);
                            objPlano.Objeto.Id = 0;
                            objPlano.Objeto.Descricao += $" - Cópia {i}";

                            await controllerPlano.Gravar(objPlano);
                        }
                        else if (produto != null)
                        {
                            objProduto.Objeto = await BindViewToObjProduto(produto);
                            objProduto.Objeto.Id = 0;
                            objProduto.Objeto.Descricao += $" - Cópia {i}";

                            await controllerProduto.Gravar(objProduto);
                        }
                    }

                    retorno.Ok = true;
                }

            }
            catch (Exception ex)
            {
                retorno.Mensagem = ex.Message;
                if (ex.InnerException != null) retorno.InnerException += ex.InnerException.Message;
            }

            return retorno;
        }
        #endregion

        #region [BindViewToObjPlano]
        private async Task<PlanoCadastroModel> BindViewToObjPlano(ISession session, Plano obj)
        {

            var retorno = new PlanoCadastroModel();

            //retorno.Id = obj.Id;
            retorno.Codigo = obj.Codigo;
            retorno.Descricao = obj.Descricao;
            retorno.Nome_Venda = obj.Nome_Venda;
            retorno.Id_Radius = obj.Radius?.Id;
            retorno.AutenticacaoRadius = obj.AutenticacaoRadius;
            retorno.SituacaoPlano = obj.SituacaoPlano == Situacao_plano.Ativo ? true : false;
            retorno.VelocidadeNominal = obj.VelocidadeNominal;
            retorno.VelocidadeDownload = obj.VelocidadeDownload;
            retorno.AtributoIPOE = obj.UtilizaAtributoIPOE;
            retorno.NomeIPOE = obj.Atributo_IPOE?.Id;
            retorno.BLOQUEIO_AUTO_DEBITO = obj.UtilizaBloqueioDebito;
            retorno.VelocidadeUpload = obj.VelocidadeUpload;
            retorno.Id_Tecnologia = obj.Tecnologia?.Id;
            retorno.Tipo_Tecnologia = obj.Tipo_Tecnologia;
            retorno.ValorPlano = String.Format("{0:N2}", obj.ValorPlano);
            retorno.Detalhes = obj.DetalhesPlano;
            retorno.StatusInicial = obj.StatusInicial;

            //Bloco2
            retorno.CobrancaInstalacao = obj.CobrancaInstalacao;
            retorno.ValorInstalacao = String.Format("{0:N2}", obj.ValorInstalacao);
            retorno.Id_ReciboInstalacaco = obj.Modelo_Recibo_Instalacao?.Id;
            retorno.Id_ContaFinanceiraInstalacao = obj.Conta_FinanceiraInstalacao?.Id;
            retorno.DescContaFinanceiraInstalacao = obj.Conta_FinanceiraInstalacao?.Descricao;
            retorno.Id_ContaFinanceiraPlano = obj.Conta_FinanceiraPlano?.Id;
            retorno.DescContaFinanceiraPlano = obj.Conta_FinanceiraPlano?.Descricao;
            retorno.ModoCobrancaInstalacao = obj.ModoCobrancaInstalacao;
            retorno.QtdParcelas = obj?.QtdParcelas;
            retorno.OSTrocaEndereco = obj.OSTrocaEndereco;

            //Bloco3
            retorno.ReducaoVelocidade = obj.ReducaoVelocidade;
            retorno.QtdDiasAtraso = obj.QtdDiasAtraso;
            retorno.QtdDiasbloqueados = obj.QtdDiasbloqueados;

            retorno.VelocidadeDownloadReduzida = obj.VelocidadeDownloadReduzida;
            retorno.VelocidadeUploadReduzida = obj.VelocidadeUploadReduzida;
            retorno.AtivarValidade = obj.AtivarValidade;
            retorno.Validade = obj.Validade;

            retorno.ProRata = obj.ProRata;
            retorno.Pro_Rata_Habilitacao = obj.Pro_Rata_Habilitacao;
            retorno.Pro_Rata_Interrupcao = obj.Pro_Rata_Interrupcao;
            retorno.Pro_Rata_Cancelamento = obj.Pro_Rata_Cancelamento;

            //Bloco4
            retorno.FrequenciaCobranca = obj.FrequenciaCobranca;
            retorno.Momento_Cobranca_Plano = obj.Momento_Cobranca_Plano;
            retorno.ComprovantePagamento = obj.ComprovantePagamento;
            retorno.ComprovantePagamentoFinanceiro = obj.ComprovantePagamentoFinanceiro;
            retorno.Momento_Cobra_Instalacao = obj.Momento_Cobra_Instalacao;
            retorno.Id_Recibo = obj.Modelo_Recibo?.Id;
            retorno.Desc_Recibo = obj.Modelo_Recibo?.Descricao;
            retorno.Id_Cfop = obj.Cfop?.Id;
            retorno.Codigo_Cfop = obj.Cfop?.Codigo;
            retorno.FormatoCobranca = obj.FormatoCobranca;
            retorno.EmitirContrato = obj.EmitirContrato;
            retorno.IdModeloContrato = obj.Modelo_Contrato?.Id;
            retorno.DescModeloContrato = obj.Modelo_Contrato?.Descricao;
            retorno.Tem_Carencia = obj.Modelo_Contrato?.Tem_Carencia ?? false;
            retorno.Periodo_Carencia = obj.Modelo_Contrato?.Periodo_Carencia;
            retorno.Disponibiliza_Telefonia = obj.Disponibiliza_Telefonia;
            retorno.RetecaoImposto = obj.RetencaoImposto;

            //Bloco5
            retorno.ModoCobranca = obj.Modo_Cobranca_Plano;
            retorno.Cobranca_Recorrente = obj.Cobranca_Recorrente;
            retorno.Utiliza_Desconto = obj.UtilizaDesconto;
            retorno.Desconto = obj.Desconto;
            retorno.MensalidadeInicial = obj.MensalidadeInicial;
            retorno.MensalidadeFinal = obj.MensalidadeFinal;
