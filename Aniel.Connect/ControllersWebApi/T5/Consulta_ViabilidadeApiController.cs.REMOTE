        /// <summary>
        /// Consulta das Áreas de Cobertura para verificação de viabilidade
        /// </summary>
        /// <param name="sessionT5"></param>
        /// <param name="latitude"></param>
        /// <param name="longitude"></param>
        /// <returns></returns>
        private async Task<List<Area_Cobertura>> GetAreas_Consulta(ISession sessionT5, double? latitude, double? longitude)
        {
            #region  Consulta Areas 
            var retorno = new List<Area_Cobertura>();
            var HandlerArea = new GeographyPattern();
            try
            {
                using (Conexao<Area_Cobertura> repoArea_Cobertura = new Conexao<Area_Cobertura>(sessionT5))
                {
                    var areas = (await repoArea_Cobertura.select(p => p.Situacao == Status_Default.Ativo)).ToList();

                    foreach (var area in areas)
                    {
                        Dictionary<List<Location>, bool> e_valido = new Dictionary<List<Location>, bool>();
                        var Poligonos = JsonService.DeserializeObject<List<List<Double>>>(area.Coordenadas);
                        List<List<Location>> locations = Poligonos.Select(poligono =>
                        {
                            List<Location> locationsPoly = new List<Location>();
                            for (int iterator = 0; iterator < poligono.Count; iterator++)
                            {
                                locationsPoly.Add(new Location(poligono[iterator], poligono[++iterator]));
                            }
                            return locationsPoly;
                        }).ToList();


                        foreach (var loc in locations)
                        {
                            var validado = HandlerArea.IsPointInPolygon(loc, new Location(latitude.Value, longitude.Value));
                            e_valido.Add(loc, validado);
                        }

                        if (e_valido.Any(p => p.Value))
                        {
                            retorno.Add(area);
                        }
                    }
                }
            }
            catch (Exception)
            {
                //                                      *******      Pro Tip     *******
                //Use o Quick Watch com o comando (shift + F9) quando debugar a variável $exception para mais detalhes do erro.
            }

            return retorno;
            #endregion
        }

        /// <summary>
        /// Verificação das Caixas viáveis na consulta
        /// </summary>
        /// <param name="sessionT5"></param>
        /// <param name="latitude"></param>
        /// <param name="longitude"></param>
        /// <param name="elements"></param>
        /// <param name="campanhas"></param>
        /// <param name="cpp"></param>
        /// <returns></returns>
        private async Task<List<Consulta_ViabilidadeCaixa>> GetCaixas_Consulta(ISession sessionT5, double? latitude, double? longitude, List<Elemento_Rede> elements, List<Campanha> campanhas, long? cpp)
        {
            #region Consulta Caixas 
            var retorno = new List<Consulta_ViabilidadeCaixa>();
            var HandlerArea = new GeographyPattern();

            try
            {
                using (Conexao<Area_Cobertura> repoArea_Cobertura = new Conexao<Area_Cobertura>(sessionT5))
                using (Conexao<Elemento_Rede_Porta> repoPortas = new Conexao<Elemento_Rede_Porta>(sessionT5))
                {
                    foreach (var caixa in elements)
                    {
                        var campanhas_validadas = new List<Campanha>();

                        var portas = await repoPortas.select(p =>
                            p.Caixa.Id == caixa.Id
                        );

                        var portasDisponiveis = portas.Where(p => p.Status == Sinapse.Model.enumerados.Situacao_Porta.Disponivel);

                        Elemento_Rede_Porta portaReservada = cpp.HasValue ? portas.FirstOrDefault(p => p.Cliente_Plano_Prod == cpp) : null;


                        if (portasDisponiveis.Count() > 0)
                        {

                            var distanciaCaixa = MapaService.GetMenorDistancia(Convert.ToDouble(latitude),
                                                                   Convert.ToDouble(longitude),
                                                                   caixa.Latitude,
                                                                   caixa.Longitude) / 1852;

                            foreach (var campanha in campanhas)
                            {
                                campanha.AreaCobertura.Select(async (area) =>
                                {
                                    var obj = (await repoArea_Cobertura.selectFirst(p => p.Id == area.Area_Cobertura.Value));
                                    var locations = JsonService.DeserializeObject<List<List<Double>>>(obj.Coordenadas).Select(coordinates =>
                                    {
                                        return new Location(coordinates[0], coordinates[1]);
                                    }).ToList();

                                    var viabilidade_in_Area = HandlerArea.IsPointInPolygon(locations, new Location(caixa.Latitude.Value, caixa.Longitude.Value));

                                    if (viabilidade_in_Area)
                                    {
                                        campanhas_validadas.Add(campanha);
                                    }
                                });
                            }

                            var disponiveis = portasDisponiveis.Where(p => p.Cliente_Plano_Prod == null).Select(p => p.Porta).ToList();
                            if (campanhas_validadas.Count > 0)
                                foreach (var validado in campanhas_validadas)
                                {
                                    var obj = new Consulta_ViabilidadeCaixa
                                    {
                                        Id = caixa.Id,
                                        Descricao = caixa.Descricao,
                                        Latitude = caixa.Latitude,
                                        Longitude = caixa.Longitude,
                                        CampanhaVinculada = validado.Titulo,
                                        PortasDisponiveis = disponiveis,
                                        reservada = portaReservada == null ? false : true,
                                        DistanciaKm = distanciaCaixa,
                                        Capacidade = caixa.Capacidade,
                                        path = caixa.Tipo?.Icone?.Caminho,
                                        cor = caixa.Tipo?.Cor,
                                    };

                                    retorno.Add(obj);
                                }

                            else
                            {
                                var obj = new Consulta_ViabilidadeCaixa
                                {
                                    Id = caixa.Id,
                                    Descricao = caixa.Descricao,
                                    Latitude = caixa.Latitude,
                                    Longitude = caixa.Longitude,
                                    CampanhaVinculada = String.Empty,
                                    PortasDisponiveis = disponiveis,
                                    reservada = portaReservada == null ? false : true,
                                    DistanciaKm = distanciaCaixa,
                                    Capacidade = caixa.Capacidade,
                                    path = caixa.Tipo?.Icone?.Caminho,
                                    cor = caixa.Tipo?.Cor,
                                };

                                retorno.Add(obj);
                            }

                        }

                    }
                }
            }
            catch (Exception)
            {
                //                                      *******      Pro Tip     *******             
                //Use o Quick Watch com o comando (shift + F9) quando debugar a variável $exception para mais detalhes do erro.
            }

            return retorno;
            #endregion
        }       
    }
