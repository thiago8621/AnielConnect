        }();

    TableManageButtonsSupervisor.init();


    @* Datatable Monitor *@

    let oDatatableMonitor = null;

    const handleDataTableMonitor = function () {
        "use strict";

        const dataMonitor = @Html.Raw(Json.Encode(Model.ParamsMonitor));

        @* Nome utilizado para enganar o razor *@
        const nomeLista = "ParamsMonitor";

        oDatatableMonitor = $("#datatableMonitor").length && $("#datatableMonitor").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: dataMonitor,
            paging: false,
            ordering: false,
            drawCallback: function () {
                handleExcluirMonitor();
            },
            columns: [
                {
                    data: "Id",
                    title: "",
                    width: "1%",
                    className: "dt-body-center",
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluirMonitor" id="btnExcluirMonitor_' + meta.row + '" excluir="' + data + '"><i class="far fa-trash-alt" style="font-size:16px; padding-right:2px;"></i></a>' +
                               '<input id="' + nomeLista + '_' + meta.row + '__Id" name="' + nomeLista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
                {
                    data: "Monitor",
                    title: "@RsCadastros.MONITOR",
                    width: 380,
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nomeLista + '_' + meta.row + '__UsuarioMonitor" name="' + nomeLista + '[' + meta.row + '].UsuarioMonitor" type="hidden" value="' + TrataNulo(row.UsuarioMonitor) + '">';
                        }

                        return data;
                    },
                }
            ]
        });

        function handleExcluirMonitor() {
            $(".btnExcluirMonitor").unbind('click');
            $(".btnExcluirMonitor").click(function (e) {
                e.preventDefault();

                const idParamMonitor = $(this).attr("excluir");
                const trLinkButton = $(this).parents('tr');

                if (idParamMonitor !== "0") {
                    const link = '@String.Concat(CONSTANTES.URLPortal, "/api/PerfilVisualizacaoServicoApi/ExcluirParamMonitor?Id=")' + idParamMonitor;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json'
                    })
                    .done(function (data) {
                        if (data.ok) {
                            oDatatableMonitor.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    });
                }
                else {
                    oDatatableMonitor.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
            });
        }

        handleExcluirMonitor();

        $("#btnAdicionarMonitor").unbind('click');
        $("#btnAdicionarMonitor").on('click', function () {
            let erro = false;

            if (!$("#iMonitor").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MONITOR)", "warning");
                erro = true;
            }

            let dataMonitor = oDatatableMonitor.data().toArray();

            if (dataMonitor.find(x => x.UsuarioMonitor === $("#iMonitor option:selected").val())) {
                Notificar("@RsBase.ATENCAO_", "Monitor já adicionado", "warning");
                erro = true;
            }

            if (erro) {
                return;
            }

            oDatatableMonitor.row.add({
                Id: 0,

                UsuarioMonitor: $("#iMonitor option:selected").val(),
                Monitor: $("#iMonitor option:selected").text()
            }).draw(false);

            handleExcluirMonitor();

            $("#iMonitor").val(null).trigger('change');
        });
    },
        TableManageButtonsMonitor = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableMonitor();
                }
            }
        }();

    TableManageButtonsMonitor.init();

    let clicked = false;

    function ValidaSubmit() {
        if (clicked) {
            return false;
        }

        clicked = true;
        erro = false;

        if (!$("#iDescricao").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsBase.DESCRICAO)", "warning")
            erro = true
        }

        if (erro) {
            clicked = false;
            return false;
        }

        ShowPageLoading();
        $('#form').submit();

        return true;
    }
</script>
}

