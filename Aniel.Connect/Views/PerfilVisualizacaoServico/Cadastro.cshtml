                    },
                }
            ]
        });

        function handleExcluirArea() {
            $(".btnExcluirArea").unbind('click');
            $(".btnExcluirArea").click(function (e) {
                e.preventDefault();

                const idParamArea = $(this).attr("excluir");
                const trLinkButton = $(this).parents('tr');

                if (idParamArea !== "0") {
                    const link = '@String.Concat(CONSTANTES.URLPortal, "/api/PerfilVisualizacaoServicoApi/ExcluirParamArea?Id=")' + idParamArea;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json'
                    })
                    .done(function (data) {
                        if (data.ok) {
                            oDatatableArea.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    });
                }
                else {
                    oDatatableArea.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
            });
        }

        handleExcluirArea();

        $("#btnAdicionarArea").unbind('click');
        $("#btnAdicionarArea").on('click', function () {
            let erro = false;

            let dataArea = oDatatableArea.data().toArray();

            if (!$("#iGrupoArea").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.GRUPO_AREA)", "warning");
                erro = true;
            }
            else if (!$("#iArea").val() && !$("#iLocalidade").val()) {
                if (dataArea.find(x => x.CodEscritorio === $("#iGrupoArea option:selected").val() &&
                                       x.CodArea === "" &&
                                       x.CodLocalidade === "")) {
                    Notificar("@RsBase.ATENCAO_", "Área já adicionada", "warning");
                    erro = true;
                }
            }
            else if (!$("#iLocalidade").val()) {
                if (dataArea.find(x => x.CodEscritorio === $("#iGrupoArea option:selected").val() &&
                                       x.CodArea === $("#iArea option:selected").val() &&
                                       x.CodLocalidade === "")) {
                    Notificar("@RsBase.ATENCAO_", "Área já adicionada", "warning");
                    erro = true;
                }
            }
            else {
                if (dataArea.find(x => x.CodEscritorio === $("#iGrupoArea option:selected").val() &&
                                       x.CodArea === $("#iArea option:selected").val() &&
                                       x.CodLocalidade === $("#iLocalidade option:selected").val())) {
                    Notificar("@RsBase.ATENCAO_", "Área já adicionada", "warning");
                    erro = true;
                }
            }

            if (erro) {
                return;
            }

            oDatatableArea.row.add({
                Id: 0,

                CodEscritorio: $("#iGrupoArea option:selected").val(),
                CodArea: $("#iArea option:selected").val(),
                CodLocalidade: $("#iLocalidade option:selected").val(),

                GrupoArea: $("#iGrupoArea option:selected").text(),
                Area: $("#iArea option:selected").text() ? $("#iArea option:selected").text() : "Todos",
                Localidade: $("#iLocalidade option:selected").text() ? $("#iLocalidade option:selected").text() : "Todos",
            }).draw(false);

            handleExcluirArea();

            $("#iGrupoArea").val(null).trigger('change');
            $("#iArea").val(null).trigger('change');
            $("#iLocalidade").val(null).trigger('change');
        });
    },
        TableManageButtonsArea = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableArea();
                }
            }
        }();

    TableManageButtonsArea.init();

