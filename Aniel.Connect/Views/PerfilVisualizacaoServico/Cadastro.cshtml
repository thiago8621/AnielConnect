@model Aniel.Connect.Repository.Model.PerfilVisualizacaoServicoCadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Aniel.T5.Model.enumerado

@{
    ViewBag.Title = RsCadastros.CADASTRO_PARAM_VISUALIZACAO_SERV;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
@Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
<script>
    const handleArea = function () {
        $("#iArea").unbind("select2:select select2:unselecting");
        $("#iArea").on("select2:select select2:unselecting", function (e) {
            const areaSelecionada = e.params.data;

            if (areaSelecionada) {
                AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $("#iGrupoArea").val(), String(areaSelecionada.id), null, "@RsBase.SELECIONE", false);
            }
            else {
                AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }
        });
    };

    const handleGrupo = function () {
        $("#iGrupoArea").unbind("select2:select select2:unselecting");
        $("#iGrupoArea").on("select2:select select2:unselecting", function (e) {
            const grupoSelecionado = e.params.data;

            if (grupoSelecionado) {
                AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(grupoSelecionado.id), null, "@RsBase.SELECIONE", false, handleArea);
                AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }
            else {
                AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, handleArea);
            }
        });
    };

    const handleContrato = function () {
        $("#iContrato").unbind("select2:select select2:unselecting");
        $("#iContrato").on("select2:select select2:unselecting", function (e) {
            const contratoSelecionado = e.params.data;

            if (contratoSelecionado) {
                AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(contratoSelecionado.id), null, "@RsBase.SELECIONE", false);
            }
            else {
                AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }
        });
    };

    $(document).ready(function () {
        AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, handleGrupo);
        AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, handleArea);
        AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);

        AddSelect("iContrato", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, handleContrato);
        AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);

        AddSelect("iSetorDepto", "@CONSTANTES.URLPortal/api/FolhaDeptoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielApi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iMonitor", "@CONSTANTES.URLPortal/api/IdentityUserApi/GetComboMonitor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
    });

    @* Datatable Contrato/Projeto *@
    let oDatatableContratoProjeto = null;

    const handleDataTableContratoProjeto = function () {
        "use strict";

        const dataContratoProjeto = @Html.Raw(Json.Encode(Model.ParamsContratoProjeto));

        @* Nome_utilizado para enganar o razor *@
        const nomeLista = "ParamsContratoProjeto";

        oDatatableContratoProjeto = $("#datatableContratoProjeto").length && $("#datatableContratoProjeto").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: dataContratoProjeto,
            paging: false,
            ordering: false,
            drawCallback: function () {
                handleExcluirContratoProjeto();
            },
            columns: [
                {
                    data: "Id",
                    title: "",
                    width: "1%",
                    className: "dt-body-center",
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluirContratoProjeto" id="btnExcluirContratoProjeto_' + meta.row + '" excluir="' + data + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                               '<input id="' + nomeLista + '_' + meta.row + '__Id" name="' + nomeLista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
                {
                    data: "NomeContrato",
                    title: "@RsCadastros.CONTRATO",
                    width: 380,
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nomeLista + '_' + meta.row + '__CodCt" name="' + nomeLista + '[' + meta.row + '].CodCt" type="hidden" value="' + TrataNulo(row.CodCt) + '">';
                        }

                        return data;
                    },
                },
                {
                    data: "NomeProjeto",
                    title: "@RsCadastros.PROJETO",
                    width: 380,
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + '<input id="' + nomeLista + '_' + meta.row + '__Projeto" name="' + nomeLista + '[' + meta.row + '].Projeto" type="hidden" value="' + TrataNulo(row.Projeto) + '">';
                        }

                        return data;
                    },
                }
            ]
        });

        function handleExcluirContratoProjeto() {
            $(".btnExcluirContratoProjeto").unbind('click');
            $(".btnExcluirContratoProjeto").click(function (e) {
                e.preventDefault();

                const idParamContratoProjeto = $(this).attr("excluir");
                const trLinkButton = $(this).parents('tr');

                if (idParamContratoProjeto !== "0") {
                    const link = '@String.Concat(CONSTANTES.URLPortal, "/api/PerfilVisualizacaoServicoApi/ExcluirParamContratoProjeto?Id=")' + idParamContratoProjeto;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json'
                    })
                    .done(function (data) {
                        if (data.ok) {
                            oDatatableContratoProjeto.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    });
                }
                else {
                    oDatatableContratoProjeto.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
            });
        }

        handleExcluirContratoProjeto();

        $("#btnAdicionarContratoProjeto").unbind('click');
        $("#btnAdicionarContratoProjeto").on('click', function () {
            let erro = false;

            let dataContratoProjeto = oDatatableContratoProjeto.data().toArray();

            if (!$("#iContrato").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CONTRATO)", "warning");
                erro = true;
            }
            else if (!$("#iProjeto").val()) {
                if (dataContratoProjeto.find(x => x.CodCt === $("#iContrato option:selected").val() && x.Projeto === "")) {
                    Notificar("@RsBase.ATENCAO_", "Contrato/Projeto já adicionado", "warning");
                    erro = true;
                }
            }
            else {
                if (dataContratoProjeto.find(x => x.CodCt === $("#iContrato option:selected").val() && x.Projeto === $("#iProjeto option:selected").val())) {
                    Notificar("@RsBase.ATENCAO_", "Contrato/Projeto já adicionado", "warning");
                    erro = true;
                }
            }

            if (erro) {
                return;
            }

            oDatatableContratoProjeto.row.add({
                Id: 0,

                CodCt: $("#iContrato option:selected").val(),
                Projeto: $("#iProjeto option:selected").val(),

                NomeContrato: $("#iContrato option:selected").text(),
                NomeProjeto: $("#iProjeto option:selected").text() ? $("#iProjeto option:selected").text() : "Todos"
            }).draw(false);

            handleExcluirContratoProjeto();

            $("#iContrato").val(null).trigger("change");
            $("#iProjeto").val(null).trigger("change");
        });
    },
        TableManageButtonsContratoProjeto = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableContratoProjeto();
                }
            }
        }();

    TableManageButtonsContratoProjeto.init();

