@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
<script>


    const idPlano = '@Html.Raw(Request.Params["idPlano"])'
    $('#idPlano').val(idPlano);

    let oDatatableSigaMe = null;

     let handleDataTableSigaMe = function () {
     "use strict";

       let array = @Html.Raw(Json.Encode(Model.SigaMeLista));
       let nome_lista = "SigaMe";//Nome_utilizado para enganar o razor

     //"Blfrtip"
         oDatatableSigaMe = $("#datatableSigaMe").length && $("#datatableSigaMe").DataTable({
             dom: "Bfrti",
             language: traducaoDataTableSimples,
             data: array,
             paging: false,
             drawCallback: () => {
                 handleExcluir();
             },
             order: [],
             columns: [
                 {
                     data: "Id",
                     orderable: false,
                     render: function (data, type, row, meta) {
                         return '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                             ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                     }
                 },
                 {
                     data: "NumeroOrigem",
                     orderable: false,
                     title: "Número Origem",
                     render: function (data, type, row, meta) {
                         if (type === 'display') {
                             data = data + ' <input id="' + nome_lista + '_' + meta.row + '__NumeroOrigem" name="' + nome_lista + '[' + meta.row + '].NumeroOrigem" type="hidden" value="' + TrataNulo(data) + '">';
                         }
                         return data;
                     },
                     width: 380
                 },
                 {
                     data: "NumeroDestino",
                     orderable: false,
                     title: "Número Destino",
                     render: function (data, type, row, meta) {
                         if (type === 'display') {
                             data = data + ' <input id="' + nome_lista + '_' + meta.row + '__NumeroDestino" name="' + nome_lista + '[' + meta.row + '].NumeroDestino" type="hidden" value="' + TrataNulo(data) + '">';
                         }
                         return data;
                     },
                     width: 380
                 },
                 {
                     data: "DefinirHorario",
                     orderable: false,
                     title: "Definir Horário?",
                     render: function (data, type, row, meta) {
                         if (type === 'display') {
                             data = data + ' <input id="' + nome_lista + '_' + meta.row + '__DefinirHorario" name="' + nome_lista + '[' + meta.row + '].DefinirHorario" type="hidden" value="' + TrataNulo(data) + '">';
                         }
                         return data;
                     },
                     width: 380
                 },
                 {
                     data: "Segunda",
                     orderable: false,
                     title: "Segunda",
                     render: function (data, type, row, meta) {
                         if (type === 'display') {
                             data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Segunda" name="' + nome_lista + '[' + meta.row + '].Segunda" type="hidden" value="' + TrataNulo(data) + '">';
                         }
                         return data;
                     },
                     width: 380
                 },
                 {
                     data: "Terca",
                     orderable: false,
                     title: "Terça",
                     render: function (data, type, row, meta) {
                         if (type === 'display') {
                             data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Terca" name="' + nome_lista + '[' + meta.row + '].Terca" type="hidden" value="' + TrataNulo(data) + '">';
                         }
                         return data;
                     },
                     width: 380
                 },
                 {
                     data: "Quarta",
                     orderable: false,
                     title: "Quarta",
                     render: function (data, type, row, meta) {
                         if (type === 'display') {
                             data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Quarta" name="' + nome_lista + '[' + meta.row + '].Quarta" type="hidden" value="' + TrataNulo(data) + '">';
                         }
                         return data;
                     },
                     width: 380
                 },
                 {
                     data: "Quinta",
                     orderable: false,
                     title: "Quinta",
                     render: function (data, type, row, meta) {
                         if (type === 'display') {
                             data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Quinta" name="' + nome_lista + '[' + meta.row + '].Quinta" type="hidden" value="' + TrataNulo(data) + '">';
                         }
                         return data;
                     },
                     width: 380
                 },
                 {
                     data: "Sexta",
                     orderable: false,
                     title: "Sexta",
                     render: function (data, type, row, meta) {
                         if (type === 'display') {
                             data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Sexta" name="' + nome_lista + '[' + meta.row + '].Sexta" type="hidden" value="' + TrataNulo(data) + '">';
                         }
                         return data;
                     },
                     width: 380
                 },
                 {
                     data: "Sabado",
                     orderable: false,
                     title: "Sábado",
                     render: function (data, type, row, meta) {
                         if (type === 'display') {
                             data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Sabado" name="' + nome_lista + '[' + meta.row + '].Sabado" type="hidden" value="' + TrataNulo(data) + '">';
                         }
                         return data;
                     },
                     width: 380
                 },
                 {
                     data: "Domingo",
                     orderable: false,
                     title: "Domingo",
                     render: function (data, type, row, meta) {
                         if (type === 'display') {
                             data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Domingo" name="' + nome_lista + '[' + meta.row + '].Domingo" type="hidden" value="' + TrataNulo(data) + '">';
                         }
                         return data;
                     },
                     width: 380
                 },
                 {
                     data: "HorarioInicial",
                     orderable: false,
                     title: "Horario Inicial",
                     render: function (data, type, row, meta) {
                         if (type === 'display') {
                             data = data + ' <input id="' + nome_lista + '_' + meta.row + '__HorarioInicial" name="' + nome_lista + '[' + meta.row + '].HorarioInicial" type="hidden" value="' + TrataNulo(data) + '">';
                         }
                         return data;
                     },
                     width: 380
                 },
                 {
                     data: "HorarioFinal",
                     orderable: false,
                     title: "Horario Final",
                     render: function (data, type, row, meta) {
                         if (type === 'display') {
                             data = data + ' <input id="' + nome_lista + '_' + meta.row + '__HorarioFinal" name="' + nome_lista + '[' + meta.row + '].HorarioFinal" type="hidden" value="' + TrataNulo(data) + '">';
                         }
                         return data;
                     },
                     width: 380
                 },
             ]
         });

        function handleExcluir() {
            $(".btnExcluir").unbind('click');
            $(".btnExcluir").click(function (e) {
                e.preventDefault();

                let idFiltro = `${$(this).attr("excluir")}`;

                let trLinkButton = $(this).parents('tr');

                if (idFiltro === "0") {
                    oDatatableSigaMe.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
                else {

                    let link = '@String.Concat(CONSTANTES.URLPortal, "/api/SigaMeApi/Excluir?value=")' + idFiltro;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',

                    })
                        .done(function (data) {

                            if (data.ok) {
                                oDatatableSigaMe.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                        .fail(function () {

                        })
                        .always(function () {

                        });
                }
            });
        }

        handleExcluir();

        $("#btnAdicionar").on('click', function () {

            oDatatableSigaMe.row.add({
                 Id: 0,
                 NumeroOrigem: $("#iNumeroOrigem").val(),
                 NumeroDestino: $("#iNumeroDestino").val(),
                 DefinirHorario: $("#iDefinirHorario").val(),
                 Segunda: $("#iSegunda").is(":checked"),
                 Terca: $("#iTerca").is(":checked"),
                 Quarta: $("#iQuarta").is(":checked"),
                 Quinta: $("#iQuinta").is(":checked"),
                 Sexta: $("#iSexta").is(":checked"),
                 Sabado: $("#iSabado").is(":checked"),
                 Domingo: $("#iDomingo").is(":checked"),
                 HorarioInicial: $("#iHorarioInicial").val(),
                 HorarioFinal: $("#iHorarioFinal").val(),

             }).draw(false);

             handleExcluir();

            });
     };

        TableManageButtonsSigaMe = function () {
             "use strict";
             return {
                 init: function () {
                     handleDataTableSigaMe();
                 }
             }
        }();

        TableManageButtonsSigaMe.init();



    let clicked = false;
    function ValidaSubmit() {
        let SigaMeItens = [];
        let error = false;

            if (clicked) {
                return false;
            }

            clicked = true;

        ShowPageLoading();

        if (!error)
        {
            $('#form').submit();

        }
        else
        {
            Notificar("@RsBase.ATENCAO_","Nenhum item foi marcado ","warning")
        }

        stopPageLoading();
        return;
    }

</script>
   }

    @using (Html.BeginForm("Cadastro", "SigaMe", FormMethod.Post, htmlAttributes: new { @id = "form" }))
    {
        @Html.HiddenFor(model => model.Id)

        @Html.HiddenFor(model => model.idPlano, new { id = "idPlano"})

        <div class="container">
            <div class="row" id="divSigaMe" style="border:none;">
                <div class="col-12 form-group container-group ">
                    <div class="col-2">
                        <label for="iNumeroOrigem"><b>Número Origem</b></label>
                        <div class="form-group">
                            @Html.TextBoxFor(model => model.NumeroOrigem, new { @maxlength = "20", @class = "form-control input-sm", @id = "iNumeroOrigem", @autocomplete = "off" })

                        </div>
                    </div>
                    <div class="col-2">
                        <label for="iNumeroDestino"><b>Número Destino</b></label>
                        <div class="form-group">
                            @Html.TextBoxFor(model => model.NumeroDestino, new { @maxlength = "20", @class = "form-control input-sm", @id = "iNumeroDestino", @autocomplete = "off" })

                        </div>
                    </div>
                    <div class="col-2">
                        <div class="form-group">
                            <label><b>Definir Horário</b></label>
                            <select class="form-control obrigatorioArea" id="iDefinirHorario">
                                <option value="true">SIM</option>
                                <option value="false">NÂO</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-6">
                        <label><b>Selecione os dias que serão redirecionados: </b></label>
                        <br />
                        <input type="checkbox" class="form-check-input" id="iSegunda">
                        <label for="iSegunda">Seg</label>

                        <input type="checkbox" class="form-check-input ml-1" id="iTerca">
                        <label for="iTerca" class="pl-4 pr-1 pt-1">Ter</label>

                        <input type="checkbox" class="form-check-input ml-1" id="iQuarta">
                        <label for="iQuarta" class="pl-4 pr-1 pt-1">Qua</label>

                        <input type="checkbox" class="form-check-input ml-1" id="iQuinta">
                        <label for="iQuinta" class="pl-4 pr-1 pt-1">Qui</label>

                        <input type="checkbox" class="form-check-input ml-1" id="iSexta">
                        <label for="iSexta" class="pl-4 pr-1 pt-1">Sex</label>

                        <input type="checkbox" class="form-check-input ml-1" id="iSabado">
                        <label for="iSabado" class="pl-4 pr-1 pt-1">Sab</label>

                        <input type="checkbox" class="form-check-input ml-1" id="iDomingo">
                        <label for="iDomingo" class="pl-4 pr-1 pt-1">Dom</label>


                    </div>

                </div>
                <div class="col-12 form-group container-group ">
                    <div class="col-3">
                        <label><b>Horário Inicial</b></label>

                        @Html.TextBoxFor(m => m.HorarioInicial, new { @class = "form-control hora", @id = "iHorarioInicial", @autocomplete = "off" })
                    </div>
                    <div class="col-3">
                        <label><b>Horário Final</b></label>

                        @Html.TextBoxFor(m => m.HorarioFinal, new { @class = "form-control hora", @id = "iHorarioFinal", @autocomplete = "off" })

                    </div>

                    <div class="col-3 mt-3">
                        <input type="button" id="btnAdicionar" class="btn btn-success" value="Adicionar">
                    </div>


                </div>
            </div>
         </div>
               
        <div class="container-fluid">
            <h5 class="mb-1 ml-3">
                <span class="text-bold-card">Lista de SigaMe: </span>
            </h5>
            <br />
            <table class="table table-hover nowrap" id="datatableSigaMe" style="width:100%"></table>
        </div>
            
        <div>
          <input type="button" onclick="return ValidaSubmit();" class="btn btn-success mt-2" value="Salvar">
          <input type="button" onclick="" class="btn btn-danger mt-2" value="Cancelar">
        </div>


     }
