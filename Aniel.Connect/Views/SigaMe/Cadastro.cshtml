@model Aniel.Connect.Models.SigaMeCadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Aniel.T5.Model.enumerado

@{
    ViewBag.Title = "Siga me";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
<style>
    .select2 select2-container select2-container--default select2-container--above {
        width: 90% !important;
    }

    .container-group {
        display: flex;
    }

    #iValorDataUltimaPendencia_dp {
