@model Aniel.Connect.Models.BuscarGeolocalizacaoModels

﻿
@using Aniel.Connect.Models
@using Aniel.Connect.Model.enumerado

<script>
    let marcadorAutoComplete;
    let marcadorAutoCompleteConfirmacao;
    let autocomplete
    let atendimento = Boolean(@Html.Raw(Convert.ToInt16(Model.OrigemDialog)));

    async function PesquisaMapaEndereco() {
        try {


            let pesquisa = $("#iPesquisaMap").val();

            var service = new google.maps.places.PlacesService(map);

            var request = {
                query: pesquisa,
                fields: ['name', 'geometry'],
            };

            service.findPlaceFromQuery(request, function (results, status) {


                if (marcadorAutoComplete) {
                    marcadorAutoComplete.setMap(null);
                    $('#iConfirmarLocalizacao').hide();
                }

                if (status === google.maps.places.PlacesServiceStatus.OK) {

                    if (results.length > 0) {

                        let latlng = {
                            lat: results[0].geometry.location.lat(),
                            lng: results[0].geometry.location.lng()
                        };

                        marcadorAutoComplete = new google.maps.Marker({
                            position: latlng,
                            map: map,
                            draggable: true,
                            title: "Resultado da Busca"
                        });

                        marcadorAutoComplete.addListener('dragend', handleDragEnd);
                        $('#iConfirmarLocalizacao').show();


                        map.setCenter(results[0].geometry.location);
                    }
                } else if (status === google.maps.places.PlacesServiceStatus.ZERO_RESULTS) {
                    Notificar("@RsBase.ATENCAO_", "Nenhum resultado foi encontrado para a solicitação. Por favor, verifique a localização.", "warning");
                } else if (status === google.maps.places.PlacesServiceStatus.UNKNOWN_ERROR) {
                    Notificar("@RsBase.ATENCAO_", "Não foi possível processar a solicitação. Tente novamente mais tarde!", "warning");
                } else if (status === google.maps.places.PlacesServiceStatus.NOT_FOUND) {
                    Notificar("@RsBase.ATENCAO_", "O lugar referenciado não foi encontrado! Por favor, verifique a localização.", "warning");
                }
            });

        }
        catch (e) { console.log(e) }
    }

    async function PesquisaMapaConfirmacao() {
        try {

            let pesquisa = `${$("#iLogradouroConfirmacao").val()} ${$("#iNumeroConfirmacao").val()} ${$("#iCidadeConfirmacao").val()} ${$("#iUFConfirmacao").val()} ${$("#iPaisConfirmacao").val()}`;
            var service = new google.maps.places.PlacesService(mapConfirmacao);

            var request = {
                query: pesquisa,
                fields: ['name', 'geometry'],
            };

            service.findPlaceFromQuery(request, function (results, status) {

                if (status === google.maps.places.PlacesServiceStatus.OK) {

                    if (results.length > 0) {

                        let latlng = {
                            lat: results[0].geometry.location.lat(),
                            lng: results[0].geometry.location.lng()
                        };

                        marcadorAutoCompleteConfirmacao = new google.maps.Marker({
                            position: latlng,
                            map: mapConfirmacao,
                            draggable: true,
                            title: "Resultado da Busca"
                        });

                        latAntigo = results[0].geometry.location.lat();
                        longAntigo = results[0].geometry.location.lng();

                        marcadorAutoCompleteConfirmacao.addListener('dragend', handleDragEndConfirmacao);

                        mapConfirmacao.setCenter(results[0].geometry.location);


                        fetch(`https://maps.googleapis.com/maps/api/geocode/json?latlng=${results[0].geometry.location.lat()},${results[0].geometry.location.lng()}&key=@CONSTANTES.TokenGoogleAPI`)
                            .then((response) => {
                                return response.json();
                            })
                            .then((data) => {
                                atualizaCamposConfirmacao(getAddressObject(data.results[0].address_components))
                            })

                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", "Não foi possível localizar endereço", "warning");
                    }
                }
            });

        }
        catch (e) { console.log(e) }
    }

    async function PesquisaMapaLatitudeLongitude() {
        try {
            let latlng = {
                lat: parseFloat($('#iLatitudeMap').val().replace(",", ".")),
                lng: parseFloat($('#iLongitudeMap').val().replace(",", "."))
            };

            if (marcadorAutoComplete) {
                marcadorAutoComplete.setMap(null);
                $('#iConfirmarLocalizacao').hide();
            }

            const geocoder = new google.maps.Geocoder();
            geocoder
                .geocode({ location: latlng })
                .then(async (response) => {
                    if (response.results[0]) {
                        map.setZoom(15);

                        marcadorAutoComplete = new google.maps.Marker({
                            position: latlng,
                            map: map,
                            draggable: true,
                            title: "Resultado da Busca"
                        });
                        marcadorAutoComplete.addListener('dragend', handleDragEnd);
                        $('#iConfirmarLocalizacao').show();
                        map.setCenter(latlng);
                    }
                    else {
                        window.alert("No results found");
                    }
                })

        }
        catch (e) { console.log(e) }
    }

    function showPosition(position) {
        let latlng = { lat: position.coords.latitude, lng: position.coords.longitude };
        map.setCenter(latlng);
    }

    async function getLocation() {

        let latlng = { lat: Number($('#iLatitudeMap').val().replace(',', '.')), lng: Number($('#iLongitudeMap').val().replace(',', '.')) };

        if (latlng.lat && latlng.lng) {

            map.setCenter(latlng);
            marcadorAutoComplete = new google.maps.Marker({
                position: latlng,
                map: map,
                draggable: true,
                title: "Resultado da Busca"
            });

            mapConfirmacao.setCenter(latlng);
            marcadorAutoCompleteConfirmacao = new google.maps.Marker({
                position: latlng,
                map: mapConfirmacao,
                draggable: true,
                title: "Resultado da Busca"
            });

            latAntigo = latlng.lat;
            longAntigo = latlng.lng;

            marcadorAutoComplete.addListener('dragend', handleDragEnd);
            marcadorAutoCompleteConfirmacao.addListener('dragend', handleDragEndConfirmacao);
        }
        else {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(showPosition);
            } else {
                Notificar("@RsBase.ATENCAO_", "A geolocalização não é suportada por este navegador", "warning");
            }
        }
    }

    function handleDragEnd(event) {

        if ($('input[name=buscarEndereco]:checked').val() == "latitudeLongitude") {
            $('#iLatitudeMap').val(marcadorAutoComplete.position.lat())
            $('#iLongitudeMap').val(marcadorAutoComplete.position.lng())
        }

        $('#iConfirmarLocalizacao').show();
    }

        async function confirmarLocalizacao() {

        let tipo = $('#iTipoModalEndereco').val();

        $('#iConfirmarLocalizacao').hide();
        let latlng = {
            lat: parseFloat(marcadorAutoComplete.position.lat()),
            lng: parseFloat(marcadorAutoComplete.position.lng())
        };


            if ($('input[name=buscarEndereco]:checked').val() == "endereco") {
                $("#iLatitude" + tipo).val(marcadorAutoComplete.position.lat())
                $("#iLongitude" + tipo).val(marcadorAutoComplete.position.lng())
            }
            else if ($('input[name=buscarEndereco]:checked').val() == "latitudeLongitude") {
                latlng = {
                    lat: parseFloat($('#iLatitudeMap').val().replace(",", ".")),
                    lng: parseFloat($('#iLongitudeMap').val().replace(",", "."))
                };

                $("#iLatitude" + tipo).val(marcadorAutoComplete.position.lat())
                $("#iLongitude" + tipo).val(marcadorAutoComplete.position.lng())


                $("#iLatitudeManut").val(marcadorAutoComplete.position.lat())
                $("#iLongitudeManut").val(marcadorAutoComplete.position.lng())
            }


        const geocoder = new google.maps.Geocoder();
        geocoder
            .geocode({ location: latlng })
            .then(async (response) => {
                if (response.results[0]) {
                    map.setZoom(15);

                    marcadorAutoComplete = new google.maps.Marker({
                        position: latlng,
                        map: map,
                        draggable: true,
                        title: "Resultado da Busca"
                    });
                    marcadorAutoComplete.addListener('dragend', handleDragEnd);
                    $('#iConfirmarLocalizacao').show();
                    map.setCenter(latlng);

                    if (response.results[0].address_components.filter(p => p.types.contains("route")).length > 0) {
                        $("#iLogradouro" + tipo).val(response.results[0].address_components.filter(p => p.types.contains("route"))[0].long_name);
                    }
                    if (response.results[0].address_components.filter(p => p.types.contains("street_number")).length > 0) {
                       $("#iNumero" + tipo).val(response.results[0].address_components.filter(p => p.types.contains("street_number"))[0].long_name);
                    }
                    if (response.results[0].address_components.filter(p => p.types.contains("sublocality_level_1")).length > 0) {
                       $("#iBairro" + tipo).val(response.results[0].address_components.filter(p => p.types.contains("sublocality_level_1"))[0].long_name);
                    }

                    if (response.results[0].address_components.filter(p => p.types.contains("postal_code")).length > 0) {
                        $("#iCEP" + tipo).val(response.results[0].address_components.filter(p => p.types.contains("postal_code"))[0].long_name);
                    }

                    if (response.results[0].address_components.filter(p => p.types.contains("country")).length > 0) {
                        let pais = response.results[0].address_components.filter(p => p.types.contains("country"))[0].long_name;

                        await AddSelect("iPais" + tipo, "@CONSTANTES.URLPortal/api/enderecoapi/GetComboPaisDescricaoId",@CONSTANTES.PaginacaoRegistros, null, null, pais, "@RsBase.SELECIONE", false);

                    }

                    if (response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_1")).length > 0) {
                        let uf = response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_1"))[0].short_name;
                        @*await AddSelect("@( "iUF" + Model.Tipo)", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUfDesc",@CONSTANTES.PaginacaoRegistros, null, null, uf, "@RsBase.SELECIONE", false, handleUf);*@
                        $("#iUF" + tipo).val(uf);
                    }

                    console.log(response.results);

                    if (response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_2")).length > 0) {
                        let cidade = response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_2"))[0].long_name;
                        let uf = response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_1"))[0].short_name;
                        await AddSelect("iCidade" + tipo, "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidadesDescId",@CONSTANTES.PaginacaoRegistros, null, uf, cidade, "@RsBase.SELECIONE", false);

                        var descCidade = $("#iCidade" + tipo + " option:selected").text();
                        $("#iDesc_Cidade" + tipo).val(descCidade);
                    }

                }
                else {
                    window.alert("No results found");
                }
            })

        $('#modal-localizacao').modal('hide');
    }

