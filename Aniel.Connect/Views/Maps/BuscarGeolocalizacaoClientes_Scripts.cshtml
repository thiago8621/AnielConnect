        let iniciando = true;
        var mapConfirmacao;

    async function initMapBuscarGeolocalizacao(tipo) {

        $('#iTipoModalEndereco').val(tipo);


        let enderecoCompleto = "";

        let logradouro = $("#iLogradouro" + tipo).val();
        let numero = $("#iNumero" + tipo).val();
        let bairro = $("#iBairro" + tipo).val();
        let cidade = "";
        if (!$("#iCidadeText" + tipo)) {
            cidade = $("#iCidade" + tipo + " option:selected").text();
        }
        else {
            cidade = $("#iCidadeText" + tipo).val();
        }
        let Valorcidade = $("#iCidade" + tipo).val();

        if (logradouro) {
            enderecoCompleto += logradouro;
        }

        if (numero) {
            enderecoCompleto += " " + numero;
        }

        if (bairro) {
            enderecoCompleto += " " + bairro;
        }

        if (Valorcidade) {
            enderecoCompleto += " " + cidade;
        }

        /*Hide transit and poi*/
        var myStyles = [
            {
                featureType: "poi",
                elementType: "labels",
                stylers: [
                    { visibility: "off" }
                ]
            },
            {
                featureType: "transit",
                elementType: "labels",
                stylers: [
                    { visibility: "off" }
                ]
            }
        ];

        $('#iLatitudeMap').val( $("#iLatitude" + tipo).val());
        $('#iLongitudeMap').val( $("#iLongitude" + tipo).val());

        var lat = -22.8690004;
        var lng = -43.4790957;

        if (($('#iLatitudeMap').val() != "") && ($('#iLongitudeMap').val() != "") &&
            ($('#iLatitudeMap').val() != undefined) && ($('#iLongitudeMap').val() != undefined)) {
            lat = parseFloat($("#iLatitudeMap").val().replace(/,/g, '.'));
            lng = parseFloat($("#iLongitudeMap").val().replace(/,/g, '.'));
        }

        let latlng = {
            lat: lat,
            lng: lng
        };

        map = new google.maps.Map(document.getElementById("map"), {
            center: latlng,
            zoom: 15,
            styles: myStyles,
            disableDefaultUI: false,
        });


        map.addListener("idle", () => {
            //console.log("O mapa foi totalmente carregado.");
            if (atendimento) {
                $("#map").children().css({ position: "relative", height: "34vh" });
                $("#map").children().css({ position: "" });
            }
        });

        $('#iPesquisaMap').val(enderecoCompleto);
        $('#iConfirmarLocalizacao').hide();


        marcadorAutoComplete = new google.maps.Marker({
            position: latlng,
            map: map,
            draggable: true,
            title: "Resultado da Busca"
        });

        marcadorAutoComplete.addListener('dragend', handleDragEnd);

        if (typeof results === 'undefined') {
            map.setCenter(latlng.lat, latlng.lng);
        }
        else {
            map.setCenter(results[0].geometry.location);
        }

        mapConfirmacao = new google.maps.Map(document.getElementById("mapConfirmacao"), {
            center: latlng,
            zoom: 15,
            styles: myStyles,
            disableDefaultUI: false,
        });

        getLocation();
    }

    async function getGoogleLatLong() {
        let link = 'https://maps.googleapis.com/maps/api/geocode/json?key=AIzaSyACnVjpiRnap58taXa7eEQJIVmD8TkoL2g&address=';

        if ($('#iNumeroManut').val()) {

            link = link.concat(GetEnderecoManut());

            try {
                return await $.getJSON(link, async function (data) {

                    if (data.results[0]) {
                        if (!data.results[0].geometry.location.lat || !data.results[0].geometry.location.lng) {
                            Notificar("@RsBase.ATENCAO_", "@RsPontoEletronico.NAO_FOI_POSSIVEL_LOCALIZAR_LATITUDE", "warning");
                            $("#iLatitudeManut").val(null);
                            $("#iLongitudeManut").val(null);

                        }
                    }

                    let latitude = data.results[0].geometry.location.lat.toString().replace(".", ",");
                    let longitude = data.results[0].geometry.location.lng.toString().replace(".", ",");

                    $("#iLatitudeManut").val(latitude);
                    $("#iLongitudeManut").val(longitude);

                })
            }
            catch (e) {
                Notificar("@RsPontoEletronico.NAO_FOI_POSSIVEL_LOCALIZAR_LATITUDE", e, "warning");
                $("#iErroApiMaps").val(e);
            }
        }
    }


    function GetEnderecoManut() {

        let endereco = "";

        if ($("#iNumeroManut").val()) {
            endereco += " " + $("#iNumeroManut").val();
        }
        else {
            return false;
        }

        if ($("#iBairroManut").val() != "")
            endereco += " " + $("#iBairroManut").val();
        if ($("#iCidadeManut").val() != "")
            endereco += " " + $("#iCidadeManut option:selected").text();
        if ($("#iUFManut").val() != "")
            endereco += " " + $("#iUFManut option:selected").text();
        if ($("#iLogradouroManut").val() != "")
            endereco += " " + $("#iLogradouroManut").val();
        return endereco;
    }

    function confirmaEndereco() {
        $('#confirmacaoEndereco').modal('show')

        var center = mapConfirmacao.getCenter();
        google.maps.event.trigger(mapConfirmacao, 'resize');
        mapConfirmacao.setCenter(center);
    }

        var latAntigo;
        var longAntigo;

    function handleDragEndConfirmacao(event) {
        Swal.fire({
            title: 'Deseja alterar o endereço de acordo com o mapa?',
            showDenyButton: false,
            showCancelButton: true,
            confirmButtonText: 'Confirmar',
            cancelButtonText: `Cancelar`,
            icon: 'question',
            reverseButtons: true,
        }).then((result) => {
            if (result.isConfirmed) {
                //pega info do novo endereço selecionado
                fetch(`https://maps.googleapis.com/maps/api/geocode/json?latlng=${event.latLng.lat()},${event.latLng.lng()}&key=AIzaSyACnVjpiRnap58taXa7eEQJIVmD8TkoL2g`)
                    .then((response) => {
                        return response.json();
                    })
                    .then((data) => {
                        atualizaCamposConfirmacao(getAddressObject(data.results[0].address_components))
                        var latlng = new google.maps.LatLng(parseFloat(event.latLng.lat()), parseFloat(event.latLng.lng()));
                        mapConfirmacao.setCenter(latlng)
                    })

            } else {
                var latlng = new google.maps.LatLng(parseFloat(latAntigo), parseFloat(longAntigo));
                mapConfirmacao.setCenter(latlng)
                marcadorAutoCompleteConfirmacao.setPosition(latlng);
            }
        })
    }

    function getAddressObject(address_components) {
        var ShouldBeComponent = {
            home: ["street_number"],
            postal_code: ["postal_code"],
            street: ["street_address", "route"],
            region: [
                "administrative_area_level_1",
            ],
            city: [
                "administrative_area_level_2",
            ],
            country: ["country"]
        };

        var address = {
            home: "",
            postal_code: "",
            street: "",
            region: "",
            city: "",
            country: ""
        };
        address_components.forEach(component => {
            for (var shouldBe in ShouldBeComponent) {
                if (ShouldBeComponent[shouldBe].indexOf(component.types[0]) !== -1) {
                    if (shouldBe === "region") {
                        address[shouldBe] = component.short_name;
                    } else {
                        address[shouldBe] = component.long_name;
                    }
                }
            }
        });
        return address;
    }

    function atualizaCamposConfirmacao(endereco) {
        $("#iCidadeConfirmacao").val(endereco.city);
        $("#iPaisConfirmacao").val(endereco.country);
        $("#iNumeroConfirmacao").val(endereco.home);
        $("#iCEPConfirmacao").val(endereco.postal_code);
        $("#iUFConfirmacao").val(endereco.region);
        $("#iLogradouroConfirmacao").val(endereco.street);

        $("#iLatitudeConfirmacao").val(marcadorAutoCompleteConfirmacao.position.lat());
        $("#iLongitudeConfirmacao").val(marcadorAutoCompleteConfirmacao.position.lng());
    }

    $("#iLatitudeConfirmacao").focusout(function () {

        fetch(`https://maps.googleapis.com/maps/api/geocode/json?latlng=${$(this).val()},${$("#iLongitudeConfirmacao").val()}&key=AIzaSyACnVjpiRnap58taXa7eEQJIVmD8TkoL2g`)
            .then((response) => {
                return response.json();
            })
            .then((data) => {
                var latlng = new google.maps.LatLng(parseFloat($(this).val()), parseFloat($("#iLongitudeConfirmacao").val()))

                mapConfirmacao.setCenter(latlng)
                marcadorAutoCompleteConfirmacao.setPosition(latlng)
                atualizaCamposConfirmacao(getAddressObject(data.results[0].address_components))
            })

    });

    $("#iLongitudeConfirmacao").focusout(function () {

        fetch(`https://maps.googleapis.com/maps/api/geocode/json?latlng=${$("#iLatitudeConfirmacao").val()},${$(this).val()}&key=AIzaSyACnVjpiRnap58taXa7eEQJIVmD8TkoL2g`)
            .then((response) => {
                return response.json();
            })
            .then((data) => {
                var latlng = new google.maps.LatLng(parseFloat($("#iLatitudeConfirmacao").val()), parseFloat($(this).val()))

                mapConfirmacao.setCenter(latlng)
                marcadorAutoCompleteConfirmacao.setPosition(latlng)
                atualizaCamposConfirmacao(getAddressObject(data.results[0].address_components))
            })

    });

    function enviaConfirmacao() {
        ShowPageLoading()
        $("#form").submit()

    }

</script>
