                    $("#TecnicosAtivosReparo").html(data.objeto.reparo);
                    $("#TecnicosAtivosMultiskill").html(data.objeto.multiskill);
                }
            });
    }

    function RankingTenicosSupervisores()
    {
        //tecnicos ativos separados por tipo habilidade
        var rankingTenicosSupervisores = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Servicosapi/GetRankingProdutividade")';
        $.ajax({
            url: rankingTenicosSupervisores,
            type: "POST",
            dataType: "json",
            data: {
                DataReferencia: $(`#iDataReferencia`).val(),
                Contrato: $(`#iContrato`).val(),
                Projeto: $(`#iProjeto`).val(),
                Supervisor: $(`#iSupervisor`).val(),
                Monitor: $(`#iMonitor`).val(),
                NaturezaServico: $(`#iNaturezaServico`).val(),
                GrupoArea: $(`#iGrupoArea`).val(),
                Area: $(`#iArea`).val(),
                Localidade: $(`#iLocalidade`).val(),
                TipoFiltroData: Number($(`#iFiltroCardRanking`).val())
            }
        })
            .done(function (data) {
                if (data.objeto.ranking_Produtividade_Mes) {

                    if (data.objeto.ranking_Produtividade_Mes.length == 0) {
                        $(`#rankingTecnico`).html(`<div class="text-center text-truncate">
                                                     <span class="dash-text">@RsCadastros.NENHUM_REGISTRO</span>
                                                  </div>`);
                    }
                    else {

                        let conteudo = "";
                        for (var i = 0; i < data.objeto.ranking_Produtividade_Mes.length; i++) {
                            let linhaConteudo = null;
                            switch (i + 1) {
                                case 1:
                                    linhaConteudo = `<i class="fas fa-medal" style="color:#FFD700;font-size:2vh"></i>`;
                                    break;
                                case 2:
                                    linhaConteudo = `<i class="fas fa-medal" style="color:#C0C0C0;font-size:2vh"></i>`;
                                    break;
                                case 3:
                                    linhaConteudo = `<i class="fas fa-medal" style="color:#CD7F32;font-size:2vh"></i>`;
                                    break;
                                default:
                                    linhaConteudo = `<span class="dash-subtitle numberCircle">${i + 1}</span>`;
                            }

                            conteudo += `<div class="row mt-3 pl-3">
                                ${linhaConteudo}
                                <div class="col">
                                    <div class="text-left text-truncate">
                                    <span style="font-weight:bold" class="dash-text">${data.objeto.ranking_Produtividade_Mes[i].nome}</span>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="text-right pr-2">
                                    <span class="dash-text">${data.objeto.ranking_Produtividade_Mes[i].qtde_OS}</span>
                                    </div>
                                </div>
                            </div>`;
                        }

                        $(`#rankingTecnico`).html(conteudo);
                    }
                }
                if (data.objeto.ranking_Produtividade_Mes_Supervisor) {


                    if (data.objeto.ranking_Produtividade_Mes_Supervisor.length == 0) {
                        $(`#rankingSuperv`).html(`<div class="text-center text-truncate">
                                                     <span class="dash-text">@RsCadastros.NENHUM_REGISTRO</span>
                                                  </div>`);
                    }
                    else
                    {

                        let conteudo = "";
                        for (var i = 0; i < data.objeto.ranking_Produtividade_Mes_Supervisor.length; i++) {
                            let linhaConteudo = null;
                            switch (i + 1) {
                                case 1:
                                    linhaConteudo = `<i class="fas fa-medal" style="color:#FFD700"></i>`;
                                    break;
                                case 2:
                                    linhaConteudo = `<i class="fas fa-medal" style="color:#C0C0C0"></i>`;
                                case 3:
                                    linhaConteudo = `<i class="fas fa-medal" style="color:#CD7F32"></i>`;
                                    break;
                                default:
                                    linhaConteudo = `<span class="dash-subtitle numberCircle">${i + 1}</span>`;
                            }

                            conteudo += `<div class="row mt-3 pl-3">
                                                          ${linhaConteudo}
                                                          <div class="col">
                                                             <div class="text-left text-truncate">
                                                                <span style="font-weight:bold" class="dash-text">${data.objeto.ranking_Produtividade_Mes_Supervisor[i].nome}</span>
                                                             </div>
                                                          </div>
                                                          <div class="col">
                                                             <div class="text-right pr-2">
                                                                <span class="dash-text">${data.objeto.ranking_Produtividade_Mes_Supervisor[i].qtde_OS}</span>
                                                              </div>
                                                           </div>
                                                       </div>`;
                        }
                        $(`#rankingSuperv`).html(conteudo)
                    }
                }
                AlteraLabelPeriodo("iLabelPeriodoRanking", $(`#iFiltroCardRanking`).val());
            });
    }


    function CarregaDados(){
        EficienciaDia();
        BancoInstalacao();
        BacklogReparo();
        EficienciaMesReparo();
        EficienciaMesInstalacao();
        TecnicosAtivosHabilidades();
        RankingTenicosSupervisores();
        RelogioPainel();
    }



