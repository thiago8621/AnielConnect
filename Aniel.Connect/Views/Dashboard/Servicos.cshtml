@model Aniel.Connect.Models.Dashboard_Servicos_Models

@using Aniel.Connect.Core.Service
@using Microsoft.AspNet.Identity
@using Aniel.Connect.Model.enumerado

@{
    ViewBag.Title = RsBase.INICIO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    var recursos = DashBoardService.GetPaginaRecursosInicial(User.Identity.GetUserId()).Result;
    recursos.Add(12);
}

@section scripts
{

    @{

        var Tipo = DashBoardService.GetPaginaInicial(User.Identity.GetUserId()).Result;

    }


    <script>

    $('input[type=radio][name=filtroTecnicoSupervisor]').change(function () {

        let valor = $('input[name=filtroTecnicoSupervisor]:checked').val();

        if (valor === "superv") {
            $("#rankingSuperv").show();
            $("#rankingTecnico").hide();
        }
        else
        {
            $("#rankingTecnico").show();
            $("#rankingSuperv").hide();
        }

    });

    var HandleGrupo = function () {
            $('#iGrupoArea').unbind('select2:select select2:unselecting');
            $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

                GrupoSelecionado  = e.params.data
                if (GrupoSelecionado) {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false, HandleArea);
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

                else {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
    };

    var HandleArea = function () {
            $('#iArea').unbind('select2:select select2:unselecting');
            $('#iArea').on('select2:select select2:unselecting', function (e) {

                AreaSelecionada = e.params.data
                if (AreaSelecionada) {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id) , null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };

    var HandleSegmento = function () {

            $('#iContrato').unbind('select2:select select2:unselecting');
            $('#iContrato').on('select2:select select2:unselecting', function (e) {

                SegmentoSelecionado = e.params.data
                if (SegmentoSelecionado) {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, SegmentoSelecionado.id, null, "@RsBase.SELECIONE", false);
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, SegmentoSelecionado.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                    AddSelect("iSubTipoServico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });

        };

    function Relogio() {
        var currentTime = new Date();
        var currentHours = currentTime.getHours();
        var currentMinutes = currentTime.getMinutes();

        var currentDay = currentTime.getDate();
        if (currentDay < 10)
            currentDay = "0" + currentDay;

        var currentMonth = currentTime.getMonth() + 1;
        if (currentMonth < 10)
            currentMonth = "0" + currentMonth;

        var currentYear = currentTime.getFullYear();

        var currentDate = currentDay + "/" + currentMonth + "/" + currentYear;


        if (currentMinutes < 10)
            currentMinutes = "0" + currentMinutes;

        // Compose the string for display
        var currentTimeString = currentDate + " " + currentHours + ":" + currentMinutes;


        $("#relogio").html(currentTimeString);

    }

    function RelogioPainel() {
        var currentTime = new Date();
        var currentHours = currentTime.getHours();
        var currentMinutes = currentTime.getMinutes();

        if (currentMinutes < 10)
            currentMinutes = "0" + currentMinutes;

        // Compose the string for display
        var currentTimeString = currentHours + ":" + currentMinutes;
        var currentTimeString = 'Painel Atualizado às ' + currentTimeString;

        $("#relogioPainel").text(currentTimeString);
    }

    function ValidaSubmit() {
        ShowPageLoading();
        $('#form').submit();
    }

    function AlteraLabelPeriodo(idLabel, valorPeriodo) {
        if (valorPeriodo == "0") {
            $("#" + idLabel).html("Data Atual")
        }
        else if (valorPeriodo == "1") {
            $("#" + idLabel).html("Esta Semana")
        }
        else if (valorPeriodo == "2") {
            $("#" + idLabel).html("Últimos 7 Dias")
        }
        else if (valorPeriodo == "3") {
            $("#" + idLabel).html("Este Mês")
        }
        else if (valorPeriodo == "4") {
            $("#" + idLabel).html("Últimos 30 Dias")
        }
    }

    function handleClickFiltroPeriodo(idPeriodo) {

        if ($('#' + idPeriodo).is(":visible")) {
            $('#' + idPeriodo).hide();
        }
        else
        {
            $('#' + idPeriodo)[0].size = $('#' + idPeriodo)[0].length;
            $('#' + idPeriodo).show();
        }

    }

    function BancoInstalacao()
    {
        var getBancoInstalacao = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Servicosapi/GetBancoInstalacao")';
        $.ajax({
            url: getBancoInstalacao,
            type: "POST",
            dataType: "json",
            data: {
                DataReferencia: $(`#iDataReferencia`).val(),
                Contrato: $(`#iContrato`).val(),
                Projeto: $(`#iProjeto`).val(),
                Supervisor: $(`#iSupervisor`).val(),
                Monitor: $(`#iMonitor`).val(),
                NaturezaServico: $(`#iNaturezaServico`).val(),
                GrupoArea: $(`#iGrupoArea`).val(),
                Area: $(`#iArea`).val(),
                Localidade: $(`#iLocalidade`).val(),
                TipoFiltroData: Number($(`#iFiltroCardBancoInstalacao`).val())
            }
        })
            .done(function (data) {
                if (data.objeto) {
                    $("#iBancoInstalacao").html(data.objeto.total);
                    $("#iBancoInstalacaoSeteDias").html("7D - " + data.objeto.seteDias);
                    $("#iBancoInstalacaoDezDias").html("10D - " + data.objeto.dezDias);
                    $("#iBancoInstalacaoQuinzeDias").html("15D - " + data.objeto.quinzeDias);
                    $("#iBancoInstalacaoTrintaDias").html("30D - " + data.objeto.trintaDias);
                    $("#iBancoInstalacaoMaisTrintaDias").html(">30D - " + data.objeto.maisTrintaDias);

                    if (data.objeto.metaCumprida == 1)
                        $("#iBancoInstalacao").addClass(`dash-green-info`);
                    else if (data.objeto.metaCumprida == 0)
                        $("#iBancoInstalacao").addClass(`dash-red-info`);
                    else
                        $("#iBancoInstalacao").addClass(`dash-yellow-info`);

                    AlteraLabelPeriodo("iLabelPeriodoBancoInstalacao", $(`#iFiltroCardBancoInstalacao`).val());
                }
            });
    }

