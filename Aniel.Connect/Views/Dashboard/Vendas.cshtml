@section scripts
{
    @{
        var Tipo = DashBoardService.GetPaginaInicial(User.Identity.GetUserId()).Result;
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/apexcharts/5.3.1/apexcharts.min.js"></script>
    <script>
        /*Reestruturação*/
@*--        LinkApis        --*@
const [metaUrl, vendasAprovadasUrl, vendasPendentesUrl, desistenciasUrl, vendasInstaladasUrl, vendasStatusUrl, funilvendasUrl] =
    ['@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Vendasapi/GetMetaUser")',
     '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Vendasapi/GetVendasAprovadasUser")',
     '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Vendasapi/GetVendasPendentesUser")',
     '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Vendasapi/GetDesistenciasUser")',
     '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Vendasapi/GetVendasInstaladasUser")',
     '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Vendasapi/GetVendasByStatusUser")',
     '@String.Concat(CONSTANTES.URLPortal,"/api/Dashboard_Vendasapi/GetFunilVendasUser")'
    ];

    async function getMeta() {
        let registrosMeta = await $.ajax({
            url: metaUrl, type: 'POST', datatype: 'json', data: {
                DataFiltrada: $("#iFiltroCardMeta option:selected").val(),
                FormatoVisualizacao: $("#iFormatoVisu").val()
            }
        });

        if (!registrosMeta.ok) {
            Notificar("@RsBase.ATENCAO_", "Meta não encontrada", "warning");
            $(".numVendas2").html(`Sem Meta`);
            return false;
        }
        const { vendas, meta, vendasTotais } = registrosMeta.idObjeto;
        let arredondado = Math.round(vendas);
        let porcentagem = Math.round(Number(vendasTotais / meta) * 100);
        $(".numVendas").html(`${porcentagem}%`);
        $(".numVendas2").html(`${vendasTotais} de ${Math.round(meta)} Vendas`);

        $("#iProggressVenda").css("width", `${porcentagem}%`);
        $("#iProggressTotal").css("width", `${100 - porcentagem}%`);
    }

    async function getVendasAprovadas() {
        let registrosVA = await $.ajax({
            url: vendasAprovadasUrl, type: 'POST', datatype: 'json', data: {
                DataFiltrada: $("#iFiltroCardAprovadas").val(),
                FormatoVisualizacao: $("#iFormatoVisu").val()
            }
        });
        $("#iVendasAprovadas").html(registrosVA.idObjeto);
    }

    async function getDesistencia() {
        let registrosDesistencia = await $.ajax({
            url: desistenciasUrl, type: 'POST', datatype: 'json', data: {
                DataFiltrada: $("#iFiltroCardDesistencias").val(),
                FormatoVisualizacao: $("#iFormatoVisu").val()
            }
        });
        $("#iDesistencias").html(registrosDesistencia.idObjeto);
    }

    async function getVendasPendentes() {
        let registrosVP = await $.ajax({
            url: vendasPendentesUrl, type: 'POST', datatype: 'json', data: {
                DataFiltrada: $("#iFiltroCardPendentes").val(),
                FormatoVisualizacao: $("#iFormatoVisu").val()
            }
        });
        $("#iVendasPendentes").html(registrosVP.idObjeto);
    }

    async function getVendasInstaladas() {
        let registrosVI = await $.ajax({
            url: vendasInstaladasUrl, type: 'POST', datatype: 'json', data: {
                DataFiltrada: $("#iFiltroCardInstaladas").val(),
                FormatoVisualizacao: $("#iFormatoVisu").val()
            }
        });
        let comparativoInstaladosAprovados = `De ${registrosVI.idObjeto.vendasAprovadas} ${registrosVI.idObjeto.vendasAprovadas > 1 ? 'Aprovadas' : 'Aprovada'} — ${registrosVI.idObjeto.vendasInstaladas} ${registrosVI.idObjeto.vendasInstaladas > 1 ? 'foram Instaladas' :'foi Instalada'}`;

        $("#iVendasInstaladas").html(comparativoInstaladosAprovados);
        $("#iPercVendasInstaladas").html(registrosVI.idObjeto.percentualVendasInstaladas + "%");
        $("#iProggressVendasInstaladas").css("width", `${registrosVI.idObjeto.percentualVendasInstaladas}%`);
        $("#iProggressVendasAprovadas").css("width", `${100 - registrosVI.idObjeto.percentualVendasInstaladas}%`);
    }

    async function getVendasStatus() {

        let registrosVS = await $.ajax({
            url: vendasStatusUrl, type: 'POST', datatype: 'json', data: {
                DataFiltrada: $("#iFiltroCardStatus").val(),
                FormatoVisualizacao: $("#iFormatoVisu").val()
            }
        });

        let results = [registrosVS.idObjeto.vendasPendentes, registrosVS.idObjeto.desistencias, registrosVS.idObjeto.vendasAprovadas, registrosVS.idObjeto.vendasInstaladas];
        let url = `@(Url.Action("Index","Venda"))?dataFiltrada=${$("#iFiltroCardStatus").val()}&formato=${$("#iFormatoVisu").val() }`
        let eventos = [{ url: url + "&filtroDashBoard=12", cor:"#FCE405"}, { url:url + "&filtroDashBoard=13", cor:"#E77D7D"}, { url:url + "&filtroDashBoard=1", cor:"#57B96D"}, { url:url + "&filtroDashBoard=14", cor:"#007BFF"}];
        let categories = ["Pendentes", "@RsCadastros.DESISTENCIAS", "Aprovadas", "Instaladas"]
        let dadosFormatados = results.map((resultado, index) => { return { x:categories[index], y: resultado, fillColor: eventos[index]["cor"], url: eventos[index]["url"] } })
        let options = {
            grid: {                
                padding: {
                    right: 30
                },
            },
            chart: {
                width: '85%',
                type: 'bar',
                events: {
                    dataPointSelection: function (event, chartContext, config) {

                        const [seriesIndex, dataPointIndex] = [config.seriesIndex, config.dataPointIndex]

                        if (dataPointIndex !== -1) {
                            const url = config.w.config.series[seriesIndex].data[dataPointIndex].url;

                            if (url) {
                                AddAba(url, '@RsCadastros.PAINEL_VENDAS');
                            }
                        }
                    }
                },
                toolbar: { show: false }
            },           
            series: [{ data: dadosFormatados }],
            plotOptions: {
                bar: {
                    barHeight: '33%',
                    borderRadius: 1,
                    borderRadiusApplication: "end",
                    horizontal: true
                }
            },
            yaxis: {
                labels: {
                    padding: 50,
                    style: {fontSize:'0.9vw'},
                    formatter: function (value) {
                        const el = document.createElement('textarea');                        
                        el.innerHTML = value;                        
                        return el.value;
                    },
                },
                axisBorder: {
                    show: true,
                    color: '#c0c0c0',
                    width: 1
                }
            },
            xaxis: {
                max: Math.max(...results) + 20,
                labels: { show: false },
                axisTicks: {
                    show: false
                },
                axisBorder: {
                    show: false
                },
                lines: {
                    show: false
                }               
            },
            dataLabels: {
                enabled: true,
                style: { colors: ['#000000']},                
                offsetX: 500,
            },
            tooltip: { enabled: false },        

            legend: {
                position: 'bottom'
            },
        }

        $("#iVendasStatus").empty();
        const chartVendasStatus = new ApexCharts(
            document.querySelector("#iVendasStatus"),
            options
        );
        chartVendasStatus.render();
    }

    async function getFunilVendas() {

        let registrosFunil = await $.ajax({
            url: funilvendasUrl, type: 'POST', datatype: 'json', data: {
                DataFiltrada: $("#iFiltroCardFunil").val(),
                FormatoVisualizacao: $("#iFormatoVisu").val()
            }
        });
       
        const [variaveis, valores] = [Object.getOwnPropertyNames(registrosFunil.idObjeto),
                                     [registrosFunil.idObjeto.leads_Cadastrados, registrosFunil.idObjeto.vendas_Aprovadas,
                                      registrosFunil.idObjeto.vendas_Cadastradas, registrosFunil.idObjeto.vendas_Instaladas]];

        let colors = ["#B8C7CE", "#57B96D", "#FCE405", "#1B61E3"];

        let resultado = variaveis.map((chave, indice) => ({
            x: (valores[indice] > 1 ? chave.replace(/_/g, " ") : chave.replace(/_/g, " ").replace(/(\w+)(s|S)(?=\s|$)/g, '$1')).replace(/^\w/, c => c.toUpperCase()),
            //y: valoresPadroes[indice],
            fillColor: colors[indice],
            label: `${chave}: ${valores[indice]}`,
            labelOriginal: chave,
            valor: valores[indice]            
        })).sort((registro1, registro2) => registro2.valor - registro1.valor);

        let resultadoOrdenado = [];

        
        let menor = 40;
        for (let i = 0; i < resultado.length; i++) {            
            
            resultado[i].y = resultado[i].valor + menor;
        }

        resultadoOrdenado.push(resultado.find(p => p.labelOriginal == variaveis[0]));
        resultadoOrdenado.push(resultado.find(p => p.labelOriginal == variaveis[2]));
        resultadoOrdenado.push(resultado.find(p => p.labelOriginal == variaveis[1]));
        resultadoOrdenado.push(resultado.find(p => p.labelOriginal == variaveis[3]));
        
        let options = {
            series: [{ data: resultadoOrdenado }],
            chart: {
                width: '100%',
                type: 'bar',
                dropShadow: { enabled: false },
                toolbar: { show: false }
            },           
            dataLabels: {
                enabled: true,
                style: {
                    colors: ["#000000"],
                    fontWeight: "bold",
                    fontSize:"0.8vw"
                },
                formatter: (val, opts) => {
                    const dataPoint = opts.w.config.series[opts.seriesIndex].data[opts.dataPointIndex];

                    return `${dataPoint.valor} ${dataPoint.x}`;
                },
                offsetY:0
            },            
            plotOptions: {
                bar: {
                    borderRadius: 0,
                    horizontal: true,
                    barHeight: '80%',
                    isFunnel: true,
                    isFunnel3d: false
                }
            },
            tooltip: { enabled: false },
            //xaxis: {
            //    categories: Object.getOwnPropertyNames(resultado)
            //},
            //responsive: [{
            //    breakpoint: 480,
            //    options: {
            //        chart: {
            //            width: 200
            //        },
            //        legend: {
            //            position: 'bottom'
            //        }
            //    }
            //}],
            title: {align:'middle'},
            legend: {
                show: false,
            },
        };

        $("#iFunilVendas").empty();
        const chartFunilVendas = new ApexCharts(
            document.querySelector("#iFunilVendas"),
            options
        );

        chartFunilVendas.render();
    }
    function handleClickFiltroPeriodo(idPeriodo) {
        if ($('#' + idPeriodo).is(":visible")) {
            $('#' + idPeriodo).hide();
        }
        else {
            $('#' + idPeriodo)[0].size = $('#' + idPeriodo)[0].length;
            $('#' + idPeriodo).show();
        }
    }

    function handleLegendaFiltro(texto, campo, valor, usuario) {
        let legenda = "";
        switch (campo) {
            case "iFiltroCardMeta": legenda = "iLegendaMeta";
                break;
            case "iFiltroCardAprovadas": legenda = "iLegendaAprovadas";
                break;
            case "iFiltroCardPendentes": legenda = "iLegendaPendentes";
                break;
            case "iFiltroCardDesistencias": legenda = "iLegendaDesistentes";
                break;
            case "iFiltroCardInstaladas": legenda = "iLegendaInstaladas";
                break;
            case "iFiltroCardStatus": legenda = "iLegendaStatus";
                break;
            case "iFiltroCardFunil": legenda = "iLegendaFunil";
                break;
        }

        let strLegenda = valor == 0 ? "Dia Corrente" :
                         valor == 1 ? "Semana Corrente" :
                         valor == 2 ? "Últimos 7 Dias" :
                         valor == 3 ? "Mês Corrente" :
                         "Últimos 30 Dias";

        $(`#${legenda}`).html(`${texto[0]}${strLegenda}${texto[1]}${usuario}`);
        return;
    }

    $(document).ready(async function () {
        $("#iFormatoVisu").trigger('change');
    });

    $("#iFiltroCardMeta").on("change", async function () {
        this.size = 1;
        $(this).hide();
        await getMeta();

    });

    $("#iFiltroCardAprovadas").on("change", async function () {
        this.size = 1;
        $(this).hide();
        await getVendasAprovadas();

    });
    $("#iFiltroCardDesistencias").on("change", async function () {
        this.size = 1;
        $(this).hide();
        await getDesistencia();

    });
    $("#iFiltroCardPendentes").on("change", async function () {
        this.size = 1;
        $(this).hide();
        await getVendasPendentes();
    });
    $("#iFiltroCardInstaladas").on("change", async function () {
        this.size = 1;
        $(this).hide();
        await getVendasInstaladas();

    });
    $("#iFiltroCardStatus").on("change", async function () {
        this.size = 1;
        $(this).hide();
        await getVendasStatus();

    });
    $("#iFiltroCardFunil").on("change", async function () {
        this.size = 1;
        $(this).hide();
        await getFunilVendas();

    });

    $("#iFormatoVisu").off("change");
    $("#iFormatoVisu").on("change", function () {
        /*Uso de apis*/
        @if (recursos. Contains(Convert.ToInt32(Dashboard_Comercial.Minha_Meta)))
        {
            <text>$("#iFiltroCardMeta").trigger('change');</text>
        }
        @if (recursos. Contains(Convert.ToInt32(Dashboard_Comercial.Vendas_Aprovadas)))
        {
            <text>$("#iFiltroCardAprovadas").trigger("change");</text>
        }
        @if (recursos. Contains(Convert.ToInt32(Dashboard_Comercial.Vendas_Pendentes)))
        {
            <text>$("#iFiltroCardPendentes").trigger("change");</text>
        }
        @if (recursos. Contains(Convert.ToInt32(Dashboard_Comercial.Desistencias)))
        {
            <text>$("#iFiltroCardDesistencias").trigger("change");</text>
        }
        @if (recursos. Contains(Convert.ToInt32(Dashboard_Comercial.Vendas_Instaladas)))
        {
            <text>$("#iFiltroCardInstaladas").trigger("change");</text>
        }
        @if (recursos. Contains(Convert.ToInt32(Dashboard_Comercial.Vendas_Status)))
        {
            <text>$("#iFiltroCardStatus").trigger("change");</text>
        }
        @if (recursos. Contains(Convert.ToInt32(Dashboard_Comercial.Funil_Vendas)))
        {
            <text>$("#iFiltroCardFunil").trigger("change");</text>
        }
    });

    $(".filtrosDash").on("change", function () {
        const [filtro, valor, usuario] = [$(this).prop("id"), $(this).val(), '@(User.Identity.GetUserName())'];

        handleLegendaFiltro`Abrangência : ${filtro} - ${valor}${usuario}`;
    });
    </script>
}
@Html.Hidden("VisualizacaoDashboard", Convert.ToInt64(Model.VisualizacaoDashboard),new {@id = "iFormatoVisu" })
<div style="margin-left: -15px; margin-right:15px;">

