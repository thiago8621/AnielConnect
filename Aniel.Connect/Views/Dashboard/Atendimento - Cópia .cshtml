@model Aniel.Connect.Models.Dashboard_Atendimento_Models

@using Chart.Mvc.ComplexChart;
@using Chart.Mvc.SimpleChart;
@using Chart.Mvc.Extensions;
@using Aniel.Connect.Core.Service
@using Microsoft.AspNet.Identity
@using Aniel.Connect.Model.enumerado
@using Aniel.Connect.ControllersWebApi;

@{
    ViewBag.Title = RsBase.INICIO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@{

    var doughnutFlagsAtendimento = new DoughnutChart();
    var doughnutOptions = (from o in Model.Flags_Atendimento
                           select new SimpleData
                           {
                               Color = o.Cor,
                               Label = o.Descricao,
                               Value = o.Valor,
                               Highlight = o.Cor
                           }).ToList();

    doughnutFlagsAtendimento.Data = doughnutOptions;


    var recursos = DashBoardService.GetPaginaRecursosInicial(User.Identity.GetUserId()).Result;

    //PARTE DO CHAT QIUE DESENVOLVEREMOS POSTERIORMENTE
    //var qtd_mensagens = new ChatApiController().GetQtdMensagens().Result.Qtd_Mensagens;
    //var mensagens = new ChatApiController().GetMensagens().Result;

}

<script src="~/bin/Scripts/Chart.js"></script>

@section scripts
{
    @if (recursos.Count == 0)
    {
        <text>
            <script>
                $(document).ready(function () {
                    Notificar("Atenção", "Você não possui nenhum perfil Dashboard definido para seu usuário. Por isso a página inicial está em branco", "warning");
                });
            </script>
        </text>
    }

    <script>
        //Preenchendo dados dos cards

        //Atendimentos Pendentes
        $(document).ready(function () {
            var atendimentoPendenteUrl = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetAtendimentoPendente")';
            $.ajax({
                url: atendimentoPendenteUrl,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.atendimentos_Pendentes) {
                    $("#iAtendimentosPendentes").html(data.objeto.atendimentos_Pendentes);
                }
            });

            //Total de Atendimento no Mês (Usuário)
            var atendimentoMesUsuarioUrl = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetAtendimentosMesUsuario")';
            $.ajax({
                url: atendimentoMesUsuarioUrl,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.total_Atendimentos_Mes_Usuario) {
                    $("#iAtendimentosMesUsuario").html(data.objeto.total_Atendimentos_Mes_Usuario);
                }
            });

            //Total de Atendimento no Mês (Geral)
            var atendimentoMesGeralUrl = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetAtendimentosMesGeral")';
            $.ajax({
                url: atendimentoMesGeralUrl,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.total_Atendimentos_Mes_Geral) {
                    $("#iAtendimentosMesGeral").html(data.objeto.total_Atendimentos_Mes_Geral);
                }
            });

            //Tempo Médio de Atendimento
            var tempoMedioAtendimentoUrl = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetTempoMedioAtendimento")';
            $.ajax({
                url: tempoMedioAtendimentoUrl,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.tempo_Medio_Atendimento) {
                    $("#iTempoMedioAtendimento").html(data.objeto.tempo_Medio_Atendimento);
                }
            });

            //Atendimento Pendente Equipe
            var atendimentoPendenteEquipeUrl = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetAtendimentoPendenteEquipe")';
            $.ajax({
                url: atendimentoPendenteEquipeUrl,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.atendimentos_Pendentes_Equipe) {
                    $("#iAtendimentoPendenteEquipe").html(data.objeto.atendimentos_Pendentes_Equipe);
                }
            });

            //A Iniciar
            var aIniciarUrl = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetA_Iniciar")';
            $.ajax({
                url: aIniciarUrl,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.a_Iniciar) {
                    $("#iA_Iniciar").html(data.objeto.a_Iniciar);
                }
            });

            //Em Atendimento
            var emAtendimentoUrl = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetEmAtendimento")';
            $.ajax({
                url: emAtendimentoUrl,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.em_Atendimento) {
                    $("#iEm_Atendimento").html(data.objeto.em_Atendimento);
                }
            });

            //Em Andamento
            var aguardandoUrl = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetAguardando")';
            $.ajax({
                url: aguardandoUrl,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.aguardando) {
                    $("#iAguardando").html(data.objeto.aguardando);
                }
            });

            //Chat

            //Carregando as Mensagens
            @*$.ajax({
                url: '@String.Concat(CONSTANTES.URLPortal,"/api/ChatApi/GetMensagens")',
                type: 'POST',
                dataType: 'json'
            })
            .done(function (data) {

                var num_id = [];

                $.each(data, function (index) {

                    if (!num_id.includes(data[index].num_Identificador)) {

                        $("#displayConversas").append(
                            '<div class="aba-mensagens conversa[' + data[index].num_Identificador + '">' +
                                '<div class="col" style="font-size:0.8rem">' +
                                    '<strong>' + data[index].num_Identificador + '</strong>' +
                                '</div>' +
                                '<div class="col" style="font-size:0.8rem; text-overflow:ellipsis">' +
                                    data[index].mensagem +
                                '</div>' +
                            '</div>'
                        );

                        num_id.push(data[index].num_Identificador);
                    }
                    else {
                        $(".conversa[" + data[index].num_Identificador + "]").html(
                            '<div class="col" style="font-size:0.8rem">' +
                                '<strong>' + data[index].num_Identificador + '</strong>' +
                            '</div>' +
                            '<div class="col" style="font-size:0.8rem; text-overflow:ellipsis">' +
                                data[index].mensagem +
                            '</div>'
                        );
                    }

                });

                $.each(data, function (index) {

                    if (data[index].remetente == '@User.Identity.GetUserId()') {

                        $("#displayMensagens").append(
                            '<div class="row mensagem[' + data[index].num_Identificador + ']">' +
                                '<div class="chat-mensagem-enviada col" style="display: none">' +
                                    data[index].mensagem +
                                '</div>' +
                            '</div>'
                        );

                    }
                    else {

                        $("#displayMensagens").append(
                            '<div class="row mensagem[' + data[index].num_Identificador + ']">' +
                                '<div class="chat-mensagem-recebida col" style="display: none">' +
                                    data[index].mensagem +
                                '</div>' +
                            '</div>'
                        );

                    }

                });
            });*@

        });



    </script>
}

