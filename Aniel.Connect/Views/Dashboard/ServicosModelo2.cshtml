                        @*<a class="dropdown-item" href="#" data-toggle="modal" data-target="#modal-config"><i class="la la-save la-2x" style="color: #999"></i>Salvar Filtros</a>
                            <a class="dropdown-item" href="#" data-toggle="modal" data-target="#modal-config"><i class="la la-file-pdf la-2x" style="color: #999"></i>@RsBase.EXPORTARPDF</a>*@
