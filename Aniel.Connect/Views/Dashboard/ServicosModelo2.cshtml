    function calcularMediaColuna(index, table) {
        var total = 0;
        var rowCount = 0;

        table.rows({ page: 'current' }).data().each(function (data) {
            var valor = table.cell(data, index).data();

            valor = parseFloat(valor.toString().replace('%', '')) || 0;

            total += valor;
            rowCount++;
        });

        var media = rowCount > 0 ? total / rowCount : 0;

        return media.toFixed(2) + '%';
    }


    function calcularSomaColuna(indexColuna, table) {
            var total = 0;
            table.column(indexColuna, { page: 'all' }).data().each(function (value, index) {
                var numero = parseFloat(value) || 0;
                total += numero;
            });
            return total;
        }

