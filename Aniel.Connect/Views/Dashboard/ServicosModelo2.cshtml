@using (Html.BeginForm("Servicos", "Dashboard", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    <div class="modal" id="modal-config">

        <div class="modal-dialog modal-lg">

            <div class="modal-content">

                <div class="modal-header">
                    <h4 class="modal-title text-muted"> Configurações Dashboard </h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">

                    <div class="form-inline mb-3">
                        Banco de @ViewBag.DescricaoTipoHabilidade1 não pode ser superior a @Html.TextBoxFor(p => p.MetaBancoInstalacao, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })% da capacidade diaria
                    </div>
                    <div class="form-inline mb-3">
                        Banco de @ViewBag.DescricaoTipoHabilidade0 não pode ser superior a @Html.TextBoxFor(p => p.MetaBacklogReparo, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })% da capacidade diaria
                    </div>
                    <div class="form-inline mb-3">
                        Meta de Eficiencia mes para @ViewBag.DescricaoTipoHabilidade1: @Html.TextBoxFor(p => p.MetaEficienciaMesInstalacao, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })%
                    </div>
                    <div class="form-inline mb-3">
                        Meta de Eficiencia mes para @ViewBag.DescricaoTipoHabilidade0: @Html.TextBoxFor(p => p.MetaEficienciaMesReparo, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })%
                    </div>
                    <div class="mb-3">
                        Metas de eficiencia do dia
                        <div class="container">
                            <div class="form-inline mb-2">
                                Total: @Html.TextBoxFor(p => p.MetaEficienciaDiaTotal, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })%
                            </div>
                            <div class="form-inline mb-2">
                                @ViewBag.DescricaoTipoHabilidade1: @Html.TextBoxFor(p => p.MetaEficienciaDiaInstalacao, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })%
                            </div>
                            <div class="form-inline mb-2">
                                @ViewBag.DescricaoTipoHabilidade0: @Html.TextBoxFor(p => p.MetaEficienciaDiaReparo, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })%
                            </div>
                            <div class="form-inline mb-2">
                                @ViewBag.DescricaoTipoHabilidade2: @Html.TextBoxFor(p => p.MetaEficienciaDiaMultiskill, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })%
                            </div>
                        </div>
                    </div>
                    <div class="form-inline mb-3">
                        Meta de Reclamação Inicial: @Html.TextBoxFor(p => p.MetaReclamacaoInicial, new { @class = "form-control text-center  mr-1 ml-1", style = "width: 4rem !important" })%
                    </div>
                    <div class="form-inline mb-3">
                        Meta de Repetidas: @Html.TextBoxFor(p => p.MetaRepetidas, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })%
                    </div>
                    <div class="mb-3">
                        Metas de atendimento dentro da janela
                        <div class="container">
                            <div class="form-inline mb-2">
                                @ViewBag.DescricaoTipoHabilidade1: @Html.TextBoxFor(p => p.MetaAtendimentoJanelaInstalacao, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })%
                            </div>
                            <div class="form-inline mb-2">
                                @ViewBag.DescricaoTipoHabilidade0: @Html.TextBoxFor(p => p.MetaAtendimentoJanelaReparo, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })%
                            </div>
                            <div class="form-inline mb-2">
                                @ViewBag.DescricaoTipoHabilidade2: @Html.TextBoxFor(p => p.MetaAtendimentoJanelaMultiskill, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })%
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        Custo Médio por Serviço
                        <div class="container">
                            <div class="form-inline mb-2">
                                @ViewBag.DescricaoTipoHabilidade1: @Html.TextBoxFor(p => p.MetaCustoMedioInstalacao, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })
                            </div>
                            <div class="form-inline mb-2">
                                @ViewBag.DescricaoTipoHabilidade0: @Html.TextBoxFor(p => p.MetaCustoMedioReparo, new { @class = "form-control text-center mr-1 ml-1", style = "width: 4rem !important" })
                            </div>

                        </div>
                    </div>






                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success mx-auto" onclick="ValidaSubmit();">Salvar</button>
                </div>

            </div>



        </div>

    </div>
}

<div class="modal modalFiltros" id="modalFiltros">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
