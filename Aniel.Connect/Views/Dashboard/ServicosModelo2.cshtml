                if (AreaSelecionada) {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id) , null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };

    var HandleSegmento = function () {

            $('#iContrato').unbind('select2:select select2:unselecting');
            $('#iContrato').on('select2:select select2:unselecting', function (e) {

                SegmentoSelecionado = e.params.data
                if (SegmentoSelecionado) {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, SegmentoSelecionado.id, null, "@RsBase.SELECIONE", false);
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, SegmentoSelecionado.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                    AddSelect("iSubTipoServico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });

        };

    function Relogio() {
        var currentTime = new Date();
        var currentHours = currentTime.getHours();
        var currentMinutes = currentTime.getMinutes();

        var currentDay = currentTime.getDate();
        if (currentDay < 10)
            currentDay = "0" + currentDay;

        var currentMonth = currentTime.getMonth() + 1;
        if (currentMonth < 10)
            currentMonth = "0" + currentMonth;

        var currentYear = currentTime.getFullYear();

        var currentDate = currentDay + "/" + currentMonth + "/" + currentYear;


        if (currentMinutes < 10)
            currentMinutes = "0" + currentMinutes;

        // Compose the string for display
        var currentTimeString = currentDate + " " + currentHours + ":" + currentMinutes;


        $("#relogio").html(currentTimeString);

    }

    function RelogioPainel() {
        var currentTime = new Date();
        var currentHours = currentTime.getHours();
        var currentMinutes = currentTime.getMinutes();

        if (currentMinutes < 10)
            currentMinutes = "0" + currentMinutes;

        // Compose the string for display
        var currentTimeString = currentHours + ":" + currentMinutes;
        var currentTimeString = 'Painel Atualizado às ' + currentTimeString;

        $("#relogioPainel").text(currentTimeString);
    }

    function ValidaSubmit() {
        ShowPageLoading();
        $('#form').submit();
    }

    function AlteraLabelPeriodo(idLabel, valorPeriodo) {
        if (valorPeriodo == "0") {
            $("#" + idLabel).html("Data Atual")
        }
        else if (valorPeriodo == "1") {
            $("#" + idLabel).html("Esta Semana")
        }
        else if (valorPeriodo == "2") {
            $("#" + idLabel).html("Últimos 7 Dias")
        }
        else if (valorPeriodo == "3") {
            $("#" + idLabel).html("Este Mês")
        }
        else if (valorPeriodo == "4") {
            $("#" + idLabel).html("Últimos 30 Dias")
        }
    }

    function handleClickFiltroPeriodo(idPeriodo) {

        if ($('#' + idPeriodo).is(":visible")) {
            $('#' + idPeriodo).hide();
        }
        else
        {
            $('#' + idPeriodo)[0].size = $('#' + idPeriodo)[0].length;
            $('#' + idPeriodo).show();
        }

    }

    function Filtrar(modalFiltro) {
        if (modalFiltro == "1") {
            ServicosStatusExecucao();
        }
        if (modalFiltro == "2") {
            ServicosFechadosProdImprod();
        }
        if (modalFiltro == "3") {
            ProxVencimentoPerdaPrazo();
        }
        if (modalFiltro == "4") {
            PainelIndicadoresRegional();
        }
        if (modalFiltro == "5") {
            TopEncerramentos();
        }
        $('#modalFiltros').modal('hide');
        $('#modalFiltrosPeriodo').modal('hide');
    }

    function CarregaDados() {

        //Limpa todos os filtros
        $(`#iDataReferenciaPeriodo`).val('');
        $(`#iContratoPeriodo`).val('');
        $(`#iProjetoPeriodo`).val('');
        $(`#iSupervisorPeriodo`).val('');
        $(`#iTecnicoPeriodo`).val('');
        $(`#iNatureza`).val('');
        $(`#iGrupoAreaPeriodo`).val('');
        $(`#iAreaPeriodo`).val('');
        $(`#iLocalidadePeriodo`).val('');
        $(`#iFiltroCard`).val('');
        $(`#iDataReferencia`).val('');
        $(`#iContrato`).val('');
        $(`#iProjeto`).val('');
        $(`#iSupervisor`).val('');
        $(`#iTecnico`).val('');
        $(`#iNatureza`).val('');
        $(`#iGrupoArea`).val('');
        $(`#iArea`).val('');
        $(`#iLocalidade`).val('');
        $(`#iFiltroCard`).val('');
        $(`#iDataReferenciaPeriodo`).prop('selectedIndex', 0);
        $(`#iContratoPeriodo`).prop('selectedIndex', 0);


        TopEncerramentos();
        ProxVencimentoPerdaPrazo();
        ServicosFechadosProdImprod();
        ServicosStatusExecucao();
        PainelIndicadoresRegional();

        RelogioPainel();
    }

    var modalFiltro = null;

        $(document).ready(function () {

            $('table').each(function () {
                $(this).addClass('tg');
            });

            $('td, th').each(function () {
                $(this).addClass('tg-0pky');
            });

        $("input[name='tipoFiltroRegional']").change(function () {
            PainelIndicadoresRegional();
        });

        if (!$('input[name="tipoFiltroRegional"]:checked').length) {
            $('input[name="tipoFiltroRegional"][value="0"]').prop('checked', true);
        }

        $("input[name='tipoStatusExecucao']").change(function () {
            TopEncerramentos();
        });

        if (!$('input[name="tipoStatusExecucao"]:checked').length) {
            $('input[name="tipoStatusExecucao"][value="0"]').prop('checked', true);
        }

        $('a[data-toggle="modal"]').on('click', function () {
            modalFiltro = $(this).data('modal-filtro');
            if (modalFiltro == 4) {
                $('#divNatureza').hide();
            } else {
                $('#divNatureza').show();
            }
        });

        AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupo);
        AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iTecnico", "@CONSTANTES.URLPortal/api/IdentityUserApi/GetComboMonitor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iNatureza", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        AddSelect("iGrupoAreaPeriodo", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupo);
        AddSelect("iAreaPeriodo", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        AddSelect("iLocalidadePeriodo", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        AddSelect("iSupervisorPeriodo", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iTecnicoPeriodo", "@CONSTANTES.URLPortal/api/IdentityUserApi/GetComboMonitor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iNaturezaFiltro", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        setInterval('Relogio()', 1000);

        CarregaDados();
    });

    // Função para ajustar o layout
    function ajustarLayout(item, proxitem) {
        var selectHeight = $('#' + item).next('.select2-container').find('.select2-selection__rendered').height();

        // Ajusta a margem superior do próximo elemento para que ele não seja sobreposto
        $('#' + proxitem).css('margin-bottom', selectHeight + 20); // 20px de espaço extra
    }

    // Monitora mudanças no Select2 e ajusta o layout
    $('#iNaturezaFiltro').on('change', function () {
        ajustarLayout('iNaturezaFiltro', 'divButton');
    });

    </script>
}

