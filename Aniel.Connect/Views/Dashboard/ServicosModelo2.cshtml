        </div>

        <div class="col">

            <div class="form-inline" style="float: right;">
                <div class="ml-3">
                    <a class="btn btn-success btn-add-2 mr-2" href="#" id="btnAtualizar" onclick="CarregaDados()" title="Atualizar" return true;">
                        <i class="fas fa-sync-alt" style="color: #fff"></i>
                    </a>

                    <button class="btn btn-default btn-add" style="float:right" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
