                                    <input type="radio" name="tipoStatusExecucao" value="2" id="produtivo">
                                    <label for="produtivo"><small>Produtivo</small></label>

                                    <input type="radio" name="tipoStatusExecucao" value="1" id="improdutivo">
                                    <label for="improdutivo"><small>Improdutivo</small></label>
                                </div>
                                <div id="divTableTopEncerramentos">
                                    <table class="table table-hover nowrap" id="datatable" style="width:100%">
                                        <thead class="tb-head">
                                        </thead>
                                    </table>
                                </div>
                            </div>
                            <div class="card-footer text-center">
                                <div id="FiltrosUtilizadosTopEncerramentos" class="mr-2 ml-2 ">
                                </div>
