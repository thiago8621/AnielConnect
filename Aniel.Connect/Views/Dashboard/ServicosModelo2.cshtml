                                <option value="">@RsBase.SELECIONE</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" id="divButton">
                <button type="button" class="btn btn-success mx-auto" onclick="Filtrar(modalFiltro);">Filtrar</button>
            </div>

        </div>

    </div>

</div>

