                                <div id="divTableServicosStatusExecucao">
                                    <table class="table table-hover nowrap" id="datatableServicosStatusExecucao" style="width:100%">
                                    </table>
                                </div>
                            </div>
                            <div class="card-footer text-center">
                                <div id="FiltrosUtilizadosServicosStatusExecucao" class="mr-2 ml-2 ">
