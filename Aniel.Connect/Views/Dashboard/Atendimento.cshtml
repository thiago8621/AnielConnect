@model Aniel.Connect.Models.Dashboard_Atendimento_Models

@using Chart.Mvc.ComplexChart;
@using Chart.Mvc.SimpleChart;
@using Chart.Mvc.Extensions;
@using Aniel.Connect.Core.Service
@using Microsoft.AspNet.Identity
@using Aniel.Connect.Model.enumerado
@using Aniel.Connect.ControllersWebApi;

@{
    ViewBag.Title = RsBase.INICIO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@{

    var doughnutFlagsAtendimento = new DoughnutChart();
    var doughnutOptions = (from o in Model.Flags_Atendimento
                           select new SimpleData
                           {
                               Color = o.Cor,
                               Label = o.Descricao,
                               Value = o.Valor,
                               Highlight = o.Cor
                           }).ToList();

    doughnutFlagsAtendimento.Data = doughnutOptions;


    var recursos = DashBoardService.GetPaginaRecursosInicial(User.Identity.GetUserId()).Result;

    //PARTE DO CHAT QIUE DESENVOLVEREMOS POSTERIORMENTE
    //var qtd_mensagens = new ChatApiController().GetQtdMensagens().Result.Qtd_Mensagens;
    //var mensagens = new ChatApiController().GetMensagens().Result;

}

<script src="~/bin/Scripts/Chart.js"></script>

@section scripts
{
    @if (recursos.Count == 0)
    {
        <text>
            <script>
                $(document).ready(function () {
                    Notificar("Atenção", "Você não possui nenhum perfil Dashboard definido para seu usuário. Por isso a página inicial está em branco", "warning");
                });
            </script>
        </text>
    }

    <script>
        //Preenchendo dados dos cards

        //Atendimentos do Usuario nos últimos 30 dias
        $(document).ready(function () {
            var atendimentoPendenteUrl = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetAtendimentosMesUsuario")';
            $.ajax({
                url: atendimentoPendenteUrl,
                type: "POST",
                data: null,
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.total_Atendimentos_Mes_Usuario) {
                    $("#iTotalAtendimentosUser").html(data.objeto.total_Atendimentos_Mes_Usuario);
                }
            });

            //Total de Atendimento Em Aberto (Usuário)
            var atendimentoAbertoUsuario = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetAtendimentosMesUsuario")';
            $.ajax({
                url: atendimentoAbertoUsuario,
                type: "POST",
                data: {
                    FiltrarEmAberto: true
                },
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.total_Atendimentos_Mes_Usuario) {
                    $("#iTotalAtendimentosAbertosUser").html(data.objeto.total_Atendimentos_Mes_Usuario);
                }
            });

            //Total de Atendimento Concluidos no Mês (Usuário)
            var atendConcluidoUser = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetAtendimentosMesUsuario")';
            $.ajax({
                url: atendConcluidoUser,
                data: {
                    FiltrarConcluidos: true
                },
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.total_Atendimentos_Mes_Usuario) {
                    $("#iTotalAtendimentosEncUser").html(data.objeto.total_Atendimentos_Mes_Usuario);
                }
            });

            //Total Geral de Atendimento
            var totalGeralAtendimento = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetAtendimentosMesGeral")';
            $.ajax({
                url: totalGeralAtendimento,
                data: {
                },
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.total_Atendimentos_Mes_Geral) {
                    $("#iAtendimentosCriados").html(data.objeto.total_Atendimentos_Mes_Geral);
                }
            });

            //Atendimentos na Fila
            var atendimentosNaFila = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetAtendimentosMesGeral")';
            $.ajax({
                url: atendimentosNaFila,
                data: {
                    FiltrarAtendimentosFila: true
                },
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.total_Atendimentos_Mes_Geral) {
                    $("#iAtendimentosAguardandoInicio").html(data.objeto.total_Atendimentos_Mes_Geral);
                }
            });

            //Atendimentos em Andamento
            var atendimentosEmAndamento = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetAtendimentosMesGeral")';
            $.ajax({
                url: atendimentosEmAndamento,
                data: {
                    FiltrarAtendimentosEmAndamento: true
                },
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.total_Atendimentos_Mes_Geral) {
                    $("#iAtendimentosEmAndamento").html(data.objeto.total_Atendimentos_Mes_Geral);
                }
            });

            //Filtrar Atendimentos Encerrados
            var atendimentosEncerrados = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetAtendimentosMesGeral")';
            $.ajax({
                url: atendimentosEncerrados,
                data: {
                    FiltrarAtendimentosEncerrados: true
                },
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.total_Atendimentos_Mes_Geral) {
                    $("#iAtendimentosEnc").html(data.objeto.total_Atendimentos_Mes_Geral);
                }
            });


            var atendimentosEncDentroPrazo = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/ObterEncDentroSLA")';
            $.ajax({
                url: atendimentosEncDentroPrazo,
                type: "POST",
                dataType: "json"
            })
            .done(function (data) {
                if (data.objeto != null) {
                    $("#iTotalAtendEncDentroPrazoPerct").text(data.objeto.porcentagem);
                    $("#iTotalAtendEncDentroPrazo").text(data.objeto.quantidadeEnc);
                }
            });


            var atendimentosEncForaPrazo = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/ObterEncForaSLA")';
            $.ajax({
                url: atendimentosEncForaPrazo,
                type: "POST",
                dataType: "json"
            })
            .done(function (data) {
                if (data.objeto != null) {
                    $("#iTotalAtendEncForaPrazoPerct").text(data.objeto.porcentagem);
                    $("#iTotalAtendEncForaPrazo").text(data.objeto.quantidadeEnc);
                }
            });

            var atendimentosTempoMedio = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetTempoMedioAtendimento")';
            $.ajax({
                url: atendimentosTempoMedio,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.tempo_Medio_Atendimento) {
                    $("#iTempoMedioAtendimento").html(data.objeto.tempo_Medio_Atendimento);
                }
            });

            var atendimentosTempoMedioFila = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/GetTempoMedioFila")';
            $.ajax({
                url: atendimentosTempoMedioFila,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto.tempo_Medio_Atendimento) {
                    $("#iTempoMedioFila").html(data.objeto.tempo_Medio_Atendimento);
                }
            });

            var atendimentosEncIntervHum = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/ObterEncContatoHumano")';
            $.ajax({
                url: atendimentosEncIntervHum,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto != null) {
                    $("#iTotalAtendIntervHum").text(data.objeto.quantidadeEnc);
                    $("#iTotalAtendIntervHumPerct").text(data.objeto.porcentagem);
                }
            });

            var atendimentosPrimContato = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/ObterNivelSolucaoPrimContato")';
            $.ajax({
                url: atendimentosPrimContato,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto != null) {
                    $("#iTotalAtendSolucPrimCtt").text(data.objeto.quantidadeEnc);
                    $("#iTotalAtendSolucPrimCttPerct").text(data.objeto.porcentagem);
                }
            });

            var atendimentosPesquisaSatisfacao = '@String.Concat(CONSTANTES.URLPortal, "/api/Dashboard_Atendimentoapi/ObterPesquisaSatisfacao")';
            $.ajax({
                url: atendimentosPesquisaSatisfacao,
                type: "POST",
                dataType: "json"
            })
            .done(function(data){
                if (data.objeto != null) {
                    $("#iTotalAtendPesqSatisfacao").text(data.objeto.quantidadeEnc);
                    $("#iTotalAtendPesqSatisfacaoPerct").text(data.objeto.porcentagem);
                }
            });
        });



    </script>
}

