                                </div>

                                <div>
                                    <i class="fas fa-flag dash-subtitle" style="color:#000000"></i> &nbsp;<span class="dash-subtitle"> @RsCadastros.PRAZO_VENCIDO: @(String.IsNullOrEmpty(Model.Prazo_Vencido) ? Html.Raw("0") : Html.DisplayFor(m => m.Prazo_Vencido)) </span>
                                </div>

                                <div>
                                    <i class="fas fa-flag dash-subtitle" style="color:#FFA500"></i> &nbsp; <span class="dash-subtitle">@RsCadastros.VENCIMENTO_PROXIMO: @(String.IsNullOrEmpty(Model.Vencimento_Proximo) ? Html.Raw("0") : Html.DisplayFor(m => m.Vencimento_Proximo)) </span>
                                </div>

                                <div>
                                    <i class="fas fa-flag dash-subtitle" style="color:#ffd700"></i> &nbsp; <span class="dash-subtitle">@RsCadastros.ATENCAO: @(String.IsNullOrEmpty(Model.Atencao) ? Html.Raw("0") : Html.DisplayFor(m => m.Atencao)) </span>
                                </div>

                                <div>
                                    <i class="fas fa-flag dash-subtitle" style="color:#00FF00;"></i> &nbsp; <span class="dash-subtitle">@RsCadastros.DENTRO_PRAZO: @(String.IsNullOrEmpty(Model.Dentro_Prazo) ? Html.Raw("0") : Html.DisplayFor(m => m.Dentro_Prazo)) </span>
                                </div>

                            </div>
                        </div>
                        <div class="text-center">
                            <span class="dash-legend">Abrangência: Período Total - Empresa</span>
                        </div>
                    </div>
                </div>


            }
        </div>
        <div class="col mt-1">



            <div class="card-deck">
