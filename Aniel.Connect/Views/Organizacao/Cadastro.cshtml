@model Aniel.Connect.Models.OrganizacaoCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_ORGANIZACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script src="~/bin/Scripts/valida_cpf_cnpj.js"></script>

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")


<script>

        let oDatatable;
        let oDatatableContato;

        function SolicitacaoChat() {
            let timerInterval
            Swal.fire({
              title: 'Você recebeu uma solicitação de atendimento por chat!',
              html: 'Essa solicitação irá fechar em <b></b> segundos.',
              timer: 10000,
              timerProgressBar: true,
              showConfirmButton: true,
              confirmButtonText: "@RsBase.SIM",
              cancelButtonText: "@RsBase.NAO",
              showCancelButton: true,
              onBeforeOpen: () => {
                timerInterval = setInterval(() => {
                  const content = Swal.getContent()
                  if (content) {
                    const b = content.querySelector('b')
                    if (b) {
                      b.textContent = Math.round(Swal.getTimerLeft() / 1000)
                    }
                  }
                }, 100)
              },
              onClose: () => {
                clearInterval(timerInterval)
              }
            }).then((result) => {
              /* Read more about handling dismissals below */
              if (result.dismiss === Swal.DismissReason.timer) {
                console.log('I was closed by the timer')
              }
            })
        }

        async function getGoogleLatLong() {
            var link = 'https://maps.googleapis.com/maps/api/geocode/json?key=@CONSTANTES.TokenGoogleAPI&address=';

            if ($('#iLogradouro').val()) {

                link = link.concat(GetEndereco());

                try {
                    return await $.getJSON(link, async function (data) {

                        if (data.results[0]) {
                            if (!data.results[0].geometry.location.lat || !data.results[0].geometry.location.lng) {
                                Notificar("@RsBase.ATENCAO_", "@RsPontoEletronico.NAO_FOI_POSSIVEL_LOCALIZAR_LATITUDE", "warning");
                                $("#iLatitude").val(null);
                                $("#iLongitude").val(null);
                                $('#iDivGoogleEndereco').hide();
                                $('#iGoogleEndereco').text('');

                            }
                        }

                        $("#iLatitude").val(data.results[0].geometry.location.lat);
                        $("#iLongitude").val(data.results[0].geometry.location.lng);
                        $('#iDivGoogleEndereco').show();
                        $('#iGoogleEndereco').text(data.results[0].formatted_address);
                    })
                }
                catch (e) {
                    Notificar("@RsPontoEletronico.NAO_FOI_POSSIVEL_LOCALIZAR_LATITUDE", e, "warning");
                }

            }


        }

        var id_cidade_inicial = "@Model.Id_Cidade"
        var id_bairro_inicial = "@Model.Id_Bairro"
        $("#iUF").val("@Model.Uf")
        if ($("#iUF").val())
        {
            var enderecoApiCidade = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + $("#iUF option:selected").text();

            $('#iCidade').empty();
            $('#iBairro').empty();

            $.getJSON(enderecoApiCidade, function (data) {

                $('#iCidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                $.each(data, function (key, value) {

                    $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
                })

                if (id_cidade_inicial) {

                    $("#iCidade").val(id_cidade_inicial);

                    var enderecoApiBairro = "@CONSTANTES.URLPortal/api/enderecoapi/GetBairros?Id_Cidade=" + id_cidade_inicial;
                    $.getJSON(enderecoApiBairro, function (data) {

                        $('#iBairro').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
                        $.each(data, function (key, value) {
                            $('#iBairro').append($('<option></option>').attr('value', value.id).text(value.descricao));
                        })

                        $("#iBairro").val(id_bairro_inicial);
                    });
                }
            });
        }

        function GetEndereco() {

            var endereco = "";


            if ($("#iLogradouro").val()) {

                endereco += " " + $("#iLogradouro").val();
            }
            else {
                return false;
            }

            if ($("#iNumero").val())
            endereco += " " + $("#iNumero").val();
            if ($("#iBairro").val())
            endereco += " " + $("#iBairro option:selected").text();
            if ($("#iCidade").val())
            endereco += " " + $("#iCidade option:selected").text();
            if ($("#iUF").val())
                endereco += " " + $("#iUF option:selected").text();



            return endereco;
        }

        $("#iNumero").focusout(async () => await getGoogleLatLong());

        $('#iEditarDominio').click(async function () {


            if (ValidaObrigatoriosPorClasse("dominioObrigatorioEditar", false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                return false;
            }

            ShowPageLoading();

            const result = await $.ajax({
                url: '@String.Concat(CONSTANTES.URLPortal, "/api/Organizacaoapi/EditarGrid")',
                type: 'POST',
                dataType: 'json',
                data: {
                    id : $('#idDominio').val(),
                    dominio : $('#iDominioEditar').val()
                }
            })

            HidePageLoading();

            if (!result.ok) {
                Notificar("@RsBase.ATENCAO_", result.mensagem, "warning");
            }
            else {
                $('#modal-editar-dominio').modal('hide')
                let updatedData = oDatatable.rows().data().toArray()
                let atualizar = updatedData.filter(p => p.Id == $('#idDominio').val())[0]
                atualizar.Dominio = $('#iDominioEditar').val();
                $('#datatable').dataTable().fnClearTable();
                $('#datatable').dataTable().fnAddData(updatedData);
            }

        })

        $('#iEditarContato').click(async function () {


            if (ValidaObrigatoriosPorClasse("contatoObrigatorioEditar", false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                return false;
            }

            ShowPageLoading();

            const result = await $.ajax({
                url: '@String.Concat(CONSTANTES.URLPortal, "/api/Organizacaoapi/EditarGridContato")',
                type: 'POST',
                dataType: 'json',
                data: {
                    id : $('#idContato').val(),
                    contato: $('#iContatoEditar').val(),
                    informacao_Adicional: $('#iInformacaoAdicionalEditar').val(),
                    tipo_Contato : $('#iTipoContatoEditar').val(),
                }
            })

            HidePageLoading();

            if (!result.ok) {
                Notificar("@RsBase.ATENCAO_", result.mensagem, "warning");
            }
            else {
                $('#modal-editar-contato').modal('hide')
                let updatedData = oDatatableContato.rows().data().toArray()
                let atualizar = updatedData.filter(p => p.Id == $('#idContato').val())[0]
                atualizar.Contato = $('#iContatoEditar').val();
                atualizar.Informacao_Adicional = $('#iInformacaoAdicionalEditar').val();
                atualizar.Tipo_Contato = $('#iTipoContatoEditar').val();
                $('#datatableContato').dataTable().fnClearTable();
                $('#datatableContato').dataTable().fnAddData(updatedData);
            }

        })

        // Dados Gerais
        $('#iUF').change(function () {

            var estado = $(this).val();
            var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

            $('#iCidade').empty();
            $('#iBairro').empty();

            $.getJSON(enderecoApi, function (data) {

                $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
                $.each(data, function (key, value) {

                    $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
                })
            });
        });


        $('#iCidade').change(function () {

            var cidade = $('#iCidade option:selected').val();
            var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/GetBairros?Id_Cidade=" + cidade;

            $('#iDesc_Cidade').val($('#iCidade option:selected').text());
            $("#iBairro").empty();

            $.getJSON(enderecoApi, function (data) {

                $('#iBairro').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                $.each(data, function (key, value) {

                    $('#iBairro').append($('<option></option>').attr('value', value.id).text(value.descricao));
                })
            });
        });

        $('#iBairro').change(function () {

            $('#iDesc_Bairro').val($('#iBairro option:selected').text());
        });

        $("#iCEP").focus(function() {
            window["cep_on_focus_"] = cep_on_focus = $("#iCEP").val();
        });

        $("#iCEP").focusout(function () {

            if ($("#iCEP").val() != window["cep_on_focus"]) {
                $('#iUF').val("");
                $('#iCidade').val("");
                $('#iBairro').val("");
                $('#iPais').val("");
                $('#iComplemento').val("");
                $('#iLatitude').val("");
                $('#iLongitude').val("");
                $('#iNumero').val("");
                $('#iLogradouro').val("");
            }

            var cepcliente = $("#iCEP").val();

            var link = "https://viacep.com.br/ws/";
            link = link.concat(cepcliente);
            link = link.concat("/json/");

            try {
                parent.App.startPageLoading();
            }
            catch (ex) { console.log(ex); }

            $.ajax({
                url: link,
                type: 'GET',
                dataType: 'json'
            })
            .done(function (data) {

                $("#iLogradouro").val(data.logradouro);
                $("#iUF").val(data.uf);
                var cidade = data.localidade;
                var bairro = data.bairro;

                var estado = $('#iUF option:selected').text();
                var enderecoApiCidade = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

                if (!$("#iUFPrincipal option:selected").val() == "") {
                    $('#iPais').val(1);
                }

                $('#iCidade').empty();
                $('#iBairro').empty();

                if ($('#iCidade').empty()) {
                    $('iPais').empty();
                }

                $.getJSON(enderecoApiCidade, function (data) {

                    $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));

                    $.each(data, function (key, value) {
                        $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
                    })

                    if (cidade) {

                        $("#iCidade").val($('option:contains("' + cidade.toUpperCase() + '")').val());

                        var enderecoApiBairro = "@CONSTANTES.URLPortal/api/enderecoapi/GetBairros?Id_Cidade=" + $('#iCidade').val();

                        $.getJSON(enderecoApiBairro, function (data) {

                            $('#iBairro').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));

                            $.each(data, function (key, value) {
                                $('#iBairro').append($('<option></option>').attr('value', value.id).text(value.descricao));
                            });

                            $("#iBairro" + " option:contains('" + bairro.toUpperCase() + "')").attr("selected", true);

                            $('#iDesc_Bairro').val($('#iBairro' + ' option:selected').text());
                            $('#iDesc_Cidade').val($('#iCidade' + ' option:selected').text());
                            $("#iNumero").focusout();
                        });
                    }
                });



            })
            .fail(function () {
                console.log("error");
            })
            .always(function () {
                try {
                    parent.App.stopPageLoading();
                }
                catch (ex) {
                    console.log(ex);
                }
            });
        });




        function ExibeMapa(tipoEndereco) {

            if ($("#iLogradouro").val() == "" || $("#iCEP").val() == "") {

                Notificar("@RsBase.ATENCAO_", " Campos CEP e Logradouro são obrigatórios. Por Favor Preencher!", "warning");
                return false;
            }

            var endereco = GetEndereco();

            ShowDialog(true, true, 'Mapa', '@Url.Action("Endereco", "Mapa")' + '?Endereco=' + endereco, 'mapa', 800, 500, 'iframeMapa');
            return false;
        }

        var handleDataTableButtons = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Dominios));

            var nome_lista = "Dominios";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            var retorno = "";

                            retorno += '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>';
                            if(row.Id != 0)
                                retorno += '<a href="#" data-toggle="modal" data-target="#modal-editar-dominio" class="btnEditarDominio ml-2" id="btnEditarDominio_' + meta.row + '" editar=' + row.Id + '><i class="fas fa-user-edit"></i></a>';
                            retorno += ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                            return retorno;
                        }
                    },
                    {
                        data: "Dominio",
                        title: "@RsCadastros.DOMINIO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Dominio" name="' + nome_lista + '[' + meta.row + '].Dominio" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    }
                ]
            });

            $('#datatable tbody').on('click', '.btnEditarDominio', function (e) {

                var $row = $(this).closest('tr');
                const data_row = oDatatable.row($row).data();
                $('#iDominioEditar').val(data_row.Dominio);
                $('#idDominio').val(data_row.Id);

            });

            function handleExcluir() {
                $(".btnExcluir").unbind('click');
                $(".btnExcluir").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatable.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Organizacaoapi/ExcluirGrid?value=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatable.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });
            }

            handleExcluir();

            $("#btnAdicionar").unbind('click')
            $("#btnAdicionar").on('click', function () {

                var erro = false;
                const dominio = $("#iDominio").val()
                if (!dominio) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DOMINIO)", "warning");
                    erro = true;
                }
                else if (dominio.charAt(0) != '@Html.Raw("@")' || !dominio.includes('.')){
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.INVALIDO_FORMAT,RsCadastros.DOMINIO)", "warning");
                    erro = true
                }
                else if (dominio.split('.')[1].length === 0) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.INVALIDO_FORMAT,RsCadastros.DOMINIO)", "warning");
                    erro = true
                }

                for (var i = 0; i < oDatatable.rows().data().length; i++) {

                    if (oDatatable.rows().data()[i].Dominio == $("#iDominio").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.DOMINIO)", "warning");
                        erro = true;
                        i = oDatatable.rows().data().length;
                    }

                }

                if (erro) {
                    return false;
                }

                oDatatable.row.add({
                    Dominio: $("#iDominio").val(),
                    Id: 0
                }).draw(false);

                $("#iDominio").val("");

                handleExcluir();
            });


        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

        var handleDataTableButtonsContato = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Contatos));

            var nome_lista = "Contatos";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            oDatatableContato = $("#datatableContato").length && $("#datatableContato").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {

                            var retorno = "";
                            retorno += '<a href="#" class="btnExcluirContato" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>';
                            if(row.Id != 0)
                                retorno += '<a href="#" data-toggle="modal" data-target="#modal-editar-contato" class="btnEditarContato ml-2" id="btnEditarContato_' + meta.row + '" editar=' + row.Id + '><i class="fas fa-user-edit"></i></a>';

                            retorno += ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                            retorno += ' <input id="' + nome_lista + '_' + meta.row + '__Tipo_Contato" name="' + nome_lista + '[' + meta.row + '].Tipo_Contato" type="hidden" value="' + TrataNulo(data) + '">';
                            return retorno;

                        }
                    },
                    {
                        data: "Tipo_Contato_Descricao",
                        title: "@RsCadastros.TIPO_CONTATO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Tipo_Contato_Descricao" name="' + nome_lista + '[' + meta.row + '].Tipo_Contato_Descricao" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Contato",
                        title: "@RsCadastros.CONTATO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Contato" name="' + nome_lista + '[' + meta.row + '].Contato" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Informacao_Adicional",
                        title: "@RsCadastros.INFORMACAO_ADICIONAL",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Informacao_Adicional" name="' + nome_lista + '[' + meta.row + '].Informacao_Adicional" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    }
                ]
            });

            $('#datatableContato tbody').on('click', '.btnEditarContato', function (e) {

                var $row = $(this).closest('tr');
                const data_row = oDatatableContato.row($row).data();
                $('#iContatoEditar').val(data_row.Contato);
                $('#iTipoContatoEditar').val(data_row.Tipo_Contato);
                $('#iInformacaoAdicionalEditar').val(data_row.Informacao_Adicional);
                $('#idContato').val(data_row.Id);

            });

            function handleExcluirContato() {
                $(".btnExcluirContato").unbind('click');
                $(".btnExcluirContato").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatableContato.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Organizacaoapi/ExcluirContatoGrid?value=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatableContato.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });
            }

            handleExcluirContato()

            $("#btnAdicionarContato").unbind('click')
            $("#btnAdicionarContato").on('click', function () {

                let erro = false;

                if (ValidaObrigatoriosPorClasse("obrigatorioContato", false)) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                    return false;
                }

                for (var i = 0; i < oDatatableContato.rows().data().length; i++) {

                    const row_data = oDatatableContato.rows().data()[i];
                    if (row_data.Contato == $("#iContato").val() && row_data.Tipo_Contato == $('#iTipoContato').val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.DOMINIO)", "warning");
                        erro = true;
                        i = oDatatableContato.rows().data().length;
                    }

                }

                if (erro) {
                    return false;
                }

                oDatatableContato.row.add({
                    Contato: $("#iContato").val(),
                    Informacao_Adicional : $("#iInformacaoAdicional").val(),
                    Tipo_Contato: $("#iTipoContato option:selected").val(),
                    Tipo_Contato_Descricao: $("#iTipoContato option:selected").text(),
                    Id: 0
                }).draw(false);

                $("#iContato").val("");
                $("#iInformacaoAdicional").val("");
                $("#iTipoContato").val(null).trigger('change');
                handleExcluirContato();
            });


        },
            TableManageButtonsContato = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtonsContato();

                    }
                }
            }();

        TableManageButtonsContato.init();

        $(document).ready(async function () {
            @if (Model.Id != 0)
            {
                <text>$("#iNumero").val("@Model.Numero")</text>
                <text>await getGoogleLatLong(false)</text>

            }
        });


        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;

            var erro = false;

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                erro = true
                clicked = false;
                return false;
            }

            if (!valida_cnpj($('#iCNPJ').val())) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.INVALIDO_FORMAT,RsCadastros.CNPJ)", "warning");
                erro = true
            }

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();


        }



</script>
}


