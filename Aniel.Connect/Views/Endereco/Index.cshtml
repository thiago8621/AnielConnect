@using Resources
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@model Aniel.Connect.Models.Endereco_UpdateDDDModel

@{
    ViewBag.Title = RsCadastros.ENDERECO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

        $(document).ready(function () {
            AddSelect("iPais", "@CONSTANTES.URLPortal/api/PaisApi/GetComboConnect", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iEstado","@CONSTANTES.URLPortal/api/enderecoapi/GetComboUf",@CONSTANTES.PaginacaoRegistros,null,null,null,"@RsBase.SELECIONE",false);
            AddSelect("iCidadeSelect","@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades",@CONSTANTES.PaginacaoRegistros,null,null,null,"@RsBase.SELECIONE",false);
        });

        $("#iEstado").on('select2:select select2:unselecting', function (e) {
            var estado = e.params.data;
            $("#iUFText").val(estado.text);
        });
        //$("#iPais").on("select2:select select2:unselecting", function () { })
        //$("#iEstado").on("select2:select select2:unselecting", function () { })
        $("#iCidadeSelect").on('select2:select select2:unselecting', function (e) {
            var text = $("#iCidadeText").val();
            var params = e.params.data;
            if (text == "") {
                text = `${params.text}`;
            }
            else {
                text = `${text}-${params.text} `;
            }
            $("#iCidadeText").val(text);
        });


        var clicked = false;
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

    </script>

}

@using (Html.BeginForm("Receive_Update", "Endereco", FormMethod.Post, new { enctype = "multipart/form-data", @id = "form", autocomplete = "off" }))
{
    <div class="container-fluid" id="divTitle">
        <!--main-->

        <div class="row">
            <div class="col-auto mr-auto">

                <h4 class="title-page"><i class="icofont-recycle-alt"></i> @ViewBag.Title</h4>

                <nav aria-label="breadcrumb" class="mt-25">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                        </li>

                        <li class="breadcrumb-item">
                            <span>@ViewBag.Title</span>
                        </li>
                    </ol>
                </nav>

                @*<span style="font-size:11px;margin-left: 15px;" id="dtLegend"></span>*@
            </div>

            <div class="col-auto mb-3">
                <div class="row title-page">
                    <div class=" pl-4 pr-2">
                        <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.DESCRICAO" autocomplete="off">
                        <i class="la la-search la-2x" style="color: #999"></i>
                    </div>

                    <a class="btn btn-success btn-add" title="@RsBase.INCLUIR" onclick="acessoCadastro(); return true;"><i class="la la-plus" style="color: #fff"></i></a>
                    <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                    </button>

                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                        <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                        <a class="dropdown-item" href="@Url.Action("Cadastro_Intervalo","Did")">Importar por Intervalo</a>
                        <a class="dropdown-item" href="@Url.Action("Did_Planilha","Did")">Importar DID por planilha</a>
                        <a class="dropdown-item" id="btnLog" href="#">@RsBase.LOG_ALTERACOES</a>

                    </div>
                </div>
            </div>

        </div>
        <div id="accordion" class="mt-3 pl-2 pr-2">
            <div class="card div-card-accord">
                <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-2">

                                <div class="form-group">
                                    <label for="iDDD"><strong>@RsCadastros.DDD</strong></label>
                                    @Html.TextBoxFor(model => model.DDD, new { @class = "form-control", @id = "iDDD", @maxlength = "2" });
                                </div>

                            </div>
                        </div>

                        <div class="row">


                            <div class="col-sm-2">

                                <div class="form-group">
                                    <label for="iPais"><strong>@RsCadastros.PAIS</strong></label>
                                    @Html.DropDownListFor(model => model.Pais, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), @RsBase.SELECIONE, new { @class = "form-control", @id = "iPais" })
                                </div>

                            </div>

                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="iEstado"><strong>@RsCadastros.ESTADO</strong></label>
                                    @Html.DropDownListFor(model => model.Id_UF, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), @RsBase.SELECIONE, new { @class = "form-control", @id = "iEstado" })
                                </div>
                            </div>
                            @Html.HiddenFor(model => model.UF, new { @id = "iUFText" });

                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="iCidadeSelect"><strong>@RsCadastros.CIDADE</strong></label>
                                    @Html.DropDownListFor(model => model.Id_Cidade, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), @RsBase.SELECIONE, new { @class = "form-control", @id = "iCidadeSelect", @multiple = "multiple" })
                                </div>
                            </div>

                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="iCidadeSelect"><strong>@RsCadastros.CIDADE</strong></label>
                                    @Html.TextBoxFor(model => model.Cidade, new { @class = "form-control", @id = "iCidadeText", @autocomplete = "off" })

                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    @{List<String> Nacionalidade_Str = @"Afegão/Africano/Alemão/Americano/Argentino/Asiático/Australiano/Austríaco
                                                                                                 /Belga/Brasileiro/Britânico/Canadense/Chileno/Chinês/Colombiano/Coreano
                                                                                                 /Croata/Dinamarquês/Egípcio/Escocês/Eslovaco/Espanhol/Europeu/Filipino
                                                                                                 /Finlandês/Francesa/Francês/Grego/Holandês/Indiano/Inglês/Iraniano/Iraquiano
                                                                                                 /Italiano/Japonês/Mexicano/Norueguês/Paquistanês/Polonês/Português/Russo
                                                                                                 /Sueco/Sul-Africano/Sul-Coreano/Turco/Árabe/Haitiano".Trim().Split('/').ToList();

                                        List<SelectListItem> Nacionalidade = new List<SelectListItem>();
                                        Nacionalidade.Add(new SelectListItem { Value = "", Text = "SELECIONE" });
                                        foreach (var str in Nacionalidade_Str)
                                        {
                                            Nacionalidade.Add(new SelectListItem { Value = str, Text = str });
                                        }

                                    }
                                    @Html.DropDownList("iNacionalidade", (Nacionalidade), new { @name = "Nacionalidade", @class = "form-control", @id = "iNacionalidade" })

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!--./main-->
        </div>
    </div>
}

<!--Button Float-->
<a href="@Url.Action("Index", "Configuracao")" class="float-cancel" onclick="ShowPageLoading(); return true;">
    <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
        <i class="fas fa-times fa-2x"></i>
    </div>
</a>

<a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
    <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
        <i class="fas fa-save fa-2x"></i>
    </div>
</a>

