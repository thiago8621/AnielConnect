                                                    </div>
                                                </div>

                                                <div class="col-sm-1">
                                                    <label for="iMarco" style="margin-left: -15px">@RsBase.MARCO</label>
                                                    <div style="margin-left: -15px">
                                                        @Html.TextBoxFor(m => m.Marco, new { @class = "form-control", @style = "min-width: 52px;", @id = "iMarco", @autocomplete = "off" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-1">
                                                    <label for="iAbril" style="margin-left: -15px">@RsBase.ABRIL</label>
                                                    <div style="margin-left: -15px">
                                                        @Html.TextBoxFor(m => m.Abril, new { @class = "form-control", @style = "min-width: 52px;", @id = "iAbril", @autocomplete = "off" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-1">
                                                    <label for="iMaio" style="margin-left: -15px">@RsBase.MAIO</label>
                                                    <div style="margin-left: -15px">
                                                        @Html.TextBoxFor(m => m.Maio, new { @class = "form-control", @style = "min-width: 52px;", @id = "iMaio", @autocomplete = "off" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-1">
                                                    <label for="iJunho" style="margin-left: -15px">@RsBase.JUNHO</label>
                                                    <div style="margin-left: -15px">
                                                        @Html.TextBoxFor(m => m.Junho, new { @class = "form-control", @style = "min-width: 52px;", @id = "iJunho", @autocomplete = "off" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-1">
                                                    <label for="iJulho" style="margin-left: -15px">@RsBase.JULHO</label>
                                                    <div style="margin-left: -15px">
                                                        @Html.TextBoxFor(m => m.Julho, new { @class = "form-control", @style = "min-width: 52px;", @id = "iJulho", @autocomplete = "off" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-1">
                                                    <label for="iAgosto" style="margin-left: -15px">@RsBase.AGOSTO</label>
                                                    <div style="margin-left: -15px">
                                                        @Html.TextBoxFor(m => m.Agosto, new { @class = "form-control", @style = "min-width: 52px;", @id = "iAgosto", @autocomplete = "off" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-1">
