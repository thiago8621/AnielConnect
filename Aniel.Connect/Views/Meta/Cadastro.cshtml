                                                    <div style="margin-left: -15px">
                                                        @Html.TextBoxFor(m => m.Setembro, new { @class = "form-control", @style = "min-width: 52px;", @id = "iSetembro", @autocomplete = "off" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-1">
                                                    <label for="iOutubro" style="margin-left: -15px">@RsBase.OUTUBRO</label>
                                                    <div style="margin-left: -15px">
                                                        @Html.TextBoxFor(m => m.Outubro, new { @class = "form-control", @style = "min-width: 52px;", @id = "iOutubro", @autocomplete = "off" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-1">
                                                    <label for="iNovembro" style="margin-left: -15px">@RsBase.NOVEMBRO</label>
                                                    <div style="margin-left: -15px">
