@model Aniel.Connect.Models.Criterio_RoteirizacaoCadastroModel

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers


@{
    ViewBag.Title = RsCadastros.CRITERIOS_ROTEIRIZACAO;
    ViewBag.Sessao = RsCadastros.CRITERIOS_ROTEIRIZACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    
}


@section styles
{
    @Styles.Render("~/Content/cssDataTable")

}


@section  scripts
{
    @Scripts.Render("~/bundles/jsDataTable")

    <script>


        $(document).ready(function () {

            alert

            var btnArea = '@Model.Criterios.Find(p => p.Criterio_Val == 0)';
            var btnDistancia = '@Model.Criterios.Find(p => p.Criterio_Val == 1)';
            var btnHabilidades = '@Model.Criterios.Find(p => p.Criterio_Val == 2)';
            var btnSlaExecucao = '@Model.Criterios.Find(p => p.Criterio_Val == 3)';

            if (btnArea != '') {
                $('#btnArea').prop('disabled', true);
                $('#btnArea').addClass('botao-desabilitado');
            }
            if (btnDistancia != '') {
                $('#btnDistancia').prop('disabled', true);
                $('#btnDistancia').addClass('botao-desabilitado');
            }
            if (btnHabilidades != '') {
                $('#btnHabilidades').prop('disabled', true);
                $('#btnHabilidades').addClass('botao-desabilitado');
            }
            if (btnSlaExecucao != '') {
                $('#btnSlaExecucao').prop('disabled', true);
                $('#btnSlaExecucao').addClass('botao-desabilitado');
            }

        });

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;
            

            var erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            //ShowPageLoading();
            $('#form').submit();
        }


        var handleDataTableButtons = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Criterios));

            var nome_lista = "Criterios";

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                data: array,

                deferRender: true,
                scrollY: '30vh',
                scroller: {
                    loadingIndicator: true
                },
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    @*var str = "@RsCadastros.INFODATATABLE";
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);*@
                    $("#dtLegend").html('@RsCadastros.ATENCAO_AGENDAMENTO_PRIORITARIO');

                    return "";
                },
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            return '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" criterio_val= ' + row.Criterio_Val + ' excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Criterio_Val" name="' + nome_lista + '[' + meta.row + '].Criterio_Val" type="hidden" value="' + TrataNulo(row.Criterio_Val) + '">';
                        }
                    },
                    {
                        data: "Ordem", title: "@RsCadastros.ORDEM",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = (parseInt(meta.row) + 1) + 'º <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                       ' <input id="' + nome_lista + '_' + meta.row + '__Ordem" name="' + nome_lista + '[' + meta.row + '].Ordem" type="hidden" value="' + TrataNulo(meta.row) + '">';
                            }
                            return data;
                        }
                    },
                    { data: "Criterio", title: "@RsCadastros.CRITERIOS_ROTEIRIZACAO" },

                ]
            });

            function handleExcluir() {

                $(".btnExcluir").unbind('click');

                $(".btnExcluir").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    var criterio_val = $(this).attr("criterio_val");

                    if (idArquivo === "0") {

                        switch (criterio_val) {

                            case "1": {
                                $('#btnDistancia').prop('disabled', false);
                                $('#btnDistancia').removeClass('botao-desabilitado');
                                break;
                            }

                            case "2": {
                                $('#btnHabilidades').prop('disabled', false);
                                $('#btnHabilidades').removeClass('botao-desabilitado');
                                break;
                            }

                            case "0": {
                                $('#btnArea').prop('disabled', false);
                                $('#btnArea').removeClass('botao-desabilitado');
                                break;
                            }

                            case "3": {
                                $('#btnSlaExecucao').prop('disabled', false);
                                $('#btnSlaExecucao').removeClass('botao-desabilitado');
                                break;
                            }

                        }

                        oDatatable.row(trLinkButton).remove().draw(true);

                        Notificar("@Resources.OPERACAOBEMSUCEDIDA", "@Resources.REGISTROREMOVIDO", "info");

                        $.each($('#datatable tr td:nth-child(2)'), function (index, val) {
                            $(this).html(index + 1 + "º");
                        });

                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Criterio_Roteirizacaoapi/ExcluirGrid?value=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {

                                    switch (criterio_val) {

                                        case "1": {
                                            $('#btnDistancia').prop('disabled', false);
                                            $('#btnDistancia').removeClass('botao-desabilitado');
                                            break;
                                        }

                                        case "2": {
                                            $('#btnHabilidades').prop('disabled', false);
                                            $('#btnHabilidades').removeClass('botao-desabilitado');
                                            break;
                                        }

                                        case "0": {
                                            $('#btnArea').prop('disabled', false);
                                            $('#btnArea').removeClass('botao-desabilitado');
                                            break;
                                        }

                                        case "3": {
                                            $('#btnSlaExecucao').prop('disabled', false);
                                            $('#btnSlaExecucao').removeClass('botao-desabilitado');
                                            break;
                                        }

                                    }

                                    oDatatable.row(trLinkButton).remove().draw(false);
                                    Notificar("@Resources.OPERACAOBEMSUCEDIDA", "@Resources.REGISTROREMOVIDO", "info");

                                    $.each($('#datatable tr td:nth-child(2)'), function (index, val) {
                                        $(this).html(index + 1 + "º");
                                    });
                                }
                                else {
                                    Notificar("@Resources.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });
            }




            handleExcluir();

            $(".btn-criterio").on('click', function () {

                var erro = false;

                @*if (!$("#iIdEquipe").val() || $("#iIdEquipe").val() == 0) {
                    Notificar("@Resources.ATENCAO_", "@String.Format(Resources.REQUIRED, RsCadastros.EQUIPE)", "warning");
                    erro = true;
                }

                for (var i = 0; i < oDatatable.rows().data().length; i++) {

                    if (oDatatable.rows().data()[i].Id_Equipe == $("#Id_Equipe").val()) {
                        Notificar("@Resources.ATENCAO_", "@String.Format(Resources.JA_EXISTE, RsCadastros.EQUIPE)", "warning");
                        erro = true;
                        i = oDatatable.rows().data().length;
                    }

                }*@

                if (erro) {
                    return false;
                }

                oDatatable.row.add({
                    Criterio: $(this).val(),
                    Criterio_Val: $(this).attr("criterio"),
                    Ordem: 0,
                    Id : 0
                }).draw(false);

                $(this).prop('disabled', true);
                $(this).addClass('botao-desabilitado');

                handleExcluir();
            });


        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();


    </script>
}

@using (Html.BeginForm("Index", "Criterio_Roteirizacao", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    <div style="padding:10px">
        <div class="card" style="border:none;">


            <h4 class="title-page"><i class="icofont-prescription"></i> @ViewBag.Title</h4>
            <nav aria-label="breadcrumb" style="font-size:12px">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item" style="margin-left:22px;"><a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Desconto")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELDESCONTO</a></li>
                    <li class="breadcrumb-item"><span>@ViewBag.Title</span></li>
                </ol>
            </nav>
            <br />


            <div class="row">
                <div id="accordion" class="col-sm-4">
                    <div class="card div-card-accord">

                        <div class="card-header title-card" id="heading-1">
                            <h5 class="mb-0">
                                <span class="text-bold-card">Tipos de @ViewBag.Title</span>

                            </h5>
                            <a style="font-size: 12px !important;margin:-20px !important;padding:0 !important">@RsCadastros.INFORME_ORDEM_PRIORIZACAO</a>

                        </div>



                        <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">


                            <div class="card-body">
                                <div class="text-center">
                                    <div>
                                        <div class="input-group">
                                            <input type="button" id="btnDistancia" criterio="1" value="@RsCadastros.DISTANCIA" class="btn btn-success btn-block btn-criterio" />
                                            <input type="button" id="btnHabilidades" criterio="2" value="@RsCadastros.HABILIDADES" class="btn btn-success btn-block btn-criterio" />
                                            <input type="button" id="btnArea" criterio="0" value="@RsCadastros.AREA" class="btn btn-success btn-block btn-criterio" />
                                            <input type="button" id="btnSlaExecucao" criterio="3" value="@RsCadastros.SLA_EXECUCAO" class="btn btn-success btn-block btn-criterio" />
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                <div id="accordion" class="col-sm-8">
                    <div class="card div-card-accord">
                        <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                            <div class="card-body">

                                <table class="table table-hover" id="datatable"></table>

                                <span style="font-size:11px" id="dtLegend"></span>

                            </div>

                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Desconto")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>

    </div>
}