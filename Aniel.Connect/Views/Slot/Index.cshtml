@model Aniel.Connect.Models.SlotListaModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers

@{
    ViewBag.Title = RsCadastros.PAINEL_SLOT;
    ViewBag.Sessao = RsCadastros.SLOT;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}

@section scripts
{

    @*@Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")*@
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")

    <script>

    var rows_selected = [];
    var oDatatable

        var HandleOLTFiltro = function () {
            $('#iOlt').on('select2:select select2:unselecting', function (e) {
                OltSelecionada = e.params.data;
                
                if ($('#iSlot').val()) {
                        AddSelect("iSlot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, OltSelecionada.id, $("#iSlot").val(), "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iSlot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, OltSelecionada.id, null, "@RsBase.SELECIONE", false);
                }                
                return true;
            });
        };

        $(document).ready(function () {
            AddSelect("iOlt", "@CONSTANTES.URLPortal/api/OLTapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleOLTFiltro);
            AddSelect("iSlot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);            
        });

    function ExibirModalCadastro(id) {
        var url = ''

        if (id != null) {
            url = '@Url.Action("Cadastro", "Slot", new { id = "__id__" })'
            url = url.replace('__id__', id)
        }
        else {
            url = '@Url.Action("Cadastro", "Slot")'
        }

        ShowDialog(true, true, "Cadastro", url, "divCadastro", 900, 600)

        $("#divCadastro").on("dialogclose", function (event, ui) {
            setTimeout(function () {
                oDatatable.draw();
            }, 500);
        })

        ShowPageLoading();
    }

    var handleDataTableButtons = function () {
        "use strict";

        function AlterarStatusObj(Status) {
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Slotapi/alterarstatus")';

            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    ids: rows_selected,
                    status: Status
                }
            })
            .done(function (data) {

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    rows_selected = [];
                    oDatatable.draw();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });
        }

        //"Blfrtip"

        oDatatable = new DataTable("#datatable",{
            dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti" ,
            columnDefs: [
                {
                    targets: 0,
                    searchable: false,
                    orderable: false,
                    width: '1%',
                    className: 'dt-body-center',
                    render: function (data, type, full, meta) {
                        return "<input type='checkbox'></input>";
                    }
                }
            ],
            select: {
                style: 'multi'
            },
            order: [[1, 'asc']],
            serverSide: true,
            searching: true,
            ordering: true,
            paging: true,
            deferRender: true,
            scrollResize: true,
            scrollY: '79vh',           
            stateSave: true,
            scrollX: true,
            fixedHeader: true,
            initComplete: dataTableInitComplete,
            lengthMenu: [[10, 25, 50, 100, 250, 750, 1000], [10, 25, 50, 100, 250, 750, 1000]],
            ajax: {
                url: baseUrl + '/api/SlotApi/GetAll',
                type: 'POST',
                data: function (data) {

                    var id_olt = $("#iOlt").val();
                    var id_slot = $("#iSlot").val();
                    var status = $("#iStatus").val();

                    if ($("#iOlt option:selected").val() == "Selecione")
                        id_olt = null;
                    if ($("#iSlot option:selected").val() == "Selecione")
                        id_slot = null;
                    if ($("#iStatus option:selected").val() == "Selecione")
                        status = null;

                    data.Id_Slot = id_slot;

                    data.Id_Olt = id_olt;
                    data.Status = status;
                    data.search.option = $("#optionSearch").val();
                },
                error: function (e) {
                    console.log(e);
                },
                dataSrc: function (d) {
                    return d.data;
                }
            },
            rowCallback: function(row, data, dataIndex){
                 // Get row ID
                 var rowId = data.id;

                 // If row ID is in the list of selected row IDs
                 if($.inArray(rowId, rows_selected) !== -1){
                    $(row).find('input[type="checkbox"]').prop('checked', true);
                    $(row).addClass('selected');
                 }
            },
            pageLength: 10,
            language: traducaoDataTable,
            buttons: buttonsDataTable,
            columns: [
                { title: "<input name='select_all' value='1' type='checkbox'>" },
                { data: "id", title: "@RsCadastros.ID", sortable: "false" },
                { data: "numSlot", title: "@RsCadastros.NUM_SLOT", sortable: "false" },
                { data: "descricao", title: "@RsCadastros.NOME", sortable: "false" },
                { data: "olt", title: "@RsCadastros.OLT", sortable: "false" },
                { data: "status", title: "@RsCadastros.SITUACAO", sortable: "false" },
                { data: "datahoracriacao", title: "@RsCadastros.DATAHORA_CRIACAO", sortable: "false" }
            ]
        });

        //#region Eventos Datatable

        $('#txtSearch').val(oDatatable.search());
        $('#txtSearch').keyup(function () {
            rows_selected = [];
            oDatatable.search($(this).val()).draw();
        });

        $("#iPesquisar").on("click", function () {
            $("#modal-filter").modal('hide');
            rows_selected = [];
            oDatatable.search($('#txtSearch').val()).draw();

            return true;
        });

        $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {

            $("#iSlot").val("");
            $("#iOlt").val("");
            $("#iStatus").val("");


            $('#txtSearch').val("");
            rows_selected = [];
            oDatatable.search($('#txtSearch').val()).draw();
        });

        $("#btnInativar").on("click", function () {

            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            //Alterando para Inativo
            AlterarStatusObj(0);

        });

       $("#btnAtivar").on("click", function () {

            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            //Alterando para Inativo
            AlterarStatusObj(1);
        });


       $("#btnExcluir").on("click", function () {

            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Slotapi/excluirlista")';

            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    ids: rows_selected
                }
            })
                .done(function (data) {

                    if (data.ok) {
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                        rows_selected = [];
                        oDatatable.draw();
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
            });
        });

         // Handle click on checkbox
        $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

        // Handle click on "Select all" control
        $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

        $('#datatable tbody').on('click', 'tr', function () {
            if (oDatatable.row(this).data() != null) {
                var _id = oDatatable.row(this).data().id

                ExibirModalCadastro(_id)
            }
        });

        // Handle table draw event
        oDatatable.on('draw', function () {
            // Update state of "Select all" control
            updateDataTableSelectAllCtrl(oDatatable);
        });

        //#endregion
    },
    TableManageButtons = function () {
        "use strict";
        return {
            init: function () {
                handleDataTableButtons();
            }
        }
    }();

    TableManageButtons.init();

    $("#iAdicionar").on("click", function () {
        ExibirModalCadastro()
    })

    var HandleOLT = function () {
            $('#iOLTCadastroPon').on('select2:select select2:unselecting', function (e) {
                OltSelecionada = e.params.data;
                $('#iSlotCadastroPon').val(null).trigger('change');
                AddSelect("iSlotCadastroPon", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, OltSelecionada.id, null, "@RsBase.SELECIONE", false);
                return true;
            });
        };

    function showModalCadastroSlotPon() {
        $("#modal-cadastrar-pon").modal('show');

        AddSelect("iOLTCadastroPon", "@CONSTANTES.URLPortal/api/OLTapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleOLT);
        AddSelect("iSlotCadastroPon", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        $("#iCancelarPon").on('click', function (e) {
            $("#modal-cadastrar-pon").modal('hide');
            $("#iOLTCadastroPon").val("");
            $("#iSlotCadastroPon").val("");
            $("#iPonInicial").val("");
            $("#iPonFinal").val("");
            $("#iVlanPon").val("");
        });

        return true;
        }

        $("#iCadastrarPon").on('click', function (e) {
            let erro = false

                if (ValidaCamposObrigatorios(erro)) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                    erro = true;
                    return;
                }
            
            ShowPageLoading($("#modal-cadastrar-pon"));

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/PONapi/CriarPONsEmMassa")';

            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    id_OLT: $("#iOLTCadastroPon option:selected").val(),
                    id_Slot: $("#iSlotCadastroPon option:selected").val(),
                    num_PON_Inicial: $("#iPonInicial").val(),
                    num_PON_Fim: $("#iPonFinal").val(),
                    vlan_PON: $("#iVlanPon").val(),
                }
            })
            .done(function (data) {

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    $("#iCancelarPon").click();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
                HidePageLoading();
            })
        });
    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page">
                <i class="fas fa-server"></i> @ViewBag.Title
            </h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GERENCIAMENTO_REDE</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>
        </div>

        <div class="col-auto mb-3">
            <div class="row title-page">                
                <div class="form-inline pl-4 pr-2">
                    <select class="form-control" id="optionSearch">
                        <option value="slot">@RsCadastros.SLOT</option>
                        <option value="olt">@RsCadastros.OLT</option>
                    </select>
                    <input type="text" class="input-search" id="txtSearch" placeholder="Digite aqui para busca rápida" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>

                <a class="btn btn-success btn-add" id="iAdicionar" title="@RsBase.INCLUIR"><i class="la la-plus" style="color: #fff"></i></a>

                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltro" onclick="$('#txtSearch').val('');oDatatable.search('').draw();" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="showModalCadastroSlotPon(); return true">Cadastrar PONs em Massa</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" id="btnInativar" href="#" onclick="return false;">@RsBase.INATIVAR</a>
                    <a class="dropdown-item" id="btnAtivar" href="#" onclick="return false;">@RsBase.ATIVAR</a>
                </div>
            </div>
        </div>
    </div>

    <!--./main-->
</div>

<div id="divCadastro"></div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>


<div class="modal" id="modal-filter">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title text-muted">Filtros Slot</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">

                    <div class="col-sm-12">

                        <div class="row">

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="iOlt">@RsCadastros.OLT</label>
                                    <select class="form-control" id="iOlt">
                                        <option>@RsBase.SELECIONE</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="iSlot">@RsCadastros.SLOT</label>
                                    <select class="form-control" id="iSlot">
                                        <option>@RsBase.SELECIONE</option>
                                    </select>
                                </div>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>Situação:</label>
                                    @Html.EnumDropDownListFor(m => m.Status_Filtro, RsBase.SELECIONE, new { @class = "form-control", @id = "iStatus", @autocomplete = "off" })
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>

<!--Modal Cadastrar PONs em massa-->
<div class="modal" id="modal-cadastrar-pon">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted"> Cadastrar PONs em Massa </h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>@RsCadastros.OLT:</label>
                                    <select class="form-control obrigatorio" id="iOLTCadastroPon">
                                        <option value="" selected>@RsBase.SELECIONE</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>@RsCadastros.SLOT:</label>
                                    <select class="form-control obrigatorio" id="iSlotCadastroPon">
                                        <option value="" selected>@RsBase.SELECIONE</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>@RsCadastros.NUM_PON_INICIAL:</label>
                                    @Html.TextBox("iPonInicial", String.Empty, null, new { @class = "form-control obrigatorio", @id = "iPonInicial", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>@RsCadastros.NUM_PON_FINAL:</label>
                                    @Html.TextBox("iPonFinal", String.Empty, null, new { @class = "form-control", @id = "iPonFinal", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iVlanPon">@RsCadastros.VLAN_UPLINK:</label>
                                    @Html.TextBox("iVlanPon", null, null, new { @class = "form-control", @type = "number", @id = "iVlanPon", @autocomplete = "off" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iCancelarPon">@RsBase.CANCELAR</button>
                        <button type="button" class="btn btn-success" id="iCadastrarPon">@RsBase.CADASTRAR</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /.modal-->