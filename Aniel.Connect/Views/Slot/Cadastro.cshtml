@model Aniel.Connect.Models.SlotCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_SLOT;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

    <script>
        AddSelect("iOLT", "@CONSTANTES.URLPortal/api/OLTapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_OLT", "@RsBase.SELECIONE", false);

        var clicked = false;
        function validaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;

            let erro = false

            if (ValidaCamposObrigatorios(erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();

              parent.dial.dialog('close');

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });
        }
    </script>
}

@using (Html.BeginForm("Cadastro", "Slot", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-sm-2">
            <div class="form-group">
                <label for="iId">@RsCadastros.ID:</label>
                @Html.TextBoxFor(p => p.Id, new { @class = "form-control", id = "iId", disabled = "disabled" })
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <label for="iNumSlot" class="mr-3">@RsCadastros.NUM_SLOT:</label><br />
                @Html.TextBoxFor(p => p.NumSlot, new { @class = "form-control obrigatorio", @id = "iNumSlot", @autocomplete = "off" })
            </div>
        </div>

        <div class="col-sm-4">
            <div class="form-group">
                <label for="iSlot">@RsCadastros.OLT:</label>
                @Html.DropDownListFor(p => p.Id_OLT, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iOLT", @autocomplete = "off" })
            </div>
        </div>

        <div class="col-sm-4">
            <div class="form-group">
                <label for="iDescricao">@RsCadastros.NOME:</label>
                @Html.TextBoxFor(p => p.Descricao, new { @class = "form-control obrigatorio", @id = "iDescricao", @autocomplete = "off" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-2">
            <div class="form-group">
                <label for="iLineProfile">@RsCadastros.LINEPROFILE:</label>
                @Html.TextBoxFor(p => p.LineProfile, new { @class = "form-control", @id = "iLineProfile", @autocomplete = "off" })
            </div>
        </div>
        <div class="col-auto">
            @if (Model.Id != 0)
            {
                <div class="form-group">
                    <label for="iStatus" class="mr-3">@RsCadastros.STATUS:</label><br />
                    @Html.CheckBoxFor(p => p.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                </div>
            }
        </div>
    </div>

    <!--Button Float-->
    <a href="#" class="float-cancel" onclick="parent.dial.dialog('close');">
        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
            <i class="fas fa-times fa-2x"></i>
        </div>
    </a>

    <a href="#" class="float-save" onclick="return validaSubmit();" name="gravar">
        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
            <i class="fas fa-save fa-2x"></i>
        </div>
    </a>
}