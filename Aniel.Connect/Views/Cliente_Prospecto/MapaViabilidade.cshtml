<!--Mapa-->
<div id="map"></div>

@section Scripts{

    <!-- Async script executes immediately and must be after any DOM elements used in callback. -->
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyACnVjpiRnap58taXa7eEQJIVmD8TkoL2g"></script>

    <!--map-font-icons-->
    <script src="~/Scripts/map-font-icons.js"></script>


    <script>
        $.ajax({
            type: "GET",
            url: '@String.Concat(CONSTANTES.URLPortal, "/api/Cliente_ProspectoApi/MapaViabilidade")',
            dataType: "json"
        }).done(function (data) {
            console.log(data);

        });
        async function PesquisaMapa() {
            let pesquisa = $("#iPesquisaMap").val();
            try {
                var url = `https://maps.googleapis.com/maps/api/place/findplacefromtext/json?input=${pesquisa}&inputtype=textquery&fields=geometry&key=AIzaSyACnVjpiRnap58taXa7eEQJIVmD8TkoL2g`;
                return await $.getJSON(url, async function (data) {
                    var latlng = {
                        lat: data.candidates[0].geometry.location.lat,
                        lng: data.candidates[0].geometry.location.lng
                    }
                    console.log(data.candidates[0].geometry.location.lat);
                    console.log(data.candidates[0].geometry.location.lng);

                    map.setCenter(latlng);
                    new google.maps.Marker({
                        position: latlng,
                        map: map,
                    });

                });
            }
            catch (e) { console.log(e) }
        }
        @*const cor = "@Html.Raw(Model.Latitude)";
        alert(cor);*@
        //GoogleMaps Config
        initMap();
        function initMap() {

            /*Hide transit and poi*/
            var myStyles = [
                {
                    featureType: "poi",
                    elementType: "labels",
                    stylers: [
                        { visibility: "off" }
                    ]
                },
                {
                    featureType: "transit",
                    elementType: "labels",
                    stylers: [
                        { visibility: "off" }
                    ]
                }
            ];

            var map = new google.maps.Map(document.getElementById('map'), {
                zoom: 15,
                center: { lat: 40.38016400, lng: 49.85092900 },
                //mapTypeId: 'satellite',
                styles: myStyles
            });

           
        }


      
    </script>

}
