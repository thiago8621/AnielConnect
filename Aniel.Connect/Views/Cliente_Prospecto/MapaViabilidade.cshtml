@section styles{



    <style>
        /*Map*/
        .map-icon-label i {
            font-size: 24px;
            color: #e81017; /*color icon*/
            line-height: 55px;
            text-align: center;
            white-space: nowrap;
        }

        #map {
            height: 100%;
        }

        /* Optional: Makes the sample page fill the window. */
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
        }
        /*Collapse*/
        .collapse {
            visibility: hidden;
        }

            .collapse.show {
                visibility: visible;
                display: block;
            }

        .collapsing {
            position: relative;
            height: 0;
            overflow: hidden;
            -webkit-transition-property: height, visibility;
            transition-property: height, visibility;
            -webkit-transition-duration: 0.35s;
            transition-duration: 0.35s;
            -webkit-transition-timing-function: ease;
            transition-timing-function: ease;
        }

            .collapsing.width {
                -webkit-transition-property: width, visibility;
                transition-property: width, visibility;
                width: 0;
                height: auto;
            }

        .iLimparFiltro {
        }

        .icons-bar {
            color: #999;
            font-size: 1.3rem;
        }

        .popover-header {
            color: #357ca5;
            background-color: transparent;
            border: none;
        }
    </style>
}


