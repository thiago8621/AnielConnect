@model IEnumerable<Aniel.Connect.Models.Cliente_ProspectoListViewModel>

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Microsoft.AspNet.Identity;

@{
    ViewBag.Title = RsCadastros.PAINEL_LEAD;
    ViewBag.Sessao = RsCadastros.CLIENTE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
    
    }


@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }

        .swal-wide {
            width: 450px !important;
        }

        .dataTables_scrollHeadInner {
            width: 100% !important;
        }

            .dataTables_scrollHeadInner table {
                width: 100% !important;
            }

        .table {
            table-layout: fixed;
        }

            .table > td {
                overflow-wrap: break-word;
            }

        .rem17 {
            width: 17rem !important;
        }
    </style>

}


@section  scripts
{

    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>


    <script>


        if ($('input[name="iStatusEtapa"]:checked').val() == null)
        {
            $('#restricaoSection').hide()
        }
        else
        {
            $('#restricaoSection').show()
        }
       
        $("input[name='iStatusEtapa']:radio").click(function () {
            if ($('input[name="iStatusEtapa"]:checked').val() == null || $('input[name="iStatusEtapa"]:checked').val() == "5") {
                $('#restricaoSection').hide()
            }
            else {
                $('#restricaoSection').show()
            }
        });

        var oDatatable = null;
        var rows_selected = [];

        function ExibirLogin(idCliente) {
            ShowDialog(true, true, 'Login Radius', '@Url.Action("ListaLoginRadius", "Cliente")' + '?Id_Cliente=' + idCliente, 'divLogin',450, 450, 'iframeLoginRadius');
        }

        AddSelect("iPais", "@CONSTANTES.URLPortal/api/PaisApi/GetComboConnect", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iSetorDepartamento", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect('iMeioCaptcao', "@CONSTANTES.URLPortal/api/Meio_Captacaoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect('iQuemIndicou', "@CONSTANTES.URLPortal/api/clienteapi/GetComboIdentificacao", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect('iCampanha', "@CONSTANTES.URLPortal/api/campanhaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect('iUsuarioCriacao', "@CONSTANTES.URLPortal/api/Identity_UserApi/GetComboUserId", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false,null,null,null,null,false);

        $('#iMeioCaptcao').on('change', function () {
            let valorSelected = $('#iMeioCaptcao :selected').val();
       
            if (valorSelected == '4')
                $('#divQuemIndicou').show();
            else {
                $('#divQuemIndicou').val() == null;
                $('#divQuemIndicou').hide();
            }

        });

        if ($('#iMeioCaptcao :selected').val() != '4') {
            $('#divQuemIndicou').hide();
        }

        var handleDataTableButtons = function () {

            "use strict";

            function AlterarStatusObj(Status) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Cliente_ProspectoApi/alterarstatus")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected,
                        status: Status
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {


                            if (data.mensagens.length > 0) {
                                for (var i = 0; i < data.mensagens.length; i++) {
                                    Notificar("@RsBase.ATENCAO_", data.mensagens[i].mensagem, "warning");
                                }
                            }

                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    });

                rows_selected = [];

            }

            //"Blfrtip"

            oDatatable = new DataTable("#datatable", {
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>"+"Bfrti",
                columnDefs: [{
                    targets: 0,
                    searchable: false,
                    orderable: false,
                    width: '1%',
                    className: 'dt-body-center',
                    render: function (data, type, full, meta) {
                        return "<input type='checkbox'></input>";
                    }
                },
                {
                    targets: 1,
                    searchable: false,
                    orderable: false,
                    width: '1%',
                    className: 'dt-body-center'
                }],
                select: 'multi',
                order: [[4, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '79vh',
                scrollX: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, 250, 750, 1000], [10, 25, 50, 100, 250, 750, 1000]],
                ajax: {
                    url: baseUrl + '/api/Cliente_ProspectoApi/GetAll',
                    type: 'POST',
                    data: function (data) {
                        // Read values
                        let busca_Leads = !!Number(param_url(window.location.href.toString(), "Somente_Leads")),

                            tipo_pessoa = $("#iTipoPessoa option:selected").val(),
                            status = $("#iStatus option:selected").val(),
                            estado = $("#iEstadosBrasil option:selected").val(),
                            cidade = $("#iCidade option:selected").val(),

                            bairro = $("#iBairro option:selected").val(),
                            login_radius = $("#iLoginRadius").val(),
                            status_prospecto = $("#iStatusProspecto").val(),
                            categoria_cliente = $("#iCategoriaCliente option:selected").val(),

                            sexo = $("#iSexo option:selected").val(),
                            estado_Civil = $("#iEstado_Civil option:selected").val(),
                            grau_Instrucao = $("#iGrau_Instrucao option:selected").val(),
                            pais = $('#iPais').val(),
                            data_inicial = $("#iDataInicial").val(),
                            data_final = $("#iDataFinal").val(),
                            idMeioCaptacao = $('#iMeioCaptcao option:selected').val(),
                            idQuemIndicou = $('#iQuemIndicou option:selected').val(),
                            idCampanha = $('#iCampanha option:selected').val(),

                            statusEtapa = $('input[name = "iStatusEtapa"]:checked').val();

                        let filtroEndereco = $('input[name="exibir"]:checked').val();
                        let consultasRestricao = $("input[name='ConsultaRestricao']:checked").toArray().map(p => p.value);

                        if ($("#iCidade option:selected").val() == "Selecione")
                            cidade = null;
                        if ($("#iBairro option:selected").val() == "Selecione")
                            bairro = null;

                      

                        @if (@AcessoHelper.TemAcesso(_areas, "205")) {
                         <text>

                            var usuario_acesso = "@User.Identity.GetUserId()";
                        var prospect_acesso = 1;

                            data.AcessoUsuario = usuario_acesso;
                            data.AcessoProspect = prospect_acesso;

                         </text>
                        }


                        // Append to data
                        data.Somente_Leads = busca_Leads;
                        data.Pais = pais;
                        data.status_Prospecto = status_prospecto;
                        data.Tipo_Pessoa = tipo_pessoa;

                        data.Status = status;
                        data.Estado = estado;
                        data.Cidade = cidade;
                        data.Bairro = bairro;

                        data.Login_Radius = login_radius;
                        data.Categoria_Cliente = categoria_cliente;
                        data.Sexo = sexo;
                        data.Estado_Civil = estado_Civil;

                        data.Grau_Instrucao = grau_Instrucao;
                        data.StatusEtapa = statusEtapa;
                        data.consultasRestricao = consultasRestricao;
                        data.Data_Inicial = data_inicial;
                        data.Data_Final = data_final;
                        data.IdMeioCaptcao = idMeioCaptacao;
                        data.Id_QuemIndicou = idQuemIndicou;
                        data.IdCampanha = idCampanha;
                        data.filtroEndereco = filtroEndereco;
                        data.UsuarioCriacao = $("#iUsuarioCriacao").val();
                        data.Departamento = $("#iSetorDepartamento").val();
                    },
                    error: function (e) {
                        var errorMessage = "Ocorreu um erro.";
                        try {
                            var response = JSON.parse(e.responseText);
                            if (response && response.exceptionMessage) {
                                errorMessage = response.exceptionMessage;
                            }
                        } catch (ex) {
                            console.error("Erro: ", ex);
                        }
                        Notificar("@RsBase.ATENCAO_", errorMessage, "warning");
                        HidePageLoading();
                    },
                    dataSrc: function (d) {
                        //Mostrar o Total de Ordens de Serviços encontradas
                        if ($('#Count_listing').length === 0)
                            $('.dataTables_length').append($('<label id="Count_listing"></label>'));

                        $("#Count_listing").html(`<div class="form-group col-sm-push-1 ml-2 mt-1">
                                                     Total de Registros encontrados: <span style="font-weight:bold; margin-right:0px;" id="Total_OS">  &nbsp; `+ d.recordsFiltered + ` </span>
                                                  </div> `);

                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                preDrawCallback: function () {
                    ShowPageLoading();
                },
                drawCallback: function () {

                    if (oDatatable)
                        oDatatable.columns.adjust();

                    HidePageLoading();
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTable,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    {
                        data: "pendencia", render: function (data) {
                            if (data) return '<i class="fas fa-circle text-danger"></i>';
                            else return '';
                        }
                    },
                    { data: "numero_Contrato", title: "@RsCadastros.IDENTIFICACAO_LEAD"},
                    { data: "status", title: "@RsCadastros.STATUS" },
                    { data: "tipoPessoa", title: "@RsCadastros.TIPOPESSOA" },
                    { data: "nomeFantasia", title: "@RsCadastros.NOMEFANTASIA" },
                    { data: "cpfCnpj", title: "@RsCadastros.CPFCNPJ" },
                    { data: "categoria", title: "@RsCadastros.CATEGORIA" },
                    { data: "status_Prospecto", title: "@RsCadastros.STATUS_LEAD" },
                    { data: "bairro", title: "@RsCadastros.BAIRRO" },
                    { data: "cidade", title: "@RsCadastros.CIDADE" },
                    { data: "estado", title: "@RsCadastros.ESTADO" },
                    { data: "pais", title: "@RsCadastros.PAIS" },
                    { data: "sexo", title: "@RsCadastros.SEXO"},
                    { data: "estado_Civil", title: "@RsCadastros.ESTADO_CIVIL" },
                    { data: "telefonePrincipal", title: "@RsCadastros.TELEFONEPRINCIPAL" },
                    { data: "telefoneCelular", title: "@RsCadastros.TELEFONECELULAR" },
                    { data: "departamento", title: "@RsCadastros.DEPARTAMENTO"},
                    { data: "data", title: "@RsCadastros.DATA_CRIACAO" },
                    { data: "usuarioCriacao", title: "@RsBase.USUARIO_CRIACAO" },
                    {
                        data: "meioCaptcao", title: "@RsCadastros.MEIO_CAPTACAO", defaultContent: "-", render: function (dat) {
                            if (dat == "" || dat == null || dat == "-")
                                return "-"
                            else
                                return dat
                        }
                    },
                    {
                        data: "outroMeio", title: "@RsCadastros.QUAL_MEIO", defaultContent: "-", render: function (dat) {
                            if (dat == "" || dat == null || dat == "-")
                                return "-"
                            else
                                return dat
                        }
                    },
                    {
                        data: "nomeIndicacao", title: "@RsCadastros.QUEMINDICOU", defaultContent: "-", render: function (dat) {
                            if (dat == "" || dat == null || dat == "-")
                                return "-"
                            else
                                return dat
                        }
                    },
                    { data: "nomeCampanha", title: "@RsCadastros.CAMPANHA", defaultContent: "-" }
                ]
            });

            function AtualizarPesquisa() {
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
            }

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                AtualizarPesquisa();
            });
            $('#txtSearch').change(function () {
                AtualizarPesquisa();
            });
            $('#txtSearch').on('input', function () {
                AtualizarPesquisa();
            });

            $("#btnDesativarProspectoSel").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);

            });

            $("#btnAtivarProspectoSel").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Ativo
                AlterarStatusObj(1);
            });

            $("#iPesquisar").on("click", function () {
                $("#modal-filter").modal('hide');
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();

                return true;
            });

            $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {

                $("#iStatusProspecto").val("");
                $("#iCampanha").val(null).trigger('change');
                $("#iMeioCaptcao").val(null).trigger('change');
                $("#iSetorDepartamento").val(null).trigger('change');
                $("#iSexo").val("");
                $("#iEstado_Civil").val("");
                $("#iGrau_Instrucao").val("");
                $("#iPais").val(null).trigger('change');


                $("#iStatus").prop("selectedIndex", 0);
                $("#iTipoPessoa").val("");
                $("#iEstadosBrasil").prop("selectedIndex", 0);
                $("#iCidade").val("");
                $("#iBairro").val("");

                $("#iLoginRadius").val("");
                $("#iCategoriaCliente").prop("selectedIndex", 0);
                $('input[name="ConsultaRestricao"]').prop('checked', false);
                $('input[name="iStatusEtapa"]').prop('checked', false);

                $("#iDataInicial").val(null).trigger('change');
                $("#iDataFinal").val(null).trigger('change');
                $('#iUsuarioCriacao').val(null).trigger('change');

                $('#txtSearch').val("");
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
            });

            // Popular lista de cidades

            $('#iEstadosBrasil').change(function () {

                var estado = $('#iEstadosBrasil option:selected').val();
                var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

                $("#iCidade").empty();
                $("#iBairro").empty();

                $.getJSON(enderecoApi, function (data) {

                    $('#iCidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                    $.each(data, function (key, value) {
                        $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
                    });
                });
            });

            $('#iCidade').change(function () {

                var cidade = $('#iCidade option:selected').val();
                var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getbairros?Id_Cidade=" + cidade;

                $("#iBairro").empty();

                $.getJSON(enderecoApi, function (data) {
                    $('#iBairro').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                    $.each(data, function (key, value) {
                        $('#iBairro').append($('<option></option>').attr('value', value.descricao).text(value.descricao));
                        console.log(value)
                });
            });
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function () {

                @if (AcessoHelper.TemAcesso(_areas, "23"))
                {
                <text>
                if (oDatatable.row(this).data() != null) {
                    @*var tipos = @(Html.EnumToString<Tipo_Pessoa>());*@

                    var _id = oDatatable.row(this).data().id;

                    //var _tipo_pessoa = tipos[oDatatable.row(this).data().tipoPessoa];

                    var url = '@Url.Action("ClienteDadosGerais", "Cliente_Prospecto", new { id = "__id__" })'; //, tipo_pessoa = "__tipo_pessoa__"
                    window.location.href = url.replace('__id__', _id);
                    //.replace('__tipo_pessoa__', _tipo_pessoa);
                    ShowPageLoading();
                }
                </text>
                }
            });

            // Handle btn login event
            $('#datatable tbody').on('click', '.btnLogin', function (e) {

                var id = $(this).attr("id_cliente");
                ExibirLogin(id);

                e.stopPropagation();
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

        if ($('input[name="iStatusEtapa"]:checked').val() == null) {
            $('#restricaoSection').hide()
        }
        else {
            $('#restricaoSection').show()
        }

        $("input[name='iStatusEtapa']:radio").click(function () {
            if ($('input[name="iStatusEtapa"]:checked').val() == null || $('input[name="iStatusEtapa"]:checked').val() == "5") {
                $('#restricaoSection').hide()
            }
            else {
                $('#restricaoSection').show()
            }
        });

    </script>
}



<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-users"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Comercial")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.COMERCIAL</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

            @*<span style="font-size:11px" id="dtLegend"></span>*@
        </div>

        <div class="col-auto">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.NOMEOUDOCUMENTO" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
                @if (AcessoHelper.TemAcesso(_areas, "23"))
                {
                    <a class="btn btn-success btn-add" href="@Url.Action("ClienteDadosGerais", "Cliente_Prospecto")" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>
                }
                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    @*<a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>*@
                    @*<a class="dropdown-item" id="btnInativar" href="#" onclick="return false;">@RsBase.INATIVAR</a>
                        <a class="dropdown-item" id="btnAtivar" href="#" onclick="return false;">@RsBase.ATIVAR</a>*@

                    <a class="dropdown-item" id="btnImportarProspecto" onclick="AddAba('@Url.Action("Importacao", "Cliente_Prospecto")');">@RsCadastros.IMPORTAR_LEAD</a>
                    <a class="dropdown-item" id="btnExportarListagem" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAR_LISTAGEM</a>
                    @if (AcessoHelper.TemAcesso(_areas, "21"))
                    {
                        <a class="dropdown-item" id="btnAtivarProspectoSel" href="#" onclick="return false;">@RsCadastros.ATIVAR_LEADS_SELECIONADOS</a>
                        <a class="dropdown-item" id="btnDesativarProspectoSel" href="#" onclick="return false;">@RsCadastros.DESATIVAR_LEADS_SELECIONADOS</a>
                    }
                </div>
            </div>
        </div>

    </div>

    <!--./main-->
</div>
<div id="divTable" style="width: 97.5vw; margin: auto">
    <table class="table table-hover nowrap display trocaAba" id="datatable" style="width:100%">
    </table>
</div>

<div id="divLogin"></div>

<!--Modal Filters-->
<div class="modal" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">

                    <div class="col-sm-10 container" style="align-content:center;">

                        <div class="row">


                            <div class="col-sm-6">

                                <div class="form-group">
                                    <label>Status:</label>
                                    <select class="form-control" id="iStatus">
                                        <option selected value="">@RsBase.TODOS</option>
                                        <option value="0">Inativo</option>
                                        <option value="1">Ativo</option>
                                    </select>
                                </div>

                            </div>

                            <div class="col-sm-6">

                                <div class="form-group">
                                    <label>Tipo de Pessoa:</label>
                                    <select class="form-control" id="iTipoPessoa">
                                        <option selected value="">@RsBase.TODOS</option>
                                        <option value="0">@RsCadastros.FISICA</option>
                                        <option value="1">@RsCadastros.JURIDICA</option>
                                    </select>
                                </div>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="iPais" class="mr-3">@RsCadastros.PAIS:</label>
                                    @Html.DropDownList("select2Pais", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iPais", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-6">

                                <div class="form-group">
                                    <label>UF:</label>
                                    <select class="form-control" id="iEstadosBrasil">
                                        <option value="" selected>@RsBase.TODOS</option>
                                        <option value="AC">AC</option>
                                        <option value="AL">AL</option>
                                        <option value="AP">AP</option>
                                        <option value="AM">AM</option>
                                        <option value="BA">BA</option>
                                        <option value="CE">CE</option>
                                        <option value="DF">DF</option>
                                        <option value="ES">ES</option>
                                        <option value="GO">GO</option>
                                        <option value="MA">MA</option>
                                        <option value="MT">MT</option>
                                        <option value="MS">MS</option>
                                        <option value="MG">MG</option>
                                        <option value="PA">PA</option>
                                        <option value="PB">PB</option>
                                        <option value="PR">PR</option>
                                        <option value="PE">PE</option>
                                        <option value="PI">PI</option>
                                        <option value="RJ">RJ</option>
                                        <option value="RN">RN</option>
                                        <option value="RS">RS</option>
                                        <option value="RO">RO</option>
                                        <option value="RR">RR</option>
                                        <option value="SC">SC</option>
                                        <option value="SP">SP</option>
                                        <option value="SE">SE</option>
                                        <option value="TO">TO</option>
                                    </select>
                                </div>

                            </div>



                        </div>

                        <div class="row">

                            <div class="col-sm-6">

                                <div class="form-group">
                                    <label>Cidade:</label>
                                    <select class="form-control" id="iCidade"></select>
                                </div>

                            </div>

                            <div class="col-sm-6">

                                <div class="form-group">
                                    <label>Bairro:</label>
                                    <select class="form-control" id="iBairro"></select>
                                </div>

                            </div>


                        </div>

                        <div class="row">

                            <div class="col-sm-6">

                                <div class="form-group">
                                    <label for="iStatusProspecto">@RsCadastros.STATUS_LEAD:</label>
                                    <select class="form-control" id="iStatusProspecto">
                                        <option selected value="">@RsBase.SELECIONE</option>
                                        <option value="0">@RsCadastros.LEAD_NAO_QUALIFICADO</option>
                                        <option value="1">@RsCadastros.LEAD_QUALIFICADO</option>
                                        <option value="2">@RsCadastros.RESTRICAO_COMERCIAL</option>
                                        <option value="3">@RsCadastros.INVIABILIDADE_TECNICA</option>
                                        <option value="4">@RsCadastros.EFETIVADO</option>
                                        <option value="5">@RsCadastros.INATIVO</option>
                                        <option value="6">@RsCadastros.LEAD_COM_RESTRICAO</option>
                                    </select>
                                </div>

                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>Categoria do Cliente</label>
                                    <select class="form-control" id="iCategoriaCliente">
                                        <option selected value="">@RsBase.SELECIONE</option>
                                        <option value="0">Pequeno</option>
                                        <option value="1">Médio</option>
                                        <option value="2">Grande</option>
                                    </select>
                                </div>
                            </div>


                        </div>

                        <div class="row">


                            <div class="col-sm-6">

                                <div class="form-group">
                                    <label>Grau de Instrução</label>
                                    <select class="form-control" id="iGrau_Instrucao">
                                        <option selected value="">@RsBase.SELECIONE</option>
                                        <option value="0">@RsBase.ANALFABETO</option>
                                        <option value="1">@RsBase.ENSINO_FUNDAMENTAL</option>
                                        <option value="2">@RsBase.ENSINO_MEDIO</option>
                                        <option value="3">@RsBase.ENSINO_SUPERIOR</option>
                                        <option value="4">@RsBase.MESTRADO</option>
                                        <option value="5">@RsBase.DOUTORADO</option>
                                    </select>
                                </div>

                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>Sexo</label>
                                    <select class="form-control" id="iSexo">
                                        <option selected value="">@RsBase.SELECIONE</option>
                                        <option value="0">Masculino</option>
                                        <option value="1">Feminino</option>
                                    </select>
                                </div>
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>Estado Civil</label>
                                    <select class="form-control" id="iEstado_Civil">
                                        <option selected value="">@RsBase.SELECIONE</option>
                                        <option value="0">SOLTEIRO</option>
                                        <option value="1">CASADO</option>
                                        <option value="2">VIUVO</option>
                                        <option value="3">DIVORCIADO</option>
                                        <option value="4">UNIAOESTAVEL</option>

                                    </select>
                                </div>

                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>@RsCadastros.MEIO_CAPTACAO:</label>
                                    <select class="form-control" id="iMeioCaptcao"></select>
                        </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6" id="divQuemIndicou">
                                <div class="form-group">
                                    <label>@RsCadastros.QUEMINDICOU?</label>
                                    <select class="form-control" id="iQuemIndicou"></select>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>@RsCadastros.CAMPANHA:</label>
                                    <select class="form-control" id="iCampanha"></select>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="iUsuarioCriacao"> @RsBase.USUARIO_CRIACAO</label>
                                    @Html.DropDownList("usuarioCriacao", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<string>>(), "Id", "Text"), RsBase.SELECIONE, new { @id = "iUsuarioCriacao", @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="iSetorDepartamento">@RsCadastros.DEPARTAMENTO:</label>
                                    @Html.DropDownList("SetorDepartamento", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iSetorDepartamento", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">

                                    <label>Exibir:</label>
                                    <div style="border: 1px solid #d9d9d9; border-radius: 4px; padding: 8px 12px; display: inline-block; ">
                                        <div class="radio">
                                            <label>
                                                <input type="radio" name="exibir" checked />
                                                Todos os Leads
                                            </label>
                                        </div>
                                        <div class="radio">
                                            <label>
                                                <input type="radio" name="exibir" value="sem_endereco" />
                                                Leads sem endereço
                                            </label>
                                        </div>
                                        <div class="radio">
                                            <label>
                                                <input type="radio" name="exibir" value="com_endereco" />
                                                Leads com endereço
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <label style="font-size: 12px">Status da Etapa:</label>
                        <br />
                        <div class="col-sm-12 pl-3 border_radius">
                            <div class="form-group">
                                <div class="form-check  mt-2">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            @Html.RadioButton("iStatusEtapa", "2", new { @class = "form-check-input", @id = "IReprovado", @autocomplete = "off", @value = "2" })
                                            <label for="IReprovado">@RsCadastros.REPROVADO</label>
                                        </div>

                                        <div class="col-sm-4">
                                            @Html.RadioButton("iStatusEtapa", "3", new { @class = "form-check-input", @id = "iAguardandoGestor", @autocomplete = "off", @value = "1" })
                                            <label for="iAguardandoGestor">@RsCadastros.AGUARDANDO_APROVACAO_VENDA</label>
                                        </div>

                                        <div class="col-sm-4">
                                            @Html.RadioButton("iStatusEtapa", "5", new { @class = "form-check-input", @id = "iTodas", @autocomplete = "off", @value = "0" })
                                            <label for="iTodas">@RsBase.TODOS</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="restricaoSection">
                            <label style="font-size: 12px">@RsCadastros.RESTRICAO:</label><br />
                            <div class="col-sm-12 pl-3 border_radius">
                                <div class="form-group">
                                    <div class="form-check  mt-2">
                                        <div class="row">
                                            <div class="col-sm-6">
                                                @Html.CheckBox("ConsultaRestricao", false, new { @class = "form-check-input", @id = "iConsultaViabilidade", @autocomplete = "off", @value = "1" })
                                                <label for="iConsultaViabilidade">@RsCadastros.CONSULTA_VIABILIDADE</label>
                                            </div>

                                            <div class="col-sm-6">
                                                @Html.CheckBox("ConsultaRestricao", false, new { @class = "form-check-input", @id = "iConsultaPendenciaFinanceira", @autocomplete = "off", @value = "2" })
                                                <label for="iConsultaPendenciaFinanceira">@RsCadastros.CONSULTA_PENDENCIA_FINANCEIRA</label>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                @Html.CheckBox("ConsultaRestricao", false, new { @class = "form-check-input", @id = "iConsultaPendenciaEndereco", @autocomplete = "off", @value = "3" })
                                                <label for="iConsultaPendenciaEndereco">@RsCadastros.CONSULTA_PENDENCIA_ENDERECO</label>
                                            </div>
                                            <div class="col-sm-6">
                                                @Html.CheckBox("ConsultaRestricao", false, new { @class = "form-check-input", @id = "iConsultaCredito", @autocomplete = "off", @value = "4" })
                                                <label for="iConsultaCredito">@RsCadastros.CONSULTA_CREDITO</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group form-inline" style="height:100%; vertical-align:middle;">

                                    <label for="iDataInicial">@RsCadastros.PERIODOABERTURA:</label>
                                    <input type="text" class="form-control datepicker" autocomplete="off" placeholder="00/00/0000" id="iDataInicial" />

                                    <span>@RsBase.A</span>

                                    <input type="text" class="form-control datepicker" autocomplete="off" placeholder="00/00/0000" id="iDataFinal" />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
