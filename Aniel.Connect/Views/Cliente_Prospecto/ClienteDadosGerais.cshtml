        async function ExecutarConsultaViabilidade(
            latitude,
            longitude,
            logradouro = null,
            numero = null,
            logradouroStr = "",
            cidade = null,
            condominio,
            bloco,
            apto_numero
        ) {

            const requestConsultaViabilidade = {
                Latitude: latitude,
                Longitude: longitude
            };

            if (logradouro) {
                requestConsultaViabilidade.IdEnderecoLogradouro = logradouro
            }

            if (numero) {
                requestConsultaViabilidade.Numero = numero;
            }

            if (logradouroStr) {
                requestConsultaViabilidade.Logradouro = logradouroStr;
            }

            if (cidade) {
                requestConsultaViabilidade.IdCidade = cidade;
            }

            if (condominio) {
                requestConsultaViabilidade.IdCondominio = condominio;
            }

            if (bloco) {
                requestConsultaViabilidade.IdBloco = bloco;
            }

            if (apto_numero) {
                requestConsultaViabilidade.IdApto_Numero = apto_numero;
            }

            return await $.ajax({
                    type: "POST",
                    url: "@CONSTANTES.URLPortal/api/Consulta_ViabilidadeApi/ExecutarConsultaViabilidade",
                    dataType: "json",
                    data: requestConsultaViabilidade
                });
        }

