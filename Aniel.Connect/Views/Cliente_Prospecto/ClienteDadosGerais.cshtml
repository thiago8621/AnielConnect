        $("#btnConcretizarVenda").on("click", async function () {

            ShowPageLoading();
            try {
                let response = await $.ajax({
                    url: baseUrl + '/api/Cliente_ProspectoApi/ConsultaRestricaoQualificativa',
                    type: "POST",
                    data: {
                        id_Cliente: @Model.Id,
                    }
                });

                if (!response.result) {
                    Notificar("@RsBase.ATENCAO_", response.message, "warning");
                    return;
                }

                var acesso = false;
                if ("@AcessoHelper.TemAcesso(_areas, "348")" == "True") {
                    acesso = true;
                }

                let cpfCnpj = $('#iCPF').val() ? $('#iCPF').val() : $('#iCNPJ').val()


                if (cpfCnpj) {
                    var link = `@String.Concat(CONSTANTES.URLPortal, "/api/VendaApi/verificaVendaDuplicadaCpfCnpj")?cpfCnpj=${cpfCnpj}`;
                    const responseVendaDuplicada = await $.ajax({
                        url: link,
                        type: 'POST',
                        dataType: 'json'
                    });

                    if (responseVendaDuplicada.ok == false) {
                        await Swal.fire({
                            title: "Pendência encontrada!",
                            type: "warning",
                            text: response.mensagem,
                            confirmButtonText: 'OK'
                        });
                        return false;
                    }
                    else if (responseVendaDuplicada.ok && acesso && responseVendaDuplicada.idObjeto > 0) {

                        let criarVendaDuplicada = false;
                        await Swal.fire({
                            type: 'error',
                            title: responseVendaDuplicada.mensagem,
                            text: "Deseja criar uma nova venda para o cliente selecionado?",
                            type: 'question',
                            showCancelButton: true,
                            confirmButtonColor: '#3085d6',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'Sim',
                            cancelButtonText: 'Não'
                        }).then(async (result) => {
                            if (result.value) {
                                criarVendaDuplicada = true
                            }
                        });

                        if (!criarVendaDuplicada) {
                            return false;
                        }
                    }
                    else if (responseVendaDuplicada.idObjeto > 0 && !acesso) {
                        await Swal.fire({
                            title: "Venda duplicada!",
                            type: "warning",
                            text: responseVendaDuplicada.mensagem,
                            confirmButtonText: 'OK'
                        });
                        return false;

                    }
                }
            }
            catch (error) {
                console.error(error);
            } finally {
                HidePageLoading();
            }

            window.location.href = "@Url.Action("ClienteDadosGerais", "Venda")?Id_Cliente=@Model.Id"
        });

        async function AvisoSemSalvar(link) {

            if (ModalPergunta) {
                let result = await Swal.fire({
                    title: 'Tem Certeza que deseja sair sem salvar?',
                    text: "Os dados ainda não foram salvos. Ao sair as informações serão perdidas. Deseja sair sem antes gravar?",
                    showCancelButton: true,
                    cancelButtonText: 'Não',
                    confirmButtonText: 'Sim',
                    type: 'question',
                    allowOutsideClick: () => !Swal.isLoading(),
                });

                if (!result.value)
                  return true;

            };

            parent.document.getElementsByClassName('menu_tab active')[0].children[1].setAttribute("onclick", "closeTab(this);");
            window.location = link;
            ShowPageLoading();
            return true;

        };
