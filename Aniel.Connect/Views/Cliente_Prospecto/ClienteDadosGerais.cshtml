        async function ConsultarCpf(cpfCnpj) {
            await $.ajax({
                url: "@String.Concat(CONSTANTES.URLPortal, "/api/Vendaapi/GetConsultaCpf")",
                type: 'POST',
                dataType: 'json',
                data: {
                    cpf: cpfCnpj
                }
            });
        }

        async function Restricao(cpfCnpj) {
            const data =
                await $.ajax({
                    url: "@String.Concat(CONSTANTES.URLPortal, "/api/Vendaapi/ResultParametrosRestricaoCredito")",
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        cpf: cpfCnpj
                    }
                });

            if (data != null && data.ok) {
                $("#iStatusConsultaCredito").html(data.objeto);
            }
            else if (data.mensagem)
            {
                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
            }


            return data;
        }

        async function TotalPontosRestricaoCredito(cpfCnpj){
            const data =
                await $.ajax({
                    url: "@String.Concat(CONSTANTES.URLPortal, "/api/Vendaapi/TotalSomaPontosRestricaoCredito")",
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        cpf: cpfCnpj
                    }
                });

            if (data != null && data.ok) {
                $("#iTotalPontos").html(data.objeto);
            }
        };

        async function DadosConsultadosSerasa(cpfCnpj) {
            const data =
                await $.ajax({
                    url: "@String.Concat(CONSTANTES.URLPortal, "/api/Vendaapi/RetornoRestricaoCredito")",
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        cpf: cpfCnpj
                    }
                });

            if (data != null && data.ok) {
                retorno = data.objeto;
                $("#iConsulta").html(retorno);
            }
        }

        function RenderResultadosConsultaCredito(cpfCnpj, buttonExists) {
            if (!buttonExists) {
                $("#rowConsultaCredito").append(
                    `<div class="col-3 d-flex">
                        <a href="javascript:void(0)"
                           id="btnResultadoConsultaCredito"
                           class="btn btn-success">Resultado</a>
                    </div>`
                );
            }
            else {
                @*
                    Caso o botão de exibir resultados já exista é necessário fazer o unbind do evento do click
                    para que os resultados exibam os resultados da consulta do CPF/CNPJ que está preenchido durante
                    a última execução da consulta de crédito
                *@
                $("#btnResultadoConsultaCredito").unbind("click");
            }

            $("#btnResultadoConsultaCredito").on("click", async function () {
                @*
                    Executando todos os métodos assíncronos que pegam os dados da consulta de crédito
                    simulataneamente e aguardando a conclusão de todos eles antes de exibir a modal com os detalhes
                *@
                await Promise.all([
                    Restricao(cpfCnpj),
                    TotalPontosRestricaoCredito(cpfCnpj),
                    DadosConsultadosSerasa(cpfCnpj)
                ]);

                $("#iModalConsultaCredito").modal("show");
            });
        }

        $("#btnConsultaCredito").on("click", async function () {
            if (!$("#iCPF").val() && !$("#iCNPJ").val()) {
                Notificar("@RsBase.ATENCAO_", "Preencha o CPF ou CNPJ antes de fazer a consulta", "warning");
                return;
            }

            let mensagemErro;

            try {
                @* Caso o CPF não esteja preenchido, a variável recebe o CNPJ *@
                let cpfCnpj = $("#iCPF").val() || $("#iCNPJ").val();
                cpfCnpj = cpfCnpj.match(/\d/g).join("");

                $("#divProgress").show();

                await ConsultarCpf(cpfCnpj);

                let result = await Restricao(cpfCnpj);
                if (result.ok === false) {
                    mensagemErro = retorno.mensagem;
                    throw new Error(mensagemErro);
                }

                $("#divProgress").hide();

                if (result != null) {
                    if (result.objeto == "@Html.Raw(HtmlEnumExtensions.GetEnumDescription(AprovacaoCriterioParametroCredito.REPROVADO))") {
                        AtualizarIndicadorStatusConsulta(CONSULTA_CREDITO, STATUS_CONSULTA_REPROVADA);
                    }
                    else if (result.objeto == "@Html.Raw(HtmlEnumExtensions.GetEnumDescription(AprovacaoCriterioParametroCredito.APROVACAO_COM_INSTALACAO))" ||
                        result.objeto == "@Html.Raw(HtmlEnumExtensions.GetEnumDescription(AprovacaoCriterioParametroCredito.APROVACAO_SEM_INSTALACAO))") {

                        AtualizarIndicadorStatusConsulta(CONSULTA_CREDITO, STATUS_CONSULTA_APROVADA);
                    }
                    else if (result.objeto == "@Html.Raw(HtmlEnumExtensions.GetEnumDescription(AprovacaoCriterioParametroCredito.AGUARDA_AVALIACAO_GESTOR))") {
                        AtualizarIndicadorStatusConsulta(CONSULTA_CREDITO, STATUS_CONSULTA_AGUARDANDO_AVALIACAO_GESTOR);
                    }
                    else if (result.objeto == null) {
                        AtualizarIndicadorStatusConsulta(CONSULTA_CREDITO, STATUS_CONSULTA_REPROVADA);
                    }
                }

                @if (AcessoHelper.TemAcesso(_areas, "322"))
                {
                    <text>
                    @*
                        Mesmo se o botão de resultados já estiver renderizado ainda é necessário executar
                        a rotina para que o CPF/CNPJ da exibição dos resultados da consulta seja atualizado
                        caso o usuário altere o CPF/CNPJ no cadastro e realize uma nova consulta de crédito
                    *@
                    const buttonResultadosExists = $("#btnResultadoConsultaCredito").length > 0;
                    RenderResultadosConsultaCredito(cpfCnpj, buttonResultadosExists);
                </text>
                }

                Notificar("@RsBase.INFORMACAO", "Consulta de crédito concluída", "info");
            }
            catch {
                $("#divProgress").hide();
                Notificar("@RsBase.ATENCAO_", "<span style='font-weight:bold; font-size:1.3rem;'>Atenção! Integração não configurada ou dados incorretos.</span><br />Não conseguimos processar a consulta de crédito. Por favor verifique se está configurada a integração ou se os dados como usuário, token e etc estão corretos.", "warning");
            }
        });

        async function validacaoTelefone(lead, numero) {
            let ok = false;
            @*Validação de número de telefone*@
            try {
                if (!lead) {
                    throw "Lead não gravado no sistema para realizar a validação de telefone.";
                }
                if (!numero) {
                    throw "Número de Telefone ausente.";
                }

                const urlconfig = "@CONSTANTES.URLPortal/api/Configuracoes_Geraisapi/FindById?Id=1";
                const url = "@CONSTANTES.URLPortal/api/IntegracaoSMSApiController/EnviarSMS";
                let numerovalidado = "@Model.NumeroValidado";

                let config = await $.ajax({
                    url: urlconfig,
                    dataType: "json",
                    type: "GET"
                });

                const urlmodeloMensagem = `@CONSTANTES.URLPortal/api/Configuracao_Envio_MensagensApi/FindById?Id=${config.objeto.idModeloMensagemSMS}`;
                let modelo = await $.ajax({
                    url: urlconfig,
                    dataType: "json",
                    type: "GET"
                });

                await $.ajax({
                    data: {
                        Salvar_Em_Banco: true,
                        Mensagem: modelo.objeto.mensagem_SMS,
                        Num_Celular: numero,
                        isReenvio: numerovalidado ? true : false,
                        Id_Integracao: null,
                        Tipo_Integracao: config.objeto.tipo_Integracao_SMS,
                    },
                    url: url,
                    dataType: "json",
                    type: "POST"
                }).done(function (data) {
                    if (data.ok) {
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", `Mensagem enviada ao número correspondente: ${numero}`, "success");
                    }
                });
            }
            catch (exception) {
                Notificar("@RsBase.ATENCAO_", exception, "warning");
            }
            return ok;
        }

        function notificacaoViabilidade(request = null) {
            let mensagemRetorno = "";
            let mensagens = [];
            let motivos = [];

                //Sem Viabilidade
                for (var passo of request.objeto.passos) {
                    mensagemRetorno = mensagemRetorno.concat(` <br> <span> ${passo} </span> `);
                }
                if ((request.objeto.possuiDisponibilidade == VIABILIDADE_REPROVADA)) {

                    request.objeto.motivos.forEach(obj => motivos.push(obj.motivo));


                    mensagemRetorno = mensagemRetorno.concat(` <br> <span> Resultado da consulta de viabilidade: ${motivos.join(" - ")} </span> `);

                    @*Criação do div de alerta*@
                }
                else if (request.objeto.caixas.length > 0) {
                    //Com Viabilidade
                    mensagens.push(`Caixa reservada: ${request.objeto.caixas[0].descricao}`);
                    mensagens.push(`Porta reservada: ${request.objeto.caixas[0].portasDisponiveis[0]}`);
                }


            $("#spanMotivoAprovManualViabiliadade").text("");

            if (request?.objeto?.motivoAprovacaoManual) {
                $("#divMotivoAprovManualViabilidade").show();
                $("#spanMotivoAprovManualViabiliadade").text(request?.objeto?.motivoAprovacaoManual);
            }

            let div = $("#iResultadoViabilidade");
            let alerta = $("#iAlertaViabilidade");

            $("#iResultadoViabilidade").empty();
            $("#iAlertaViabilidade").empty();

            for (let mensagem of mensagens) {
                if (!mensagemRetorno) {
                    mensagemRetorno = mensagem;
                }
                else {
                    mensagemRetorno = `${mensagemRetorno} <br> ${mensagem}`;
                }
            }
            div.append($.parseHTML(mensagemRetorno));
            alerta.append($.parseHTML(mensagemRetorno));

            alerta.removeClass("d-none");
            alerta.parent().removeClass("d-none");
            $("#iVerificarMapa").attr("hidden", false);
        }

    </script>

