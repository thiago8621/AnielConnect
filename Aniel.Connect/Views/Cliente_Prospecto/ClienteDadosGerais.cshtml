        const CONSULTA_VIABILIDADE = 0;
        const CONSULTA_PENDENCIA_FINANCEIRA = 1;
        const CONSULTA_PENDENCIA_ENDERECO = 2;
        const CONSULTA_CREDITO = 3;

        const STATUS_CONSULTA_PENDENTE = 0;
        const STATUS_CONSULTA_APROVADA = 1;
        const STATUS_CONSULTA_REPROVADA = 2;
        const STATUS_CONSULTA_AGUARDANDO_AVALIACAO_GESTOR = 3;

        function AtualizarIndicadorStatusConsulta(consulta, status) {
            let statusClass = null;
            switch (status) {
                case STATUS_CONSULTA_PENDENTE:
                    statusClass = "circle-consulta-pendente";
                    break;
                case STATUS_CONSULTA_APROVADA:
                    statusClass = "circle-consulta-aprovada";
                    break;
                case STATUS_CONSULTA_REPROVADA:
                case STATUS_CONSULTA_AGUARDANDO_AVALIACAO_GESTOR:
                    statusClass = "circle-consulta-reprovada";
                    break;
            }

            if (statusClass != null) {
                let statusElemSelector = null;

                switch (consulta) {
                    case CONSULTA_VIABILIDADE:
                        statusElemSelector = "#statusConsultaViabilidade";
                        AtualizaStatusConsulta(statusElemSelector, vendedorVisualiza.CONSULTA_VIABILIDADE, statusClass);

                        statusConsultaViabilidade = status;
                        $("#iStatusConsultaViabilidade").val(status);
                        break;
                    case CONSULTA_PENDENCIA_FINANCEIRA:
                        statusElemSelector = "#statusConsultaPendenciaFinanceira";
                        AtualizaStatusConsulta(statusElemSelector, vendedorVisualiza.CONSULTA_PENDENCIA_FINANCEIRA, statusClass);

                        $("#iStatusConsultaPendenciaFinanceira").val(status);
                        break;
                    case CONSULTA_PENDENCIA_ENDERECO:
                        statusElemSelector = "#statusConsultaPendenciaEndereco";
                        AtualizaStatusConsulta(statusElemSelector, vendedorVisualiza.CONSULTA_PENDENCIA_ENDERECO, statusClass);

                        $("#iStatusConsultaPendenciaEndereco").val(status);
                        break;
                    case CONSULTA_CREDITO:
                        statusElemSelector = "#statusConsultaCredito";
                        AtualizaStatusConsulta(statusElemSelector, vendedorVisualiza.CONSULTA_CREDITO, statusClass);

                        $("#iStatusConsultaCredito").val(status);
                        break;
                }
            }
        }

        function AtualizaStatusConsulta(element, visualiza, classe) {
            $(element).removeClass("circle-consulta-pendente");
            $(element).removeClass("circle-consulta-aprovada");
            $(element).removeClass("circle-consulta-reprovada");

            if (@Html.Raw(Json.Encode(AcessoHelper.TemAcesso(_areas, "322")))) {
                $(element).addClass(classe);
            }
            else if (visualiza) {
                $(element).addClass(classe);
            }
            else {
                $(element).addClass("circle-consulta-pendente");
            }
        }

