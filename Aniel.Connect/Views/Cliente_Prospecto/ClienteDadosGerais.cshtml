        // Cálculo da validade da consulta de viabilade de endereço
        function calculaValidadeEndereco() {
            var validadeDaConsultaPendenciaEndereco;
            @if (ViewBag.consultaPendenciaEnderecoValidade != 0)
            {
                <text>
                    validadeDaConsultaPendenciaEndereco = "@ViewBag.consultaPendenciaEnderecoValidade";
                </text>
            }
            else if (Model.ConsultaPendenciaEnderecoValidade != 0)
            {
                <text>
                    validadeDaConsultaPendenciaEndereco = "@Model.ConsultaPendenciaEnderecoValidade";
                </text>
            }
            else
            {
                <text>
                validadeDaConsultaPendenciaEndereco = Infinity;
                </text>
            }

            // Formatando a data da última consulta para o formato MM/dd/yyyy
            var getDataHoraCriacaoConsultaEndereco = "@Model.DataHoraCriacaoConsultaEndereco" != null ? "@Model.DataHoraCriacaoConsultaEndereco" : new Date();
            var dataHoraCriacaoConsultaEndereco = getDataHoraCriacaoConsultaEndereco.split(' ');
            var dataPartes = dataHoraCriacaoConsultaEndereco[0].split('/');
            var dataFormatada = dataPartes[1] + '/' + dataPartes[0] + '/' + dataPartes[2];

            // Realizando o cálculo
            var dataDaUltimaConsultaEndereco = new Date(dataFormatada);
            var dataDeHoje = new Date()
            var diferencaEmTempo = dataDeHoje.getTime() - dataDaUltimaConsultaEndereco.getTime();
            var diferencaEmDias = Math.floor(diferencaEmTempo / (1000 * 3600 * 24));

            return diferencaEmDias <= validadeDaConsultaPendenciaEndereco;
        }

