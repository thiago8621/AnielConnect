            </li>*@
        @*<li class="nav-item">
                <a class="nav-link " id="arquivo-tab" data-toggle="tab" href="#iTabArquivo" role="tab" aria-controls="foto" aria-selected="false"><i class="fas fa-file-alt"></i> @RsCadastros.FOTOS_ARQUIVOS </a>
            </li>*@
