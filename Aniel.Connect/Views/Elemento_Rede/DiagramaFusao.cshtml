@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/visjsPackage")
    <script src="~/Scripts/vis-network.js"></script>
    <script>
        const container = $('#visNetwork')[0];

        @*/////////////////////////////////
            Registros presentes na model
          //////////////////////////////// *@
        const listagemCaixas = @(Html.Raw(Json.Encode(Model.listagem_Caixas))),
              @*listagemLoose = @(Html.Raw(Json.Encode(Model.listagem_Tubo_Loose))),*@
            listagemPortas = @(Html.Raw(Json.Encode(Model.listagem_Portas))),
            listagemOlts = @(Html.Raw(Json.Encode(Model.listagem_Olts))),
            listagePON = @(Html.Raw(Json.Encode(Model.listagem_PON))),
            listagemConexoes =@(Html.Raw(Json.Encode(Model.listagem_Conexoes))),
            listagemCabos = @(Html.Raw(Json.Encode(Model.listagem_Cabos)));
        
        let Ids = 0,
            network = null;


        // Called when the Visualization API is loaded.
        function draw() {
            @* Create a data table with nodes.*@
            let nodes = [],
                @*Create a data table with links.*@
                edges = [],
                @*get Nodes Ids*@
                looses = [];

            let CountItens = [];

            try {

                listagemCabos.forEach((objeto,index) => {

                    CountItens.push(index);                    
                    objeto.listagem_Tubo_Loose.forEach(loose => {

                        let urlLoose = useTemplate(loose.Cor, `Loose ${loose.Id}`),
                            exampleValue = CountItens.length == 1 ? 0 : CountItens[CountItens.length-1];
                        nodes.push({

                            id: ++Ids,
                            label: `Loose ${loose.Id}`,
                            image: urlLoose,
                            group: "",
                            shape: 'image',
                            level: exampleValue,/*x: exampleValue, y: exampleValue * ++index*/

                        });
                        looses.push(Ids);

                        loose.Fibras.forEach(fibra => {

                            let reference_Id = looses.findLast(p => { return p; }),
                                urlFibra = useTemplate(fibra.Cor, `Fibra ${fibra.NumeroFibra}`);

                            nodes.push({

                                id: ++Ids,
                                label: `Fibra ${fibra.NumeroFibra}`,
                                image: urlFibra, group: reference_Id,
                                shape: 'image',
                                level: exampleValue + 1

                            });

                            edges.push({

                                from: Ids,
                                to: reference_Id,
                                length: 300

                            });

                        })
                    })
                });

                listagemCaixas.forEach(caixa => {
                    let urlCaixa = useTemplate("blue", `Caixa${caixa.Id}`);
                    CountItens.push((CountItens[CountItens.length - 1] + 2));

                    nodes.push({

                        id: ++Ids,
                        label: `${caixa.Descricao}`,
                        image: urlCaixa,
                        group: "reference_Id",
                        level: CountItens[CountItens.length - 1],
                        x: 0, y: 300,
                        shape: 'image'

                    });
                });

            }
            catch (Exception) {
                console.log(`Erro ao renderizar: ${Exception}`);
            }
            //Incluir texto dinamicamente aqui.

            // create a network
            let data = {
                nodes: nodes,
                edges: edges,
            };
            let options = {
                physics: {
                    enabled: false, stabilization: true,
                },

                layout: {                  
                    //randomSeed: '0.6506283204401688: 1669127826006',
                },
                edges: { smooth: false },
            };
            network = new vis.Network(container, data, options);

            return { elementos: nodes, conexoes: edges };
        }


        function useTemplate(color, descricao) {
            let svgTemplate =
                `<svg xmlns="http://www.w3.org/2000/svg" width="390" height="65">
            <rect x="0" y="0" width="100%" height="100%" fill="${color}" stroke-width="20" stroke="#ffffff" ></rect>
            <foreignObject x="15" y="10" width="100%" height="100%">
            <div xmlns="http://www.w3.org/1999/xhtml" style="font-size:40px">
            <span style="color:white; text-shadow:0 0 20px #000000;">
            ${descricao}</span>"
            "</div>"
            "</foreignObject>"
            "</svg>`;

            let url = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svgTemplate);
            return url;
        }

        let handleNetWork = function () {
            "use strict";
            return {
                init: function () {
                    draw();
                    reorder(@Html.Raw(Json.Encode(Model.Json_order)));
                }
            }
        }();

        handleNetWork.init();

        function storePositions(visCallBack) {
            let parsedVis = JSON.parse(visCallBack);

            let arrayProperties = Object.getOwnPropertyNames(parsedVis);
            let array = [];

            for (let item of arrayProperties) {

                if (item != 'length') {
                    array.push({ id: item, x: parsedVis[item].x, y: parsedVis[item].y });
                }
            }
            return array;
        }

        function reorder(positionNodes = "") {

            if (positionNodes.length == 0) {
                return;
            }

            const positions = storePositions(positionNodes);

            for (let node of positions) {
                network.moveNode(node.id, node.x, node.y);
            }
        }

        //function resize(width, height) {

        //    let cadastro = $("#cadastro"),

        //        alturacadastro = Number(cadastro.css("width").replace("px", "")),
        //        larguracadastro = Number(cadastro.css("height").replace("px", ""));

        //    if (larguracadastro < height || alturacadastro < width) {
        //        cadastro.css("width", `${width}px`);
        //        cadastro.css("height",`${height}px`);
        //    }
        //    network.setSize(width, height);
        //}

    function generateImage() {

            let mime = "image/png",
                informationBase = $('canvas')[0].toDataURL(mime, 1.0).split(",");

            return {
                base64: `${informationBase[1]}`,
                base64context: `${informationBase[0]}`,
                extensao: mime.split("/")[1]
            };
    }


    async function ValidaSubmit() {

        let doc = generateImage(),
            posicoes = storePositions( JSON.stringify(network.getPositions()) );

        await $.post({
            url: "@String.Concat(CONSTANTES.URLPortal, "/api/Elemento_RedeApi/SaveDiagram")",
            type: "POST",
            dataType: "json",
            data: {
                Id: @Model.Id_Elemento,
                Descricao: "Diagrama_Fusao",
                Base64Image: doc.base64,
                Context: doc.base64context,
                Extensao: "pdf",
                Altura: `${document.querySelector('canvas').height}`,
                Largura: `${document.querySelector('canvas').width}`,
                OrderElements: JSON.stringify(posicoes),
            },
        })
            .done(function (data) {
                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", data.mensagem, "info");
            });

        }



    </script>
}

