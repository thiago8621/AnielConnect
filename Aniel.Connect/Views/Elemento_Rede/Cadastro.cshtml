        $(".BtnAddEnderecoCondominio").on("click", function () {
            let messages = [];

            const cloneEnderecoCondominio = structuredClone(requestEnderecoCondominio);

            if ($('#checkboxQuadra').is(':checked')) {
                cloneEnderecoCondominio.Bloco = "@RsBase.TODOS";
                cloneEnderecoCondominio.Id_Bloco = "";
            } else {
                cloneEnderecoCondominio.Bloco = blocoQuadraText;
                cloneEnderecoCondominio.Id_Bloco = blocoQuadraId;
            }

            if ($('#checkboxApto_Numero').is(':checked')) {
                cloneEnderecoCondominio.Apto_Numero = "@RsBase.TODOS";
                cloneEnderecoCondominio.Id_Apto_Numero = "";
            } else {
                cloneEnderecoCondominio.Apto_Numero = apto_numeroText;
                cloneEnderecoCondominio.Id_Apto_Numero = apto_numeroId;
            }

            if (cloneEnderecoCondominio == null) {
                messages.push("Escolha o Condomínio/Prédio a ser vinculado");
            }

            if (cloneEnderecoCondominio != null) {
                let itensEndereco = oDatatableCondominios.rows().data().toArray(),
                    itemSelect = Number($("#iCondominioPredio").val());

                let contem_registro = itensEndereco.find(p => p.Id_Condominio == itemSelect && p.Bloco == cloneEnderecoCondominio.Bloco && p.Apto_Numero == cloneEnderecoCondominio.Apto_Numero) !== undefined;

