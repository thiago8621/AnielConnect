        let handleElementoVinculadoOrigem = () => {
            $("#itemVinculadoOrigem").on("select2:select select2:unselect", function (event) {
                const ElementoVinculado = event.params.data;
                if (event.params._type == 'unselect') {

                    let index = itensVinculados.findIndex(p => { p.id == ElementoVinculado.id });
                    itensVinculados.splice(index, 1);

                }
                else {

                    itensVinculados.push(ElementoVinculado);
                }
            });

    };

