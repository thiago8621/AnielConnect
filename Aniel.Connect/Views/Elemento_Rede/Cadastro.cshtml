        function consultarPorta(_id) {


        if (_id === "") {
            _id = null;
            Notificar("@RsBase.ATENCAO_", "Não é possivel verificar as portas antes de terminar o cadastro deste Elemento", "warning");
            return;
        }
        else {
            let url = `@Url.Action("Index", "Elemento_Rede_Porta" @*new { id = "__id__" }*@)?caixa=${_id}`;
           AddAba(url,"Consultar_Portas")/*.replace('__id__', _id)*/;
        }
        }
    function visualizar_Mapa(_id) {

        let lat = $("#iLatitude").val().replace(",", ".");
        let lng = $("#iLongitude").val().replace(",", ".");

        if (lat == "")
        {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LATITUDE)", "warning"); return false;
        }

        if (lng == "")
        {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LONGITUDE)", "warning"); return false;
        }

        let url = `@Url.Action("Index", "Mapa_Gestao_Rede" @*new { id = "__id__" }*@)`;
        let formulario = document.createElement("form");

        formulario.method = "POST";
        $(formulario).attr({
            action: url,
            target: "_blank"
        });
            let obj = {
                latitude: lat,
                longitude:lng
            };

            let formdata = document.createElement("input");

            $(formdata).attr({
                type: "hidden",
                name: "latlng",
                value: JSON.stringify(obj)
            }).appendTo(formulario);

            $(document.body).append(formulario);

            formulario.submit();
        }


