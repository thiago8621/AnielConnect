        //    });

        //};
        var HandleTipoElemento = function () {

            $('#iTipo').on('select2:select select2:unselecting', function (e) {

                TipoSelecionado = e.params.data;

                let values = @(Enum.GetValues(typeof(ColunaModeloElementoEnum)).Length - 1);
                $("#ICampoDyn_0").empty();
                $("#DescricaoModelo").empty();
                if (TipoSelecionado != undefined) {

                    //if(TipoSelecionado)
                    let vinculo_modelo = `@RsCadastros.MODELO_ELEMENTO_REDE : ${TipoSelecionado.modelo_Vinculo}`;
                    $("#DescricaoModelo").text(vinculo_modelo);

                    let tamanho = TipoSelecionado.colunas.length - 1;
                    let listaDinamicos = TipoSelecionado.colunas.filter(p => p.id_Dinamico);

                    if (listaDinamicos.length > 0) {
                        let col = 0;
                        let row = 0;
                        for (let dinamico of listaDinamicos) {

                            if (col == 0 || col > 3) {
                                col = 1;
                                row++;
                                let str = `<div id=\"ICamposDyn_${row}\"class=\"row\"> </div>`;
                                let div = $.parseHTML(str);
                                $("#ICampoDyn_0").append(div);
                            }
                            col++;
                            let name = verifica_row(row);
                            CamposDynamic(dinamico.id_Dinamico, name);

                        }
                    }

                    for (let i = 0; i <= values; i++) {
                        let listaFiltrada = TipoSelecionado.colunas ? TipoSelecionado.colunas.filter(p => p.coluna == i) : [];

                        if (listaFiltrada.length > 0 && listaFiltrada[0].obrigatorio == true) {
                            $(`.inputclass${i}`).addClass("obrigatorio");
                        }
                        else {
                            $(`.inputclass${i}`).removeClass("obrigatorio");
                        }

                        if (listaFiltrada.length > 0) {
                            $(`#iDiv${i}`).show();
                        }
                        else {
                            $(`#iDiv${i}`).hide();
                        }
                    }
                    if (!$("#iCapacidade").val()) {
                        $("#iCapacidade").val(TipoSelecionado.capacidade);
                    }

                }
                else {

                    for (let iteration = 0; iteration < values; iteration++) {
                        $(`#iDiv${iteration}`).hide();
                        $(`.inputclass${iteration}`).removeClass("obrigatorio");

                    }

                }
            });
    };

    /**captura a resposta local */
    function get_response() {
        let array_Obj = [];
        let cols = $("#ICampoDyn_0").children().find("input, select");

        for (let col of cols) {

            let id = $(col).prop("id");
            let descricao = id.substr(1, id.search("_")-1);
            let idDinamico = id.substr(id.search("_") + 1, id.length);
            if (col.localName == "input") { value = $(col).val(); } else if (col.localName == "select") { value = $(col.selectedOptions).text() }
            let obj = {

                idElemento: $("#iId").val(),
                idDinamico: idDinamico,
                descricao: descricao,
                tipo: $(col).attr("tipo"),
                value: value,
            }
            if (obj.idElemento == "") {obj.idElemento=0 }
            array_Obj.push(obj);
        }
        $("#iObjeto").val(JSON.stringify(array_Obj));

    }

