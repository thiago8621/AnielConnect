       //#region criacampos
    /**funcao pai para criacao de campos
     * */
    //#endregion
    async function CamposDynamic(id,name) {


        let campos = [];

        let url = "@CONSTANTES.URLPortal/api/Modelo_Elemento_RedeApi/GetCampoDinamico";
        await $.ajax({
            url: url,
            type: "POST",
            data: {
                id_ : id,
            },
            dataType:"json"
        }).done(function (data) {
            if (data.ok) {

                campos.push(data.objeto.lista[0]);
            }
        }).fail(function (data) {
            Notificar("", data.mensagem, "");
        });

        for (let item of campos) {
            if (item.tipo === 5) {
                let opcoes = [];

                link = `@CONSTANTES.URLPortal/api/Modelo_Elemento_RedeApi/GetOpcoesDinamico?Id=${item.id}`;
                await $.ajax({
                    url: link,
                   type: "GET",
                    dataType: "json"
                }).done(function (data) {

                    if (data.ok && data.objeto) {
                        opcoes = data.objeto.opcao;
                    }

                }).fail(function (data) {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                });

                opcoes = opcoes.map(p => {
                    return {
                        id: p.id,
                        valor: p.resposta
                    }
                });

                CriarCampoDinamico(`${name}`, item.id, item.descricao, item.tipo, opcoes);
                let valorCampoDinamico = arrayObj.find(p => p.idDinamico == item.id)?.value;

                if (valorCampoDinamico){
                    $(`#i${item.descricao}_${item.id} option:contains("${valorCampoDinamico}")`).attr("selected", true);
                }


            }
            else {
                CriarCampoDinamico(`${name}`, item.id, item.descricao, item.tipo, []);
                let valorCampoDinamico = arrayObj.find(p => p.idDinamico == item.id);
                $(`#i${item.descricao}_${item.id}`).val(valorCampoDinamico?.value);
            }
        }
    }
