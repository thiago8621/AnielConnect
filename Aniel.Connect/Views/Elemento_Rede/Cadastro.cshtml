        <text>
    $("#iCriarConexao").on('click', async function () {
        let errors = [];
        try {

            if (itensVinculados.length < 2) {
                errors.push("Estrutura incompleta. Elemento de Origem/Destino Ausente");
            }
            if (fibraSelecionada == null) {
                errors.push("Fibra não foi selecionada");
            }

            @*Teste conexão dupla*@
            if (oDatatableConexoes.rows().count() > 0) {

                oDatatableConexoes.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    let obj = this.data();
                    // ... do something with data(), or this.node(), etc
                    if (obj.Numero_Fibra == fibraSelecionada.Numero_Fibra && obj.numero_Loose == fibraSelecionada.Numero_Loose) {

                        errors.push("Fibra selecionada já possui conexão definida");
                        return;
                    }
                });
            }

            if (errors.length > 0) {

                let textError = errors.length > 1 ? `${errors.length} erros` : "1 erro";
                textError += `<br> ${errors.join(" <br> e <br> ")}`;

                throw textError;
            }
            else {
                let conexao_origem =  await getPortaConexao(itensVinculados[0].id),
                    conexao_destino = await getPortaConexao(itensVinculados[1].id);

                oDatatableConexoes.row.add({

                    Id: 0,
                    Id_Cabo: fibraSelecionada.cabo,
                    Descricao_Cabo: `${fibraSelecionada.cabo} - ${fibraSelecionada.text}`,
                    Id_FibraUtilizada: fibraSelecionada.id,
                    Numero_Fibra:fibraSelecionada. numero_Fibra,
                    Numero_Loose: fibraSelecionada.numero_Loose,

                    Id_Origem: itensVinculados[0].id,
                    Id_Conexao_Origem: conexao_origem.id,
                    Tipo_Elemento_Origem: itensVinculados[0].id_Tipo,
                    Descricao_Elemento_Origem: itensVinculados[0].text,
                    portaOrigem: conexao_origem.porta,
                    Descricao_Tipo_Elemento_Origem: itensVinculados[0].tipo,

                    Id_Destino: itensVinculados[1].id,
                    Id_Conexao_Destino: conexao_destino.id,
                    Tipo_Elemento_Destino: itensVinculados[1].id_Tipo,
                    Descricao_Elemento_Destino: itensVinculados[1].text,
                    portaDestino: conexao_destino.porta,
                    Descricao_Tipo_Elemento_Destino: itensVinculados[1].tipo,
                });
                oDatatableConexoes.draw(false);
            }
        }


        catch (Exception) {
            Notificar('@RsBase.ERRO', Exception, "warning");
        }
    });

    async function getPortaConexao(elemento) {
        const link = `@CONSTANTES.URLPortal/api/Elemento_Rede_PortaApi/GetListByCaixa?IdCaixa=${elemento}`;
        let retorno = null;
        await $.ajax({
            url: link,
            type: "GET",
            dataType:"json"

        })
            .done(data => {
                if (data.hasOwnProperty('objeto'))
                    retorno = data.objeto.find(p => p.status == 'Disponível');
            });

        return { id: retorno.id, porta: retorno.porta };


    }

