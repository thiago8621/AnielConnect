                                        @Html.DropDownListFor(model => model.IdTipo, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iTipo", @autocomplete = "off" })
