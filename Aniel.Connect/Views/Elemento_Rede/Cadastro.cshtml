                    Tipo_Atendimento_Zona: valueSelect.tipo_Atendimento_Zona,
                    Status: valueSelect.status,
                    Numero: Number($("#iNumeroEndereco").val()),
                };
            }
        });

        $("#iSelectCondominio").on("select2:select select2:unselect", function ({ params: {_type:type, data } }) {

            let valueSelect = data;
            if (type == 'unselect') {
                requestEndereco = null;
            }
            else {

                requestEndereco = {
                    Id: 0,
                    Id_Condominio: valueSelect.id,
                    Id_Logradouro: valueSelect.id_Logradouro,
                    Descricao: valueSelect.descricao,
                    Cep: valueSelect.cep,
                    Bairro: valueSelect.bairro,
                    Cidade: valueSelect.cidade,
                    Uf: valueSelect.uf,
                    Pais: valueSelect.pais,
                    Tipo_Endereco_Logradouro: valueSelect.tipo_Endereco_Logradouro,
                    Tipo_Atendimento_Zona: valueSelect.tipo_Atendimento_Zona,
                    Status: valueSelect.status,
                    Numero: valueSelect.numero,
                };
            }
        });

        $(".BtnAddEndereco").on("click", function () {
            let messages = [];
            //let numeroSelecionado = requestEndereco?.Numero;

            let numeroSelecionado = Number($("#iNumeroEndereco").val());
            requestEndereco.Numero = numeroSelecionado;

            if (requestEndereco == null) {
                messages.push("Escolha o endereço a ser vinculado");
            }

            if (numeroSelecionado == 0) {
                messages.push("Número necessário para vínculo não foi preenchido");
            }

            if (requestEndereco != null && numeroSelecionado != 0) {
                let itensEndereco = oDatatableEnderecos.rows().data().toArray(),
                    itemSelect = Number($("#iSelectEnderecoLogradouro").val());

                let contem_registro = itensEndereco.find(p => p.Id_Logradouro == itemSelect && p.Numero == numeroSelecionado) !== undefined;

                if (contem_registro) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.REGISTRO_DUPLICIDADE", "warning");
                    return false;
                }
                oDatatableEnderecos.row.add(requestEndereco).draw(false);

                requestEndereco = null;
                $("#iSelectEnderecoLogradouro").val(null).trigger('change');
                return true;
            }
            else {
                for (let message of messages) {
                    Notificar("@RsBase.ATENCAO_", message, "warning");
                }
                return false;
            }
        });

        $("#iSelectTipoEndereco").on("change", function ({ target: { value = "" } }) {
            requestEndereco = null;

            $("#iSelectEnderecoLogradouro").val(null).trigger("change");
            $("#iSelectCondominio").val(null).trigger("change");
            $("#iNumeroEndereco").val("");

            if (value == '0') {
                $("#iCadastroEnderecoLogradouro").removeClass("d-none");
                $("#iCadastroCondominioPredio").addClass("d-none");
            }
            else if (value == '1') {
                $("#iCadastroCondominioPredio").removeClass("d-none");
                $("#iCadastroEnderecoLogradouro").addClass("d-none");
            }
            else {
                $("#iCadastroCondominioPredio").addClass("d-none");
                $("#iCadastroEnderecoLogradouro").addClass("d-none");
            }
        });

    </script>
