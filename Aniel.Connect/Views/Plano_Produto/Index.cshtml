@model IEnumerable<Aniel.Connect.Repository.Model.PlanoProdutoListModel>

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado

@{
    /**/

    ViewBag.Title = RsCadastros.PAINELPLANOSPRODUTOS;
    ViewBag.Sessao = RsCadastros.PLANOS_E_PRODUTOS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<Aniel.Connect.Models.T5.AreaModuloModel> _areas = ViewBag.Areas;
}


@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }

        .swal-wide {
            width: 650px !important;
        }

    </style>
}


@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")

<script>

        var rows_selected = [];
        let oDatatable;

        $("#spSaudacao").html("@RsCadastros.SAUDACAO" + ", " + username);
    function rowsSelectedMessage() {
        if (rows_selected.length === global_iTotal) {
            $("#dtLegendRecordsTotal").html("Todos os <strong> " + global_iTotal + " </strong> registros selecionados.");
        }
        else {
            $("#dtLegendRecordsTotal").html(`<a href='#' onclick ='rowsSelectedAddAll()'style='font-size: 14px;' ><strong>${rows_selected.length}</strong> registros selecionados <i class='fas fa-hand-point-right'></i><strong style='font-size: 13px;' > Clique aqui para selecionar todos os ${global_iTotal} registros </strong></a>`);
        }

        //Confirma a seleção de todos os registros
        $("#dtLegendRecordsTotal").click(function () {
            $("#dtLegendRecordsTotal").html("<span style='font-size: 14px;'>Todos os <strong> " + global_iTotal + " </strong> registros selecionados.</span>");
        });
    }

        var handleDataTableButtons = function () {
            "use strict";

            function AlterarStatusObj(Status) {
                const selectData = oDatatable.data().toArray().filter(p => rows_selected.includes(p.id));
                let listaPlanos = selectData.filter(p => p.tipo === "Plano");
                let listaProdutos = selectData.filter(p => p.tipo === "Produto");

                if (listaPlanos.length > 0) {
                    AlterarStatusPlano(listaPlanos.map(p => p.id), Status);
                }

                if (listaProdutos.length > 0) {
                    AlterarStatusProduto(listaProdutos.map(p => p.id), Status);
                }
            }

            function AlterarStatusPlano(Ids, Status) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/PlanoApi/AlterarStatus")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: Ids,
                        status: Status
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });
            };

            function AlterarStatusProduto(Ids, Status) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/ProdutoApi/AlterarStatus")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: Ids,
                        status: Status
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });
            };

            //"Blfrtip"
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [{
                    targets: 0,
                    searchable: false,
                    orderable: false,
                    width: '1%',
                    className: 'dt-body-center',
                    render: function (data, type, full, meta) {
                        return "<input type='checkbox'></input>";
                    }
                },
                {
                    targets: 1,
                    searchable: false,
                    orderable: true,
                    width: '1%',
                    className: 'dt-body-center'
                }],
                select: 'multi',
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '79vh',
                /*stateSave: true,*/
                scrollX: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/PlanoProdutoApi/GetAll',
                    type: 'POST',
                    data: function (data) {
                        var status = $("#iStatus_Filtro").val();
                        if ($("#iStatus_Filtro option:selected").val() == "-1") {
                            status = null;
                        }

                        data.Status = status;
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        //Mostrar o Total de Ordens de Serviços encontradas
                        if ($('#Count_listing').length === 0)
                            $('.dataTables_length').append($('<label id="Count_listing"></label>'));

                        $("#Count_listing").html(`<div class="form-group col-sm-push-1 ml-2 mt-1">
                            Total de Registros encontrados : <span style="font-weight:bold; margin-right:0px;" id="Total_OS">  &nbsp; `+ d.recordsFiltered + ` </span>
                        </div> `);

                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";

                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                drawCallback: function () {

                    var api = this.api();
                    var len = api.page.len();

                    if ($("input[name='select_all']").prop('checked') == true) {
                        rowsSelectedMessage();
                    }

                    if (len === -1) {
                        rows_selected = oDatatable.data().toArray().map(p => p.id);

                        $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');

                    }
                },
                pageLength: 10,
                language: traducaoDataTable,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "codigo", title: "@RsCadastros.CODIGO" },
                    { data: "descricao", title: "@RsCadastros.DESCRICAO" },
                    { data: "tipo", title: "@RsCadastros.TIPO" },
                    { data: "situacao", title: "@RsCadastros.SITUACAO" }
                ]
            });
            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });

            $("#iPesquisar").on("click", function () {
                $("#modal-filter").modal('hide');
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();

                return true;
            });

            $('#iLimparFiltro').on('click', function () {
                $("#iStatus_Filtro").val(-1);
                $('#txtSearch').val('');
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
            });

             $("#btnInativar").on("click", function () {
                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);
            });

            $("#btnAtivar").on("click", function () {
                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });

            $("#btnDuplicarPlanoProduto").on("click", function () {
                if (rows_selected.length > 1) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.REGISTROSSELECIONADOS", "info");
                    return;
                } else if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                swal.fire({
                        showCancelButton: true,
                        confirmButtonColor: '#0bb30e',
                        cancelButtonColor: '#d33',
                        confirmButtonText: "Duplicar",
                        cancelButtonText: 'Cancelar',
                        allowOutsideClick: false,
                        customClass: 'swal-wide',
                        html: `
                        <div class="text-left">
                            <h4>Duplicar Plano<h4>
                            <hr />
                        </div>
                        <div class="d-flex flex-row bd-highlight mb-3">
                            <div class="p-2 bd-highlight">Informe a quantidade de vezes que o Plano será duplicado:</div>
                            <div class="p-2 bd-highlight">
                                <input type="number" id="iQtdeDuplicidade" class="form-control" value="1" min=1 />
                            </div>
                        </div>
                        `
                    }).then((result) => {
                        if (result.value) {
                            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/PlanoProdutoApi/DuplicarPlanoProduto")' + `?planoProdutoId=${rows_selected[0]}&qtdeDuplicidade=${parseInt($("#iQtdeDuplicidade").val())}`;;
                            $.ajax({
                                url: link,
                                type: 'GET',
                                dataType: 'json',
                                beforeSend: function () {
                                    ShowPageLoading();
                                },
                                complete: function () {
                                    HidePageLoading();
                                }
                            }).done(function (data) {
                                if (data.ok) {
                                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            });
                        }

                        rows_selected = [];

                        oDatatable.draw();
                    });
            });

            $("#btnExcluir").on("click", function () {
                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/PlanoProdutoApi/excluirlista")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected
                    }
                })
                .done(function (data) {
                    if (data.ok) {
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");

                        rows_selected = [];
                        oDatatable.draw();
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                });
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            $('#datatable tbody').on('click', 'tr', function () {
                let { id, tipo } = oDatatable.row(this).data();
                const acesso = @Html.Raw(Json.Encode(AcessoHelper.TemAcesso(_areas, "74")));

                if (((tipo == "@HtmlEnumExtensions.GetEnumDescription(Tipo_Plano_Produto.Plano)") && acesso) || ((tipo == "@HtmlEnumExtensions.GetEnumDescription(Tipo_Plano_Produto.Produto)") && acesso))
                  {
                    var url = '@Url.Action("Cadastro", "Plano", new { id = "__id__" })';
                    window.location.href = url.replace('__id__', id);
                    ShowPageLoading();
                  }
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);
            });
        },
        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtons();
                }
            }
        }();

        TableManageButtons.init();


</script>
}


<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-wifi"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

            @*<span style="font-size:11px" id="dtLegend"></span>*@
        </div>

        <div class="col-auto mb-3">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.NOMEPLANOPRODUTO" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>

                @*<a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "Plano")" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>
                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">

                        <a class="dropdown-item" href="@Url.Action("Cadastro", "Plano")" onclick="ShowPageLoading(); return true;">@RsBase.CADASTRAR_PLANO</a>
                        <a class="dropdown-item" href="@Url.Action("Cadastro", "Produtos")" onclick="ShowPageLoading(); return true;">@RsBase.CADASTRAR_PRODUTO</a>
                    </div>*@

            <div>

                @if (AcessoHelper.TemAcesso(_areas, "74"))
                {
                    <button class="btn btn-success btn-add" type="button" title="Incluir" aria-haspopup="true" aria-expanded="false"
                            onclick="location.href='@Url.Action("Cadastro", "Plano")'; ShowPageLoading(); return false;">
                        <i class="la la-plus"></i>
                    </button>
                }

                @*<button class="btn btn-success btn-add" type="button" title="Incluir" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="la la-plus"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdown">
            <a class="dropdown-item" href="@Url.Action("Cadastro", "Plano")" onclick="ShowPageLoading(); return true;">@RsBase.CADASTRAR_PLANO</a>
            <a class="dropdown-item" href="@Url.Action("Cadastro", "Produtos")" onclick="ShowPageLoading(); return true;">@RsBase.CADASTRAR_PRODUTO</a>
        </div>*@
            </div>


                @*<button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>*@
                <button type="button" class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <div>
                    <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                    </button>

                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                        <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fa fa-table" aria-hidden="true"></i> @RsBase.EXPORTAREXCEL</a>
                        @if (AcessoHelper.TemAcesso(_areas, "74"))
                        {
                            <a id="btnAtivar" class="dropdown-item" href="#"><i class="fa fa-check" aria-hidden="true"></i> @RsBase.ATIVAR</a>
                            <a id="btnInativar" class="dropdown-item" href="#"><i class="fa fa-ban" aria-hidden="true"></i> @RsBase.INATIVAR</a>
                        }
                            <a id="btnDuplicarPlanoProduto" class="dropdown-item" href="#"><i class="fa fa-file" aria-hidden="true"></i> @RsBase.DUPLICAR_PLANO_PRODUTO</a>
                        </div>
                </div>
            </div>
        </div>

    </div>

    <!--./main-->
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>

<!--./Filter-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTRO</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label for="iStatus_Filtro">Status:</label>
                                <select id="iStatus_Filtro" class="form-control">
                                    <option value="-1">Todos</option>
                                    <option value="0">Inativo</option>
                                    <option value="1">Ativo</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row text-center">
                        <div class="form-group col-sm-12" style="padding: 15px;">
                            <div class="text-center">
                                <button id="iPesquisar" type="button" class="btn btn-success" onclick="">@RsCadastros.PESQUISAR</button>
                            </div>
                        </div>

                    </div>
                </div>


            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->