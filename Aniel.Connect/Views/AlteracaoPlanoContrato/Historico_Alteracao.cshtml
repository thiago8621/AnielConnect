@model Aniel.Connect.Models.LogGenericoParamListModel

@{
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    ViewBag.Title = @RsCadastros.HISTORICO_ALTERACOES;
    ViewBag.Sessao = @RsCadastros.HISTORICO_ALTERACOES;
}

@{ 
    long venda = long.Parse(Request.QueryString["venda"]);
}
@section styles{    
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />    
}

@section scripts {
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>
    <script>
                ///<reference path="../../../Aniel.Connect.Core/Scripts/connect.js" />

        var rows_selected = [];

        var handleDataTableButtons = function () {
            "use strict";

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                columnDefs: [
                    //{
                    //    targets: 0,
                    //    searchable: false,
                    //    orderable: false,
                    //    width: '1%',
                    //    className: 'dt-body-center',
                    //    render: function (data, type, full, meta) {
                    //        return "<input type='checkbox'></input>";
                    //    }
                    //}
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                processing: true,
                ordering: false,
                paging: true,
                deferRender: true,
                scrollResize: true,
                autoWidth: false,
                scrollY: '61vh',
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/AlteracaoPlanoContratoapi/HistoricoAlteracao',
                    type: 'POST',
                    data: function (data) {
                        data.id       = "@Request.QueryString["venda"]";
                        //data.dataIni      = $("#iDataInicial").val();
                        //data.dataFim      = $("#iDataFinal").val();
                        //data.objeto       = $("#iConta").val();
                        //data.tipoOperacao = $("#iTipoOperacao option:selected").val();
                        //data.campo        = $("#iCampo").val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                    var rowId = data.id;                     
                },
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [                    
                    { data: "nome_usuario", title: "@RsBase.NOME_USUARIO", orderable: false },
                    { data: "usuarioCriacao", title: "@RsBase.USUARIO", orderable: false },
                    { data: "dataHoraCriacao", title: "@RsBase.DATAHORA", orderable: false },
                    { data: "tipoOperacao", title: "@RsBase.OPERACAO", orderable: false },
                    { data: "campo", title: "@RsBase.CAMPO", orderable: false },
                    { data: "campo_ValorAntes", title: "@RsBase.VALORANTES", orderable: false },
                    { data: "campo_ValorDepois", title: "@RsBase.VALORDEPOIS", orderable: false },
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });
            
            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                //$(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {                

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                //updateDataTableSelectAllCtrl(oDatatable);

            });

            $("#iLimparFiltroModal, #iLimparFiltros").unbind("click");
            $("#iLimparFiltroModal, #iLimparFiltros").on("click", function () {
                $("#iDataInicial").val("");
                $("#iDataFinal").val("");

                $("#iConta").val("");
                $("#iCampo").val("");
                $("#iTipoOperacao").val("");

                rows_selected = [];

                oDatatable.search($('#txtSearch').val()).draw(false);
            });

            $("#iPesquisar").unbind("click");
            $("#iPesquisar").on("click", function () {

                var _data_ini = $("#iDataInicial").val().split("/");
                var _data_fim = $("#iDataFinal").val().split("/");

                var data_ini = new Date(_data_ini[2], _data_ini[1] - 1, _data_ini[0]);
                var data_fim = new Date(_data_fim[2], _data_fim[1] - 1, _data_fim[0]);

                let erro = false;

                if (!$("#iDataInicial").val()) {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsBase.DATA_INICIO)", "warning");
                    erro = true;
                }
                if (!$("#iDataFinal").val()) {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsBase.DATA_FINAL)", "warning");
                    erro = true;
                }

                if (!erro && data_ini > data_fim) {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.DATA_INVALIDA)", "warning")
                    $("#iDataInicial").val("")
                    $("#iDataFinal").val("")
                    erro = true;
                }

                if (!erro)
                {
                    rows_selected = [];
                    oDatatable.search($('#txtSearch').val()).draw();
                    $("#modal-filter").modal('hide');
                }

                return true;
            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();
    </script>
}
<div class="container-fluid" id="divTitle">
    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page"><i class=" fas fa-history"></i>@ViewBag.Title</h4>
            
            <nav class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a onclick="ShowPageLoading(); return true;" href="@Url.Action("Index","AlteracaoPlanoContrato")">@RsCadastros.LISTAGEM_ALTERACOES_PLANO_CONTRATO</a>
                                            </li>
                    <li class="breadcrumb-item">
                        <a onclick="ShowPageLoading(); return true;" href="@Url.Action("Cadastro","AlteracaoPlanoContrato",new {@IdVenda = venda})">@RsCadastros.ALTERACAO_PLANO_CONTRATO</a>

                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>

                </ol>
            </nav>            
        </div>
        <div class="col-auto">
            <div class="row title-page">
                <div class="pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.NOMEOUDOCUMENTO" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="divTable" style="width:97.5vw; margin:auto">
    <table class="table table-hover no-wrap display" id="datatable" style="width:100%">
    </table>
</div>
