@model Aniel.Connect.Repository.Model.AlteracaoPlanoContratoCadastroModel
@using Sinapse.Model.enumerados
@using Aniel.Connect.Model.enumerado
@using Microsoft.AspNet.Identity

@{
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    ViewBag.Title = @RsCadastros.ALTERACAO_PLANO_CONTRATO;
}

@{ var _areas = (List<Aniel.Connect.Models.T5.AreaModuloModel>)ViewBag.Areas;
    var areascobertura = (List<long>)ViewBag.AreasCobertura;
    var exigeAssinaturaTermo = ViewBag.ExigeAssinaturaTermo;
    long? IdCliente = Model.VendaBase != null ? Model.VendaBase.Id_Cliente : (long?)null;
    string Login = Model.VendaBase != null ? Model.VendaBase.Login : String.Empty;
    string Senha = Model.VendaBase != null ? Model.VendaBase.Senha : String.Empty;
    string CodEscritorio = Model.VendaBase != null ? Model.VendaBase.EnderecoInstalacao.Cod_Escritorio : String.Empty;
    string CodArea = Model.VendaBase != null ? Model.VendaBase.EnderecoInstalacao.Cod_Area : String.Empty;
    string CodLocalidade = Model.VendaBase != null ? Convert.ToString(Model.VendaBase.EnderecoInstalacao.Cod_Localidade) : String.Empty;
    string Localidade = Model.VendaBase != null ? Model.VendaBase.EnderecoInstalacao.Localidade : String.Empty;
}
@section styles{
    <link href="~/bin/Content/preloaderbar.css" media="none" onload="if(media!='all')media='all'" rel="stylesheet" />
    <style>
        .circle-consulta-pendente {
            font-size: 1.5em;
            color: #CCCCCC;
        }

        .circle-consulta-aprovada {
            font-size: 1.5em;
            color: #8BC53F;
        }

        .circle-consulta-reprovada {
            font-size: 1.5em;
            color: #FF0000;
        }

        .inherit-width {
            width: inherit
        }

        .legenda-status-sem-acesso {
            color: #CCCCCC;
            vertical-align: middle;
            font-size: 16px;
        }

        .legenda-status-aprovado {
            color: #8BC53F;
            vertical-align: middle;
            font-size: 16px;
        }

        .legenda-status-aprovado-manual {
            color: #2db3eb;
            vertical-align: middle;
            font-size: 16px;
        }

        .legenda-status-pedente {
            color: #CCCCCC;
            vertical-align: middle;
            font-size: 16px;
        }

        .legenda-status-reprovado {
            color: #FF0000;
            vertical-align: middle;
            font-size: 16px;
        }

        .swal2-popup .swal2-actions {
            z-index: 0 !important;
        }

        .swal2-lg {
            width: 600px !important;
        }
    </style>
}

@section scripts {
    <script src="~/bin/Scripts/cliente.js"></script>
    <script src="~/bin/Scripts/valida_cpf_cnpj.js"></script>
    <script src="~/bin/Scripts/bootstrap-validate.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyACnVjpiRnap58taXa7eEQJIVmD8TkoL2g&libraries=places,geometry" async defer></script>
    <script src="~/bin/Scripts/bootstrap-validate.js"></script>
    <script>

        const statusEtapaTermoAdesao = @((int)Model.EtapaTermoAdesao);
        const statusEtapaCriarOS = @((int)Model.EtapaCriacaoOS);
        const exigeAssinaturaTermo = @Html.Raw(Json.Encode(exigeAssinaturaTermo));
        let tecnologiaPlanoAntigo = null;

        const STATUS_CONSULTA_PENDENTE = 0;
        const STATUS_CONSULTA_APROVADA = 1;
        const STATUS_CONSULTA_REPROVADA = 2;
        const STATUS_CONSULTA_AGUARDANDO_AVALIACAO_GESTOR = 3;

        const TERMO_ADESAO = @((int) EnumEtapaVenda.TermoAdesao);
        const ORDEM_SERVICO = @((int) EnumEtapaVenda.OrdemServico);

        let clicked = false;
        let erro = false;
        const planoAnterior = @(Model.VendaBase != null ? Html.Raw(Json.Encode(Model.VendaBase.Planos)):Html.Raw(Json.Encode(new List<Aniel.Connect.Repository.Model.PlanoProdutoListModel>())));
        const configCombo = [];
        const desabilita_vendedor = "@Model.Id_Vendedor" == "" ? false : true;
        const possui_venda = "@Model.IdVenda" == 0 ? false : true;

        $("#iLinkComercial").on("click", async function () {
            let comercial = "@Url.Action("Index", "Comercial")";
            ShowPageLoading();
            window.location.href = comercial;

        });

        $("#iLinkIndex").on("click", async function () {
            let index = "@Url.Action("Index", "AlteracaoPlanoContrato")";
            ShowPageLoading();
            window.location.href = index;
        });

        $("#btnAlterarVendedorSupervisor").on("click", function () {
            EnableSelect('idVendedor');
            EnableSelect('idSupervisor');
            EnableSelect('iDepartamento');
        });

        const HandleVendedor = async function () {
            $('#idVendedor').unbind('select2:select select2:unselecting');
            $('#idVendedor').on('select2:select select2:unselecting', async function (e) {
                VendedorSelecionado = e.params.data;

                const id_venda = @Model.IdVenda;
                True = true;
                False = false;
                area = @Aniel.Connect.Core.Helpers.AcessoHelper.TemAcesso(_areas, "266");
                if (id_venda == 0) {
                    if (VendedorSelecionado != undefined) {
                        await AddSelect('idSupervisor', '@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboFuncionarioSupervisor', @CONSTANTES.PaginacaoRegistros, null, null, VendedorSelecionado.id_Supervisor, '@RsBase.SELECIONE', desabilita_vendedor);
                        await AddSelect("iDepartamento", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, VendedorSelecionado.id_Departamento, "@RsBase.SELECIONE", desabilita_vendedor);
                    }
                    else {
                        await AddSelect('idSupervisor', '@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboFuncionarioSupervisor', @CONSTANTES.PaginacaoRegistros, null, null, null, '@RsBase.SELECIONE', desabilita_vendedor);
                        await AddSelect("iDepartamento", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Departamento", "@RsBase.SELECIONE", desabilita_vendedor);
                    }
                }
                return true;
            });
        };

        $(document).ready(async function () {

            AtualizarIndicadorStatusConsulta(@((int)EnumEtapaVenda.TermoAdesao), statusEtapaTermoAdesao);
            AtualizarIndicadorStatusConsulta(@((int)EnumEtapaVenda.OrdemServico), statusEtapaCriarOS);
            const id_contrato_plano_selecionado = planoAnterior[0] != null ? planoAnterior[0].Id_Contrato : "";

            await AddSelect('idVendedor', '@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboVendedor', @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Vendedor", '@RsBase.SELECIONE', desabilita_vendedor, HandleVendedor);
            await AddSelect('idSupervisor', '@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboFuncionarioSupervisor', @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Supervisor", '@RsBase.SELECIONE', desabilita_vendedor);
            await AddSelect("iDepartamento", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Departamento", "@RsBase.SELECIONE", desabilita_vendedor);
            await AddSelect("iPlanoAnteriorSelecionado", "@CONSTANTES.URLPortal/api/AlteracaoPlanoContratoapi/GetComboPlanoByClienteContrato",@CONSTANTES.PaginacaoRegistros, "@IdCliente", id_contrato_plano_selecionado, "@Model.IdPlanoAnterior", "@RsBase.SELECIONE", "@Model.IdPlanoAnterior" != 0? true : false, null, null, null, { tecnologia: tecnologiaPlanoAntigo });

            @if (Model.VendaBase != null)
            {
            <text>
            if ('@Html.Raw(Model.IdPlanoAnterior)' != "" && '@Html.Raw(Model.IdPlanoAnterior)' != null && '@Html.Raw(Model.IdPlanoAnterior)' != undefined && '@Html.Raw(Model.IdPlanoAnterior)' != 0 && '@Html.Raw(Model.IdPlanoAnterior)' != "null") {
                await $.get({ url: `@CONSTANTES.URLPortal/api/AlteracaoPlanoContratoapi/GetTecnologiaPlano?plano=@Model.IdPlanoAnterior`, type: "GET", dataType: "json", }).done(function (apiTecnologia) {
                    if (apiTecnologia != null && apiTecnologia.ok) {
                        tecnologiaPlanoAntigo = apiTecnologia.objeto;
                    }
                });
                configCombo.push({ Key: "TECNOLOGIA", Value: tecnologiaPlanoAntigo });
            }
            </text>
            }
            @if(areascobertura.Count > 0)
            {
             <text>
            configCombo.push({ Key: "AREACOBERTURA", Value:@Html.Raw(Json.Encode(areascobertura))});
            </text>
            }
            await AddSelect("iPlanoSelecionado", "@CONSTANTES.URLPortal/api/AlteracaoPlanoContratoapi/GetComboPlanoTecnologia",@CONSTANTES.PaginacaoRegistros, null, "@IdCliente", "@Model.IdPlanoProduto", "@RsBase.SELECIONE", possui_venda, null, null, null, configCombo);
        });
        $('#iPlanoSelecionado').unbind('select2:select select2:unselecting');
        $("#iPlanoSelecionado").on("select2:select select:unselect", async function (e) {
            if (e.params._type == "unselect") {
                $("#iDetalhes").empty();
                return;
                $("#iIdPlanoProduto").val(null).trigger("change");
                $("#iPlanoProduto").val(null).trigger("change");
            }
            else {
                let { id, text } = e.params.data;
                await renderDetalhesPlano(id, text);
                ValidaContrato()
                    .then(async (erroContrato) => {
                        if (!erroContrato) {
                            if ($("#iPlanoAnteriorSelecionado").val()) {
                                let objGravacao = await getPlanoProdutoList(e.params.data);
                                fillPlanoProduto(objGravacao);
                                $("#iIdPlanoProduto").val(id).trigger("change");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", "Plano vigente não foi escolhido na rotina", "warning");
                            }
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", "erro na validação de contrato", "warning");
                            $("#iIdPlanoProduto").val(null).trigger("change");
                            $("#iPlanoProduto").val(null).trigger("change");
                        }
                    });
            }
        });


        async function renderDetalhesPlano(id, text) {
            let idplanoAnterior = Number("@Model.IdPlanoAnterior");
            let detalhesPlano = { perguntas: [], respostas: [] };
            let url = "@CONSTANTES.URLPortal/api/clienteapi/FindByIdClientePlanoProduto?Id=" + $("#iPlanoAnteriorSelecionado").val();

            const detalhesPlanoAnterior = await $.get({
                url: url, type: "GET", dataType: "json",
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                } });
            const obj_plano_anterior = detalhesPlanoAnterior.objeto;

            await $.get({
                url: `@CONSTANTES.URLPortal/api/PlanoApi/GetListDetalhes?Id_Plano=${id}`, type: "GET", dataType: "json",
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                } }).done(async function (data) {
                let detalhe = "";
                let periodoCarencia = data.objeto.periodo_Carencia;

                detalhesPlano["perguntas"].push(`— Descrição do Plano: `);
                detalhesPlano["perguntas"].push(`— Valor de Instalação: R$ `);
                detalhesPlano["perguntas"].push(`— Valor final total a ser pago - Sem instalação: R$ `);
                detalhesPlano["perguntas"].push(`— Valor final total a ser pago - Com instalação: R$ `);
                detalhesPlano["perguntas"].push(`— Período de Carencia:`);
                detalhesPlano["perguntas"].push(`— Quantidade de Meses: `);
                detalhesPlano["perguntas"].push(`— Valor da multa por Rescisão: `);

                detalhesPlano["respostas"].push(`${text}`);
                detalhesPlano["respostas"].push(`${data.objeto.valorInstalacao} `);
                detalhesPlano["respostas"].push(`${data.objeto.valorTotalSemInstalacao}`);
                detalhesPlano["respostas"].push(`${data.objeto.valorTotalComInstalacao}`);
                detalhesPlano["respostas"].push(`${periodoCarencia}`);
                detalhesPlano["respostas"].push(`${data.objeto.multa_Carencia_Periodo} `);
                detalhesPlano["respostas"].push(`${data.objeto.multa_Carencia_Reais}`);

                const valor_plano_produto = obj_plano_anterior != null ? parseFloat(obj_plano_anterior.valorPlanoProduto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.')) : 0;
                const valor_plano_produto_final = parseFloat(data.objeto.valorPlanoProdutoFinal.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.'));
                if (valor_plano_produto_final != valor_plano_produto) {
                    let tipoAlteracao = valor_plano_produto_final > valor_plano_produto ? "UPGRADE" : "DOWNGRADE";
                    detalhesPlano["perguntas"].push(tipoAlteracao);
                    detalhesPlano["respostas"].push("");
                    if (tipoAlteracao == "UPGRADE") {
                        $("#iTipoAlteracao").val(@((int)Aniel.Connect.Model.enumerado.TipoAlteracaoPlanoContratoEnum.upgrade));
                    }
                    else if (tipoAlteracao == "DOWNGRADE") {
                        $("#iTipoAlteracao").val(@((int)Aniel.Connect.Model.enumerado.TipoAlteracaoPlanoContratoEnum.downgrade));
                    }
                }
                for (let iterator = 0; iterator < detalhesPlano["perguntas"].length; iterator++) {
                    detalhe += `<span class="font-weight-bold"> ${detalhesPlano['perguntas'][iterator]}</span> <span> ${detalhesPlano["respostas"][iterator]}</span><br />`
                }

                $("#iDetalhes").html(detalhe);
            });
        }

        function AtualizarIndicadorStatusConsulta(consulta, status) {
            let statusClass = null;
            switch (status) {
                case STATUS_CONSULTA_PENDENTE:
                    statusClass = "circle-consulta-pendente";
                    break;
                case STATUS_CONSULTA_APROVADA:
                    statusClass = "circle-consulta-aprovada";
                    break;
                case STATUS_CONSULTA_REPROVADA:
                case STATUS_CONSULTA_AGUARDANDO_AVALIACAO_GESTOR:
                    statusClass = "circle-consulta-reprovada";
                    break;
            }

            if (statusClass != null) {


                switch (consulta) {
                    case TERMO_ADESAO:
                        let statusTermoSelector = "#statusTermoAdesao";
                        AtualizaStatusConsulta(statusTermoSelector, true, statusClass);
                        alteraBtnTermo(status);
                        break;

                    case ORDEM_SERVICO:
                        let statusOSSelector = "#statusCriacaoOS";
                        AtualizaStatusConsulta(statusOSSelector, true, statusClass);
                        break;
                }
            }
        }

        function AtualizaStatusConsulta(element, visualiza, classe) {
            $(element).removeClass("circle-consulta-pendente");
            $(element).removeClass("circle-consulta-aprovada");
            $(element).removeClass("circle-consulta-reprovada");

            if (@Html.Raw(Json.Encode(Aniel.Connect.Core.Helpers.AcessoHelper.TemAcesso(_areas, "322")))) {
                $(element).addClass(classe);
            }
            else if (visualiza) {
                $(element).addClass(classe);
            }
            else {
                $(element).addClass("circle-consulta-pendente");
            }
        }

        function alteraBtnTermo(status) {
            if (statusEtapaTermoAdesao == @((int)(StatusEtapaVenda.Aprovado))) {
                $("#btnVisualizaTermo").removeClass("d-none");
                $("#btnReenvioTermo").addClass("d-none");
                $("#btnEnvioTermo").addClass("d-none");
            }
            else if (statusEtapaTermoAdesao == @((int)(StatusEtapaVenda.Reprovado))) {
                $("#btnReenvioTermo").removeClass("d-none");
                $("#btnEnvioTermo").addClass("d-none");
                $("#btnVisualizaTermo").addClass("d-none");
            }
            else {
                $("#btnEnvioTermo").removeClass("d-none");
                $("#btnReenvioTermo").addClass("d-none");
                $("#btnVisualizaTermo").addClass("d-none");
            }
        }

        function ValidaContrato() {
            return new Promise(async (resolve, reject) => {
                let erro = false;
                if ($("#iPlano").val()) {
                    let link = '@String.Concat(CONSTANTES.URLPortal, "/api/Planoapi/FindById?Id=")' + $("#iPlanoSelecionado").val();
                    await $.getJSON(link, async function (data) {
                        if (data.objeto == null) {
                            link = '@String.Concat(CONSTANTES.URLPortal, "/api/Produtoapi/FindById?Id=")' + $("#iPlanoSelecionado").val();

                            await $.getJSON(link, function (data) {
                                erro = validaContratoPlanoProduto(data.objeto);
                                resolve(erro);
                            });
                        }
                        else {
                            erro = validaContratoPlanoProduto(data.objeto);
                            resolve(erro);
                        }
                    });
                }

                resolve(erro);
            });
        }
        function validaContratoPlanoProduto(planoProduto) {
            let erro = false;
            if (planoProduto.emitirContratoProduto == true) {
                const id_modelo_contrato = planoAnterior[0] != null ? planoAnterior[0].Id_Modelo_Contrato : "";
                if (!id_modelo_contrato) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MODELO_CONTRATO)", "warning");
                    erro = true;
                }

                const numero_contrato = planoAnterior[0] != null ? planoAnterior[0].Numero_Contrato : "";
                if (!numero_contrato) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.NUMERO_CONTRATO)", "warning");
                    erro = true;
                }
            }
            return erro;
        }

        function validaSubmit() {
            if (clicked) { return false; }

            ShowPageLoading();
            erro = false;
            clicked = true;

            if (!$("#iPlanoSelecionado").val()) {
                erro = true;
                Notificar("@RsBase.ATENCAO_", "Preencha o Plano Produto", "warning");
            }

            if (!$("#idVendedor").val()) {
                erro = true;
                Notificar("@RsBase.ATENCAO_", "Preencha Vendedor", "warning")
            }
            if (!$("#idSupervisor").val()) {
                erro = true;
                Notificar("@RsBase.ATENCAO_", "Preencha Vendedor", "warning")
            }
            if (!$("#iDepartamento").val()) {
                erro = true;
                Notificar("@RsBase.ATENCAO_", "Preencha Departamento", "warning")
            }

            if (erro) {
                HidePageLoading();
                clicked = false;

                return false;
            }
            $("#form").submit();
        }

        function geracaocharCode(numeroContrato) {
            let charCodeAppended = "";
            for (let iterator = 0; iterator < numeroContrato.length; iterator++) {
                charCodeAppended += numeroContrato.charCodeAt(iterator);
            }
            return charCodeAppended;
        }

        async function getPlanoProdutoList(data) {
            let registroPlanoAnterior = await $.get({ url: `@String.Concat(CONSTANTES.URLPortal, "/api/Planoapi/FindById?Id=")@Model.IdPlanoAnterior`, type: "GET", dataType: "json" });

            let registroPlanoProdutoListModel = {};

            registroPlanoProdutoListModel.Id = 0;
            registroPlanoProdutoListModel.Id_Endereco = 0;
            registroPlanoProdutoListModel.Id_Plano_Produto = data.id;
            registroPlanoProdutoListModel.Id_Troca_Plano = registroPlanoAnterior.objeto.id;
            registroPlanoProdutoListModel.Descricao = data.text;
            registroPlanoProdutoListModel.Disponibiliza_Telefonia = false;
            registroPlanoProdutoListModel.JsonTelefonia = "";
            registroPlanoProdutoListModel.ServicosAdicionais = "";
            registroPlanoProdutoListModel.Utilizar_ServicoSelecionado = false;

            registroPlanoProdutoListModel.ValorTotal = data.valorTotal;
            registroPlanoProdutoListModel.ValorPlanoProduto = parseFloat(data.valorReal);
            registroPlanoProdutoListModel.ValorPlanoProduto_Final = parseFloat(data.valorFinal);
            registroPlanoProdutoListModel.ValorInstalacao = !data.valorInstalacao ? '' : parseFloat(data.valorInstalacao.replace(',', '.'));
            registroPlanoProdutoListModel.ValorInstalacao_Final = !data.valorInstalacaoFinal ? '' : parseFloat(data.valorInstalacaoFinal.replace(',', '.'));
            registroPlanoProdutoListModel.Status = "@Convert.ToInt32(Status_PlanoProduto.Aguardando_Aprovacao_Venda)";
            registroPlanoProdutoListModel.Status_PlanoProduto_Str = "@RsCadastros.AGUARDANDO_APROVACAO_VENDA";
            registroPlanoProdutoListModel.Cod_Area = "@CodArea";
            registroPlanoProdutoListModel.Cod_Escritorio = "@CodEscritorio";
            registroPlanoProdutoListModel.Cod_Localidade = "@CodLocalidade";
            registroPlanoProdutoListModel.Localidade = "@Localidade";

            registroPlanoProdutoListModel.Tipo_Tecnologia = data.tipo_Tecnologia;
            registroPlanoProdutoListModel.Id_Contrato = null;
            registroPlanoProdutoListModel.Id_Modelo_Contrato = registroPlanoAnterior.objeto.idModeloContrato;
            registroPlanoProdutoListModel.Numero_Contrato = planoAnterior[0] != null ? planoAnterior[0].Numero_Contrato : "";
            registroPlanoProdutoListModel.Id_PlanoMudanca = planoAnterior[0] != null ? planoAnterior[0].Id : 0;
            registroPlanoProdutoListModel.Id_MudancaPlano = planoAnterior[0] != null ? planoAnterior[0].Id : 0;
            registroPlanoProdutoListModel.Tipo = data.tipo;
            registroPlanoProdutoListModel.Login_Radius = "@Login";
            registroPlanoProdutoListModel.Senha_Radius = "@Senha";

            registroPlanoProdutoListModel.Numero_Parcelas = registroPlanoAnterior.objeto.numero_Parcelas_Instalacao;
            registroPlanoProdutoListModel.Qtde_Dias = registroPlanoAnterior.objeto.qtde_Dias;
            registroPlanoProdutoListModel.Meses_Carencia = registroPlanoAnterior.objeto.meses_Carencia;
            registroPlanoProdutoListModel.Teste_Gratis = registroPlanoAnterior.objeto.checkTesteGratis;
            registroPlanoProdutoListModel.Periodo_Carencia = registroPlanoAnterior.objeto.checkPeriodoCarencia;
            registroPlanoProdutoListModel.Id_Endereco = planoAnterior[0] != null ? planoAnterior[0].Id_Endereco : 0;

            registroPlanoProdutoListModel.NecessitaCriarOS = "";
            registroPlanoProdutoListModel.PossuiOSCriada = "";
            registroPlanoProdutoListModel.NumOS = "";
            registroPlanoProdutoListModel.Id_Forma_Pagamento_Cliente = planoAnterior[0] != null ? planoAnterior[0].Id_Forma_Pagamento_Cliente : 0;
            registroPlanoProdutoListModel.Id_Forma_De_Pagamento = planoAnterior[0] != null ? planoAnterior[0].Id_Forma_Pagamento_Cliente : 0;

            registroPlanoProdutoListModel.Desc_Forma_Pagto = "";
            registroPlanoProdutoListModel.FlagTrocaPlano = true;
            registroPlanoProdutoListModel.Id_Tecnologia = data.id_Tecnologia;

            return registroPlanoProdutoListModel;

        }
        function fillPlanoProduto(registroPlanoProdutoListModel) {
            $("#iPlanoCod_Escritorio").val(registroPlanoProdutoListModel.Cod_Escritorio);
            $("#iPlanoCod_Area").val(registroPlanoProdutoListModel.Cod_Area);
