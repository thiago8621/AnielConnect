        @if (Model.IdVenda != 0) {

        <text>
        async function alterarStatus(status) {
            return await $.ajax({
                url: "@String.Concat(CONSTANTES.URLPortal,"/api/Vendaapi/AlterarStatus")",
                dataType: "json",
                type: "POST",
                data: {
                    id:@Model.IdVenda,
                    status: status,
                    usuario: "@User.Identity.GetUserId()"
                },
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                }
            });
        }
        async function ReenviarTermoAdesao() {
            var consulta_plano = await ConsultaPlanoEmVenda();
            if (!consulta_plano) {
                Notificar("@RsBase.ATENCAO_", "Não foi possível reenviar o termo por e-mail, pois, não existe PLANO vinculado a essa venda.", "warning");
            } else {
                const link = '@String.Concat(CONSTANTES.URLPortal, "/api/TermoAdesaoApi/enviarTermoAdesao")' + "?IdVenda=" + "@Model.IdVenda";

                const data = await $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',
                    beforeSend: function () {
                        $("#divProgress").show();
                    },
                    complete: function () {
                        $("#divProgress").hide();
                    }
                });

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "Termo de adesão enviado", "info");
                }
                else {
                    Notificar("@RsBase.ATENCAO_", "Erro ao enviar o termo de adesão - " + data.mensagem, "warning");
                }
            }
        }
        async function ConsultaPlanoEmVenda() {
            const link = '@String.Concat(CONSTANTES.URLPortal, "/api/VendaApi/ConsultaPlanoEmVenda")' + "?IdVenda=" + "@Model.IdVenda";
            const data = await $.ajax({
                url: link,
                type: 'GET',
                dataType: 'json',
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                }
            });

            return data.ok;
        }
        $("#btnEnvioTermo, #btnReenvioTermo").on("click", async function () {
            await ReenviarTermoAdesao();
            if ($(this).attr("id") == "btnEnvioTermo") {
                await $.get({
                    url: `@CONSTANTES.URLPortal/api/VendaApi/AlterarStatusEtapaVenda?idVenda=@Model.IdVenda&etapa=${TERMO_ADESAO}&status=${STATUS_CONSULTA_REPROVADA}&IdConsulta=&idTrocaTitular=`,
                    dataType: "json",
                    type: "GET",
                    beforeSend: function () {
                        $("#divProgress").show();
                    },
                    complete: function () {
                        $("#divProgress").hide();
                    }
                }).done(function (data) {
                    if (data.ok) {
                        @*Alteração de Status do Termo de Adesão para Reprovado*@
                        window.location.reload();
                    }
                });
            }
        });

        function VisualizarTermoAdesao() {
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/TermoAdesaoApi/getPdfTermoAdesao")' + "?IdVenda=" + "@Model.IdVenda";

            $.ajax({
                url: link,
                type: 'GET',
                dataType: 'json',

                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                }
            })
                .done(function (data) {
                    if (data.ok) {
                        let caminho = "@CONSTANTES.URLPortal/Arquivos/TermoAdesao/termo_adesao_@Model.IdVenda" + ".pdf";
                        window.open(caminho);
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                });
        }

        $("#btnVisualizaTermo").on("click", function () {
            VisualizarTermoAdesao();
        });

        $("#iAprovar").on("click", async function () {
            if (exigeAssinaturaTermo) {
                if (statusEtapaTermoAdesao != STATUS_CONSULTA_APROVADA) {
                    //Notificar("@RsBase.ATENCAO_", "Termo de Adesão pendente de Assinatura", "warning");
                    await Swal.fire({
                        type: 'warning',
                        title: '@RsBase.ATENCAO_',
                        text: `Termo de Adesão pendente de Assinatura`,
                        confirmButtonText: 'OK'
                    });
                    return false;
                }
            }
            let retorno = await alterarStatus(@((int)Status_Venda.Venda_Aprovada));
            if (retorno.ok) {
                //Notificar("Sucesso", "Proposta de Alteração de Plano foi efetuada com sucesso", "info");
                await Swal.fire({
                    type: 'success',
                    title: 'Sucesso',
                    text: '@Html.Raw("Proposta de Alteração de Plano foi efetuada com sucesso")',
                    confirmButtonText: 'OK'
                });
                $("#divProgress").show();
                window.location.reload(true);
            }
            else
            {
                //Notificar("@RsBase.ATENCAO_", retorno.mensagem, "warning");
                await Swal.fire({
                    type: 'warning',
                    title: '@RsBase.ATENCAO_',
                    text: `${retorno.mensagem}`,
                    confirmButtonText: 'OK'
                });
            }
            return true;
        });

        $("#iReprovar").on("click", async function () {
            let retorno = await alterarStatus(@((int)Status_Venda.Venda_Cancelada));
            if (retorno.ok) {
                Notificar("@RsBase.ATENCAO_", "Proposta de Alteração de Plano foi recusada", "info");
                window.location.reload(true);
            }
            else
            {
                Notificar("@RsBase.ATENCAO_", retorno.mensagem, "warning");
            }

            return true;
        });

        $("#iCriarAtendimento").on("click", function () {
            ShowPageLoading();

            window.location.href = `@Url.Action("cadastro","Atendimento")?IdVenda=@Model.IdVenda&IdClienteContrato=@Model.PlanoProduto.Id_Contrato&IdClientePlanoProduto=@Model.PlanoProduto.Id`;
        });

        $("#iHistorico").on("click", function () {
            ShowPageLoading();
            window.location.href = "@Url.Action("Historico_Alteracao","AlteracaoPlanoContrato")?id=@Model.PlanoProduto.Id&venda=@Model.IdVenda"
        });

        $("#btnCriarOS").on("click", function () {
            ShowPageLoading();
            AddAba('@Url.Action("Criar_Ordem_Servico", "Painel_Servicos", new { Id_Cliente = Model.Id_Cliente, Id_Venda = Model.IdVenda })&Id_PlanoProduto=@Model.PlanoProduto.Id&Id_PlanoProdutoAnterior=@Model.PlanoProduto.Id_Troca_Plano&Id_Venda=@Model.IdVenda', '@Html.Raw(RsCadastros.CRIAR_ORDEM_SERVICO)');
            HidePageLoading();
        });

        $("#btnVisualizarOS").on("click", function () {
            ShowPageLoading();
            const url = `@Html.Raw(Url.Action("Index", "Acompanhamento_Servico", new { CodCt = Model.cod_ct, Projeto = Model.projeto, Num_Obra = Model.numeroOS, Num_Doc = Model.num_doc}))`;
            AddAba(url, '@Html.Raw(RsCadastros.ACOMPANHAMENTO_SERVICO)');
            HidePageLoading();
        });
        </text>
        }
    </script>
}

