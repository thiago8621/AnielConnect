                                @Html.DisplayFor(p => p.VendaBase.DescCategoriaCliente)
                            </div>
                            <div class="col-sm-2">
                                <label for="iCpfCnpj" class="font-weight-bold"> @RsCadastros.CPFCNPJ </label>
                                @Html.DisplayFor(p => p.VendaBase.CpfCnpj)
                            </div>
                            <div class="col-sm-2">
                                <label for="iDescricaoPlano" class="font-weight-bold"> Descrição do Plano Vigente </label>
                                @Html.DisplayFor(p => p.VendaBase.Planos[0].Descricao)
                            </div>
                            <div class="col-sm-2">
                                <label for="iPeriodoFidelidade" class="font-weight-bold"> @RsCadastros.PERIODO_FIDELIDADE_MESES_ </label>
                                @Html.DisplayFor(p => p.VendaBase.Planos[0].Meses_Carencia)
                            </div>
                        </div>
                        <div class="row mt-1">
                            <div class="col-sm-2">
                                <label for="iContrato" class="font-weight-bold"> @RsCadastros.CONTRATO </label>
                                @Html.DisplayFor(p => p.VendaBase.Planos[0].Descricao_Contrato)
                            </div>
                            <div class="col-sm-2">
                                <label for="iNomeFantasia" class="font-weight-bold"> @RsCadastros.NOMEFANTASIA </label>
                                @Html.DisplayFor(p => p.VendaBase.NomeFantasia)
                            </div>
                            <div class="col-sm-2">
                                <label for="iVigenciaContrato" class="font-weight-bold"> Prazo de Vigência do contrato </label>
                                @Html.DisplayFor(p => p.VendaBase.Encerra_Carencia)
                            </div>
                            <div class="col-sm-2">
                                <label for="iValorMulta" class="font-weight-bold"> @RsCadastros.VALOR_MULTA_RESCISAO </label>
                                @Html.DisplayFor(p => p.VendaBase.Planos[0].Multa_Carencia_Reais)
                            </div>
                        </div>
                        <div class="row mt-1">
                            <div class="col-sm-2 offset-sm-2">
                                <label for="iFormaPagamento" class="font-weight-bold"> @RsCadastros.FORMA_PAGAMENTO </label>
                                @Html.DisplayFor(p => p.VendaBase.Planos[0].Desc_Forma_Pagto)
                            </div>
                            <div class="col-sm-2">
                                <label for="iDesc_Periodo_Carencia" class="font-weight-bold"> @RsCadastros.TEM_FIDELIDADE_ </label>
                                @Html.DisplayFor(p => p.VendaBase.Planos[0].Desc_Periodo_Carencia)
                            </div>
                        </div>
                        <div class="row mt-4">
                            <div class="col-sm-4">
                                <h5 class="text-muted font-weight-bold" style="font-size:15px">@RsCadastros.ENDERECO_DE_INSTALACAO </h5>
                                <hr />
                            </div>
                        </div>
                        <div class="row mt-1">
                            <div class="col-sm-4">
                                <label for="iCEP" class="font-weight-bold"> @RsCadastros.CEP </label>
                                @Html.DisplayFor(p => p.VendaBase.EnderecoInstalacao.CEP)
                            </div>
                            <div class="col-sm-4">
                                <label for="iBairro" class="font-weight-bold"> @RsCadastros.BAIRRO </label>
                                @Html.DisplayFor(p => p.VendaBase.EnderecoInstalacao.Bairro)
                            </div>
                        </div>
                        <div class="row mt-1">
                            <div class="col-sm-4">
                                <label for="iLogradouro" class="font-weight-bold"> @RsCadastros.LOGRADOURO </label>
                                @Html.DisplayFor(p => p.VendaBase.EnderecoInstalacao.Logradouro)
                            </div>
                            <div class="col-sm-4">
                                <label for="iTipoImóvel" class="font-weight-bold"> @RsCadastros.TIPO_IMOVEL </label>
                                @Html.DisplayFor(p => p.VendaBase.EnderecoInstalacao.Desc_Tipo_Imovel)
                            </div>
                        </div>
                        <div class="row mt-1">
                            <div class="col-sm-4">
                                <label for="iNumero" class="font-weight-bold"> @RsCadastros.NUMERO </label>
                                @Html.DisplayFor(p => p.VendaBase.EnderecoInstalacao.Numero)
                            </div>
                            <div class="col-sm-4">
                                <label for="iPais" class="font-weight-bold"> @RsCadastros.PAIS </label>
                                @Html.DisplayFor(p => p.VendaBase.EnderecoInstalacao.Pais)
                            </div>
                        </div>
                        <div class="row mt-1">
                            <div class="col-sm-4">
                                <label for="iUF" class="font-weight-bold"> @RsCadastros.UF </label>
                                @Html.DisplayFor(p => p.VendaBase.EnderecoInstalacao.UF)
                            </div>
                            <div class="col-sm-4">
                                <label for="iComplemento" class="font-weight-bold"> @RsCadastros.COMPLEMENTO </label>
                                @Html.DisplayFor(p => p.VendaBase.EnderecoInstalacao.Complemento)
                            </div>
                        </div>
                        <div class="row mt-1">
                            <div class="col-sm-4">
                                <label for="iCidade" class="font-weight-bold"> @RsCadastros.CIDADE </label>
                                @Html.DisplayFor(p => p.VendaBase.EnderecoInstalacao.Cidade)
                            </div>
                            <div class="col-sm-4">
                                <label for="iPontoReferencia" class="font-weight-bold"> @RsCadastros.PONTOREFERENCIA </label>
                                @Html.DisplayFor(p => p.VendaBase.EnderecoInstalacao.Ponto_Referencia)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @*Dados da Venda*@
        <div class="accordion mt-2">
            <div class="card div-card-accord mt-1">
                <div class="card-header title-card">
                    <h4 class="text-muted" style="font-size:15px">Dados da Venda</h4>
                </div>
                <div class="card-body body-card-accord">
                    <span class="text-bold-card"></span><span class="text-bold-card"></span><span class="text-bold-card"></span>
                    <!--Contato-->
                    <div class="form-group panel">
                        <div class="row pb-2">
                            <div class="col-sm-3">
                                <div class="form_group">
                                    <label for="iNumVenda">@RsCadastros.NUMERO_VENDA:</label>

                                    @Html.DisplayFor(p => p.IdVenda, new { id = "iNumVenda" })
                                </div>
                            </div>
                            <div id="exibirStatusVenda" class=" col-sm-3">
                                <div class="form-group">
                                    <label for="iStatusVenda">@RsCadastros.STATUS_VENDA:</label><br>
                                    @Html.TextBoxFor(m => m.Status, new { @class = "form-control readonly", @id = "iStatusVenda", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <label>@RsCadastros.DATA_CRIACAO:</label>
                                <div class="form-group">
                                    @Html.TextBoxFor(m => m.DataCriacao, new { @class = "form-control readonly", @data_provide = "datepicker", @id = "iDataCriacao", @autocomplete = "off" })

                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-3">
                                <label for="iNomeVendedor"><span class="text-danger">*</span> @RsCadastros.VENDEDOR</label>
                                <div class="form-group">
                                    @Html.DropDownListFor(model => model.Id_Vendedor, new SelectList(new List<Aniel.Connect.Core.ObjBusca<Int64?>>()), RsBase.SELECIONE, new { @id = "idVendedor", @class = "form-control", @style = "width: 100%" })
                                </div>
                            </div>

                            <div class="col-sm-3">
                                <label for="iNomeSupervisor"><span class="text-danger">*</span> Supervisor do Vendedor</label>
                                <div class="form-group">
                                    @Html.DropDownListFor(model => model.Id_Supervisor, new SelectList(new List<Aniel.Connect.Core.ObjBusca<Int64?>>()), RsBase.SELECIONE, new { @id = "idSupervisor", @class = "form-control", @style = "width: 100%" })
                                </div>
                            </div>

                            <div class="col-sm-3">
                                <label for="iDepartamento"><span class="text-danger">*</span> Departamento</label>
                                <div class="form-group">
                                    @Html.DropDownListFor(model => model.Id_Departamento, new SelectList(new List<Aniel.Connect.Core.ObjBusca<Int64?>>()), RsBase.SELECIONE, new { @id = "iDepartamento", @class = "form-control", @style = "width: 100%" })
                                </div>
                            </div>

                            @if (Aniel.Connect.Core.Helpers.AcessoHelper.TemAcesso(ViewBag.Areas, "153") && Model.IdVenda > 0 && Model.Status_Venda != Status_Venda.Venda_Cancelada && Model.Status_Venda != Status_Venda.Venda_Aprovada)
                            {
                                <div class="col-sm-3">
                                    <input type="button" id="btnAlterarVendedorSupervisor" value="Trocar Vendedor" class="btn btn-outline-secondary" style="margin-top: 10px;margin-bottom: 10px;">
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @*Mudança de Plano*@
        <div class="accordion mt-2">
            <div class="card div-card-accord mt-2">
                <div class="card-header title-card">
                    <h4 class="text-muted" style="font-size:15px">Mudança de Plano</h4>
                </div>
                <div class="card-body body-card-accord">
                    <div class="form-group panel">
                        <div class="row">
                            <div class="col-sm-3">
                                <label for="iPlanoAnteriorSelecionado"> Selecione o Plano a ser trocado:</label>
                                <div class="form-group">
                                    @Html.DropDownListFor(p => p.IdPlanoAnterior, new SelectList(new List<Aniel.Connect.Core.ObjCombo<Int64?>>()), RsBase.SELECIONE, new { @id = "iPlanoAnteriorSelecionado", @class = "form-control" })
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <label for="iPlanoSelecionado"> Selecione o novo Plano:</label>
                                <div class="form-group">
                                    @Html.DropDownListFor(p => p.IdPlanoProduto, new SelectList(new List<Aniel.Connect.Core.ObjCombo<Int64?>>()), RsBase.SELECIONE, new { @id = "iPlanoSelecionado", @class = "form-control" })
                                </div>
                            </div>
                            @if (Model.IdVenda != 0)
                            {
                                <div class="col-sm-3 mt-3">
                                    <div class="col-md-8 d-flex">
                                        <div class="row inherit-width">
                                            <div class="col-2">
                                                <i id="statusTermoAdesao"
                                                   class="fas fa-circle circle-consulta-pendente"></i>
                                            </div>
                                            <div class="col-10">@RsCadastros.TERMO_ADESAO</div>
                                        </div>
                                    </div>
                                    <div class="col-2 d-flex">
                                        <a href="javascript:void(0)"
                                           id="btnEnvioTermo"
                                           class="btn btn-outline-primary btn_Termo">Enviar Termo</a>
                                        <a href="javascript:void(0)"
                                           id="btnReenvioTermo"
                                           class="btn btn-outline-primary btn_Termo d-none">@RsCadastros.REENVIAR_TERMO_ADESAO</a>
                                        <a href="javascript:void(0)"
                                           id="btnVisualizaTermo"
                                           class="btn btn-outline-primary btn_Termo d-none">@RsCadastros.VISUALIZAR_TERMO_ADESAO</a>
                                    </div>
                                </div>
                                if (Model.NecessitaCriarOS && Model.Status == Aniel.Connect.Core.Helpers.HtmlEnumExtensions.GetEnumDescription(Status_Venda.Venda_Aprovada))
                                {
                                    <div class="col-sm-3 mt-3">
                                        <div class="col-md-8 d-inline">
                                            <div class="row inherit-width">
                                                <div class="col-1">
                                                    <i id="statusCriacaoOS"
                                                       class="fas fa-circle circle-consulta-pendente"></i>
                                                </div>
                                                <div class="col-10">Número da OS: <span>@Model.numeroOS</span> </div>
                                            </div>
                                        </div>
                                        @if (String.IsNullOrEmpty(Model.numeroOS))
                                        {
                                            <div class="col-2 d-flex @(Model.EtapaCriacaoOS != StatusEtapaVenda.Pendente ? "d-none":"")">
                                                <a href="javascript:void(0)"
                                                   id="btnCriarOS"
                                                   class="btn btn-outline-primary">@RsCadastros.CRIAR_OS</a>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-2 d-flex">
                                                <a href="javascript:void(0)"
                                                   id="btnVisualizarOS"
                                                   class="btn btn-outline-primary">@RsCadastros.VISUALIZAR_ORDEM_DE_SERVICO</a>
                                            </div>
                                        }
                                    </div>
                                }

                            }
                        </div>

                    </div>
                    <div class="title-card">
                        <div class="row">
                            <div class="col-sm-4">
                                <h5 style="font-size:15px" class="font-weight-bold text-muted">@RsCadastros.DETALHES_DO_PLANO Novo</h5>
                                <hr />
                            </div>
                        </div>
                    </div>
                    <div class="card-body body-card-accord">
                        <div clas="row">
                            <div class="col-sm-4">
                                <div id="iDetalhes"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>
<a href="@Url.Action("Index", "AlteracaoPlanoContrato")" class="float-cancel" onclick="ShowPageLoading(); return true;">
    <div class="text-btn-float-cancel" data - toggle="tooltip" data-placement="left" title="Cancelar">
        <i class="fas fa-times fa-2x"></i>
    </div>
</a>

<a href="#" class="float-save" onclick="return validaSubmit();" name="gravar">
    <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
        <i class="fas fa-save fa-2x"></i>
    </div>
</a>
<div class="overlay" id="divProgress" style="display:none;">
    <div class="preloaderbar show active">
        <span class="bar"></span>
        <span class="text">Processando Consulta ...</span>
    </div>
</div>