                }
            });

            if (_data.ok) {
                Notificar("@RsBase.ATENCAO_", _data.mensagem, "warning");
                return false;
            }

            $("#divprogress").show();
            let comboCliente = $("#iComboCliente").val();
            let comboContrato = $("#iComboContrato").val();
            let parametros = {
                newRecord: true,
                idCliente: comboCliente,
                idContrato: comboContrato,
                idPlano: idPlano,
                id: null,
            };
            const _url = Cadastro(parametros);
            window.location.href = _url;
            //AddAba(_url, "@Html.Raw(RsCadastros.ALTERACAO_PLANO_CONTRATO)");
        } else {
            const texto = $("#iComboContrato").val() == "" || $("#iComboContrato").val() == null || $("#iComboContrato").val() == 0 || $("#iComboContrato").val() == undefined ? "Contrato" : "Plano";
            Notificar("@RsBase.ATENCAO_", `Necessário informar o campo ${texto}, pois está vazio.`, "warning");
