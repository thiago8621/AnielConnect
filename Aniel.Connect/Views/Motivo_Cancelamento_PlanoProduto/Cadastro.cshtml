@model Aniel.Connect.Models.Motivo_Cancelamento_PlanoProdutoCadastroModel

@{

    ViewBag.Title = RsCadastros.CADASTRO_MOTIVO_CANCELAMENTO_CONTRATUAL;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script>

    function validaSubmit() {

            var erro = false;

            if (!$('#iMotivo').val()) {

                Notificar("@RsBase.ATENCAO_", '@RsCadastros.MOTIVO não informado', "warning");
                erro = true;
            }

            if (erro) {

                return;
            }

            $('#form').submit();

        }

/**/</script>
}


@using (Html.BeginForm("Cadastro", "Motivo_Cancelamento_PlanoProduto", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-window-close"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Motivo_Cancelamento_PlanoProduto")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAMOTIVO_CANCELAMENTO_PLANO_PRODUTO</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>



                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">
                                <div class="col-sm-2">

                                    <div class="form-group">
                                        <label for="iMotivo">@RsCadastros.MOTIVO:</label>
                                        @Html.TextBoxFor(model => model.Motivo, new { @class = "form-control", @id = "iMotivo", @autocomplete = "off", @Maxlength = 100 })
                                    </div>

                                </div>

                                <div class="col-sm-2">
                                    @if (Model.Id != 0)
                                    {
                                        <div class="form-group">
                                            <label class="mr-3">@RsFinanceiro.STATUS:</label><br>
                                            @Html.CheckBoxFor(model => model.Status, new { @class = "form-control", @id = "iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    }
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Motivo_Cancelamento_PlanoProduto")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return validaSubmit();" name="gravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>
    </div>
}