@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@model Aniel.Connect.Models.MotivoAusencia_CadastroModel
@{
    ViewBag.Title = RsCadastros.LISTA_MOTIVO_AUSENCIA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@{
    List<AreaModuloModel> _areas = ViewBag.Areas;

}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }

        .classBread {
            margin-bottom: 15px;
        }
    </style>
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")

<script>
    let rows_selected = [];
    var oDatatable;

    function AlterarStatusObj(Status) {
        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/MotivoAusenciaapi/alterarstatus")';

            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    ids: rows_selected,
                    status: Status
                }
            })
            .done(function (data) {

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    rows_selected = [];
                    oDatatable.draw();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });

        rows_selected = [];
    }


        var handleDataTableButtons = function () {

            "use strict";


            //"Blfrtip"
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                stateSave:false,
                processing: true,
                ordering: false,
                destroy: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                autoWidth: false,
                scrollY: '79vh',
                scrollX: true,
                layout: {
                    bottomEnd: {
                        paging: {
                            firstLast: false
                        }
                    }
                },
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/MotivoAusenciaapi/GetAll',
                    type: 'POST',
                    data: function (data) {
                        // Read values
                        let status = $("#iStatusFiltro option:selected").val();
                        data.Status = status;
                        data.Motivo = $("#txtSearch").val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                drawCallback: function () {
                    HidePageLoading();
                },               
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                initComplete: dataTableInitComplete,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "id", title: "@RsCadastros.CODIGO" },
                    { data: "motivo", title: "@RsCadastros.MOTIVO_AUSENCIA" },
                    { data: "status", title: "@RsCadastros.STATUS" },
                ]
            });


            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });

            $("#iPesquisar").unbind("click");
            $("#iPesquisar").on("click", function (e) {
                e.preventDefault();
                $("#modal-filter").modal('hide');
                rows_selected = [];

                if ($.fn.DataTable.isDataTable("#datatable")) {
                    $("#datatable").DataTable().clear().destroy();
                    TableManageButtons.init();
                }
                else {
                    TableManageButtons.init();
                }

                return true;
            });

            $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {
                $("#iStatusFiltro").val("");
                $('#iGrupoAreaFiltro').val(null).trigger('change');
                $('#txtSearch').val("");
               // carregaSelect2();

                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
            });

            $("#btnInativar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);

            });

            $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Ativo
                AlterarStatusObj(1);
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            $('#datatable tbody').on('click', 'tr', function () {

                @if (AcessoHelper.TemAcesso(_areas, "331"))
                {
                    <text>
                    if (oDatatable.row(this).data() != null) {

                        var _id = oDatatable.row(this).data().id;

                        var url = '@Url.Action("Cadastro", "MotivoAusencia", new { id = "__id__" })';
                        window.location.href = url.replace('__id__', _id);
                        ShowPageLoading();
                    }
                    </text>
                }
                else
                {
                    <text>
                    Notificar("@RsBase.ATENCAO_", "Usuário sem acesso", "warning");
                    </text>
                }

            });


            // Handle btn login event
            $('#datatable tbody').on('click', '.btnLogin', function (e) {

                var id = $(this).attr("id_cliente");
                ExibirLogin(id);

                e.stopPropagation();
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                updateDataTableSelectAllCtrl(oDatatable);
            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();
</script>
}
@using (Html.BeginForm("Cadastro", "MotivoAusencia", FormMethod.Post, htmlAttributes: new { enctype = "multipart/form-data", @id = "form" }))
{
    @Html.AntiForgeryToken()
    <html>
    <head>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    </head>
    <body>
        <div class="container-fluid" id="divTitle">
            <!--main-->
            <div class="row">
                <div class="col-auto mr-auto classBread">
                    <h4 class="title-page"><i class="fa-solid fa-person-circle-exclamation"></i> @ViewBag.Title</h4>

                    <nav aria-label="breadcrumb" class="mt-25">
                        <ol class="breadcrumb">
                            @if (AcessoHelper.TemAcesso(_areas, "328"))
                            {
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao", new { Id = Request.Params["Id"] })" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@RsCadastros.LISTA_MOTIVO_AUSENCIA</span>
                                </li>
                            }
                        </ol>
                    </nav>
                </div>

                <div class="col-auto">
                    <div class="row title-page">
                        <div class=" pl-4 pr-2">
                            <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.MOTIVO_AUSENCIA" autocomplete="off">
                            <i class="la la-search la-2x" style="color: #999"></i>
                        </div>
                        @if (AcessoHelper.TemAcesso(_areas, "329"))
                        {
                            <a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "MotivoAusencia", new { Id = Request.Params["Id"]})" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>
                        }

                        <button type="button" class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                        <button type="button" class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                        <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                        </button>

                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                            <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                            @if (AcessoHelper.TemAcesso(_areas, "330"))
                            {
                                <a class="dropdown-item" id="btnInativar" href="#" onclick="return false;">@RsBase.INATIVAR</a>
                                <a class="dropdown-item" id="btnAtivar" href="#" onclick="return false;">@RsBase.ATIVAR</a>
                                @*<a class="dropdown-item" href="@Url.Action("Importacao", "MotivoAusencia")" onclick="ShowPageLoading(); return true;">@RsCadastros.IMPORTAR_AREA</a>
                                <a class="dropdown-item" href="@Url.Action("Historico_Alteracao", "MotivoAusencia")">@RsCadastros.LOG_ALTERACAO_AREA</a>*@
                            }
                        </div>
                    </div>
                </div>
            </div>


            <!--./main-->
            <!--MODAL DE FILTRO-->
            <div class="modal" id="modal-filter">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <div class="form-group">
                                <label for="iStatusFiltro" class="mr-3" style="font-size: 12px"><b>@RsCadastros.STATUS: </b></label><br>
                                <select id="iStatusFiltro" class="form-control">
                                    <option value="">@RsBase.TODOS</option>
                                    <option value="0">@RsCadastros.INATIVO</option>
                                    <option value="1">@RsCadastros.ATIVO</option>
                                </select>
                            </div>

                        </div>
                        <div class="form-group col-sm-12" style="padding: 15px;">
                            <div class="text-center">
                                <button type="button" class="btn btn-danger" id="iLimparFiltroModal"> Limpar Campo</button>
                                <button type="button" class="btn btn-success" id="iPesquisar"> Filtrar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div id="divTable">
            <table class="table table-hover nowrap" id="datatable" style="width:100%">
            </table>
        </div>


    </body>
</html>
}
