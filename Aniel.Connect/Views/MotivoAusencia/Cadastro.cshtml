@model Aniel.Connect.Models.MotivoAusencia_CadastroModel

@{
    /**/

    ViewBag.Title = RsCadastros.CADASTRO_AUSENCIA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
<script>


        var clicked = false;
    function ValidaSubmit() {
        if (clicked) {
            return false;
        }

        clicked = true;

        var erro = false;

        if ($('#iMotivo').val() == "") {
            Notificar("@RsBase.ATENCAO_", "Informe o motivo", "warning");
            erro = true;
        }
        if ($('#iStatus').val() == "") {
            Notificar("@RsBase.ATENCAO_", "Informe o Status", "warning");
            erro = true;
        }

        if (erro) {
            clicked = false;
            return false;
        }
        clicked = true;

        ShowPageLoading();
        $('#form').submit();
    }
</script>
}
<html>
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    @using (Html.BeginForm("Cadastro", "MotivoAusencia", FormMethod.Post, htmlAttributes: new { @id = "form" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.Id)

        <div style="padding:10px">
            <div class="card" style="border:none;">
                <div class="card-body">
                    <div class="row">
                        <div class="col main-title">
                            <h4 class="title-page">
                                <i class="fa-solid fa-person-circle-exclamation"></i> @ViewBag.Title
                            </h4>

                            <nav aria-label="breadcrumb" class="mb-20">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="@Url.Action("Index", "MotivoAusencia")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTA_MOTIVO_AUSENCIA</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <span>@ViewBag.Title</span>
                                    </li>
                                </ol>
                            </nav>

                            @*<span style="font-size:11px" id="dtLegend"></span>*@
                        </div>
                    </div>
                    <div class="card div-card-accord">
                        <div class="card-header title-card" id="heading-1">
                            <h5 class="mb-0">
                                <span class="text-bold-card pt-0">@ViewBag.Title</span>
                            </h5>
                        </div>
                        <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                            <div class="card-body body-card-accord">


                                <div class="row">
                                    <div class="form-group col-sm-2">
                                        <label for="iCodigo" class="mr-3">@RsCadastros.CODIGO:</label><br>
                                        @Html.TextBoxFor(model => model.Id, new { @maxlength = 4, @class = "form-control", @id = "iCodigo", @autocomplete = "off", @readonly = "readonly", @disabled = true })
                                        @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="form-group col-sm-4">
                                        <label for="iD" class="mr-3">@RsCadastros.MOTIVO:<span class="text-danger">* </span></label><br>
                                        @Html.TextBoxFor(model => model.Motivo, new { @class = "form-control", @id = "iMotivo",@placeholder = "Motivo"})
                                        @Html.ValidationMessageFor(model => model.Motivo, "", new { @class = "text-danger" })
                                    </div>
                         @if (Model.Id != 0)
                         {
                                    <div class="form-group col-sm-4">
                                        <div class="form-group">
                                            <div class="form-group">
                                                <label for="iStatus">@RsCadastros.STATUS:</label><br />
                                                @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = RsBase.ATIVAR, @data_off = RsBase.INATIVAR, @data_onstyle = "success", @data_offstyle = "light" })
                                            </div>
                                        </div>
                                    </div>

                         }
                                </div>

                            </div>

                        </div>

                        <!--Button Float-->
                        <!--Button Float-->
                        <a href="@Url.Action("Index", "MotivoAusencia")" class="float-cancel" onclick="ShowPageLoading(); return true;">
                            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                                <i class="fas fa-times fa-2x"></i>
                            </div>
                        </a>

                        <a href="#" onclick="ValidaSubmit();" class="float-save" name="gravar">
                            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                                <i class="fas fa-save fa-2x"></i>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</body>
</html>