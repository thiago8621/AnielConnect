        $("#btnAtualizarAba").click(async () => {

            var date1Ini = new Date(parseInt($("#iDataCriacaoInicioFiltroServicos").val().substring(6, 10)), parseInt($("#iDataCriacaoInicioFiltroServicos").val().substring(3, 5)) - 1, parseInt($("#iDataCriacaoInicioFiltroServicos").val().substring(0, 2)));
            var date2Fim = new Date(parseInt($("#iDataCriacaoFimFiltroServicos").val().substring(6, 10)), parseInt($("#iDataCriacaoFimFiltroServicos").val().substring(3, 5)) - 1, parseInt($("#iDataCriacaoFimFiltroServicos").val().substring(0, 2)));

            const diffTime = Math.abs(date2Fim - date1Ini);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays > 90) {
                Notificar("@RsBase.ATENCAO_", "O período filtrado é maior que 90 dias!", "warning");
                return false;
            }

            if (date1Ini > date2Fim) {
                Notificar("@RsBase.ATENCAO_", "A data final não pode ser menor que a inicial!", "warning");
                return false;
            }

            if ($("#iDataCriacaoInicioFiltroServicos").val() == "" || $("#iDataCriacaoFimFiltroServicos").val() == "") {
                Notificar("@RsBase.ATENCAO_", "Período Inválido!", "warning");
                return false;
            }

            $("#modal-filter-servicos").modal('hide');

            ShowPageLoading();
            await GetServicosSemTecnico();
            await GetServicosSemAgendamento();
            HidePageLoading();
        });

        $("#btnAtualizar,#btnAtualizaTimeline").click(() => {

            var erro = false;

            if ($("#iVisuData").is(":checked")) {
                $("#iDataFinal").val($("#iData").val());
            }

            if (!@Json.Encode(AcessoHelper.TemAcesso(_areas, "134"))) {
                Notificar("@RsBase.ATENCAO_", "Usuário sem acesso à timeline.", "warning");
                erro = true;
            }

            if ($("#iVisuTecnico").is(":checked")) {
                $('#idSupervisor').val(null);
                $('#idMonitor').val(null);
                $('#iGrupoArea').val(null);
                $('#iArea').val(null);
                $('#iLocalidade').val(null);
                $('#iIdNatureza').val(null);

                if ($("#iTecnico").val() == null) {
                    Notificar("@RsBase.ATENCAO_", "Selecione o Técnico!", "warning");
                    erro = true;
                }
            }

            var date1Ini = new Date(parseInt($("#iData").val().substring(6, 10)), parseInt($("#iData").val().substring(3, 5)) - 1, parseInt($("#iData").val().substring(0, 2)));
            var date2Fim = new Date(parseInt($("#iDataFinal").val().substring(6, 10)), parseInt($("#iDataFinal").val().substring(3, 5)) - 1, parseInt($("#iDataFinal").val().substring(0, 2)));

            const diffTime = Math.abs(date2Fim - date1Ini);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays > 31) {
                Notificar("@RsBase.ATENCAO_", "O período filtrado é maior que 31 dias!", "warning");
                erro = true;
            }

            if ($("#iData").val() == "" || $("#iDataFinal").val() == "") {
                Notificar("@RsBase.ATENCAO_", "Período Inválido!", "warning");
                erro = true;
            }

            if (date1Ini > date2Fim) {
                Notificar("@RsBase.ATENCAO_", "A data final não pode ser menor que a inicial!", "warning");
                erro = true;
            }

            if (!erro) {
                ValidaSubmit();

                TagFilter("FiltrosUtilizados", filter_state);
                $('#modal-filter').modal('hide');
            }
        });

