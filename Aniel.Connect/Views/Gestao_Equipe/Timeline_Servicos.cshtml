        const animateCSS = (element, animation, prefix = 'animate__') =>
            // We create a Promise and return it
            new Promise((resolve, reject) => {
                const animationName = `${prefix}${animation}`;
                const node = document.querySelector(element);

                node.classList.add(`${prefix}animated`, animationName);

                // When the animation ends, we clean the classes and resolve the Promise
                function handleAnimationEnd(event) {
                    event.stopPropagation();
                    node.classList.remove(`${prefix}animated`, animationName);
                    node.removeEventListener('animationend', handleAnimationEnd, { once: true });
                    resolve('Animation ended');
                }

                node.addEventListener('animationend', handleAnimationEnd, { once: true });
        });

        function BuscarServico() {

            var texto = $('#textoSearch').val()
            const selector = $(`.vis-item[data-numeroServico^="${texto}/"]`).length > 0 ? `.vis-item[data-numeroServico^="${texto}/"]` : `li[data-numeroos^="${texto}/"]`;
            const selectorSemBarra = $(`.vis-item[data-numeroServico="${texto}"]`).length > 0 ? `.vis-item[data-numeroServico="${texto}"]` : `li[data-numeroos="${texto}"]`;

            if (texto && $(`${selector}`).length > 0) {

                if (selector == `li[data-numeroos^="${texto}/"]`) {
                    $("#iColunaMenu").show();
                }

                for (let item of $(`${selector}`)) {
                    $(item).css("filter", "drop-shadow(-2px 0px 0 black) drop-shadow(2px 0px 0 red) drop-shadow(0px -3px 0 black)drop-shadow(0px 3px 0 black)");
                    $(item).css("animation-iteration-count", "6");
                }

                if ($(`${selector}`)) {
                    document.querySelector(`${selector}`).scrollIntoView({
                        behavior: 'smooth'
                    });
                }


                animateCSS(`${selector}`, 'flash').then((message) => {
                    for (let item of $(`${selector}`)) {
                        $(item).css("filter", "");
                        $(item).css("animation-iteration-count", "");
                    }
                });


            }
            else if (texto && $(`${selectorSemBarra}`).length > 0) {

                if (selectorSemBarra == `li[data-numeroos="${texto}"]`) {
                    $("#iColunaMenu").show();
                }

                for (let item of $(`${selectorSemBarra}`)) {
                    $(item).css("filter", "drop-shadow(-2px 0px 0 black) drop-shadow(2px 0px 0 red) drop-shadow(0px -3px 0 black)drop-shadow(0px 3px 0 black)");
                    $(item).css("animation-iteration-count", "6");
                }

                if ($(`${selectorSemBarra}`)) {
                    document.querySelector(`${selectorSemBarra}`).scrollIntoView({
                        behavior: 'smooth'
                    });
                }


                animateCSS(`${selectorSemBarra}`, 'flash').then((message) => {
                    for (let item of $(`${selectorSemBarra}`)) {
                        $(item).css("filter", "");
                        $(item).css("animation-iteration-count", "");
                    }
                });


            } else {
                Notificar("@RsBase.ATENCAO_", "Serviço não encontrado!", "warning");
            }

        }

