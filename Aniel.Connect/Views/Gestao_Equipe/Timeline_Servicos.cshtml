    $.ajax({
        url: '@String.Concat(CONSTANTES.URLPortal, "/api/Gestao_Equipeapi/GetLegendaTipoServico")',
        type: 'GET',
        dataType: 'json',
        success: function (data) {
            if (data && data.length > 0) {
                let contentHtml = '<ul style="list-style-type: none; padding-left: 0;">';

                data.forEach(item => {
                    contentHtml += `<li><i class='fas fa-circle' style='color: ${item[0].cor}'></i> ${item[0].descricao}</li>`;
                });

                contentHtml += '</ul>';

                $('[data-toggle="popover"]').attr('data-content', contentHtml);
                $('[data-toggle="popover"]').popover('dispose').popover();
            }
        },
        error: function (xhr, status, error) {
            console.error('Erro ao buscar os dados:', error);
        }
    });
}

