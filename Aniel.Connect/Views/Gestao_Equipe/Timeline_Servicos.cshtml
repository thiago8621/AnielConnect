        async function AtualizarServicosGrupo(grupo)
        {
            var FormatoTimeline = null;
            if ($("#iVisuData").is(':checked')) {
                FormatoTimeline = $('#iVisuData').val();
            } else {
                FormatoTimeline = $('#iVisuTecnico').val();
            }

            let novosItems = await GetServicosTecnico(FormatoTimeline == "0" ? $('#iTecnico').val() : grupo);
            var dataCorrente = $('#iData').val();
            var dia = dataCorrente.split("/")[0];
            var mes = dataCorrente.split("/")[1];
            var ano = dataCorrente.split("/")[2];

            dataCorrente = new Date(ano + '-' + mes + '-' + dia);

            dia = dataCorrente.getDate() + 1;
            mes = dataCorrente.getMonth();
            ano = dataCorrente.getFullYear();


            for (let servicosList of novosItems) {


                var start = moment(servicosList.dataHoraIni_String, 'DD/MM/YYYY HH:mm');
                var end = moment(servicosList.dataHoraFim_String, 'DD/MM/YYYY HH:mm');

                const starthoras = start != null ? start._d.getHours() : null;
                const startminutos = start != null ? start._d.getMinutes() : null;
                const startsegundos = start != null ? start._d.getSeconds() : null;
                const endhoras = end != null ? end._d.getHours() : null;
                const endminutos = end != null ? end._d.getMinutes() : null;
                const endsegundos = end != null ? end._d.getSeconds() : null;


                //Bloqueia os horário de hora extra
                if (servicosList.TipoOS == 13) {
                    timeline1.itemsData.add({
                        id: servicosList.num_OS ? servicosList.codCt + "|" + servicosList.projeto + "|" + servicosList.numDoc + "|" + servicosList.num_OS + "|" + grupos.Equipe : null,
                        group: item.group,
                        start: new Date(ano, mes, dia, starthoras, startminutos, startsegundos),
                        end: new Date(ano, mes, dia, endhoras, endminutos, endsegundos),
                        editable: false,
                        className: "hora_extra",
                        type: "background"
                    });
                }

                //Bloqueia os horário que não podem ser agendados
                else if (servicosList.TipoOS == 11) {
                    timeline1.itemsData.add({
                        id: servicosList.num_OS ? servicosList.codCt + "|" + servicosList.projeto + "|" + servicosList.numDoc + "|" + servicosList.num_OS + "|" + grupos.Equipe : null,
                        group: item.group,
                        start: new Date(ano, mes, dia, starthoras, startminutos, startsegundos),
                        end: new Date(ano, mes, dia, endhoras, endminutos, endsegundos),
                        editable: false,
                        type: "background",
                    });
                }

                //Bloqueia os horários que estão como ausente o técnico
                else if (servicosList.TipoOS == 12) {
                    timeline1.itemsData.add({
                        id: servicosList.num_OS ? create_UUID() + "|" + listagem[objIndex].equipe : null,
                        group: grupo,
                        start: new Date(ano, mes, dia, starthoras, startminutos, startsegundos),
                        end: new Date(ano, mes, dia, endhoras, endminutos, endsegundos),
                        content: "<b class='conteudo-ausente-tec'>" + servicosList.prioridade_Legenda + "</b>",
                        className: 'bg-ausente-tecnico',
                        title: servicosList.HtmlTitle,
                        editable: false,
                        type: 'range',
                        limitSize: true,
                        align: 'center',
                    });
                }

                else if (servicosList.TipoOS != 0) {
                    editavel = true;

                    //1) Deslocamento, Reiniciado ou Iniciado, Finalizado, Produtivo ou Improdutivo
                    if (servicosList.TipoOS == 2 || servicosList.TipoOS == 3 ||
                        servicosList.TipoOS == 10 || servicosList.TipoOS == 4 ||
                        servicosList.TipoOS == 5 || servicosList.TipoOS == 6 ||
                        servicosList.TipoOS == 7) {
                        editavel = false;
                    }

                    //verifica o tipo de OS selecionada
                    var classe = servicosList.classeCorServico;

                    let objIndex = listagem.findIndex((obj => obj.codCt == servicosList.codCt &&
                        obj.projeto == servicosList.projeto &&
                        obj.numDoc == servicosList.numDoc &&
                        obj.numOs == servicosList.num_OS));

                    if (objIndex > -1) {
                        listagem[objIndex].itens = servicosList.classeCorServico;
                    }
                    else {
                        listagem.push({
                            numOs: servicosList.num_OS,
                            codCt: servicosList.codCt,
                            projeto: servicosList.projeto,
                            numDoc: servicosList.numDoc,
                            equipe: grupos.Equipe,
                            itens: servicosList.classeCorServico
                        });
                    }

                    /*listagem.push({ numOs: servicosList.num_OS, itens: servicosList.classeCorServico })*/
                    var classeServico = "";

                    classe.forEach(function (classeList) {
                        if (classeList.tipoClasse == "SLA" && ($("#iPrazoSLA").is(':checked'))) {
                            servicosList.classe = classeList.classe;
                        } else if (classeList.tipoClasse == "JANELA" && ($("#iPrazoAtendimento").is(':checked'))) {
                            servicosList.classe = classeList.classe;
                        } else if (classeList.tipoClasse == "STATUS" && ($("#iStatusServico").is(':checked'))) {
                            servicosList.classe = classeList.classe;
                        } else if (classeList.tipoClasse == "TIPOSERV" && ($("#iTipoServico").is(':checked'))) {
                            $('.visutiposerv').css('background-color', classeList.classe);
                            servicosList.classe = "visutiposerv";
                        }
                    });

                    timeline1.itemsData.update({
                        id: servicosList.num_OS ? servicosList.codCt + "|" + servicosList.projeto + "|" + servicosList.numDoc + "|" + servicosList.num_OS + "|" + listagem[objIndex].equipe : null,
                        group: grupo,
                        start: new Date(ano, mes, dia, starthoras, startminutos, startsegundos),
                        end: new Date(ano, mes, dia, endhoras, endminutos, endsegundos),
                        content: "<b class='conteudo'>" + servicosList.prioridade_Legenda + "</b>",
                        className: servicosList.classe,
                        title: servicosList.htmlTitle,
                        codCt: servicosList.codCt,
                        projeto: servicosList.projeto,
                        numDoc: servicosList.numDoc,
                        editable: editavel,
                        type: 'range',
                        limitSize: true,
                        align: 'center',
                    });
                }
            }
        }

    </script>

