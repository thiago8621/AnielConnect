        async function AlterarResponsabilidade(responsabilidade, props) {
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Painel_ServicosApi/AlterarResponsabilidade")';

            let itemTimeline = timeline1.itemsData.get(props);
            var chaveServico = itemTimeline.codCt + "|" +
                itemTimeline.projeto + "|" +
                props.split("|")[3] + "|" +
                itemTimeline.numDoc;

            let data = await $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    ids: [chaveServico],
                    responsabilidade: responsabilidade
                }
            });

            if (data.ok)
            {
                Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
            }
            else {
                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
            }

        }

