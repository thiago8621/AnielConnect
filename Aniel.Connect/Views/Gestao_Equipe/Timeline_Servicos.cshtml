                            @Html.DropDownListFor(model => model.Id_Natureza, new SelectList(ViewBag.Natureza, "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iIdNatureza", @autocomplete = "off" })
                        </div>
                    </div>
                </div>

                <div class="row" style="margin-left:-15px; margin-right:-15px">
                    <div class="col-12 mt-1" id="divGrupoArea">
                        <div class="form-group">
                            <label for="iGrupoArea">@RsCadastros.GRUPO_AREA:</label>
