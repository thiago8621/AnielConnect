                                                        var obj_time_line = timeline1.itemsData.get().filter(x => x.id.includes(itemId));
                                                        //timeline1.itemsData.remove(obj_time_line);
                                                        timeline1.itemsData.update({
                                                            id: servicosList.num_OS ? servicosList.codCt + "|" + servicosList.projeto + "|" + servicosList.numDoc + "|" + servicosList.num_OS + "|" + listagem[objIndex].equipe : null,
                                                            group: item.group,
                                                            start: new Date(ano, mes, dia, starthoras, startminutos, startsegundos),
                                                            end: new Date(ano, mes, dia, endhoras, endminutos, endsegundos),
                                                            content: "<b class='conteudo'>" + servicosList.prioridade_Legenda + "</b>",
                                                            className: servicosList.classe,
                                                            title: servicosList.htmlTitle,
                                                            codCt: servicosList.codCt,
                                                            projeto: servicosList.projeto,
                                                            numDoc: servicosList.numDoc,
                                                            editable: editavel,
                                                            type: 'range',
                                                            limitSize: true,
                                                            align: 'center',
                                                        });
                                                    }
                                                }

                                                $("#divProgress").hide();

                                            }
                                            else {
                                                callback(null);
                                                $("#divProgress").hide();
                                            }
                                        });
                                    }

                                }
                                else {
                                    callback(null);
                                    $("#divProgress").hide();
                                }

                            });
                        }
                    },
                    onAdd: (item, callback) => {
                        if (item.content == 'new item') {
                            callback(null)
                        } else {
                            //emits('onAdd', item);
                            callback(item);
                        }
                    }
                };

                // Cria a timeline e atualiza os parâmetros que adicionamos
                var container = document.getElementById('visualization');
                $("#visualization").empty();
                timeline1 = new vis.Timeline(container, items, groups, options);
                timeline1.range.body.emitter.off('mousewheel');


                //Linha vermelha acompanhando parametro ou não
                var dataHoraCorrente = $('#iDataHoraParametro').val();

                if ($("#iVisuData").is(":checked")) {
                    if (!dataHoraCorrente == '') {
                        var dataCorrente = $('#iData').val();

                        var dia = dataCorrente.split("/")[0];
                        var mes = dataCorrente.split("/")[1];
                        var ano = dataCorrente.split("/")[2];

                        dataCorrente = new Date(ano + '-' + mes + '-' + dia);

                        dia = dataCorrente.getDate() + 1;
                        mes = dataCorrente.getMonth();
                        ano = dataCorrente.getFullYear();

                        var dataPamCorrente = new Date(dataHoraCorrente);

                        var hora = dataPamCorrente.getHours();
                        var min = dataPamCorrente.getMinutes();
                        var segs = dataPamCorrente.getSeconds();

                        var dataValor = new Date(ano, mes, dia, hora, min, segs);
                        timeline1.setCurrentTime(new Date(dataValor));
                    }
                }

                timeline1.on('contextmenu', function (props) {
                    //Busca as informações do item selecionado para saber se é uma OS ou um status
                    if (timeline1.itemsData.get(props.item).className != 'bg-ausente-tecnico'){
                        if (props.item) {
                            $(".custom-menu").finish().toggle(100).

                                // In the right position (the mouse)
                                css({
                                    top: event.pageY + "px",
                                    left: event.pageX + "px"
                                });

                            $("#icustom-menu").attr("data-numItem", props.item)
                            $("#icustom-menu").attr("data-numGroup", props.group)
                            props.event.preventDefault();
                        }
                    }
                });

                timeline1.on('doubleClick', function (props) {

                    if(props.event.type == "doubletap") {
                        return;
                    }

                    const osData = props.item;
                    const numObra = osData.split("|")[3].split('/')[0];
                    const codCt = osData.split("|")[0];
                    const projeto = osData.split("|")[1];
                    const numDoc = osData.split("|")[2];

                    const url = '@Url.Action("Index", "Acompanhamento_Servico")' + "?CodCt=" + codCt + "&Projeto=" + projeto + "&Num_Obra=" + numObra + "&Num_Doc=" + numDoc;
                    AddAba(url, 'Acompanhamento de Serviço');
                    props.event.preventDefault();
                });

                $('[data-toggle="tooltip"]').tooltip()

                HidePageLoading();
                carregandoTimeline = false;
            });


            //HidePageLoading();
        }

