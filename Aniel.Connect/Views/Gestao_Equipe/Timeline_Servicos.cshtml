        <input type="text" class="input-search ml-2" id="textoSearch" placeholder="@RsCadastros.NUMERO_OS" autocomplete="off" style="width:200px;">
        <button type="button" style="background: none !important; border: none; padding: 0 !important; /*optional*/ font-family: arial, sans-serif; /*input has OS specific font-family*/ color: #069; text-decoration: underline; cursor: pointer;" onclick="BuscarServico();"><i class="fas fa-search"></i></button>

        <div class="col" id="divRadioButon" style="justify-content: end; align-items: end;">
            <input type="radio" id="sla" name="rdFormatoVisu" value="SLA" class="radio-button" onclick="alteraClasseTilmeline()">
            <small for="sla">SLA</small>
            <input type="radio" id="janela" name="rdFormatoVisu" value="JANELA" class="radio-button" onclick="alteraClasseTilmeline()">
            <small for="janela">Janela de Atendimento</small>
            <input type="radio" id="status" name="rdFormatoVisu" value="STATUS" class="radio-button" onclick="alteraClasseTilmeline()">
            <small for="status">Status de Serviço</small>
            <input type="radio" id="tiposerv" name="rdFormatoVisu" value="TIPOSERV" class="radio-button" onclick="alteraClasseTilmeline()">
            <small for="tiposerv">Tipo de Serviço</small>
        </div>

    </div>
    <div class="row">
        <div class="col-md-4 col-lg-3 col-sm-12 pr-0 animate__animated animate__fadeIn " id="iColunaMenu" style="display:none;">

            <div class="accordion" id="accordion_1">
                <div class="card shadow div-card-accord">
                    <div class="card-header title-card" id="heading_1">
                        <h5 class="mb-0">
                            <a role="button" data-toggle="collapse" data-target="#collapse_1" aria-expanded="true" aria-controls="collapse_1">
                                <span class="text-bold-card" style="font-size: 13px;">Serviços Agendados Sem Técnicos</span>
                            </a>



                        </h5>
                    </div>
                    <div id="collapse_1" class="collapse show" aria-labelledby="heading_1" data-parent="#accordion_1">
                        <div class="card-body body-card-accord">
                            <ul class="items" id="iListaAgendadosSemTecnicos" style="overflow-y: scroll; max-height: 40rem; list-style-type: none; /* Remove bullets */ padding: 0; /* Remove padding */ margin: 0; /* Remove margins */">
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion mt-3" id="accordion_2">
                <div class="card shadow div-card-accord">
                    <div class="card-header title-card" id="heading_2">
                        <h5 class="mb-0">
                            <a role="button" data-toggle="collapse" data-target="#collapse_2" aria-expanded="true" aria-controls="collapse_2">
                                <span style="font-size: 13px;" class="text-bold-card">Serviços Sem Agendamento</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse_2" class="collapse show" aria-labelledby="heading_2" data-parent="#accordion_2">
                        <div class="card-body body-card-accord">
                            <ul class="items" id="iListaAgendadosSemAgendamento" style="overflow-y: scroll; max-height: 40rem; list-style-type: none; /* Remove bullets */ padding: 0; /* Remove padding */ margin: 0; /* Remove margins */">
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="col pl-0">
            <div id="visualization"></div>
        </div>
    </div>
</body>
</html>

<!--Modal Filters-->
<div class="modal" id="modal-filter" data-backdrop="static" data-keyboard="false">
