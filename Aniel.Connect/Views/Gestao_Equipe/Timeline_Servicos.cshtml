        dateTimeReviver = function (key, value) {
            var a;
            if (typeof value === 'string') {
                a = /\/Date\((\d*)\)\//.exec(value);
                if (a) {
                    return new Date(+a[1]);
                }
            }
            return value;
        }

       function handleDragStart(event) {
            //verifica o tipo de OS selecionada
            var classe = JSON.parse($(event.target).attr("data-classeCorServico"));
            let classeSelecionada;
            let codCt = $(event.target).attr("data-codct");
            let projeto = $(event.target).attr("data-projeto");
            let numDoc = $(event.target).attr("data-numDoc");
            let equipe = $(event.target).attr("data-equipe");

            let objIndex = listagem.findIndex((obj => obj.codCt == codCt &&
                obj.projeto == projeto &&
                obj.numDoc == numDoc &&
                obj.numOs == $(event.target).attr("data-numeroOS")));

            if (objIndex > -1) {
                listagem[objIndex].itens = JSON.parse($(event.target).attr("data-classeCorServico"));
            }
            else {
                listagem.push({
                    numOs: $(event.target).attr("data-numeroOS"),
                    codCt: codCt,
                    projeto: projeto,
                    numDoc: numDoc,
                    equipe: equipe,
                    itens: JSON.parse($(event.target).attr("data-classeCorServico"))
                });
            }

           let backgroundColor = "";
            classe.forEach(function (classeList) {
                if (classeList.tipoClasse == "SLA" && ($("#iPrazoSLA").is(':checked'))) {
                    classeSelecionada = classeList.classe;
                } else if (classeList.tipoClasse == "JANELA" && ($("#iPrazoAtendimento").is(':checked'))) {
                    classeSelecionada = classeList.classe;
                } else if (classeList.tipoClasse == "STATUS" && ($("#iStatusServico").is(':checked'))) {
                    classeSelecionada = classeList.classe;
                } else if (classeList.tipoClasse == "TIPOSERV" && ($("#iTipoServico").is(':checked'))) {
                    backgroundColor = classeList.classe;
                    classeSelecionada = "visutiposerv";
                }
            });



           let luminance = backgroundColor ? getLuminance(backgroundColor) : "";
           let textColor = luminance && luminance > 128 ? 'black' : 'white';

            event.dataTransfer.effectAllowed = 'move';
            var item = {
                id: codCt + "|" + projeto + "|" + numDoc + "|" + $(event.target).attr("data-numeroOS"),
                type: "range",
                codCt: codCt,
                projeto: projeto,
                numDoc: numDoc,
                numOs: $(event.target).attr("data-numeroOS"),
                editable: true,
                title: $(event.target).attr("data-title"),
                content: "<b></b>",
                className: classeSelecionada,
                style: backgroundColor ? `background-color: ${backgroundColor}; color: ${textColor}; border-color: grey; border-radius: 5px; height: auto;` : ""
            };

            if (event.target. getAttribute('data-listener') !== 'true') {
               event.target.addEventListener('dragend', handleDragEnd.bind(this));
               event.target.setAttribute('data-listener', 'true');
            }
            event.dataTransfer.setData("text", JSON.stringify(item));

        }

        function retornoHora(data) {
            const date = data._d != undefined && data._d != null ? data._d : data;

            return date.toLocaleTimeString([], {
                hour: '2-digit',
                minute: '2-digit',
                hour12: false, // usa formato 24h
            });
        }

