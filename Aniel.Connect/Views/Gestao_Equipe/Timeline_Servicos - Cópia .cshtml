                                        <p class="spanTecnico">@Model.Equipes[i].Nome_Equipe</p>
                                        <div class="spanEquipe d-none">@Model.Equipes[i].Equipe</div>

                                        @if (!String.IsNullOrEmpty(Model.Equipes[i].Justificativa))
                                        {
                                            <p class="spanDetalheTecnico" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-html="true" title="<div style='font-size:10px'>@RsCadastros.JUSTIFICATIVA: @Model.Equipes[i].Justificativa</div>">@Model.Equipes[i].Detalhe_Equipe</p>
                                        }
                                        else
                                        {
                                            <p class="spanDetalheTecnico">@Model.Equipes[i].Detalhe_Equipe</p>
                                        }
                                    </th>
                                    <td colspan="23">
                                        <div class="progress">

                                            @if (Model.Equipes[i] != null && Model.Equipes[i].Servicos != null)
                                            {
                                                for (var y = 0; y < Model.Equipes[i].Servicos.Count(); y++)
                                                {
                                                    
                                                        <div class="progress-bar badge badge-pill @Model.Equipes[i].Servicos[y].ClasseCorServico" role="progressbar" style="width: @Model.Equipes[i].Servicos[y].Pixels" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-html="true" title="@Model.Equipes[i].Servicos[y].HtmlTitle">
                                                        </div>
                                                    
                                                }
                                            }
                                            <!--
                                            <div class="progress-bar bg-serv-prev" role="progressbar" style="width: 60px" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-html="true" title="Serviço Previsto"></div>
                                            <div class="progress-bar bg-tec-desloc" role="progressbar" style="width: 60px" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-html="true" title="Técnico em Deslocamento"></div>
                                            <div class="progress-bar bg-serv-inic" role="progressbar" style="width: 60px" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-html="true" title="Serviço Iniciado"></div>
                                            <div class="progress-bar bg-serv-baixo-prod" role="progressbar" style="width: 60px" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-html="true" title="Serviço Baixado no Prazo Produtivo"></div>
                                            <div class="progress-bar bg-serv-baixa-improd" role="progressbar" style="width: 60px" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-html="true" title="Serviço Baixado no Prazo Improdutivo"></div>
                                            <div class="progress-bar bg-serv-baixa-fora-prod " role="progressbar" style="width: 60px" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-html="true" title="Serviço Baixado Fora do Prazo Produtivo"></div>
                                            <div class="progress-bar bg-serv-baixa-fora-improd" role="progressbar" style="width: 60px" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-html="true" title="Serviço Baixado Fora do Prazo Improdutivo"></div>
                                            <div class="progress-bar bg-serv-atrasado" role="progressbar" style="width: 60px" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-html="true" title="Serviço Atrasado"></div>
                                            <div class="progress-bar bg-serv-paralisado" role="progressbar" style="width: 60px" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-html="true" title="Paralisado"></div>
                                            <div class="progress-bar bg-tec-ausente" role="progressbar" style="width: 60px" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-html="true" title="Técnico Ausente"></div>
                                            -->
                                        </div>
                                    </td>
                                </tr>
                            }


                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }


    <!--Modal Filters-->
    <div class="modal" id="modal-filter">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                    @*<button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>*@
                </div>
                <div class="modal-body">

                    <div class="row">
                        <div class="col-12 mt-1 text-left">
                            <div class="form-group">
                                <label for="exampleFormControlSelect1">Data de Agendamento:</label>
                                <center>
                                    @Html.TextBoxFor(m => m.Data, new { @class = "form-control datepicker", @style = "background: #fff;color: #000", @data_provide = "datepicker", @id = "iData", @autocomplete = "off", @required = true })
                                    a
                                    @Html.TextBoxFor(m => m.DataFinal, new { @class = "form-control datepicker", @style = "background: #fff;color: #000", @data_provide = "datepicker", @id = "iDataFinal", @autocomplete = "off", @required = false })
                                </center>
                            </div>
                        </div>

                        <div class="col-12 mt-1 text-left">
                            <div class="form-group">
                                <label for="exampleFormControlSelect2">Visualizar por:</label><br />
                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.TipoVisualizacao, "0", new { @id = "iPrazoServico" })
                                    <label class="form-check-label" for="iPrazoServico"> Prazo Execução</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.TipoVisualizacao, "1", new { @id = "iStatusServico" })
                                    <label class="form-check-label" for="iStatusServico"> Status Serviço</label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-12 mt-1 text-left" style="display: block" id="divPrazo">
                            <div class="form-group">
                                <label for="exampleFormControlSelect2">Prazo por:</label><br />
                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.Prazo, "0", new { @id = "iPrazoSLA" })
                                    <label class="form-check-label" for="iPrazoSLA"> SLA</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.Prazo, "1", new { @id = "iPrazoAtendimento" })
                                    <label class="form-check-label" for="iPrazoAtendimento"> Janela de Atendimento</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 text-left">
                            <div class="form-group">
                                <label for="exampleFormControlSelect3">Equipes por:</label><br/>
                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.TipoFiltro, "0", new { @id = "iSupervisor" })
                                    <label class="form-check-label" for="iSupervisor"> Supervisor de Técnico</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.TipoFiltro, "1", new { @id = "iMonitor" })
                                    <label class="form-check-label" for="iMonitor"> Monitor de Técnico</label>
                                </div>
                            </div>
                        </div>


                        <div class="col-12 mb-2 text-center">
                            <div class="form-group" id="divSupervisor">
                                @Html.DropDownListFor(model => model.Num_Fre_Supervisor, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), new { @class = "form-control text-center", @id = "idSupervisor" })
                            </div>
                            <div class="form-group" id="divMonitor">
                                @Html.DropDownListFor(model => model.Id_Monitor, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), new { @class = "form-control text-center", @id = "idMonitor" })
                            </div>
                        </div>

                        <div class="col-12 mt-1">
                            <div class="mt-1 form-group">
                                <label for="iVendedor">@RsCadastros.HABILIDADE_TECNICA</label>
                                @Html.DropDownListFor(model => model.Id_Natureza, new SelectList(ViewBag.Natureza, "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iIdNatureza", @autocomplete = "off" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mt-1">
                            <div class="form-group">
                                <label for="iAno">@RsCadastros.GRUPO_AREA:</label>
                                @Html.DropDownListFor(model => model.Cod_Escritorio, new SelectList(ViewBag.GruposArea, "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iGrupoArea" })
                            </div>
                        </div>
                        <div class="col-12 mt-1">
                            <div class="form-group">
                                <label for="iAno">@RsCadastros.AREA:</label>
                                @Html.DropDownListFor(model => model.Cod_Area, new SelectList(ViewBag.Areas), RsBase.SELECIONE, new { @class = "form-control", @id = "iArea" })
                            </div>
                        </div>
                        <div class="col-12  mt-1">
                            <div class="form-group">
                                <label for="iAno">@RsCadastros.LOCALIDADE:</label>
                                @Html.DropDownListFor(model => model.Cod_Localidade, new SelectList(ViewBag.Localidades), RsBase.SELECIONE, new { @class = "form-control", @id = "iLocalidade" })
                            </div>
                        </div>

                        <div class="col-12 text-center">
                            <div class="mt-2 mb-2" style="">
                                <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                                <button class="btn btn-success pl-2 pr-2" type="submit" id="btnAtualizar" title="Aplicar" onclick="ShowPageLoading();">
                                    @RsCadastros.APLICAR
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal-->


}