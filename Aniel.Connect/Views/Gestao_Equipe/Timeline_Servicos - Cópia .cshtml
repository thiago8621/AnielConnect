@model Aniel.Connect.Models.Timeline_ServicosModels

@{
    ViewBag.Title = RsCadastros.TIMELINE_SERVICOS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    <link href="~/Content/tableTimeLine.css" rel="stylesheet" />
    <style>


        .bg-fora-agendamento {
            background-color: #8080803d;
            border-radius: 0 !important;
        }

        .tooltip-inner {
            max-width: 200px;
            padding: 3px 8px;
            color: #000;
            text-align: center;
            background-color: #fff;
            border-radius: .25rem;
            border: 1px solid #000;
        }

        .tooltip.bs-tooltip-auto[x-placement^=top] .arrow::before, .tooltip.bs-tooltip-top .arrow::before {
            margin-left: -3px;
            content: "";
            border-width: 5px 5px 0;
            border-top-color: #000;
        }

        .tooltip.bs-tooltip-auto[x-placement^=right] .arrow::before, .tooltip.bs-tooltip-right .arrow::before {
            margin-top: -3px;
            content: "";
            border-width: 5px 5px 5px 0;
            border-right-color: #000;
        }

        .tooltip.bs-tooltip-auto[x-placement^=bottom] .arrow::before, .tooltip.bs-tooltip-bottom .arrow::before {
            margin-left: -3px;
            content: "";
            border-width: 0 5px 5px;
            border-bottom-color: #000;
        }

        .tooltip.bs-tooltip-auto[x-placement^=left] .arrow::before, .tooltip.bs-tooltip-left .arrow::before {
            right: 0;
            margin-top: -3px;
            content: "";
            border-width: 5px 0 5px 5px;
            border-left-color: #000;
        }

        .spanTecnico {
            margin-bottom: 0px;
        }

        .spanDetalheTecnico {
            margin-bottom: 0px;
            font-size: 10px;
            color: #ffd800
        }

        .container_table {
            overflow: hidden;
        }

        .frozen {
            width: 100%;
            height: 100%;
            overflow: scroll;
            position: relative;
        }

        table thead th {
            position: sticky;
            top: 0;
            background: #fff;
            color: #000;
            white-space: nowrap;
            border-right: 1px solid #ddd;
            text-align: center;
        }

        table thead th:first-child {
            left: 0;
            z-index: 1;
        }

        .popover {
            max-width: 300px !important;
        }

    </style>
}

@section scripts
{
    <script>

        $(document).ready(function () {

            HandleSupervMonitor();
            $('#iSupervisor').trigger('change');

            var areaInicial = "@( Model.Cod_Area )";
            var localidadeInicial = "@( Model.Cod_Localidade )";

            var grupo_area = $('#iGrupoArea option:selected').val();
            var enderecoApi = "@CONSTANTES.URLPortal/api/Areaapi/GetList?grupo_area=" + grupo_area;

            $('#iArea').empty();
            $('#iLocalidade').empty();

            $.ajax({
                url: enderecoApi,
                type: 'GET',
                dataType: 'json'
            })
            .done(function (data) {

                $('#iArea').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                    $.each(data.objeto, function (key, value) {
                    $('#iArea').append($('<option></option>').attr('value', value.value).text(value.label));
                });

                var grupo_area = $('#iGrupoArea option:selected').val();
                var area = $('#iArea option:selected').val();

                var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

                $('#iLocalidade').empty();

                $.getJSON(enderecoApi, function (data) {
                    $('#iLocalidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                    $.each(data.objeto, function (key, value) {
                        $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));
                    });

                    if (areaInicial) {

                        $("#iArea").val(areaInicial);

                        var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + areaInicial;

                        $('#iLocalidade').empty();

                        $.getJSON(enderecoApi, function (data) {
                            $('#iLocalidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                            $.each(data.objeto, function (key, value) {
                                 $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));
                            });

                            $("#iLocalidade").val(localidadeInicial);
                        });
                    }
                });

            })
            .fail(function () {
                console.log("error");
            })
            .always(function () {
                try {
                    parent.App.stopPageLoading();
                }
                catch (ex) { console.log(ex); }

                });


        });

        AddSelect("idMonitor", "@CONSTANTES.URLPortal/api/IdentityUserApi/GetComboMonitor", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Monitor", "@RsBase.SELECIONE", false);
        AddSelect("idSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Num_Fre_Supervisor", "@RsBase.SELECIONE", false);

        var HandleSupervMonitor = function () {
            $('#iSupervisor, #iMonitor').change(function () {
                if ($("#iSupervisor").is(":checked")) {
                    $("#divSupervisor").show();
                    $("#divMonitor").hide();
                    $("#idMonitor").val("").trigger("change");
                }
                else {
                    $("#divSupervisor").hide();
                    $("#divMonitor").show();

                    $("#idSupervisor").val("").trigger("change");
                }
            });
        }

       function carregaSelect2(){
            AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
            AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("idMonitor", "@CONSTANTES.URLPortal/api/IdentityUserApi/GetComboMonitor", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Monitor", "@RsBase.SELECIONE", false);
            AddSelect("idSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Num_Fre_Supervisor", "@RsBase.SELECIONE", false);
       }

        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {
            $('#iGrupoArea').val(null).trigger('change')
            $('#iArea').val(null).trigger('change')
            $('#iLocalidade').val(null).trigger('change')
            $('#idMonitor').val(null).trigger('change')
            $('#idSupervisor').val(null).trigger('change')
            $('#iIdNatureza').val(null).trigger('change')
            carregaSelect2()
        })

        $(document).ready(async () => {
            $('#modal-filter').modal('show')
            carregaSelect2()
        });

        $("#btnAtualizar").click(() => {

            var dataInicio = $('#iData').val();
            var dataFinal = $('#iDataFinal').val();
            $("#lbDataFiltro").html('Data de Agendamento: ' + dataInicio + " a " + dataFinal);

            if ($("#iStatusServico").is(":checked")) {
                $("#lbAgrupadoPor").html('Filtrado por: @Html.Raw("Status de Serviço")');
            } else {
                if ($("#iPrazoSLA").is(":checked")) {
                   $("#lbAgrupadoPor").html('Filtrado por: @Html.Raw("Prazo de SLA")');
                } else if ($("#iPrazoAtendimento").is(":checked")) {
                   $("#lbAgrupadoPor").html('Filtrado por: @Html.Raw("Prazo de Atendimento")');
                }
            }
        });

        $('#iPrazoServico').change(function () {
            if ($("#iPrazoServico").is(":checked")) {
                $("#divPrazo").show();
            }
        });

        $('#iStatusServico').change(function () {
            if ($("#iStatusServico").is(":checked")) {
                $("#divPrazo").hide();
                $("#divLegendaExecucaoSLA").hide();
                $("#divLegendaExecucaoAgendamento").hide();
                $("#divLegendaStatusServico").show();
            }
        });


        //LEGENDA DINÂMICA
        $('#iPrazoSLA').change(function () {
            if ($("#iPrazoSLA").is(":checked")) {
                $("#divLegendaExecucaoSLA").show();
                $("#divLegendaExecucaoAgendamento").hide();
                $("#divLegendaStatusServico").hide();
            }
        });
        $('#iPrazoAtendimento').change(function () {
            if ($("#iPrazoAtendimento").is(":checked")) {
                $("#divLegendaExecucaoAgendamento").show();
                $("#divLegendaExecucaoSLA").hide();
                $("#divLegendaStatusServico").hide();
            }
        });

        $('#iGrupoArea').change(function () {

            var grupo_area = $('#iGrupoArea option:selected').val();
            var enderecoApi = "@CONSTANTES.URLPortal/api/Areaapi/GetList?grupo_area=" + grupo_area;

            $('#iArea').empty();
            $('#iLocalidade').empty();

            $.ajax({
                url: enderecoApi,
                type: 'GET',
                dataType: 'json'
            })
            .done(function (data) {

                $('#iArea').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                    $.each(data.objeto, function (key, value) {
                    $('#iArea').append($('<option></option>').attr('value', value.value).text(value.label));
                });

                var grupo_area = $('#iGrupoArea option:selected').val();
                var area = $('#iArea option:selected').val();

                var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

                $('#iLocalidade').empty();

                $.getJSON(enderecoApi, function (data) {
                    $('#iLocalidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                    $.each(data.objeto, function (key, value) {
                        $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));
                    });

                });

            })
            .fail(function () {
                console.log("error");
            })
            .always(function () {
                try {
                    parent.App.stopPageLoading();
                }
                catch (ex) { console.log(ex); }

                });

        });


        $('#iArea').change(function () {

            var grupo_area = $('#iGrupoArea option:selected').val();
            var area = $('#iArea option:selected').val();

            var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

            $('#iLocalidade').empty();

            $.getJSON(enderecoApi, function (data) {
                $('#iLocalidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                $.each(data.objeto, function (key, value) {
                        $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));
                });

            });


        });

        //Filtro Nome ou Matrícula
        function filterTable() {

            var input, filter, tbody, tr, td, td2, i, txtValue;
            input = document.getElementById("txtSearch");
            filter = input.value.toUpperCase();
            tbody = document.getElementById("iTbodyTecnicos");
            tr = tbody.getElementsByTagName("tr");

            for (i = 0; i < tr.length; i++) {
                td = tr[i].getElementsByClassName("spanTecnico")[0]
                td2 = tr[i].getElementsByClassName("spanEquipe")[0]

                if (td || td2) {
                    txtValue = td.textContent || td.innerText;
                    txtValue2 = td2.textContent || td2.innerText;

                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    }
                    else if (txtValue2.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
                //if (td2) {
                //    txtValue2 = td2.textContent || td2.innerText;
                //    if (txtValue2.toUpperCase().indexOf(filter) > -1) {
                //        tr[i].style.display = "";
                //    } else {
                //        tr[i].style.display = "none";
                //    }
                //}
            }

        }


    </script>
}

