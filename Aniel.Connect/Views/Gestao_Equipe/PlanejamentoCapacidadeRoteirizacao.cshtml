            function GetCapacidadeDisponivel(listaFunc, servicos, habilidades, priorizarInstalacaoReparo, formatoDemanda) {

                let demanda = GetDemanda(servicos, habilidades, formatoDemanda);
                let servAgendados = GetServAgendados(servicos, habilidades, formatoDemanda);
                let capacidade = GetCapacidade(listaFunc, priorizarInstalacaoReparo, formatoDemanda, servicos);
                let roteirizados = GetRoteirizados(servicos, habilidades, formatoDemanda)


                if (habilidades.includes(0) && habilidades.includes(1)) {
                    capacidade = capacidade.tipoHabilidade2
                }
                else if (habilidades.includes(0)) {
                    capacidade = capacidade.tipoHabilidade0
                }
                else if (habilidades.includes(1)) {
                    capacidade = capacidade.tipoHabilidade1
                }

                let capacidadeDisponivel = capacidade - servAgendados - demanda - roteirizados;

                return Math.round(capacidadeDisponivel);
            }

            function GetCapacidadeDisponivelDisplay(listaFunc, servicos, habilidades, priorizarInstalacaoReparo, formatoDemanda) {

                let resultado = GetCapacidadeDisponivel(listaFunc, servicos, habilidades, priorizarInstalacaoReparo, formatoDemanda);

                if (formatoDemanda == "horas") {
                    return MinutosParaTempo(resultado);
                }
                else {
                    return resultado;
                }
            }

            function GetMaoObra(listaFunc, servicos, habilidades, priorizarInstalacaoReparo, formatoDemanda) {
                let resultado = GetCapacidadeDisponivel(listaFunc, servicos, habilidades, priorizarInstalacaoReparo, formatoDemanda);
                let qtdeTecnicosTipoHabilidade0 = 0;
                let qtdeTecnicosTipoHabilidade1 = 0;
                let qtdeTecnicosTipoHabilidade2 = 0;
                let objCapacidade = GetCapacidade(listaFunc, priorizarInstalacaoReparo, formatoDemanda, servicos);

                if (formatoDemanda == "servicos")
                {
                    qtdeTecnicosTipoHabilidade0 = listaFunc.filter(p => p.tipoHabilidade == 0 && p.escalado === true).length + (priorizarInstalacaoReparo == 0 ? listaFunc.filter(p => p.tipoHabilidade == 2 && p.escalado === true).length : 0);
                    qtdeTecnicosTipoHabilidade1 = listaFunc.filter(p => p.tipoHabilidade == 1 && p.escalado === true).length + (priorizarInstalacaoReparo == 1 ? listaFunc.filter(p => p.tipoHabilidade == 2 && p.escalado === true).length : 0)
                    qtdeTecnicosTipoHabilidade2 = qtdeTecnicosTipoHabilidade0 + qtdeTecnicosTipoHabilidade1;

                    let capacidadeUsada = 0;
                    let qtdeTecnicosUsada = 0;

                    if (habilidades.includes(0) && habilidades.includes(1)) {
                        capacidadeUsada = objCapacidade.tipoHabilidade2;
                        qtdeTecnicosUsada = qtdeTecnicosTipoHabilidade2;
                    }
                    else if (habilidades.includes(0)) {
                        capacidadeUsada = objCapacidade.tipoHabilidade0;
                        qtdeTecnicosUsada = qtdeTecnicosTipoHabilidade0;
                    }
                    else if (habilidades.includes(1)) {
                        capacidadeUsada = objCapacidade.tipoHabilidade1;
                        qtdeTecnicosUsada = qtdeTecnicosTipoHabilidade1;
                    }

                    if (qtdeTecnicosUsada > 0) {
                        return resultado == 0 ? 0 : (resultado / (capacidadeUsada / qtdeTecnicosUsada)).toFixed(1);
                    }
                    else {
                        return resultado == 0 ? 0 : (resultado / (dados.minutosHorarioTrabalhoPadrao / GetTempoMedio(servicos, habilidades))).toFixed(1);
                    }
                }
                else {
                    qtdeTecnicosTipoHabilidade0 = listaFunc.filter(p => p.tipoHabilidade == 0 && p.escalado === true).length + (priorizarInstalacaoReparo == 0 ? listaFunc.filter(p => p.tipoHabilidade == 2 && p.escalado === true).length : 0);
                    qtdeTecnicosTipoHabilidade1 = listaFunc.filter(p => p.tipoHabilidade == 1 && p.escalado === true).length + (priorizarInstalacaoReparo == 1 ? listaFunc.filter(p => p.tipoHabilidade == 2 && p.escalado === true).length : 0)
                    qtdeTecnicosTipoHabilidade2 = qtdeTecnicosTipoHabilidade0 + qtdeTecnicosTipoHabilidade1;

                    let capacidadeUsada = 0;
                    let qtdeTecnicosUsada = 0;

                    if (habilidades.includes(0) && habilidades.includes(1)) {
                        capacidadeUsada = objCapacidade.tipoHabilidade2;
                        qtdeTecnicosUsada = qtdeTecnicosTipoHabilidade2;
                    }
                    else if (habilidades.includes(0)) {
                        capacidadeUsada = objCapacidade.tipoHabilidade0;
                        qtdeTecnicosUsada = qtdeTecnicosTipoHabilidade0;
                    }
                    else if (habilidades.includes(1)) {
                        capacidadeUsada = objCapacidade.tipoHabilidade1;
                        qtdeTecnicosUsada = qtdeTecnicosTipoHabilidade1;
                    }

                    if (qtdeTecnicosUsada > 0) {
                        return resultado == 0 ? 0 : (resultado / (capacidadeUsada / qtdeTecnicosUsada)).toFixed(1);
                    }
                    else
                    {
                        return resultado == 0 ? 0 : (resultado / dados.minutosHorarioTrabalhoPadrao).toFixed(1);
                    }
                }
            }

            function GetStatus(listaFunc, servicos, habilidades, priorizarInstalacaoReparo) {

                let capacidadeDisponivel = GetCapacidadeDisponivel(listaFunc, servicos, habilidades, priorizarInstalacaoReparo, formatoDemanda);

                if (capacidadeDisponivel > 0)
                    return `Sobrando`
                else if (capacidadeDisponivel < 0) {
                    return `Faltando`
                }
                else if (capacidadeDisponivel == 0) {
                    return `Adequado`
                }

            }

            function GetTempoMedio(servicos,habilidades)
            {
                let listaFiltrada = servicos.filter(p => habilidades.includes(p.tipoHabilidade)).map(p => p.tempoExecucaoMinutos);

                if (listaFiltrada.length > 0) {
                    let soma = listaFiltrada.reduce(somar, 0);
                    let media = soma / listaFiltrada.length;
                    return Math.round(media);
                }
                else {
                    return @ViewBag.TempoExecucaoPadrao;
                }
            }

            function GetTempoMedioDisplay(servicos, habilidades) {
                return MinutosParaTempo(GetTempoMedio(servicos, habilidades));
            }

            function GetDemanda(servicos, habilidades, formatoDemanda) {

                if (formatoDemanda == "servicos")
                {
                    let listaFiltrada = servicos.filter(p => habilidades.includes(p.tipoHabilidade) && ((p.equipe && p.dataMaximaStr == $('#iDataInicio').val()) == false) && p.dataMaximaStr != $('#iDataInicio').val());
                    if (listaFiltrada.length > 0) {
                        return listaFiltrada.length
                    }
                    else {
                        return 0;
                    }
                }
                else
                {
                    if (formatoDemanda == "horas") {
                        let listaFiltrada = servicos.filter(p => habilidades.includes(p.tipoHabilidade) && ((p.equipe && p.dataMaximaStr == $('#iDataInicio').val()) == false) && p.dataMaximaStr != $('#iDataInicio').val());
                        if (listaFiltrada.length > 0) {
                            let soma = listaFiltrada.map(p => p.tempoExecucaoMinutos).reduce(somar, 0);
                            return soma;
                        }
                        else {
                            return 0;
                        }
                    }
                }
            }

            function GetServAgendados(servicos, habilidades, formatoDemanda) {

                if (formatoDemanda == "servicos") {
                    let listaFiltrada = servicos.filter(p => habilidades.includes(p.tipoHabilidade) && p.dataMaximaStr == $('#iDataInicio').val() && !p.equipe);
                    if (listaFiltrada.length > 0) {
                        return listaFiltrada.length
                    }
                    else {
                        return 0;
                    }
                }
                else {
                    if (formatoDemanda == "horas") {
                        let listaFiltrada = servicos.filter(p => habilidades.includes(p.tipoHabilidade) && p.dataMaximaStr == $('#iDataInicio').val() && !p.equipe);
                        if (listaFiltrada.length > 0) {
                            let soma = Math.round(listaFiltrada.map(p => p.tempoExecucaoMinutos).reduce(somar, 0));
                            return soma;
                        }
                        else {
                            return 0;
                        }
                    }
                }
            }

            function GetServAgendadosDisplay(servicos, habilidades, formatoDemanda) {
                let resultado = GetServAgendados(servicos, habilidades, formatoDemanda)
                if (formatoDemanda == "servicos") {
                    return resultado;
                }
                else {
                    return MinutosParaTempo(resultado);
                }
            }

            function GetDemandaDisplay(servicos, habilidades, formatoDemanda) {
                let resultado = GetDemanda(servicos, habilidades, formatoDemanda)
                if (formatoDemanda == "servicos") {
                    return resultado;
                }
                else {
                    return MinutosParaTempo(resultado);
                }
            }

            function GetRoteirizados(servicos, habilidades, formatoDemanda) {
                let listaFiltrada = servicos.filter(p => habilidades.includes(p.tipoHabilidade));

                if (formatoDemanda == "servicos") {
                    if (listaFiltrada.length > 0) {
                        return listaFiltrada.filter(p => p.equipe && p.dataMaximaStr == $('#iDataInicio').val()).length;
                    }
                    else {
                        return 0;
                    }
                }
                else {
                    if (formatoDemanda == "horas") {
                        let listaFiltrada = servicos.filter(p => habilidades.includes(p.tipoHabilidade) && p.equipe && p.dataMaximaStr == $('#iDataInicio').val());
                        if (listaFiltrada.length > 0) {
                            listaFiltrada = listaFiltrada.map(p => p.tempoExecucaoMinutos);
                            let soma = Math.round(listaFiltrada.reduce(somar, 0));
                            return soma;
                        }
                        else {
                            return 0;
                        }
                    }
                }
            }

            function GetRoteirizadosDisplay(servicos, habilidades, formatoDemanda)
            {
                let resultado = GetRoteirizados(servicos, habilidades, formatoDemanda);
                if (formatoDemanda == "horas") {
                    return MinutosParaTempo(resultado);
                }
                else {
                    return resultado;
                }
            }

            function GetCapacidade(listaFunc, priorizarInstalacaoReparo, formatoDemanda, servicosGrupo) {

                if (formatoDemanda == "servicos") {


                    let objCapacidade = {
                        tipoHabilidade0: listaFunc.filter(p => p.tipoHabilidade == 0 && p.escalado === true).map(p => p.horasTrabalhadasHorario).concat(priorizarInstalacaoReparo == 0 ? listaFunc.filter(p => p.tipoHabilidade == 2 && p.escalado === true).map(p => p.horasTrabalhadasHorario) : 0),
                        tipoHabilidade1: listaFunc.filter(p => p.tipoHabilidade == 1 && p.escalado === true).map(p => p.horasTrabalhadasHorario).concat(priorizarInstalacaoReparo == 1 ? listaFunc.filter(p => p.tipoHabilidade == 2 && p.escalado === true).map(p => p.horasTrabalhadasHorario) : 0),
                    };

                    let tempoMedioHabilidade0 = GetTempoMedio(servicosGrupo, [0]);
                    let tempoMedioHabilidade1 = GetTempoMedio(servicosGrupo, [1]);
                    let tempoMedioHabilidade2 = GetTempoMedio(servicosGrupo, [0, 1]);

                    objCapacidade.tipoHabilidade2 = Math.round((objCapacidade.tipoHabilidade0.reduce(somar, 0) + objCapacidade.tipoHabilidade1.reduce(somar, 0)) / tempoMedioHabilidade2);
                    objCapacidade.tipoHabilidade0 = Math.round(objCapacidade.tipoHabilidade0.reduce(somar, 0) / tempoMedioHabilidade0);
                    objCapacidade.tipoHabilidade1 = Math.round(objCapacidade.tipoHabilidade1.reduce(somar, 0) / tempoMedioHabilidade1);


                    return objCapacidade;
                }
                else
                {
                    let objCapacidade = {
                        tipoHabilidade0: listaFunc.filter(p => p.tipoHabilidade == 0 && p.escalado === true).map(p => p.horasTrabalhadasHorario).concat(priorizarInstalacaoReparo == 0 ? listaFunc.filter(p => p.tipoHabilidade == 2 && p.escalado === true).map(p => p.horasTrabalhadasHorario) : 0),
                        tipoHabilidade1: listaFunc.filter(p => p.tipoHabilidade == 1 && p.escalado === true).map(p => p.horasTrabalhadasHorario).concat(priorizarInstalacaoReparo == 1 ? listaFunc.filter(p => p.tipoHabilidade == 2 && p.escalado === true).map(p => p.horasTrabalhadasHorario) : 0),
                    };

                    objCapacidade.tipoHabilidade0 = objCapacidade.tipoHabilidade0.reduce(somar, 0);
                    objCapacidade.tipoHabilidade1 = objCapacidade.tipoHabilidade1.reduce(somar, 0);
                    objCapacidade.tipoHabilidade2 = objCapacidade.tipoHabilidade0 + objCapacidade.tipoHabilidade1;

                    return objCapacidade;
                }
            }

            function GetCapacidadeDisplay(listaFunc, priorizarInstalacaoReparo, formatoDemanda, servicosGrupo) {
                let resultado = GetCapacidade(listaFunc, priorizarInstalacaoReparo, formatoDemanda, servicosGrupo)
                if (formatoDemanda == "servicos") {
                    return resultado;
                }
                else {

                    resultado.tipoHabilidade0 = MinutosParaTempo(resultado.tipoHabilidade0)
                    resultado.tipoHabilidade1 = MinutosParaTempo(resultado.tipoHabilidade1)
                    resultado.tipoHabilidade2 = MinutosParaTempo(resultado.tipoHabilidade2)
                    return resultado;
                }
            }

            function somar(total, number) {

                number = isFloat(number) ? parseFloat(number) : (isNaN(number) ? number : Number(number));
                return total + number;
            }

            function isFloat(n) {
                return Number(n) === n && n % 1 !== 0;
            }

            function ordenarDados(keys,arrayDados,dadosTecnico)
            {
                if (keys.find(p => p === "localidadeStr"))
                {
                    return arrayDados.sort(function (a, b) {

                        let AdescricaoEscritorio = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == a[0])?.descricao_Escritorio ?? dados.servicos.find(p => p.cod_Escritorio == a[0]).descricao_Grupo_Area;
                        let BdescricaoEscritorio = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == b[0])?.descricao_Escritorio ?? dados.servicos.find(p => p.cod_Escritorio == b[0]).descricao_Grupo_Area;

                        if (AdescricaoEscritorio === BdescricaoEscritorio)
                        {
                            let AdescricaoArea = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Area == a[1])?.descricao_Area ?? dados.servicos.find(p => p.cod_Escritorio == a[0] && p.cod_Area == a[1]).descricao_Grupo_Area;
                            let BdescricaoArea = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Area == b[1])?.descricao_Area ?? dados.servicos.find(p => p.cod_Escritorio == b[0] && p.cod_Area == b[1]).descricao_Grupo_Area;

                            if (AdescricaoArea === BdescricaoArea)
                            {
                                let AlocalidadeStr = a[2]
                                let BlocalidadeStr = b[2]
                                return AlocalidadeStr.localeCompare(BlocalidadeStr);
                            }

                            return AdescricaoArea.localeCompare(BdescricaoArea);
                        }


                        return AdescricaoEscritorio.localeCompare(BdescricaoEscritorio);

                    });
                }
                else if (keys.find(p => p === "cod_Area")) {
                    return arrayDados.sort(function (a, b) {

                        let AdescricaoEscritorio = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == a[0])?.descricao_Escritorio ?? dados.servicos.find(p => p.cod_Escritorio == a[0]).descricao_Grupo_Area;
                        let BdescricaoEscritorio = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == b[0])?.descricao_Escritorio ?? dados.servicos.find(p => p.cod_Escritorio == b[0]).descricao_Grupo_Area;

                        if (AdescricaoEscritorio === BdescricaoEscritorio) {
                            let AdescricaoArea = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == a[0] && p.cod_Area == a[1])?.descricao_Area ?? dados.servicos.find(p => p.cod_Escritorio == a[0] && p.cod_Area == a[1]).descricao_Grupo_Area
                            let BdescricaoArea = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == b[0] && p.cod_Area == b[1])?.descricao_Area ?? dados.servicos.find(p => p.cod_Escritorio == b[0] && p.cod_Area == b[1]).descricao_Grupo_Area

                            return AdescricaoArea.localeCompare(BdescricaoArea);
                        }


                        return AdescricaoEscritorio.localeCompare(BdescricaoEscritorio);

                    });
                }
                else if (keys.find(p => p === "cod_Escritorio")) {

                    return arrayDados.sort(function (a, b) {

                        let AdescricaoEscritorio = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == a[0])?.descricao_Escritorio ?? dados.servicos.find(p => p.cod_Escritorio == a[0]).descricao_Grupo_Area
                        let BdescricaoEscritorio = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == b[0])?.descricao_Escritorio ?? dados.servicos.find(p => p.cod_Escritorio == b[0]).descricao_Grupo_Area
                        return AdescricaoEscritorio.localeCompare(BdescricaoEscritorio);

                    });


                }
                else if (keys.find(p => p === "numFre_Supervisor")) {
                    return arrayDados.sort(function (a, b) {

                        let AnomeSupervisor = dadosTecnico.find(p => p.numFre_Supervisor == a[0])?.nome_Supervisor ?? ""
                        let BnomeSupervisor = dadosTecnico.find(p => p.numFre_Supervisor == b[0])?.nome_Supervisor ?? ""
                        return AnomeSupervisor.localeCompare(BnomeSupervisor);

                    });
                }
                else if (keys.find(p => p === "usuario_Monitor")) {

                    return arrayDados.sort(function (a, b) {

                        let AnomeMonitor = dadosTecnico.find(p => p.usuaro_monitor == a[0])?.nome_Monitor ?? ""
                        let BnomeMonitor = dadosTecnico.find(p => p.usuaro_monitor == b[0])?.nome_Monitor ?? ""
                        return AnomeMonitor.localeCompare(BnomeMonitor);

                    });

                }
            }

            function GetResumoTipoHabilidade(listaFunc)
            {
                return {
                    tipoHabilidade0: listaFunc.filter(p => p.tipoHabilidade == 0 && p.escalado === true).length,
                    tipoHabilidade1: listaFunc.filter(p => p.tipoHabilidade == 1 && p.escalado === true).length,
                    tipoHabilidade2: listaFunc.filter(p => p.tipoHabilidade == 2 && p.escalado === true).length
                };
            }

            let columndef = [
                {
                    targets: keys.length, render: function (data, type, row) {

                        let grupo = [];
                        for (var i = 0; i < keys.length; i++) {
                            grupo.push(row[i]);
                        }

                        return data + `&nbsp;<a style="color:gray;float:right" class="ajustePerfil" data-keys="${keys}" data-key0="${row[0]}" data-key1="${row[1]}" data-key2="${row[2]}" data-grupoString="${grupo.join(" - ")}"><i class="fas fa-user-edit"></i></a>`;
                    }
                },
                {
                    targets: keys.length + 7, render: function (data, type, row) {

                        let grupo = [];
                        for (var i = 0; i < keys.length; i++) {
                            grupo.push(row[i]);
                        }

                        return data +
                            `&nbsp;<a style="color:gray;float:right" data-habilidadeNatureza="1" data-key0="${row[0]}" data-key1="${row[1]}" data-key2="${row[2]}" class="demanda"><i class="fas fa-file-alt"></i></a>` +
