                    stringTh = `<th rowspan="2">Grupo Área</th>`;
                    totalColspan = 1;
                }
                if (formatoAreasAtuacao === "area") {
                    stringTh = `<th rowspan="2">Grupo Área</th><th rowspan="2">Área</th>`;
                    totalColspan = 2;
                }
                if (formatoAreasAtuacao === "localidade") {
                    stringTh = `<th rowspan="2">Grupo Área</th><th rowspan="2">Área</th><th rowspan="2">Localidade</th>`;
                    totalColspan = 3;
                }
