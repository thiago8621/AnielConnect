                        //reparo
                        reparoTempoMedioServico: GetTempoMedioDisplay(servicosGrupo, [0]),
                        reparoCapacidade: resumoCapacidade.tipoHabilidade0,
                        reparoDemanda: GetDemandaDisplay(servicosGrupo, [0], formatoDemanda),
                        reparoServAgendados: GetServAgendadosDisplay(servicosGrupo, [0], formatoDemanda),
                        reparoInstalacaoServRoteirizados: GetRoteirizadosDisplay(servicosGrupo, [0], formatoDemanda),
                        reparoCapacidadeDisponivel: GetCapacidadeDisponivelDisplay(grupoObj, servicosGrupo, [0], priorizarInstalacaoReparo, formatoDemanda),
