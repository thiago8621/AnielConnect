                if (keys.find(y => y === "localidade"))
                {
                    if (key0 && key1 && key2)
                        servicos = servicos.filter(p => p.cod_Escritorio == key0 && p.cod_Area == key1 && p.localidadeStr == key2)
                }
                else if (keys.find(y => y === "cod_Area")) {
                    if (key0 && key1)
                        servicos = servicos.filter(p => p.cod_Escritorio == key0 && p.cod_Area == key1)
                }
                else if (keys.find(y => y === "cod_Escritorio")) {
                    if (key0)
                        servicos = servicos.filter(p => p.cod_Escritorio == key0)
                }
                else if (keys.find(y => y === "numFre_Supervisor")) {
                    if (key0)
                        servicos = servicos.filter(p => p.numFre_Supervisor == key0)
                }
                else if (keys.find(y => y === "usuario_Monitors")) {
                    if (key0)
                        servicos = servicos.filter(p => p.usuario_Monitor == key0)
                }

                NumeroOS = servicos.map(p => p.num_Obra_Original);

                let _url = `@Url.Action("Index", "Painel_Roteirizacao")?Servicos=` + NumeroOS;
                AddAba(_url, "@Html.Raw(RsCadastros.PAINEL_ROTEIRIZACAO)");

            });

            $(".servRot").click(async function (e) {

                let [filtro, habilidadeNatureza] = [[], $(this).attr("data-habilidadeNatureza")];

                let [key0, key1, key2] = [$(this).attr("data-key0"), $(this).attr("data-key1"), $(this).attr("data-key2")];
                                
                if (habilidadeNatureza) {
                    filtro.push({ chave: "HabilidadeNatureza", valor: habilidadeNatureza });
                }
                if (keys.find(y => y === "localidade")) {

                    if (key0)
                        filtro.push({ chave: "GrupoArea", valor: key0 });
                    if (key1)
                        filtro.push({ chave: "Area", valor: key1 });
                    if (key2)
                        filtro.push({ chave: "Localidade", valor: key2 });
                }
                else if (keys.find(y => y === "cod_Area")) {
                    if (key0)
                        filtro.push({ chave: "GrupoArea", valor: key0 });
                    if (key1)
                        filtro.push({ chave: "Area", valor: key1 });
                }
                else if (keys.find(y => y === "cod_Escritorio")) {
                    if (key0)
                        filtro.push({ chave: "GrupoArea", valor: key0 });
                }
                else if (keys.find(y => y === "numFre_Supervisor")) {
                    if (key0)
                        filtro.push({ chave: "Supervisor", valor: key0 });
                }
                else if (keys.find(y => y === "usuario_Monitors")) {
                    if (key0)
                        filtro.push({ chave: "Monitor", valor: key0 });
                }

                if ($("#iNaturezaProducao").val()) {
                    filtro.push({ chave: "NaturezaProducao", valor: $("#iNaturezaProducao").val() });
                }
                if ($("#iTipoServico").val()) {
                    filtro.push({ chave: "TipoServico", valor: $("#iTipoServico").val() });
                }
                if ($("#iGrupoArea").val()) {
                    filtro.push({ chave: "GrupoArea", valor: $("#iGrupoArea").val() });
                }
                if ($("#iArea").val()) {
                    filtro.push({ chave: "Area", valor: $("#iArea").val() });
                }
                if ($("#iLocalidade").val()) {
                    filtro.push({ chave: "Localidade", valor: $("#iLocalidade").text() });
                }
                if ($("#iContrato").val()) {
                    filtro.push({ chave: "Contrato", valor: $("#iContrato").val() });
                }
                if ($("#iProjeto").val()) {
                    filtro.push({ chave: "Contrato", valor: $("#iContrato").val() });
                }
                if ($("#iEquipe").val()) {
                    filtro.push({ chave: "Equipe", valor: $("#iEquipe").val() });
                }
                if ($("#iSupervisor").val()) {
                    filtro.push({ chave: "Supervisor", valor: $("#iSupervisor").val() });
                }
                if ($("#iMonitor").val()) {
                    filtro.push({ chave: "Monitor", valor: $("#iMonitor").val() });
                }
                if ($("#iDataInicioDemanda").val()) {
                    filtro.push({ chave: "DataInicioDemanda", valor: $("#iDataInicioDemanda").val() });
                }
                if ($("#iNatureza_Servico").val()) {
                    filtro.push({ chave: "iNatureza_Servico", valor: $("#iNatureza_Servico").val() });
                }

                filtro = filtro.filter(function ({ chave }) {
                    return !this.has(chave) && this.add(chave);
                }, new Set);

                let filtroString = "";
                if (filtro.length > 0) {
                    for (item of filtro) {
                        filtroString += `&${item.chave}=${item.valor}`
                    }
                }

                let _url = `@Url.Action("Index", "Painel_Servicos")?DataInicial=${$('#iDataInicio').val()}&DataFinal=${$('#iDataInicio').val()}&ConfigRoteirizados=S` + filtroString;
                AddAba(_url, "@Html.Raw(RsCadastros.PAINEL_SERVICOS)");
            });

            oDatatable.columns().toArray()[0].forEach(function (item, index)
            {
                if (index >= keys.length && index != keys.length + 5 && index != keys.length + 12 && index != keys.length + 19) {

                    if (formatoDemanda == "servicos") {
                        var sum = oDatatable.rows().data().map(p => p[index]).reduce(somar, 0);
                        sum = isFloat(sum) ? parseFloat(sum).toFixed(1) : (isNaN(sum) ? sum : Number(sum));
                        if (isNaN(sum))
                        {
                            $('#totalColuna' + index).html('-');
                        }
                        else {
                            $('#totalColuna' + index).html(sum);
                        }
                    }
                    else
                    {
                        let dados = oDatatable.rows().data().map(p => p[index])
                        if (dados.filter(p => isNaN(p)).length > 0)
                        {
                            dados = dados.map(p => TempoParaMinutos(p));
                            var sum = dados.reduce(somar, 0);
                            sum = isFloat(sum) ? parseFloat(sum).toFixed(1) : (isNaN(sum) ? sum : Number(sum));
                            let tempo = MinutosParaTempo(sum);
                            if(tempo.includes("NaN"))
                                $('#totalColuna' + index).html('-');
                            else
                                $('#totalColuna' + index).html(tempo);

                        }
                        else
                        {
                            var sum = dados.map(p => parseFloat(p)).reduce(somar, 0);
                            $('#totalColuna' + index).html(sum);
                        }

                    }
                }
            });

            $("#divProgress").hide();

            //$('#iNaturezaServico').val(oDatatable.search());
            //$('#iNaturezaServico').keyup(function () {

            //    rows_selected = [];
            //    oDatatable.search($(this).val()).draw();

            //});
                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    rows_selected = [];
                });
            },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        $(window).resize(function () {
            if (oDatatable != null) {
                oDatatable.columns.adjust();
            }
        });

        function oDatatableFunction(atualizar) {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                    Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 30 dias", "warning");
                    return false
                }
            }

            if (atualizar == true)
                dados = null;

            if (oDatatable != null)
            {
                if (oDatatableTecnicos != null)
                {
                    jQuery("#datatableTecnicos").DataTable().clear().destroy();
                }

                oDatatable.destroy();
                $("#datatable").empty();
            }

            TableManageButtons.init();

            $('#modal-filter').modal('hide');
        }

    </script>
}
