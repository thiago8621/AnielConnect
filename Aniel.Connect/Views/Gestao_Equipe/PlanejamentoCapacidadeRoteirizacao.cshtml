@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = "Painel de Planejamento para Roteirização";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />
    <style>

        .nowrap th td {
            white-space: nowrap !important;
        }

        .text-center th td {
            text-align: center !important;
        }


        tr, td {
            text-align: center;
        }

        .dtfc-fixed-left {
            background: white;
        }

        td.dtfc-fixed-left {
            text-align: left !important;
        }

        .table.dataTable.stripe tbody tr.odd {
            background-color: #f9f9f9;
        }

        .table td {
            padding: 0.4rem;
            white-space: normal !important;
        }

        .table th {
            padding: 0.3rem;
            white-space: normal !important;
            min-width: 75px !important;
            vertical-align: middle;
        }

        .table td {
            padding: 0.4rem;
            white-space: normal !important;
            min-width: 60px !important;
        }


        td.colunaAgrupamento {
            white-space: nowrap !important;
        }

        .toggle.btn {
            min-width: 3.7rem !important;
            min-height: 1.7rem !important;
        }
    </style>

}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")
    <script src="https://cdn.datatables.net/fixedcolumns/4.0.2/js/dataTables.fixedColumns.min.js"></script>

    <script>
        let oDatatable = null;
        let oDatatableTecnicos = null;
        let objetoTecnico = null;

        let HandleNaturezaServico = function () {
            $('#iNatureza_Servico').on('select2:select select2:unselecting', function (e) {
                let alturaSelect2 = $(".select2-selection--multiple").height();
                $("#iRowMultipleNatureza").height(alturaSelect2 + 30);

            });
        };

        $('#SalvarAjusteTecnicos').click(async function () {

            let lista = $(`.perfilTecnico`).toArray().filter(p => $(p).attr("data-alterado") == "true").map(p => {
                return {
                    equipe: $(p).attr("data-equipe"),
                    idPerfilAgendamento: $(p).val()
                }
            })

            const link = '@String.Concat(CONSTANTES.URLPortal, "/api/PlanejamentoCapacidadeRoteirizacaoApiController/SalvarAjustePerfil")';
            let resultado = await $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    data: $('#iDataInicio').val(),
                    lista: lista
                }
            });

            if (resultado.ok === true) {
                Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                $("#modal-tecnicos").modal('hide');
                oDatatableFunction(true);
            }
            else {
                Notificar("@RsBase.ATENCAO_", resultado.mensagem, "warning");
            }

        });

        $("#modal-tecnicos").on('shown.bs.modal', async function (e) {

            oDatatableTecnicos = $("#datatableTecnicos").DataTable(objetoTecnico);
            for (let perfil of $(`.perfilTecnico`)) {
                const valor = $(perfil).attr("data-valor");
                const indice = $(perfil).attr("data-indice");

                let HandlePerfil = function () {
                    $(`#iPerfilAgendamento${indice}`).unbind('select2:select select2:unselecting');
                    $(`#iPerfilAgendamento${indice}`).on('select2:select select2:unselecting', function (e) {

                        if ($(this).val() != valor)
                        {
                            $(this).parent().css("background-color", "#C7FDC6");
                            $(this).attr("data-alterado", true);
                        }
                        else
                        {
                            $(this).parent().css("background-color", "");
                            $(this).attr("data-alterado", false);
                        }
                    });
                };

                await AddSelect(`iPerfilAgendamento${indice}`, "@CONSTANTES.URLPortal/api/PerfilAgendamentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, valor, "@RsBase.SELECIONE", false, HandlePerfil);
            }
            oDatatableTecnicos.columns.adjust();

            $("#divProgress").hide();
        });

        $("#iPeriodo").change(function (e) {
            if ($(this).is(':checked')) {
                $(`#iDataInicioDemanda`).prop("disabled",false);
            }
            else {
                $(`#iDataInicioDemanda`).prop("disabled", true);
                $(`#iDataInicioDemanda`).val("");
            }
        });

        let HandleContrato = function () {
            $('#iContrato').unbind('select2:select select2:unselecting');
            $('#iContrato').on('select2:select select2:unselecting', function (e) {

                Contrato = e.params.data
                if (Contrato) {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, Contrato.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
            });
        };

        var HandleGrupo = function () {
            $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

                GrupoSelecionado = e.params.data
                if (GrupoSelecionado) {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false, HandleArea);
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
                else {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
                }

            });
        };

        var HandleArea = function () {
            $('#iArea').on('select2:select select2:unselecting', function (e) {

                AreaSelecionada = e.params.data
                if (AreaSelecionada) {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id) , null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };

        function carregaSelect2() {
            AddSelect("iContrato", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleContrato);
            AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iMaterial", "@CONSTANTES.URLPortal/api/Material_TarefaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iFamiliaMaterial", "@CONSTANTES.URLPortal/api/Material_TarefaApi/GetComboFamiliaMaterial", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iGrupoMaterial", "@CONSTANTES.URLPortal/api/Material_TarefaApi/GetComboGrupoMaterial", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iEquipe", "@CONSTANTES.URLPortal/api/EquipeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iNaturezaProducao", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupo);
            AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
            AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iMonitor", "@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboMonitor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iNatureza_Servico", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleNaturezaServico);
        }

        var filter_state = {
            periodo: {
                label: "@RsCadastros.DATA", getDisplay: () => {

                    var tipo_data = "";
                    switch ($('input[name="tipodata"]:checked').val()) {

                        case "criacao": { tipo_data = "(@RsCadastros.CRIACAO) "; break; }
                        case "agendamento": { tipo_data = "(@RsCadastros.AGENDAMENTO) "; break; }
                        case "baixa" :{ tipo_data = "(@RsCadastros.DIGITACAO) "; break; }
                    }

                    return Boolean($('#iDataInicio').val()) ? $('#iDataInicio').val() : "";

                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            contrato: {
                label: "@RsCadastros.CONTRATO",
                getDisplay: () => { return Boolean($('#iContrato').val()) ? $('#iContrato option:selected').text() : "" },
                onclick: () => {
                    $('#iContrato').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            projeto: {
                label: "@RsCadastros.PROJETO",
                getDisplay: () => { return Boolean($('#iProjeto').val()) ? $('#iProjeto option:selected').text() : "" },
                onclick: () => {
                    $('#iProjeto').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            equipe: {
                label: "@RsCadastros.TECNICO",
                getDisplay: () => { return Boolean($('#iEquipe').val()) ? $('#iEquipe option:selected').text() : "" },
                onclick: () => {
                    $('#iEquipe').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            material: {
                label: "@RsCadastros.MATERIAL",
                getDisplay: () => { return Boolean($('#iMaterial').val()) ? $('#iMaterial option:selected').text() : "" },
                onclick: () => {
                    $('#iMaterial').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            classificacaoMaterial : {
                label: "@RsCadastros.CLASSIFICAO_MATERIAL",
                getDisplay: () => { return Boolean($('#iClassificacaoMaterial').val()) ? $('#iClassificacaoMaterial option:selected').text() : "" },
                onclick: () => {
                    $('#iClassificacaoMaterial').val(null).trigger("change")
                    oDatatable.draw();
                }
            },

            naturezaProducao : {
                label: "@RsCadastros.NATUREZA",
                getDisplay: () => { return Boolean($('#iNaturezaProducao').val()) ? $('#iNaturezaProducao option:selected').text() : "" },
                onclick: () => {
                    $('#iNaturezaProducao').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            tipo_servico : {
                label: "@RsCadastros.TIPO_SERVICO",
                getDisplay: () => { return Boolean($('#iTipoServico').val()) ? $('#iTipoServico option:selected').text() : "" },
                onclick: () => {
                    $('#iTipoServico').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            familia : {
                label: "@RsCadastros.FAMILIA_MATERIAL",
                getDisplay: () => { return Boolean($('#iFamiliaMaterial').val()) ? $('#iFamiliaMaterial option:selected').text() : "" },
                onclick: () => {
                    $('#iFamiliaMaterial').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            grupo_familia : {
                label: "@RsCadastros.GRUPO_MATERIAL",
                getDisplay: () => { return Boolean($('#iGrupoMaterial').val()) ? $('#iGrupoMaterial option:selected').text() : "" },
                onclick: () => {
                    $('#iGrupoMaterial').val(null).trigger("change")
                    oDatatable.draw();
                }
            }
        }






        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {

            $('#iNaturezaProducao').val(null).trigger('change');
            $('#iSupervisor').val(null).trigger('change');
            $('#iTipoServico').val(null).trigger('change');
            $('#iEquipe').val(null).trigger('change');
            $('#iGrupoMaterial').val(null).trigger('change');
            $('#iFamiliaMaterial').val(null).trigger('change');
            $('#iMaterial').val('').trigger('change');
            $('#iProjeto').val(null).trigger('change');
            $('#iContrato').val(null).trigger('change');
            $('#iClassificacaoMaterial').val(null).trigger('change');
            $("#iNatureza_Servico").val(null).trigger('change');

            carregaSelect2()
            if (oDatatable != null) {
                oDatatable.draw()
            }
        })

        $(document).ready(async () => {
            $('#modal-filter').modal('show')
            carregaSelect2()
        })

        $('input[type=radio][name=AreaAtuacaoFormato]').change(function () {
            oDatatableFunction();
        });

        $('input[type=radio][name=InstalacaoReparo]').change(function () {
            oDatatableFunction();
        });

        $('input[type=radio][name=ServicosHoras]').change(function () {
            oDatatableFunction();
        });

        //$('#iNaturezaServico').change(function () {
        //    oDatatableFunction();
        //});

        $('#iFormatoVisu').change(function () {

            const valor = $(this).val();

            if (valor == 0)
            {
                $('#iFormatoAreasAtuacao').show();
            }
            else {
                $('#iFormatoAreasAtuacao').hide();
            }

            oDatatableFunction();
        });

        let dados = null;

