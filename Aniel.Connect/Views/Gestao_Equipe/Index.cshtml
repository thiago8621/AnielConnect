@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Aniel.Connect.Models

@{
    ViewBag.Title = RsCadastros.GESTAO_EQUIPES;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;
    List<OsReprocessadas> osReprocessadas = new List<OsReprocessadas>();
}
@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")

    <script>
    let rows_selected = [];
        
        $("#iProcessar").on("click", function () {
  

            var objEnviar = { dataInicio: $("#txtDataInicio").val(), dataFim: $("#txtDataFim").val() }

            $.ajax({

                url: baseUrl + '/api/Gestao_Equipeapi/ReprocessarPedido',

                type: 'POST',

                data: objEnviar,

                success: function (data) {
                    console.log(data);
                    let quantSucesso = document.querySelector("#iQuantSucess");
                    let errosObtidos = document.querySelector("#iErros");

                    quantSucesso.innerText = data.totalProcessada;
                    errosObtidos.textContent = data.totalNaoReprocessadaOuComErro;
                    console.log(quantSucesso);//mostra na tele

                }
            });
        


        return true;
    });
    </script>
}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="col-sm-12" style="right:20px; padding-top:7px;">
        <h4 class="title-page"><i class="fas fa-users"></i> @ViewBag.Title</h4>
    </div>

    <div class="row pl-4">

        @if (AcessoHelper.TemAcessos(_areas, "130", "131"))
        {
            <div class="col-sm-3">
                <div class="row">
                    <i class="fas fa-users" style="margin-top: 16px;"></i>
                    <p class="pConfig mt-3"><u>@RsCadastros.EQUIPES</u></p>
                </div>
                <div class="text-left">
                    <ul class="ulConfig">
                        @if (AcessoHelper.TemAcesso(_areas, "130"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Acompanhamento_Equipes", "Gestao_Equipe")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_ACOMPANHAMENTO_EQUIPE</a></li>
                        }
                        @if (AcessoHelper.TemAcesso(_areas, "131"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Equipes", "Mapa")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.LOCALIZACAO_EQUIPE_MAPA</a></li>
                        }
                        @if (AcessoHelper.TemAcesso(_areas, "131"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Painel_Chat", "Chat")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_CONVERSAS_CHAT</a></li>
                        }
                        @if (AcessoHelper.TemAcesso(_areas, "272"))
                        {
                            <li class="liConfig"><a href="@Url.Action("PlanejamentoCapacidadeRoteirizacao", "Gestao_Equipe")" class="aConfig" onclick="ShowPageLoading(); return true;">Painel de Planejamento de Roteirização</a></li>
                        }
                        @if (AcessoHelper.TemAcesso(_areas, "303"))
                        {
                            <li class="liConfig"><a href="@Url.Action("PlanejamentoCapacidade", "Agendamento")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_PLANEJAMENTO_CAPACIDADE</a></li>
                        }
                        @if (AcessoHelper.TemAcesso(_areas, "273"))
                        {
                            <li class="liConfig"><a href="@Url.Action("PainelGestaoOperacional", "Gestao_Equipe")" class="aConfig" onclick="ShowPageLoading(); return true;">Painel de Gestão Operacional</a></li>
                        }
                    </ul>
                </div>
            </div>
        }
        @if (AcessoHelper.TemAcessos(_areas, "132", "133", "134", "294", "295"))
        {
            <div class="col-sm-3">
                <div class="row">
                    <i class="fas fa-hand-holding" style="margin-top: 15px;"></i>
                    <p class="pConfig mt-3"><u>@RsCadastros.SERVICOS</u></p>
                </div>
                <div class="text-left">
                    <ul class="ulConfig">
                        @if (AcessoHelper.TemAcesso(_areas, "132"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Criar_Ordem_Servico", "Painel_Servicos", new { Origem = "GestaoEquipe" })" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CRIAR_ORDEM_SERVICOS</a></li>
                        }
                        @if (AcessoHelper.TemAcesso(_areas, "133"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "Painel_Servicos")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_SERVICOS</a></li>
                        }
                        @if (AcessoHelper.TemAcesso(_areas, "134"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Timeline_Servicos", "Gestao_Equipe")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.TIMELINE_SERVICOS</a></li>
                        }
                        @if (AcessoHelper.TemAcesso(_areas, "294"))
                        {
                            <li class="liConfig"><a href="@Url.Action("ImportarOs", "ImportacaoOS")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsConfiguracao.IMPORTAR_OS</a></li>
                        }
                        @if (AcessoHelper.TemAcesso(_areas, "295"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "ExclusaoOs")" class="aConfig" onclick="ShowPageLoading(); return true;">Exclusão de Ordens de Serviços</a></li>
                        }
                        @if (AcessoHelper.TemAcesso(_areas, "295"))
                        {
                            <li class="liConfig">
                                <a href="@Url.Action("Index", "ReprocessarOsRencidentes")" class="aConfig" data-toggle="modal" data-target="#modal-filter" title="@RsConfiguracao.REPROCESSAROSREINCIDENTES">
                                    @RsConfiguracao.REPROCESSAROSREINCIDENTES
                                </a>
                            </li>

                        }
                        @if (AcessoHelper.TemAcesso(_areas, "354"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "PainelProdutividade")" class="aConfig" onclick="ShowPageLoading(); return true;">Painel de Produtividade</a></li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>

    <div class="row pl-4" style="margin-top: -10px;">
        <div class="modal" id="modal-filter">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title text-muted">
                            @RsConfiguracao.REPROCESSAROSREINCIDENTES
                        </h4>
                        <div class="row">

                            <input type="date" class="input-search" id="txtDataInicio" placeholder="Data de inicio" autocomplete="off">
                            <input type="date" class="input-search" id="txtDataFim" placeholder="Data fim" autocomplete="off">

                        </div>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>


                        </div>
                        <div class="modal-body">
                            <table class="table text-center">
                                <thead>
                                    <tr>
                                        <th>Quantidade de Sucesso</th>
                                        <th>Ordem de Serviços com Erros</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th id="iQuantSucess">  </th>
                                        <th id="iErros">  </th>
                                    </tr>
                                </tbody>

                            </table>

                        </div>
                        <div class="form-group col-sm-12" style="padding: 15px;">
                            <div class="text-center">
                                <button type="button" class="btn btn-success" id="iProcessar"> Processar</button>
                            </div>
                        </div>
                    </div>
            </div>
        </div>



    </div>


</div>