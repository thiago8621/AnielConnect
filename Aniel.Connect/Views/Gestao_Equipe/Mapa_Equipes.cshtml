                async function PolyLineRealizada(polylineRealizadaPoints, lista) {

                    for (data of lista) {
                        try {

                            if ($('#iDistanciaRealizada').text() == "") $('#iDistanciaRealizada').text(0);
                            distanciaRealizada = $('#iDistanciaRealizada').text().replace("KM", "");
                            distanciaRealizada = Number((parseFloat(distanciaRealizada)).toFixed(2));
                            $('#iDistanciaRealizada').text(((distanciaRealizada + (data.routes[0].distance / 1000)).toFixed(2)) + "KM");

                            for (var y = 0; y < data.routes[0].legs.length; y++) {

                                for (var z = 0; z < data.routes[0].legs[y].steps.length; z++) {

                                    for (var i = 0; i < data.routes[0].legs[y].steps[z].geometry.coordinates.length; i++) {
                                        //new L.LatLng(-22.884809, -43.499205),
                                        polylineRealizadaPoints.push(new L.LatLng(data.routes[0].legs[y].steps[z].geometry.coordinates[i][1], data.routes[0].legs[y].steps[z].geometry.coordinates[i][0]));
                                        if (latInicial == null) {
                                            latInicial = data.routes[0].legs[y].steps[z].geometry.coordinates[i][1];
                                            lonInicial = data.routes[0].legs[y].steps[z].geometry.coordinates[i][0];
                                        }
                                        latFinal = data.routes[0].legs[y].steps[z].geometry.coordinates[i][1];
                                        lonFinal = data.routes[0].legs[y].steps[z].geometry.coordinates[i][0];
                                    }
                                }

                            };
                        }
                        catch (ex) {
                            var mensagem = '@RsCadastros.NAO_FOI_POSSIVEL_ESTABELCER_ROTA_PLANEJADA';
                        Notificar("@RsBase.ATENCAO_", mensagem, "warning");
                            console.log(e.responseText)
                        }
                    }

                }

