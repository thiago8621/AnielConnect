    </div>
    <div class="row" style="font-size:10px">
        <a target="_blank" href="https://leafletjs.com" title="A JavaScript library for interactive maps"> Leaflet</a> <span aria-hidden="true">|</span> © <a target="_blank" href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
    </div>

    @if (!String.IsNullOrEmpty(Request.Params["equipe"]))
    {
        if (Model.Rotas_Planejadas != null)
        {

            if ((Model.Rotas_Planejadas.Count() == 0) && (Model.Rotas_Realizada.Count() == 0))
            {
                <text>
                    <script>
                        $(document).ready(function () {
                            alert("Nenhuma rota definida");
                        });
                    </script>
                </text>
            }




<script>

                function ShowPageLoading() {
                    try {
                        parent.App.startPageLoading();
                    } catch {
                        try {
                            parent.parent.App.startPageLoading();
                        } catch (e) {
                            console.log(e);
                        }
                    }
                }

                function HidePageLoading() {
                    try {
                        parent.App.stopPageLoading();
                    } catch {
                        try {
                            parent.parent.App.stopPageLoading();
                        } catch (e) {
                            console.log(e);
                        }
                    }
                }


                $('#iDistanciaPlanejada').text("0.00KM");
                $('#iDistanciaRealizada').text("0.00KM");
                
                polylinePlanejada = undefined;
                polylineRealizada = undefined;
                polylineIntegrada = undefined;
                var polylinePlanejadaPoints = [];
                var polylineRealizadaPoints = [];
                var polylineIntegradaPoints = [];
                let paradas = [];
                let pontoPartida = null;
                let pontoInicial = null;
                let pontoFinal = null;
                let servicosExecutados = [];
                let servicosExecutadosImprodutivos = [];
                let baixasServico = [];
                let servicosExecutar = [];
                let servicosSendoExecutados = [];


                async function PolyLinePlanejada(polylinePlanejadaPoints, lista) {

                    for (data of lista) {


                        try {

                            if ($('#iDistanciaPlanejada').text() == "") $('#iDistanciaPlanejada').text(0);

                            distanciaPlanejada = $('#iDistanciaPlanejada').text();
                            distanciaPlanejada = distanciaPlanejada.replace("KM", "");
                            distanciaPlanejada = parseFloat(distanciaPlanejada);
                            distanciaPlanejada = Number(distanciaPlanejada + (data.routes[0].distance / 1000)).toFixed(2);

                            $('#iDistanciaPlanejada').text(distanciaPlanejada + "KM");



                            for (var y = 0; y < data.routes[0].legs.length; y++) {

                                for (var z = 0; z < data.routes[0].legs[y].steps.length; z++) {

                                    for (var i = 0; i < data.routes[0].legs[y].steps[z].geometry.coordinates.length; i++) {
                                        //new L.LatLng(-22.884809, -43.499205),
                                        polylinePlanejadaPoints.push(new L.LatLng(data.routes[0].legs[y].steps[z].geometry.coordinates[i][1], data.routes[0].legs[y].steps[z].geometry.coordinates[i][0]));
                                    }

                                }
                            }
