@model  Aniel.Connect.Models.Equipe_MapaItemModel
@using Resources
@using Aniel.T5.Model.enumerado

@{
    ViewBag.Title = @Request.Params["pagina"] == "Acompanhamento" ? RsCadastros.ACOMPANHAMENTO_EQUIPE_MAPA : RsCadastros.VISUALIZAR_ROTA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

<script src="~/bin/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/leaflet.js"></script>
<script src="~/Scripts/leaflet.markercluster-src.js"></script>
<script src="~/Scripts/leaflet_awesome_number_markers.js"></script>
<script src="~/Scripts/L.Polyline.SnakeAnim.js"></script>

<link rel="stylesheet" href="~/Content/MarkerCluster.css" />
<link rel="stylesheet" href="~/Content/MarkerCluster.Default.css" />
<link href="~/Content/leaflet.css" rel="stylesheet" />
<link href="~/Content/map.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/leaflet_awesome_number_markers.css">
<link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />



<!--<script src="~/bin/Scripts/connect.js"></script>-->



@section styles{
    <style>
        .overlay {
            z-index: 9999 !important
        }
    </style>
}


@section scripts {

    <script>


        
        var decodeHtmlEntity = function (str) {
            return str.replace(/&#(\d+);/g, function (match, dec) {
                return String.fromCharCode(dec);
            });
        };

        function Traduzir(Texto) {

            if (Texto.indexOf("The value") !== -1 && Texto.indexOf("is not valid for") !== -1) {
                return Texto.replace("The value", "O valor").replace("is not valid for", "é inválido para");
            }
            else {
                return Texto;
            }
        }

        function erroLatLong() {
            Notificar("@RsBase.ATENCAO_","Erro ao montar a rota devido a latitude e longitude configuradas de forma errada.","warning");
        }

        function NotificacaoMapa(atencao, Texto,tipo){
            try {
                parent.Swal.fire({
                    html: Texto,
                    type: tipo,
                    confirmButtonColor: "#3085d6",
                    confirmButtonText: "OK"
                });
            } catch (ex) {
                Swal.fire({
                    html: Texto,
                    type: tipo,
                    confirmButtonColor: "#3085d6",
                    confirmButtonText: "OK"
                });
            }
        }

        $(document).ready(function () {

            AddSelect("iMatricula_Id", "@CONSTANTES.URLPortal/api/Equipeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Request.Params["equipe"]", "@RsBase.SELECIONE", false);

            $('#iData_Busca').val('@Request.Params["data"]');

            if($('#iData_Busca').val()) {
                $('#iData_Busca').val('@Request.Params["data"]');
                var tempdate = new $('#iData_Busca').val();
                var partesData = tempdate.split("/");
                var tempdate = partesData[1] + '/' + partesData[0] + "/" + partesData[2];
                $('#iData_Busca').val(tempdate);
            }

            escondeExibeDivPorURL();
        });

        function recarregaFiltro() {


            if (!$('#iMatricula_Id').val() || !$('#iData_Busca').val()) {
                Notificar("@RsBase.ATENCAO_","@String.Format(RsBase.REQUIRED, RsCadastros.DATA_EQUIPE)","warning");
                return false;
            }

            var tempdate = new $('#iData_Busca').val();
            var partesData = tempdate.split("/");
            var tempdate = partesData[1] + '/' + partesData[0]  + "/" + partesData[2];

            var url = "@Url.Action("Mapa_Equipes", "Gestao_Equipe")" + "?Equipe=" + $('#iMatricula_Id').val()
                      + "&Data=" + tempdate + "&nome_equipe=" + $('#iMatricula_Nome').val() + "&Pagina=@Request.Params["pagina"]";
            window.location.href = url;
            ShowPageLoading();

        }

        //Esconder e Exibir Divs de acordo com a URL
        function escondeExibeDivPorURL() {

            var pagina = "@Request.Params["Pagina"]";

            if (pagina == "Acompanhamento") {
                //$("#iDivData").hide();
                //$("#iDivEquipe").hide();
                //$("#iBtnAtualizar").hide();
                $("#iCircleStatusEquipe").show();
                $("#iNavPainelRotas").hide();
                $("#iNavAcompanhamento").show();
                $("#iBtnVoltar").attr("href", "@Url.Action("Acompanhamento_Equipes", "Gestao_Equipe")");

            } else if (pagina == "Rotas"){
                $("#iDivData").show();
                $("#iDivEquipe").show();
                $("#iBtnAtualizar").show();
                $("#iCircleStatusEquipe").hide();
                $("#iNavAcompanhamento").hide();
                $("#iNavPainelRotas").show();
                $("#iBtnVoltar").attr("href","@Url.Action("Index","Painel_Roteirizacao")");
            }

        }

        var fotoAjaxUrl = '@String.Concat(CONSTANTES.URLPortal, "/api/Acompanhamento_Servicoapi/FotoAjax")' + '?num_fre=@Model.Num_Fre';
                $.ajax({
                    url: fotoAjaxUrl,
                    type: "GET",
                    dataType: "json"
                })
                    .done(function (data) {
                        $("#iFotoLoading").hide();
                        if (data.objeto) {
                            $("#idImg").html('<img id="iFoto" width="80%" height="100%" style="height: 80% !important;" src="data:image/jpeg;base64,' + data.objeto + '" class="rounded-circle img-fluid" alt="@RsCadastros.FUNCIONARIO" />');
                        }
                        else {
                            $("#idImg").html('<i id="iFoto" class="fas fa-user-circle fa-3x"></i>');
                        }
                    });

        //Documentação: http://project-osrm.org/docs/v5.22.0/api/#general-options
        /*ARequestivar e Desativar Rotas Planejadas e Realizadas */
        $('#iTooglePlanejada').change(function () {
            if ($(this).is(":checked")) {
                polylinePlanejada.removeFrom(map);

                var polylinePlanejadaOptions = {
                    color: 'blue',
                    weight: 8,
                    snakingSpeed: 250,
                    opacity: 0.9,
                    smoothFactor: 1
                };

                polylinePlanejada = new L.Polyline(polylinePlanejadaPoints, polylinePlanejadaOptions)
                polylinePlanejada.addTo(map).snakeIn();

            }
            else {
                polylinePlanejada.removeFrom(map);
            }
        })

        $('#iToogleRealizada').change(function () {
            if ($(this).is(":checked")) {

                polylineRealizada.removeFrom(map);

                var polylineOptions = {
                    color: 'red',
                    weight: 5,
                    snakingSpeed: 250,
                    opacity: 0.9,
                    smoothFactor: 1
                };

                polylineRealizada = new L.Polyline(polylineRealizadaPoints, polylineOptions);
                polylineRealizada.addTo(map).snakeIn();

                $(".iLbRealizada").show();

            }
            else {

                polylineRealizada.removeFrom(map);
                $(".iLbRealizada").hide();
            }
        })

        $('#iToogleIntegrada').change(function () {
            if ($(this).is(":checked")) {

                polylineIntegrada.removeFrom(map);

                var polylineOptions = {
                    color: 'green',
                    weight: 2.5,
                    snakingSpeed: 250,
                    opacity: 0.9,
                    smoothFactor: 1
                };

                polylineIntegrada = new L.Polyline(polylineIntegradaPoints, polylineOptions);
                polylineIntegrada.addTo(map).snakeIn();

            }
            else {

                polylineIntegrada.removeFrom(map);
            }
        })

        $('#iToogleParadas').change(function () {
            if ($(this).is(":checked")) {
                for (let parada of paradas) {
                    parada.removeFrom(map);
                    parada.addTo(map)
                }
            }
            else {
                for (let parada of paradas) {
                    parada.removeFrom(map);
                }
            }
        });

        $('#iTooglePontoInicial').change(function () {
            if ($(this).is(":checked")) {
                pontoInicial.removeFrom(map);
                pontoInicial.addTo(map);
            }
            else {
                
                pontoInicial.removeFrom(map);
                
            }
        });

        $('#iTooglePontoFinal').change(function () {
            if ($(this).is(":checked")) {
                pontoFinal.removeFrom(map);
                pontoFinal.addTo(map);
            }
            else {

                pontoFinal.removeFrom(map);

            }
        });

        $('#iTooglePontoPartida').change(function () {
            if ($(this).is(":checked")) {
                pontoPartida.removeFrom(map);
                pontoPartida.addTo(map);
            }
            else {

                pontoPartida.removeFrom(map);

            }
        });

        $('#iToogleServicoExecutado').change(function () {
            if ($(this).is(":checked")) {
                for (let servico of servicosExecutados) {
                    servico.removeFrom(map);
                    servico.addTo(map)
                }
            }
            else {
                for (let servico of servicosExecutados) {
                    servico.removeFrom(map);
                }
            }
        });

        $('#iToogleServicoSendoExecutado').change(function () {
            if ($(this).is(":checked")) {
                for (let servico of servicosSendoExecutados) {
                    servico.removeFrom(map);
                    servico.addTo(map)
                }
            }
            else {
                for (let servico of servicosSendoExecutados) {
                    servico.removeFrom(map);
                }
            }
        });

        $('#iToogleServicoaExecutar').change(function () {
            if ($(this).is(":checked")) {
                for (let servico of servicosExecutar) {
                    servico.removeFrom(map);
                    servico.addTo(map)
                }
            }
            else {
                for (let servico of servicosExecutar) {
                    servico.removeFrom(map);
                }
            }
        });

        $('#iToogleServicoExecutadoImprodutivo').change(function () {
            if ($(this).is(":checked")) {
                for (let servico of servicosExecutadosImprodutivos) {
                    servico.removeFrom(map);
                    servico.addTo(map)
                }
            }
            else {
                for (let servico of servicosExecutadosImprodutivos) {
                    servico.removeFrom(map);
                }
            }
        });

        $('#iToogleBaixasServico').change(function () {
            if ($(this).is(":checked")) {
                for (let servico of baixasServico) {
                    servico.removeFrom(map);
                    servico.addTo(map)
                }
            }
            else {
                for (let servico of baixasServico) {
                    servico.removeFrom(map);
                }
            }
        });



        

    </script>


}

