                        orderable: false,
                        render: function(data, type, row, meta) {
                            return '<hr>' +
                                    '<div class="container-fluid pl-0 pr-0" style="font-size: 12px; margin-top: -15px; margin-bottom: -22px;">' +
                                        '<div class="row">' +
                                            '<div class="col-sm-4 mt-2">' +
                                            '<div class="pl-2 pr-2 text-truncate">' +
                                                '<i class="fas fa-circle" style="vertical-align: middle; font-size: 16px; margin-top: -2px;color:' + row.cor_StatusEquipe +'"></i> ' +
                                                '<span><b>Colaborador Responsável:</b> ' + row.nome + ' </span>' +
                                            '</div>' +
                                '</div>' +
                                '<div class="col-sm-8" id="iLink"' + meta.row + '" > ' +
                                            '<span class="pl-2 pr-2">' +
                                                    '<span><img class="rotate-45" style="margin-top:10px;" src="../../Images/battery_svg_png/'+ row.icone_Bateria + '.svg" /><b>Bateria:</b> ' + row.bateria + '</span>' + // Status Bateria
                                            '</span>' +
                                            '<span class="pl-2 pr-2">' +
                                                '<span><b>Total de Visitas:</b> ' + row.totalVisitas + ' </span>' +
                                            '</span>' +
                                            '<span class="pl-2 pr-2">' +
                                                '<span><b>Baixadas Produtiva:</b> ' + row.baixadasProdutivas + ' </span>' +
                                            '</span>' +
                                            '<span class="pl-2 pr-2">' +
                                                '<span><b>Baixadas Improdutiva:</b> ' + row.baixadasImprodutivas + ' </span>' +
                                            '</span>' +
                                            '<span class="pl-2 pr-2">' +
                                                '<span><b>Restantes:</b> ' + row.restantes + ' </span>' +
                                            '</span>' +

                                             '<a href="#iLink' + meta.row + '" style="color: #367fa9" data-toggle="tooltip" data-placement="top" title="Técnico no Mapa" onclick="return ExibeMapa(\'' + row.equipe + '\');">' +
                                                     '<i class="icofont-tack-pin" style="vertical-align: middle; font-size: 20px;"></i>' +
                                             '</a > ' +

                                            '<a href="#iLink' + meta.row + '" style="color: #367fa9" data-toggle="tooltip" data-placement="top" title="Ver Mais Detalhes do Técnico"  onclick="return DetalhesEquipe(\'' + row.equipe + '\',\'' + row.nome + '\');">' +
                                                 '<i class="icofont-plus-square" style="vertical-align: middle; font-size: 20px; "></i>' +
                                            '</a > ' +
                                '<a href="#iLink' + meta.row + '" style="color: #367fa9;" data-toggle="tooltip" data-placement="top" title="Expandir" class="btn-expand" id="btnToggle' + row.equipe + '">' +
                                               '<i class="fas fa-arrow-circle-down" style="vertical-align: middle; font-size: 20px; "></i>' +
                                            '</a >' +
                                      '</div>' +
                                        //'<div class="" id="table-responsive' + row.equipe + '">' + /*table-responsive*/
                                        //    "<table class='datatableOS' id='datatableOS" + row.equipe + "'>" +
                                        //'</div>' +
