                        }

                    }

                ]
        });

        $("#btnAtualizar").on('click', function () {
            oDatatable.draw();
            RelogioPainel();
        });

        $("#iLimparFiltros").on('click', function () {

            $("#idSupervisor").val("");
            $("#iDescSupervisor").val("");
            $('#idMonitor').val(null).trigger('change');

            $("#idMonitor").val("");
            $("#iDescMonitor").val("");
            $('#idSupervisor').val(null).trigger('change');
         

            oDatatable.draw();
        });

        $('#datatable tbody tr').css('cursor', 'initial');

        $("#iPesquisar").on("click", function () {
                $("#modal-filter").modal('hide');
                rows_selected = [];


            oDatatable.draw();

                return true;
        });

        $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {

                 $("#iTecnico_Ativos").prop("checked", false);
            $("#iTecnico_Ativos").trigger("change")

                 $("#iTecnico_Execucao").prop("checked", false);
            $("#iTecnico_Execucao").trigger("change")

            $('#iSituacao').val("");
            $('#iSituacao').val(null).trigger('change');

            $("#modal-filter").modal('hide');
                 rows_selected = [];
               oDatatable.draw();
        });

        $("#modal-filter").on("shown.bs.modal", function () {
            $("#iTecnico_Ativos").prop("checked", true);
            $("#iTecnico_Ativos").trigger("change")
        });

        $('#datatable tbody').on('click', '.btn-expand', function () {

            var $row = $(this).closest('tr');

            if (oDatatable.row($row).data() != null) {

                var equipe = oDatatable.row($row).data().equipe;

                //Troca botão de expansão + por -
                if ($("#btn-expand" + equipe).attr('collapsed') == undefined) {

                    $("#btn-expand" + equipe).html('<a href="#" class=""><i class="fas fa-arrow-circle-up text-danger" style="vertical-align: middle; font-size: 20px; "></i></a>');
                    $("#btn-expand" + equipe).attr("collapsed", true);

                    $("#table-responsive" + equipe).show();

                    PreencheOSs(equipe);
                }
                else {
                    $("#btn-expand" + equipe).html('<a href="#" style="color: #367fa9;" class=""><i class="fas fa-arrow-circle-down" style="vertical-align: middle; font-size: 20px; "></i></a>');
                    $("#btn-expand" + equipe).removeAttr("collapsed");

                    $("#table-responsive" + equipe).hide();
                    $("#datatableOS" + equipe).dataTable().fnDestroy();
                }

            }
        });

        //INICIO DATA TABLE DADOS OS
        function PreencheOSs(Id) {


                $("#datatableOS").DataTable({
                    dom: "Bfrti",
                    select: {
                        style: 'multi'
                    },
                    columnDefs: [
                        {
                            targets: 0,
                            searchable: false,
                            orderable: false,
                            //style: 'padding-left: 10px',
                            width: '1%',
                            className: 'dt-body-center',
                            render: function (data, type, row, meta) {
                                var url = '"@Url.Action("Index", "Agendamento")" +"?CodCt=' + row.codCt + '&Pagina=acompanhamento' + '&Projeto=' + row.projeto + '&Num_Obra=' + row.numero_Os + '&Num_Doc=' + row.numero_Doc +'"';
                                var titulo = '"Agendamento"';

                                if (realizaAgendamento && ['@Html.Raw(RsCadastros.ABERTA_AGUARD_ATENDIMENTO)', '@Html.Raw(RsCadastros.OS_EM_DESLOCAMENTO)', '@Html.Raw(RsCadastros.ATENDIMENTO_PARALIZADO)'].includes(row.status_Execucao))
                                    return "<a href='#' data-toggle='tooltip' data-placement='top' title='Reagendar Serviço' onclick='AddAba(" + url + ", " + titulo + ");'><i class='far fa-calendar-alt'></i><a>";
                                else
                                    return "";
                            }
                        }
                    ],
                    order: [[1, 'asc']],
                    serverSide: true,
                    searching: true,
                    processing: true,
                    autoWidth: false,
                    ordering: false,
                    paging: true,
                    deferRender: true,
                    //scrollY: '20vh',
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: baseUrl + '/api/Documento_ProducaoApi/GetOSsAcompamentoEquipe',
                        type: 'POST',
                        data: function (data) {
                            data.Equipe = Id;
                            data.Data = $("#iData_Busca").val();
                            data.Situacao = $("#iSituacao option:selected").val();
                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
                    },
                    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {
                        return "";
                    },
