@model Aniel.Connect.Models.AtendimentoListaModel

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Core

@{
    ViewBag.Title = RsCadastros.PAINEL_ACOMPANHAMENTO_EQUIPE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")

    <style>
        body {
            width: 98%;
        }

        .table td, .table th {
            vertical-align: top;
            border-top: 1px solid #dee2e6;
            padding-right: 10px;
            padding-left: 10px;
            padding-bottom: 0px;
            padding-top: 2px;
        }

        .toggle.btn {
            min-width: 3.7rem !important;
            min-height: 1.7rem !important;
        }

        .rotate-45 {
            -webkit-transform: rotate(90deg);
            -moz-transform: rotate(90deg);
            -ms-transform: rotate(90deg);
            -o-transform: rotate(90deg);
            transform: rotate(90deg);
        }

