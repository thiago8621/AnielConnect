}



@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")



<script>

        var oDatatable = null;
        var realizaAgendamento = @Json.Encode(ViewBag.RealizaAgendamento);

        $(function () {
            $('[data-toggle="tooltip"]').tooltip()
        })

        //Resize toggle button 
        $('#btnToggle').on('click', function () {

            if (this.value === '<') {
                $('#divdatatable').removeClass('col-sm-8');
                $('#divdatatableOS').removeClass('col-sm-4');
                $('#divdatatable').addClass('col-sm-4');
                $('#divdatatableOS').addClass('col-sm-8');

                oDatatable.column(0).visible(false);
                oDatatable.column(1).visible(false);
            

                this.value = '>';

            }
            else {
                $('#divdatatableOS').removeClass('col-sm-8');
                $('#divdatatable').removeClass('col-sm-4');
                $('#divdatatableOS').addClass('col-sm-4');
                $('#divdatatable').addClass('col-sm-8');

                oDatatable.column(0).visible(true);
                oDatatable.column(1).visible(true);
       

                this.value = '<';
            }
        });


         $('input[name=SupervisorMonitor]').change(function () {

             if($('#iRadioSupervisor').is(':checked')){

                 $('#idMonitor').prop('disabled', true);
                 $('#idMonitor').val(null).trigger('change');

                 $('#idSupervisor').prop('disabled', false);
             }
             if($('#iRadioMonitor').is(':checked')){
                 $('#idSupervisor').prop('disabled', true);
                 $('#idSupervisor').val(null).trigger('change');


                 $('#idMonitor').prop('disabled', false);
             }

         });


            "use strict";

        function Relogio() {
            var currentTime = new Date();
            var currentHours = currentTime.getHours();
            var currentMinutes = currentTime.getMinutes();

            var currentDay = currentTime.getDate();
            if (currentDay < 10)
                currentDay = "0" + currentDay;

            var currentMonth = currentTime.getMonth() + 1;
            if (currentMonth < 10)
                currentMonth = "0" + currentMonth;

            var currentYear = currentTime.getFullYear();

            var currentDate = currentDay + "/" + currentMonth + "/" + currentYear;


            if (currentMinutes < 10)
                currentMinutes = "0" + currentMinutes;

            // Compose the string for display
            var currentTimeString = currentDate + " " + currentHours + ":" + currentMinutes;


            $("#relogio").html(currentTimeString);

        }

        function RelogioPainel() {
            var currentTime = new Date();
            var currentHours = currentTime.getHours();
            var currentMinutes = currentTime.getMinutes();

            if (currentMinutes < 10)
                currentMinutes = "0" + currentMinutes;

            // Compose the string for display
            var currentTimeString = currentHours + ":" + currentMinutes;
            var currentTimeString = 'Painel Atualizado às ' + currentTimeString;

            $("#relogioPainel").text(currentTimeString);

        }

        var handleselect = function (e) {

                 $("#" + e.id).on("select2:select select2:unselecting", function (e) {
                    oDatatable.draw();
                })


        }

        $(document).ready(function () {

            AddSelect("idSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false,handleselect(idSupervisor));
            AddSelect("idMonitor", "@CONSTANTES.URLPortal/api/IdentityUserApi/GetComboMonitor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false,handleselect(idMonitor));

            $('#iRadioSupervisor').prop('checked', true);
            $('input[name=SupervisorMonitor]').trigger('change');
            setInterval('Relogio()', 1000);
            RelogioPainel();

            GetTotaisVisitas();

        });

        function GetTotaisVisitas() {

                        var link = baseUrl + '/api/EquipeApi/GetAllAcompanhamentoEquipe';
                            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    Area: null,
                    GrupoArea: null,
                    Id_Natureza: null,
                    Localidade: null,
                    Monitor: null,
                    Supervisor: null,
                    Tecnico_Ativos: null,
                                    Tecnico_Em_Execucao: null,
                                    columns: [{ data: '0', name: null, orderable: false, search: [{ regex: false, value: null }], searchable: false }],
                    draw: 1,
                    length: 10,
                    order: [{ column: 1, dir: 'asc' }],
                    recordsTotal: 0,
                    search: { regex: false, value: null },
                    start: 0,

                }
            })
                .done(function (data) {

                    var totalVisitas = 0; var totalVisitasProdutivas = 0; var totalVisitasImprodutivas = 0;
                    var totalVisitasProdutivasPercentual = 0;var totalVisitasImprodutivasPercentual = 0;

                    if (data.data != undefined) {
                        for (var i = 0; i < data.data.length; i++) {
                            totalVisitas = totalVisitas + parseInt(data.data[i].totalVisitas);
                            totalVisitasProdutivas = totalVisitasProdutivas + parseInt(data.data[i].baixadasProdutivas);
                            totalVisitasImprodutivas = totalVisitasImprodutivas + parseInt( data.data[i].baixadasImprodutivas );
                        }
                        $('#spnTotalVisitas').text(totalVisitas);
                        $('#spnTotalVisitasProdutivas').text(totalVisitasProdutivas);
                        $('#spnTotalVisitasImprodutivas').text(totalVisitasImprodutivas);

                        totalVisitasProdutivasPercentual = (totalVisitasProdutivas / totalVisitas) * 100;
                        totalVisitasImprodutivasPercentual = (totalVisitasImprodutivas / totalVisitas) * 100;

                        if (!isNaN(totalVisitasProdutivasPercentual)) {
                            var num = totalVisitasProdutivasPercentual
                            $('#spnTotalVisitasProdutivasPercentual').text(totalVisitasProdutivasPercentual.toFixed(2));
                        }
                        else {
                            $('#spnTotalVisitasProdutivasPercentual').text(0);
                        }

                        if (!isNaN(totalVisitasImprodutivasPercentual)) {
                            var num = totalVisitasProdutivasPercentual
                            $('#spnTotalVisitasImprodutivasPercentual').text(totalVisitasImprodutivasPercentual.toFixed(2));
                        }
                        else {
                            $('#spnTotalVisitasImprodutivasPercentual').text(0);
                        }

                    }
                    else {
                        @*Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");*@
                    }
                })
                

        }

        function atualizaTotais(data) {
            var totalVisitas = 0; var totalVisitasProdutivas = 0; var totalVisitasImprodutivas = 0;
            var totalVisitasProdutivasPercentual = 0; var totalVisitasImprodutivasPercentual = 0;

            if (data != undefined) {
                for (var i = 0; i < data.length; i++) {
                    totalVisitas = totalVisitas + parseInt(data[i].totalVisitas);
                    totalVisitasProdutivas = totalVisitasProdutivas + parseInt(data[i].baixadasProdutivas);
                    totalVisitasImprodutivas = totalVisitasImprodutivas + parseInt(data[i].baixadasImprodutivas);
                }
                $('#spnTotalVisitas').text(totalVisitas);
                $('#spnTotalVisitasProdutivas').text(totalVisitasProdutivas);
                $('#spnTotalVisitasImprodutivas').text(totalVisitasImprodutivas);

                totalVisitasProdutivasPercentual = (totalVisitasProdutivas / totalVisitas) * 100;
                totalVisitasImprodutivasPercentual = (totalVisitasImprodutivas / totalVisitas) * 100;

                if (!isNaN(totalVisitasProdutivasPercentual)) {
                    var num = totalVisitasProdutivasPercentual * 100
                    $('#spnTotalVisitasProdutivasPercentual').text(totalVisitasProdutivasPercentual.toFixed(2));
                }
                else {
                    $('#spnTotalVisitasProdutivasPercentual').text(0);
                }

                if (!isNaN(totalVisitasImprodutivasPercentual)) {
                    var num = totalVisitasImprodutivasPercentual * 100
                    $('#spnTotalVisitasImprodutivasPercentual').text(totalVisitasImprodutivasPercentual.toFixed(2));
                }
                else {
                    $('#spnTotalVisitasImprodutivasPercentual').text(0);
                }
            }
        }

        $("#iDescMonitor").autocomplete({
            source: "@(CONSTANTES.URLPortal + "/api/IdentityUserapi/busca")",
            dataType: "json",
            minLength: 2,
            focus: function () { return false; },
            open: function () {
                setTimeout(function () {
                    $('.ui-autocomplete').css('z-index', 99999999999999);
                }, 0);
            },
            select: function (event, ui) {
                var obj = ui.item;
                $("#idMonitor").val(obj.value);
                $("#iDescMonitor").val(obj.label);
                oDatatable.draw();
                RelogioPainel();
                return false;
            },
            change: function (event, ui) {
                if (!ui.item) {
                    $("#idMonitor").val(null);
                    $("#iDescMonitor").val(null);
                    oDatatable.draw();
                }
                return false;
            }
        });

        $("#iDescSupervisor").autocomplete({
            source: "@(CONSTANTES.URLPortal + "/api/FuncionarioAnielapi/buscaSupervisor")",
            dataType: "json",
            minLength: 2,
            focus: function () { return false; },
            open: function () {
                setTimeout(function () {
                    $('.ui-autocomplete').css('z-index', 99999999999999);
                }, 0);
            },
            select: function (event, ui) {
                var obj = ui.item;
                $("#idSupervisor").val(obj.value);
                $("#iDescSupervisor").val(obj.label);
                oDatatable.draw();
                RelogioPainel();
                GetTotaisVisitas();
                return false;
            },
            change: function (event, ui) {
                if (!ui.item) {
                    $("#idSupervisor").val(null);
                    $("#iDescSupervisor").val(null);
                    oDatatable.draw();
                    GetTotaisVisitas();
                }
                return false;
            }
        });



        function ExibeMapa(equipe) {

            @*ShowDialog(true, true, 'Mapa', '@Url.Action("Equipes", "Mapa")' + '?Equipe=' + equipe, 'mapa', 800, 500, 'iframeMapa');*@

            var url = "@Url.Action("Mapa_Equipes", "Gestao_Equipe")" + "?Equipe=" + equipe + "&Pagina=Acompanhamento";

            window.location = url;

            return false;
        }


        function DetalhesEquipe(equipe, nome) {

            ShowDialog(true, true, nome, '@Url.Action("EquipeStatus", "Equipe")' + '?Equipe=' + equipe, 'equipe', 700, 330, 'iframeEquipe');
            return false;
        }

        oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        sortable: false,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                processing: true,
                deferRender: true,
                //scrollY: '65vh',
                //scroller: {
                //    loadingIndicator: true
                //},
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/EquipeApi/GetAllAcompanhamentoEquipe',
                    type: 'POST',
                    data: function (data) {
                        data.Supervisor = $("#idSupervisor").val();
                        data.Monitor = $("#idMonitor").val();



                        var tecnico_ativos = $("#iTecnico_Ativos").val();
                        var tecnico_execucao = $("#iTecnico_Execucao").val();

                        if (!$("#iTecnico_Ativos").is(':checked'))
                            tecnico_ativos = null;
                        if (!$("#iTecnico_Execucao").is(':checked'))
                            tecnico_execucao = null;

                        

                        data.Tecnico_Ativos = tecnico_ativos;
                        data.Tecnico_Em_Execucao = tecnico_execucao;


                    },
                    error: function (ex) {
                        $("#datatable_processing").hide();
                        Notificar("@RsBase.ATENCAO_", ex.responseJSON.exceptionMessage, "warning");
                    },
                    dataSrc: function (d) {
                        atualizaTotais(d.data);
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    {
                        title: "<!--<input name='select_all' value='1' type='checkbox'>-->",
                        orderable: false
                    },
                    {
                        data: "equipe",
