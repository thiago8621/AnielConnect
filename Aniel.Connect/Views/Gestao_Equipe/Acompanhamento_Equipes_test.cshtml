                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTable,
                    columns: [
                        { title: "<!--<input name='select_all' value='1' type='checkbox'>-->" },
                        {
                            data: "numero_Os_Original",
                            title: "@RsConfiguracao.NUMERO_OS",
                            render: function (data, type, row, meta) {
                                var url = '"@Url.Action("Index", "Acompanhamento_Servico")" +"?CodCt=' + row.codCt + '&Pagina=acompanhamento' + '&Projeto=' + row.projeto + '&Num_Obra=' + row.numero_Os + '&Num_Doc=' + row.numero_Doc +'"';
                                var titulo = '"@RsCadastros.GESTAO_EQUIPES"';

                                if (['@RsCadastros.ABERTA_AGUARD_ATENDIMENTO', '@RsCadastros.OS_EM_DESLOCAMENTO', '@RsCadastros.ATENDIMENTO_PARALIZADO'].includes(row.status_Execucao))
                                    return "<a href='#' data-toggle='tooltip' data-placement='top' title='"+ "@RsCadastros.ACOMPANHAMENTO_SERVICO" + "' onclick='AddAba(" + url + ", " + titulo + ");'>"+ data +"<a>";
                                else
                                    return "<a href='#' data-toggle='tooltip' data-placement='top' title='"+ "@RsCadastros.ACOMPANHAMENTO_SERVICO" + "' onclick='AddAba(" + url + ", " + titulo + ");'>"+ data +"<a>";
                            }
                        },

                        { data: "data_Agendamento", title: "@RsConfiguracao.DATA_AGENDAMENTO" },

                        { data: "tipo_Servico", title: "@RsConfiguracao.TIPO_SERVICO" },
                        {
                            data: "slA_Servicos",
                            title: "@RsConfiguracao.SLA_SERVICOS",
                            render: function (data, type, row, meta) {
                                return "<span title='"+ row.dataHora_Indicador +"'>" + data +"</span>";
                            }
                        },
                        { data: "status_Execucao", title: "@RsConfiguracao.STATUS_EXECUCAO" },
                        { data: "assinante", title: "@RsConfiguracao.ASSINANTE" },
                        { data: "endereco", title: "@RsCadastros.ENDERECO" },
                        { data: "numero", title: "@RsCadastros.NUMERO" },
                        { data: "deslocamento", title: "@RsConfiguracao.DESLOCAMENTO" },
                        { data: "inicio_Atendimento", title: "@RsConfiguracao.INICIO_ATENDIMENTO" },
                        { data: "fim_Atendimento", title: "@RsConfiguracao.FIM_ATENDIMENTO" },
                        { data: "tempo_Execucao", title: "@RsConfiguracao.TEMPO_EXECUCAO" },
                        { data: "tempo_Paralizacoes", title: "@RsConfiguracao.TEMPO_PARALIZACAO" },
                        { data: "duracao_Total_Visita", title: "@RsConfiguracao.DURACAO_TOTAL_VISITA" }
                    ]
                });

        };




</script>
}


