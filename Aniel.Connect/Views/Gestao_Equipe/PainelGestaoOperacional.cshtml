            function somar(total, number) {

                number = isFloat(number) ? parseFloat(number) : (isNaN(number) ? number : Number(number));
                return total + number;
            }

            function isFloat(n) {
                return Number(n) === n && n % 1 !== 0;
            }

            function ordenarDados(keys,arrayDados,dadosTecnico)
            {
                if (keys.find(p => p === "localidadeStr"))
                {
                    return arrayDados.sort(function (a, b) {

                        let AdescricaoEscritorio = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == a[0])?.descricao_Escritorio ?? dados.servicos.find(p => p.cod_Escritorio == a[0]).descricao_Grupo_Area;
                        let BdescricaoEscritorio = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == b[0])?.descricao_Escritorio ?? dados.servicos.find(p => p.cod_Escritorio == b[0]).descricao_Grupo_Area;

                        if (AdescricaoEscritorio === BdescricaoEscritorio)
                        {
                            let AdescricaoArea = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Area == a[1])?.descricao_Area ?? dados.servicos.find(p => p.cod_Escritorio == a[0] && p.cod_Area == a[1]).descricao_Grupo_Area;
                            let BdescricaoArea = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Area == b[1])?.descricao_Area ?? dados.servicos.find(p => p.cod_Escritorio == b[0] && p.cod_Area == b[1]).descricao_Grupo_Area;

                            if (AdescricaoArea === BdescricaoArea)
                            {
                                let AlocalidadeStr = a[2]
                                let BlocalidadeStr = b[2]
                                return AlocalidadeStr.localeCompare(BlocalidadeStr);
                            }

                            return AdescricaoArea.localeCompare(BdescricaoArea);
                        }


                        return AdescricaoEscritorio.localeCompare(BdescricaoEscritorio);

                    });
                }
                else if (keys.find(p => p === "cod_Area")) {
                    return arrayDados.sort(function (a, b) {

                        let AdescricaoEscritorio = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == a[0])?.descricao_Escritorio ?? dados.servicos.find(p => p.cod_Escritorio == a[0]).descricao_Grupo_Area;
                        let BdescricaoEscritorio = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == b[0])?.descricao_Escritorio ?? dados.servicos.find(p => p.cod_Escritorio == b[0]).descricao_Grupo_Area;

                        if (AdescricaoEscritorio === BdescricaoEscritorio) {
                            let AdescricaoArea = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == a[0] && p.cod_Area == a[1])?.descricao_Area ?? dados.servicos.find(p => p.cod_Escritorio == a[0] && p.cod_Area == a[1]).descricao_Grupo_Area
                            let BdescricaoArea = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == b[0] && p.cod_Area == b[1])?.descricao_Area ?? dados.servicos.find(p => p.cod_Escritorio == b[0] && p.cod_Area == b[1]).descricao_Grupo_Area

                            return AdescricaoArea.localeCompare(BdescricaoArea);
                        }


                        return AdescricaoEscritorio.localeCompare(BdescricaoEscritorio);

                    });
                }
                else if (keys.find(p => p === "cod_Escritorio")) {

                    return arrayDados.sort(function (a, b) {

                        let AdescricaoEscritorio = dadosTecnico.map(p => p.localidades).flat().find(p => p.cod_Escritorio == a[0])?.descricao_Escritorio ?? dados.servicos.find(p => p.cod_Escritorio == a[0]).descricao_Grupo_Area
