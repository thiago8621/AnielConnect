        async function GetDados(keys)
        {
            const link = '@String.Concat(CONSTANTES.URLPortal, "/api/PlanejamentoCapacidadeRoteirizacaoApiController/GestaoOperacional")';
            let resultado = dados == null ? await $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    data: $('#iDataFimDemanda').val(),
                    contrato: $('#iContrato').val(),
                    projeto: $('#iProjeto').val(),
                    equipe: $('#iEquipe').val(),
                    grupoArea: $("#iGrupoArea").val(),
                    area: $("#iArea").val(),
                    localidade: $("#iLocalidade").text(),
                    natureza: $("#iNaturezaProducao").val(),
                    tipoServico: $("#iTipoServico").val(),
                    supervisor: $("#iSupervisor").val(),
                    monitor: $("#iMonitor").val(),
                    periodo: $("#iPeriodo").val(),
                    dataInicioDemanda: $('#iDataInicioDemanda').val()
                }
            }) : dados;

            let tecnicosTemp = resultado.tecnicos.map(p => {

                for (let localidade of p.localidades) {



                    localidade.nome = p.nome;
                    localidade.equipe = p.equipe;
                    localidade.escalado = p.escalado;
                    localidade.tipoHabilidade = p.tipoHabilidade;
                    localidade.usuario_Monitor = p.usuario_Monitor;
                    localidade.numFre_Supervisor = p.numFre_Supervisor;
                    localidade.horasTrabalhadasHorario = p.horasTrabalhadasHorario;
                    localidade.idPerfilAgendamento = p.idPerfilAgendamento;

                }
                return p.localidades;
            }).flat();




            let tecnicosUnique = tecnicosTemp.filter(function ({ equipe, cod_Escritorio, cod_Area, localidade, numFre_Supervisor, usuario_Monitor, periodo }) {

                let valor = null;
                if (keys.find(y => y === "cod_Escritorio")) {
                    valor = equipe + cod_Escritorio;
                }
                else if (keys.find(y => y === "cod_Area")) {
                    valor = equipe + cod_Escritorio + cod_Area;
                }
                else if (keys.find(y => y === "localidade")) {
                    valor = equipe + cod_Escritorio + cod_Area + localidade;
                }
                else if (keys.find(y => y === "numFre_Supervisor")) {
                    valor = equipe + numFre_Supervisor;
                }
                else if (keys.find(y => y === "usuario_Monitors")) {
                    valor = equipe + usuario_Monitor;
                }
                else if (keys.find(y => y === "equipe")) {
                    valor = equipe;
                }
                else if (keys.find(y => y === "periodo")) {
                    valor = periodo;
                }

                return !this.has(valor) && this.add(valor);

            }, new Set);




            let retorno = {
                tecnicos: resultado.tecnicos,
                tecnicosUnique: tecnicosUnique,
                servicos: resultado.servicos,
                minutosHorarioTrabalhoPadrao: resultado.minutosHorarioTrabalhoPadrao
            };

            @* Limpa os filtros anteriores e grava os filtros utilizados para carregar o relatório *@
            localStorage.removeItem(STORAGE_FILTER_KEY);
            saveFilters();

            return retorno;


        }

        function GetKeys() {


            if ($('#iFormatoVisu').val() == "0") {
                const valor = $('input[name=AreaAtuacaoFormato]:checked').val();
                if (valor === "grupoarea") {
                    return ["cod_Escritorio"]
                }
                else if (valor === "area") {
                    return ["cod_Escritorio", "cod_Area"]
                }
                else if (valor === "localidade") {
                    return ["cod_Escritorio", "cod_Area", "localidadeStr"]
                }
            }
            else if ($('#iFormatoVisu').val() == "1")
            {
                return ["numFre_Supervisor"];
            }
            else if ($('#iFormatoVisu').val() == "2")
            {
                return ["usuario_Monitor"];
            }
            else if ($('#iFormatoVisu').val() == "3") {
                return ["equipe"];
            }
            else if ($('#iFormatoVisu').val() == "4") {
                return ["periodo"];
            }
        }

        "use strict";

    function Agrupar(lista,keys) {
        let resultado = lista.reduce((r, object) => {
            keys.reduce((group, key, index, { length }) =>
                group[object[key]] = group[object[key]] || (index + 1 === length
                    ? []
                    : {}
                ), r)
                .push(object);
            return r;
        }, {});

        return resultado
    }

    function ResizeTablePainel(idDivTable) {
        if (typeof $("#" + idDivTable) !== "undefined") {
            var ht = $(window).height();
            var $header = 20;
            var $title = $("#divTitle");

            var height = ht - $header - $title.outerHeight();

            $("#" + idDivTable).css({
                height: height
            });
        }
    }

    function MinutosParaTempo(minutos)
    {
        let negativo = minutos < 0 ? true : false;

        if (negativo) {
            minutos = Math.abs(minutos);
        }

        let m = minutos % 60;
        let h = (minutos - m) / 60;
        let HHMM = h.toString() + ":" + (m < 10 ? "0" : "") + m.toString();

        if (negativo) {
            HHMM = '-' + HHMM;
        }

        return HHMM;
    }

        function TempoParaMinutos(tempo)
        {
            var hms = tempo;   // your input string
            var a = hms.split(':'); // split it at the colons

            // Hours are worth 60 minutes.
            return minutes = (+a[0]) * 60 + (+a[1]);


        }



