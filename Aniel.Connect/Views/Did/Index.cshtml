@using Resources
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.LISTAGEM_DIDS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

       $('#btnLog').on('click', function () {

            let _url = `@Url.Action("Index", "LogGenerico")?Modelo=4`;

            AddAba(_url, "@( String.Format(RsFinanceiro.LOGDE, RsCadastros.DID) )");
        });

        var rows_selected = [];

        var handleDataTableButtons = function () {
            "use strict";

            //"Blfrtip"

            //if ($("#datatable").length != null && $("#datatable").length < 1) {
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/DidApi/GetAll',
                    type: 'POST',
                    data: function (data) {
                        var status = $("#iStatusDidFilter").val();
                        var numero = $("#iNumerosDidFilter").text();
                        var uf = $("#iUfDidFilter").val();
                        var cidade = $("#iCidadeDidFilter").val();
                        var pais = $("#iPaisDidFilter").val();

                        data.Status = status;
                        data.Numero = numero;
                        data.Uf = uf;
                        data.Cidade = cidade;
                        data.Pais = pais;
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "id", title: "@RsCadastros.CODIGO",orderable: false },
                    { data: "numero", title: "@RsCadastros.NUMERO", orderable: false },
                    { data: "pais", title: "@RsCadastros.PAIS", orderable: false },
                    { data: "uf", title: "@RsCadastros.UF", orderable: false },
                    { data: "cidade", title: "@RsCadastros.CIDADE", orderable: false },
                    { data: "status", title: "@RsCadastros.STATUS", orderable: false },
                    { data: "reservado_DDR", title: "@RsCadastros.RESERVADO_DDR", orderable: false }
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });
            $("#iPesquisar").on("click", function () {
                $("#modal-filter").modal('hide');

                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();

                return true;
            });

             // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function () {
                @if (!AcessoHelper.TemAcesso(_areas, "218")) {
                    <text>
                Notificar("@RsBase.ATENCAO_", "@RsBase.NAO_POSSUI_AREA_ACESSO", "warning");
                return false;
                    </text>

                }


                if (oDatatable.row(this).data() != null) {

                    var _id = oDatatable.row(this).data().id;

                    var url = '@Url.Action("Cadastro", "Did", new { id = "__id__" })';
                    window.location.href = url.replace('__id__', _id);
                    ShowPageLoading();
                }


            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

            $("#iLimparFiltros").on("click", function () {

                $('#txtSearch').val('');
                $("#iStatusDidFilter").val('');
                $("#iUfDidFilter").val('');

                $("#iNumerosDidFilter").val(null).trigger('change');
                $("#iCidadeDidFilter").val(null).trigger('change');
                $("#iPaisDidFilter").val(null).trigger('change');

                oDatatable.search('').draw(false);
            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

    TableManageButtons.init();

        function acessoCadastro() {
            @if (AcessoHelper.TemAcesso(_areas, "213"))
            {
            <text>
        ShowPageLoading();

        var url = "@Url.Action("Cadastro", "Did")";
        window.location.href = url;
        </text>

            } else { <text>Notificar("@RsBase.ATENCAO_", "Sem Acesso", "warning");</text> }

        }


        $(document).ready(function () {
            AddSelect("iCidadeDidFilter", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades", "@CONSTANTES.PaginacaoRegistros", null, null, null, "@RsBase.TODOS", false);
            AddSelect("iPaisDidFilter", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboPais", "@CONSTANTES.PaginacaoRegistros", null, null, null, "@RsBase.TODOS", false);
            AddSelect("iNumerosDidFilter", "@CONSTANTES.URLPortal/api/DidApi/GetComboNum_Did", "@CONSTANTES.PaginacaoRegistros", null, null, null, "@RsBase.TODOS", false);
        });

    </script>

}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-phone"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GESTAO_CONEXOES</a>
                    </li>

                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

            @*<span style="font-size:11px;margin-left: 15px;" id="dtLegend"></span>*@
        </div>

        <div class="col-auto mb-3">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.NUMERO" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>

                <a class="btn btn-success btn-add" title="@RsBase.INCLUIR" onclick="acessoCadastro(); return true;"><i class="la la-plus" style="color: #fff"></i></a>

                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltros" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="@Url.Action("Cadastro_Intervalo", "Did")">Importar por Intervalo</a>
                    <a class="dropdown-item" href="@Url.Action("Did_Planilha", "Did")">Importar DID por planilha</a>
                    <a class="dropdown-item" id="btnLog" href="#">@RsBase.LOG_ALTERACOES</a>

                </div>
            </div>
        </div>

    </div>

    <!--./main-->
</div>

<!--Modal Filters-->
<div class="modal" id="modal-filter">
    <div class=" modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted pr-2">Filtros DID</h4>
                @*<i class="fas fa-key mt-1"></i>*@
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-sm-6">

                        <div class="form-group">
                            <label for="iServ_Internet">@RsCadastros.STATUS: </label>
                            @{ IList<SelectListItem> Lista_StatusDid = EnumHelper.GetSelectList(typeof(StatusDid));}

                            @Html.DropDownList("StatusDidFilter", Lista_StatusDid, RsBase.TODOS, new { @class = "form-control filtro", @id = "iStatusDidFilter", @autocomplete = "off" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">

                            <label for="iServ_TV">@RsCadastros.NUMERO: </label>
                            @Html.DropDownList("NumerosDidFilter", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), new { @class = "form-control filtro", @id = "iNumerosDidFilter", @autocomplete = "off" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iServ_Movel">@RsCadastros.PAIS:</label>
                            @Html.DropDownList("PaisDidFilter", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { @class = "form-control filtro", @id = "iPaisDidFilter", @autocomplete = "off" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iServ_Fixo">@RsCadastros.CIDADE:</label>
                            @Html.DropDownList("CidadeDidFilter", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { @class = "form-control filtro", @id = "iCidadeDidFilter", @autocomplete = "off" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iServProd">@RsCadastros.UF:</label>
                            @*Código de Criação de um selectList mais manual*@

                            @{ List<SelectListItem> ListaUfs = @"AC/AL/AP/AM/BA/CE/DF/ES/GO/MA/MT/MS/MG/PA/PB/PR/PE/PI/RJ/RN/RS/RO/RR/SC/SP/SE/TO".ToString().Split('/').Select((p) =>
                                     new SelectListItem { Text = p, Value = p }).ToList();}


                            @Html.DropDownList("UfDidFilter", (ListaUfs), RsBase.TODOS, new { @class = "form-control filtro", @id = "iUfDidFilter", @autocomplete = "off" })
                        </div>
                    </div>
                </div>
                <div class="row text-center">
                    <div class="form-group col-sm-12" style="padding: 15px;">
                        <div class="text-center">
                            <button id="iPesquisar" type="button" class="btn btn-success" onclick="">@RsCadastros.PESQUISAR</button>
                        </div>
                    </div>

                </div>


            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>

