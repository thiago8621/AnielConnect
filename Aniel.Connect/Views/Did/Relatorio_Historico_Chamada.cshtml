@model Aniel.Connect.Models.DidCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_DIDS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{

    <script>


        
        
        $(document).ready(async function () {

            
        });

        let clicked = false
        let erro = false
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();


        }

    </script>
}


    @Html.AntiForgeryToken()

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-phone"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GERENCIAMENTO_REDE</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Did")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_DIDS</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <div id="accordion">
                    <div class="card div-card-accord">
                        <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iRota">Tipo de Discagem:</label>
                                            <br/>
                                            @Html.RadioButtonFor(m => m.TipoDiscagem, Aniel.Connect.Model.enumerado.TipoDiscagem.SCM) <label class="pr-2">@RsCadastros.SCM</label>
                                            @Html.RadioButtonFor(m => m.TipoDiscagem, Aniel.Connect.Model.enumerado.TipoDiscagem.STFC) <label class="pr-2">@RsCadastros.STFC</label>
                                            @Html.RadioButtonFor(m => m.TipoDiscagem, Aniel.Connect.Model.enumerado.TipoDiscagem.Dinamico) <label class="pr-2">@RsCadastros.ROTA_DINAMICA</label>
                                        </div>
                                    </div>
                                    <div class="col-sm-3" id="iColunaRota" style="display:none">
                                        <div class="form-group">
                                            <label for="iRota">Rota:</label>
                                            @Html.DropDownListFor(model => model.IdRota, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iRota", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.IdRota, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iNumero">@RsCadastros.NUMERO:</label>
                                            @Html.TextBoxFor(model => model.Numero, new { @class = "form-control", @id = "iNumero", @autocomplete = "off", @maxlength = "100" })
                                            @Html.ValidationMessageFor(model => model.Numero, "", new { @class = "text-danger" })
                                        </div>
                                    </div>


                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iValor">@RsCadastros.VALOR:</label>
                                            @Html.TextBoxFor(model => model.Valor, new { @class = "form-control money", @id = "iValor", @autocomplete = "off", @maxlength = "100" })
                                            @Html.ValidationMessageFor(model => model.Valor, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iStatusDid">@RsCadastros.STATUS:</label>
                                            @Html.EnumDropDownListFor(m => m.StatusDid, RsBase.SELECIONE, new { @class = "form-control", @id = "iStatusDid", @autocomplete = "off" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2" id="iColunaMotivoIndisponivel" style="display:none">
                                        <div class="form-group">
                                            <label for="iMotivoIndisponivel">@RsCadastros.MOTIVO:</label>
                                            @Html.TextBoxFor(m => m.MotivoIndisponivel, new { @class = "form-control", @id = "iMotivoIndisponivel", @autocomplete = "off" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2" id="iColunaDiaLiberado" style="display:none">
                                        <label for="iDiaLiberado" class="fs-12">Dia liberado:</label>
                                        <div class="form-group">
                                            @Html.TextBoxFor(m => m.DiaLiberado, RsBase.SELECIONE, new { @class = "form-control datepicker", @id = "iDiaLiberado", @autocomplete = "off" })
                                        </div>
                                    </div>


                                </div>

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iChamadaCobrar">Aceita Chamada a Cobrar:</label>
                                            @Html.CheckBoxFor(model => model.ChamadaCobrar, new { @class = "form-control", @id = "iChamadaCobrar", @name = "iEncerrar_Atendimento_Junto_OS", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iPais">@RsCadastros.PAIS:</label>
                                            @Html.DropDownListFor(model => model.IdPais, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iPais", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.IdPais, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iUF">@RsCadastros.UF:</label>
                                            <select class="form-control endereco" name="UF" id="iUF" autocomplete="off">
                                                <option value="" selected>@RsBase.SELECIONE</option>
                                                <option value="AC">AC</option>
                                                <option value="AL">AL</option>
                                                <option value="AP">AP</option>
                                                <option value="AM">AM</option>
                                                <option value="BA">BA</option>
                                                <option value="CE">CE</option>
                                                <option value="DF">DF</option>
                                                <option value="ES">ES</option>
                                                <option value="GO">GO</option>
                                                <option value="MA">MA</option>
                                                <option value="MT">MT</option>
                                                <option value="MS">MS</option>
                                                <option value="MG">MG</option>
                                                <option value="PA">PA</option>
                                                <option value="PB">PB</option>
                                                <option value="PR">PR</option>
                                                <option value="PE">PE</option>
                                                <option value="PI">PI</option>
                                                <option value="RJ">RJ</option>
                                                <option value="RN">RN</option>
                                                <option value="RS">RS</option>
                                                <option value="RO">RO</option>
                                                <option value="RR">RR</option>
                                                <option value="SC">SC</option>
                                                <option value="SP">SP</option>
                                                <option value="SE">SE</option>
                                                <option value="TO">TO</option>
                                            </select>
                                            @Html.ValidationMessageFor(model => model.UF, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iCidade">@RsCadastros.CIDADE:</label>
                                            @Html.DropDownListFor(model => model.IdCidade, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iCidade", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.IdCidade, "", new { @class = "text-danger" })
                                        </div>
                                    </div>


                                </div>


                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Did")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>

    </div>

