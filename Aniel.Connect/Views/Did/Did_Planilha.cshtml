@model  Sinapse.Util.ExcelServiceLog<Aniel.Connect.Models.Did_PlanilhaImportacao>
@{
    ViewBag.Title = "Importar Dids por Planilha";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    ViewBag.Modelo_Paises_Estados_Municipios = CONSTANTES.URLPortal + @"/Arquivos/Did/Tabela_Paises_Estados_Municipios.xlsx";
    ViewBag.Modelo_Did = CONSTANTES.URLPortal + @"/Arquivos/Did/Planilha Padrao DID.xlsx";
}

@section styles
{
    <style>
        .pattern {
            font-size: 12px;
        }
    </style>
}
@section scripts
{

    <script>
        var clicked = false;
          function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;
            var erro = false;

              myfile = $("#iUploadPlanilha").val();
            if (!myfile) {

                if ($('#iUploadPlanilha').next('.custom-file-label').html() == '') {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ARQUIVO)", "warning");
                    erro = true;
                }
                else {

                    var ext = $('#iUploadPlanilha').next('.custom-file-label').html().split('.').pop();
                    if (!(ext == "xlsx" || ext == "xls")) {

                        Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                        erro = true;
                    }
                }
            }
            else {

                var ext = myfile.split('.').pop();
                if (!(ext == "xlsx" || ext == "xls")) {

                    Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                    erro = true;
                }
            }

            if (erro) {

                clicked = false;
                return false;
            }

            $("#divProgress").show();

            $('#form').submit();
        } 

        $("#iBotaoUpload").on('click', function () { $("#iUploadPlanilha").trigger('click'); })
    </script>
}



@Html.AntiForgeryToken()

@*@Html.HiddenFor(model => model.Id)*@

<div style="padding:10px">
    <div class="card" style="border:none;">
        <div class="card-body">
            <div class="row">
                <div class="col main-title">
                    <h4 class="title-page"><i class="fas fa-download"></i> @ViewBag.Title</h4>
                    <nav aria-label="breadcrumb" class="mb-20">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GESTAO_CONEXOES</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index", "Did")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_DIDS</a>
                            </li>
                            <li class="breadcrumb-item">
                                <span>@ViewBag.Title</span>
                            </li>
                        </ol>
                    </nav>
                </div>
            </div>

            <div id="accordion">
                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card fs-1" style="font-size:15px">Para importar DID siga os seguintes passos</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body">
                            <div class="row">
                                <div class="col">
                                    <div class="form-group" style="font-size:12px">
                                        <p class="pattern"> 1 - Faça o download da planilha padrão; </p>
                                        <p class="pattern"> 2 - A primeira linha da planilha está preenchida com um exemplo para auxiliá-lo no preenchimento; </p>
                                        <p class="pattern"> 3 - Apague o exemplo e preencha a planilha com os dados dos DID's que deseja importar para o cadastro;</p>
                                        <p class="pattern">
                                            4 - Verifique a nomenclatura dos
                                            <a href="@ViewBag.Modelo_Paises_Estados_Municipios">Países, Estados e Municípios</a>
                                            cadastrados no sistema para o preenchimento correto;
                                        </p>
                                        <p class="pattern"> 5 - Para saber mais informações sobre os campos, clique no ícone informativo no canto superior direito da tela; </p>
                                        <p class="pattern"> 6 - Ao preencher a planilha, salve em seu computador e faça o Upload do arquivo; </p>
                                        <p class="pattern"> 7 - Ao final do processo será exibido um log de registros importados e não importados. </p>

                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col align-items-center">
                                    <button type="button" class="btn btn-primary" onclick="location.href= '@ViewBag.Modelo_Did'">@RsPontoEletronico.DOWNLOADPLANILHAPADRAO</button>
                                    <button type="button" id="iBotaoUpload" class="btn btn-success">@RsPontoEletronico.UPLOAD_PLANILHA</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
    @using (Html.BeginForm("Did_Planilha", "Did", FormMethod.Post, new { enctype = "multipart/form-data", @id = "form", autocomplete = "off" }))
    {
        @*@Html.AntiForgeryToken()*@

        <!--Modal Filters-->
        <input type="file" id="iUploadPlanilha" class="d-none" name="Planilha">

        <div class="modal" id="modal-filter">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title text-muted">@RsCadastros.UPLOADPLANILHAPROSPECTOS</h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">

                        <div class="row">

                            <div class="col-sm-12">

                                <div class="row">

                                    <div class="col-sm-12">
                                        <div class="form-group">
                                            <label><strong>@RsCadastros.ARQUIVO</strong></label>
                                            <div class="input-group mb-3">
                                                <input type="file" class="custom-file-input" name="Arquivo" id="iArquivo" />
                                                <label for="Arquivo" id="arquivoi" class="custom-file-label"><i class="fas fa-upload"></i> @RsBase.ESCOLHAUMARQUIVO</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="form-group col-sm-12" style="padding: 15px;">
                            <div class="text-center">
                                <button type="button" class="btn btn-danger" id="iLimparFiltroModal" data-dismiss="modal">@RsBase.CANCELAR</button>
                                <button type="button" class="btn btn-success" id="iImportar" onclick="return ValidaSubmit();">@RsBase.IMPORTAR</button>
                            </div>
                        </div>

                    </div>

                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal-->
    }

    <!--Button Float-->
    <a href="@Url.Action("Index", "Did")" class="float-cancel" onclick="ShowPageLoading(); return true;">
        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
            <i class="fas fa-times fa-2x"></i>
        </div>
    </a>

    <a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
            <i class="fas fa-save fa-2x"></i>
        </div>
    </a>

</div>


