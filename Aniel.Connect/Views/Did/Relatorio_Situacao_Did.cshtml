                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iSituacao">@RsCadastros.DID</label>
                                        @Html.DropDownList("iDid", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { Id = "iDid", @class = "form-control", @placeholder = "Todos", @autocomplete = "off" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-sm-12" style="padding: 10px;">
