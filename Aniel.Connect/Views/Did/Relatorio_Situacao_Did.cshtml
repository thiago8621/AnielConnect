    <div class="modal" id="modal-filter">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-sm-12" style="align-content:center;">
                            <div class="row" style="align-content:center;">
                                <!--Período Situacao DID-->
                                <div class="row pl-4 ml-4">
                                    <div class="col ">
                                        <div class="form-group">
                                            <label for="iDataInicio">@RsCadastros.PERIODO:</label>
                                            <input class="form-control obrigatorio datepicker-period mb-1"
                                                   id="iDataInicio"
                                                   type="text"
                                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                                   data-startdate="@(DateTime.Now.AddYears(-1).ToString())"
                                                   autocomplete="off"
                                                   placeholder="00/00/0000" />

                                            <span class="pl-3 pr-3">@RsBase.A.ToUpper()</span>

                                            <input class="form-control obrigatorio datepicker-period  mb-1"
                                                   id="iDataFim"
                                                   type="text"
                                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                                   data-startdate="@(DateTime.Now.AddYears(-1).ToString())"
                                                   autocomplete="off"
                                                   placeholder="00/00/0000" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iSituacao">@RsCadastros.SITUACAO</label>
