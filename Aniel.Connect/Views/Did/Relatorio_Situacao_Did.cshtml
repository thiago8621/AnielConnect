@using Aniel.Connect.Model.enumerado;
@using Aniel.Connect.Core.Helpers;

@{
    ViewBag.Title = RsCadastros.RELATORIO_SITUACAO_DID;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{

    <script>

        AddSelect("iPais", "@CONSTANTES.URLPortal/api/PaisApi/GetComboConnect", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iRota", "@CONSTANTES.URLPortal/api/RotaTelefoniaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        $('#iUF').val("");
        $('#iUF').change(async function () {

            var estado = $('#iUF option:selected').text();
            var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

            $('#iCidade').empty();

            await $.getJSON(enderecoApi, function (data) {
                $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
                $.each(data, function (key, value) {
                    $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
                });
            });
        });

        $('#iStatusDid').change(async function () {

            let status = $(this).val();

            if (status == "3") {
                $('#iColunaDiaLiberado').show();
            }
            else {
                $('#iColunaDiaLiberado').hide();
            }

            if (status == "2") {
                $('#iColunaMotivoIndisponivel').show();
            }
            else {
                $('#iColunaMotivoIndisponivel').hide();
            }

        });

        $('input[type=radio][name=TipoDiscagem]').change(function () {
            if (this.value == 'Dinamico' && this.checked) {
                $('#iColunaRota').show();
            }
            else {
                $('#iColunaRota').hide();
            }
        });

        var oDatatable = $("#datatable").length && $("#datatable").DataTable({
    dom: "Bfrti",
    order: [[1, 'asc']],
    serverSide: true,
    searching: true,
    ordering: true,
    paging: true,
    deferRender: true,
    scrollY: '73vh',
    scroller: {
    loadingIndicator: true,
    rowHeight: 40,
    boundaryScale: 0.5,
    displayBuffer: 3
    },
    stateSave: true,
    scrollX: true,
    fixedHeader: true,
    initComplete: dataTableInitComplete,
    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
    ajax: {
    url: urlApi,
    type: 'POST',
    data: function (data) {
    //var status = $("#iSituacao option:selected").val();
    //data.situacao = status;

    },
    error: function (e) {
    console.log(e);
    },
    dataSrc: function (d) {
    return d.data;
    }
    },
    rowId : "id",
    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

    var str = "@RsCadastros.INFODATATABLE";
    if (iTotal == 0) { iEnd = 0; iStart = 0; }
    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
    $("#dtLegend").html(str);

    return "";
    },
    pageLength: 10,
    language: traducaoDataTableSimples,
            buttons: buttonsDataTable,
            drawCallback: () => {

                TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                ResizeTable('divTable');
            },
    columns:
    [
    { title: "<input name='select_all' value='1' type='checkbox'>"},
    { data: "codigo", title: "@RsCadastros.CODIGO", orderable: false },
    { data: "did", title: "@RsCadastros.DID", orderable: false},
    { data: "uf", title: "@RsCadastros.UF", orderable: false},
    { data: "cidade", title: "@RsCadastros.CIDADE", orderable: false},
    { data: "cliente", title: "@RsCadastros.CLIENTE", orderable: false},
    { data: "circuito", title: "@RsCadastros.CIRCUITO.Replace("Circuito", "Numero do Circuito")", orderable: false},
    { data: "dia_Previsto_Portabilidade", title: "@RsCadastros.CADASTRO_PORTABILIDADE.Replace("Cadastro", "Dia Previsto")", orderable: false},
    { title: "", render: function (data, type, row, meta) { return "<a href=''><i class='fas fa-trash'></i></a>"; }, orderable: false }
    ],

    });
        $(document).ready(async () => {
            $('#modal-filter').modal('show');
            //carregaSelect2();

            AddSelect("iDid", "@CONSTANTES.URLPortal/api/CircuitoTelefoniaApi/GetCombo", "@CONSTANTES.PaginacaoRegistros", null, null, null, "@RsBase.SELECIONE", false);

            var estado = $('#iUF option:selected').text();
            var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

            $('#iStatusDid').trigger("change");
            $('input[type=radio][name=TipoDiscagem]').trigger('change');
            $('#iCidade').empty();

            await $.getJSON(enderecoApi, function (data) {
                $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
                $.each(data, function (key, value) {
                    $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
                });
                $('#iCidade').val("");
            });
        });

        let clicked = false
        let erro = false
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();


        }

        function resetValues()
        {
            $("#iDataInicio").val("");
            $("#iDataFim").val("");
            $("#iSituacao").val(null).trigger('change');
            $("#iDid").val(null).trigger('change');
        }
        const situacaofilter = @(Html.GetArrayEnum<Situacao_DID>());
        var appendOption = situacaofilter.forEach(
            (value, index) => {
                $("#iSituacao").append($("<option></option>").attr("value", index).text(`${value}`));
            });


    </script>
}


