@model Aniel.Connect.Models.DidCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_DIDS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles
    {
    <style>
        .popover-body {
            background-color: #357CA5;
            color: white;
        }
    </style>
}

@section scripts
{

    <script>

        AddSelect("iPais", "@CONSTANTES.URLPortal/api/PaisApi/GetComboConnect", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdPais", "@RsBase.SELECIONE", false);
        AddSelect("iRota", "@CONSTANTES.URLPortal/api/RotaTelefoniaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdRota", "@RsBase.SELECIONE", false);
        $('#iUF').val("@Model.UF");
        $('#iUF').change(async function () {

            $('#iCidade').prop('disabled',false);

            var estado = $('#iUF option:selected').text();
            var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

            $('#iCidade').empty();

            await $.getJSON(enderecoApi, function (data) {
                $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
                $.each(data, function (key, value) {
                    $('#iCidade').append($('<option></option>').attr({ value: value.id}).text(value.descricao));
                });
            });
        });

        $('#iCidade').change(function () {
            //$('#iNumero').val("");
            //var cidade = $('#iCidade option:selected').attr('ddd') ;
            //$('#iNumero').val(cidade);
        });
        $('#iPais').change(function () {
         
            $('#iUF').prop('disabled', false);
        });

        $('#iStatusDid').change(async function () {

            let status = $(this).val();

            if (status == "3"|| status == 6) {
                $('#iColunaDiaLiberado').show();
                $('#iColunaVenda').hide();
                $('.cadastro').prop("disabled", false);
            }

            else if (status == "2") {
                $('#iColunaMotivoIndisponivel').show();
                $('#iColunaVenda').hide();
                $('#iColunaDiaLiberado').hide();
                $('.cadastro').prop("disabled", false);
            }

            else if (status == 4 || status == 5) {
                $('.cadastro').prop("disabled", "disabled");
                $('#iColunaVenda').show();
            }
            else if (status == 6) {

            }

        });

        $('input[type=radio][name=TipoDiscagem]').change(function () {
            if (this.value == 'Dinamico' && this.checked) {
                $('#iColunaRota').show();
            }
            else if (this.value == 'SCM' && this.checked) {
                $('#iColunaRota').hide();
                //$("#iNumero").val('');
                //$("#iNumero").mask('(00)00000-0000');
            }
            else if (this.value == 'STFC' && this.checked) {
                $('#iColunaRota').hide();
                //$("#iNumero").val('');
                //$("#iNumero").mask('(00)0000-0000');
            }
        });


        $(document).ready(async function () {
            @if (Model.Id == 0)
            {
                <text>
                       $("#iChamadaCobrar").prop('checked', true).change();
                </text>
            }
            $('#iUF').prop('disabled', 'disabled');
            $('#iCidade').prop('disabled', 'disabled');


            var estado = $('#iUF option:selected').text();
            var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

            $('#iStatusDid').trigger("change");
            $('input[type=radio][name=TipoDiscagem]').trigger('change');
            $('#iCidade').empty();

            await $.getJSON(enderecoApi, function (data) {
                $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
                $.each(data, function (key, value) {
                    $('#iCidade').append($('<option></option>').attr({ value: value.id}).text(value.descricao));
                });
                $('#iCidade').val("@Model.IdCidade");
            });
        });

        let clicked = false
        let erro = false
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();


        }

        $("#iNumero").mask("(00) 00000-0000");
        $("#iPrefixo").on('focusout', function () {
            $("#iNumero").val("");
            $("#iNumero").val($(this).val());
        });

    </script>
}


@using (Html.BeginForm("Cadastro", "Did", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-phone-square"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GESTAO_CONEXOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Did")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_DIDS</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <div id="accordion">
                    <div class="card div-card-accord">
                        <div class="card-header title-card" id="heading-1">
                            <h5 class="mb-0">
                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                    <span class="text-bold-card">Cadastro</span>
                                </a>
                            </h5>
                        </div>
                        <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-1">
                                        <div class="form-group">
                                            <label for="iId">@RsCadastros.ID</label>
                                            @Html.TextBoxFor(model => model.Id, new { @class = "form-control", id = "iId", disabled = "disabled" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">

                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iRota">Tipo de Discagem: &nbsp;</label><i class="fas fa-info-circle" style="color: #2092EC" data-toggle="popover" data-placement="top"
                                                                                                  data-content="SCM = Telefonia Tipo Móvel Ex.: (21) 9 0000-0000
                                                                                                  STFC = Telefonia Tipo Fixo Ex.: (21) 0000-0000"></i>
                                            <br />
                                            @Html.RadioButtonFor(m => m.TipoDiscagem, Aniel.Connect.Model.enumerado.TipoDiscagem.SCM, new { @class = "cadastro" }) <label class="pr-2">@RsCadastros.SCM</label>
                                            @Html.RadioButtonFor(m => m.TipoDiscagem, Aniel.Connect.Model.enumerado.TipoDiscagem.STFC, new { @class = "cadastro" }) <label class="pr-2">@RsCadastros.STFC</label>
                                            @*@Html.RadioButtonFor(m => m.TipoDiscagem, Aniel.Connect.Model.enumerado.TipoDiscagem.Dinamico) <label class="pr-2">@RsCadastros.ROTA_PERSONALIZADA</label>*@
                                        </div>
                                    </div>
                                    @*<div class="col-sm-3" id="iColunaRota" style="display:none">
                                            <div class="form-group">
                                                <label for="iRota">Rota:</label>
                                                @Html.DropDownListFor(model => model.IdRota, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iRota", @autocomplete = "off" })
                                                @Html.ValidationMessageFor(model => model.IdRota, "", new { @class = "text-danger" })
                                            </div>
                                        </div>*@
                                </div>

                                @*<div class="row">
                                        <div class="col-sm-1">
                                            <div class="form-group">
                                                <label for="iPrefixo">Prefixo:</label>
                                                @Html.TextBox("iPrefixo", null, null, new { @id = "iPrefixo", @class = "form-control", @autocomplete = "off", @maxlength = "2" })
                                            </div>
                                        </div>
                                    </div>*@
                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iNumero">@RsCadastros.PREFIXO -  @RsCadastros.NUMERO:</label>
                                            @Html.TextBoxFor(model => model.Numero, new { @class = "form-control", @id = "iNumero"})
                                            @*@Html.ValidationMessageFor(model => model.Numero, "", new { @class = "text-danger" })*@
                                        </div>
                                    </div>


                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iValor">@RsCadastros.VALOR:</label>
                                            <i class="fas fa-info-circle" style="color: #2092EC" data-toggle="popover" data-placement="top"
                                               data-content=" Valor cobrado pela
                                               utilização do número, caso o valor cobrado
                                               for no plano não precisa ser preenchido">

                                            </i>
                                            @Html.TextBoxFor(model => model.Valor, new { @class = "form-control money cadastro", @id = "iValor", @autocomplete = "off", @maxlength = "10" })
                                            @Html.ValidationMessageFor(model => model.Valor, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    @*@{ List<String> statusStr = "Disponivel/Indisponivel".Split('/').ToList();
                                            List<SelectListItem> Listagem_Status = statusStr.Select((item, index) =>
                                            {
                                                return new SelectListItem
                                                {
                                                    Value = (index + 1).ToString(),
                                                    Text = item,
                                                };
                                            }).ToList();
                                        }*@
                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iStatusDid">@RsCadastros.STATUS:</label>
                                            @Html.EnumDropDownListFor(m => m.StatusDid, new { @class = "form-control", @id = "iStatusDid", @autocomplete = "off" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2" id="iColunaMotivoIndisponivel" style="display:none">
                                        <div class="form-group">
                                            <label for="iMotivoIndisponivel">@RsCadastros.MOTIVO:</label>
                                            @Html.TextBoxFor(m => m.MotivoIndisponivel, new { @class = "form-control cadastro", @id = "iMotivoIndisponivel", @maxlength = "50", @autocomplete = "off" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2" id="iColunaDiaLiberado" style="display:none">
                                        <label for="iDiaLiberado" class="fs-12">Dia liberado:</label>
                                        <div class="form-group">
                                            @Html.TextBoxFor(m => m.DiaLiberado, RsBase.SELECIONE, new { @class = "form-control datepicker cadastro", @id = "iDiaLiberado", @autocomplete = "off" })
                                        </div>
                                    </div>
                                    <div class="col-sm-2" id="iColunaVenda" style="display:none">
                                        <div class="form-group">
                                            <label for="iNumero_Venda">Número da Venda:</label>
                                            @Html.TextBoxFor(model => model.Id_Venda, new { @class = "form-control cadastro", @id = "iNumero_Venda", @autocomplete = "off" })
                                        </div>
                                    </div>


                                </div>

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iChamadaCobrar">Aceita Chamada a Cobrar:</label>
                                            @Html.CheckBoxFor(model => model.ChamadaCobrar, new { @class = "form-control cadastro", @id = "iChamadaCobrar", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iPais">@RsCadastros.PAIS:</label>
                                            @Html.DropDownListFor(model => model.IdPais, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control cadastro", @id = "iPais", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.IdPais, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iUF">@RsCadastros.UF:</label>
                                            <select class="form-control endereco cadastro" name="UF" id="iUF" autocomplete="off">
                                                <option value="" selected>@RsBase.SELECIONE</option>
                                                <option value="AC">AC</option>
                                                <option value="AL">AL</option>
                                                <option value="AP">AP</option>
                                                <option value="AM">AM</option>
                                                <option value="BA">BA</option>
                                                <option value="CE">CE</option>
                                                <option value="DF">DF</option>
                                                <option value="ES">ES</option>
                                                <option value="GO">GO</option>
                                                <option value="MA">MA</option>
                                                <option value="MT">MT</option>
                                                <option value="MS">MS</option>
                                                <option value="MG">MG</option>
                                                <option value="PA">PA</option>
                                                <option value="PB">PB</option>
                                                <option value="PR">PR</option>
                                                <option value="PE">PE</option>
                                                <option value="PI">PI</option>
                                                <option value="RJ">RJ</option>
                                                <option value="RN">RN</option>
                                                <option value="RS">RS</option>
                                                <option value="RO">RO</option>
                                                <option value="RR">RR</option>
                                                <option value="SC">SC</option>
                                                <option value="SP">SP</option>
                                                <option value="SE">SE</option>
                                                <option value="TO">TO</option>
                                            </select>
                                            @Html.ValidationMessageFor(model => model.UF, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iCidade">@RsCadastros.CIDADE:</label>
                                            @Html.DropDownListFor(model => model.IdCidade, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control cadastro", @id = "iCidade", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.IdCidade, "", new { @class = "text-danger" })
                                        </div>
                                    </div>


                                </div>

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iReservado_DDR">@RsCadastros.RESERVADO_DDR:</label>
                                            @Html.EnumDropDownListFor(model => model.Reservado_Ddr, new { @class = "form-control cadastro", @id = "iReservado_DDR", @autocomplete = "off" })
                                        </div>
                                    </div>


                                </div>

                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Did")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>

    </div>

}
