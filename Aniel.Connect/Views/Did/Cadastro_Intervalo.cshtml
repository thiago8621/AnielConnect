@model Aniel.Connect.Models.Did_CadastroIntervaloModel

@{
    //ViewBag.Title = RsCadastros.CADASTRO_DIDS.Insert(RsCadastros.CADASTRO_DIDS.Length, " Por Intervalo");
    ViewBag.Title = "Importar Dids por Intervalo";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
    {
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
<style>
    #iFixLog {
        overflow-y: auto;
        height:200px;
    }
    </style>
}

@section scripts{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

<script>
            AddSelect("iPais", "@CONSTANTES.URLPortal/api/PaisApi/GetComboConnect", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdPais", "@RsBase.SELECIONE", false);
        AddSelect("iRota", "@CONSTANTES.URLPortal/api/RotaTelefoniaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdRota", "@RsBase.SELECIONE", false);
        $('#iUF').val("@Model.UF");
        $('#iUF').change(async function () {

            $('#iCidade').prop('disabled', false);
            var estado = $('#iUF option:selected').text();
            var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

            $('#iCidade').empty();

            await $.getJSON(enderecoApi, function (data) {
                $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
                $.each(data, function (key, value) {
                    $('#iCidade').append($('<option></option>').attr({ value: value.id, ddd:value.ddd }).text(value.descricao));
                });
            });
        });

        //$('#iCidade').change(function () {
        //    $('.telefone').val("");
        //    var cidade = $('#iCidade option:selected').attr('ddd');
        //    $('.telefone').val(cidade);
        //});
    $('#iPais').change(function () {

        $('#iUF').prop('disabled', false);
    });


        $('#iStatusDid').change(async function () {

            let status = $(this).val();

            if (status == "3") {
                $('#iColunaDiaLiberado').show();
            }
            else {
                $('#iColunaDiaLiberado').hide();
            }

            if (status == "2") {
                $('#iColunaMotivoIndisponivel').show();
            }
            else {
                $('#iColunaMotivoIndisponivel').hide();
            }

        });

        $('input[type=radio][name=TipoDiscagem]').change(function () {
           
           if (this.value=='STFC' && $(this).is(':checked')) {
                $(".telefone").mask("(00) 0000-0000");
            }
            else {
               $(".telefone").mask("(00) 00000-0000");
            }
        });


        $(document).ready(async function () {

            var estado = $('#iUF option:selected').text();
            var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

            $('#iStatusDid').trigger("change");
            $('input[type=radio][name=TipoDiscagem]').trigger('change');
            $('#iCidade').empty();

            $('#iUF').prop('disabled', 'disabled');
            $('#iCidade').prop('disabled', 'disabled');

            await $.getJSON(enderecoApi, function (data) {
                $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
                $.each(data, function (key, value) {
                    $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
                });
                $('#iCidade').val("@Model.IdCidade");
            });
        });

        let clicked = false
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            let erro = false;
            clicked = true;

            erro = ValidaCamposObrigatorios(erro);
      

            if (erro) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning");
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();


        }
        $("#iPrefixo").on('focusout', function () {
            $(".telefone").val("");
            $(".telefone").val($(this).val());
        });
    var array = @Html.Raw(Json.Encode(Model.Log_DidIntervalo));
    const name = "Log_DidIntervalo";
    var oDatatableLog = $("#datatableLog").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                order:[],
                columns: [
                    {
                        data: "Numero",
                        title: "Número",
                        render: function (data, type, row, meta) {
                            return data +' <input id="' + name + '_' + meta.row + '__Id" name="' + name + '[' + meta.row + '].Numero" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                    },
                    {
                        data: "Mensagem",
                        title: "Mensagem",
                        title: "@RsCadastros.CATEGORIA",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + name + '_' + meta.row + '__Categoria" name="' + name + '[' + meta.row + '].Mensagem" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    }
        ],
        paging: false
            });

</script>
}
@using (Html.BeginForm("Cadastro_Intervalo", "Did", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-sort-numeric-down"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GESTAO_CONEXOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Did")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_DIDS</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <div id="accordion">
                    <div class="card div-card-accord">
                        <div class="card-header title-card" id="heading-1">
                            <h5 class="mb-0">
                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                    <span class="text-bold-card" style="font-size:15px">Para Importar os Did's, siga a sequência abaixo</span>
                                </a>
                            </h5>
                        </div>
                        <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iRota">Tipo de Discagem:</label>
                                            <br />
                                            @Html.RadioButtonFor(m => m.TipoDiscagem, Aniel.Connect.Model.enumerado.TipoDiscagem.SCM) <label class="pr-2">@RsCadastros.SCM</label>
                                            @Html.RadioButtonFor(m => m.TipoDiscagem, Aniel.Connect.Model.enumerado.TipoDiscagem.STFC) <label class="pr-2">@RsCadastros.STFC</label>
                                            @*@Html.RadioButtonFor(m => m.TipoDiscagem, Aniel.Connect.Model.enumerado.TipoDiscagem.Dinamico) <label class="pr-2">@RsCadastros.ROTA_PERSONALIZADA</label>*@
                                        </div>
                                    </div>
                                    <div class="col-sm-3" id="iColunaRota" style="display:none">
                                        <div class="form-group">
                                            <label for="iRota">Rota:</label>
                                            @Html.DropDownListFor(model => model.IdRota, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iRota", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.IdRota, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-1">
                                        <div class="form-group">
                                            <label for="iPrefixo">Prefixo:</label>
                                            @Html.TextBoxFor(model => model.Prefixo, new { @id = "iPrefixo", @class = "form-control obrigatorio", @autocomplete = "off", @maxlength = "2" })
                                        </div>
                                    </div>
                                </div>

                                @{ List<String> statusStr = "Disponivel/Indisponivel".Split('/').ToList();
                                    List<SelectListItem> Listagem_Status = statusStr.Select((item, index) =>
                                    {
                                        return new SelectListItem
                                        {
                                            Value = (index + 1).ToString(),
                                            Text = item,
                                        };
                                    }).ToList();
                                }
                                <div class="row">

                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iStatusDid">@RsCadastros.STATUS:</label>
                                            @Html.DropDownListFor(m => m.StatusDid, (Listagem_Status), new { @class = "form-control obrigatorio", @id = "iStatusDid", @autocomplete = "off" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2" id="iColunaMotivoIndisponivel" style="display:none">
                                        <div class="form-group">
                                            <label for="iMotivoIndisponivel">@RsCadastros.MOTIVO:</label>
                                            @Html.TextBoxFor(m => m.MotivoIndisponivel, new { @class = "form-control", @id = "iMotivoIndisponivel", @autocomplete = "off" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2" id="iColunaDiaLiberado" style="display:none">
                                        <label for="iDiaLiberado" class="fs-12">Dia liberado:</label>
                                        <div class="form-group">
                                            @Html.TextBoxFor(m => m.DiaLiberado, RsBase.SELECIONE, new { @class = "form-control datepicker ", @id = "iDiaLiberado", @autocomplete = "off" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iPais">@RsBase.SELECIONE o @RsCadastros.PAIS:</label>
                                            @Html.DropDownListFor(model => model.IdPais,
                                            new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"),
                                            RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iPais", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.IdPais, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iUF">@RsBase.SELECIONE a @RsCadastros.UF:</label>
                                            <select class="form-control endereco obrigatorio" name="UF" id="iUF" autocomplete="off">
                                                <option value="" selected>@RsBase.SELECIONE</option>
                                                <option value="AC">AC</option>
                                                <option value="AL">AL</option>
                                                <option value="AP">AP</option>
                                                <option value="AM">AM</option>
                                                <option value="BA">BA</option>
                                                <option value="CE">CE</option>
                                                <option value="DF">DF</option>
                                                <option value="ES">ES</option>
                                                <option value="GO">GO</option>
                                                <option value="MA">MA</option>
                                                <option value="MT">MT</option>
                                                <option value="MS">MS</option>
                                                <option value="MG">MG</option>
                                                <option value="PA">PA</option>
                                                <option value="PB">PB</option>
                                                <option value="PR">PR</option>
                                                <option value="PE">PE</option>
                                                <option value="PI">PI</option>
                                                <option value="RJ">RJ</option>
                                                <option value="RN">RN</option>
                                                <option value="RS">RS</option>
                                                <option value="RO">RO</option>
                                                <option value="RR">RR</option>
                                                <option value="SC">SC</option>
                                                <option value="SP">SP</option>
                                                <option value="SE">SE</option>
                                                <option value="TO">TO</option>
                                            </select>
                                            @Html.ValidationMessageFor(model => model.UF, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iCidade">@RsBase.SELECIONE a @RsCadastros.CIDADE:</label>
                                            @Html.DropDownListFor(model => model.IdCidade, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iCidade", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.IdCidade, "", new { @class = "text-danger" })
                                        </div>
                                    </div>


                                </div>

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iChamadaCobrar">Aceita Chamada a Cobrar:</label>
                                            @Html.CheckBoxFor(model => model.ChamadaCobrar, new { @class = "form-control obrigatorio", @id = "iChamadaCobrar", @name = "iEncerrar_Atendimento_Junto_OS", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iValor">@RsCadastros.VALOR.Insert(RsCadastros.VALOR.Length, " a Cobrar"):</label>
                                            @Html.TextBoxFor(model => model.Valor, new { @class = "form-control money obrigatorio", @id = "iValor", @autocomplete = "off", @maxlength = "100" })
                                            @Html.ValidationMessageFor(model => model.Valor, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iReservado_DDR">@RsCadastros.RESERVADO_DDR:</label>
                                            <select class="form-control" id="iReservado_Ddr" name="Reservado_DDR" autocomplete="off">
                                                <option value="1" selected="selected"> Sim </option>
                                                <option value="0"> Não </option>
                                            </select>
                                        </div>
                                    </div>
                                </div>


                                <div class="row">

                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iNumero">Número Inicial:</label>
                                            @Html.TextBoxFor(model => model.Numero_Inicial, new { @class = "form-control telefone obrigatorio", @id = "iNumeroInicial", @autocomplete = "off", @maxlength = "100" })
                                            @Html.ValidationMessageFor(model => model.Numero_Inicial, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iNumero">Número Final:</label>
                                            @Html.TextBoxFor(model => model.Numero_Final, new { @class = "form-control telefone obrigatorio", @id = "iNumeroFinal", @autocomplete = "off", @maxlength = "100" })
                                            @Html.ValidationMessageFor(model => model.Numero_Final, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3 ">
                                        <button type="button" class="btn btn-success" id="iAdicionar" onclick="ValidaSubmit()">
                                            <span>@RsBase.IMPORTAR</span>
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
                <div id="accordion2">
                    <div class="card div-card-accord">
                        <div class="card-header title-card" id="heading-2">
                            <h5 class="mb-0">
                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-2" aria-expanded="true" aria-controls="collapse-2">
                                    <span class="text-bold-card">Log de Importação</span>
                                </a>
                            </h5>
                        </div>
                        <div id="collapse-2" class="collapse show" data-parent="#accordion2" aria-labelledby="heading-2">
                            <div class="card-body body-card-accord">
                                <div class="row" id="iFixLog">
                                    <table class="table table-hover nowrap" id="datatableLog" style="width:100%"></table>

                                </div>
                            </div>



                        </div>
                    </div>

                </div>
            </div>


        </div>
    </div>

    @*Button Float*@
    @*
           <a href="@Url.Action("Index", "Did")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>
    *@



}