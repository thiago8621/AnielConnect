@model Aniel.Connect.Models.Area_CadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{

    ViewBag.Title = RsCadastros.CADASTRO_AREA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;
    bool temAcesso235 = AcessoHelper.TemAcesso(_areas, "235");
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")


    @if (@Model.Id == null || Model.IdCadastro == null)
    {
        <text>
            <script>
                $("#iStatus").val(true);
                $("#divStatus").hide();

                $(document).ready(async () => {
                    AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdGrupoArea", "@RsBase.SELECIONE", !@temAcesso235.ToString().ToLower());
                    AddSelect("iUf", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUfDesc", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Uf", "@RsBase.SELECIONE", false);

                });

            </script>
        </text>

        Model.IdCadastro = null;
    }
    else
    {
<script>
            $("#iDescricao").prop("disabled", !@temAcesso235.ToString().ToLower());
            if(@temAcesso235.ToString().ToLower())
                $("#divStatus").show();

                    $(document).ready(async () => {
                        AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdGrupoArea", "@RsBase.SELECIONE", !@temAcesso235.ToString().ToLower());
                        AddSelect("iUf", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUfDesc", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Uf", "@RsBase.SELECIONE", false);

        });

</script>

        Model.IdCadastro = Model.Id;
    }


    <script>




        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;

            var erro = false;

            if ($('#iDescricao').val() == "") {
                Notificar("@RsBase.ATENCAO_", "Informe a Descrição", "warning");
                erro = true;
            }
            if ($('#iCodigo').val() == "") {
                Notificar("@RsBase.ATENCAO_", "Informe o Código", "warning");
                erro = true;
            }
            if ($('#iGrupoArea').val() == null) {
                Notificar("@RsBase.ATENCAO_", "Selecione o Grupo Área", "warning");
                erro = true;
            }

            if (erro) {
                clicked = false;
                return false;
            }
            ShowPageLoading();
            $('#form').submit();

        }

    </script>
}


@using (Html.BeginForm("Cadastro", "Area", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @*@Html.HiddenFor(model => model.Id)*@
    @Html.HiddenFor(model => model.CompositeId.IdGrupoArea, new { @id = "idCadastro" })
    @Html.HiddenFor(model => model.CompositeId.IdArea, new { @id = "idCadastro" })

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page">
                            <i class="fas fa-map-marked-alt"></i> @ViewBag.Title
                        </h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Area")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_AREA</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>

                    </div>
                </div>
                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <span class="text-bold-card pt-0">@ViewBag.Title</span>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">
                                <div class="form-group col-sm-2">
                                    <label for="iCodigo" class="mr-3">@RsCadastros.CODIGO:<span class="text-danger">* </span></label><br>
                                    @Html.TextBoxFor(model => model.Id, new { @maxlength = 4, @class = "form-control", @id = "iCodigo" })
                                    @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group col-sm-4">
                                    <label for="iDescricao" class="mr-3">@RsCadastros.DESCRICAO_AREA:<span class="text-danger">* </span></label><br>
                                    @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao" })
                                    @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                </div>

                                <div class="col-sm-2" id="divStatus" style="display:none">
                                    <div class="form-group">
                                        <label for="iStatus">@RsCadastros.STATUS:</label><br />
                                        @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = RsBase.ATIVAR, @data_off = RsBase.INATIVAR, @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-2 col-md-2">
                                    <div class="form-group">
                                        <label for="iGrupoArea">@RsCadastros.GRUPO_AREA:<span class="text-danger">* </span></label><br />
                                        <select id="iGrupoArea" name="IdGrupoArea">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2 col-md-2">

                                    <div class="form-group">
                                        <label for="iUf"> @RsCadastros.UF</label>
                                        @Html.DropDownListFor(model => model.Uf, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iUf" })
                                        @Html.ValidationMessageFor(model => model.Uf, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-2 col-md-2">

                                    <div class="form-group">
                                        <label for="iUf"> @RsCadastros.LATITUDE</label>
                                        @Html.TextBoxFor(model => model.Latitude, new { @class = "form-control", @id = "iLatitude" })
                                        @Html.ValidationMessageFor(model => model.Latitude, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-2 col-md-2">

                                    <div class="form-group">
                                        <label for="iUf"> @RsCadastros.LONGITUDE</label>
                                        @Html.TextBoxFor(model => model.Longitude, new { @class = "form-control", @id = "iLongitude" })
                                        @Html.ValidationMessageFor(model => model.Longitude, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-2 col-md-2">

                                    <div class="form-group">
                                        <label for="iUf"> Limite de Distância</label>
                                        @Html.TextBoxFor(model => model.Distancia, new { @class = "form-control", @type="number", @min="0", @placeholder="Valor em Quilômetros", @id = "iDistancia" })
                                        @Html.ValidationMessageFor(model => model.Uf, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>


                    <!--Button Float-->
                    <a href="@Url.Action("Index", "Area")" class="float-cancel" onclick="ShowPageLoading(); return true;">
                        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                            <i class="fas fa-times fa-2x"></i>
                        </div>
                    </a>

                    <a href="#" onclick="ValidaSubmit();" class="float-save" id="btnGravar">
                        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                            <i class="fas fa-save fa-2x"></i>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
}