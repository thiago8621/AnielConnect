            </div>
        </div>*@

</div>

<div class="modal" id="modal-tiposervico">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" style="color: darkgray"> <i class="fas fa-filter"></i>Tipos de Serviços Não Cadastrados</h4>
                <button type="button" class="close" data-dismiss="modal" arial-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <form action="@Url.Action("EnviarPlanilha","ImportacaoOS")" id="arquivoModal" enctype="multipart/form-data" method="post">

                    <input type="hidden" id="projetoForm" name="projeto" value="@(TempData["Projeto"])" />
                    <input type="hidden" id="contratoForm" name="contrato" value="@(TempData["Contrato"])" />
                    <input type="hidden" id="custoForm" name="unidadeCusto" value="@(TempData["UnidadeCusto"])" />
                    <input type="hidden" id="DocumentosJsonForm" name="DocumentosJson" value="@(TempData["DocumentosJson"])" />

                    @if (TempData["TipoServicoNaoEncontrado"] != null)
                    {

                        <div class="row mb-2">
                            <div class="col">
                                <p class="font-weight-bold">Tipo de Serviço</p>
                            </div>
                            <div class="col">
                                <p class="font-weight-bold">Ação</p>
                            </div>
                            <div class="col">
                                <p class="font-weight-bold">Tipo de Serviço à Vincular</p>
                            </div>
                        </div>


                        List<string> TipoServicoNaoEncontrado = ((List<string>)TempData["TipoServicoNaoEncontrado"]);
                        for (int i = 0; i < TipoServicoNaoEncontrado.Count; i++)
                        {
                            <div class="row">
                                <div class="col-4">
                                    <p>@TipoServicoNaoEncontrado[i]</p>
                                    <input type="hidden" value="@TipoServicoNaoEncontrado[i]" name="TiposNaoEncontrado[@i].Descricao">
                                </div>
                                <div class="col-4">
                                    <select name="TiposNaoEncontrado[@i].Acao" class="form-control acaoTipoServ" data-tiposervindex="@i">
                                        <option value="cadastrar">Cadastrar</option>
                                        <option value="vincular">Vincular</option>
                                    </select>
                                </div>
                                <div class="col-4" id="iDivTipoServ@(i)" style="display:none">
                                    <select style="max-width:100%" name="TiposNaoEncontrado[@i].TipoServicoVincular" type="text" class="form-control tipoServSelect" id="iTipoServ@(i)" placeholder="">
                                    </select>
                                </div>
                            </div>
                        }
                    }


                </form>


            </div>
            <div class="modal-footer justify-content-center">
                <div class="row text-center justify-content-center">
                    <button class="btn" type="button" onclick="$('#arquivoModal').submit();">Importar</button>
                    <button class="btn" type="button"onclick="$('#modal-tiposervico').modal('hide')">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="overlay" id="divProgress" style="display:none;">
    <div class="preloaderbar show active">
        <span class="bar"></span>
        <span class="text">@RsCadastros.PROCESSANDO ...</span>
    </div>
</div>


