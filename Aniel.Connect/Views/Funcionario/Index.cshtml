@model Aniel.Connect.Models.FuncionarioCadastroModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.PAINEL_FUNCIONARIO;
    ViewBag.Sessao = RsCadastros.FUNCIONARIO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }

        div.dataTables_wrapper div.dataTables_length label {
            font-size: 13px !important;
        }

        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }

    </style>
}


@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

<script>
        var rows_selected = [];

    AddSelect("iEquipeVendas", "@CONSTANTES.URLPortal/api/EquipeVendasApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
    AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

   // function ExibirCadastroVendedor(id, e_supervisor, tipo) {
    function ExibirCadastroVendedor(id, e_supervisor, tipo) {
       // var _dialog = ShowDialog(true, true, "Definir Critérios para o Vendedor", '@Url.Action("Cadastro", "Funcionario")?Id=' + id + "&E_Supervisor=" + e_supervisor + "&Id_Supervisor=" + 0 + "&Tipo=" + tipo, 'divFuncionario', 600, 500, 'iframeCadastro',
        var _dialog = ShowDialog(true, true, "Definir Critérios para o Vendedor", '@Url.Action("Cadastro", "Funcionario")?Id=' + id + "&E_Supervisor=" + e_supervisor + "&Id_Supervisor=" + 0 + "&Tipo=" + tipo, 'divFuncionario', 600, 500, 'iframeCadastro',
            function () {
                try {
                    setTimeout(function () {
                        rows_selected = [];
                        oDatatableVendedor.draw();
                    }, 500);
                }
                catch {
                    setTimeout(function () {
                        rows_selected= [];
                        oDatatableVendedor.draw();

                    }, 500);
                }
            }
        );

    }

    function ExibirCadastroSupervisor(id, e_supervisor, tipo) {
        var _dialog = ShowDialog(true, true, "Definir Critérios para o Supervisor", '@Url.Action("Cadastro", "Funcionario")?Id=' + id + "&E_Supervisor=" + e_supervisor + "&Id_Supervisor=" + 0 + "&Tipo=" + tipo, 'divFuncionario', 600, 600, 'iframeCadastro',
            function () {
                try {
                    setTimeout(function () {
                        rows_selected = [];
                        oDatatableVendedor.draw();
                    }, 500);
                }
                catch {
                    setTimeout(function () {
                        rows_selected= [];
                        oDatatableVendedor.draw();

                    }, 500);
                }
            }
        );

    }
    function DefinirCriteriosEmMassa(num_fre) {
        if (rows_selected.length == 0) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
            return;
        }
        ShowDialog(true, true, "Definir Critérios em Massa", "@Url.Action("CadastroEmMassa", "Funcionario")?funcionarios=" + rows_selected, 'divCadastroEmMassa', 600, 700, 'iframeCadastroEmMassa', function () {
            try {
                setTimeout(function () {
                    rows_selected = [];
                    oDatatableVendedor.draw();
                }, 500);
            }
            catch {
                setTimeout(function () {
                    rows_selected = [];
                    oDatatableVendedor.draw();
                }, 500);
            }
        });
    }
    $("#btnVincular").on("click", function () {
        if (rows_selected.length > 1) {
            parent.Swal.fire({
                type: 'warning',
                title: '<b>Um ou mais usuários já possuem critérios!</b>',
                text: 'Alguns usuários selecionados já estão vinculados a alguns critérios, ao prosseguir com a ação os critérios serão atualizados.Deseja continuar?',
                showCancelButton: true,
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não'
            }).then(async (okay) => {
                if (okay.value) {
                DefinirCriteriosEmMassa();
                }
                else {
                    return false;
                }
            });
        }
        else {
            DefinirCriteriosEmMassa();
        }
    });

    var handleDataTableButtons = function () {
        oDatatableVendedor = $("#datatableVendedor").DataTable({
            dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
            columnDefs: [{
                targets: 0,
                searchable: false,
                orderable: false,
                width: '1%',
                className: 'dt-body-center',
                render: function (data, type, full, meta) {
                    return "<input type='checkbox'></input>";
                }
            },
            {
                targets: 1,
                searchable: false,
                orderable: false,
                width: '1%',
                className: 'dt-body-center'
            }],
            select: 'multi',
            order: [[1, 'asc']],
            serverSide: true,
            searching: true,
            ordering: true,
            paging: true,
            deferRender: true,
            scrollResize: true,
            scrollY: '85vh',
            /*stateSave: true,*/
            scrollX: true,
            initComplete: dataTableInitComplete,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
            ajax: {
                url: baseUrl + '/api/FuncionarioApi/GetVendedor',
                type: 'POST',
                data: function (data) {
                    data.meta = $("#iMeta").val();
                    data.id_Supervisor = $("#iSupervisor").val();
                    data.equipeVenda = $("#iEquipeVenda").val();
                    data.comissionamento = $("#iComissionamento").val();
                    data.faixaComissionamento = $("#iFaixa").val();
                    data.todos = $("#iTodos").is(":checked");
                    data.premier = $("#iConfigurados").is(":checked");
                    data.naoPremier = $("#iNaoConfigurados").is(":checked");
                    data.nome = $("#txtSearch").val();
                },
                error: function (e) {
                    console.log(e);
                },
                dataSrc: function (d) {
                    return d.data;
                }
            },
            infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                var str = "@RsCadastros.INFODATATABLE";
                if (iTotal == 0) { iEnd = 0; iStart = 0; }
                str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                $("#dtLegend2").html(str);

                return "";
            },
            preDrawCallback: function () {
                ShowPageLoading();
            },
            drawCallback: function () {
                HidePageLoading();
            },
            rowCallback: function (row, data, dataIndex) {
                // Get row ID
                var rowId = data.id;

                // If row ID is in the list of selected row IDs
                if ($.inArray(rowId, rows_selected) !== -1) {
                    $(row).find('input[type="checkbox"]').prop('checked', true);
                    $(row).addClass('selected');
                }
            },
            pageLength: 10,
            language: traducaoDataTableSimples,
            buttons: buttonsDataTable,
            columns: [
                { title: "<input name='select_all' value='1' type='checkbox'>" },
                { data: "id", title: "@RsCadastros.CODIGO" },
                { data: "nome", title: "@RsCadastros.NOME" },
                { data: "meta", title: "@RsCadastros.META_INDIVIDUAL_PERIODO" },
                { data: "desc_Comissionamento", title: "@RsCadastros.TABELA_COMISSIONAMENTO" },
                { data: "faixa", title: "@RsCadastros.FAIXA_COMISSIONAMENTO" },
                { data: "tipoUsuario", title: "@RsCadastros.PERFIL", orderable: false },
                { data: "nomeSupervisor", title: "@RsCadastros.SUPERVISOR", orderable: false },
                { data: "equipeVenda", title: "@RsCadastros.EQUIPE_VENDAS", orderable: false },
                { data: "parametrosConsultaPreQual", title: "@RsCadastros.PARAM_CONS_CREDITO_PREQUAL", orderable: false },
                { data: "possuiAcessoPremier", title: "@RsCadastros.ACESSO_PREMIER", orderable: false },
            ]
        });

        oDatatableVendedor.draw();
        // FIM DATATABLE VENDEDOR

        $("#btnExcluirVendedor").on("click", function () {
            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/FuncionarioApi/excluirlistavendedor")';
            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    ids: rows_selected
                }
            })
                .done(function (data) {

                    if (data.ok) {
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                        rows_selected = [];
                        oDatatableVendedor.draw();
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                });
        });

        $('#datatableVendedor tbody').on('click', 'tr', function (e) {
            _id = oDatatableVendedor.row(this).data().id;
            mostrarmodal = oDatatableVendedor.row(this).data().tipoUsuario

            if (mostrarmodal == "Vendedor") {
                ExibirCadastroVendedor(_id, false, 1);
            } else {
                ExibirCadastroSupervisor(_id, false, 1);
            }

            e.stopPropagation();
            ShowPageLoading();
        });
        $('#iPesquisar').on('click', function (e) {
            oDatatableVendedor.draw();
            $('#modal-filter').modal("hide");
        });

        $('#datatableVendedor tbody').on('click', 'input[type="checkbox"]', function (e) {
            var $row = $(this).closest('tr');
            // Get row data
            var rowId = oDatatableVendedor.row($row).data().id;
            var index = $.inArray(rowId, rows_selected);

            // If checkbox is checked and row ID is not in list of selected row IDs
            if (this.checked && index === -1) {
                rows_selected.push(rowId);

                // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
            } else if (!this.checked && index !== -1) {
                rows_selected.splice(index, 1);
            }

            if (this.checked) {
                $row.addClass('selected');
            } else {
                $row.removeClass('selected');
            }

            // Prevent click event from propagating to parent
            e.stopPropagation();
        });
        $('thead input[name="select_all"]', oDatatableVendedor.table().container()).on('click', function (e) {
            if (this.checked) {
                $('#datatableVendedor tbody input[type="checkbox"]:not(:checked)').trigger('click');
            } else {
                $('#datatableVendedor tbody input[type="checkbox"]:checked').trigger('click');
            }

            // Prevent click event from propagating to parent
            e.stopPropagation();
        });

        $('#iLimparFiltroModal').on('click', function () {
            $("#iSupervisor").val(null).trigger("change");
            $("#iComissionamento").val(null).trigger("change");
            $("#iFaixa").val(null).trigger("change");
            $("#iMeta").val(null).trigger("change");
            $("#iEquipeVendas").val(null).trigger("change");
            $("#txtSearch").val('');

            $("#iTodos").prop("checked", false);
            $("#iConfigurados").prop("checked", false);
            $("#iNaoConfigurados").prop("checked", false);
            $('#modal-filter').modal("hide");
            oDatatableVendedor.draw();
        });

        $('#iLimparFiltro').on('click', function () {
            $("#iSupervisor").val(null).trigger("change");
            $("#iComissionamento").val(null).trigger("change");
            $("#iFaixa").val(null).trigger("change");
            $("#iMeta").val(null).trigger("change");
            $("#iEquipeVendas").val(null).trigger("change");
            $("#txtSearch").val('');

            $("#iTodos").prop("checked", false);
            $("#iConfigurados").prop("checked", false);
            $("#iNaoConfigurados").prop("checked", false);
            $('#modal-filter').modal("hide");
            oDatatableVendedor.draw();
        });

        //$('#txtSearch').val(oDatatableVendedor.search());
        $('#txtSearch').keyup(function () {
            rows_selected = [];
            oDatatableVendedor.search($(this).val()).draw();
        });
    },
    TableManageButtons = function () {
        "use strict";
        return {
            init: function () {
                handleDataTableButtons();
            }
        }
    }();

    TableManageButtons.init();
</script>
}

<div class="container-fluid" id="divTitle">

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-user-tie"></i> @ViewBag.Title</h4>
            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Comercial")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.COMERCIAL</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

            @*<span style="font-size:11px" id="dtLegend"></span>*@
            <h5 class="title-page text-danger">
                Clique em um dos nomes da lista para inserir ou
                atualizar os dados do cadastro individualmente, ou clique nos 3 pontinhos para inserir
                ou atualizar em massa.
            </h5>
        </div>

        <div class="col-auto mb-3">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="Nome Vendedor" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fa fa-file"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" id="btnVincular"><i class="fas fa-users"></i> @RsBase.DEFINIR_CRITERIO_MASSA </a>

                </div>
            </div>
        </div>
    </div>



    <div class="container-fluid">
        <table class="table table-hover nowrap" id="datatableVendedor" style="width:100%">
        </table>
    </div>

    <div id="divFuncionario"></div>
    <div id="divCadastroEmMassa"></div>


    <div class="modal" id="modal-filter">
        <div class="modal-dialog modal-lg" style="width:50%">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">

                    <div class="col-sm-11 container">
                        <div class="row">
                            <div class="row">
                                <div class="col-sm-5">
                                    <div class="form-group">
                                        <label for="iMeta">@RsCadastros.META_INDIVIDUAL_PERIODO :</label>
                                        @Html.DropDownList("Meta", new SelectList(ViewBag.Meta, "Id", "Descricao"), RsBase.SELECIONE, new { @class = "form-control", @id = "iMeta", @autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-5">
                                    <div class="form-group">
                                        <label for="iFaixa">@RsCadastros.TABELA_COMISSIONAMENTO :</label>
                                        @Html.DropDownList("TabelaComissionamento", new SelectList(ViewBag.Comissionamento, "Id", "Descricao"), RsBase.SELECIONE, new { @class = "form-control", @id = "iComissionamento", @autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-5">
                                    <div class="form-group">
                                        <label for="iFaixa">@RsCadastros.FAIXA_COMISSIONAMENTO :</label>
                                        @Html.DropDownList("FaixaComissionamento", new SelectList(ViewBag.Faixa_Comissionamento, "Id", "Descricao"), RsBase.SELECIONE, new { @class = "form-control", @id = "iFaixa", @autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-5">
                                    <div class="form-group">
                                        <label for="iSupervisor">@RsCadastros.SUPERVISOR :</label>
                                        @Html.DropDownList("Supervisor", new SelectList(ViewBag.Supervisores, "Id", "Descricao"), RsBase.SELECIONE, new { @class = "form-control", @id = "iSupervisor", @autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-sm-5">
                                    <div class="form-group">
                                        <div class="form-group">
                                            <label for="iPerfilVenda">@RsCadastros.EQUIPE_VENDAS:</label>
                                            @Html.DropDownList("EquipeVenda", new SelectList(new List<object>()), RsBase.SELECIONE, new { @class = "form-control mb-3", @id = "iEquipeVendas", @autocomplete = "off" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <br /><br /><br />
                            <div class="col-12" style="width: 50%">
                                <div class="form-group">
                                    <input type="radio" id="iTodos" name="radio" />
                                    <label for="iTodos">Todos</label>
                                </div>
                            </div>
                            <div class="col-12" style="width: 50%">
                                <div class="form-group">
                                    <input type="radio" id="iConfigurados" name="radio" />
                                    <label for="iConfigurados">Somente vendedores com acesso Premier</label>
                                </div>
                            </div>
                            <div class="col-12" style="width: 50%">
                                <div class="form-group">
                                    <input type="radio" id="iNaoConfigurados" name="radio" />
                                    <label for="iNaoConfigurados">Somente vendedores sem acesso Premier</label>
                                </div>
                            </div>

                        </div>
                        <div class="form-group col-sm-12">
                            <div class="text-center">
                                <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                                <input type="submit" class="btn btn-success" id="iPesquisar" value="@RsCadastros.PESQUISAR" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>