@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.GESTAO_CONEXOES;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;
}
@section Scripts

{
    <script>
        $(".semAcesso").on("click", function () {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NAO_POSSUI_AREA_ACESSO", "warning");
            stopPageLoading();
            return false;
        });

    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->
    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page"><i class="icofont icofont-network-tower la-1-4x" style="background-color: transparent"></i> @ViewBag.Title</h4>
            <span style="font-size:11px" id="dtLegend"></span>
        </div>
    </div>
    <div class="row pl-4" style="margin-top: -10px;">
        <div class="col-sm-3">
            <div class="row">
                <i class="fas fa-cube" style="margin-top: 16px;"></i>
                <p class="pConfig mt-3"><u>Cadastros</u></p>
            </div>
            <div class="text-left">
                <ul class="ulConfig">
                    <li class="liConfig"><a href="@Url.Action("Index", "Tecnologia")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_TECNOLOGIA</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "POP")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_POP</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "OLT")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_OLT</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "Pon")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_PON</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "Slot")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_SLOT</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "Concentradora")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_CONCENTRADORA</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "Radius")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_RADIUS</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "Pool_Ip")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_POOL_IP</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "LoginRadius")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_LOGIN</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "PerfilAtivacao")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_PERFIL_ATIVACAO</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "Atributo_IPOE")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_ATRIBUTO_IPOE</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "PontoAcessoRadio")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_PONTO_ACESSO_RADIO</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "InterfaceRadio")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_INTERFACE_RADIO</a></li>


                </ul>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="row">
                <i class="fas fa-tasks" style="margin-top: 16px;"></i>
                <p class="pConfig mt-3"><u>@RsCadastros.GESTAO</u></p>
            </div>
            <div class="text-left">
                <ul class="ulConfig">
                    <li class="liConfig"><a href="@Url.Action("Index", "EstruturaFibra")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.ESTRUTURA_REDE_OPTICA</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "Pool_Ip_Endereco")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_IP</a></li>
                    <li class="liConfig"><a href="@Url.Action("ListagemONU", "EstruturaFibra")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_ONU</a></li>
                    <li class="liConfig"><a href="@Url.Action("AutorizarONU", "EstruturaFibra")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.AUTORIZAR_ONU</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "Configuracao_Servico_OLT")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURAR_EXECUCAO_SERVICO_OLT</a></li>
                    <li class="liConfig"><a href="@Url.Action("Index", "Painel_Diagnosticos")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELDIAGNOSTICOS</a></li>
                    @if (AcessoHelper.TemAcesso(_areas, "406"))
                    {
                        <li class="liConfig"><a href="@Url.Action("PainelHistoricoAutenticacoes", "Painel_Diagnosticos")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_HISTORICO_AUTENTICACOES</a></li>
                    }                  
                    <li class="liConfig"><a href="@Url.Action("Index", "Configuracao_Conexao_Plano")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURAR_CONEXAO_CLIENTE_PLANO</a></li>
                    <li class="liConfig"><a href="@Url.Action("RelatorioLogProvisionamento", "Relatorio")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.LOGS_PROVISIONAMENTO</a></li>
                </ul>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="row">
                <i class="fas fa-mobile-alt"></i>
                <p class="pConfig"><u>@RsCadastros.TELEFONIA</u></p>
            </div>
            <div class="text-left">
                <ul class="ulConfig">
                    <li class="liConfig"><a href="@Url.Action("Index", "Franquia")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_FRANQUIA</a></li>
                    @if (AcessoHelper.TemAcesso(_areas, "259"))
                    {
                        <li class="liConfig"><a href="@Url.Action("Index", "RotaTelefonia")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_ROTA_TELEFONIA</a></li>
                    }
                    @*Acesso DID *@
                    @if (AcessoHelper.TemAcesso(_areas, "212"))
                    {
                        <li class="liConfig"><a href="@Url.Action("Index", "Did")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_DIDS</a></li>

                    }
                    else
                    {
                        <li class="liConfig"><a href="#" class="aConfig semAcesso" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_DIDS</a></li>
                    }

                    @if (AcessoHelper.TemAcesso(_areas, "215"))
                    {
                        <li class="liConfig"><a href="@Url.Action("Index", "CircuitoTelefonia")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CIRCUITOS</a></li>
                    }

                </ul>
            </div>
        </div>

    </div>
</div>

