                    }
                });

                if (!isChecked_Contrato) {
                    Notificar("@RsBase.ATENCAO_", "Necessário estar de acordo com o contrato para continuar", "warning");
                    erro = true;
                }
            }

            if (erro)
            {
                return false;
            }

            nextPrev(1);

        }
        function redirecionar_formulario_contrato(aceitar, tipoComprovanteTermo)
        {
            var erro = false;
            if (aceitar) {
                const checked = document.getElementById("check-termo").checked;
                if (!checked) {
                    Notificar("@RsBase.ATENCAO_", "Necessário estar de acordo com o TERMO para continuar.", "warning");
                    erro = true;
                }
            }

            if (erro)
            {
                return false;
            }

            nextPrev(1);
        }

        function isAndroidSelfiePartial() {
            return /Android/i.test(navigator.userAgent);
        }

        function isMobileSelfiePartial() {
            const regex = /Mobi|Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i;
            return regex.test(navigator.userAgent);
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (isMobileSelfiePartial() && isAndroidSelfiePartial()) {
                $("#iTermoPdfEmbedSelfiePartial").hide();
                document.getElementById("abrirPdfBtnSelfiePartial").style.display = "block";
                // percorre todos os contratos
                document.querySelectorAll("[id^='iVisuTermoContrato-']").forEach(function (embed) {
                    embed.style.display = "none";
                });

                $(".carrosselBtn").hide();
                $("#divCarrosselArquivos").removeClass("carousel");
                $("li").removeClass("slide");

                document.querySelectorAll("[id^='abrirPdfBtnTermoContrato-']").forEach(function (btn) {
                    btn.style.display = "block";
                });
            } else {
                // mantém o embed visível em desktop/iOS
                document.querySelectorAll("[id^='iVisuTermoContrato-']").forEach(function (embed) {
                    embed.style.display = "block";
                });

                $("#iTermoPdfEmbedSelfiePartial").show();
            }
        });

        function redirecionar_formulario_anexo(aceitar)
        {
            var erro = false;
            if (aceitar) {

                const highlightedItems = document.querySelectorAll("input[name^='check-contrato']");
                var isChecked_Contrato = true;
                highlightedItems.forEach((item) => {
                    if (item.checked == false) {
                        isChecked_Contrato = false;
                    }
                });

                if (!isChecked_Contrato) {
                    Notificar("@RsBase.ATENCAO_", "Necessário estar de acordo com o CONTRATO para continuar", "warning");
                    erro = true;
                }
            }

            if (erro)
            {
                return false;
            }

            nextPrev(1);
        }

    const buttons = document.querySelectorAll("[data-carousel-button]");
        buttons.forEach(button => {
            button.addEventListener("click", () => {
            const offset = button.dataset.carouselButton === "next" ? 1 : -1
            const slides = button
                .closest("[data-carousel]")
                .querySelector("[data-slides]")

            const activeSlide = slides.querySelector("[data-active]")
            let newIndex = [...slides.children].indexOf(activeSlide) + offset

            if (newIndex < 0) newIndex = slides.children.length - 1
            if (newIndex >= slides.children.length) newIndex = 0

            slides.children[newIndex].dataset.active = true
            delete activeSlide.dataset.active
        });
    });

    function contador_checkbox_termo_contrato(value) {
        const highlightedItems = document.querySelectorAll("input[name^='check-contrato']");
        const filter = [...highlightedItems].filter(x => !x.checked);
        if (filter.length > 0) {
            $('#iAceitar_Contrato').attr('disabled', 'disabled');
        } else {
            $('#iAceitar_Contrato').removeAttr('disabled');
        }
    }
    function contador_checkbox_anexo(value) {
        const highlightedItems = document.querySelectorAll("input[name^='check-anexo']");
        const filter = [...highlightedItems].filter(x => !x.checked);
        if (filter.length > 0) {
            $('#iAceitar_Contrato').attr('disabled', 'disabled');
        } else {
            $('#iAceitar_Contrato').removeAttr('disabled');
        }
    }
    </script>
}

<nav class="navbar-custom">
    @if (Model.UrlLogo != "" && Model.UrlLogo != null)
    {
        <center>
            <img class="logo img-fluid" src="@Model.UrlLogo" alt="logo" style="width:auto;" />
        </center>
    }
    else
    {
        <center>
            <a class="navbar-brand">@Model.Empresa</a>
        </center>
    }
</nav>

<div class="main">
    <div class="section section-basic">
        <div class="container text-center">
        <div class="container text-center pt-2">

            @if (Model.ExigeFotoTermo && Model.TipoComprovanteTermo == Sinapse.Model.enumerados.Tipo_Comprovante_Termo.ProvaVida)
            {
                <text>
                    <p class="texto margem-topo">Prezado(a) @Model.Cliente. Para confirmar sua compra e realizar o aceite, é necessário realizar algumas etapas de confirmações de identidade.</p><hr size="10" width="auto">
                </text>
            }
            else
            {

                if (Model.ExigeTermoContrato)
                {
                    <text>Prezado(a) @Model.Cliente, para confirmar sua compra, é necessário realizar a assinatura e o aceite do(s) documento(s) a seguir.</text>
                }
                else
                {
                    <text>Prezado(a) @Model.Cliente, para confirmar sua compra, é necessário realizar a assinatura e o aceite no termo de adesão a seguir.</text>
                }

            }

            @if (ViewBag.VendaStatus == Aniel.Connect.Model.enumerado.Status_Venda.Venda_Cancelada || 
                 ViewBag.StatusTroca == Aniel.Connect.Model.enumerado.StatusTrocaTitularidade.Cancelado)
            {
                <div class="main pt-2">
                    <div class="section section-basic">
                        <div class="container text-center">
                            <div class="jumbotron mt-3">
                                <div class="container">
                                    <p class="lead">Infelizmente, a venda associada a este formulário foi cancelada.</p>
                                    <p class="lead">Caso tenha alguma dúvida ou precise de mais informações, entre em contato conosco.</p>
                                    <p class="lead">Agradecemos pela compreensão.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (Model.Contratos.Count == 0 && Model.ExigeTermoContrato)
            {
                <div class="main pt-2">
                    <div class="section section-basic">
                        <div class="container text-center">
                            <div class="jumbotron mt-3">
                                <div class="container">
                                    <p class="lead">Ops! Não conseguimos identificar um plano na sua proposta comercial. Contate o suporte da empresa para mais informações</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                using (Html.BeginForm("Formulario", "Termo_Adesao", FormMethod.Post, htmlAttributes: new { enctype = "multipart/form-data", @id = "form" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.HiddenFor(model => model.IdVenda)
                    @Html.HiddenFor(model => model.Cliente)

                    //TERMO SELFIE
                    if (Model.ExigeFotoTermo && Model.TipoComprovanteTermo == Sinapse.Model.enumerados.Tipo_Comprovante_Termo.Selfie)
                    {

                        Html.RenderPartial("~/Views/Termo_Adesao/SelfiePartial.cshtml", Model);
                    }


                    //TERMO PROVA DE VIDA
                    else if (Model.ExigeFotoTermo && Model.TipoComprovanteTermo == Sinapse.Model.enumerados.Tipo_Comprovante_Termo.ProvaVida)
                    {
                        Html.RenderPartial("~/Views/Termo_Adesao/ProvaVidaPartial.cshtml", Model);
                    }

                    //TERMO SEM COMPROVANTE
                    else
                    {
                        Html.RenderPartial("~/Views/Termo_Adesao/SelfiePartial.cshtml", Model);
                    }

                    if (Model.ExigeTermoContrato)
                    {
                        Html.RenderPartial("~/Views/Termo_Adesao/Formulario_Termo_Contrato.cshtml", Model);
                    }

                    if (Model.TemAnexosDocumento)
                    {
                        Html.RenderPartial("~/Views/Termo_Adesao/Formulario_Anexo.cshtml", Model);
                    }

                }
            }
        </div>
    </div>
</div>
<div class="overlay" id="divProgress" style="display:none;">
    <div class="preloaderbar show active">
        <span class="bar"></span>
        <span class="text">Confirmando assinatura do termo ...</span>
    </div>
</div>

