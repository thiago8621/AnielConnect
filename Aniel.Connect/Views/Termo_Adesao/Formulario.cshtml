    var currentTab = 0; // Current tab is set to be the first tab (0)
    showTab(currentTab); // Display the current tab

    function showTab(n) {
        // This function will display the specified tab of the form ...
        var x = document.getElementsByClassName("tab");
        x[n].style.display = "block";
        // ... and fix the Previous/Next buttons:
        if (n == 0) {
            document.getElementById("prevBtn").style.display = "none";
        } else {
            document.getElementById("prevBtn").style.display = "inline";
        }
        if (n == (x.length - 1)) {
            document.getElementById("nextBtn").innerHTML = "Submit";
        } else {
            document.getElementById("nextBtn").innerHTML = "Próximo";
        }
        // ... and run a function that displays the correct step indicator:
        fixStepIndicator(n)
    }
        function nextPrev(n) {

            var tabs = document.getElementsByClassName("tab");

            if (currentTab == 1)
            {
                // Caso "não" esteja marcado, avança dois tabs
                if ($("#nao").prop("checked") && n == 1) {
                    stepTo(2);
                    return true;
                }
            }

            if (currentTab == 3) {
                // Caso "não" esteja marcado, retorna dois tabs
                if ($("#nao").prop("checked") && n == -1) {
                    stepTo(0);
                    return true;
                }
            }

            // Sai da função se o campo atual for inválido
            if (n == 1 && !validateForm()) return false;

            // Esconde a aba atual
            tabs[currentTab].style.display = "none";

            currentTab = currentTab + n;

            // Se chegou ao final, tenta submeter o formulário
            if (currentTab >= tabs.length) {
                currentTab = tabs.length - 1;
            }
            // Se chegou o início, passar o valor da página inicial
            if (currentTab <= 0) {
                currentTab = 0;
            }

            // Caso contrário, exibe a aba correta
            showTab(currentTab);
        }

        function stepTo(etapa) {
            var tabs = document.getElementsByClassName("tab");

            @* Esconde a aba atual*@
            tabs[currentTab].style.display = "none";

            currentTab = etapa;
            showTab(currentTab);
        }
    function validateForm() {
        // This function deals with validation of the form fields
        var x, y, i, valid = true;
        x = document.getElementsByClassName("tab");
        y = x[currentTab].querySelectorAll("img");

        // A loop that checks every input field in the current tab:
        for (i = 0; i < y.length; i++) {
            let campoVazioIncompleto = y[i].src == "" || y[i].src == "data:,";

            //Verifica se tem camêra
            if ((navigator?.mediaDevices?.getUserMedia == null && $("#sim").prop("checked")) || (navigator?.mediaDevices?.getUserMedia == null && ExigeFotoTermo == "True" && TipoComprovanteTermo == "Selfie")) {
                Notificar("@RsBase.ATENCAO_", "Para prosseguir, é necessário tirar uma foto com o documento de identificação. Verifique se seu navegador possui acesso à câmera.", "warning");
                valid = false;
            }

            //Ou se o arquivo esta vazio
            else if ((campoVazioIncompleto && $("#sim").prop("checked")) || (campoVazioIncompleto && ExigeFotoTermo == "True" && TipoComprovanteTermo == "Selfie")) {
                Notificar("@RsBase.ATENCAO_", "Para prosseguir, é necessário tirar uma foto com o documento de identificação.", "warning");

                // add an "invalid" class to the field:
                y[i].className += " invalid";
                // and set the current valid status to false:
                valid = false;
                nextPrev(-1);
            }
        }

        // If the valid status is true, mark the step as finished and valid:
        if (valid) {
            document.getElementsByClassName("step")[currentTab].className += " finish";
        }
        return valid; // return the valid status
    }

    function fixStepIndicator(n) {
        // This function removes the "active" class of all steps...
        var i, x = document.getElementsByClassName("step");
        for (i = 0; i < x.length; i++) {
            x[i].className = x[i].className.replace(" active", "");
        }

        if (n >= x.length) {
            n = x.length - 1;
        }

        //... and adds the "active" class to the current step:
        x[n].className += " active";
        }

    async function getPendenciaTermo(id) {
        let url = `@String.Format("{0}/{1}",CONSTANTES.URLPortal, "api/TermoAdesaoApi/GetPendenciaTermo")?Id=${id}`;
        let retorno = false;
        await $.ajax({
            url: url,
            dataType: "json",
            type: "GET",
        }).done(function (data) {
           retorno = Boolean(data.objeto.integracaoPendente);
        });
        return retorno;
    }

    $("#check-termo").on("change", async function () {
        if ($(this).is(":checked")) {
            ShowPageLoading();
            try {
                let id = Number('@Model.IdVenda');
                let pendente = await getPendenciaTermo(id);

                if (pendente) {
                    temPendencia = pendente;
                    $("#check-termo").prop("checked", false);
                    Notificar("@RsBase.ATENCAO_", "@RsCadastros.TERMO_ADESAO_PENDENTE", "warning");
                }
                else {
                    temPendencia = false;
                    Notificar("@RsBase.INFORMACAO", "Pré-requisitos atendidos para aprovação do termo.", "info");
                }
            }
            catch (exception) {
                $("#check-termo").prop("checked", false);
                console.log(exception);
            }
            finally {
                HidePageLoading();
            }
        }
    });

