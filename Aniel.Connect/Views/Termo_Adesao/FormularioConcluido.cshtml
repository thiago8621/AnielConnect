@model Aniel.Connect.Models.TermoAdesaoFormularioConcluidoModel

@using Resources

@{
    ViewBag.Title = RsCadastros.TERMO_ADESAO;
    ViewBag.Sessao = RsCadastros.TERMO_ADESAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, shrink-to-fit=no' name='viewport' />
    <link rel="stylesheet" type="text/css" href="~/bin/Content/roboto.css" />

    <style>
        .navbar-custom {
            background-color: #473D71;
        }

        .logo {
            width: 50%
        }

        .margem {
            margin-top: 15px;
        }
    </style>
}

<nav class="navbar-custom">
    @if (Model.UrlLogo != "" && Model.UrlLogo != null)
    {
    <center>
        <img class="logo img-fluid" src="@Model.UrlLogo" alt="logo" style="width:auto;" />
        </center>
    }
    else
    {
            <center>
                <a class="navbar-brand">@Model.Empresa</a>
                </center>
    }
</nav>

<div class="main">
    <div class="section section-basic">
        <div class="container text-center">
            <div class="jumbotron margem">
                <div class="container">
                    <p class="lead">@Model.Mensagem</p>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Sucesso)
{
    <div class="col" style="text-align:center">
        <a href="@Url.Action("Formulario", "Termo_Adesao", new {Id = Model.IdVenda })" class="btn btn-danger" style="margin-top: 18px">Voltar</a>
    </div>
}




