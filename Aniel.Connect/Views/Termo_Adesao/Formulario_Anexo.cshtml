@model Aniel.Connect.Models.TermoAdesaoFormularioModel
@using Aniel.Connect.Models
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Microsoft.AspNet.Identity
@using Aniel.Connect.Models.T5

@{

    var camposObrigatorios = (Dictionary<String, Boolean>)ViewBag.CamposObrigatorios;
    var camposBloqueados = new Dictionary<string, bool>();

    var stringObrigatorio = Html.Raw("<span class=\"text-danger\">* </span>");
}

<div class="tab passo4">
    <section aria-label="Newest Photos" style="margin-bottom: 60px;">
        <div class="carousel" data-carousel>
            @if (Model.AnexosContrato != null && Model.AnexosContrato.Count > 1)
            {
                <button class="carousel-button prev" data-carousel-button="prev" type="button">&#8656;</button>
                <button class="carousel-button next" data-carousel-button="next" type="button">&#8658;</button>
            }
            <ul data-slides>
                @foreach (var item in Model.AnexosContrato)
                {
                    if (item.Id == 0)
                    {
                        <li class="slide" data-active id="pdf-@item.Id">
                            <embed src="@item.Url" class="termo" type="application/pdf">
                        </li>
                    }
                    else
                    {
                        <li class="slide" id="pdf-@item.Id">
                            <embed src="@item.Url" class="termo" type="application/pdf">
                        </li>

                    }
                }
            </ul>
        </div>
    </section>

    <div class="row text-center">
        @foreach (var item in Model.AnexosContrato)
        {
            <div class="row mt-7 form-inline">
                <div class="col-1">
                    <input type="checkbox" class="form-check-input" id="check-anexo-@item.Id"  name="check-anexo" onchange="contador_checkbox_termo_contrato(this)" />
                </div>
                <div class="col-11">
                    <span>Li e concordo plenamente com o arquivo apresentado - <b>@item.NomeArquivo</b></span>
                </div>
            </div>
        }
    </div>

    <div>
        <button class="btn btn-success btn-lg botao" type="button" id="iAceitar_Anexo" onclick="return ValidaSubmit(true, true);">Aceitar Anexos</button>
        <button class="btn btn-danger btn-lg botao" type="button" id="iRecusar" onclick="return ValidaSubmit(false, 'contrato');">Recusar Anexos</button>
    </div>

    <div style="overflow:auto;">
        <div style="float:right;">
            <button class="btn botao btn-lg btn-primary" type="button" id="prevBtn" onclick="nextPrev(-1)">Anterior</button>
        </div>
    </div>
</div>