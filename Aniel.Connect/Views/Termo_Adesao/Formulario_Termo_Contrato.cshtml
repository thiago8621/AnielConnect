@model Aniel.Connect.Models.TermoAdesaoFormularioModel
@using Aniel.Connect.Models
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Microsoft.AspNet.Identity
@using Aniel.Connect.Models.T5

@{

    var camposObrigatorios = (Dictionary<String, Boolean>)ViewBag.CamposObrigatorios;
    var camposBloqueados = new Dictionary<string, bool>();

    var stringObrigatorio = Html.Raw("<span class=\"text-danger\">* </span>");

    int i = 0;

}

<div class="tab passo5">
    <section aria-label="Newest Photos" class="mt-1">
        <div class="carousel visualizacaoPDF" data-carousel id="divCarrosselArquivos">
                @if (Model.Contratos != null && Model.Contratos.Count > 1)
                {
                <button class="carousel-button prev carrosselBtn" data-carousel-button="prev" type="button">&#8656;</button>
                <button class="carousel-button next carrosselBtn" data-carousel-button="next" type="button">&#8658;</button>
                }
            <ul data-slides class="list-group">
                    @foreach (var item in Model.Contratos)
                    {
                    <li class="slide list-group-item border-0" @if (item.Id == 0) { <text> data-active </text> } id="pdf-@item.Id">
                            <embed src="@item.Caminho" class="termoContrato" type="application/pdf" id="iVisuTermoContrato-@item.Id">

                        <a href="@item.Caminho" target="_blank"
                               id="abrirPdfBtnTermoContrato-@item.Id"
                           class="btn btn-primary text-truncate px-1"
                           style="display:none; font-size: 0.85rem;">
                                Abrir PDF - @item.Nome_Contrato
                            </a>
                            </li>
                        }
                </ul>
            </div>
        </section>

    <div class="text-center row mt-1 pt-1">
            @foreach (var item in Model.Contratos)
            {
            <div style="margin: 0 auto; max-width: 65ch; padding: 2em; text-align: left; border-radius: 5px;">
                <label class="checkboxes" style="display: flex; align-items: center; gap: 0.5em;">
                    <input data-val="true" data-val-required="O campo Aceito é obrigatório." id="check-contrato-@item.Id" name="check-contrato" onchange="contador_checkbox_termo_contrato(this)" style="display: flex; align-items: center; justify-content: flex-start;" type="checkbox" value="true">
                    
                        <span>Li e concordo plenamente com o contrato apresentado - <b>@item.Nome_Contrato</b></span>
                </label>
            </div>

            { i++; }
             }
        </div>

    @if (Model.TemAnexosDocumento)
    {
        <div>
            <button class="btn btn-success btn-lg botao" id="iAceitar_Contrato" type="button" onclick="return redirecionar_formulario_anexo(true);">Aceitar Contrato</button>
            <button class="btn btn-danger btn-lg botao" id="iRecusar" type="button" onclick="return ValidaSubmit(false, 'contrato');">Recusar Contrato</button>
        </div>
    }
    else
    {
        <div>
            <button class="btn btn-success btn-lg botao" id="iAceitar_Contrato" type="button" onclick="return ValidaSubmit(true);">Aceitar Contrato</button>
            <button class="btn btn-danger btn-lg botao" id="iRecusar" type="button" onclick="return ValidaSubmit(false, 'contrato');">Recusar Contrato</button>
        </div>
    }


        <div style="overflow:auto;">
            <div style="float:right;">
                <button class="btn botao btn-lg btn-primary" type="button" id="prevBtn" onclick="nextPrev(-1)">Anterior</button>
            </div>
        </div>
    </div>