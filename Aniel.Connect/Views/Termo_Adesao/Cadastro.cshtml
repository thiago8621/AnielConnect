@model Aniel.Connect.Models.TermoAdesaoCadastroModel
@using Aniel.Connect.Model.enumerado;

@{
    ViewBag.Title = "Cadastro Termo de Adesão";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<String> Variaveis = Enum.GetNames(typeof(VariaveisModeloContrato)).ToList();

}

@section scripts
{
    <script>

        @if (TempData["sucesso"] != null && (bool)TempData["sucesso"])
        {
            @:$(document).ready(function() {
                @:Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "Modelo do termo de adesão salvo", "info");
            @:});
        }

        @if(!string.IsNullOrEmpty(Model.NomeArquivo))
        {
            @:$('.custom-file-label').html('@Model.NomeArquivo');
        }

        $('#iArquivo').on('change', function () {
            var arquivo = $(this)[0].files[0];
            getBase64($("#btnDownloadModelo"), arquivo)

            var fileName = arquivo.name;
            $(this).next('.custom-file-label').html(fileName);
        });

        function getBase64(btnDownload, arquivo) {
            let reader = new FileReader();
            reader.onload = function (e) {

                btnDownload.prop('href', e.target.result)
                btnDownload.prop('download', arquivo.name)
            }

            reader.readAsDataURL(arquivo)
        }

    </script>
}

@using (Html.BeginForm("SalvarDocumento", "Termo_Adesao", FormMethod.Post, new { enctype = "multipart/form-data", @id = "form", autocomplete = "off" }))
{

    <div class="card" style="border:none;">
        <div class="card-body">
            <div class="sticky-top bg-white">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-file-signature"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>
            </div>
            <div class="card div-card-accord">
                <div class="card-header title-card" id="heading-4">
                    <h5 class="mb-0">
                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-4" aria-expanded="true" aria-controls="collapse-4">
                            <span class="text-bold-card"> <i class="fas fa-sitemap"></i> @RsCadastros.CRIACAO_DOCUMENTO </span>
                        </a>
                    </h5>
                </div>
                <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-8">
                                <label style="font-size: 15px; font-weight: bold "><strong>Para configurar o seu modelo de adesão, siga os seguintes passos abaixo:</strong></label><br />

                                @{
                                    string caminho = CONSTANTES.URLPortal + "/Arquivos/Modelo_Termo_Adesao/Modelo_Termo_Adesao.docx";
                                }

                                <span style="font-size:12px;">
                                    <label>
                                        @RsCadastros.CONFIGURAR_MODELO_CONTRATO_PASSO1.Replace("clique aqui e baixe um modelo padrão", "")
                                        <a href="@caminho" download="Modelo_de_Adesao.docx">clique aqui e baixe um modelo padrão</a>
                                    </label> <br />
                                    <label>@RsCadastros.CONFIGURAR_MODELO_CONTRATO_PASSO2</label> <br />
                                    <label>@RsCadastros.CONFIGURAR_MODELO_CONTRATO_PASSO3</label> <br />
                                    <label>@RsCadastros.CONFIGURAR_MODELO_CONTRATO_PASSO4</label> <br />
                                    <label>@RsCadastros.CONFIGURAR_MODELO_CONTRATO_PASSO5</label> <br />
                                </span>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group">
                                            <label><strong>@RsCadastros.ARQUIVO</strong></label>
                                            <div class="input-group">
                                                <input type="file" class="custom-file-input" accept=".docx" name="Arquivo" id="iArquivo" />
                                                <label for="Arquivo" class="custom-file-label"><i class="fas fa-upload"></i> @RsBase.ESCOLHAUMARQUIVO</label>
                                            </div>
                                        </div>
                                        <a id="btnDownloadModelo"
                                           href="@caminho"
                                           download="Modelo_Adesao">
                                            <i class="fas fa-download" style="font-size:16px;"></i> <span>Baixar Modelo Padrão</span>
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-group">
                                            <label><strong>Mensagem Para Exibir Após o Aceite do Termo</strong></label>
                                            @Html.TextAreaFor(m => m.MensagemConcluido, new { @class="form-control", @id="iMensagemConcluido", @rows="4" })
                                        </div>
                                    </div>
                                </div>
                                <div style="position:absolute; bottom:0">
                                    <input type="submit" onclick="ShowPageLoading()" class="btn btn-success" value="Salvar" />
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div style="overflow-y:scroll; max-height:20rem">
                                    <label for="listVariaveisONU">Variáveis</label>
                                    <ul id="listVariaveisONU">
                                        @foreach (var variavel in Variaveis)
                                        {
                                            <li>@variavel</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}