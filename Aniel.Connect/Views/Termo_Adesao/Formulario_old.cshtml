@model Aniel.Connect.Models.TermoAdesaoFormularioModel

@using Resources

@{
    ViewBag.Title = RsCadastros.TERMO_ADESAO;
    ViewBag.Sessao = RsCadastros.TERMO_ADESAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, shrink-to-fit=no' name='viewport' />
    <link rel="stylesheet" type="text/css" href="~/bin/Content/roboto.css" />

    <style>
        .navbar-custom {
            background-color: #473D71;
        }

        .logo {
            width: 70px;
            height: 70px;
        }

        .texto {
            font-size: 16px;
            color: black;
            text-align: left;
        }

        .margem-topo {
            margin-top: 15px;
        }

        .check {
            text-align: left;
        }

        .botao {
            margin: 15px;
            height: 40px;
        }

        .termo {
            width: 100%;
            height: 700px;
            text-align: center;
        }
    </style>
}

@section scripts {
    <script>
        var clicked = false;

        $(document).ready(function () {
            ShowPageLoading();
            $('#iframeTermo').ready(function(){
            //your code (will be called once iframe is done loading)
               

            });
        });
        
        function ValidaSubmit(aceitar) {
            if (clicked) {
                return false;
            }

            clicked = true;
            var erro = false;

            if (aceitar) {
                var isChecked = $('#check-termo').prop("checked")
                if (!isChecked) {
                    Notificar("@RsBase.ATENCAO_", "Necessário estar de acordo com o termo para continuar", "warning");
                    erro = true;
                }
            } else {
                var isChecked = $('#check-termo').prop("checked")
                if (isChecked) {
                    Notificar("@RsBase.ATENCAO_", "Para recusar o termo favor desmarcar a opção 'Li e concordo plenamente com o termo apresentado'", "warning");
                    erro = true;
                }
            }

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
        }

        window.onload = function () {
            HidePageLoading();
            @if(!Model.isIntegracao)
            {
                <text>
                    let myiFrame = document.getElementById("iframeTermo");
                    let doc = myiFrame.contentDocument;
                    doc.body.innerHTML = doc.body.innerHTML + '<style> @@media screen and (min-width: 980px) { div > p {margin-left: 90pt !important; margin-right: 90pt !important;} }</style>';
                </text>
            }
            
        }        
    </script>
}

<nav class="navbar navbar-custom">
    @if (Model.UrlLogo != "" && Model.UrlLogo != null)
    {
        <img class="logo img-fluid" src="@Model.UrlLogo" alt="logo" />
    }
    else
    {
        <a class="navbar-brand">@Model.Empresa</a>
    }
</nav>    

    <div class="main">
        <div class="section section-basic">
            <div class="container text-center">
                <p class="texto margem-topo">Prezado(a) @Model.Cliente. Para confirmar sua compra é necessário realizar a assinatura e o aceite no termo de adesão.</p>

                @if (Model.isIntegracao)
                {
                    <text>
                        <iframe class="termo"
                                src="@Model.Termo"
                                frameborder="0"
                                id="iframeTermo"></iframe>
                    </text>
                }
                else
                {
                    <text>
                        <embed src="https://drive.google.com/viewerng/viewer?embedded=true&url=@Model.Termo" width="1280" height="720" type="application/pdf">
                    </text>
                }


                @using (Html.BeginForm("Formulario", "Termo_Adesao", FormMethod.Post, htmlAttributes: new { @id = "form" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.HiddenFor(model => model.IdVenda)
                    @Html.HiddenFor(model => model.Cliente)

                    <div class="form-check check">
                        <!-- <input type="checkbox" class="form-check-input" id="check-termo"> -->
                        @Html.CheckBoxFor(model => Model.Aceito, new { @class = "form-check-input", @id = "check-termo" })
                        <label class="form-check-label texto" for="check-termo">Li e concordo plenamente com o termo apresentado</label>
                    </div>

                    <div class="row">
                        <button class="btn btn-success btn-lg botao" onclick="return ValidaSubmit(true);">Aceitar Termo</button>
                        <button class="btn btn-danger btn-lg botao" onclick="return ValidaSubmit(false);">Recusar Termo</button>
                    </div>
                }
            </div>
                </div>
    </div>

