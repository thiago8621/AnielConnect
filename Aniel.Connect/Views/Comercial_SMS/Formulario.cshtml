                }

            .navbar-custom {
                background-color: #473D71;
            }

            .logo {
                width: 70px;
                height: 70px;
            }

            .texto {
                font-size: 16px;
                color: black;
                text-align: left;
            }

            .margem-topo {
                margin-top: 15px;
            }

            .check {
                text-align: left;
            }

            .botao {
                margin: 15px;
                height: 40px;
            }

            .termo {
                width: 100%;
                height: 700px;
                text-align: center;
            }

            .input_container {
                border: 1px solid #e5e5e5;
            }

            input[type=file]::file-selector-button {
                margin-right: 20px;
                border: none;
                background: #084cdf;
                padding: 10px 20px;
                border-radius: 10px;
                color: #fff;
                cursor: pointer;
                transition: background .2s ease-in-out;
            }

                input[type=file]::file-selector-button:hover {
                    background: #0d45a5;
                }

            .form-control {
                font-weight: bold;
            }

            dy {
                font-family: sans-serif;
                margin: 0;
            }

            .area {
                margin: 10px auto;
                box-shadow: 0 10px 100px #ccc;
                padding: 20px;
                box-sizing: border-box;
                max-width: 500px;
            }

                .area video {
                    width: 100%;
                    height: auto;
                    background-color: whitesmoke;
                }

                .area textarea {
                    width: 100%;
                    margin-top: 10px;
                    height: 80px;
                    box-sizing: border-box;
                }

                .area button {
                    -webkit-appearance: none;
                    width: 100%;
                    box-sizing: border-box;
                    padding: 10px;
                    text-align: center;
                    background-color: #068c84;
                    color: white;
                    text-transform: uppercase;
                    border: 1px solid white;
                    box-shadow: 0 1px 5px #666;
                }

                    .area button:focus {
                        outline: none;
                        background-color: #0989b0;
                    }

                .area img {
                    max-width: 100%;
                    height: auto;
                }

                .area .caminho-imagem {
                    padding: 5px 10px;
                    border-radius: 3px;
                    background-color: #068c84;
                    text-align: center;
                }

                    .area .caminho-imagem a {
                        color: white;
                        text-decoration: none;
                    }

                        .area .caminho-imagem a:hover {
                            color: yellow;
                        }
    </style>
}

