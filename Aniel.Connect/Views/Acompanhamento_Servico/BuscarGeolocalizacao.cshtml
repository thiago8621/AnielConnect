@model Aniel.Connect.Models.BuscarGeolocalizacaoModels
<div id="modal-localizacao" class="modal">
    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <input type="hidden" id="iTipoModalEndereco">

            <div class="modal-header">
                <h4 align="center" class="modal-title text-muted">@RsCadastros.BUSCAR_GEOLOCALIZACAO</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="form-group row">

                    <div class="col-sm-10">
                        <input type="radio" checked name="buscarEndereco" value="endereco" class="mr-1"><strong class="mr-1">Buscar por Endereço</strong>
                        <input type="radio" name="buscarEndereco" value="latitudeLongitude" class="mr-1"><strong class="mr-1">Buscar por Latitude/Longitude</strong>
                    </div>
                </div>
                <div class="row" id="iBuscarEnderecoInput">
                    <div class="col-sm-8">
                        <div class="form-group">
                            <label for="iPesquisaMap">@RsCadastros.ENDERECO:</label>
                            <input type="text" value="" class="form-control" id="iPesquisaMap" autocomplete="off">
                        </div>
                    </div>
                    <div class="col mt-4 form-group">
                        <a href="#" onclick="PesquisaMapaEndereco();"><i class="la la-search la-2x" style="color: #999"></i></a>
                    </div>
                </div>

                <div class="row" id="iBuscarLatitudeLongitudeInput" style="display:none">
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label for="iLatitudeMap">@RsCadastros.LATITUDE:</label>
                            <input type="text" value="" class="form-control" id="iLatitudeMap" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label for="iLongitudeMap">@RsCadastros.LONGITUDE:</label>
                            <input type="text" value="" class="form-control" id="iLongitudeMap" autocomplete="off">
                        </div>
                    </div>
                    <div class="col mt-4 form-group">
                        <a href="#" onclick="PesquisaMapaLatitudeLongitude();"><i class="la la-search la-2x" style="color: #999"></i></a>
                    </div>
                </div>

                <div class="form-group row justify-content-center" style="display:none" id="iConfirmarLocalizacao">
                    <button type="button" class="btn" href="#" id="iButtonConfirmarMap">Clique para confirmar Localização</button>
                </div>
                <div id="map">Erro ao carregar Mapa </div>
            </div>
        </div>
    </div>
</div>


