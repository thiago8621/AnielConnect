                                <div id="collapse_@resp.id" class="collapse show" aria-labelledby="heading_@resp.id" data-parent="#accordion_@resp.id">
                                    <div class="card-body" style="margin-top: -20px;">
                                        <input type="text" id="pergunta_@resp.id" readonly class="form form-control" value="@resp.resposta" maxlength="300">
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    if (resp.tipo == Aniel.T5.Model.enumerado.EnumQuizTipo.Data)
                    {
