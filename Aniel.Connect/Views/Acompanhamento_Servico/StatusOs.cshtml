@{ Layout = "~/Views/Shared/_LayoutZero.cshtml"; }

    @model Aniel.Connect.Models.AcompanhamentoListaModel
    <div id="accordion" class="DivStatusOs">
        <div class="card div-card-accord">
            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                <div class="card-body">

                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label for="iNumOS"><strong>@RsFinanceiro.NUM_OS: </strong></label>
                                @Html.DisplayFor(model => model.Num_OS_Original)
                            </div>

                        </div>

                        <div class="col-sm-4 form-group">
                            <label for="iAgendamento"><strong>@RsFinanceiro.AGENDAMENTO: </strong></label>
                            @Html.DisplayFor(model => model.Agendamento)
                        </div>
                    </div>

                    <div class="row">

                        <div class="col-sm-4">
                            <div class="form-group">
                                <label for="iStatusOS"><strong>@RsFinanceiro.STATUS_OS: </strong></label>
                                @Html.DisplayFor(model => model.Status_OS)
                            </div>
                        </div>

                        <div class="col-sm-4 form-group">
                            <label for="iPeriodo"><strong>@RsFinanceiro.PERIODO: </strong></label>
                            @Html.DisplayFor(model => model.Periodo)
                        </div>




                    </div>

                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label for="iStatusOS"><strong>@RsCadastros.TIPO_SERVICO: </strong></label>
                                @Html.DisplayFor(model => model.TipoServico)
                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col-sm-4 form-group">
                            <label for="iSLA_Atual"><strong>@RsFinanceiro.SLA_ATUAL: </strong></label>
                            @Html.DisplayFor(model => model.SLA_Atual)
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>