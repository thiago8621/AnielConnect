        async function AtualizarLatLong() {

            var link = 'https://maps.googleapis.com/maps/api/geocode/json?key=@CONSTANTES.TokenGoogleAPI&address=';

            if ($('#iLogradouro').val()) {

                link = link.concat(GetEndereco());

                $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json'
                })
                    .done(function (data) {
                        $("#iLogradouroLatitude").val(data.results[0].geometry.location.lat).trigger('change');
                        $("#iLogradouroLongitude").val(data.results[0].geometry.location.lng).trigger('change');
                    })
                    .fail(function (e) {
                        Notificar("@RsBase.ATENCAO_", e, "warning");
                    })
                    .always(function () {

                    });

                let cidade = $("#iLogradouroCidade :selected").text();
                let bairro = $("#iLogradouroBairro").val();

                await GetGrupoAreabyEndereco(bairro, cidade);
            }
        }

        async function GetGrupoAreabyEndereco(bairro, cidade) {
            let request = { DescricaoBairro: bairro, DescricaoCidade: cidade };
            let link = '@String.Concat(CONSTANTES.URLPortal, "/api/GrupoAreaapi/GetGrupoAreaLocalidadeByBairro")';

            await $.ajax({
                url: link,
                type: "POST",
                dataType: "json",
                data: request,
            })
            .done(async function (data) {
                if (data.ok) {

                    let grupo_area = data.objeto.idGrupoArea;
                    let area = data.objeto.idArea;
                    let localidade = data.objeto.idLocalidade;

                    await AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, grupo_area, "@RsBase.SELECIONE", desabilitarEdit, HandleGrupo);
                    $("#iGrupoArea").val(grupo_area);

                    $('#iArea').empty();
                    $('#iLocalidade').empty();

                    let enderecoApi = "@CONSTANTES.URLPortal/api/Areaapi/GetList?grupo_area=" + grupo_area;

                    await $.ajax({
                        url: enderecoApi,
                        type: 'GET',
                        dataType: 'json'
                    })
                        .done(async function (data) {
                            $('#iArea').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));

                            $.each(data.objeto, function (key, value) {
                                $('#iArea').append($('<option></option>').attr('value', value.value).text(value.label));
                            });

                            $("#iArea").prop("disabled", false);
                            $("#iArea").val(area);

                            let localidadeApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

                            await $.ajax({
                                url: localidadeApi,
                                type: "GET",
                                dataType: "json"
                            })
                                .done(function (data) {
                                    $('#iLocalidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));


                                    $.each(data.objeto, function (key, value) {
                                        $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));

                                    });

                                    $("#iLocalidade").prop("disabled", false);
                                    $("#iLocalidade").val(localidade);
                                });
                        });
                }
            });
        }

     $("#iCEP").focus(function(){
