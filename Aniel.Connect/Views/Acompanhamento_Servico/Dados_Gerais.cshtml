        async function AdicionarInformacaoComplementar()
        {
            let texto =  await parent.Swal.fire({
                title: 'Adicione uma informação complementar',
                input: 'textarea',
                inputAttributes: {
                    autocapitalize: 'off'
                },
                showCancelButton: true,
                confirmButtonText: '@RsBase.CONFIRMAR',
                cancelButtonText: '@RsBase.CANCELAR',
                showLoaderOnConfirm: true,
                preConfirm: (texto) => {

                    if (!texto.value)
                        Swal.showValidationMessage(`Nenhum dado informado`);

                    return texto;
                },
                allowOutsideClick: () => !Swal.isLoading()
            });

            if (texto.value)
            {

                const num_obra = "@Html.Raw(Model.Num_Obra)";
                const numdoc = "@Html.Raw(Model.Num_Doc)";
                const projeto = "@Html.Raw(Model.Projeto)";
                const codct = "@Html.Raw(Model.CodCt)";
                let info = `[@User.Identity.GetUserName() - ${moment().format('DD/MM/YYYY HH:mm:ss')}]: ${texto.value}`;
                const link = '@String.Concat(CONSTANTES.URLPortal, "/api/Acompanhamento_Servicoapi/AdicionarInformacaoComplementar")';
                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        CodCt : codct,
                        Projeto : projeto,
                        Num_Obra : num_obra,
                        numDoc : numdoc,
                        Informacao : info
                    },
                    beforeSend: function () {
                        ShowPageLoading();
                    },
                    complete: function () {
                        HidePageLoading();
                    }
                }).done(function (data) {
                    if (data.ok) {
                        $(`#iInformacoesComplementares`).val(data.mensagem);
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                });
            }
        }



