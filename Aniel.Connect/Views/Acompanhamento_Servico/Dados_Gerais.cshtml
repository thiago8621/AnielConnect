        async function Reagendar() {
            let erro = false;

            @if (ViewBag.Exige_LatLong_Agendamento)
            {
                if (Model.Tipo == "M")
                {
                    <text>
                    if (!$('#iLatitudeManut').val()) {

                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LATITUDE)", "warning");
                	    erro = true;

                    }

                    if (!$('#iLongitudeManut').val()) {

                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LONGITUDE)", "warning");
                	    erro = true;

                    }
                    </text>
                }
                else
                {
                    <text>
                    if (!$('#iLogradouroLatitude').val()) {

                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LATITUDE)", "warning");
                	    erro = true;

                    }

                    if (!$('#iLogradouroLongitude').val()) {

                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LONGITUDE)", "warning");
                	    erro = true;

                    }
                    </text>
                }
            }

            const num_obra = "@Html.Raw(Model.Num_Obra)";
            const numdoc = "@Html.Raw(Model.Num_Doc)";
            const projeto = "@Html.Raw(Model.Projeto)";
            const codct = "@Html.Raw(Model.CodCt)";
            const link = '@String.Concat(CONSTANTES.URLPortal, "/api/Acompanhamento_Servicoapi/VerificarCriterioAgendamento")';
            let data = await $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    CodCt: codct,
                    Projeto: projeto,
                    Num_Obra: num_obra,
                    numDoc: numdoc,

                },
                beforeSend: function () {
                    //rotina ja possui tratamento pageLoading externamente
                    //ShowPageLoading();
                },
                complete: function () {
                    //rotina ja possui tratamento pageLoading externamente
                    //HidePageLoading();
                }
            });

            HidePageLoading();
            let temAlteracaoDadosGerais = TemAlteracao();
            if (data.ok) {
                if (temAlteracaoDadosGerais) {
                    ValidaSubmit('@Url.Action("Index", "Agendamento")' + '?CodCt=' + '@Html.Raw(Model.CodCt)' + '&Projeto=' + '@Html.Raw(Model.Projeto)' + '&Num_Obra=' + '@Html.Raw(Model.Num_Obra)' + '&Num_Doc=' + '@Html.Raw(Model.Num_Doc)');
                }
                else {
                    let url = '@Url.Action("Index", "Agendamento")' + '?CodCt=' + '@Html.Raw(Model.CodCt)' + '&Projeto=' + '@Html.Raw(Model.Projeto)' + '&Num_Obra=' + '@Html.Raw(Model.Num_Obra)' + '&Num_Doc=' + '@Html.Raw(Model.Num_Doc)';
                    parent.window.location = url;
                    ShowPageLoading();
                    erro = true;
                }
            }
            else {
                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                erro = true;
            }

            
            ShowPageLoading();
            
            if (await SalvarAntesReagendar(temAlteracaoDadosGerais) == false)
            {
                let url = '@Url.Action("Index", "Agendamento")' + '?CodCt=' + '@Html.Raw(Model.CodCt)' + '&Projeto=' + '@Html.Raw(Model.Projeto)' + '&Num_Obra=' + '@Html.Raw(Model.Num_Obra)' + '&Num_Doc=' + '@Html.Raw(Model.Num_Doc)';
                parent.window.location = url;
                ShowPageLoading();
                return false;
            }

        }

