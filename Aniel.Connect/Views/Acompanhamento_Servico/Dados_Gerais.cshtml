        async function getGoogleLatLong() {
             let link = 'https://maps.googleapis.com/maps/api/geocode/json?key=AIzaSyACnVjpiRnap58taXa7eEQJIVmD8TkoL2g&address=';

            if ($('#iNumeroManut').val()) {

                link = link.concat(GetEnderecoManut());

                try {
                    return await $.getJSON(link, async function (data) {

                        if (data.results[0]) {
                            if (!data.results[0].geometry.location.lat || !data.results[0].geometry.location.lng) {
                                Notificar("@RsBase.ATENCAO_", "@RsPontoEletronico.NAO_FOI_POSSIVEL_LOCALIZAR_LATITUDE", "warning");
                                $("#iLatitudeManut").val(null);
                                $("#iLongitudeManut").val(null);

                            }
                        }

                        let latitude = data.results[0].geometry.location.lat.toString().replace(".", ",");
                        let longitude = data.results[0].geometry.location.lng.toString().replace(".", ",");

                        $("#iLatitudeManut").val(latitude);
                        $("#iLongitudeManut").val(longitude);

                    })
                }
                catch (e) {
                    Notificar("@RsPontoEletronico.NAO_FOI_POSSIVEL_LOCALIZAR_LATITUDE", e, "warning");
                    $("#iErroApiMaps").val(e);
                }
             }
         }

        function GetEnderecoManut() {

            let endereco = "";

            if ($("#iLogradouroManut").val())
                endereco += " " + $("#iLogradouroManut").val();
            else {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LOGRADOURO)", "warning");
                return false;
            }

            if ($("#iNumeroManut").val()) {
                endereco += " " + $("#iNumeroManut").val();
            }
            else {
                return false;
            }

            if ($("#iBairroManut").val() != "")
                endereco += " " + $("#iBairroManut").val();

            if ($("#iCidadeManut").val() != "")
                endereco += " " + $("#iCidadeManut option:selected").text();

            if ($("#iUFManut").val() != "")
                endereco += " " + $("#iUFManut option:selected").text();

            return endereco;
        }

        //Espera o carregamento dos campos para depois gravar.
        let PromisseCarregar = null;
        async function PrimeiroCarregamento() {
            if (!PromisseCarregar) {
                PromisseCarregar = new Promise(async (resolve, reject) => {
                    let timeout = setTimeout(() => {
                        resolve();
                        return;
                    }, 5000);

                     await carregarCampos();
                     clearTimeout(timeout);
                    resolve();

                });
            }
            return PromisseCarregar;
        }

