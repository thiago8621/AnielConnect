                await AddSelect("iLogradouroPais", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboPais",@CONSTANTES.PaginacaoRegistros, null, null, "1", "@RsBase.SELECIONE", disabled);

                let enderecoApiCidade = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;
                let enderecoApiBairro = "@CONSTANTES.URLPortal/api/enderecoapi/GetBairrosViaCep?Bairro=" + bairro;

                $('#iLogradouroBairro').val(bairro);

                await getCidades(enderecoApiCidade, cidade);
                await getBairros(enderecoApiBairro, bairro);

                let cidadeArea = $("#iLogradouroCidade :selected").text();
                let bairroArea = $("#iLogradouroBairro").val();
                await GetGrupoAreabyEndereco(bairroArea, cidadeArea);

                jQuery(':input').keyup(function(){
                  $(this).val($(this).val().toUpperCase());
                });

                $("#iNumeroLogradouro").focus();
            })
            .fail(function () {
                console.log("error");
            })
            .always(function () {
                try {
                }
                catch (ex) { console.log(ex); }
            });
            }
    });

     async function getCidades(enderecoApiCidade, cidade = "") {
         await $.getJSON(enderecoApiCidade, function (data) {
             $('#iLogradouroCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
             $.each(data, function (key, value) {
                 $('#iLogradouroCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
             });

             if (cidade) {
                 $('#iLogradouroCidade').val($('#iLogradouroCidade' + ' > option:contains("' + cidade.toUpperCase() + '")').val());
             }
         });
    }

    async function getBairros(enderecoApiBairro, bairro = "") {

        await $.getJSON(enderecoApiBairro, function (data) {
            $('#iLogradouroBairro').empty();
            $('#iLogradouroBairro').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
            $.each(data, function (key, value) {
                $('#iLogradouroBairro').append($('<option></option>').attr('value', value.id).text(value.descricao));
            });
            if (bairro) {
                $("#iLogradouroBairro" + " option:contains('" + bairro + "')").attr("selected", true);
            }
        });
    }

    function GetEndereco() {
        var endereco = "";
         @if (!utilizaCadastroEndereco)
         {   <text>
            if ($("#iLogradouro").val())
                endereco += " " + $("#iLogradouro").val();
            else {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LOGRADOURO)", "warning");
                return false;
            }

            if ($("#iNumeroLogradouro").val())
                endereco += " " + $("#iNumeroLogradouro").val();

            if ($("#iLogradouroBairro").val())
            endereco += " " + $("#iLogradouroBairro").val();

            if ($("#iLogradouroCidade").val())
            endereco += " " + $("#iLogradouroCidade option:selected").text();

            if ($("#iLogradouroUf").val())
            endereco += " " + $("#iLogradouroUf option:selected").text();

            return endereco;
            </text>
         }
         else {
             <text>
                let logradouroText = $("#iLogradouro").html() || $("#iLogradouro").val();
                if (logradouroText) {
                    endereco += " " + logradouroText;
                }
                else
                {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LOGRADOURO)", "warning");
                    return false;
                }

                if ($("#iNumeroLogradouro").val())
                    endereco += ` ${$("#iNumeroLogradouro").val()}`;
                if ($("#iLogradouroBairro").val())
                    endereco += " " + $("#iLogradouroBairro").html();
                if ($("#iLogradouroCidade").val())
                    endereco += " " + $("#iLogradouroCidade").text();
                if ($("#iLogradouroUf").val())
                    endereco += " " + $("#iLogradouroUf").text();
                return endereco;
            </text>
         }

    }

