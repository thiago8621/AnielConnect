                verificaMotivo = true;
            } else if ($("#iMotivo_ReagendamentoM").val() != "" && $("#iMotivo_ReagendamentoM").val() != null && $("#iMotivo_ReagendamentoM").val() != undefined && $("#iMotivo_ReagendamentoM").val() == "0") {
