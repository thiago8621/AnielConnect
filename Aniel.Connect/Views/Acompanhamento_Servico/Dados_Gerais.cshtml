                              }
                          </text>
                 }

                 if (camposObrigatorios.ContainsKey(RsCadastros.LOGRADOURO)) {
                        <text>
                            if (!$('#iLogradouro').val()) {
                                Notificar("@RsBase.ATENCAO_", "É necessário informar o Logradouro", "warning");
                                erro = true;
                            }
                        </text>
                 }

                 if (camposObrigatorios.ContainsKey(RsCadastros.NUMERO)) {
                        <text>
                            if ($('#iBuscarEndereco').val() === '2') {
                                if (!$('#iNumeroLogradouro').val()) {
                                    Notificar("@RsBase.ATENCAO_", "É necessário informar o número do Logradouro", "warning");
                                    erro = true;
                                }
                            }
                        </text>
                 }

                 if (!utilizaCadastroEndereco) {

                        <text>
                           if ($("input[name='UtilizaEndeCondo']").is(":checked")) {
                               if ($('#iBuscarEndereco').val() === '3') {
                                   if (!$('#iBloco').val()) {
                                       Notificar("@RsBase.ATENCAO_", "É necessário informar o Bloco", "warning");
                                       erro = true;
                                   }
                                   else {
                                       let valorBloco = $('#iBloco').val();

                                       if (Number(valorBloco) >= 10) {
                                            Notificar("@RsBase.ATENCAO_", "É necessário informar o Bloco menor que 10", "warning");
                                       erro = true;
                                       }
                                   }
                               }
                           }
                           if ($("input[name='UtilizaEndeCondo']").is(":checked")) {
                               if ($('#iBuscarEndereco').val() === '3') {
                                   if (!$('#iApartamento').val()) {
                                       Notificar("@RsBase.ATENCAO_", "É necessário informar o número do Apartamento", "warning");
                                       erro = true;
                                   }
                               }
                           }
                        </text>
                 } else {

                         <text>
                          if ($('#iBuscarEndereco').val() === '3') {
                              if (!$('#iBloco').val()) {
                                  Notificar("@RsBase.ATENCAO_", "É necessário informar o Bloco", "warning");
                                  erro = true;
                              }
                          }
                          if ($('#iBuscarEndereco').val() === '3') {
                              if (!$('#iApartamento').val()) {
                                  Notificar("@RsBase.ATENCAO_", "É necessário informar o número do Apartamento", "warning");
                                  erro = true;
                              }
                          }
                        </text>
                 }

                 if (camposObrigatorios.ContainsKey(RsCadastros.UF)) {
                        <text>
                            if (!$('#iLogradouroUf').text()) {
                                Notificar("@RsBase.ATENCAO_", "É necessário informar o Estado/UF", "warning");
                                erro = true;
                            }
                        </text>
                 }

                 if (camposObrigatorios.ContainsKey(RsCadastros.CIDADE)) {
                        <text>
                            if (!$('#iLogradouroCidade').val()) {
                                Notificar("@RsBase.ATENCAO_", "É necessário informar a Cidade", "warning");
                                erro = true;
                            }
                        </text>
                 }

                 if (camposObrigatorios.ContainsKey(RsCadastros.BUSCAR_ENDERECO)) {
                        <text>
                            if ($('#iBuscarEndereco').val()) {
                                let valueBuscar = $('#iBuscarEndereco').val();

                                if (valueBuscar == '3') {
                                    if (!$('#iBloco').val()) {
                                        Notificar("@RsBase.ATENCAO_", "É necessário informar o Bloco do Apartamento", "warning");
                                        erro = true;
                                    }
                                    if (!$('#iApartamento').val()) {
                                        Notificar("@RsBase.ATENCAO_", "É necessário informar o Apartamento", "warning");
                                        erro = true;
                                    }
                                }
                            }
                        </text>
                 }


                 if (camposObrigatorios.ContainsKey(RsCadastros.GRUPO_AREA))
                 {

                        <text>
                            if (!$('#iGrupoArea').val()) {
                                Notificar("@RsBase.ATENCAO_", "É necessário selecionar o Grupo Área", "warning");
                                erro = true;
                            }
                        </text>
                 }

                 if (camposObrigatorios.ContainsKey(RsCadastros.AREA))
                 {
                        <text>
                            if (!$('#iArea').val()) {
                                Notificar("@RsBase.ATENCAO_", "É necessário selecionar a Área", "warning");
                                erro = true;
                            }
                        </text>
                 }

                 if (camposObrigatorios.ContainsKey(RsCadastros.LOCALIDADE))
                 {
                        <text>
                            if (!$('#iLocalidade').val()) {
                                Notificar("@RsBase.ATENCAO_", "É necessário selecionar a Localidade", "warning");
                                erro = true;
                            }
                        </text>
                 }

             }

           if (erro) {
               $("#divProgress").hide();
                clicked = false;
                return false;
            }

            //ShowPageLoading();

            if (redirecionamento) {
                $('#iRedirecionamento').val(redirecionamento);
            }

            RemoverNotificacaoCloseTab();
            $('#form').submit();

            return true;
        }


        async function acompanhaServicoOS(codct, projeto, num_obra, num_doc){

            var _codCt = codct;
            var _projeto = projeto;
            var _num_Obra = num_obra;
            var _num_Doc = num_doc;

            var url = '@Url.Action("Index", "Acompanhamento_Servico")' + "?CodCt=" + _codCt +"&Projeto=" + _projeto + "&Num_Obra=" + _num_Obra + "&Num_Doc=" + _num_Doc;


            parent.AddAba(url, '@RsCadastros.ACOMPANHAMENTO_SERVICO');

        }

        function exibirModalMotivoReagendamento() {
            $('#modal-motivo-reagendamento').modal("show");
            AddSelect("iMotivo_ReagendamentoM", "@CONSTANTES.URLPortal/api/MotivosReagendamentosapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, null, null, null);
        }

        function FecharModalReagendamento() {
            $('#modal-motivo-reagendamento').modal("hide");
        }

        $("#iEditarAtividades").on("click", function () {
            if (!$("#iMotivo_ReagendamentoM").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MOTIVO_REAGENDAMENTO)", "warning");
                return false;
            }

            if ($("#iMotivo_ReagendamentoM").val() == 0) {
                if (!$("#iMotivo_Reagendamento_Outros").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, "Motivo - OUTRO")", "warning");
                    return false;
                }
            }

            FecharModalReagendamento();
            ValidaSubmit();
        });

        $('#iMotivo_ReagendamentoM').change(function (e) {
            var id = e.target.value;
            if (id == "0") {
                $('#iMotivoReagendamentoOutros').removeClass('d-none');
            } else {
                $('#iMotivoReagendamentoOutros').addClass('d-none');
            }
        });
         ////console.log(@Model.CodCt,@Model.Projeto, @Model.Num_Doc,@Model.Num_Obra);
$("#HistoricoVicular-mod").click(function () {
    try {
        var url = $(this).data("url");

        if ($("#iHistoricoVincularFrame1").attr("src") !== url) {
            $('#iHistoricoVincularFrame1').show();
            $("#iHistoricoVincularFrame1").attr("src", url);
        } else {
            // Se já estiver com a mesma URL, apenas ativa alguma função dentro do iframe (opcional)
            if (window.frames['iHistoricoVincularFrame1'].switchTabInIframe) {
                window.frames['iHistoricoVincularFrame1'].switchTabInIframe();
            }
        }
    } catch (ex) {
        console.error("Erro ao carregar iframe:", ex);
    }
});


    </script>
}


