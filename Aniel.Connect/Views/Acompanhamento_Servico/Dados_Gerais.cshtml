                }
            } else if (dt == "Sem Agendamento" && periodo == "" && hr == "") {
                verificaMotivo = true;
            }

            var permitirMotivoReagendamento = "@ViewBag.PermitirMotivoReagendamento" ?? "False";

            if (!verificaMotivo && dataAgendamento !== "" && permitirMotivoReagendamento == "True") {
