            }
            $('#modal-localizacao').modal('hide');
        });

        let iniciando = true;
        async function initMap() {
            /*Hide transit and poi*/
            var myStyles = [
                {
                    featureType: "poi",
                    elementType: "labels",
                    stylers: [
                        { visibility: "off" }
                    ]
                },
                {
                    featureType: "transit",
                    elementType: "labels",
                    stylers: [
                        { visibility: "off" }
                    ]
                }
            ];

            map = new google.maps.Map(document.getElementById("map"), {
                center: { lat: -22.8690004, lng: -43.4790957 },
                zoom: 15,
                styles: myStyles,
                disableDefaultUI: false,
            });
            $('#iConfirmarLocalizacao').hide();

            @if (Model.Tipo == "C") {
                <text>
                    let logradouro = $("#iLogradouro").val();
                    let logradouroNum = ($("#iNumeroLogradouro").val() ?? '');
                    let logradouroCidade = $("#iLogradouroCidade :selected").text();
                    let logradouroUf = $('#iLogradouroUf :selected').text() ?? '';
                    let stringPesquisa = logradouro + ' ' + logradouroNum + ' ' + logradouroCidade + ' ' + logradouroUf;
                    $('#iPesquisaMap').val(stringPesquisa);
                    PesquisaMapaEndereco();
                    getLocation();
                </text>
            } else {
                  <text>
                    let logradouro = $("#iLogradouroManut").val();
                    let logradouroNum = ($("#iNumeroManut").val() ?? '');
                    let logradouroCidade = $("#iCidadeManut :selected").text();
                    let logradouroUf = $('#iUfManut :selected').text() ?? '';
                    let stringPesquisa = logradouro + ' ' + logradouroNum + ' ' + logradouroCidade + ' ' + logradouroUf;
                    $('#iPesquisaMap').val(stringPesquisa);
                    PesquisaMapaEndereco();
                    getLocation();
                </text>
            }
        }

        @*
            Verifica se houve alteração nos dados gerais. Essa função é chamada da Index do Acompanhamento de Serviço na função
            AvisoSemSalvar(link) para determinar se é necessário exibir uma mensagem para avisar que há alterações não salvas
            que podem ser perdidas ao sair sem gravar.
        *@
        function TemAlteracao() {

            if (terminouCarregarCampos == false)
            {
                return false;
            }

            let dataAgendamento = "@Html.Raw(Model.Data)";

            if (dataAgendamento == "Sem Agendamento") {
                dataAgendamento = "";
            }

            //Burlando ids diferentes em Manutenção e Cliente
            var CodGrupoArea = "";
            var CodArea = "";
            var CodLocalidade = "";
