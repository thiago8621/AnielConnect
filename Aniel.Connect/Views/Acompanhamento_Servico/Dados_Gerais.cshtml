@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script src="https://maps.googleapis.com/maps/api/js?key=@CONSTANTES.TokenGoogleAPI&libraries=places,geometry"
            async defer></script>
    <script>
        var desabilitarEdit = @Json.Encode(desabilitarEdit);
        var temAcesso364 = @Json.Encode(temAcesso364);
        let tipoCliente = "@Model.Tipo" === "C";
        let terminouCarregarCampos = false;
        let enderecoValue;
        let idBuscaEndereco;
        let isCheckedEndeCondo = false;
        let dataAgendamento = "";

        $(document).ready(function() {
            dataAgendamento = $("#idataAgendamento").val();

            $('#modal-OS').on('hidden.bs.modal', function () {
                // Limpa o conteúdo carregado
                $('#iHistoricoVincularFrame1').attr('src', '');
        });
        });

        window.addEventListener("message", function (event) {
            const pagina = event.data;
            if (pagina.action === "addTabs") {
                parent.AddAba(pagina.data.url, pagina.data.title);
            }
        });

        $("#iCEP").mask("99999-999");
        $("#iCEP").attr('placeholder', '00000-000');

        let selectsCarregados = false;
        //#region Modal de aviso ao sair sem salvar

        function NotificarCloseTab() {
            $('form').on('change paste, input, select, textarea', function () {
                try {
                    if (TemAlteracao()) {
                        parent.ModalPergunta = true;
                        parent.parent.document.getElementsByClassName('menu_tab active')[0].children[1].setAttribute("onclick", `AvisoSalvarAntesDeFechar(${parent.parent.getActivePageId()},"iDadosGeraisFrame");`);
                    }

                } catch { }
            });

        }

        function RemoverNotificacaoCloseTab() {
            try {
                parent.ModalPergunta = true;
                parent.parent.document.getElementsByClassName('menu_tab active')[0].children[1].setAttribute("onclick", `closeTab(this);`);
            } catch { }
        }

        //#endregion

         function onClickCancela() {
             if (TemAlteracao()) {
                 parent.AvisoSemSalvar('@Url.Action("Index", "Painel_Servicos")');
         } else {
                 window.parent.location.href = '@Url.Action("Index", "Painel_Servicos")';
             }
         }

        function SwalReagendarCritica() {
            Swal.fire({
                title: "Cliente ainda não efetuou o pagamento da instalação. Deseja continuar com o agendamento?",
                type: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não'
            }).then((result) => {
                if (result.value){
                    var url = '@Url.Action("Index", "Agendamento")' + '?CodCt=' + '@Html.Raw(Model.CodCt)' + '&Projeto=' + '@Html.Raw(Model.Projeto)' + '&Num_Obra=' + '@Html.Raw(Model.Num_Obra)' + '&Num_Doc=' + '@Html.Raw(Model.Num_Doc)';
                    parent.window.location = url;
                    ShowPageLoading();
                    return false;
                }
            });
        }

        let marcadorAutoComplete;
        let autocomplete

        $('input[type=radio][name=buscarEndereco]').change(function () {
            if (this.value == 'endereco') {
                $('#iBuscarEnderecoInput').show();
                $('#iBuscarLatitudeLongitudeInput').hide();
            }
            else if (this.value == 'latitudeLongitude') {
                $('#iBuscarLatitudeLongitudeInput').show();
                $('#iBuscarEnderecoInput').hide();
            }
        });

        async function PesquisaMapaEndereco() {
            try {

                let pesquisa = $("#iPesquisaMap").val();
                var service = new google.maps.places.PlacesService(map);

                var request = {
                    query: pesquisa,
                    fields: ['name', 'geometry'],
                };

                service.findPlaceFromQuery(request, function (results, status) {


                    if (marcadorAutoComplete) {
                        marcadorAutoComplete.setMap(null);
                        $('#iConfirmarLocalizacao').hide();
                    }

                    if (status === google.maps.places.PlacesServiceStatus.OK) {

                        if (results.length > 0) {

                            let latlng = {
                                lat: results[0].geometry.location.lat(),
                                lng: results[0].geometry.location.lng()
                            };

                            marcadorAutoComplete = new google.maps.Marker({
                                position: latlng,
                                map: map,
                                draggable: true,
                                title: "Resultado da Busca"
                            });

                            marcadorAutoComplete.addListener('dragend', handleDragEnd);
                            $('#iLatitudeMap').val(marcadorAutoComplete.position.lat())
                            $('#iLongitudeMap').val(marcadorAutoComplete.position.lng())
                            $('#iConfirmarLocalizacao').show();

                            map.setCenter(results[0].geometry.location);
                        }
                    } else if (status === google.maps.places.PlacesServiceStatus.ZERO_RESULTS) {
                        Notificar("@RsBase.ATENCAO_", "Nenhum resultado foi encontrado para a solicitação. Por favor, verifique a localização.", "warning");
                    } else if (status === google.maps.places.PlacesServiceStatus.UNKNOWN_ERROR) {
                        Notificar("@RsBase.ATENCAO_", "Não foi possível processar a solicitação. Tente novamente mais tarde!", "warning");
                    } else if (status === google.maps.places.PlacesServiceStatus.NOT_FOUND) {
                        Notificar("@RsBase.ATENCAO_", "O lugar referenciado não foi encontrado! Por favor, verifique a localização.", "warning");
                    }
                });

            }
            catch (e) { console.log(e) }
        }

        async function PesquisaMapaLatitudeLongitude() {
            try
            {
                let latlng = "";

                @if (Model.Tipo == "C") {
                    <text>
                        latlng = {
                            lat: parseFloat($('#iLogradouroLatitude').val().replace(",", ".")),
                            lng: parseFloat($('#iLogradouroLongitude').val().replace(",", "."))
                        };
                    </text>

                } else {
                    <text>
                        latlng = {
                            lat: parseFloat($('#iLatitudeMap').val().replace(",", ".")),
                            lng: parseFloat($('#iLongitudeMap').val().replace(",", "."))
                        };
                    </text>
                }


                if (marcadorAutoComplete)
                {
                    marcadorAutoComplete.setMap(null);
                    $('#iConfirmarLocalizacao').hide();
                }

                const geocoder = new google.maps.Geocoder();
                geocoder
                    .geocode({ location: latlng })
                    .then(async (response) => {
                        if (response.results[0]) {
                            map.setZoom(11);

                            marcadorAutoComplete = new google.maps.Marker({
                                position: latlng,
                                map: map,
                                draggable: true,
                                title: "Resultado da Busca"
                            });
                            marcadorAutoComplete.addListener('dragend', handleDragEnd);
                            $('#iConfirmarLocalizacao').show();
                            map.setCenter(latlng);
                        }
                        else {
                            window.alert("No results found");
                        }
                    })

            }
            catch (e) { console.log(e) }
        }

        function showPosition(position) {
            let latlng = { lat: position.coords.latitude, lng: position.coords.longitude };
            map.setCenter(latlng);
        }

        function getLocation() {


            @if (Model.Tipo == "M")
            {
                <text>
                latlng = { lat: Number($('#iLatitudeManut').val().replace(',', '.')), lng: Number($('#iLongitudeManut').val().replace(',', '.')) };
                </text>
            }
            else
            {
                <text>
                latlng = { lat: Number($('#iLogradouroLatitude').val().replace(',', '.')), lng: Number($('#iLogradouroLongitude').val().replace(',', '.')) };
                </text>
            }

            if (latlng.lat && latlng.lng)
            {
                map.setCenter(latlng);
                marcadorAutoComplete = new google.maps.Marker({
                    position: latlng,
                    map: map,
                    draggable: true,
                    title: "Resultado da Busca"
                });

                marcadorAutoComplete.addListener('dragend', handleDragEnd);
            }
            else {
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(showPosition);
                } else {
                    Notificar("@RsBase.ATENCAO_", "A geolocalização não é suportada por este navegador", "warning");
                }
            }
        }


        function handleDragEnd(event) {

            if ($('input[name=buscarEndereco]:checked').val() == "latitudeLongitude") {
                $('#iLatitudeMap').val(marcadorAutoComplete.position.lat())
                $('#iLongitudeMap').val(marcadorAutoComplete.position.lng())
            }

            $('#iConfirmarLocalizacao').show();
        }

        $('#iConfirmarLocalizacao').click(function () {
            $('#iConfirmarLocalizacao').hide();

            if ($('input[name=buscarEndereco]:checked').val() == "endereco") {
                @if (Model.Tipo == "M")
                {
                    <text>
                    $('#iLatitudeManut').val(marcadorAutoComplete.position.lat())
                    $('#iLongitudeManut').val(marcadorAutoComplete.position.lng())
