        async function ObterEnderecoCondominio() {
            await AddSelect("iId_Condominio_Predio", "@CONSTANTES.URLPortal/api/CondominioPredioapi/GetComboEndereco", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", desabilitarEdit, x = async function () {
            $("#iId_Condominio_Predio").on('select2:select select2:unselecting', async function (e) {

                let CondominioPredioSelecionado = e?.params?.data;

                if (e?.params?._type == "select") {
                    $("#iBuscarEndereco").val('3');
                    $('#iLogradouro').val(CondominioPredioSelecionado.endereco_Logradouro);
                    $("#iLogradouroBairro").val(CondominioPredioSelecionado.bairro);
                    $("#iCEP").val(CondominioPredioSelecionado.cep);
                    $("#iLogradouroComplemento").val(CondominioPredioSelecionado.descricao);
                    $("#iNumeroLogradouro").val(CondominioPredioSelecionado.numero);
                    $("#iTipo").val(CondominioPredioSelecionado.tipo_Endereco_Logradouro);
