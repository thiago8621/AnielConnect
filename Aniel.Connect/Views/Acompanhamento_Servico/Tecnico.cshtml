                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="modal" id="iModalElementos">
        <div class="modal-dialog modal-sm mt-3 text-left">
            <div class="modal-content">

                <div class="modal-header">
                    <h4>Nova Caixa e Porta de Elemento de Rede</h4>
                    <button type="button" class="iAlteraCP_FTTH" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="iNovaCaixa">  @RsCadastros.CAIXA_FTTH</label>
                                    @Html.DropDownListFor(m => m.NovaCaixa, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iNovaCaixa", @autocomplete = "off" })
                                    
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="iNovaPorta">@RsCadastros.PORTA_FTTH:</label>
                                    @Html.DropDownListFor(m => m.NovaPorta, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iNovaPorta" })                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-sm-12" style="padding: 10px;">
                        <div class="text-center">
                            <button type="button" class="btn btn-danger" data-dismiss="modal">@RsBase.CANCELAR</button>
                            <button type="button" class="btn btn-success" id="btnAlteraCaixa">@RsBase.SALVAR</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
