                                            url: '@String.Concat(CONSTANTES.URLPortal, "/api/Area_ManutencaoApi/BuscarPontosAfetados")',
                                            method: 'POST',
                                            dataType: 'json',
                                            data: {
                                                NodeId: node.id, Codct: "@Html.Raw(Model.CodCt)", Projeto: "@Html.Raw(Model.Projeto)",
                                                NumDoc: "@Html.Raw(Model.Num_Doc)", NumObra: "@Html.Raw(Model.Num_OS)", Tipo: node.li_attr['data-type'],
                                                NodeProximo: node.li_attr['data-proximo'], NodePai: node.li_attr['data-pai'],
                                                NodeAvo: node.li_attr['data-avo'], Skip: node.li_attr['data-skip']
                                            },
                                             success: function (filhos) {
                                                 if (filhos.idObjeto != null && filhos.ok) {
                                                      callback(filhos.idObjeto);
                                                }
                                            }
                                        });
                                    }
                                }
                            },
                            "types": {
                                "default": { "icon": false },
                                "folder": { "icon": false },
                                "file": { "icon": true },
                                "trash": { "icon": "fa fa-trash custom-trash-icon" }
                            },
                            "plugins": ["types", "html"],
                            "html": true
                        });
                    }
                    else if (dadosIniciais.ok) {

                        //mostrar div com 0 dados;
                    }


                    // Passo 2: iniciar jsTree com os dados iniciais
                }
            });
        }


