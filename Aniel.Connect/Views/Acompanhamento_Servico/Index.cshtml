                            "core": {
                                "themes": {
                                    "variant": "large",
                                    "dots": false
                                },
                                "check_callback": true,
                                'data': function (node, callback) {
                                    // Se for o carregamento inicial
                                    if (node.id === "#") {
                                        callback(dadosIniciais.idObjeto);
                                    } else {
                                        // Passo 3: carregar filhos sob demanda
                                        console.log("skip value");
                                        console.log(node.li_attr['data-skip']);

