        async function BuscarPontosAfetados() {

            $('#jstree').jstree('destroy');
            $('#jstree').empty();

            await $.ajax({
                url: '@String.Concat(CONSTANTES.URLPortal, "/api/Area_ManutencaoApi/BuscarPontosAfetados")',
                data: { nodeId: '#',  Codct: "@Html.Raw(Model.CodCt)", Projeto: "@Html.Raw(Model.Projeto)",
                        NumDoc: "@Html.Raw(Model.Num_Doc)", NumObra: "@Html.Raw(Model.Num_OS)", Tipo: 'POP'
                },
                method: 'POST',
                dataType: 'json',
                success: function (dadosIniciais) {
                    if (dadosIniciais.idObjeto != null && dadosIniciais.ok) {

                        $("#iQtdCliAfetados").text(dadosIniciais.recordsClientes);
                        $("#iQtdPontosAfetados").text(dadosIniciais.recordsTotal);
