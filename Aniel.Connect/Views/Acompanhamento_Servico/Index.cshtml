    function FuncaoCancelar (){

        var iframe = document.getElementById('iDadosGeraisFrame');

        if (iframe.offsetParent === null) {

            var iframe = document.getElementById('iTecnicoFrame'); //Tecnico
            AvisoSemSalvar('@Url.Action("Index", "Painel_Servicos")');
        }
        else
        {
            iframe.contentWindow.onClickCancela(); //Dados Gerais
        }

    };

    async function SwalVincularAtendimento() {

        const iframe = document.getElementById('iVincularAtendimentoFrame1');
        if (!iframe) return;

        const iframeContent = iframe.contentDocument || iframe.contentWindow?.document;
        if (!iframeContent) return;

        const tabela = iframeContent.getElementById('datatable');
        if (!tabela) return;

        const rows = tabela.getElementsByTagName('tr');
        const atendimentosSelecionados = [];

        for (let i = 0; i < rows.length; i++) {
            const checkbox = rows[i].querySelector('input[type="checkbox"]');
            const numeroCell = rows[i].getElementsByTagName('td')[1];

            if (checkbox && checkbox.checked && numeroCell) {
                const idAtendimento = numeroCell.innerText.trim();
                atendimentosSelecionados.push(idAtendimento);
            }
        }

        if (atendimentosSelecionados.length === 0) {
            Swal.fire("Atenção", "Por favor, selecione ao menos um atendimento para vincular.", "warning");
            return;
        }
            Swal.fire({
                title: "Deseja Vincular o  Atendimento a Ordem de Serviço ?",
                text: "Não será possível retornar essa ação !",
                type: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não'
            }).then((result) => {
                if (result.value)
                    var iframe = document.getElementById('iVincularAtendimentoFrame1');
                if (iframe) {
                    var iframeContent = iframe.contentDocument || iframe.contentWindow.document;
                    var tabela = iframeContent.getElementById('datatable');
                    if (tabela) {
                        var rows = tabela.getElementsByTagName('tr');
                        for (var i = 0; i < rows.length; i++) {
                            var checkbox = rows[i].getElementsByTagName('input')[0];
                            var numeroCell = rows[i].getElementsByTagName('td')[1];
                            if (checkbox && numeroCell) {
                                var IdAtendimento = numeroCell.innerText;
                                if (checkbox.checked) {
                                    VincularAtendimento(IdAtendimento);
                                }
                            }
                        }

                    }
                }
            });
        }


        async function VincularAtendimento(IdAtendimento) {
              $('#modal-vincular').modal('hide');

               $("#divProgress").show();

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Acompanhamento_ServicoApi/VincularAtendimento")';

               var requestData = {
                  codCt: "@Html.Raw(Model.CodCt)",
                  projeto: "@Html.Raw(Model.Projeto)",
                  usuario: "@User.Identity.GetUserId()",
                  Num_OS: "@Html.Raw(Model.Num_OS)",
                  Num_Doc:"@Html.Raw(Model.Num_Doc)",
                  idAtendimento: IdAtendimento
               };

               await $.ajax({
                   url: link,
                   type: 'POST',
                   dataType: 'json',
                   data: requestData
               }).done(function (data) {
                   if (data.ok) {

                       setTimeout(() => {
                           location.reload();
                           ShowPageLoading();
                       }, 1000);
                       ShowPageLoading();
                      Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                      rows_selected = [];

                   }
                   else {
                       Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                   }
               });
            $("#divProgress").hide();
            HidePageLoading();
        }

    function FuncaoGravar() {

        var iframe = document.getElementById('iDadosGeraisFrame'); //Dados Gerais

        if (iframe.offsetParent === null) {
            var iframe = document.getElementById('iTecnicoFrame'); //Tecnico
        }

        return iframe.contentWindow.ValidaSubmit();

    };


    let zoom = false;
    var rotacao = 0;
    var modal = document.getElementById("modalFoto");

    const exibirModalAvisoSemSalvar = true;

    async function AvisoSemSalvar(link) {
        let iframeDadosGerais = document.getElementById("iDadosGeraisFrame").contentWindow;
        let iframeTecnico = document.getElementById("iTecnicoFrame").contentWindow;

        let temAlteracaoDadosGerais = false;
        let temAlteracaoTecnico = false;

        if (iframeDadosGerais && document.getElementById("iDadosGeraisFrame").getAttribute("src") && (typeof iframeDadosGerais.TemAlteracao === "function")) {
            temAlteracaoDadosGerais = iframeDadosGerais.TemAlteracao();
        }

        if (iframeTecnico && document.getElementById("iTecnicoFrame").getAttribute("src") && (typeof iframeTecnico.TemAlteracao === "function")) {
            temAlteracaoTecnico = iframeTecnico.TemAlteracao();
        }

        if (exibirModalAvisoSemSalvar && (temAlteracaoDadosGerais || temAlteracaoTecnico)) {
            let result = await Swal.fire({
            title: 'Você está saindo da tela de edição da ordem de serviço, porém há dados alterados que ainda não foram salvos. Deseja salvar essas alterações?',
                    text: "",
                    showCancelButton: true,
                    cancelButtonText: 'Não',
                    confirmButtonText: 'Sim',
                    type: 'question',
                    allowOutsideClick: () => !Swal.isLoading(),
                });

    if (!result.value)
    {
        parent.parent.document.getElementsByClassName('menu_tab active')[0].children[1].setAttribute("onclick", "closeTab(this);");
        window.location = link;
        ShowPageLoading();
        return true;
    }
    else
    {
        if (temAlteracaoDadosGerais && iframeDadosGerais && document.getElementById("iDadosGeraisFrame").getAttribute("src") && (typeof iframeDadosGerais.ValidaSubmit === "function")) {
            temAlteracaoDadosGerais = iframeDadosGerais.ValidaSubmit(link);
            return true;
        }

        if (temAlteracaoTecnico && iframeTecnico && document.getElementById("iTecnicoFrame").getAttribute("src") && (typeof iframeDadosGerais.ValidaSubmit === "function")) {
            temAlteracaoTecnico = iframeTecnico.ValidaSubmit(link);
            return true;
        }
    }
            }

            @* Seguindo o link informado *@
            parent.parent.document.getElementsByClassName('menu_tab active')[0].children[1].setAttribute("onclick", "closeTab(this);");
            window.location = link;
            ShowPageLoading();

            return true;
        }

