        function salvarMotivo() {
            // Obtém os valores necessários do modelo para compor a URL da API
            const num_obra = "@Html.Raw(Model.Num_OS)";  // Número da obra
            const numdoc = "@Html.Raw(Model.Num_Doc)";   // Número do documento
            const projeto = "@Html.Raw(Model.Projeto)";  // Nome ou código do projeto
            const codct = "@Html.Raw(Model.CodCt)";      // Código do contrato

            // Captura o motivo selecionado pelo usuário no dropdown
            var codMotivo = $('#iMotivo_CancelamentoM').val();

            // Captura a descrição do motivo se o usuário preencher o campo adicional
            var descricaoMotivo = $('#iMotivoCancelamentoOutros').val();

            // Verifica se o usuário selecionou um motivo. Se não, exibe um alerta e interrompe a execução
            if (!codMotivo) {
                   Notificar("@RsBase.ATENCAO_", "Selecione um motivo", "warning");
                 return;
            }

            // Monta a URL da API para alterar o status, incluindo os parâmetros necessários
            const link = '@String.Concat(CONSTANTES.URLPortal, "/api/Acompanhamento_Servicoapi/AlterarStatus")' +
                `?CodCt=${codct}&Projeto=${projeto}&Num_Obra=${num_obra}&numDoc=${numdoc}&Usuario=@Html.Raw(User.Identity.GetUserId())&CodMotivo=${codMotivo}&MotivoCancelamento=${descricaoMotivo}`;

               $.ajax({
                        url: link,
                        type: 'GET',
                        beforeSend: function () {
                            $("#divProgress").show();
                        }
                    }).done(function (data) {
                        if (data.ok) {
                            document.location.reload(true);
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            $("#divProgress").hide();
                        }
                    });
        }
        function ModalFoto(id,idItem) {
