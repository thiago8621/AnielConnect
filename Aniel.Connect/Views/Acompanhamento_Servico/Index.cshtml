                                    if (Model.Status_Auditoria == null && Model.Status_Execucao == Aniel.T5.Model.enumerado.StatusExecucaoAniel.Fechada_Produtiva || Model.Status_Auditoria == null && Model.Status_Execucao == Aniel.T5.Model.enumerado.StatusExecucaoAniel.Fechada_Improdutiva)
