        async function AtualizarBreadCrumb(elementoAtual, elementoPai, elementoAvo, elementoBizAvo) {

            $("#iBreadcrumb").empty();

            let textoBreadCrumb = "";
            let tipoPontoAfetado = $("#iBuscarPontos option:selected").val();

            if (tipoPontoAfetado == "1") {
                switch (passoAtual) {
                    case 1:
                        textoBreadCrumb = `${elementoAtual} >`
                        break;
                    case 2:
                        textoBreadCrumb = `${elementoAtual} >`
                        break;
                    case 3:
                        textoBreadCrumb = `${elementoPai}` + " > " + `${elementoAtual}`;
                        break;
                    case 4:
                        textoBreadCrumb = `${elementoAvo}` + " > " + `${elementoPai}` + " > " + `${elementoAtual}`;
                        break;
                    case 5:
                        textoBreadCrumb = `${elementoBizAvo}` + " > " + `${elementoAvo}` + " > " + `${elementoPai}` + " > " + `${elementoAtual}`;
                        break;
                }
            }
            else if (tipoPontoAfetado == "2") {
                switch (passoAtual) {
                    case 1:
                        textoBreadCrumb = `${elementoAtual } >`
                        break;
                    case 2:
                        textoBreadCrumb = `${elementoPai}` + " > " + `${elementoAtual}`;
                        break;
                    case 3:
                        textoBreadCrumb = `${elementoAvo}` + " > " + `${elementoPai}` + " > " + `${elementoAtual}`;
                        break;
                }
            }
            else if (tipoPontoAfetado == "3") {
                switch (passoAtual) {
                    case 1:
                        textoBreadCrumb = `${elementoAtual} >`
                        break;
                    case 2:
                        textoBreadCrumb = `ENDEREÇAMENTO` + " > " + `${elementoAtual}`;
                        break;
                }
            }

            $("#iBreadcrumb").append(`<p style="margin-top:15px;font-size: 16px;"><b>${textoBreadCrumb}<b></p>`);
        }

        async function ConfirmarSelecao() {
            let erroConfirm = false;

            let pontoSelecionado = {
                Codct: "@Html.Raw(Model.CodCt)",
                Projeto: "@Html.Raw(Model.Projeto)",
                NumDoc: "@Html.Raw(Model.Num_Doc)",
                NumObra: "@Html.Raw(Model.Num_OS)",
                Tipo: "",
                Ids: []
            };


            let tipoSelecionado = $("#iBuscarPontos option:selected").val();
            let ids = [];
            let arrayIdsTipoElementoRede = [];
            let idPop = "";
            let tipo = "";
            let idTipoElemento = "";
            if (tipoSelecionado == "1") {
                switch (passoAtual) {
                    case 1:
                        var checkboxesMarcados = $("input[name='containerPrimeiro[]']:checked").toArray();

                        if (checkboxesMarcados.length < 1) {
                            Notificar("ATENCAO!", "Selecione um registro", "warning")
                            return;
                        }

                        ids = [];
                        tipo = "";
                        idPop = "";

                        for (let check of checkboxesMarcados) {
                            let idCheck = $(check).data("id");
                            tipo = $(check).data("tipo");
                            idPop = $(check).data("idpai");
                            ids.push(idCheck);
                        }
                        pontoSelecionado.IdPop = idPop;
                        pontoSelecionado.Tipo = tipo;
                        pontoSelecionado.Ids = ids;
                        break;
                    case 2:
                        var checkboxesMarcados = $("input[name='containerSegundo[]']:checked").toArray();

                        if (checkboxesMarcados.length < 1) {
                            Notificar("ATENCAO!", "Selecione um registro", "warning")
                            return;
                        }
                        ids = [];
                        tipo = "";
                        idPop = "";
                        var idsTipos = [];
                        for (let check of checkboxesMarcados) {
                            let idCheck = $(check).data("id");
                            tipo = $(check).data("tipo");
                            idPop = $(check).data("idpai");
                            ids.push(idPop);
                            idsTipos.push(tipo);
                            //ids.push(idCheck);
                        }

                        pontoSelecionado.Tipo = ids.length > 1 ? "POP" : tipo;
                        pontoSelecionado.IdPop = idPop;
                        pontoSelecionado.Ids = ids;
                        pontoSelecionado.IdsTipos = idsTipos;
                        break;
                    case 3:

                        var checkboxesMarcados = $("input[name='containerTerceiro[]']:checked").toArray();

                        if (checkboxesMarcados.length < 1) {
                            Notificar("ATENCAO!", "Selecione um registro", "warning")
                            return;
                        }

                        ids = [];
                        idPop = "";
                        tipo = "";

                        for (let check of checkboxesMarcados) {
                            let idCheck = $(check).data("id");
                            idPop = $(check).data("idpai");
                            tipo = $(check).data("tipo");
                            ids.push(idCheck);
                        }

                        pontoSelecionado.Tipo = tipo;
                        pontoSelecionado.IdPop = idPop;
                        pontoSelecionado.Ids = ids;
                        break;
                    case 4:
                        var checkboxesMarcados = $("input[name='containerQuarto[]']:checked").toArray();

                        if (checkboxesMarcados.length < 1) {
                            Notificar("ATENCAO!", "Selecione um registro", "warning")
                            return;
                        }

                        ids = [];
                        idPop = "";
                        tipo = "";

                        for (let check of checkboxesMarcados) {
                            let idCheck = $(check).data("id");
                            idPop = $(check).data("idavo");
                            tipo = $(check).data("tipo");
                            ids.push(idCheck);
                        }

                        pontoSelecionado.Tipo = tipo;
                        pontoSelecionado.IdPop = idPop;
                        pontoSelecionado.Ids = ids;

                        break;
                    case 5:
                        var checkboxesMarcados = $("input[name='containerQuinto[]']:checked").toArray();

                        if (checkboxesMarcados.length < 1) {
                            Notificar("ATENCAO!", "Selecione um registro", "warning")
                            return;
                        }

                        ids = [];
                        idPop = ""
                        tipo = "";

                        for (let check of checkboxesMarcados) {
                            let idCheck = $(check).data("id");
                            idPop = $(check).data("idbizavo");
                            tipo = $(check).data("tipo");
                            ids.push(idCheck);
                        }

                        pontoSelecionado.Tipo = tipo;
                        pontoSelecionado.IdPop = idPop;
                        pontoSelecionado.Ids = ids;

                        break;
                }
            }
            else if (tipoSelecionado == "2") {
                switch (passoAtual) {
                    case 1:
                        var checkboxesMarcados = $("input[name='containerPrimeiro[]']:checked").toArray();

                        if (checkboxesMarcados.length < 1) {
                            Notificar("ATENCAO!", "Selecione um registro", "warning")
                            return;
                        }

                        ids = [];
                        arrayIdsTipoElementoRede = [];
                        idTipoElemento = "";

                        for (let check of checkboxesMarcados) {
                            let idCheck = $(check).data("id");
                            tipo = $(check).data("tipo");
                            let iscaixa = $(check).data("caixa");

                            var elemento = {
                                IdElemento: idCheck,
                                Tipo: tipo
                            };

                            arrayIdsTipoElementoRede.push(idCheck);
                            ids.push(elemento);
                        }

                        pontoSelecionado.Ids = arrayIdsTipoElementoRede;
                        pontoSelecionado.Tipo = tipo;
                        pontoSelecionado.ElementosRedeRequests = ids;
                        pontoSelecionado.IdTipoElementoRede = ids.filter(x => x.IdElemento)[0].IdElemento;
                        break;
                    case 2:
                        var checkboxesMarcados = $("input[name='containerSegundo[]']:checked").toArray();

                        if (checkboxesMarcados.length < 1) {
                            Notificar("ATENCAO!", "Selecione um registro", "warning")
                            return;
                        }

                        ids = [];
                        arrayIdsTipoElementoRede = [];
                        idTipoElemento = "";
                        for (let check of checkboxesMarcados) {
                            let idCheck = $(check).data("id");
                            idTipoElemento = $(check).data("idpai");
                            tipo = $(check).data("tipo");
                            let iscaixa = $(check).data("caixa");

                            var elemento = {
                                isCaixa: iscaixa,
                                IdElemento: idCheck,
                                Tipo: tipo
                            };

                            arrayIdsTipoElementoRede.push(idTipoElemento);
                            ids.push(elemento);
                        }

                        pontoSelecionado.Ids = arrayIdsTipoElementoRede;
                        pontoSelecionado.Tipo = tipo;
                        pontoSelecionado.IdTipoElementoRede = arrayIdsTipoElementoRede.filter(x => x)[0];
                        pontoSelecionado.ElementosRedeRequests = ids;
                        break;
                    case 3: {
                        var checkboxesMarcados = $("input[name='containerTerceiro[]']:checked").toArray();
                        var todosElementos = $("input[name='containerTerceiro[]']").toArray();

                        if (checkboxesMarcados.length < 1) {
                            Notificar("ATENCAO!", "Selecione um registro", "warning")
                            return;
                        }

                        var elementoContainer = todosElementos[0];
                        let idAvo = $(elementoContainer).data("idavo");
                        let idElementoPai = $(elementoContainer).data("idpai");
                        let tipo = $(elementoContainer).data("tipo");

                        var elemento = {
                            IdElemento: idElementoPai,
                            Tipo: tipo,
                            idsPortas: [],
                            isCaixa: "SIM"
                        };

                        var listasPortas = [];

                        for (let check of checkboxesMarcados) {
                            let idCheck = $(check).data("id");
                            listasPortas.push(idCheck);
                        }

                        elemento.idsPortas = listasPortas;
                        ids.push(elemento);

                        pontoSelecionado.Ids = ids;
                        pontoSelecionado.Tipo = tipo;
                        pontoSelecionado.IdTipoElementoRede = idAvo;
                        pontoSelecionado.ElementosRedeRequests = ids;
                    }
                }
            }
            else {
                switch (passoAtual) {
                    case 1:
                        var checkboxesMarcados = $("input[name='containerPrimeiro[]']:checked").toArray();

                        if (checkboxesMarcados.length < 1) {
                            Notificar("ATENCAO!", "Selecione um registro", "warning")
                            return;
                        }

                        if (checkboxesMarcados.length == 2) {
                            Notificar("ATENCAO!", "Selecione ENDEREÇO/LOGRADOURO ou CONDOMÍNIO/PRÉDIO", "warning")
                            return;
                        }

                        ids = [];
                        idTipoElemento = "";

                        for (let check of checkboxesMarcados) {
                            let idCheck = $(check).data("id");
                            tipo = $(check).data("tipo");
                            ids.push(idCheck);
                        }


                        tipo == `ENDERECO` ? pontoSelecionado.IdTipoEndereco = 1 : pontoSelecionado.IdTipoEndereco = 2;
                        pontoSelecionado.Tipo = tipo;
                        pontoSelecionado.Ids = ids;
                        break;
                    case 2:
                        var checkboxesMarcados = $("input[name='containerSegundo[]']:checked").toArray();

                        if (checkboxesMarcados.length < 1) {
                            Notificar("ATENCAO!", "Selecione um registro", "warning")
                            return;
                        }

                        ids = [];
                        idTipoElemento = "";

                        for (let check of checkboxesMarcados) {
                            let idCheck = $(check).data("id");
                            tipo = $(check).data("tipo");
                            ids.push(idCheck);
                        }


                        tipo == `ENDERECO` ? pontoSelecionado.IdTipoEndereco = 1 : pontoSelecionado.IdTipoEndereco = 2;
                        pontoSelecionado.Tipo = tipo;
                        pontoSelecionado.Ids = ids;
                        break;
                }
            }

            await $.ajax({
                url: baseUrl + "/api/Area_ManutencaoApi/GravarPontosAfetados",
                method: 'POST',
                dataType: 'json',
                data: pontoSelecionado
            }).done(async (responseData) => {
                if (!responseData.ok) {
                    Notificar("ATENCAO!", responseData.mensagem, "warning")
                    erroConfirm = true;
                    return false;
                }
            });

            if (erroConfirm)
                return false;

            Notificar("Sucesso!", "Pontos Afetados foram gravados com sucesso!", "success")
            $('#iSelecionarPontosManut').modal("hide");
            $("#iLimparSelecao").click();
            await BuscarPontosAfetados();
            return true;
        }

        const handleCidade = function () {
            $("#iCidadePesq").on("select2:select select2:unselecting", function (e) {
                const cidadeSelecionada = e.params.data
                if (cidadeSelecionada) {
                    AddSelect("iBairroPesq", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboBairros",@CONSTANTES.PaginacaoRegistros, null, cidadeSelecionada.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iBairroPesq", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboBairros",@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                }
            })
        }

        const handleUf = function () {
            $("#iUfPesq").on("select2:select select2:unselecting", function (e) {
                const ufSelecionado = e.params.data
                if (ufSelecionado) {
                    AddSelect("iCidadePesq", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidadesDescId",@CONSTANTES.PaginacaoRegistros, null, ufSelecionado.sigla, null, "@RsBase.SELECIONE", false, handleCidade);
                    AddSelect("iBairroPesq", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboBairros",@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iCidadePesq", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidadesDescId",@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, handleCidade);
                    AddSelect("iBairroPesq", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboBairros",@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                }
            })
        }

        $("#iVerCliAfetados").click(function () {
            var codct = "@Html.Raw(Model.CodCt)";
            var projeto = "@Html.Raw(Model.Projeto)";
            var numDoc = "@Html.Raw(Model.Num_Doc)";
            var numObra = "@Html.Raw(Model.Num_OS)";

            var url = '@Url.Action("VerClientesAfetados", "Acompanhamento_Servico")'
                    + '?codct=' + encodeURIComponent(codct)
                    + '&projeto=' + encodeURIComponent(projeto)
                    + '&numDoc=' + encodeURIComponent(numDoc)
                    + '&numObra=' + encodeURIComponent(numObra);

            AddAba(url, 'Acompanhamento_Servico');
        });

        $('#iSelecionarPontosManut').on('hidden.bs.modal', function () {
            passoAtual = 1;
            maximoPassos = 0;
            breadcrumbValores = [];

            $("#iCampoPesquisa").show();
            $(".divUfSelect").hide();
            $(".divCidadeSelect").hide();
            $(".divBairroSelect").hide();
            $(".divBtnEndSelects").hide();
            $(".divBtnPesquisarEnd").hide();
            $("#iBreadcrumb").empty();
            $('#card-containerPrimeiro').empty();
            $('#card-containerSegundo').empty();
            $('#card-containerTerceiro').empty();
            $('#card-containerQuarto').empty();
            $('#card-containerQuinto').empty();
        });

        function montarRequest(tipoPesquisaSelecionado) {
            switch (tipoPesquisaSelecionado) {
                case "0":
                case "1":
                case "5":
                    return {
                        pesquisa: $("#iPesquisarEnd").val(),
                        TipoEndereco: tipoPesquisaSelecionado
                    };
                case "2":
                    return {
                        IdUf: $("#iUfPesq").val(),
                        TipoEndereco: "2"
                    };
                case "3":
                    return {
                        IdUf: $("#iUfPesq").val(),
                        IdCidade: $("#iCidadePesq").val(),
                        TipoEndereco: "3"
                    };
                case "4":
                    return {
                        IdUf: $("#iUfPesq").val(),
                        IdCidade: $("#iCidadePesq").val(),
                        IdBairro: $("#iBairroPesq").val(),
                        DescBairro: $("#iBairroPesq option:selected").text(),
                        TipoEndereco: "4"
                    };
                default:
                    return {};
            }
        }

        async function buscarEndereco(tipoSelecionado, tipoPesquisaSelecionado) {
            let erroBusca = false;
            let response;
            let tipo = "";
            let link = "";

            const request = montarRequest(tipoPesquisaSelecionado);

            if (tipoSelecionado === "3") {
                const elementoContainer = $("input[name='containerSegundo[]']").first();
                tipo = $(elementoContainer).data("tipo");

                link = tipo === "CONDOMINIO"
                    ? '/api/Area_ManutencaoApi/BuscarCondominiosPredios'
                    : '/api/Area_ManutencaoApi/BuscarEnderecoLogradouro';
            }

            if (link) {
                await $.ajax({
                    url: baseUrl + link,
                    method: 'POST',
                    dataType: 'json',
                    data: request
                }).done(async (responseData) => {
                    if (responseData.ok)
                        response = responseData.idObjeto;
                    else {
                        Notificar("@RsBase.ATENCAO_", "Erro ao buscar Endereços/Condomínios", "info");
                        erroBusca = true;
                    }
                });

                if (erroBusca) return;

                await AplicarResultadosFiltrados(response, tipoSelecionado, tipo);
                Notificar("SUCESSO", "Estrutura filtrada com sucesso!", "success");
            }
        }

        $("#btnPesquisarLogradouro").on("click", async () => {
            const tipoSelecionado = $("#iBuscarPontos").val();
            const tipoPesquisaSelecionado = $("input[name='TipoPesquisar']:checked").val();
            await buscarEndereco(tipoSelecionado, tipoPesquisaSelecionado);

        });

        $("#btnPesquisarSelects").on("click", async () => {
            const tipoSelecionado = $("#iBuscarPontos").val();
            const tipoPesquisaSelecionado = $("input[name='TipoPesquisar']:checked").val();
            await buscarEndereco(tipoSelecionado, tipoPesquisaSelecionado);
        });

        $("#iPesquisar").on("keydown", async function (event) {
            if (event.key === "Enter" || event.which == 13) {
                await iPesquisar();
            }
        });

        $("#iPesquisarEnd").on("keydown", async function (event) {
            if (event.key === "Enter" || event.which == 13) {
                const tipoSelecionado = $("#iBuscarPontos").val();
                const tipoPesquisaSelecionado = $("input[name='TipoPesquisar']:checked").val();
                await buscarEndereco(tipoSelecionado, tipoPesquisaSelecionado);
            }
        });

        async function iPesquisar() {
            var response;
            let erroBusca = false;
            let link = "";
            let tipo = "";
            let idpai = "";
            let idavo = "";
            let idbizavo = "";
            let request = {};

            let tipoSelecionado = $("#iBuscarPontos option:selected").val();
            let stringPesquisa = $("#iPesquisar").val();

            if (tipoSelecionado == "1") {
                switch (passoAtual) {
                    case 1:
                        link = '/api/Area_ManutencaoApi/ObterDescricaoPop';
                        request = {
                            pesquisa: stringPesquisa
                        };
                        break;
                    case 3:
                        var elementos = $("input[name='containerTerceiro[]']").toArray();
                        var elementoContainer = elementos[0];
                        idpai = $(elementoContainer).data("idpai");
                        tipo = $(elementoContainer).data("tipo");

                        if (tipo == "RADIUS") {
                            link = '/api/Area_ManutencaoApi/BuscarRadiusPop';
                        }
                        else if (tipo == "CONCENTRADORA") {
                            link = '/api/Area_ManutencaoApi/BuscarConcentradorasPop';
                        }
                        else if (tipo == "OLT") {
                            link = '/api/Area_ManutencaoApi/BuscarOLTSPop';
                        }

                        request = {
                            pesquisa: stringPesquisa,
                            IdPop: idpai,
                        };
                        break;
                    case 4:
                        link = '/api/Area_ManutencaoApi/BuscarSlotsOLT';

                        var elementos = $("input[name='containerQuarto[]']").toArray();
                        var elementoContainer = elementos[0];

                        idpai = $(elementoContainer).data("idpai");
                        idavo = $(elementoContainer).data("idavo");
                        tipo = $(elementoContainer).data("tipo");

                        request = {
                            pesquisa: stringPesquisa,
                            IdPop: idavo,
                            IdOlt: idpai
                        };
                        break;
                    case 5:
                        link = '/api/Area_ManutencaoApi/BuscarPonsSlots';

                        var elementos = $("input[name='containerQuinto[]']").toArray();
                        var elementoContainer = elementos[0];

                        idpai = $(elementoContainer).data("idpai");
                        idavo = $(elementoContainer).data("idavo");
                        idbizavo = $(elementoContainer).data("idbizavo");
                        tipo = $(elementoContainer).data("tipo");

                        request = {
                            pesquisa: stringPesquisa,
                            IdPop: idbizavo,
                            IdOlt: idavo,
                            IdSlot: idpai,
                        };
                        break;
                }
            }
            else if (tipoSelecionado == "2") {
                switch (passoAtual) {
                    case 1:
                        link = '/api/Area_ManutencaoApi/ObterDescricaoElementoRede';
                        request = {
                            pesquisa: stringPesquisa
                        };
                        break;
                    case 2:
                        link = '/api/Area_ManutencaoApi/BuscarElementosTipo';

                        var elementos = $("input[name='containerSegundo[]']").toArray();
                        var elementoContainer = elementos[0];

                        idpai = $(elementoContainer).data("idpai");
                        tipo = $(elementoContainer).data("tipo");

                        request = {
                            pesquisa: stringPesquisa,
                            IdTipoElemento: idpai,
                        };
                        break;
                    case 3:
                        link = '/api/Area_ManutencaoApi/BuscarPortasElementoRede';

                        var elementos = $("input[name='containerTerceiro[]']").toArray();
                        var elementoContainer = elementos[0];

                        idpai = $(elementoContainer).data("idpai");
                        idavo = $(elementoContainer).data("idavo");
                        tipo = $(elementoContainer).data("tipo");

                        request = {
                            pesquisa: stringPesquisa,
                            IdElemento: idpai,
                        };
                        break;
                }
            }
            else if (tipoSelecionado == "3") {
                switch (passoAtual) {
                    case 2:
                        var elementos = $("input[name='containerSegundo[]']").toArray();
                        var elementoContainer = elementos[0];

                        tipo = $(elementoContainer).data("tipo");

                        if (tipo == "CONDOMINIO")
                            link = '/api/Area_ManutencaoApi/BuscarCondominiosPredios';
                        else
                            link = '/api/Area_ManutencaoApi/BuscarEnderecoLogradouro'

                        request = {
                            pesquisa: stringPesquisa,
                        };
                        break;
                }
            }

            if (link != null && link != "") {
                await $.ajax({
                    url: baseUrl + link,
                    method: 'POST',
                    dataType: 'json',
                    data: request
                }).done(async (responseData) => {
                    if (responseData.ok)
                        response = responseData.idObjeto;
                    else {
                        Notificar("@RsBase.ATENCAO_", "Erro ao buscar Condominios", "info");
                        erroBusca = true;
                    }
                });

                if (erroBusca)
                    return false;

                await AplicarResultadosFiltrados(response, tipoSelecionado, tipo);

                Notificar("SUCESSO", "Estrutura filtrada com sucesso!", "success");
            }
        }

        async function AplicarResultadosFiltrados(response, tipoSelecionado, tipoRequest){

             if (tipoSelecionado == "1") {
                switch (passoAtual) {
                    case 1:
                        await AplicarPopEncontrado(response);
                        break;
                    case 3:
                        if (tipoRequest == "RADIUS") {
                            await AplicarRadiusEncontrados(response);
                        }
                        else if (tipoRequest == "CONCENTRADORA") {
                            await AplicarConcentradorasEncontradas(response);
                        }
                        else if (tipoRequest == "OLT") {
                            await AplicarOLTSEncontradas(response);
                        }
                        break;
                    case 4:
                        await AplicarSlotsEncontradas(response);
                        break;
                    case 5:
                        await AplicarPonsEncontrados(response);
                        break;
                }
            }
            else if (tipoSelecionado == "2") {
                switch (passoAtual) {
                    case 1:
                        AplicarTiposElementosRedeEncontrados(response);
                        break;
                    case 2:
                        await AplicarElementosEncontrados(response);
                        break;
                    case 3:
                        await AplicarPortasEncontradas(response);
                        break;
                }
             }
             else if (tipoSelecionado == "3") {
                switch (passoAtual) {
                    case 2:
                        AplicarEnderecosEncontrados(response, tipoRequest == "CONDOMINIO" ? `2` : `1`);
                        break;
                }
             }
        }

///SCRIPTS MANUT
    </script>
}

