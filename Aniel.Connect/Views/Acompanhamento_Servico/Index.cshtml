        function AtualizarInterfaceTipoPesquisar(tipoSelecionado) {
            var tipoSelecionado = $("input[name='TipoPesquisar']:checked").val();
            if (tipoSelecionado == 0) {
                $(".divUfSelect").hide();
                $(".divCidadeSelect").hide();
                $(".divBairroSelect").hide();
                $(".divBtnEndSelects").hide();
                $("#iLabelPesquisar").empty();
                $(".divBtnEnd").show();
                $("#iLabelPesquisar").show();
                $("#iLabelPesquisar").append(`<b>CEP:</b>`);
                $("#btnPesquisarSelects").hide();
            }

            if (tipoSelecionado == 1) {
                $(".divUfSelect").hide();
                $(".divCidadeSelect").hide();
                $(".divBairroSelect").hide();
                $(".divBtnEndSelects").hide();
                $(".divBtnEnd").show();
                $("#iLabelPesquisar").empty();
                $("#iLabelPesquisar").show();
                $("#iLabelPesquisar").append(`<b>Nome do Condomínio:</b>`);
                $("#btnPesquisarSelects").hide();
            }

            if (tipoSelecionado == 2) {
                $("#iLabelPesquisar").hide();
                $(".divCidadeSelect").hide();
                $(".divBairroSelect").hide();
                $(".divBtnEnd").hide();
                $(".divUfSelect").show();
                $(".divBtnEndSelects").show();
                $("#btnPesquisarSelects").show();
            }
            if (tipoSelecionado == 3) {
                $("#iLabelPesquisar").hide();
                $(".divBairroSelect").hide();
                $(".divBtnEnd").hide();
                $(".divUfSelect").show();
                $(".divCidadeSelect").show();
                $(".divBtnEndSelects").show();
                $("#btnPesquisarSelects").show();
            }
            if (tipoSelecionado == 4) {
                $("#iLabelPesquisar").hide();
                $(".divUfSelect").show();
                $(".divBtnEnd").hide();
                $(".divCidadeSelect").show();
                $(".divBairroSelect").show();
                $(".divBtnEndSelects").show();
                $("#btnPesquisarSelects").show();
            }
            if (tipoSelecionado == 5) {
                $(".divUfSelect").hide();
                $(".divCidadeSelect").hide();
                $(".divBairroSelect").hide();
                $(".divBtnEnd").show();
                $("#iLabelPesquisar").empty();
                $("#iLabelPesquisar").show();
                $("#iLabelPesquisar").append(`<b>Logradouro:</b>`);
                $(".divBtnEndSelects").hide();
                $("#btnPesquisarSelects").hide();
            }
        }

