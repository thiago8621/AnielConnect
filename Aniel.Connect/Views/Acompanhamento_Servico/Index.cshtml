                    $(".carousel-control-prev-icon").click();
                }
            });
            $('#modalFoto').attr("data-idFoto", id);
            $('#modalFoto').attr("data-idItem", idItem);

        };

        function ParalisarAtendimento(justificativa) {
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Painel_ServicosApi/ParalisarAtendimento")';
            const num_obra = "@Html.Raw(Model.Num_OS)"
            const numdoc = "@Html.Raw(Model.Num_Doc)"
            const projeto = "@Html.Raw(Model.Projeto)"
            const codct = "@Html.Raw(Model.CodCt)"
            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    ids: codct + "|" + projeto + "|" + num_obra + "|" + numdoc,
                    justificativa: justificativa
                }
