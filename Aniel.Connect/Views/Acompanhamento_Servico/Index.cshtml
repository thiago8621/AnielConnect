            $('#prevStep').prop('disabled', desabilitarVoltar);

            // Garante que o botão e o texto estejam sempre visíveis
            $('#prevStep').show();
            $('.iCampoVoltar').show();
        }

        async function ProximoPasso() {
            if (passoAtual < maximoPassos) {
