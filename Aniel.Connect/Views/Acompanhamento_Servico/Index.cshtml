<div class="modal fade" id="iModalPontosManut" role="dialog" aria-labelledby="iModalPontosManutLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document" style="max-width: 75vw;">
        <div class="modal-content" style="height: 90vh; display: flex; flex-direction: column;">
            <!-- Header -->
            <div class="modal-header">
                <h4 class="modal-title"><b>@dataHoraPrevisto</b></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <!-- Body com scroll e flex -->
            <div class="modal-body" style="flex: 1; overflow-y: auto; padding: 1rem;">
                <div class="container-fluid">
                    <div class="row align-items-end">
                        @if (!statusConcluido)
                        {
                            <div class="col-12 col-md-4 col-lg-3 mb-3">
                                <label for="iBuscarPontos" class="font-weight-bold" style="font-size:16px;">
                                    Buscar Pontos Afetados:
                                </label>
                                <select class="form-control" id="iBuscarPontos">
                                    <option value="1">POP</option>
                                    <option value="2">Elemento de Rede</option>
                                    <option value="3">Endereço</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-4 col-lg-3 mb-3">
                                @if (AcessoHelper.TemAcesso(_areas, "413"))
                                {
                                    <button type="button" id="iAdcPontosAfetados" class="btn btn-success btn-block mt-md-4">
                                        Adicionar Pontos Afetados
                                    </button>
                                }
                            </div>
                        }

                        <div class="col-6 col-md-3 mb-3">
                            <div class="d-flex align-items-center">
                                <label class="font-weight-bold mb-0" style="font-size:16px; white-space: nowrap;">
                                    Qtd. Pontos:
                                </label>
                                <p id="iQtdPontosAfetados" class="mb-0 ml-2" style="font-size:16px;">0</p>
                            </div>
                        </div>

                        <div class="col-6 col-md-3 mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <label class="font-weight-bold mb-0" style="font-size:16px; white-space: nowrap;">
                                    Qtd. Clientes:
                                </label>
                                <p id="iQtdCliAfetados" class="mb-0 ml-2" style="font-size:16px;">0</p>
                            </div>
                            <button type="button" id="iVerCliAfetados" class="btn btn-primary btn-block">
                                Ver Clientes
                            </button>
                        </div>
                    </div>

                    <hr class="my-3">

                    <div class="row">
                        <div class="col-12">
                            <h4 class="font-weight-bold">Pontos Afetados:</h4>
                            <div id="jstree" style="min-height: 300px; max-height: 60vh; overflow: auto; border: 1px solid #ddd; padding: 10px; border-radius: 4px;">
                                <!-- JSTree será carregado aqui -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="iSelecionarPontosManut" tabindex="-1" role="dialog"
     aria-labelledby="iSelecionarPontosManutLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document" style="max-width: 75vw;">
        <div class="modal-content" style="height: 90vh; display: flex; flex-direction: column;">

            <!-- HEADER -->
            <div class="modal-header">
                <h4 class="modal-title"><b>Selecione a Estrutura</b></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <!-- BODY COM SCROLL -->
            <div class="modal-body p-3" style="flex: 1; overflow-y: auto;">
                <div class="container-fluid">

                    <!-- LINHA 1: Voltar + Breadcrumb + Pesquisa -->
                    <div class="row align-items-center mb-2">
                        <div class="col-12 col-md-2 col-lg-1 mb-2 mb-md-0">
                            <button id="prevStep" class="btn btn-outline-secondary btn-sm w-100 d-flex align-items-center justify-content-center"
                                    onclick="PassoAnterior();">
                                <i class="fas fa-arrow-left mr-1"></i>
                                <span class="d-none d-sm-inline iCampoVoltar">Voltar</span>
                            </button>
                        </div>
                        <div class="col-12 col-md-6 col-lg-7 mb-2 mb-md-0">
                            <div id="iBreadcrumb" class="form-control readonly border-0 bg-transparent p-0"
                                 style="height: 38px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            </div>
                        </div>
                        <div id="iDivPesquisar" class="col-12 col-md-4 col-lg-4">
                            <div class="input-group">
                                <input type="text" id="iPesquisar" placeholder="Filtre por Descrição/Nome"
                                       class="form-control form-control-sm" />
                                <div class="input-group-append" onclick="iPesquisar();">
                                    <span class="input-group-text bg-white border-left-0">
                                        <i class="fa-solid fa-magnifying-glass"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- LINHA 2: Filtros por tipo (radio buttons) -->
                    <div class="row mb-2 divBtnPesquisarEnd">
                        <div class="col-12">
                            <div class="d-flex flex-wrap gap-3 align-items-center">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="TipoPesquisar" value="0" />
                                    <label class="form-check-label font-weight-bold"><b>CEP</b></label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="TipoPesquisar" value="1" />
                                    <label class="form-check-label font-weight-bold"><b>Nome do Condomínio</b></label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="TipoPesquisar" value="2" />
                                    <label class="form-check-label font-weight-bold"><b>UF</b></label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="TipoPesquisar" value="3" />
                                    <label class="form-check-label font-weight-bold"><b>Cidade</b></label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="TipoPesquisar" value="4" />
                                    <label class="form-check-label font-weight-bold"><b>Bairro</b></label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="TipoPesquisar" value="5" />
                                    <label class="form-check-label font-weight-bold"><b>Logradouro</b></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- LINHA 3: Campo de pesquisa por endereço -->
                    <div class="row mb-2 divBtnEnd">
                        <div class="col-12 col-lg-8">
                            <div class="d-flex align-items-center">
                                <label id="iLabelPesquisar" class="mr-2 mb-0 font-weight-bold" style="font-size: 13px; white-space: nowrap;"></label>
                                <div class="flex-grow-1 d-flex">
                                    <input type="text" id="iPesquisarEnd" class="form-control form-control-sm mr-2" />
                                    <button id="btnPesquisarLogradouro" type="button"
                                            class="btn btn-success btn-sm iButtonPesquisarEnd">
                                        Pesquisar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- LINHA 4: Selects de UF, Cidade, Bairro -->
                    <div class="row mb-3">
                        <div class="col-6 col-md-4 col-lg-3 divUfSelect">
                            <label class="font-weight-bold"><b>UF:</b></label>
                            <select id="iUfPesq" class="form-control form-control-sm"></select>
                        </div>
                        <div class="col-6 col-md-4 col-lg-3 divCidadeSelect">
                            <label class="font-weight-bold"><b>Cidade:</b></label>
                            <select id="iCidadePesq" class="form-control form-control-sm"></select>
                        </div>
                        <div class="col-6 col-md-4 col-lg-3 divBairroSelect">
                            <label class="font-weight-bold"><b>Bairro:</b></label>
                            <select id="iBairroPesq" class="form-control form-control-sm"></select>
                        </div>
                        <div class="col-6 col-md-4 col-lg-3 divBtnEndSelects d-flex align-items-end">
                            <button id="btnPesquisarSelects" type="button"
                                    class="btn btn-success btn-sm iButtonPesquisarEnd w-100">
                                Pesquisar
                            </button>
                        </div>
                    </div>

                    <!-- LINHA 5: Botões de Seleção -->
                    <div class="row mb-3">
                        <div class="col-12 col-md-5 divBtnSelecionar">
                            <div class="d-flex gap-2">
                                <button class="form-control flex-fill" id="iSelecionarManual">Selecionar</button>
                                <button class="form-control flex-fill ml-2" id="iSelecionarTodos">Selecionar Todos</button>
                            </div>
                        </div>
                        <div class="col-12 col-md-2"></div>
                        <div class="col-12 col-md-5 divBtnSelecionar">
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-danger d-none flex-fill" id="iLimparSelecao">
                                    <i class="fa-solid fa-circle-xmark"></i> Limpar
                                </button>
                                <button class="btn btn-success flex-fill ml-2" id="iConfirmarSelecao" onclick="ConfirmarSelecao();">
                                    Confirmar Seleção
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- MENSAGEM DE ERRO -->
                    <div class="row mb-3" id="divErros" style="display: none;">
                        <div class="col-12 text-center">
                            <p class="text-danger font-weight-bold" style="font-size: 18px;">
                                Não possui dados!
                            </p>
                        </div>
                    </div>

                    <!-- STEPS DINÂMICOS -->
                    <div class="step active" id="step1">
                        <div class="row" id="card-containerPrimeiro"></div>
                    </div>
                    <div class="step" id="step2">
                        <div class="row" id="card-containerSegundo"></div>
                    </div>
                    <div class="step" id="step3">
                        <div class="row" id="card-containerTerceiro"></div>
                    </div>
                    <div class="step" id="step4">
                        <div class="row" id="card-containerQuarto"></div>
                    </div>
                    <div class="step" id="step5">
                        <div class="row" id="card-containerQuinto"></div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
