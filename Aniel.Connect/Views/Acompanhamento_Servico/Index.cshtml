        function baixar(dados,baixaOsDuplicada) {
            const [num_obra, numdoc, projeto, codct] = ["@Html.Raw(Model.Num_OS)", "@Html.Raw(Model.Num_Doc)", "@Html.Raw(Model.Projeto)", "@Html.Raw(Model.CodCt)"];
            const link = '@String.Concat(CONSTANTES.URLPortal, "/api/Documento_ProducaoApi/BaixarOS")';
            $.ajax({
                url: link,
                type: 'POST',
                data: {
                    num_Obra: num_obra,
                    equipe: dados.responsavel,// $('#iResponsavel').val(),
                    caixaFTTH: dados.caixaFTTH,//$('#iCaixaFTTH').val(),
                    portaFTTH: dados.portaFTTH, //$('#iPortaFTTH').val(),
                    data_Ini_Atend: dados.data_Ini_Atend,//$('#iDataIniAtend').val(),
                    data_Fim_Atend: dados.data_Fim_Atend, //$('#iDataFimAtend').val(),
                    hora_Ini_Atend: dados.hora_Ini_Atend, //$('#iHoraIniAtend').val(),
                    hora_Fim_Atend: dados.hora_Fim_Atend, //$('#iHoraFimAtend').val(),
                    projeto: projeto,
                    num_Doc: numdoc,
                    codCt: codct,
                    observacao: dados.observacao,
                    baixaOsProdDuplicada: baixaOsDuplicada,
                    codigo_Encerramento: dados.codigo_Encerramento // $('#iEncerramento').val()
                },
                dataType: 'json',
                beforeSend: function () {
                    ShowPageLoading();
                },
                complete: function () {
                    HidePageLoading();
                }
            }).done(function (data) {
                if (data.ok) {
                    document.location.reload(true);
                }
                else if (data.mensagem == "Este serviço já foi baixado como produtivo anteriormente. Deseja realmente prosseguir com esta nova baixa?") {

                    Swal.fire({
                        title: '@RsBase.ATENCAO_',
                        text: data.mensagem,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: '@RsBase.SIM',
                        cancelButtonText: '@RsBase.NAO',
                    }).then((result) => {
                        if (result.value) {
                            baixar(dados,"S");
                        }
                    });

                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });
        }

