@model Aniel.Connect.Models.Historico_ServicoCadastroModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.T5.Model.enumerado

@{
    ViewBag.Title = RsCadastros.HISTORICO_SERVICO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts{

    <!--Usando link para imprimir a página atual-->
    @*<script>
            $('.printMe').click(function () {
                window.print();
            });
        </script>*@
}

@section styles
{
    <link href="~/Content/timeline.css" rel="stylesheet" />
    <style>
        .dash-card {
            min-width: 265px !important;
        }

        .card-title {
            font-size: x-large;
        }
    </style>
}
@using (Html.BeginForm("Historico_Servico", "Acompanhamento_Servico", FormMethod.Post, htmlAttributes: new { @id = "form", @autocomplete = "off" }))
{

    @Html.HiddenFor(p => p.CodCt)
    @Html.HiddenFor(p => p.Projeto)
    @Html.HiddenFor(p => p.Num_Obra)
    @Html.HiddenFor(p => p.Numero_Doc)

    <div class="container-fluid">
        <div class="row">
            <!--Timeline-->
            <div class="col">


                @{

                    List<String> lista_branca = new List<string>();
                    List<String> lista_cinza = new List<string>();
                    List<String> lista_azul_escuro = new List<string>();
                    List<String> lista_azul_claro = new List<string>();
                    List<String> lista_amarelo = new List<string>();
                    List<String> lista_verde = new List<string>();
                    List<String> lista_laranja = new List<string>();
                    lista_branca.Add(RsCadastros.ABERTA_AGUARD_AGENDAMENTO);
                    lista_branca.Add(RsCadastros.ABERTA_AGUARD_RESPONSAVEL);
                    lista_cinza.Add(RsCadastros.ABERTA_AGUARD_ATENDIMENTO);
                    lista_azul_escuro.Add(RsCadastros.ATENDIMENTO_INICIADO_REINICIADO);
                    lista_azul_escuro.Add(RsCadastros.REINICIADO_ATENDIMENTO);
                    lista_azul_claro.Add(RsCadastros.OS_EM_DESLOCAMENTO);
                    lista_amarelo.Add(RsCadastros.ATENDIMENTO_PARALIZADO);
                    lista_azul_claro.Add(RsCadastros.INTERROMPER_DESLOCAMENTO);
                    lista_verde.Add(RsCadastros.FECHADA_PRODUTIVA);
                    lista_laranja.Add(RsCadastros.FECHADA_IMPRODUTIVA);

                }

                @foreach (var item in Model.Historico_Servico)
                {
                    <!-- Vertical Timeline -->
                    <section id="conference-timeline">
                        @*<div class="timeline-start">Início</div>*@
                        <div class="conference-center-line" style="top:0;height: 100vh !important;">
                            <div class="meta-date" style="margin-left:-27px;margin-top: 40px;">


                                @{
                                    var html_class = String.Empty;
                                    if (item.Status_OS == RsCadastros.ATENDIMENTO_FINALIZADO)
                                    {
                                        if (item.Status_Documento == StatusExecucaoAniel.Fechada_Produtiva)
                                        {
                                            lista_verde.Add(RsCadastros.ATENDIMENTO_FINALIZADO);
                                        }
                                        else if (item.Status_Documento == StatusExecucaoAniel.Fechada_Improdutiva)
                                        {
                                            lista_laranja.Add(RsCadastros.ATENDIMENTO_FINALIZADO);
                                        }
                                    }

                                    if (lista_branca.Contains(item.Status_OS))
                                    {
                                        html_class = "historico-white";
                                    }

                                    else if (lista_cinza.Contains(item.Status_OS))
                                    {
                                        html_class = "text-secondary";
                                    }

                                    else if (lista_azul_escuro.Contains(item.Status_OS))
                                    {
                                        html_class = "text-primary";
                                    }

                                    else if (lista_azul_claro.Contains(item.Status_OS))
                                    {
                                        html_class = "text-info";
                                    }

                                    else if (lista_amarelo.Contains(item.Status_OS))
                                    {
                                        html_class = "text-warning";
                                    }

                                    else if (lista_verde.Contains(item.Status_OS))
                                    {
                                        html_class = "text-success";
                                    }
                                    else if (lista_laranja.Contains(item.Status_OS))
                                    {
                                        html_class = "historico-orange";
                                    }

                                }

                                <span class="date"><i class="far fa-dot-circle @html_class iTimeLine" style="font-size: 350%;background: #fff;"></i></span>
                            </div>
                        </div>
                        <div class="conference-timeline-content">
                            <div class="timeline-article" style="margin-bottom: 20px;margin-top: 0;">
                                @*<div class="content-left-container">
                                        <div class="content-left pr-0">
                                            <p class="text-right"><b>@item.DataHora </b></p>
                                            <p class="text-right"><b>@RsCadastros.USUARIO: </b><span id="iUsuario" class="text-muted">@item.Usuario</span></p>
                                        </div>
                                    </div>*@
                                <div class="content-right-container">
                                    <div class="content-right">
                                        <p class="text-center"><strong>@item.Status_OS</strong></p>
                                        <p class="text-center"><b>@item.DataHora </b></p>
                                        <p class="text-center"><b>@RsCadastros.USUARIO: </b><span class="text-muted">@item.Usuario</span></p>

                                        @if(item.Status_OS != RsCadastros.ABERTA_AGUARD_AGENDAMENTO && item.Status_OS != RsCadastros.ABERTA_AGUARD_RESPONSAVEL && item.Status_OS != RsCadastros.ABERTA_AGUARD_ATENDIMENTO) { 
                                        if (!String.IsNullOrEmpty(item.Latitude) && !String.IsNullOrEmpty(item.Longitude))
                                        {
                                            <p class="text-center"><b>@RsCadastros.LATITUDE: </b><span class="text-muted">@item.Latitude</span> | <b>@RsCadastros.LONGITUDE: </b><span class="text-muted">@item.Latitude</span></p>
                                            }
                                            else
                                            {
                                            <p class="text-center"><b>Sem Localização</b></p>
                                            }
                                        }
                                    </div>
                                </div>
                                @*<div class="meta-date">


                                        @{
                                            var html_class = String.Empty;
                                            if (item.Status_OS == RsCadastros.ATENDIMENTO_FINALIZADO)
                                            {
                                                if (item.Status_Documento == StatusExecucaoAniel.Fechada_Produtiva)
                                                {
                                                    lista_verde.Add(RsCadastros.ATENDIMENTO_FINALIZADO);
                                                }
                                                else if (item.Status_Documento == StatusExecucaoAniel.Fechada_Improdutiva)
                                                {
                                                    lista_laranja.Add(RsCadastros.ATENDIMENTO_FINALIZADO);
                                                }
                                            }

                                            if (lista_branca.Contains(item.Status_OS))
                                            {
                                                html_class = "historico-white";
                                            }

                                            else if (lista_cinza.Contains(item.Status_OS))
                                            {
                                                html_class = "text-secondary";
                                            }

                                            else if (lista_azul_escuro.Contains(item.Status_OS))
                                            {
                                                html_class = "text-primary";
                                            }

                                            else if (lista_azul_claro.Contains(item.Status_OS))
                                            {
                                                html_class = "text-info";
                                            }

                                            else if (lista_amarelo.Contains(item.Status_OS))
                                            {
                                                html_class = "text-warning";
                                            }

                                            else if (lista_verde.Contains(item.Status_OS))
                                            {
                                                html_class = "text-success";
                                            }
                                            else if (lista_laranja.Contains(item.Status_OS))
                                            {
                                                html_class = "historico-orange";
                                            }

                                        }

                                        <span class="date"><i class="far fa-dot-circle @html_class iTimeLine"></i></span>
                                    </div>*@
                            </div>
                        </div>
                    </section>
                    <!-- // Vertical Timeline -->
                }


            </div>
            <!--cards xl = 100% lg = 110%  md= -->
            <div class="col">

                <div class="card-deck">
                    <div class="card shadow dash-card">
                        <div class="card-body">
                            <div class="row">
                                <div class="text-left card-title col">
                                    <span>@(Model.TempoRealDeslocamento)h</span>
                                </div>
                                <div class="text-right card-title col">
                                    <i class="far fa-clock"></i>
                                </div>
                            </div>
                            <div class="text-center dash-title">@RsCadastros.TEMPO_REAL_DESLOCAMENTO</div>
                        </div>
                    </div>



                    <div class="card shadow dash-card">
                        <div class="card-body">
                            <div class="row">
                                <div class="text-left card-title col">
                                    <span>@(Model.TempoAtendimento)h</span>
                                </div>
                                <div class="text-right card-title col">
                                    <i class="far fa-clock"></i>
                                </div>
                            </div>
                            <div class="text-center dash-title">@RsCadastros.TEMPO_ATENDIMENTO</div>
                        </div>
                    </div>

                    <div class="card shadow dash-card">
                        <div class="card-body">
                            <div class="row">
                                <div class="text-left card-title col">
                                    <span>@(Model.TempoTotalParalisacoes)h</span>
                                </div>
                                <div class="text-right card-title col">
                                    <i class="far fa-clock"></i>
                                </div>
                            </div>
                            <div class="text-center dash-title">@RsCadastros.TEMPO_TOTAL_PARALISACOES</div>
                        </div>
                    </div>

                    <div class="card shadow dash-card">
                        <div class="card-body">
                            <div class="row">
                                <div class="text-left card-title col">
                                    <span>@(Model.TempoTotalAtendimento)h</span>
                                </div>
                                <div class="text-right card-title col">
                                    <i class="far fa-clock"></i>
                                </div>
                            </div>
                            <div class="text-center dash-title">@RsCadastros.TEMPO_TOTAL_ATENDIMENTO</div>
                        </div>
                    </div>

                    <div class="card shadow dash-card">
                        <div class="card-body">
                            <div class="row">
                                <div class="text-left card-title col-9">
                                    <span>R$ @(Model.CustoTotalServico)</span>
                                </div>
                                <div class="text-right card-title col">
                                    <i class="fas fa-dollar-sign"></i>
                                </div>
                            </div>
                            <div class="text-center dash-title">@RsCadastros.CUSTO_TOTAL_SERVICO</div>
                        </div>
                    </div>


                </div>
            </div>


        </div>
    </div>
}
