@model Aniel.Connect.Repository.Model.EquipeAuxiliaresModel
@using Resources
@using Aniel.Connect.Core;
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    List<AreaModuloModel> _areas = ViewBag.Areas;
    ViewBag.Title = RsCadastros.LISTAGEM_ATENDIMENTO;
    ViewBag.Sessao = RsCadastros.ATENDIMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")

}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

<script>

        var oDatatable = null;
        var rows_selected = [];
        function excluirArquivo(equipe,nome) {

            $.ajax({
                url: '@String.Concat(CONSTANTES.URLPortal, "/api/Equipes_AuxilaresApi/ExcluirArquivo")',
                type: 'POST',
                dataType: 'json',
                data: {
                    Nome:nome,
                    equipe: equipe,
                    CodCt: "@Html.Raw(Model.CodCt)",
                    Projeto: "@Html.Raw(Model.Projeto)",
                    Num_Obra: "@Html.Raw(Model.Num_Obra)",
                    Num_Doc: "@Html.Raw(Model.Num_Doc)",
                },
            })
                .done(function (data) {
                    if (data.ok) {
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                        ShowPageLoading();
                        window.location.reload();
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                });
        }

        var handleDataTableButtons = function () {
            "use strict";


            //"Blfrtip"
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        //render: function (data, type, full, meta) {
                        //    return "<input type='checkbox'></input>";
                        //}
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: false,
                deferRender: true,
                scrollY: '73vh',
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/Equipes_AuxilaresApi/GetEquipes_AuxiliaresDataTable',
                    type: 'POST',
                    data: function (data) {

                        data.CodCt = "@Html.Raw(Request.Params["CodCt"])";
                        data.Projeto = "@Html.Raw(Request.Params["Projeto"])";
                        data.Num_Obra = "@Html.Raw(Model.Num_Obra)";
                        data.Num_Doc = "@Html.Raw(Model.Num_Doc)";

                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    { data: "equipe", title: "@RsCadastros.MATRICULA", orderable: false },
                    { data: "nome", title: "@RsCadastros.NOME", orderable: false },
                    {
                        render: function (data, type, row, meta) {

                            let btnexc = `<a onclick = "excluirArquivo('${row.equipe}','${row.nome}')"><i class='fas fa-trash'></i></a>`
                            @if (AcessoHelper.TemAcesso(_areas, "366"))
                            {
                                <text>
                                return btnexc;
                                </text>
                            }
                            else
                            {
                                <text>
                                return "";
                                </text>
                            }



                        }
                    }

                ],
            });


            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                //updateDataTableSelectAllCtrl(oDatatable);
            });




        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();
        $(document).ready(async function () {


            @if (AcessoHelper.TemAcesso(_areas, "366"))
            {
                <text>
                await AddSelect('iMatricula_Id', '@CONSTANTES.URLPortal/api/EquipeApi/GetComboNumFre', @CONSTANTES.PaginacaoRegistros, null, null, null, '@RsBase.SELECIONE', true);
                EnableSelect('iMatricula_Id')
                </text>
            }

        });

        function InsereEquipe () {

            var equipes = $("#iMatricula_Id option:selected").val();
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Equipes_AuxilaresApi/InserirRegistro")';

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsCadastros.SELECIONAR_EQUIPE_AUXILIAR", "warning");
                return false;
            }
         $.ajax({
             url: link,
             type: 'POST',
             dataType: 'json',
             data: {
                 Nome: $("#iMatricula_Id option:selected").text(),
                equipe: equipes,
                CodCt: "@Html.Raw(Model.CodCt)",
                Projeto: "@Html.Raw(Model.Projeto)",
                Num_Obra: "@Html.Raw(Model.Num_Obra)",
                Num_Doc: "@Html.Raw(Model.Num_Doc)",
            },
         })
             .done(function (data) {

                 if (data.ok) {
                     Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                     ShowPageLoading();
                     window.location.reload();

                 }
                 else {
                     Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                 }
             });


        }
   $("#iMatricula_Id").on("change", function (){})
</script>
}

@Html.HiddenFor(model => model.CodCt, new { @id = "iCodCt" })
@Html.HiddenFor(model => model.Projeto, new { @id = "iProjeto" })
@Html.HiddenFor(model => model.Num_Obra, new { @id = "iNum_Obra" })

<div style="padding:10px;">
    @if (AcessoHelper.TemAcesso(_areas, "366"))
    {
        <div class="card" style="box-shadow: 0 8px 17px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.1); border: none;">
            <div class="card-body" style="padding-top: 0">
                <div class="row mt-2">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="iMatricula_Id">@RsCadastros.SELECIONAR_EQUIPE_AUXILIAR</label>
                            @Html.DropDownListFor(model => model.Equipe, new SelectList(new List<ObjBusca<Int64?>>()), RsBase.SELECIONE, new { @id = "iMatricula_Id", @class = "form-control obrigatorio", @style = "width: 100%" })
                        </div>
                    </div>
                    <div class="col-md-4">


                        <a id="btnAltera" style="color:#fff; margin-top:8px" onclick="InsereEquipe()" class="btn btn-success">Adicionar</a>

                    </div>
                </div>
            </div>
        </div>
    }
</div>
<div style="padding:10px;">
    <div class="card" style="box-shadow: 0 8px 17px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.1); border:none;">
        <div class="card-body" style="padding-top: 0">
            <table class="table table-hover nowrap" id="datatable" style="width:100%">
            </table>
        </div>
    </div>
</div>

