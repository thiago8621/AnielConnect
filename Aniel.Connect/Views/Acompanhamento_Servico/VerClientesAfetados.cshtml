@model  Aniel.Connect.Models.PontosAfetados.GetClientesByOSManutencaoRequest
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = RsCadastros.CLIENTES_AFETADOS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

}

@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />
    <meta charset="utf-8" />
    <style>
        .popover {
            max-width: 45%; /* Max Width of the popover (depending on the container!) */
        }

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <script>

        let oDatatable;

     var handleDataTableButtons = function () {

     "use strict";
     ShowPageLoading();

     //"Blfrtip"
     oDatatable = new DataTable("#datatable", {
         dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
         searching: true,
         ordering: false,
         serverSide: true,
         deferRender: true,
         language: traducaoDataTableSimples,
         scrollX: true,
         //scrollCollapse: true,
         scrollY: '79vh',
         paging: true,
         /*stateSave: true,*/
         initComplete: dataTableInitComplete,
         lengthMenu: [[10, 25, 50, 100, 250, 750, 1000], [10, 25, 50, 100, 250, 750, 1000]],
         pageLength: 10,
         ajax: {
             url: '@String.Concat(CONSTANTES.URLPortal, "/api/PontosAfetadosManutencaoApi/GetClientesByOSManutencao")',
             type: 'POST',
             data: function (data) {
                 // Read values
                 data.codct = '@Html.Raw(Model.Codct)';
                 data.projeto = '@Html.Raw(Model.Projeto)';
                 data.numObra = '@Html.Raw(Model.NumObra)';
                 data.numDoc = '@Html.Raw(Model.NumDoc)';
                 data.search.option = $("#optionSearch").val();
             },
             error: function (e) {
                 console.log(e);
                 Notificar("@RsBase.ATENCAO_", e.responseJSON.exceptionMessage || "@RsBase.ERROAORECUPERARLISTAGEMDOSERVIDOR", "warning");
                 HidePageLoading();
             },
             dataSrc: function (d) {
                 HidePageLoading();
                 return d.data;
             }
         },
         columns: [
             { data: "cpfcnpj", title: "CPF/CNPJ" },
             { data: "nome", title: "Nome Fantasia" },
             { data: "plano", title: "Plano/Produto" },
             { data: "login_Radius", title: "Login" },
             { data: "endereco", title: "Endereço de Instalação" },
             { data: "ponto_Afetado", title: "Afetado Por" },
         ]
     });


         $('#txtSearch').val(oDatatable.search());
         $('#txtSearch').keyup(function () {
             oDatatable.search($(this).val()).draw();
         });

 },
     TableManageButtons = function () {
         "use strict";
         return {
             init: function () {
                 handleDataTableButtons();
             }
         }
     }();

    TableManageButtons.init();
    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->
    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page"><i class="fa-solid fa-person-circle-exclamation"></i> @ViewBag.Title</h4>
        </div>
        <div class="col-auto">
            <div class="row title-page">
                <div class="form-inline pl-4 pr-2">
                    <select class="form-control" id="optionSearch">
                        <option value="cpfcnpj">@RsCadastros.CPFCNPJ</option>
                    </select>
                    <input type="text" class="input-search" id="txtSearch" placeholder="Digite aqui para busca rápida" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;">@RsBase.EXPORTARPDF</a>
                </div>
            </div>
        </div>
    </div>
    <div id="divTable" class="ml-3 mr-3">
        <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
    </div>
</div>
