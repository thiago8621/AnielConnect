@model  Aniel.Connect.Models.Historico_NfViewModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@{
    ViewBag.Title = RsCadastros.HISTORICO_NF;
    ViewBag.Sessao = RsCadastros.HISTORICO_NF;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion,"~/Content/cssDataTable")
}

@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion,"~/bundles/jsDataTable")
    <script>
        var rows_selected = [];

        function AbrirArquivo(caminho) {
            window.open(caminho, "_blank");
        }


        var handleDataTableButtons = function () {
            "use strict";

            //"Blfrtip"

            //if ($("#datatable").length != null && $("#datatable").length < 1) {
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '73vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + "/api/Historico_NfApi/GetAll",
                    type: 'POST',
                    data: function (data) {
                        data.Id_Cliente = @Request.Params["Id_Cliente"];
                        data.Data_Ini = $("#iDataInicial").val();
                        data.Data_Fim = $("#iDataFinal").val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "codigo", title: "@RsCadastros.CODIGO_NOTA_FISCAL", orderable: false },
                    { data: "cnpj", title: "@RsCadastros.CNPJ", orderable: false },
                    { data: "nome_Empresa", title: "@RsCadastros.NOME_EMPRESA" },
                    { data: "data_Emissao", title: "@RsCadastros.DATAEMISSAO", orderable: false },
                    { data: "valor", title: "@RsCadastros.VALOR", orderable: false },
                    {
                        render: function (data, type, row, meta) {
                            return "<a href='" + "@CONSTANTES.URLFinanceiro/Arquivos/Nota_Fiscal/" + row.id + ".pdf" + "' target='_blank'><i class='far fa-file-alt'></i></a>";
                        }
                    }

                    ]
                });

           $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);
                
            });

            $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {

                $("#iDataInicial").val("");
                $("#iDataFinal").val("");

                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
            });

            $("#iPesquisar").on("click", function () {

                $("#modal-filter").modal('hide');

                $("#iDataInicial").val($("#iDataInicial").val().replace(/\//g, "."));
                $("#iDataFinal").val($("#iDataFinal").val().replace(/\//g, "."));

                var _data_ini = $("#iDataInicial").val().split(".");
                var _data_fim = $("#iDataFinal").val().split(".");

                var data_ini = new Date(_data_ini[2], _data_ini[1] - 1, _data_ini[0]);
                var data_fim = new Date(_data_fim[2], _data_fim[1] - 1, _data_fim[0]);

                if ($("#iDataInicial").val() == "" || $("#iDataFinal").val() == "") {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.DATA_INVALIDA)", "warning");
                }
                else if (data_ini >= data_fim) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.DATA_INVALIDA)", "warning");
                }
                else {
                    rows_selected = [];
                    oDatatable.search($('#txtSearch').val()).draw();
                }

                return true;
            });
        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->
    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page"><i class="fas fa-calendar-alt"></i> @ViewBag.Title</h4>
            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Cliente")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELCLIENTES</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="@(Url.Action("ClienteDadosGerais", "Cliente") + "/" + Request.Params["Id_Cliente"])" style="color:#367fa9">@RsBase.CADASTRARCLIENTE</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>
            @*<span style="font-size:11px;margin-left: 15px;" id="dtLegend"></span>*@
        </div>
        <div class="col-auto">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.NOMEOUDOCUMENTO" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
                @*<a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "Campanha")" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>*@
                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" id="btnInativar" href="#" onclick="return false;">@RsBase.INATIVAR</a>
                    <a class="dropdown-item" id="btnAtivar" href="#" onclick="return false;">@RsBase.ATIVAR</a>
                </div>
            </div>
        </div>
    </div>

    <!--./main-->
</div>



<!--Modal Filters-->
<div class="modal" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="col-sm-12" style="align-content:center">

                    <label for="iDataInicial">@RsCadastros.DATA_PREVISTA:</label>
                    <div class="row">
                        <div class="col-sm-1"></div>
                        <div class="col-sm-4">
                            <input type="text" class="form-control datepicker" placeholder="00/00/0000" id="iDataInicial" value="@Model.Data_Ini"/>
                        </div>
                        <div class="col-sm-2">Até</div>
                        <div class="col-sm-4">
                            <input type="text" class="form-control datepicker" placeholder="00/00/0000" id="iDataFinal" value="@Model.Data_Fim"/>
                        </div>
                    </div>

                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
