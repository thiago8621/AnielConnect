                                                </div>
                                            </div>

                                            <div class="col-sm-3" id="iDivPercentual">

                                                <div class="form-group">
                                                    <label for="iRadioPercentual">@RsCadastros.PERCENTUAL_DESCONTO:</label>
                                                    @Html.RadioButtonFor(m => m.TipoValor, "Percentual", new { id = "iRadioPercentual" })

                                                    @Html.TextBoxFor(m => m.Percentual_Desconto, new { @class = "form-control", @id = "iPercentual", @autocomplete = "off" })
                                                    @*@Html.ValidationMessageFor(model => model.Percentual_Desconto, "", new { @class = "text-danger" })*@
                                                </div>
                                            </div>

                                            <div class="col-sm-2" id="iDivPercentual">

                                                <div class="form-group">
                                                    <label for="iRadioPercentual">@RsCadastros.CODIGO_AUXILIAR:</label>
                                                    @Html.TextBoxFor(m => m.CodigoAuxiliar, new { @class = "form-control", @id = "iPercentual", @autocomplete = "off" })
                                                </div>
                                            </div>

                                        </div>

