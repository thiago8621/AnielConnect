        var array = @Html.Raw(Json.Encode(Model.CondicoesCombinadas));

        var nome_lista = "CondicoesCombinadas";//Nome_utilizado para enganar o razor

        //"Blfrtip"
        var oDatatableCondicoesCombinadas = $("#datatableCondicoesCombinadas").length && $("#datatableCondicoesCombinadas").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: array,
            columns: [
                {
                    data: "Id",
                    orderable: false,
                    render: function (data, type, row, meta) {
