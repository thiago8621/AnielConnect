            function handleExcluir() {
                $(".btnExcluirCondicoesCombinadas").unbind('click');
                $(".btnExcluirCondicoesCombinadas").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatableCondicoesCombinadas.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Descontoapi/ExcluirGridCondicoes?value=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatableCondicoesCombinadas.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });
            }



            handleExcluir();
            handleTipoCondicao();
            AtribuirValorCondicao();
            //Adicionar meio de captação



            var descontoMeioCaptacao = @Html.Raw(Json.Encode(ViewBag.Desconto_Meio_Captacao));

