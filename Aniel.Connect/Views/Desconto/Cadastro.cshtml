                                                    @Html.CheckBoxFor(model => model.Desconto_Tempo_Indeterminado, new { @class = "form-control", @id = "iDesconto_Tempo_Indeterminado", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>

                                            <div class="col-sm-3" id="divRepeticoes">
                                                <div class="form-group">
                                                    <label for="iRepeticoes">@RsCadastros.REPETICOES_DESCONTO (Meses):</label>
                                                    @Html.TextBoxFor(model => model.Repeticoes_Desconto, new { @class = "form-control", @type = "number", @id = "iRepeticoes", @autocomplete = "off", @min = 1 })
                                                    @Html.ValidationMessageFor(model => model.Repeticoes_Desconto, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="col-sm-1">
                                                <div class="form-group">
                                                    <label>@RsCadastros.VALOR_UNICO:</label> <i class=" ml-2 fas fa-question-circle" style="color: #357CA5" data-toggle="popover" data-placement="top" title="" data-content="
   Sim = Desconto será um valor único para o tempo de repetição configurado;
   Não = Desconto poderá ser um valor diferente para o tempo de repetição configurado"></i>
                                                    <br>
                                                    @Html.CheckBoxFor(model => model.Valor_Unico, new { @class = "form-control", @id = "iValor_Unico", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>

                                            <div class="col-sm-3" id="iDivValor">
                                                <div class="form-group">


                                                    <label for="iRadioValorUnico">@RsCadastros.VALOR_DESCONTO:</label>
                                                    @Html.RadioButtonFor(m => m.TipoValor, "Valor", new { @id = "iRadioValorUnico" })


                                                    @Html.TextBoxFor(model => model.Valor_Desconto, new { @placeholder = "0,00", @class = "form-control money", @id = "iValor", @autocomplete = "off" })
