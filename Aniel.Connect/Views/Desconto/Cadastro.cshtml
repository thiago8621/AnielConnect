@model Aniel.Connect.Models.DescontoCadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@{
    ViewBag.Title = RsCadastros.CADASTRO_DESCONTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles
    {
    <style>
        .popover-body {
            background-color: #357CA5;
            color: white;
        }
    </style>
    }

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>

    function limparSelect2(id) {
        if ($(`#${id}`).data('select2')) {
            $(`#${id}`).select2('destroy');
        }

        $(`#${id}`).empty();
    }


        var HandleTipoDesconto = function () {

            $('#iTipoDesconto').on('select2:select select2:unselecting', function (e) {
                TipoDescontoSelecionado = e.params.data;

                if (TipoDescontoSelecionado)
                    $("#iFormatoTipoDesconto").text("Formato: " + TipoDescontoSelecionado.formato);
                else
                    $("#iFormatoTipoDesconto").text("");
            });
        };

        AddSelect("iTipoDesconto", "@CONSTANTES.URLPortal/api/Tipo_DescontoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Tipo_Desconto", "@RsBase.SELECIONE", false, HandleTipoDesconto);

        AddSelect("iPais", "@CONSTANTES.URLPortal/api/PaisApi/GetComboConnect", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        @*AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades",@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);*@

        //Money
        $('.money').mask('000000000000,00', { reverse: true });
        //Percentage
        $('.percentage').mask('000,00', { reverse: true });

           //se esta caixa de seleção estiver for marcada pelo usuário o sistema aplicará o
           //desconto em todas as faturas. Se estiver desmarcado deverá ser informada uma
           //quantidade de faturas em que o desconto será aplicado
        $('#iDesconto_Tempo_Indeterminado').change(function () {

            if ($('#iDesconto_Tempo_Indeterminado').is(':checked')) {
                $('#divRepeticoes').hide();
                $('#iValor_Unico').bootstrapToggle('on')
            }

            else {
                $('#divRepeticoes').show();
            }
        });

        $('#iValor_Unico').change(function (e) {

            if (!$('#iValor_Unico').is(':checked') && $('#iDesconto_Tempo_Indeterminado').is(':checked')) {
                Notificar("@RsBase.ATENCAO_", "Atenção! Para definir múltiplos valores para meses marque como Não o Desconto por Tempo Indeterminado? e defina um tempo de repetição", "warning");
                $('#iValor_Unico').bootstrapToggle('on');
            }

            if ($('#iValor_Unico').is(':checked')) {
                $("#iRadioValorUnico").prop("checked", false);
                $("#iRadioPercentual").prop("checked", false);

                $('#iDivValor').show();
                $('#iDivPercentual').show();
                $('#iDivValores').hide();
            }
            else {
                $('#iDivValor').hide();
                $('#iDivPercentual').hide();
                $('#iDivValores').show();
            }
        });

    async function mudancaUF()  {

        var estado = $('#iUf' + ' option:selected').val();
        var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;
        AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades",@CONSTANTES.PaginacaoRegistros, null, estado, null, "@RsBase.SELECIONE", false);
    };


     $('#iUf').change(function () { mudancaUF() });

    function changeCountry() {
        var countryTxt = $('#iPais').text();
        var countryVal = $('#iPais').val();


        if (countryVal != null) {
            if (countryTxt.toUpperCase() == "BRASIL") {
           AddSelect("iUf", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUf", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Uf", "@RsBase.TODOS", false);
            } else {
                $('#iUf').val(null).trigger('change');
                $('#iUf').text("").trigger('change');
                $('#iUf').select2('destroy');
            };
            } else {
            $('#iUf').val(null).trigger('change');
            $('#iUf').text("").trigger('change');
            $('#iUf').select2('destroy');
        };
    };

    $('#iPais').change(function () { changeCountry() });



        $('#iPercentual').focusout(function () {

            if ($('#iPercentual').val() > 100 || $('#iPercentual').val() < 1) {
                $('#iPercentual').val("");
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PERCENTUAL_DESCONTO)", "warning");
                erro = true;

            }
        })

        var handleDataTableButtons = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Valores));

            var nome_lista = "Valores";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            return '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir="' + row.Id +'"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id_Meio" name="' + nome_lista + '[' + meta.row + '].Id_Meio" type="hidden" value="' + TrataNulo(row.Id_Meio) + '">';
                        }
                    },
                    {
                        data: "MesInicial",
                        title: "@RsCadastros.MES_INICIAL",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__MesInicial" name="' + nome_lista + '[' + meta.row + '].MesInicial" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "MesFinal",
                        title: "@RsCadastros.MES_FINAL",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__MesFinal" name="' + nome_lista + '[' + meta.row + '].MesFinal" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Valor",
                        title: "@RsCadastros.VALOR",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Valor" name="' + nome_lista + '[' + meta.row + '].Valor" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Percentual",
                        title: "@RsCadastros.PERCENTUAL",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Percentual" name="' + nome_lista + '[' + meta.row + '].Percentual" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                ]
            });

            function handleExcluir() {
                $(".btnExcluir").unbind('click');
                $(".btnExcluir").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatable.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Descontoapi/ExcluirGridValores?value=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatable.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });
            }

            $(document).ready(function () {

                $('#iRadioValorMes').trigger('change');
                if ($('#iRadioValorUnico').is(':checked')) {

                    $('#iPercentual').prop('disabled', true);
                }

                if ($('#iRadioPercentual').is(':checked')) {

                    $('#iValor').prop('disabled', true);
                }

                $('#iDesconto_Tempo_Indeterminado').trigger('change');
                $('#iValor_Unico').trigger('change');
            });

            if ($('#iRadioValorUnico').prop(('checked', true))){

                $('#iPercentual').prop('disabled', true);
            }

            $('#iRadioValorUnico').on('click', function () {

                $('#iValor').prop('disabled', false);
                $('#iPercentual').prop('disabled', true);
                $('#iPercentual').val("");
            });

            $('#iRadioPercentual').on('click', function () {
                $('#iValor').prop('disabled', true);
                $('#iPercentual').prop('disabled', false);
                $('#iValor').val("");
            });

            handleExcluir();

            //Adicionar meio de captação

            var descontoMeioCaptacao = @Html.Raw(Json.Encode(ViewBag.Desconto_Meio_Captacao));
            $('input[name="RadioOpcaoMes"]').on("change", function () {
                $("#iAdicionarMes").val(null).trigger("change");
                if ($(this).val() == "valor") {
                    //Money
                    $('#iAdicionarMes').mask('000000000000,00', { reverse: true });

                }
                else {
                    $('#iAdicionarMes').mask('000,00', { reverse: true });
                }
            })
            $("#btnAdicionar").on('click', function () {
                let erro = false;
                const DescontoMesesSelecionados = (radio) => {
                    let objeto = {
                        Id: 0,
                        MesInicial: $("#iMesInicial").val(),
                        MesFinal: $("#iMesFinal").val(),
                        Valor: 0,
                        Percentual: 0
                    };
                    if (radio == "valor") {
                        objeto.Valor = $("#iAdicionarMes").val();
                    }
                    else {
                        objeto.Percentual = $("#iAdicionarMes").val();
                    }
                    return objeto;
                }

                if(!$("#iMesInicial").val()){
                    Notificar("@RsBase.ATENCAO_", "valor de mes inicial não foi preenchido", "warning");
                    erro = true;
                }

                if(!$("#iMesFinal").val()){
                    Notificar("@RsBase.ATENCAO_", "valor de mes final não foi preenchido", "warning");
                    erro = true;
                }

                if(!$("#iAdicionarMes").val()){
                    let notificacao = `desconto não foi definido para os meses ${$("#iMesInicial").val()} e ${$("#iMesFinal").val()}.`;
                    Notificar("@RsBase.ATENCAO_",$('input[name="RadioOpcaoMes"]:checked').val() == "value" ? "Valor de" + notificacao : "Percentual de " + notificacao, "warning");
                    erro = true;
                }

                if (erro) {
                    return false;
                }

                oDatatable.row.add(DescontoMesesSelecionados($('input[name="RadioOpcaoMes"]:checked').val())).draw(false);

                $("#iMeio").val("");

                handleExcluir();
            });
        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

    TableManageButtons.init();

