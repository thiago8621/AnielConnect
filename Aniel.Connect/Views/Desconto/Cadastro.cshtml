            var erro = false;


            if (erro) {
                return false;
            }

                oDatatableCondicoesIndependentes.row.add({
                    ValorCondicao: "",
                TipoCondicao: "",
                Id: 0
            }).draw(false);

            handleTipoCondicao();

            handleExcluir();
        });


        },
            TableManageButtonsCondicoesIndependentes = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtonsCondicoesIndependentes();
                    }
                }
            }();

    TableManageButtonsCondicoesIndependentes.init();





        var clicked = false;
        function ValidaSubmit()
        {
            console.log()

            if (clicked) {
                return false;
            }

            clicked = true;
            var erro = false;

            if ($("#iDescricao").val() == "") {
                 Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DESCRICAO)", "warning");
                 erro = true;
            }

             if (!$("#iDesconto_Captacao").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DESCONTO_CAPTACAO)", "warning");
                    erro = true;
             }


           if (!$('#iDesconto_Tempo_Indeterminado').is(':checked')) {

               if (!$("#iRepeticoes").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.REPETICOES_DESCONTO)", "warning");
                    erro = true;
                }
           }

            if ($('#iRadioValorUnico').is(':checked')) {

                if (!$("#iValor").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.VALOR_DESCONTO)", "warning");
                    erro = true;
                }
            }

            if ($('#iRadioPercentual').is(':checked')) {

                var percentual = $("#iPercentual").val()

                $("#iPercentual").val(percentual.replace(".",","))

                if (!$("#iPercentual").val())
                    erro = true;
             }

            if ($("#iTipoDesconto").val() == "") {
                 Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TIPO_DESCONTO)", "warning");
                 erro = true;
            }

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
        }



</script>
}


@using (Html.BeginForm("Cadastro", "Desconto", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
