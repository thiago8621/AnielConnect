@model Aniel.Connect.Models.SLA_ServicoCadastroModel

@{


    ViewBag.Title = RsCadastros.CADASTRO_SLASERVICO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{

}

@section scripts
{
    <script>

    var clicked = false;
    function ValidaSubmit()
    {


        if (clicked) {
            return false;
        }

        clicked = true;


        var erro = false;


        //var regexp = /^((?:[01]\d|2[0-3]):[0-5]\d:[0-5]\d$)/;
        //var correct = ($('#iHoras').val().search(regexp) >= 0) ? true : false;

        @*if ($('#iCalculaSlaRetroativo').is(":checked")) {
                        var idSla = @Model.Id
                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/SLA_Servicoapi/RecalcularSLA?idSla=")' + idSla;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatable.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "", "");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });

        }*@


        if ($('#iHoras').val() == "" || $('#iHoras').val().length < 5) {
            Notificar("@RsBase.ATENCAO_", "@RsCadastros.PREENCHA_HORA_CORRETAMENTE", 'warning');
            erro = true;
            clicked = false;
        }

        Hora = document.getElementById("iHoras");
        hrs = (Hora.value.substring(0, 2));
        min = (Hora.value.substring(3, 5));

        estado = "";
        if ((hrs < 00) || (hrs > 99) || (min < 00) || (min > 59)) {
            document.getElementById("iHoras").style.borderColor = "red";
            estado = "errada";
            erro = true;

        }
        if (Hora == "") {
            document.getElementById("iHoras").style.borderColor = "red";
            estado = "errada";
            erro = true;

        }
        if (estado == "errada") {
            document.getElementById("iHoras").style.borderColor = "red";
            document.getElementById("iHoras").focus();
            erro = true;

        }

        if (erro) {
            clicked = false;
            return false;
        }
        else {
            document.getElementById("iHoras").style.borderColor = "";
        }
        ShowPageLoading();
        $('#form').submit();

    }

    var disabled = (@Json.Encode(Model.Id != 0));

        $(document).ready(function () {

            if (disabled) {
                $("#iHiddemCodCt").prop('disabled', false);
                $("#iHiddemTipo_Servico").prop('disabled', false);
            }
            else {
                $("#iHiddemCodCt").prop('disabled', true);
                $("#iHiddemTipo_Servico").prop('disabled', true);
            }

            AddSelect("iCodCt", "@CONSTANTES.URLPortal/api/ContratoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.CodCt", "@RsBase.SELECIONE", disabled, Handle_CodCt_Change);

            AddSelect("id_Tipo_Servico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, "@Model.CodCt", "@Model.Id_Tipo_Servico", "@RsBase.SELECIONE", disabled);

            AddSelect("iHorario", "@CONSTANTES.URLPortal/api/horarioapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Horario_Connect", "@RsBase.SELECIONE", false);

            AddSelect("iCategoriaCliente", "@CONSTANTES.URLPortal/api/Categoria_ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Categoria_Cliente", "@RsBase.INDIFERENTE", false);

            Handle_Horario();
            Handle_Calendario();

            $("#iCalendario_Padrao").trigger('change');
            $("#iPrioridade_Atendimento").trigger('change');
        });


        var Handle_CodCt_Change = function () {

            $("#iCodCt").change(function () {
                var codct = $("#iCodCt option:selected").val();

                AddSelect("id_Tipo_Servico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, codct, null, "@RsBase.SELECIONE", disabled);
                $("#id_Tipo_Servico").val(null).trigger('change');
            });
        };


        var Handle_Horario = function () {

            $("#iPrioridade_Atendimento").unbind('change');
            $("#iPrioridade_Atendimento").change(function () {

                if ($("#iPrioridade_Atendimento").val() == 0) {
                    $("#iHorario").parent().hide();
                    $("#iHorario").prop('disabled', true);
                    $("#iHiddenHorario").prop('disabled', false);
                }
                else {
                    $("#iHorario").parent().show();
                    $("#iHorario").prop('disabled',false);
                    $("#iHiddenHorario").prop('disabled', true);
                }
            });

        }

        var Handle_Calendario = function () {
            $("#iCalendario_Padrao").unbind('change');
            $("#iCalendario_Padrao").change(function () {
                if ($("#iCalendario_Padrao").is(':checked')) {
                    $("#calendarioOpt").hide();
                }
                else {
                    $("#calendarioOpt").show();
                }
            });

        }

        $(".hora99").on("focusout", function () {

            if ($(this).val()) {
                let min = ($(this).val().substr(4, 2));
                if (((parseInt(min) % 15) != 0.00) && parseInt(min) != 0.00) {
                    $(this).val("");
                    Notificar("@RsBase.ATENCAO_", "@RsCadastros.HORA_INVALIDA", "warning");
                }
            }

        });

    </script>
}


@using (Html.BeginForm("Cadastro", "SLA_Servico", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-flag"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "SLA_SERVICO")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELSLA_SERVICO</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        @*<span style="font-size:11px" id="dtLegend"></span>*@
                    </div>
                </div>

                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <span class="text-bold-card">@ViewBag.Title</span>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iCodCt">@RsCadastros.SEGMENTO:</label>
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.CodCt, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iCodCt" })
                                            @Html.HiddenFor(model => model.CodCt, new { @id = "iHiddemCodCt" })
                                            @Html.ValidationMessageFor(model => model.CodCt, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iTipo_Atendimento_Desc">@RsCadastros.TIPO_SERVICO:</label>
                                        <div class="input-group">
                                            @Html.DropDownListFor(p => p.Id_Tipo_Servico, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "id_Tipo_Servico" })
                                            @Html.HiddenFor(model => model.Id_Tipo_Servico, new { @id = "iHiddemTipo_Servico" })
                                            @Html.ValidationMessageFor(model => model.Tipo_Servico, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                @*<div class="col-sm-3">
                                <label for="iPrioridade_Atendimento" class="mr-3">@RsCadastros.PRIORIDADE_ATENDIMENTO:</label>
                                <div class="form-group">
                                    @Html.EnumDropDownListFor(m => m.Prioridade_Atendimento, RsBase.SELECIONE, new { @class="form-control", @id="iPrioridade_Atendimento" })
                                </div>
                            </div>*@
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iCategoriaCliente">@RsCadastros.CATEGORIA_CLIENTE:</label>
                                        @Html.DropDownListFor(m => m.Id_Categoria_Cliente, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.INDIFERENTE, new { @class = "form-control", @id = "iCategoriaCliente" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iHoras">@RsCadastros.HORAS:</label>
                                        @Html.TextBoxFor(m => m.Horas, new { @class = "form-control hora99", @id = "iHoras", @placeholder = "000:00" })
                                        @Html.ValidationMessageFor(m => m.Horas, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="form-group">
                                        <label for="iCalculaSlaRetroativo">Calcular SLA retroativamente? (alterará as ordens de serviço abertas cadastradas com esse SLA):</label>
                                        @Html.CheckBoxFor(m => m.SLA_Retroativo, new { @class = "form-control", @id = "iCalculaSlaRetroativo", @name = "iCalculaSlaRetroativo", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light", @checked = false })
                                    </div>
                                </div>

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iPrioridade_Atendimento">@RsCadastros.CONTAGEM_PRAZO_EM</label>
                                        <div class="form-group">
                                            @Html.EnumDropDownListFor(m => m.Tipo, RsBase.SELECIONE, new { @class = "form-control", @id = "iPrioridade_Atendimento" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iHorario">@RsCadastros.HORARIO_DE_TRABALHO</label>
                                        @Html.DropDownListFor(m => m.Id_Horario_Connect, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iHorario", @autocomplete = "off" })
                                        @Html.HiddenFor(m => m.Id_Horario_Connect, new { @id = "iHiddenHorario" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">


                                <div class="col-sm-3">
                                    <div class="form-group">
                                        @if (Model.Id != 0)
                                        {

                                            <label for="iStatus" class="mr-3">@RsCadastros.STATUS:</label>
                                            <div class="form-group">
                                                @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                            </div>
                                        }
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!--Button Float-->
        <a href="@Url.Action("Index", "SLA_SERVICO")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit(); return false;">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}
