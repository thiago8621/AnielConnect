@model Aniel.Connect.Models.RotaTelefoniaCadastroModel

@{

    ViewBag.Title = RsCadastros.CADASTRO_ROTA_TELEFONIA.Remove(RsCadastros.CADASTRO_ROTA_TELEFONIA.Length -1, 1);
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    
<script>

    let clicked = false
    let erro = false

    function validaSubmit() {

        if (clicked) {
            return false
        }

        clicked = true
        erro = false

        if (!$('#iNome').val()) {

            Notificar("@RsBase.ATENCAO_", '@RsCadastros.DESCRICAO não informada', "warning");
            erro = true;
        }

        if (erro) {
            clicked = false;
            return;
        }

        $('#form').submit();

    }

</script>
}

@using (Html.BeginForm("Cadastro", "RotaTelefonia", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    <div style="padding:10px">
        <div class="card " style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-route"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GESTAO_CONEXOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "RotaTelefonia")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_ROTA_TELEFONIA</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>



                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">
                                <div class="col-sm-2 mr-auto">

                                    <div class="form-group">
                                        <label for="iNome">@RsCadastros.NOME_ROTA:</label>
                                        @Html.TextBoxFor(model => model.Nome, new { @class = "form-control", @id = "iNome", @autocomplete = "off", @Maxlength = 100 })
                                    </div>

                                </div>

                                <div class="col-sm-2">
                                    @if (Model.Id != 0)
                                    {
                                        <div class="form-group">
                                            <label class="mr-3">@RsFinanceiro.STATUS:</label><br>
                                            @Html.CheckBoxFor(model => model.Status, new { @class = "form-control", @id = "iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    }
                                </div>

                            </div>



                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "RotaTelefonia")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return validaSubmit();" name="gravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>
    </div>
}