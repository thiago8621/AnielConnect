                                <br>
                                <i>/</i>
                            </div>

                            <div class="col-sm-1" id="CIDR">
                                <div class="form-group">
                                    <label for="iCIDR">@RsCadastros.CIDR:</label>
                                    @Html.TextBoxFor(model => model.CIDR, new { @class = "form-control", @id = "iCIDR", @style = "width:75%", @type = "number", @min = 1, @max = 128, @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-2" id="IpFim">
                                <div class="form-group">
                                    <label for="iIPFim">@RsCadastros.IP_FINAL:</label>
                                    @Html.HiddenFor(model => model.Ip_Fim_Range, new { id = "iHiddenIpFim" })
                                    <div id="iIPFim" class="ip-input">
                                        <div class="ip-input-container form-control">
                                            <input type="text" class="ip-input-item" value="">
                                            <i class="ip-input-dot"></i>
                                            <input type="text" class="ip-input-item" value="">
