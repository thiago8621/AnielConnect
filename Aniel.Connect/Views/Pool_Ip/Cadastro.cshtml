                            </div>

                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="iRadius">@RsCadastros.SERVIDOR_RADIUS:</label>
                                    @Html.DropDownListFor(p => p.IdRadius, new List<SelectListItem>(), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iRadius", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-2" id="divConcentradora">
                                <div class="form-group">
                                    <label for="iConcentradora">@RsCadastros.CONCENTRADORA:</label>
                                    @Html.DropDownListFor(p => p.IdConcentradora, new List<SelectListItem>(), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iConcentradora", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-2" id="divNomePoolConcentradora">
                                <div class="form-group">
                                    <label for="iNomePoolConcentradora" style="display:block">@RsCadastros.NOME_POOL_CONCENTRADORA:</label>
                                    @Html.TextBoxFor(model => model.Nome_Pool_Concentradora, new { @class = "form-control", @id = "iNomePoolConcentradora", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Nome_Pool_Concentradora, "", new { @class = "text-danger" })
                                    <!--<i class="ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="Deve corresponder ao nome do Pool de IPs criado na Concentradora"></i>-->
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <div class="outerDivFull mb-2">
                                        <label for="iPoolConcentradora" style="display:block">@RsConfiguracao.POOL_CONTROLADO_POR_CONCENTRADORA?</label>
                                        @Html.CheckBoxFor(m => m.IsPoolConcentradora, new { @class = "form-control", @id = "iPoolConcentradora", @name = "my-checkbox", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                        <i class="ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="Marcado como NÃO o sistema atribuirá o controle do Pool ao Radius"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="col-sm-2" id="PoolIpFixo">
                                <div class="form-group">
                                    <div class="outerDivFull mb-2">
                                        <label for="iPoolIPFixo" style="display:block">@RsConfiguracao.POOL_IP_FIXO?</label>
                                        @Html.CheckBoxFor(m => m.IsPoolIpFixo, new { @class = "form-control", @id = "iPoolIPFixo", @name = "groupPool[]", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>

                            <div class="col-sm-2" id="PoolReducaoVelocidade">
                                <div class="form-group">
                                    <div class="outerDivFull mb-2">
                                        <label for="iPoolReducaoVelocidade" style="display:block">@RsConfiguracao.UTILIZAR_POOL_REDUCAO_VELOCIDADE?</label>
                                        @Html.CheckBoxFor(m => m.IsPoolReducaoVelocidade, new { @class = "form-control", @id = "iPoolReducaoVelocidade", @name = "groupPool[]", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>

                            <div class="col-sm-2" id="DistribuicaoBlocoIp">
                                <div class="form-group">
                                    <div class="outerDivFull mb-2">
                                        <label for="iDistribuicaoBlocoIp" style="display:block">@RsConfiguracao.DISTRIBUICAO_POR_BLOCO_IPS?</label>
                                        @Html.CheckBoxFor(m => m.IsDistribuicaoBlocoIp, new { @class = "form-control", @id = "iDistribuicaoBlocoIp", @name = "groupPool[]", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-2" id="PoolPadraoConcentradora">
                                <div class="form-group">
                                    <div class="outerDivFull mb-2">
                                        <label for="iPoolPadraoConcentradora" style="display:block">@RsConfiguracao.POOL_PADRAO_DA_CONCENTRADORA?</label>
                                        @Html.CheckBoxFor(m => m.PoolPadraoConcentradora, new { @class = "form-control", @id = "iPoolPadraoConcentradora", @name = "groupPool[]", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                        <i class="ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="Marcado como SIM o sistema dará prioridade na escolha deste pool durante a criação do login, no momento do cadastro da venda"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                            @*<div class="row">
                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iIPMascara">@RsCadastros.MASCARA_IP:</label>
                                            @Html.HiddenFor(model => model.Ip_Mascara, new { id = "iHiddenIpMascara" })
                                            <div id="iIPMascara" class="ip-input">
                                                <div class="ip-input-container form-control">
                                                    <input type="text" class="ip-input-item" value="">
                                                    <i class="ip-input-dot"></i>
                                                    <input type="text" class="ip-input-item" value="">
                                                    <i class="ip-input-dot"></i>
                                                    <input type="text" class="ip-input-item" value="">
                                                    <i class="ip-input-dot"></i>
                                                    <input type="text" class="ip-input-item" value="">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>*@
                        </div>
                    </div>

                </div>

                <br>

                <div class="card div-card-accord" id="accordion-ips">
                    <div class="card-header title-card" id="heading-5">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-2" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@RsCadastros.LISTAGEM_IP</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-2" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="form-inline pl-4 pr-2">
                            </div>
                            <div id="divTable">
                                <table class="table table-hover nowrap" id="datatable" style="width:100%">
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Pool_Ip")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}
