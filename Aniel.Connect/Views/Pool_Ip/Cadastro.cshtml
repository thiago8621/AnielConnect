@model Aniel.Connect.Models.Pool_IpCadastroModel

@{
    ViewBag.Title = RsCadastros.POOL_IP;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    <style>
        .ip-input-container {
            width: 105%;
        }
    </style>

}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/maskip")
    @*@Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")*@
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")
    @*@Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")*@

    <script>

        let ip_inicio = undefined;
        //let ip_mascara = undefined;
        let ip_fim = undefined;

        $(document).ready(function () {

            if (@Model.Id == 0) {
                $("#accordion-ips").hide();
            }

            $(function(){
                $('#iIPv6Inicio').ipAddress({v:6});
            });

            ip_inicio = $('#iIPInicio').ipInput();
            //ip_mascara = $('#iIPMascara').ipInput();
            ip_fim = $('#iIPFim').ipInput();
            $('.ip-input-container').addClass('form-control')

            ip_inicio.setIp('@Model.Ip_Inicio_Range');
            @*ip_mascara.setIp('@Model.Ip_Mascara');*@
            ip_fim.setIp('@Model.Ip_Fim_Range');

            $("#DistribuicaoBlocoIp").hide();
            $("#PoolReducaoVelocidade").hide();            
            $("#divNomePoolConcentradora").hide();            

            $("#iRdIpv4").change(function () {
                
                if ($("#iRdIpv4").is(':checked')) {
                    $('#IpInicio').show();
                    $('#IpFim').show();
                    $('#IPv6Inicio').hide();
                    }
                else {
                    $('#IpInicio').hide();
                    $('#IpFim').hide();
                    $('#IPv6Inicio').show();
                }
                


            if (@Model.Id == 0) {
            $("#iCIDR").val('').trigger("change");
            }

            document.getElementById("iIPv6Inicio").readOnly = false;
            });

            $("#iRdIpv6").change(function () {
                
                if ($("#iRdIpv6").is(':checked')) {
                    $('#IpInicio').hide();
                    $('#IpFim').hide();
                    $('#IPv6Inicio').show();
                    }
                else {
                    $('#IpInicio').show();
                    $('#IpFim').show();
                    $('#IPv6Inicio').hide();
                }
                


            if (@Model.Id == 0) {
            $("#iCIDR").val('').trigger("change");
            }

            document.getElementById("iCIDR").readOnly = false;
            });

            $("#iRdIpv4").trigger("change");
            $("#iRdIpv6").trigger("change");
            

            $('#iPoolConcentradora').change(function () {
            if ($('#iPoolConcentradora').is(':checked')) {
            //$('#IpInicio').hide();
            //$('#iSlash').hide();
            //$('#IpFim').hide();
            //$('#IPv6Inicio').hide();
            //$("#CIDR").hide();
                $("#divNomePoolConcentradora").show();     
                $("#DistribuicaoBlocoIp").show();
                //$("#PoolIpFixo").hide();
              
                $("#PoolReducaoVelocidade").show(); 
                $("#divNomePoolConcentradora input").attr("required", "required").addClass("form-control obrigatorio");
            }
            else {
                /*if ($("#iRdIpv4").is(':checked')) {
                $('#IpInicio').show();
                $('#IpFim').show();
                }
                else {
                $('#IPv6Inicio').show();
                }*/
                //$('#iSlash').show();
                //$("#CIDR").show();
                //$("#PoolIpFixo").show();
                $("#DistribuicaoBlocoIp").hide();
                $("#PoolReducaoVelocidade").hide();

                $("#divNomePoolConcentradora").hide();
              
                $("#divNomePoolConcentradora input").removeAttr("required").removeClass("form-control obrigatorio");
                $("#divNomePoolConcentradora input").val('');
                }
            });

        if (@Model.Id != 0) {
            /*
            handlePoolConcentradora();
            $('#iIPFim')[0].childNodes[0].childNodes[0].readOnly = true;
            $('#iIPFim')[0].childNodes[0].childNodes[2].readOnly = true;
            $('#iIPFim')[0].childNodes[0].childNodes[4].readOnly = true;
            $('#iIPFim')[0].childNodes[0].childNodes[6].readOnly = true;
            document.getElementById("iCIDR").readOnly = true;
            $('#iIPInicio')[0].childNodes[0].childNodes[0].readOnly = true;
            $('#iIPInicio')[0].childNodes[0].childNodes[2].readOnly = true;
            $('#iIPInicio')[0].childNodes[0].childNodes[4].readOnly = true;
            $('#iIPInicio')[0].childNodes[0].childNodes[6].readOnly = true;
            document.getElementById("iIPv6Inicio").readOnly = true; */
            $("#iPoolConcentradora").trigger("change");
            handlePoolConcentradora();
      
        }

    /*$('#DistribuicaoBlocoIp').change(function () {
    $('#PoolReducaoVelocidade').prop('checked', false)
    $('#PoolIpFixo').prop('checked', false)
    $('#iPoolBloqueio').prop('checked', false)
    });

    $('#PoolReducaoVelocidade').change(function () {
    $('#DistribuicaoBlocoIp').prop('checked', false)
    $('#PoolIpFixo').prop('checked', false)
    $('#iPoolBloqueio').prop('checked', false)
    });

    $('#PoolIpFixo').change(function () {
    $('#PoolReducaoVelocidade').prop('checked', false)
    $('#PoolIpFixo').prop('checked', false)
    $('#iPoolBloqueio').prop('checked', false)
    });

    $('#iPoolBloqueio').change(function () {
    $('#PoolReducaoVelocidade').prop('checked', false)
    $('#PoolIpFixo').prop('checked', false)
    $('#DistribuicaoBlocoIp').prop('checked', false)
    });*/

    $('input[type="checkbox"]').on('change', function () {

        if (this.name === "IsDistribuicaoBlocoIp" && $('#iDistribuicaoBlocoIp').is(':checked')) {
            $('#iPoolReducaoVelocidade').prop('checked', false).trigger('change');
            $('#iPoolIPFixo').prop('checked', false).trigger('change');
            $('#iPoolBloqueio').prop('checked', false).trigger('change');
        }
        else if (this.name === "IsPoolReducaoVelocidade" && $('#iPoolReducaoVelocidade').is(':checked')) {
            $('#iDistribuicaoBlocoIp').prop('checked', false).trigger('change');
            $('#iPoolIPFixo').prop('checked', false).trigger('change');
            $('#iPoolBloqueio').prop('checked', false).trigger('change');
        }
        else if (this.name === "IsPoolIpFixo" && $('#iPoolIPFixo').is(':checked')) {
            $('#iPoolReducaoVelocidade').prop('checked', false).trigger('change');
            $('#iDistribuicaoBlocoIp').prop('checked', false).trigger('change');
            $('#iPoolBloqueio').prop('checked', false).trigger('change');
        }
        else if (this.name === "IsPoolBloqueio" && $('#iPoolBloqueio').is(':checked')) {
            $('#iPoolReducaoVelocidade').prop('checked', false).trigger('change');
            $('#iPoolIPFixo').prop('checked', false).trigger('change');
            $('#iDistribuicaoBlocoIp').prop('checked', false).trigger('change');
        }

    });

    $('#iCIDR').on('input', function (e) {
    if ($("#iRdIpv4").is(':checked')) {
    if ($("#iCIDR").val() < 1 || $("#iCIDR").val() > 32) { //Máscaras IPv4 suportadas entre 1 bit e 32 bits
    var value = $("#iCIDR").val();
    $("#iCIDR").val(value.substr(0, value.length - 1));
    }
    }
    else {
    if ($("#iCIDR").val() < 1 || $("#iCIDR").val() > 128) { //Máscaras IPv6 suportadas entre 1 bit e 128 bits
    var value = $("#iCIDR").val();
    $("#iCIDR").val(value.substr(0, value.length - 1));
    }
    }

    if ($('#iCIDR').val().length > 0) {
    $('#iIPFim')[0].childNodes[0].childNodes[0].readOnly = true;
    $('#iIPFim')[0].childNodes[0].childNodes[2].readOnly = true;
    $('#iIPFim')[0].childNodes[0].childNodes[4].readOnly = true;
    $('#iIPFim')[0].childNodes[0].childNodes[6].readOnly = true;
    //$('#iIPFim').prop("readonly", true);
    }
    else {
    $('#iIPFim')[0].childNodes[0].childNodes[0].readOnly = false;
    $('#iIPFim')[0].childNodes[0].childNodes[2].readOnly = false;
    $('#iIPFim')[0].childNodes[0].childNodes[4].readOnly = false;
    $('#iIPFim')[0].childNodes[0].childNodes[6].readOnly = false;
    //$('#iIPFim').prop("readonly", false);
    }
    });

    $('#iIPFim').on('input', function (e) {
    if ($('#iIPFim')[0].childNodes[0].childNodes[0].value.length > 0
    || $('#iIPFim')[0].childNodes[0].childNodes[2].value.length > 0
    || $('#iIPFim')[0].childNodes[0].childNodes[4].value.length > 0
    || $('#iIPFim')[0].childNodes[0].childNodes[6].value.length > 0) {
    document.getElementById("iCIDR").readOnly = true;
    //$('#iCIDR').prop("readonly", true);
    }
    else {
    document.getElementById("iCIDR").readOnly = false;
    //$('#iCIDR').prop("readonly", false);
    }
    });

    AddSelect("iRadius", "@CONSTANTES.URLPortal/api/RadiusApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdRadius", "@RsBase.SELECIONE", false)
    AddSelect("iConcentradora", "@CONSTANTES.URLPortal/api/ConcentradoraApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdConcentradora", "@RsBase.SELECIONE", false)
})

        function handlePoolConcentradora() {
            if ($('#iPoolConcentradora').is(':checked')) {
                //$('#IpInicio').hide();
                //$('#iSlash').hide();
                //$('#IpFim').hide();
                //$('#IPv6Inicio').hide();
                //$("#CIDR").hide();
                $("#DistribuicaoBlocoIp").show();
                //$("#PoolIpFixo").hide();
                $("#PoolReducaoVelocidade").show();                
                }
            else {                
                //$('#iSlash').show();
                //$("#CIDR").show();
                //$("#PoolIpFixo").show();
                $("#DistribuicaoBlocoIp").hide();
                $("#PoolReducaoVelocidade").hide();                
            }

            if ($("#iRdIpv4").is(':checked')) {
                    $('#IpInicio').show();
                    $('#IpFim').show();
                }
                else {
                    $('#IPv6Inicio').show();
                }
        }


        var handleDataTableButtons = function () {
            "use strict";

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                /*select: {
                    style: 'multi'
                },*/
                order: [[0, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '79vh',
                /*scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },*/
                //stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + "/api/Pool_Ip_Enderecoapi/GetAllByPoolId",
                    type: 'POST',
                    data: function (data) {
                        data.id_Pool_Ip = @Model.Id
                        },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                        @*{ data: "id", title: "@RsCadastros.CODIGO" },*@
                    { data: "ip", title: "@RsCadastros.IP" },
                    {
                        data: "desc_Status_Ip", title: "@RsCadastros.STATUS",
                        render: function (data, type, row, meta) {
                            if (data === "Indisponivel") return '<i class="text-danger">' + data + '</i>';
                            else if (data === "Ocupado") return '<i class="text-warning">' + data + '</i>';
                            else return '<i style="color:limegreen">' + data + '</i>';
                        }
                    },
                    { data: "usuario_Login_Radius", title: "@RsCadastros.LOGIN_RADIUS" }
                ]
            });
                        },
                        TableManageButtons = function () {
                            "use strict";
                            return {
                                init: function () {
                                    handleDataTableButtons();
                                }
                            }
                        }();

                        if(@Model.Id != 0)
                        {
                        $("#accordion-ips").show();
                        TableManageButtons.init();
                        }


                        var clicked = false;
                        function ValidaSubmit() {
                        if (clicked) {
                        return false;
                        }

                        clicked = true;


                        let erro = false

                        let ipfim_value = ip_fim.getIp();
                        $('#iHiddenIpFim').val(ipfim_value);

                        let ipinicio_value = ip_inicio.getIp();
                        $('#iHiddenIpInicio').val(ipinicio_value);

                        //let ipmascara_value = ip_mascara.getIp();
                        //$('#iHiddenIpMascara').val(ipmascara_value);

                        if (ValidaCamposObrigatorios(erro)) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                        erro = true
                        }

                        if (!$("#iRadius").val()) {
                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.RADIUS)", "warning")
                            erro = true
                        }                       

                        if ($("#iRdIpv6").is(':checked')) {
                        if ($('#iIPv6Inicio').val().length <= 0) {
                        Notificar("@RsBase.ATENCAO_", "Obrigatório informar o IPv6", "warning")
                        erro = true
                        }
                        else {
                        if ($('#iIPv6Inicio').val().isIpv6() == false) {
                        Notificar("@RsBase.ATENCAO_", "O IPv6 informado é inválido", "warning")
                        erro = true
                        }
                        else {
                        $('#iHiddenIpInicio').val($('#iIPv6Inicio').val());
                        }
                        }

                        }

                            if ($('#iPoolConcentradora').is(':checked') == false) {
                                ValidaCampoIP(ip_inicio, "iIPInicio")

                                if ($('#iIPFim').getIp() == undefined && $('#iCIDR').val().length <= 0) {
                                    Notificar("@RsBase.ATENCAO_", "Obrigatório informar Máscara do IP ou IP Final do range", "warning")
                                    erro = true
                                }
                            }
                            else {     
                                 if (!$('#iConcentradora').val()) {
                                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CONCENTRADORA)", "warning")
                                    erro = true
                                 }

                                if ($('#iIPInicio').getIp() != undefined) {
                                    ValidaCampoIP(ip_inicio, "iIPInicio")

                                if ($('#iIPFim').getIp() == undefined && $('#iCIDR').val().length <= 0) {
                                    Notificar("@RsBase.ATENCAO_", "Obrigatório informar Máscara do IP ou IP Final do range", "warning")
                                    erro = true
                                }
                                }
                            }



                        //ValidaCampoIP(ip_fim, "iIPFim")
                        //ValidaCampoIP(ip_mascara, "iIPMascara")

                        if (erro) {
                        clicked = false;
                        return false;
                        }

                        ShowPageLoading();
                        $('#form').submit();
                        return true;
                        }

    </script>
}


@using (Html.BeginForm("Cadastro", "Pool_Ip", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">

                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-digital-tachograph"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GERENCIAMENTO_REDE</a></li>
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Pool_Ip")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_POOL_IP</a></li>
                                <li class="breadcrumb-item"><span>@ViewBag.Title</span></li>
                            </ol>
                        </nav>
                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>

                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iID" class="mr-3">@RsCadastros.ID:</label>
                                        @Html.TextBoxFor(model => model.Id, new { @class = "form-control", @id = "iID", @autocomplete = "off", @readonly = "readonly" })
                                        @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iDescricao">@RsCadastros.NOME_POOL:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control obrigatorio", @id = "iDescricao", @autocomplete = "off", @required = true })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iPadraoIP">@RsCadastros.PADRAO:</label>
                                        <div class="ml-input">
                                            @Html.RadioButtonFor(m => m.PadraoIp, "IPv4", new { @id = "iRdIpv4", @style = "margin-top: 2px;" })
                                            <label for="iRdIpv4" class="pl-1 mr-2">@RsCadastros.IPV4</label>

                                            @Html.RadioButtonFor(m => m.PadraoIp, "IPv6", new { @id = "iRdIpv6", @style = "margin-top: 2px;" })
                                            <label for="iRdIpv6" class="pl-1">@RsCadastros.IPV6</label>
                                        </div>
                                    </div>
                                </div>


                                <div class="col-sm-1">
                                    <div class="outerDivFull mb-2">
                                        <label for="iPoolBloqueio" style="display:block">@RsConfiguracao.UTILIZAR_COMO_POOL_BLOQUEIO_SINAL?</label>
                                        @Html.CheckBoxFor(m => m.IsPoolBloqueio, new { @class = "form-control", @id = "iPoolBloqueio", @name = "groupPool[]", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>



                                @if (Model.Id != 0)
                                {
                                    <div class="col-sm-2 offset-3">
                                        <div class="form-group">
                                            <label for="iStatus">@RsFinanceiro.STATUS:</label><br />
                                            @Html.CheckBoxFor(m => m.Status, new { @class = "form-control obrigatorio", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = RsBase.ATIVAR, @data_off = RsBase.INATIVAR, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>

                                }

                            </div>

                            @*<div class="row">
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label for="iCodigo">@RsCadastros.CODIGO:</label>
                                            @Html.TextBoxFor(model => model.Codigo, new { @class = "form-control", @id = "iCodigo", @autocomplete = "off", @required = true })
                                            @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>*@

                        <div class="row">
                            <div class="col-sm-2" id="IpInicio">
                                <div class="form-group">
                                    <label for="iIPInicio">@RsCadastros.IP_INICIO:</label>
                                    @Html.HiddenFor(model => model.Ip_Inicio_Range, new { id = "iHiddenIpInicio" })
                                    <div id="iIPInicio" class="ip-input">
                                        <div class="ip-input-container form-control">
                                            <input type="text" class="ip-input-item" value="">
                                            <i class="ip-input-dot"></i>
                                            <input type="text" class="ip-input-item" value="">
                                            <i class="ip-input-dot"></i>
                                            <input type="text" class="ip-input-item" value="">
                                            <i class="ip-input-dot"></i>
                                            <input type="text" class="ip-input-item" value="">
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <div class="col-sm-2" id="IPv6Inicio">
                                <div class="form-group">
                                    <label for="iIPv6Inicio">@RsCadastros.ENDERECO_IPV6:</label>
                                    @Html.TextBoxFor(model => model.Ip_Inicio_Range, new { @class = "form-control", @id = "iIPv6Inicio" })
                                </div>
                            </div>

