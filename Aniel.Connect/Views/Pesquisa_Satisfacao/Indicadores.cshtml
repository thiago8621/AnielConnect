                    <span class="text-card" style="font-size: 18px"><b>@Model.Titulo_Pesquisa</b></span>
                    @if (!String.IsNullOrEmpty(Model.Descricao_Pesquisa))
                    {
                        <br />
                        <span class="text-card">@Model.Descricao_Pesquisa</span>
                    }

                </a>
            </h5>
        </div>

        <div id="collapse_1" class="collapse show" aria-labelledby="heading_1" data-parent="#accordion_1">
