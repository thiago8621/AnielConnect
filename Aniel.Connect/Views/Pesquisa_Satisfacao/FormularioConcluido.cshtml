@model Aniel.Connect.Models.Pesquisa_Satisfacao_FormularioConcluidoModel

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Model.enumerado

@{
    ViewBag.Title = RsCadastros.PESQUISA_SATISFACAO;
    ViewBag.Sessao = RsCadastros.PESQUISA_SATISFACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, shrink-to-fit=no' name='viewport' />
    <!-- Fonts and icons -->
    <link rel="stylesheet" type="text/css" href="~/bin/Content/roboto.css" />
    <link rel="stylesheet" href="~/Content/pesquisaSatisf/font-awesome.min.css">
    <!-- CSS Files -->
    <link href="~/Content/pesquisaSatisf/material-kit.min.css?v=2.0.5" rel="stylesheet" />
    <!--<link href="~/Content/pesquisaSatisf/emoji.css" rel="stylesheet" />-->
    <link href="~/Content/pesquisaSatisf/style.css" rel="stylesheet" />
    <style>
        hr {
            margin-top: -10px;
        }
    </style>
}

<!--Content Main-->
<div class="main main-raised mt-5">
    <div class="section section-basic">
        <div class="container">

            <center>
                <div class="col-md-8 ml-auto mr-auto">
                    <div class="card mb-3" style="box-shadow: none;">
                        <div class="row no-gutters">
                            <div class="col-md-4" style="margin-top: 44px;text-align:right;">
                                <img src="@Model.URLLogo" class="img-fluid" />
                            </div>
                            <div class="col-md-8" style="text-align:left;">
                                <div class="card-body">
                                    <h3>@Model.NomeEmpresa</h3>
                                    <hr />
                                    <h4>
                                        @Model.Titulo_Da_Pesquisa
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </center>
            <div style="text-align:center;">
                <h3>
                    @RsCadastros.PESQUISA_OBRIGADO
                </h3>
            </div>
        </div>
    </div>

</div>