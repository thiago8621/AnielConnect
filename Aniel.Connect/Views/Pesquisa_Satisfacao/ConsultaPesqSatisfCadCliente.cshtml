@model Aniel.Connect.Models.Pesquisa_PerguntaListaModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers

@{
    ViewBag.Title = RsCadastros.VISUALIZAR_DASHBOARD_PESQUISA_RESPONDIDA;
    ViewBag.Sessao = RsCadastros.PESQUISA_SATISFACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")

}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

        var rows_selected = [];

        var handleDataTableButtons = function () {
            "use strict";

            function AlterarStatusObj(Status) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/pesquisa_Satisfacaoapi/alterarstatus")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected,
                        status: Status
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });

                rows_selected = [];
            }


            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollY: '66vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/pesquisa_Satisfacaoapi/GetAllRespostas',
                    type: 'POST',
                    dataType: 'json',
                    data: function (data) {

                        data.status_Pesquisa = $("#iStatus").val();
                        data.dataIni = $("#iDataInicial").val();
                        data.dataFin = $("#iDataFinal").val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    {
                        data: "titulo_Da_Pesquisa",
                        title: "@RsCadastros.TITULO_DA_PESQUISA"
                    },
                    {
                        data: "quem_Preenche",
                        title: "@RsCadastros.QUEM_PREENCHE_"
                    },
                    {
                        data: "disparoAuto",
                        title: "@RsCadastros.TIPO_DISPARO",
                    },
                    {
                        data: "status",
                        title: "@RsCadastros.STATUS",
                        orderable: false
                    },
                    {
                        data: "usuario_Criacao",
                        title: "@RsBase.USUARIO_CRIACAO",
                        orderable: false
                    },
                    {
                        data: "data_Hora_Criacao",
                        title: "@RsCadastros.DATAHORA_CRIACAO",
                        orderable: false
                    },
                    {
                        data: "qtde_Envios",
                        title: "@RsCadastros.QTDE_ENVIOS",
                        orderable: false
                    },
                    {
                        data: "qtde_Respostas",
                        title: "@RsCadastros.QTDE_RESPOSTAS",
                        orderable: false
                    },
                    {
                        data: "percentual",
                        title: "@RsCadastros.PERCENTUAL",
                        orderable: false
                    }
                ]
            });

            $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {

                $("#iStatus").val("");

                $("#iDataInicial").val("");
                $("#iDataFinal").val("");

                $("#iAtivaFiltroData").prop('checked', false).change();

                rows_selected = [];
                oDatatable.draw();
            });


            $("#iPesquisar").on("click", function () {

                $("#modal-filter").modal('hide');

                $("#iDataInicial").val($("#iDataInicial").val().replace(/\//g, "."));
                $("#iDataFinal").val($("#iDataFinal").val().replace(/\//g, "."));

                var _data_ini = $("#iDataInicial").val().split(".");
                var _data_fim = $("#iDataFinal").val().split(".");

                var data_ini = new Date(_data_ini[2], _data_ini[1] - 1, _data_ini[0]);
                var data_fim = new Date(_data_fim[2], _data_fim[1] - 1, _data_fim[0]);

                if ($("#iAtivaFiltroData").prop("checked")) {

                    if ($("#iDataInicial").val() == "" || $("#iDataFinal").val() == "") {

                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.SELECIONE_DATAINICIAL_DATAFINAL)", "warning");
                        return false;
                    }

                    if (data_ini > data_fim) {

                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.DATA_INVALIDA)", "warning");
                    }
                    else {
                        rows_selected = [];
                        oDatatable.draw();
                    }
                }
                else {

                    $("#iDataInicial").val("")
                    $("#iDataFinal").val("")

                    rows_selected = [];
                    oDatatable.draw();
                }

                return true;
            });

            $("#btnInativar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);

            });

            $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });

            $('#datatable tbody').on('click', 'tr', function () {
                if (oDatatable.row(this).data() != null) {

                    var _id = oDatatable.row(this).data().id;

                    var url = '@Url.Action("Indicadores", "Pesquisa_Satisfacao", new { id = "__id__" })';
                    
                    window.location.href = url.replace('__id__', _id);
                    ShowPageLoading();
                }
            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

    </script>
}


<div style="padding:10px;">
    <div class="card" style="box-shadow: 0 8px 17px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.1); border:none; min-height: 530px; height: auto;">
        <div class="card-body" style="padding-top: 0">
            <!--main-->

            <div class="row" style="padding-top: 10px;">
                <div class="col" style="margin-top: -10px">

                    <h4 class="title-page"><i class="fas fa-chart-bar"></i> @ViewBag.Title</h4>

                    <nav aria-label="breadcrumb" style="font-size:12px">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item" style="margin-left:22px; margin-top:-18px">
                                <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                            </li>
                            <li class="breadcrumb-item" style="margin-top:-18px">
                                <span>@ViewBag.Title</span>
                            </li>
                        </ol>
                    </nav>

                    <span style="font-size:11px" id="dtLegend"></span>
                </div>

                <div class="row pr-4">
                    <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                    <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                        <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    </div>


                </div>

            </div>

            <table class="table table-hover nowrap" id="datatable" style="width:100%">
                <thead class="tb-head">

                </thead>
            </table>


            <!--./main-->
        </div>
    </div>
</div>


<!--Modal Filters-->
<div class="modal" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-sm-9 align-horizontal">

                        <label for="iStatus" style="font-size: 12px">@RsCadastros.STATUS</label>
                        <select class="form-control" id="iStatus">
                            <option value="">@RsBase.TODOS</option>
                            <option value="0">@RsCadastros.INATIVO</option>
                            <option value="1" selected>@RsCadastros.ATIVO</option>
                        </select>

                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-sm-9 align-horizontal">

                        <div class="row">
                            <div class="ml-2 mr-1">
                                <input type="checkbox" id="iAtivaFiltroData" /><label for="iAtivaFiltroData"></label>
                            </div>

                            <label style="font-size: 12px">Período:</label>
                        </div>
                        <div class="row">
                            <div class="form-group form-inline align-horizontal" style="height:100%;">

                                <input type="text" class="form-control datepicker" placeholder="00/00/0000" id="iDataInicial" />
                                <span class="mr-2 ml-2">@RsBase.A</span>
                                <input type="text" class="form-control datepicker" placeholder="00/00/0000" id="iDataFinal" />

                            </div>
                        </div>

                    </div>
                </div>


                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                    </div>
                </div>

            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal-->
</div>