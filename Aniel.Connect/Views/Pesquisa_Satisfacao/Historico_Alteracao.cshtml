@model Aniel.Connect.Models.LogGenericoParamListModel

@using Resources
@using Aniel.Connect.Models.T5
@using Aniel.Connect.Core

@{
    ViewBag.Title = RsCadastros.HISTORICO_ALTERACAO;
    ViewBag.Sessao = RsCadastros.HISTORICO_ALTERACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{

    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>

    <script>
        //<reference path="../../../Aniel.Connect.Core/Scripts/connect.js" />

       var rows_selected = [];

        var handleDataTableButtons = function () {
            "use strict";

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                columnDefs: [
                    {

                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                processing: true,
                autoWidth: false,
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/Pesquisa_SatisfacaoApi/Historico_Envio',
                    type: 'POST',
                    data: function (data) {
                       

                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     //if($.inArray(rowId, rows_selected) !== -1){
                     //   $(row).find('input[type="checkbox"]').prop('checked', true);
                     //   $(row).addClass('selected');
                     //}
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                   //{ title: "<input name='select_all' value='1' type='checkbox'>" },
                    ////{ data: "id", title: "@RsCadastros.ID", orderable: false },
                    { data: "dataCriacao", title: "@RsBase.DATAHORA", orderable: false },
                    { data: "nomeFantasia", title: "@RsCadastros.CLIENTE", orderable: false },
                    { data: "email", title: "@RsCadastros.EMAIL", orderable: false },
                    { data: "descricao", title: "@RsCadastros.PESQUISAR", orderable: false },
                    { data: "obs", title: "@RsCadastros.OBSERVACAO", orderable: false },

                ]
            });


            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();
    </script>
}


<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-history"></i> @ViewBag.Title</h4>

            <nav class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                    </li>
                     <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Pesquisa_Satisfacao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELPESQUISA_SATISFACAO</a>
                    </li>
                   
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>

                </ol>
            </nav>
          
        </div>       

    </div>

    <!--./main-->
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>

