                }
                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                @*<button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                    <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>*@

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="return EnviarPesquisa();">@RsCadastros.ENVIAR_PESQUISA_SATISFACAO</a>
                    <a class="dropdown-item" href="#" onclick="return AbrirPesquisa();">@RsCadastros.PREENCHER_PESQUISA_SATISFACAO</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    @if (AcessoHelper.TemAcesso(_areas, "72"))
                    {
                        <a class="dropdown-item" id="btnInativar" href="#" onclick="return false;">@RsBase.INATIVAR</a>
                        <a class="dropdown-item" id="btnAtivar" href="#" onclick="return false;">@RsBase.ATIVAR</a>
                    }
                </div>
            </div>
        </div>

    </div>
    <!--./main-->
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>


<!--Modal Filters-->
<div class="modal" id="modal-filter">
    <div class="modal-dialog" style="max-width:60%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsCadastros.FILTRO_PESQUISA_SATISFACAO</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">

                    <div class="col-sm-12" style="align-content:center;">

                        <div class="row mt-1">

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iStatusPesquisa">@RsCadastros.STATUS_PESQUISA:</label>
                                    @Html.EnumDropDownListFor(m => m.StatusPesquisa, RsBase.SELECIONE, new { @class = "form-control", @id = "iStatusPesquisa", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.StatusPesquisa, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-sm-4">

                                <div class="form-group">
                                    <label for="iQuemIndicou">@RsCadastros.QUEMINDICOU:</label>
                                    @Html.EnumDropDownListFor(m => m.QuemPreenche, RsBase.SELECIONE, new { @class = "form-control", @id = "iQuemIndicou", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.QuemPreenche, "", new { @class = "text-danger" })
                                </div>

                            </div>

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iTipoDisparo"> @RsCadastros.TIPO_DISPARO: </label>
                                    @Html.EnumDropDownListFor(m => m.DisparoAuto, RsBase.SELECIONE, new { @class = "form-control", @id = "iTipoDisparo", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.DisparoAuto, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col">
                                <div class="form-group">
                                    <label style="font-size: 12px">@RsCadastros.SLA_ATENDIMENTO:</label><br />
                                    <div class="col-sm-12 pl-3 border_radius">

                                        <div class="form-group">
                                            <div class="form-check mt-2">
                                                <div class="row">
                                                    <div class="col">
                                                        @Html.RadioButton("periodo", 0, false, new { @id = "iSomentePesquisa" }) <label for="radioAbertura">@RsCadastros.PESQUISA_COMENTARIOS</label><br />
                                                    </div>
                                                    <div class="col">
                                                        @Html.RadioButton("periodo", 1, false, new { @id = "iSomentePesquisaSem" }) <label for="radioEncerramento">@RsCadastros.PESQUISA_SEM_COMENTARIOS</label><br />

                                                    </div>

                                                    @*<div class="col">
                                                            @Html.CheckBoxFor(m => m.SomentePesquisa, new { @class = "form-check-input", @id = "iSomentePesquisa", @autocomplete = "off" })
                                                            <label for="iSomentePesquisa">@RsCadastros.PESQUISA_COMENTARIOS </label>
                                                        </div>

                                                        <div class="col">
                                                            @Html.CheckBoxFor(m => m.SomentePesquisaSem, new { @class = "form-check-input", @id = "iSomentePesquisaSem", @autocomplete = "off" })
                                                            <label for="iSomentePesquisaSem">@RsCadastros.PESQUISA_SEM_COMENTARIOS </label>
                                                        </div>*@


                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>


                </div>
                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatableFunction(); $('#modal-filter').modal('hide');" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div><!-- /.modal-content -->
</div><!-- /.modal-dialog -->