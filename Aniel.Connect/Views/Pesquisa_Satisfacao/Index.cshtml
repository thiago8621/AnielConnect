@model Aniel.Connect.Models.PesquisaSatisfacaoFiltroModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.PAINEL_PESQUISA_SATISFACAO;
    ViewBag.Sessao = RsCadastros.PAINEL_PESQUISA_SATISFACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
    var StorageName = CONSTANTES.SIGLA_MODULO + " - " + ViewBag.Title + " - " + CONSTANTES.Versao;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>

}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

     function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            @*if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                    Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 30 dias", "warning");
                    return false
                }
            }*@

            if (oDatatable == null) {
                TableManageButtons.init();
            }
            else {
                oDatatable.draw()
            }

            $('#modal-filter').modal('hide')


        }


        var oDatatable;
        var rows_selected = [];
        var elem_rows_selected = [];

        function EnviarPesquisa() {

            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsCadastros.NENHUM_REGISTRO_SELECIONADO", "warning")
                return false;
            }
            else {

                var erro = false

                var atendentePreenche = elem_rows_selected.filter(function (val) {
                    return val.quem_Preenche == "Atendente"
                })

                if (atendentePreenche.length != 0) {

                    var queueSwal = []

                    $.each(atendentePreenche, function (key, value) {

                        erro = true

                        queueSwal.push({
                            type: "error",
                            title: "A pesquisa " + value.titulo_Da_Pesquisa + " deve ser respondida pelo atendente"
                        })
                    })

                    rows_selected = $.grep(rows_selected, function (value, index) {
                        return atendentePreenche.filter(obj => { return obj.id == value}).length == 0
                    })

                    elem_rows_selected = []
                    Swal.queue(queueSwal).then(function () {

                        if (rows_selected.length > 0) {

                            var url = "@Url.Action("ListaCliente", "Pesquisa_Satisfacao")" + "?Ids_Pesquisa_Satisfacao=" + rows_selected;
                            var titulo = "Pesquisa Satisfacao";

                            AddAba(url, titulo);
                        }
                    })
                }

                if (!erro && (rows_selected.length > 0)) {

                    var url = "@Url.Action("ListaCliente", "Pesquisa_Satisfacao")" + "?Ids_Pesquisa_Satisfacao=" + rows_selected;
                    var titulo = "Pesquisa Satisfacao";

                    AddAba(url, titulo);
                }
            }

            @*var url = "@Url.Action("ListaCliente", "Pesquisa_Satisfacao")" + "?Ids_Pesquisa_Satisfacao=" + rows_selected;
            var titulo = "Pesquisa Satisfacao";

            AddAba(url, titulo);

            return false;*@
        }

        function GetCliente(pesquisas_selecionadas) {

            Swal.fire({
                type: "warning",
                title: "Digite o CPF/CNPJ do cliente:",
                input: "text"
            })
            .then(function (result) {

                if (result.value) {

                    var urlApi = "@CONSTANTES.URLPortal/api/clienteapi/buscaCpf?term=" + result.value
                    $.ajax({
                        url: urlApi,
                        type: "GET",
                        dataType: "json"
                    })
                    .done(function (data) {

                        if (data.ok) {

                            var id_cliente = data.objeto[0].id;

                            $.each(pesquisas_selecionadas, function (index, valor) {

                                var urlApi = "@CONSTANTES.URLPortal/api/Pesquisa_Satisfacao/PreencherPesquisaAtendedor"

                                $.ajax({
                                    url: urlApi,
                                    type: "POST",
                                    dataType: "json",
                                    data: {
                                        Id_Pesquisa: valor,
                                        Id_Cliente: id_cliente
                                    }
                                })
                                .done(function (data) {

                                    window.open(data.objeto.caminho_Pesquisa, "_blank")
                                })
                            })
                        }
                        else {
                            Swal.fire({
                                type: "error",
                                title: "Cliente não encontrado"
                            })
                        }

                        elem_rows_selected = []
                    })
                }
            })
        }

        function AbrirPesquisa() {

            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "Selecione uma pesquisa de satisfação", "warning")
            }
            else if (rows_selected.length > 1) {
                Notificar("@RsBase.ATENCAO_", "Selecione apenas uma pesquisa de satisfação", "warning")
            }
            else {

                var erro = false

                var clientePreenche = elem_rows_selected.filter(function (val) {
                    return val.quem_Preenche == "Cliente"
                })

                if (clientePreenche.length != 0) {

                    var queueSwal = []

                    $.each(clientePreenche, function (key, value) {

                        erro = true

                        queueSwal.push({
                            type: "error",
                            title: "A pesquisa " + value.titulo_Da_Pesquisa + " deve ser respondida pelo cliente"
                        })
                    })

                    rows_selected = $.grep(rows_selected, function (value, index) {
                        return clientePreenche.filter(obj => { return obj.id == value}).length == 0
                    })

                    elem_rows_selected = []
                    Swal.queue(queueSwal).then(function () {

                        if (rows_selected.length > 0)
                            GetCliente(rows_selected)
                    })
                }

                if (!erro && (rows_selected.length > 0))
                    GetCliente(rows_selected)
            }
        }

        var handleDataTableButtons = function () {
            "use strict";

            function AlterarStatusObj(Status) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/pesquisa_Satisfacaoapi/alterarstatus")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected,
                        status: Status
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });

                rows_selected = [];
            }


            //"Blfrtip"
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/pesquisa_Satisfacaoapi/GetAll',
                    type: 'POST',
                    data: function (data) {
                         window.localStorage.setItem(
                        "@Html.Raw(StorageName)",
                        JSON.stringify(
                        $('.filtro').toArray().map(p => ({
                            id: $(p).attr('id'),
                            value: $(p).val(),
                            checked: $(p).prop('checked')
                        }))
                     )
                    );
                        data.StatusPesquisa = $('#iStatusPesquisa').val();
                        data.QuemPreenche = $('#iQuemIndicou').val();
                        data.DisparoAuto = $('#iTipoDisparo').val();
                        data.SomentePesquisa = $('#iSomentePesquisa').is(":checked");
                        data.SomentePesquisaSem = $('#iSomentePesquisaSem').is(":checked");

                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [

                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "titulo_Da_Pesquisa", title: "@RsCadastros.TITULO" },
                    { data: "quem_Preenche", title: "@RsCadastros.QUEM_INDICOU" },
                    { data: "tipo_Disparo", title: "@RsCadastros.TIPO_DISPARO" },

                    { data: "status", title: "@RsCadastros.STATUS" },

                    {
                        data: "quem_Preenche",
                        render: function (data, type, row, meta) {

                            return '<input type="hidden" value="' + data + '">';

                        }
                    }



                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                console.log("Testando a pesquisa")
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });


            $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {

                $("#iSomentePesquisa").prop("checked", false).change();
                $("#iSomentePesquisaSem").prop("checked", false).change();


                $("#iStatusPesquisa").val(null).trigger('change');
                $("#iQuemIndicou").val(null).trigger('change');
                $("#iTipoDisparo").val(null).trigger('change');


                $('#txtSearch').val("");
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();

            });

            @*$("#iPesquisar").on("click", function () {
                 if (ValidaCamposObrigatorios(false)) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
            return false;
        }

                $("#modal-filter").modal('hide');
                rows_selected = [];
                 oDatatable.search($('#txtSearch').val()).draw();
                return true;
            });*@


            $("#btnInativar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);

            });

            $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });


            $("#btnExcluir").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/pesquisa_Satisfacaoapi/excluirlista")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index_elem = $.inArray(oDatatable.row($row).data(), elem_rows_selected)
                if (this.checked && index_elem === -1) {

                    elem_rows_selected.push(oDatatable.row($row).data());
                }
                else if (!this.checked && index_elem !== -1) {
                    elem_rows_selected.splice(index_elem, 1);
                }

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function () {
                 @if (AcessoHelper.TemAcesso(_areas, "71"))
                  {
                  <text>
                      if (oDatatable.row(this).data() != null) {

                          var _id = oDatatable.row(this).data().id;

                          var url = '@Url.Action("Cadastro", "Pesquisa_Satisfacao", new { id = "__id__" })';
                          window.location.href = url.replace('__id__', _id);
                          ShowPageLoading();
                      }
                   </text>
                  }
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

    </script>
}



