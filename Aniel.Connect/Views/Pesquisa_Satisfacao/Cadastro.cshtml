@model Aniel.Connect.Models.Pesquisa_SatisfacaoCadastroModel

@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Sinapse.Model.enumerados


@{
    ViewBag.Title = RsCadastros.CADASTRO_PESQUISA_SATISFACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    <style>
        .bootstrap-tagsinput input {
            width: 95%;
        }

        .popover-body {
            background-color: #357CA5;
            color: white;
        }
    </style>



}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>

        $("#iTemCaixaTexto").on("change", function () {

            if ($("#iTemCaixaTexto").is(":checked")) {
                $("#divTipoCaixa").show();
            }
            else {
                $("#divTipoCaixa").hide();
            }
        });

        function checkValue(id)
        {
            $("#" + id).val($("#" + id).is(":checked"));
            return true;
        }

        $(document).ready(function () {
            $("#iStatusPesquisaPergunta").prop("checked", true).change()
        })

        @if (Model.PesquisaJaEnviada)
        {
            <text>
            $(document).ready(function () {

                $("#iTemCaixaTexto").bootstrapToggle('disable');
                $("#iTipoCaixaTexto").addClass('readonly');
            })
            </text>
        }

        var handleDataTableButtons = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Perguntas));
            var qtderegistros = array.length;

            var nome_lista = "Perguntas";//Nome_utilizado para enganar o razor

            var tipos_resposta = @(Html.GetArrayEnum<Pesquisa_Tipo_Resposta>());

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                paging: false,
                ordering: false,
                columnDefs: [{
                    targets: 0,
                    searchable: false,
                    orderable: false,
                    width: '100px',
                    className: 'dt-body-center'
                }],
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            var retorno = ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Tipo_Resposta" name="' + nome_lista + '[' + meta.row + '].Tipo_Resposta" type="hidden" value="' + TrataNulo(row.Tipo_Resposta) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Respostas_Possiveis" name="' + nome_lista + '[' + meta.row + '].Respostas_Possiveis" type="hidden" value="' + TrataNulo(row.Respostas_Possiveis) + '">' + 
                                ' <input id="' + nome_lista + '_' + meta.row + '__Escala_Emoticos" name="' + nome_lista + '[' + meta.row + '].Escala_Emoticos" type="hidden" value="' + TrataNulo(row.Escala_Emoticos) + '">';

                        @if (!Model.PesquisaJaEnviada) {
                                <text>
                            retorno = retorno + '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>';

                            if (meta.row != 0) {
                                retorno = retorno + '<a href="#" class="btnUp" id="btnUp_' + meta.row + '" valor="' + row.Descricao + '"><i class="fas fa-arrow-up" style="font-size:16px;;padding-right:2px;"></i></a>';
                            }

                            if (meta.row != (qtderegistros - 1)) {
                                retorno = retorno + '<a href="#" class="btnDown" id="btnDown_' + meta.row + '" valor="' + row.Descricao + '"><i class="fas fa-arrow-down" style="font-size:16px;;padding-right:2px;"></i></a>';
                            }
                                </text>
                            }
                            else
                        {
                                <text>
                            if (meta.row != 0) {
                                retorno = retorno + '<a href="#" class="btnUp readonly" id="btnUp_' + meta.row + '" valor="' + row.Descricao + '"><i class="fas fa-arrow-up" style="font-size:16px;;padding-right:2px;"></i></a>';
                            }

                            if (meta.row != (qtderegistros - 1)) {
                                retorno = retorno + '<a href="#" class="btnDown readonly" id="btnDown_' + meta.row + '" valor="' + row.Descricao + '"><i class="fas fa-arrow-down" style="font-size:16px;;padding-right:2px;"></i></a>';
                            }
                                </text>
                            }

                            return retorno;
                        }
                    },
                    {
                        data: "Ordem",
                        orderable: false,
                        title: "@RsCadastros.ORDEM",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + 'º <input id="' + nome_lista + '_' + meta.row + '__Ordem" name="' + nome_lista + '[' + meta.row + '].Ordem" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                            AtualizarOrdem();
                        }
                    },
                    {
                        data: "Descricao",
                        title: "@RsCadastros.PERGUNTA",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = TrataNulo(data) + ' <input id="' + nome_lista + '_' + meta.row + '__Descricao" name="' + nome_lista + '[' + meta.row + '].Descricao" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Tipo_Resposta",
                        title: "@RsCadastros.TIPO_RESPOSTA",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = tipos_resposta[data] + ' <input id="' + nome_lista + '_' + meta.row + '__Tipo_Resposta" name="' + nome_lista + '[' + meta.row + '].Tipo_Resposta" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Obrigatorio",
                        title: "@RsCadastros.OBRIGATORIO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {

                            @if (!Model.PesquisaJaEnviada)
                                {
                                    <text>
                                var func = "return checkValue('" + nome_lista + "_" + meta.row + "__Obrigatorio');";
                                data = ' <input onclick="' + func + '" id="' + nome_lista + '_' + meta.row + '__Obrigatorio" name="' + nome_lista + '[' + meta.row + '].Obrigatorio" type="checkbox" ' + (data === true ? 'checked' : '') + ' value="' + data + '"/>';
                                    </text>
                                }
                                else
                            {
                                    <text>
                                var func = "return checkValue('" + nome_lista + "_" + meta.row + "__Obrigatorio');";
                                data = ' <input onclick="' + func + '" id="' + nome_lista + '_' + meta.row + '__Obrigatorio" class="readonly" name="' + nome_lista + '[' + meta.row + '].Obrigatorio" type="checkbox" ' + (data === true ? 'checked' : '') + ' value="' + data + '"/>';
                                    </text>
                                }

                            }
                            return data;
                        }
                    },
                    {
                        data: "Status_Pesquisa_Pergunta",
                        title: "@RsCadastros.ATIVO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {

                            @if (!Model.PesquisaJaEnviada)
                                {
                                    <text>
                                var func = "return checkValue('" + nome_lista + "_" + meta.row + "__Status_Pesquisa_Pergunta');";
                                data = ' <input onclick="' + func + '" id="' + nome_lista + '_' + meta.row + '__Status_Pesquisa_Pergunta" name="' + nome_lista + '[' + meta.row + '].Status_Pesquisa_Pergunta" type="checkbox" ' + (data === true ? 'checked' : '') + ' value="' + data + '">';
                                    </text>
                                }
                                else
                            {
                                    <text>
                                var func = "return checkValue('" + nome_lista + "_" + meta.row + "__Status_Pesquisa_Pergunta');";
                                data = ' <input onclick="' + func + '" id="' + nome_lista + '_' + meta.row + '__Status_Pesquisa_Pergunta" class="readonly" name="' + nome_lista + '[' + meta.row + '].Status_Pesquisa_Pergunta" type="checkbox" ' + (data === true ? 'checked' : '') + ' value="' + data + '">';
                                    </text>
                                }
                            }
                            return data;
                        }
                    },
                    {
                        data: "Escala_Linear_Ini",
                        title: "@RsCadastros.ESCALA_LINEAR_INI",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = TrataNulo(data) + ' <input id="' + nome_lista + '_' + meta.row + '__Escala_Linear_Ini" name="' + nome_lista + '[' + meta.row + '].Escala_Linear_Ini" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Escala_Linear_Fin",
                        title: "@RsCadastros.ESCALA_LINEAR_FIN",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = TrataNulo(data) + ' <input id="' + nome_lista + '_' + meta.row + '__Escala_Linear_Fin" name="' + nome_lista + '[' + meta.row + '].Escala_Linear_Fin" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Escala_Emoticos",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = TrataNulo(data) + ' <input id="' + nome_lista + '_' + meta.row + '__Escala_Emoticos" name="' + nome_lista + '[' + meta.row + '].Escala_Emoticos" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        },
                        visible: false
                    }
                ]
            });

            function handleExcluir() {
                $(".btnExcluir").unbind('click');
                $(".btnExcluir").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatable.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/pesquisa_PerguntaApi/Excluir?id=")' + idArquivo;

                        $.ajax({
                        url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                            if (data.ok) {
                                oDatatable.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                qtderegistros -= 1;
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                            .fail(function () {

                        })
                            .always(function () {

                        });
                    }

                });

                $(".btnUp").unbind('click');
                $(".btnUp").click(function (e) {
                    e.preventDefault();

                    var trLinkButton = $(this).parents('tr');
                    moveRow(oDatatable, trLinkButton, 'up');

                    handleExcluir();

                    AtualizarOrdem();
                });

                $(".btnDown").unbind('click');
                $(".btnDown").click(function (e) {
                    e.preventDefault();

                    var trLinkButton = $(this).parents('tr');
                    moveRow(oDatatable, trLinkButton, 'down');

                    handleExcluir();

                    AtualizarOrdem();
                });

            }

            handleExcluir();

            $("#btnAdicionar").on('click', function () {

                var erro = false;

                if (!$("#iDescricao").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TITULO)", "warning");
                    erro = true;
                }

                if ($("#iTipo_Resposta").val() == "2") {
                    if (!$("#iEscala_Linear_Ini").val()) {

                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ESCALA_LINEAR_INI)", "warning");
                        erro = true;
                    }
                    else if (!($("#iEscala_Linear_Ini").val() >= 0 && $("#iEscala_Linear_Ini").val() <= 1)) {

                        Notificar("@RsBase.ATENCAO_", "A escala linear deve começar em 0 ou 1", "warning")
                        erro = true
                    }

                    if (!$("#iEscala_Linear_Fin").val()) {

                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ESCALA_LINEAR_FIN)", "warning");
                        erro = true;
                    }
                    else if (!($("#iEscala_Linear_Fin").val() >= 5 && $("#iEscala_Linear_Fin").val() <= 10)) {

                        Notificar("@RsBase.ATENCAO_", "A escala linear deve terminar em um número de 5 a 10", "warning")
                        erro = true
                    }
                }
                else if ($("#iTipo_Resposta").val() == 0 || $("#iTipo_Resposta").val() == 1) {

                    if (!$("#iRespostas_Possiveis").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.RESPOSTAS_POSSIVEIS)", "warning");
                        erro = true;
                    }
                }

                if ($("#iDescricao").val().length > 300) {

                     Notificar("@RsBase.ATENCAO_", "Informe uma descrição da pergunta de até 300 caracteres", "warning")
                     erro = true
                }

                if (erro) {
                    return false;
                }


                var obg = false;
                var StatusPesPerg = false;


                if ($("#iObrigatorio").parent().hasClass("toggle btn btn-success")) {
                    obg = true;
                    $("#iObrigatorio").parent().toggleClass("toggle btn btn-success toggle btn btn-light off");
                }
                else if ($("#iObrigatorio").parent().hasClass("toggle btn btn-light off")) {
                    obg = false;
                }

                if ($("#iStatusPesquisaPergunta").parent().hasClass("toggle btn btn-success")) {
                    StatusPesPerg = true;
                    $("#iStatusPesquisaPergunta").parent().toggleClass("toggle btn btn-success toggle btn btn-light off");
                }
                else if ($("#iStatusPesquisaPergunta").parent().hasClass("toggle btn btn-light off")) {
                    StatusPesPerg = false;
                }

                qtderegistros += 1;

                oDatatable.row.add({
                Id: 0,
                    Descricao: $("#iDescricao").val(),
                    Status_Pesquisa_Pergunta: StatusPesPerg,
                    Ordem: 0,
                    Obrigatorio: obg,
                    Escala_Linear_Ini: $("#iEscala_Linear_Ini").val(),
                    Escala_Linear_Fin: $("#iEscala_Linear_Fin").val(),
                    Tipo_Resposta: $("#iTipo_Resposta option:selected").val(),
                    Respostas_Possiveis: $('#iRespostas_Possiveis').val() ? $('#iRespostas_Possiveis').tagsinput('items').join(";") : "",
                    Escala_Emoticos: $("#iEscala_Emoticos").val()
                }).draw(false);

                oDatatable.column(0).cells().invalidate().render();
                AtualizarOrdem();

                $("#iDescricao").val("");
                $("#iStatusPesquisaPergunta").val(true).trigger("change");
                $("#iObrigatorio").val(true);
                $("#iEscala_Linear_Ini").val("");
                $("#iEscala_Linear_Fin").val("");
                $("#iTipo_Resposta").val("0").trigger("change");
                $('#iRespostas_Possiveis').tagsinput('removeAll');
                $("#iEscala_Emoticos").val("");

                handleExcluir();
            });


        },
            TableManageButtons = function () {
            "use strict";
            return {
            init: function () {
                    handleDataTableButtons();
                }
            }
        }();

        TableManageButtons.init();

        function AtualizarOrdem() {
            $.each($('#datatable tr td:nth-child(2)'), function (index, val) {
                    var ordem = index + 1;
                    $(this).html(ordem + "º"+ '<input id="Perguntas_' + index + '__Ordem" name="Perguntas[' + index + '].Ordem" type="hidden" value="' + ordem + '">');
                });
        }

    $("#iTipo_Resposta").on("change", function () {
            if ($("#divRespostas_Possiveis .bootstrap-tagsinput").length) {
                $("#iRespostas_Possiveis").tagsinput('destroy');
            }


        if ($(this).val() == "2") { // Escala Linear
            $("#divRespostas_Possiveis").hide();
            $("#iDiv_Esc_Ini").show();
            $("#iDiv_Esc_Fin").show();
            $("#iDiv_Emotico").hide();
            $("#divTexto").hide();
            $("#iEscala_Linear_Ini").val("1");
            $("#iEscala_Linear_Fin").val("10");
        }
        else if ($(this).val() == "3") { // Emoticons
            $("#divRespostas_Possiveis").hide();
            $("#iDiv_Esc_Ini").hide();
            $("#iDiv_Esc_Fin").hide();
            $("#iDiv_Emotico").show();
            $("#divTexto").hide();
            $("#iEscala_Emoticos").show();
            $("#iEscala_Linear_Ini").val(null);
            $("#iEscala_Linear_Fin").val(null);
        }
            else if ($(this).val() == "1" || $(this).val() == "0") {
                const $input = $('#iRespostas_Possiveis');
                $input.tagsinput({
                    confirmKeys: [13],
                    delimiter:';',
                    trimValue: true
                });

                $input.on('keypress', function (e) {
                    if (e.key === ',' || e.key === ';') {
                        e.stopPropagation(); // impede quebra
                    }
                });

            $("#divRespostas_Possiveis").show();
            $("#iDiv_Esc_Ini").hide();
            $("#iDiv_Esc_Fin").hide();
            $("#iDiv_Emotico").hide();
            $("#divTexto").hide();
            $("#iEscala_Linear_Ini").val(null);
            $("#iEscala_Linear_Fin").val(null);
        }
		else if ($(this).val() == "4") { // Texto

            $("#divRespostas_Possiveis").hide();
            $("#iDiv_Esc_Ini").hide();
            $("#iDiv_Esc_Fin").hide();
            $("#iDiv_Emotico").hide();
            $("#divTexto").show();
            $("#iEscala_Linear_Ini").val(null);
            $("#iEscala_Linear_Fin").val(null);
        }

            else {
                $("#iDiv_Esc_Ini").hide();
                $("#iDiv_Esc_Fin").hide();
                $("#iDiv_Emotico").hide();
                $("#iEscala_Linear_Ini").val(null);
                $("#iEscala_Linear_Fin").val(null);
            }
    });

    $("#iTeEnviarMsgEmailSms").change(function () {

        if ($("#iTeEnviarMsgEmailSms").is(':checked')) {
                 $('#modeloenvio').show();
             }
              else {
                    $('#modeloenvio').hide();
                   }
                   });

        $(document).ready(function () {

            somenteNumeros('iEscala_Linear_Ini');
            somenteNumeros('iEscala_Linear_Fin');
            $('#iTeEnviarMsgEmailSms').trigger('change');

            $("#iTemCaixaTexto").trigger("change");

            $('#iEnviarMsgEmailSms').tagsinput({
                //tagClass: 'tagChips',
                confirmKeys: [13],
                delimiter: ';'
            });
            $("#iTipo_Resposta").trigger('change');
            AddSelect("iModelo_Envio", "@CONSTANTES.URLPortal/api/Configuracao_Envio_Mensagensapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Modelo_Envio", "@RsBase.SELECIONE", false);
        });

        var clicked = false;
        function ValidaSubmit()
        {
            var erro = false

            if (clicked) {
                return false;
            }

            if (!$("#iQuemPreenche").val()) {

                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.QUEM_PREENCHE_)", "warning")
                erro = true
            }

            if (!$("#iDisparoAutomatico").val()) {

                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DISPARO_AUTOMATICO_)", "warning")
                erro = true
            }

            if (!$("#iNome").val()) {

                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TITULO)", "warning")
                erro = true
            }

            if ($("#iNome").val().length > 100) {

                Notificar("@RsBase.ATENCAO_", "Informe um título com até 100 caracteres", "warning")
                erro = true
            }

            if ($("#iDescricao_Pesquisa").val().length > 200) {

                Notificar("@RsBase.ATENCAO_", "Informe uma descrição com até 200 caracteres", "warning")
                erro = true
            }

            if ($("#iTemCaixaTexto").prop('checked')) {
                if (!$("#iTipoCaixaTexto").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TIPO_CAIXATEXTO)", "warning")
                    erro = true
                }
            }
            
            if (!erro) {

                @if (!Model.PesquisaJaEnviada)
                {
                    <text>
                    clicked = true;

                    ShowPageLoading();
                    $('#form').submit();
                    </text>
                }
                else
                {
                    <text>
                    Swal.fire({
                        type: "warning",
                        text: "Você está tentando alterar dados de uma pesquisa que já foi enviada para alguns clientes. Deseja alterar mesmo assim?",
                        showConfirmButton: true,
                        showCancelButton: true,
                        cancelButtonText: 'Cancelar'
                    }).then(function (result) {

                        if (result.value) {

                            clicked = true;

                            ShowPageLoading();
                            $('#form').submit();
                        }
                    })
                    </text>
                }
            }
        }



</script>
}


@using (Html.BeginForm("Cadastro", "Pesquisa_Satisfacao", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page">
                            <i class="fas fa-headset"></i> @ViewBag.Title
                        </h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a></li>
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Pesquisa_Satisfacao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_PESQUISA_SATISFACAO</a></li>
                                <li class="breadcrumb-item"><span>@ViewBag.Title</span></li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <div class="accordion">
                    <div class="card div-card-accord">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label for="iNome">@RsCadastros.TITULO:</label>
                                        @Html.TextBoxFor(model => model.Titulo_Da_Pesquisa, new { @class = "form-control", @id = "iNome", @autocomplete = "off" })
                                        @*@Html.ValidationMessageFor(model => model.Titulo_Da_Pesquisa, "", new { @class = "text-danger" })*@

                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iQuemPreenche">@RsCadastros.QUEM_PREENCHE_:</label>
                                        @Html.EnumDropDownListFor(m => m.QuemPreenche, RsBase.SELECIONE, new { @class = "form-control", @id = "iQuemPreenche", @autocomplete = "off" })
                                    </div>
                                </div>
                                <div class="col-sm-3">
