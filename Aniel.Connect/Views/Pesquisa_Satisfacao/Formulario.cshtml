@model Aniel.Connect.Models.Pesquisa_Satisfacao_FormularioModel

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Model.enumerado

@{
    ViewBag.Title = RsCadastros.PESQUISA_SATISFACAO;
    ViewBag.Sessao = RsCadastros.PESQUISA_SATISFACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, shrink-to-fit=no' name='viewport' />
    <!-- Fonts and icons -->
    <link rel="stylesheet" type="text/css" href="~/bin/Content/roboto.css" />
    <link rel="stylesheet" href="~/Content/pesquisaSatisf/font-awesome.min.css">
    <!-- CSS Files -->
    <link href="~/Content/pesquisaSatisf/material-kit.min.css?v=2.0.5" rel="stylesheet" />
    <!--<link href="~/Content/pesquisaSatisf/emoji.css" rel="stylesheet" />-->
    <link href="~/Content/pesquisaSatisf/style.css" rel="stylesheet" />

    <style>
        hr {
            margin-top: -10px;
        }
    </style>
}

@section scripts {

    <script>

        var clicked = false;
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;

            var erro = false;

            @for (int y = 0; y < Model.Pesquisa.Perguntas.Count(); y++)
            {
                if (Model.Pesquisa.Perguntas[y].Obrigatorio)
                {
                    if (Model.Pesquisa.Perguntas[y].Tipo_Resposta == Pesquisa_Tipo_Resposta.Multipla_Escolha)
                    {
                    <text>
            var radioValue_@y = $("input[name^='Pesquisa.Perguntas[@y].Respostas']:checked").val();
            if (!radioValue_@y) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.PERGUNTAREQUIRED, y + 1)", "warning");
                erro = true;
            }
                    </text>
                    }
                    else {
                    <text>
            var radioValue_@y = $("input[name='Pesquisa.Perguntas[@y].Resposta']:checked").val();
            if (!radioValue_@y) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.PERGUNTAREQUIRED, y + 1)", "warning");
                erro = true;
            }
                    </text>
                    }


                }
            }


            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
        }

    </script>
}

<!--Content Main-->
<div class="main main-raised mt-5">
    <div class="section section-basic">
        <div class="container">

            @using (Html.BeginForm("Formulario", "Pesquisa_Satisfacao", FormMethod.Post, htmlAttributes: new { @id = "form" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.Pesquisa.Id)
                @Html.HiddenFor(model => model.Id_Cliente)
                @Html.HiddenFor(model => model.Pesquisa.URLLogo)
                @Html.HiddenFor(model => model.Pesquisa.Titulo_Da_Pesquisa)
                @Html.HiddenFor(model => model.Pesquisa.AssuntoPesquisa)
                @Html.HiddenFor(model => model.Pesquisa.CorpoPesquisa)

                <div class="row">

                    <div class="col-md-4">
                        <img src="@Model.Pesquisa.URLLogo" class="img-fluid" />
                    </div>

                    <div class="col-md-8 ml-auto mr-auto">
                        <center>
                            <div class="mb-3" style="box-shadow: none;">
                                <div class="row no-gutters">

                                    <div class="col-md-8" style="text-align:left;">
                                        <div class="card-body">
                                            <h3>@Model.Pesquisa.NomeEmpresa</h3>
                                            <hr />
                                            <h4>
                                                @Model.Pesquisa.Titulo_Da_Pesquisa
                                            </h4>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </center>
                    </div>

                </div>
                <div class="row">
                    @Html.Raw(Model.Pesquisa.CorpoPesquisa)
                </div>

                if (Model.JaRespondido)
                {
                    <div style="text-align:center;">
                        <h3>
                            @RsCadastros.PESQUISA_JA_RESPONDIDA
                        </h3>
                    </div>
                }
                else
                {
                    Model.Pesquisa.Perguntas.RemoveAll(p => !p.Status_Pesquisa_Pergunta);

                    for (int y = 0; y < Model.Pesquisa.Perguntas.Count(); y++)
                    {
                        @Html.HiddenFor(p => @Model.Pesquisa.Perguntas[y].Id)
                        <div>
                            <h3>
                                @(y + 1). @Model.Pesquisa.Perguntas[y].Descricao <span style="color: red;"> @(Model.Pesquisa.Perguntas[y].Obrigatorio ? "*" : "") </span>
                            </h3>
                            @if (Model.Pesquisa.Perguntas[y].Tipo_Resposta == Pesquisa_Tipo_Resposta.Avaliacao_Escala_Linear)
                            {
                                <div class="btn-group btn-group-toggle btn-group-sm" data-toggle="buttons">
                                    @for (Int32 i = Convert.ToInt32(Model.Pesquisa.Perguntas[y].Escala_Linear_Ini); i <= Convert.ToInt32(Model.Pesquisa.Perguntas[y].Escala_Linear_Fin); i++)
                                    {
                                        String classeButton = "";

                                        if (Convert.ToInt32(Model.Pesquisa.Perguntas[y].Escala_Linear_Ini) == 0)
                                        {
                                            switch (Convert.ToInt32(Model.Pesquisa.Perguntas[y].Escala_Linear_Fin))
                                            {
                                                case 5:
                                                    classeButton = (i <= 1 ? "red" : (i <= 3 ? "orange" : "green")) + (i <= 1 ? i : (i <= 3 ? (i + 2) : (i + 5)));
                                                    break;
                                                case 6:
                                                    classeButton = (i <= 2 ? "red" : (i <= 3 ? "orange" : "green")) + (i <= 2 ? i : (i <= 3 ? (i + 2) : (i + 4)));
                                                    break;
                                                case 7:
                                                    classeButton = (i <= 2 ? "red" : (i <= 4 ? "orange" : "green")) + (i <= 2 ? i : (i <= 4 ? (i + 1) : (i + 3)));
                                                    break;
                                                case 8:
                                                    classeButton = (i <= 2 ? "red" : (i <= 5 ? "orange" : "green")) + (i <= 2 ? i : (i <= 5 ? (i + 1) : (i + 2)));
                                                    break;
                                                case 9:
                                                    classeButton = (i <= 3 ? "red" : (i <= 6 ? "orange" : "green")) + i;
                                                    break;
                                                case 10:
                                                    classeButton = (i <= 3 ? "red" : (i <= 6 ? "orange" : "green")) + i;
                                                    break;
                                            }
                                        }
                                        else
                                        {
                                            switch (Convert.ToInt32(Model.Pesquisa.Perguntas[y].Escala_Linear_Fin))
                                            {
                                                case 5:
                                                    classeButton = (i <= 2 ? "red" : (i <= 3 ? "orange" : "green")) + (i <= 2 ? i : (i <= 3 ? (i + 2) : (i + 5)));
                                                    break;
                                                case 6:
                                                    classeButton = (i <= 2 ? "red" : (i <= 4 ? "orange" : "green")) + (i <= 2 ? (i + 1) : (i <= 4 ? (i + 2) : (i + 4)));
                                                    break;
                                                case 7:
                                                    classeButton = (i <= 3 ? "red" : (i <= 4 ? "orange" : "green")) + (i <= 3 ? (i) : (i <= 4 ? (i + 1) : (i + 3)));
                                                    break;
                                                case 8:
                                                    classeButton = (i <= 3 ? "red" : (i <= 5 ? "orange" : "green")) + (i <= 3 ? i : (i <= 5 ? (i + 1) : (i + 2)));
                                                    break;
                                                case 9:
                                                    classeButton = (i <= 3 ? "red" : (i <= 5 ? "orange" : "green")) + (i <= 3 ? i : (i + 1));
                                                    break;
                                                case 10:
                                                    classeButton = (i <= 3 ? "red" : (i <= 6 ? "orange" : "green")) + i;
                                                    break;
                                            }
                                        }

                                        <label for="idRadio_@i" class="btn button @classeButton" id="btn-@Model.Pesquisa.Perguntas[y].Id-@i" value="@i">
                                            @Html.RadioButtonFor(m => Model.Pesquisa.Perguntas[y].Resposta, i)<span>@i</span>
                                        </label>
                                    }
                                </div>
                            }
                            else if (Model.Pesquisa.Perguntas[y].Tipo_Resposta == Pesquisa_Tipo_Resposta.Unica_Escolha)
                            {
                                Int32 w = -1;
                                foreach (var respostaPossivel in Model.Pesquisa.Perguntas[y].Respostas_Possiveis.Split(';'))
                                {
                                    w++;
                                    <div class="form-inline mt-1">
                                        @Html.RadioButtonFor(model => Model.Pesquisa.Perguntas[y].Resposta, respostaPossivel, new { @class = "form-control", @id = "idRadio_" + w })
                                        <label for="idRadio_@w" class="pl-1 pr-1">@respostaPossivel</label>
                                    </div>
                                }

                            }
                            else if (Model.Pesquisa.Perguntas[y].Tipo_Resposta == Pesquisa_Tipo_Resposta.Multipla_Escolha)
                            {
                                Int32 z = -1;
                                var respostasPossiveis = Model.Pesquisa.Perguntas[y].Respostas_Possiveis.Split(';');
                                foreach (var respostaPossivel in respostasPossiveis)
                                {
                                    z++;

                                    <div class="form-inline mt-1">
                                        @Html.CheckBoxFor(model => Model.Pesquisa.Perguntas[y].Respostas[z], new { @class = "form-control", @id = "iCheck_" + z })
                                        <label for="iCheck_@z" class="pl-1 pr-1">@respostaPossivel</label>
                                        <br>
                                    </div>
                                }

                            }
                            else if (Model.Pesquisa.Perguntas[y].Tipo_Resposta == Pesquisa_Tipo_Resposta.Texto)
                            {
                                <div class="form-group mt-2">
                                    @Html.TextAreaFor(m => m.Pesquisa.Perguntas[y].RespostaTexto,
                                 new
                                 {
                                     @class = "form-control",
                                     @rows = "3",
                                     @placeholder = "Digite sua resposta aqui"
                                 })
                                </div>
                            }

                            else if (Model.Pesquisa.Perguntas[y].Tipo_Resposta == Pesquisa_Tipo_Resposta.Avaliacao_Emoticons)
                            {
                                <div class="btn-group btn-group-toggle btn-group-sm" data-toggle="buttons">
                                    <label class="btn em em-angry smile" data-toggle="tooltip" data-placement="top" title="Péssimo">
                                        @Html.RadioButtonFor(m => Model.Pesquisa.Perguntas[y].Resposta, "Péssimo")
                                    </label>
                                    <label class="btn em em-slightly_frowning_face smile" data-toggle="tooltip" data-placement="top" title="Ruim">
                                        @Html.RadioButtonFor(m => Model.Pesquisa.Perguntas[y].Resposta, "Ruim")
                                    </label>
                                    <label class="btn em em-neutral_face smile" data-toggle="tooltip" data-placement="top" title="Neutro">
                                        @Html.RadioButtonFor(m => Model.Pesquisa.Perguntas[y].Resposta, "Neutro")
                                    </label>
                                    <label class="btn em em-slightly_smiling_face smile" data-toggle="tooltip" data-placement="top" title="Bom">
                                        @Html.RadioButtonFor(m => Model.Pesquisa.Perguntas[y].Resposta, "Bom")
                                    </label>
                                    <label class="btn em em-smiley smile" data-toggle="tooltip" data-placement="top" title="Ótimo">
                                        @Html.RadioButtonFor(m => Model.Pesquisa.Perguntas[y].Resposta, "Ótimo")
                                    </label>
                                </div>
                                if (Model.Pesquisa.Perguntas[y].Escala_Emoticos == Padrao.Sim)
                                {
                                    <div class="form-group mt-2">
                                        @Html.TextAreaFor(m => m.Pesquisa.Perguntas[y].RespostaTextoEmoticon,
                                     new
                                     {
                                         @class = "form-control",
                                         @rows = "3",
                                         @placeholder = "Deixe aqui sua justificativa"
                                     })
                                    </div>
                                }
                            }
                        </div>
                    }

                    if (Model.Pesquisa.Tem_Caixa_Texto)
                    {
                        <div>

                            <h3>@(Model.Pesquisa.Perguntas.Count() + 1). Sugestões, Elogios e Críticas</h3>
                            <div class="form-group">

                                <div class="form-inline">
                                    @Html.RadioButtonFor(m => m.Categoria, PesquisaSatisfacaoCategoriaCaixaTexto.Sugestao, new { @id = "iradiosugestao" })
                                    <label for="iradiosugestao" class="pl-1 pr-1">@RsCadastros.SUGESTAO</label>

                                    @Html.RadioButtonFor(m => m.Categoria, PesquisaSatisfacaoCategoriaCaixaTexto.Elogio, new { @id = "iradioElogio" })
                                    <label for="iradioElogio" class="pl-1 pr-1">@RsCadastros.ELOGIO</label>

                                    @Html.RadioButtonFor(m => m.Categoria, PesquisaSatisfacaoCategoriaCaixaTexto.Critica, new { @id = "iradioCritica" })
                                    <label for="iradioCritica" class="pl-1 pr-1">@RsCadastros.CRITICA</label>
                                </div>

                                @if (Model.Pesquisa.TipoCaixaTexto == PesquisaSatisfacaoTipoCaixaTexto.Resposta_Longa)
                                {
                                    @Html.TextAreaFor(m => m.Comentario, new { @class = "form-control", @id = "iComentario", @rows = "3", @placeholder = "Deixe aqui sua opinião ou comentário", @style = "margin-top: 10px" })
                                }
                                else
                                {
                                    @Html.TextBoxFor(m => m.Comentario, new { @class = "form-control", @maxlength = "255", @id = "iComentario", @placeholder = "Deixe aqui sua opinião ou comentário", @style = "margin-top: 10px" })
                                }

                            </div>
                        </div>
                    }
                    if (Model.Pesquisa.Perguntas.Any(p => string.Equals(p.Tipo_Resposta.ToString(), "texto", StringComparison.OrdinalIgnoreCase)))
                    {

                        @Html.TextAreaFor(m => m.Comentario, new { @class = "form-control", @id = "iComentario", @rows = "3", @placeholder = "Deixe aqui sua opinião ou comentário", @style = "margin-top: 10px" })

                    }

                    <div class="text-center">
                        <button class="btn btn-lg btn-round send" onclick="return ValidaSubmit();">Enviar</button>
                    </div>
                }
            }

        </div>
    </div>

    <environment include="Development">
        <!--   Core JS Files   -->
        @*<script src="~/Content/pesquisaSatisf/jquery.min.js" type="text/javascript"></script>
            <script src="~/Content/pesquisaSatisf/popper.min.js" type="text/javascript"></script>
            <script src="~/Content/pesquisaSatisf/bootstrap-material-design.min.js" type="text/javascript"></script>*@
        @*<script src="~/Content/pesquisaSatisf/moment.min.js"></script>*@
        <!--	Plugin for the Datepicker, full documentation here: https://github.com/Eonasdan/bootstrap-datetimepicker -->
        @*<script src="~/Content/pesquisaSatisf/bootstrap-datetimepicker.js" type="text/javascript"></script>
            <script src="~/Content/pesquisaSatisf/material-kit.min.js" type="text/javascript"></script>*@
    </environment>

</div>