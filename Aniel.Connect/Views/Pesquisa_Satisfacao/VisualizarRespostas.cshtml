@model Aniel.Connect.Models.VisualizarRespostasModel

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Model.enumerado
@using Aniel.Connect.Core.Helpers

@{
    ViewBag.Title = "Visualizar Respostas";
    Layout = Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

<div style="padding:10px;">
    <div class="card" style="box-shadow: 0 8px 17px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.1); border:none; height: 95vh">
        <div class="card-body" style="padding-top: 0">
            <!--breadcrumb-->

            <div class="row" style="padding-top: 10px;">
                <div class="col">
                    <h4 class="title-page"><i class="fas fa-paste"></i> @ViewBag.Title </h4>
                    <nav aria-label="breadcrumb" style="font-size:12px">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index", "Cliente")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELCLIENTES</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("ClienteDadosGerais", "Cliente", new { Id = ViewBag.Id_Cliente })" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_CLIENTE</a>
                            </li>
                            <li class="breadcrumb-item">
                                <span>@ViewBag.Title</span>
                            </li>
                        </ol>
                    </nav>
                    <span style="font-size:11px;margin-left: 15px;" id="dtLegend"></span>
                </div>
            </div>

            <!--main-->
            <span class="col-12 pt-2 pl-3">

                <div class="col pb-4">
                    <div class="row">
                        <span style="font-size: 16px; font-weight: bold">@Model.Titulo_Pesquisa</span>
                    </div>
                    <div class="row">
                        @if (ViewBag.Cliente_Preenche)
                        {
                            <span style="font-size: 12px"> Pesquisa enviada para o e-mail do cliente @ViewBag.Quem_Respondeu </span>
                        }
                        else
                        {
                            <span style="font-size: 12px"> Pesquisa preenchida pelo atendente @ViewBag.Quem_Respondeu </span>
                        }
                    </div>
                </div>

                @{
                    int count_multipla_escolha = 0;
                    for (int y = 0; y < Model.Perguntas.Count(); y++)
                    {
                        string id_elem_resposta = String.Format("Resposta_{0}", Model.Perguntas[y].Id);

                        if (y != 0)
                        {
                            if (Model.Perguntas[y].Id != Model.Perguntas[y - 1].Id)
                            {
                                <div class="col @((y + 1 == Model.Perguntas.Count()) ? "mt-2" : "mb-2")">

                                    <div class="row" style="font-size: 16px; font-weight: bold"> @((y + 1) - count_multipla_escolha). @Model.Perguntas[y].Descricao </div>

                                    <div class="row" style="font-size: 12px">
                                        <span id="@id_elem_resposta">Resposta do Cliente: @Model.Perguntas[y].Resposta</span>
                                    </div>

                                </div>
                            }
                            else
                            {

                                count_multipla_escolha++;


                                <script>
                                    var resp_mulit_escolha = document.getElementById('@id_elem_resposta');
                                    resp_mulit_escolha.innerHTML += ", @Model.Perguntas[y].Resposta";
                                </script>
                            }
                        }
                        else
                        {
                            <div class="col @((y + 1 == Model.Perguntas.Count()) ? "mt-2" : "mb-2")">

                                <div class="row" style="font-size: 1rem; font-weight: bold"> @(y + 1). @Model.Perguntas[y].Descricao </div>

                                <div class="row" id="@id_elem_resposta" style="font-size: 0.8rem">
                                    Resposta do Cliente: @Model.Perguntas[y].Resposta
                                </div>

                            </div>
                        }
                    }

                    if (!String.IsNullOrEmpty(Model.Comentario_Cliente))
                    {
                        <div class="col mt-2">

                            <div class="row" style="font-size: 1rem; font-weight: bold"> Comentário do Cliente </div>

                            <div class="row" style="font-size: 0.8rem">
                                @HtmlEnumExtensions.GetEnumDescription(Model.Categoria_Comentario): @Model.Comentario_Cliente
                            </div>

                        </div>
                    }
                }

</div>

        </div>
    </div>
</div>
