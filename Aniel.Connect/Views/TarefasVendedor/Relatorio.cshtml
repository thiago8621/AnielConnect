@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Relatorio";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />

}

@section scripts{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {

            $('#iDataInicio').val("");
            $('#iDataFim').val("");
            carregaSelect2();
            if (oDatatable != null)
            {
                oDatatable.draw()
            }
        })

        var oDatatable;
        var rows_selected = []
        var filter_state = {
            periodo: {
                label: "@RsFinanceiro.PERIODO",
                getDisplay: () => {

                    return Boolean($('#iDataInicio').val()) ? $('#iDataInicio').val() + " a " + $('#iDataFim').val() : ""

                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            tarefa: {
                label: "Tipo de Tarefa",
                getDisplay: () => { return Boolean($('#iTipoTarefa').val()) ? $('#iTipoTarefa option:selected').text() : "" },
                onclick: () => {
                    $('#iTipoTarefa').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            venda: {
                label: "Venda",
                getDisplay: () => { return Boolean($('#iVenda').val()) ? $('#iVenda option:selected').text() : "" },
                onclick: () => {
                    $('#iVenda').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            prioridade: {
                label: "Prioridade",
                getDisplay: () => { return Boolean($('#iPrioridade').val()) ? $('#iPrioridade option:selected').text() : "" },
                onclick: () => {
                    $('#iPrioridade').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            vendedor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iVendedor').val()) ? $('#iVendedor option:selected').text() : "" },
                onclick: () => {
                    $('#iVendedor').val(null).trigger("change")
                    oDatatable.draw()
                }
            }
        }

        function selecionaLinha(id) {
            console.log(id)
        }

        const datatable_columns = [
            {
                data: "id",
                title: "",
                orderable: false,
                render: function (data, type, row, meta) {
                return `<input type='checkbox'>`;
                }
            },
            { data: "tipoTarefa", className: "text-center", title: "Tipo Tarefa", orderable: false, visible: true },
            { data: "venda", className: "text-center", title: "Venda Vinculada", orderable: false },
            { data: "assunto", className: "text-center", title: "Assunto", orderable: false },
            { data: "dataInicio", className: "text-center", title: "Data início", orderable: false },
            { data: "dataFim", className: "text-center", title: "Data fim", orderable: false },
            { data: "horarioInicio", className: "text-center", title: "Horário início", orderable: false },
            { data: "horarioFim", className: "text-center", title: "Horário fim", orderable: false },
            { data: "local", className: "text-center", title: "Local", orederable: false },
            {
                data: "observacao", className: "text-center", title: "Observação", orderable: false,
                render: function (data, type, row, meta) {
                    return `<i class="fa fa-envelope" onclick="abreObservacao('${data}')"></i>`;
                }
            },
            { data: "prioridade", className: "text-center", title: "Prioridade", orderable: false }
        ];

        $(document).ready(async () => {
            $('#modal-filter').modal('show')
            carregaSelect2()
        })

        function abreObservacao(observacao) {
            Swal.fire({
                title: 'Observação',
                html: `</br><textarea style="resize:none" readonly class="form-control">${observacao}</textarea></br>`,
                showCancelButton: false
            })
        }

        function oDatatableFunction() {

            if (oDatatable == null) {
                oDatatable = $("#datatable").DataTable({
                    dom: "Bfrti",
                    select: {
                        style: 'multi'
                    },
                    columnDefs: [
                        {
                            data: "id",
                            targets: 0,
                            searchable: false,
                            orderable: false,
                            width: '1%',
                            className: 'dt-body-center',
                            render: function (data, type, full, meta) {
                                console.log(data, type, full, meta)
                                return "<input type='checkbox'></input>";
                            }
                        }
                    ],
                    serverSide: true,
                    searching: true,
                    ordering: false,
                    paging: false,
                    deferRender: true,
                    scrollResize: true,
                    scrollY: '66vh',
                    stateSave: true,
                    scrollX: true,
                    fixedHeader: true,
                    drawCallback: () => {

                        TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                        ResizeTable('divTable');
                    },
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: '@CONSTANTES.URLPortal/api/TarefasVendedorApi/Relatorio',
                        type: 'POST',
                        async: false,
                        data: function (data) {
                            data.dataInicio = $('#iDataInicio').val();
                            data.dataFim = $("#iDataFim").val();
                            data.tipoTarefa = $("#iTipoTarefa").val();
                            data.venda = $("#iVenda").val();
                            data.prioridade = $("#iPrioridade").val();
                            data.vendedor = $("#iVendedor").val();
                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
                    },
                    pageLength: 5,
                    order: [],
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTableRelatorio({
                        title: "@Html.Raw(ViewBag.Title)",
                        pageSize: GetPageSizePDF(datatable_columns)
                    }),
                    columns: datatable_columns
                });
            }
            else {
                oDatatable.draw()
            }

            // Handle click on checkbox
            $('#datatable tbody').one('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                e.stopPropagation();
            });

        }

        function carregaSelect2() {
            AddSelect("iTipoTarefa", "@CONSTANTES.URLPortal/api/TipoTarefaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iVenda", "@CONSTANTES.URLPortal/api/Vendaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iVendedor", "@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboVendedor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iPrioridade", "@CONSTANTES.URLPortal/api/TipoTarefaApi/GetComboPrioridade", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }

        function abrirDialogReabrir() {
            if (!rows_selected.length <= 0) {
                Swal.fire({
                    text: "Deseja reabrir as tarefas selecionadas ?",
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#00FF00',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sim',
                    cancelButtonText: 'Não'
                }).then((result) => {
                    if (result.value) {
                        $.ajax({
                            type: "POST",
                            url: "@CONSTANTES.URLPortal/api/TarefasVendedorApi/Reabrir",
                            dataType: "json",
                            contentType: "application/json; charset=utf-8",
                            data: JSON.stringify({
                                ids: rows_selected
                            }),
                            success: function (response) {
                                Notificar("@RsBase.ATENCAO_", "Tarefas reabertas", "success");
                                oDatatable.draw();
                            }
                        })
                    }
                })
            }
            else {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "warning");
            }
        }

    </script>

}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-cogs"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "TarefasVendedor")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">Agenda Vendedor/Supervisor</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">


                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="abrirDialogReabrir(); return false;"><i class="fas fa-check"></i> Reabrir Tarefas</a>
                </div>

            </div>
        </div>

    </div>
    <div id="divSubTitle">
        <div id="FiltrosUtilizados" class="mr-2 ml-2 form-inline"></div>
        <div class="mr-2 ml-2 form-inline mt-1 fs-12">@(String.Format(RsFinanceiro.EMITIDO_POR_EM_AS, User.Identity.GetUserName(), DateTime.Now.ToString("dd/MM/yyyy"), DateTime.Now.ToString("HH:mm")))</div>
    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog modal-m">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="form-group border_radius">
                    <div class="row">
                        <div class="col form-inline text-center mt-1" style="display:block">
                            <input class="form-control obrigatorio datepicker-period mb-1"
                                   id="iDataInicio"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />

                            <span class="pl-3 pr-3">@RsBase.A</span>

                            <input class="form-control obrigatorio datepicker-period  mb-1"
                                   id="iDataFim"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iContrato">Tipo Tarefa:</label>
                            <select class="form-control" id="iTipoTarefa"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iProjeto">Venda:</label>
                            <select class="form-control" id="iVenda"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">Vendedor:</label>
                            <select class="form-control" id="iVendedor"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iEquipe">Prioridade:</label>
                            <select class="form-control" id="iPrioridade"></select>
                        </div>
                    </div>
                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatableFunction(); $('#modal-filter').modal('hide');" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->