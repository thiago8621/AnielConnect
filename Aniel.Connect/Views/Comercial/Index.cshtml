@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.COMERCIAL;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}


<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page"><i class="fas fa-cog"></i> @ViewBag.Title</h4>
        </div>
    </div>

    <div class="row" style="padding-left: 35px;">
        @if (AcessoHelper.TemAcessos(_areas, "25", "13", "46", "52", "82", "80"))
        {

            <div class="col-sm-3">
                <div class="row">
                    <i class="fas fa-file-alt" style="margin-top: 16px;"></i>
                    <p class="pConfig mt-3"><u>@RsCadastros.CADASTRO</u></p>
                </div>
                <div class="text-left">
                    <ul class="ulConfig">
                        @if (AcessoHelper.TemAcesso(_areas, "25"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "Cliente_Prospecto")" onclick="ShowPageLoading(); return true;" class="aConfig">@RsCadastros.CADASTRO_LEAD</a></li>
                        }

                        @if (AcessoHelper.TemAcesso(_areas, "13"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "Campanha")" onclick="ShowPageLoading(); return true;" class="aConfig">@RsCadastros.CADASTROCAMPANHA</a></li>
                        }

                        @if (AcessoHelper.TemAcesso(_areas, "46"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "Funcionario")" onclick="ShowPageLoading(); return true;" class="aConfig">@RsCadastros.CADASTRO_VENDEDOR</a></li>
                        }

                        @if (AcessoHelper.TemAcesso(_areas, "52"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "Meta")" onclick="ShowPageLoading(); return true;" class="aConfig">@RsCadastros.CADASTRO_META</a></li>
                        }

                        @if (AcessoHelper.TemAcesso(_areas, "82"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "Ponto_Venda")" onclick="ShowPageLoading(); return true;" class="aConfig">@RsCadastros.CADASTRO_PONTO_VENDA</a></li>
                        }

                        @if (AcessoHelper.TemAcesso(_areas, "223"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "Workflow_Vendas")" onclick="ShowPageLoading(); return true;" class="aConfig">@RsCadastros.WORKFLOW_VENDAS</a></li>
                        }

                        @if (AcessoHelper.TemAcesso(_areas, "209"))
                        {
                            <li class="liConfig"><a class="aConfig" href="@Url.Action("Index","Portabilidade")" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_PORTABILIDADE</a></li>
                        }

                    </ul>
                </div>
            </div>
        }
        @if (AcessoHelper.TemAcessos(_areas, "122", "123", "351", "379", "380", "352"))
        {
            <div class="col-sm-3">
                <div class="row">
                    <i class="fas fa-briefcase" style="margin-top: 16px;"></i>
                    <p class="pConfig mt-3"><u>@RsCadastros.GESTAO_VENDAS</u></p>
                </div>
                <div class="text-left">
                    <ul class="ulConfig">
                        @if (AcessoHelper.TemAcesso(_areas, "122"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "Venda")" onclick="ShowPageLoading(); return true;" class="aConfig">@RsCadastros.PAINEL_VENDAS</a></li>
                        }

                        @if (AcessoHelper.TemAcesso(_areas, "123"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Dashboard_Vendas", "Venda")" onclick="ShowPageLoading(); return true;" class="aConfig">@RsCadastros.DASHBOARD_VENDEDOR</a></li>
                        }

                        @if (AcessoHelper.TemAcesso(_areas, "379"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "Viabilidade")" onclick="ShowPageLoading(); return true;" class="aConfig">@RsCadastros.CONSULTA_VIABILIDADE</a></li>
                        }

                        @if (AcessoHelper.TemAcesso(_areas, "380"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "TarefasVendedor")" onclick="ShowPageLoading(); return true;" class="aConfig">Agenda Vendedor/Supervisor</a></li>

                        }

                        @if (AcessoHelper.TemAcesso(_areas, "352"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "EtapasVenda")" onclick="ShowPageLoading(); return true;" class="aConfig">@RsCadastros.PAINEL_ETAPAS_VENDA</a></li>
                        }

                        //comentado porque foi adiado para proxima versão
                        @*@if (AcessoHelper.TemAcesso(_areas, "409"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "AlteracaoPlanoContrato")" onclick="ShowPageLoading(); return true;" class="aConfig">@RsCadastros.ALTERACAO_PLANO_CONTRATO</a></li>
                        }*@

                        
                        @if (AcessoHelper.TemAcesso(_areas, "401"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Index", "TrocaTitularidade")" onclick="ShowPageLoading(); return true;" class="aConfig">@RsCadastros.TROCA_TITULARIDADE</a></li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
                </div>
