@model Aniel.Connect.Models.Categoria_AtendimentoCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_CATEGORIA_ATENDIMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script>
        var clicked = false;
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

    </script>
}


@using (Html.BeginForm("Cadastro", "Categoria_Atendimento", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-list-ol"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Categoria_Atendimento")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_CATEGORIA_ATENDIMENTO</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        @*<span style="font-size:11px" id="dtLegend"></span>*@
                    </div>
                </div>



                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>

                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="row mt-2 mb-2">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iCodigo" class="mr-3">@RsFinanceiro.CODIGO:</label>
                                        @Html.TextBoxFor(model => model.Codigo, new { @class = "form-control", @id = "iCodigo", @autocomplete = "off", @readonly = "readonly" })
                                        @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-7">
                                    <div class="form-group">
                                        <label for="iDescricao" class="mr-3">@RsFinanceiro.DESCRICAO:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off", @required = true })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                @if (Model.Id != 0)
                                {
                                    <div class="col-sm-3 pt-3">
                                        <div class="form-group">
                                            <label for="iSaldo_Caixa" class="mr-3">@RsFinanceiro.STATUS:</label>
                                            @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Categoria_Atendimento")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}