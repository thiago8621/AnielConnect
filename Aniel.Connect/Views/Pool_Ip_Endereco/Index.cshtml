@model Aniel.Connect.Models.Pool_Ip_EnderecoModels
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.LISTAGEM_IP;
    ViewBag.Sessao = RsCadastros.LISTAGEM_IP;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")

    <script>

        var rows_selected = [];
        let tem_login_vinculado = [];
        let oDatatable;

        var HandleConcentradora = function () {            
            $('#iConcentradora').on('select2:select select2:unselecting', function (e) {     
                if (e.params.data != undefined) {
                    AddSelect("iPoolIp", "@CONSTANTES.URLPortal/api/pool_Ipapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, e.params.data.id, null, "@RsBase.SELECIONE", false);    
                } 
                else{
                    AddSelect("iPoolIp", "@CONSTANTES.URLPortal/api/pool_Ipapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);  
                }
                return true
            });                   
        }

        $(document).ready(function() {
            AddSelect("iPoolIp", "@CONSTANTES.URLPortal/api/pool_Ipapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.INDIFERENTE", false);
            AddSelect("iConcentradora", "@CONSTANTES.URLPortal/api/ConcentradoraApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.INDIFERENTE", HandleConcentradora);
        });

        $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {
            $("#iPoolIp").val(null).trigger('change');
            $("#iStatus").val("");
            $("#iConcentradora").val(null).trigger('change');            
            $('#txtSearch').val("");

            rows_selected = [];
            oDatatable.search($('#txtSearch').val()).draw();
        });

        $("#iPesquisar").on("click", function () {
            $("#modal-filter").modal('hide');
            rows_selected = [];
            oDatatable.search($('#txtSearch').val()).draw();

            return true;
        });

        var handleDataTableButtons = function () {
            "use strict";

            function AlterarStatusObj(Status) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Pool_Ip_Enderecoapi/AlterarStatus")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected,
                        status: Status
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });
                HidePageLoading();
                rows_selected = [];
            }

            $("#iPesquisar").on("click", function () {
            $("#modal-filter").modal('hide');
            rows_selected = [];
            oDatatable.search($('#txtSearch').val()).draw();

            return true;
        });

            //"Blfrtip"
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '79vh',
                /*scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },*/
                //stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + "/api/Pool_Ip_Enderecoapi/GetAll",
                    type: 'POST',
                    data: function (data) {
                        // Read values
                        var concentradora = $("#iConcentradora option:selected").val();
                        var status = $("#iStatus option:selected").val();
                        var pool_ip = $("#iPoolIp option:selected").val();

                        // Append to data
                        data.status_Ip = status;
                        data.id_Concentradora = concentradora;
                        data.id_Pool_Ip = pool_ip;
                        data.search.option = $("#optionSearch").val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    @*{ data: "id", title: "@RsCadastros.CODIGO" },*@
                    { data: "ip", title: "@RsCadastros.IP" },
                    { data: "desc_Pool_Ip", title: "@RsCadastros.POOL_IP" },
                    {
                        data: "desc_Status_Ip", title: "@RsCadastros.STATUS",
                        render: function (data, type, row, meta) {
                            if (data === "Indisponivel") return '<i class="text-danger">' + data + '</i>';
                            else if(data === "Ocupado") return '<i class="text-warning">' + data + '</i>';
                            else return '<i style="color:limegreen">' + data + '</i>';
                        }
                    },
                    {
                        data: "usuario_Login_Radius", title: "@RsCadastros.LOGIN_DO_RADIUS",
                        render: function (data, type, row, meta) {
                            if (data == null || data == undefined || data.length == 0) {
                                return '<a href="#" id_ip="' + row.id + '" class="btnLogin" id="btnVincularLogin_' + row.id + '"><i class="fas fa-key mr-2" style="font-size:16px;padding-right:2px;"></i></a>';
                            }
                            else return data;
                        }
                    },
                    { data: "ip_Concentradora", title: "@RsCadastros.CONCENTRADORA" },
                    { data: "mac", title: "@RsCadastros.MAC" },
                    { data: "conexao", title: "@RsCadastros.TIPO_CONEXAO" }
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });

            $('#iLimparFiltro').on('click', function () {

                $('#txtSearch').val('');
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
            });


            $("#btnBloquearIp").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    HidePageLoading();
                    return;
                }

                if (tem_login_vinculado.length > 0) {
                    Notificar("@RsBase.ATENCAO_", "Só é permitido bloquear IPs sem login vinculado", "info");
                    HidePageLoading();
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(2);

            });

            $("#btnDesbloquearIp").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    HidePageLoading();
                    return;
                }

                if (tem_login_vinculado.length > 0) {
                    Notificar("@RsBase.ATENCAO_", "Só é permitido desbloquear IPs sem login vinculado", "info");
                    HidePageLoading();
                    return;
                }

                //Alterando para Ativo
                AlterarStatusObj(1);
            });

            $("#btnDesvincularLogin").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    HidePageLoading();
                    return;
                }

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Pool_Ip_Enderecoapi/DesvincularLoginRadius")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });

                rows_selected = [];
                HidePageLoading();
            });

            $("#btnExcluir").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Pool_Ip_Enderecoapi/excluirlista")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    const login = oDatatable.row($row).data().usuario_Login_Radius;
                    if (login != null && login != undefined && login.length > 0) {
                        tem_login_vinculado.push(true);
                    }


                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);

                    const login = oDatatable.row($row).data().usuario_Login_Radius;
                    if (login == null || login == undefined || login.length > 0) {
                        tem_login_vinculado.splice(index, 1);
                    }
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle btn login event
            $('#datatable tbody').on('click', '.btnLogin', function (e) {

                var id = $(this).attr("id_ip");
                var HandleLoginCliente = function () {
                    //Pool Vinculado
                    $('#iLoginCliente').on('select2:select select2:unselecting', function (e) {
                        if (e.params.data != undefined) {
                            AddSelect("iLoginPlanoProduto", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboVinculoLoginRadius", @CONSTANTES.PaginacaoRegistros, null, e.params.data.id, null, "@RsBase.SELECIONE", false);
                        }
                        return true;
                    });
                }

                $('#modal-loginradius').modal('show');
                {
                    AddSelect("iLoginCliente", "@CONSTANTES.URLPortal/api/clienteapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleLoginCliente);

                    $("#btnVincularLoginIp").click(function (e) {
                        ShowPageLoading();

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/pool_Ip_Enderecoapi/VincularLoginRadius")';
                        $.ajax({
                            url: link,
                            type: 'POST',
                            dataType: 'json',
                            data: {
                                Id_Ip: id,
                                Id_Cliente: $('#iLoginCliente option:selected').val(),
                                Id_ClientePlanoProduto: $('#iLoginPlanoProduto option:selected').val()
                            }
                        })
                            .done(function (data) {
                                if (data.ok) {
                                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");

                                    //var dataFormaTemp = oDatatable.row(novaFormaPagamentoCliente).data();
                                    //dataFormaTemp.Id = data.idObjeto;
                                    //oDatatable.row(novaFormaPagamentoCliente).data(dataFormaTemp).draw();
                                    oDatatable.draw();
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }

                                $('#iLoginCliente').val('').trigger('change');
                                $('#iLoginPlanoProduto').val('').trigger('change');
                                $('#modal-loginradius').modal('hide');
                                HidePageLoading();
                            });



                        e.stopPropagation();
                        $("#btnVincularLoginIp").unbind("click");
                    });
                }

                e.stopPropagation();
            });

            $('#datatable tbody').on('click', 'tr', function () {

            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

    </script>
}



<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page"><i class="fas fa-digital-tachograph"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GERENCIAMENTO_REDE</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>

                </ol>
            </nav>

            @*<span style="font-size:11px" id="dtLegend"></span>*@
        </div>


        <div class="col-auto mb-3">
            <div class="row title-page">
                <div class="form-inline pl-4 pr-2">
                    <select class="form-control" id="optionSearch">
                        <option value="ip">@RsCadastros.ENDERECO_IP</option>
                        <option value="login">@RsCadastros.LOGIN_DO_RADIUS</option>
                        <option value="pool_ip">@RsCadastros.POOL_IP</option>
                        <option value="mac">@RsCadastros.MAC</option>
                    </select>
                    <input type="text" class="input-search" id="txtSearch" placeholder="Digite aqui pra busca rápida" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
                @if (AcessoHelper.TemAcesso(_areas, "65"))
                {
                    <a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "Pool_Ip")" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>
                }
                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" id="btnCadastroLogin" href="@Url.Action("Cadastro", "LoginRadius")" onclick="ShowPageLoading(); return true;">@RsCadastros.CADASTRO_LOGIN</a>
                    <a class="dropdown-item" id="btnDesvincularLogin" href="#" onclick="ShowPageLoading(); return true;">@RsCadastros.DESVINCULAR_LOGIN</a>
                    <a class="dropdown-item" id="btnBloquearIp" href="#" onclick="ShowPageLoading(); return true;">@RsCadastros.BLOQUEAR_IP</a>
                    <a class="dropdown-item" id="btnDesbloquearIp" href="#" onclick="ShowPageLoading(); return true;">@RsCadastros.DESBLOQUEAR_IP</a>
                </div>
            </div>
        </div>

    </div>

    <!--./main-->
</div>
<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>

<div class="modal" id="modal-loginradius">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted pr-2">@RsCadastros.VINCULAR_LOGIN</h4>
                <i class="fas fa-key mt-1"></i>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row mb-5">

                    <div class="col-sm-8 container" style="align-content:center;">


                        <div class="form-group">
                            <label for="iLoginCliente">@RsCadastros.CLIENTE:</label>
                            <select class="form-control" id="iLoginCliente">
                                <option value="" selected>Selecione</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="iLoginPlanoProduto">@RsCadastros.PLANO_PRODUTO</label>
                            <select class="form-control" id="iLoginPlanoProduto">
                                <option value="" selected>Selecione</option>
                            </select>
                        </div>
                    </div>
                </div>


                <div class="form-group mt-4">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" data-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-success ml-2" id="btnVincularLoginIp">Vincular</button>
                    </div>
                </div>

            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->

<!--Modal Filters-->
<div class="modal" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iStatus">Status:</label>
                            <select class="form-control" id="iStatus">
                                <option value="" selected>@RsBase.TODOS</option>
                                <option value="0">@RsCadastros.OCUPADO</option>
                                <option value="1">@RsCadastros.DISPONIVEL</option>
                                <option value="2">@RsCadastros.INDISPONIVEL</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iPoolIp">@RsCadastros.POOL_IP:</label>
                            @Html.DropDownList("PoolIp", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iPoolIp", @autocomplete = "off" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iConcentradora">@RsCadastros.CONCENTRADORA:</label>
                            @Html.DropDownList("Concentradora", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iConcentradora", @autocomplete = "off" })
                        </div>
                    </div>
                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
