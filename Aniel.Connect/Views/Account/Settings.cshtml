@model Aniel.Connect.Models.SettingsViewModel

@{
    ViewBag.Title = RsBase.CONFIGURACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    var culture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name.ToLowerInvariant();
}

<div class="main-bar">
    <div class="col-md-8">
        <h3>
            <i class="fa fa-pencil-square-o"></i>&nbsp; @ViewBag.Title
        </h3>
    </div>
    <div class="col-md-4">
        &nbsp; <!--Menu Aqui-->
    </div>
    <div class="col-md-12">
        <hr />
    </div>
</div>

@using (Html.BeginForm("SetCulture", "Account"))
{
    @Html.AntiForgeryToken()
    <div class="col-md-12 col-sm-12 col-xs-12" style="padding:0px;">
        <div class="x_panel">
            <div class="x_title">
                <ul class="nav navbar-right panel_toolbox">
                    <!--<li>
                        Html.NoEncodeActionLink("<span class='fa fa-plus'></span>", RsBase.NOVO, "Edit", "EmpresaTelefone", routeValues: new { IdPai = ViewBag.IdPai }, htmlAttributes: new { data_modal = "", class = "" })
                    </li>-->
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                    <!--<li>
                        <a class="close-link"><i class="fa fa-close"></i></a>
                    </li>-->
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                @helper selected(string c, string culture)
                {
                    if (culture.Contains(c))
                    {
                        @:checked="checked"
                    }
                }

                <div id="replacetarget">
                    <fieldset>
                        <div class="control-group">
                            <div class="controls">
                                <label for="pt">
                                    <input name="culture" id="pt" value="pt" type="radio" @selected("pt", culture) /> Portugues
                                </label>
                            </div>
                        </div>
                        <div class="control-group">
                            <div class="controls">
                                <label for="en">
                                    <input name="culture" id="en" value="en" type="radio" @selected("en", culture) /> English
                                </label>
                            </div>
                        </div>
                        <div class="control-group">
                            <div class="controls">
                                <label for="es">
                                    <input name="culture" id="es" value="es" type="radio" @selected("es", culture) /> Español
                                </label>
                            </div>
                        </div>
                    </fieldset>

                </div>
            </div>
        </div>
    </div>

}

@section Scripts {
    @Styles.RenderFormat(SiteKeys.ScriptVersion,"~/bundles/jqueryval")

    <script type="text/javascript">
        (function ($) {
            $("input[type = 'radio']").click(function () {
                $(this).parents("form").submit(); // post form
            });

        })(jQuery);
    </script>
}