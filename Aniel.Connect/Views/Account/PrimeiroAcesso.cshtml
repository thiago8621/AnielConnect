@using Aniel.Connect.Models;
@using Microsoft.AspNet.Identity;
@model Aniel.Connect.Models.PrimeiroAcessoViewModel

@{
    ViewBag.Title = RsBase.PRIMEIROACESSO;
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

@using (Html.BeginForm("PrimeiroAcesso", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{

    @Html.AntiForgeryToken()

    <h1>@ViewBag.Title</h1>
    @Html.ValidationSummary(true)
    <div>
        @RsBase.OBSPRIMEIROACESSO
    </div>
    <div>
        @Html.TextBoxFor(m => m.Login, new { @class = "form-control", @autocomplete = "new-password", @placeholder = RsBase.LOGIN })
        @Html.ValidationMessageFor(m => m.Login)
    </div>
    <div>
        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", @autocomplete = "new-password", @placeholder = RsBase.NEWPASSWORD })
        @Html.ValidationMessageFor(m => m.NewPassword)
    </div>
    <div>
        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @autocomplete = "new-password", @placeholder = RsBase.CONFIRMACAO })
        @Html.ValidationMessageFor(m => m.ConfirmPassword)
    </div>
    <div>
        <input type="submit" value="@RsBase.CONFIGURARPASSWORD" class="btn btn-primary btn-block" />
    </div>
    <div class="clearfix"></div>
    <div class="separator">
        <div>
            <h1><i class="fa fa-cloud" style="font-size: 26px;"></i> @RsBase.APPLICATIONNAME</h1>
            <p>@RsBase.TODOSDIREITOSRESERVADOS</p>
        </div>
    </div>
}