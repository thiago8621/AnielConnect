@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Aniel.Connect.Models
@{
    ViewBag.Title = "Listagem de Segmentos";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles {
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}


@section scripts {
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
<script>

    var rows_selected = [];

        var handleDataTableButtons = function () {
            "use strict";

            function AlterarStatusObj(Status) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Segmentoapi/AlterarStatus")';
                let statusCode = Status;
                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        cods: rows_selected,
                        status: Status
                    }
                })
                    .done(function (data) {
                        if (data.ok && statusCode == 0) {
                            Notificar("@RsBase.ATENCAO_", "@RsBase.SEGMENTO_ALERTA_INATIVO", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else if (data.ok && statusCode == 1) {
                            Notificar("@RsBase.ATENCAO_", "@RsBase.SEGMENTO_ALERTA_ATIVO", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });

                rows_selected = [];
            }

        var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + "/api/Segmentoapi/GetAll",
                    type: 'POST',
                    data: function (data) {
                        let status = $("#iSeleciona option:selected").val();
                        data.Status = status;
                        data.search.option = $("#optionSearch").val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iTotal).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                    // Get row ID
                    var rowCodigo = data.codigo;

                     // If row ID is in the list of selected row IDs
                    if ($.inArray(rowCodigo, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    {   title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "codigo", title: "@RsCadastros.CODIGO" },
                    { data: "descricao", title: "@RsCadastros.DESCRICAO" },
                    { data: "status", title: "@RsCadastros.STATUS" }
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });


            $("#iPesquisar").on("click", function () {
                $("#Modal").modal('hide');

                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();

                return true;
            });

            $("#iLimparFiltroModal").on("click", function () {
                $("#iSeleciona").val("");
                $('#txtSearch').val("");

                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
            });

            $("#btnInativar").on("click", function () {

             if (rows_selected.length == 0) {
                 Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                 return;
             }

             //Alterando para Inativo
             AlterarStatusObj(0);

             });

            $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });



            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');


                var rowCodigo = oDatatable.row($row).data().codigo;

                var index = $.inArray(rowCodigo, rows_selected);


                if (this.checked && index === -1) {
                    rows_selected.push(rowCodigo);

                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function () {
                @if(AcessoHelper.TemAcesso(_areas, "326"))
                    {
                     <text>
                        if (oDatatable.row(this).data() != null)
                        {
                           var _codigo = oDatatable.row(this).data().codigo;
                           var url = '@Url.Action("Cadastro", "Segmento", new { codigo = "__codigo__" })';
                           window.location.href = url.replace('__codigo__', _codigo);
                           ShowPageLoading();
                         }
                     </text>
                    }

            });

            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();


</script>
}


<div class="container-fluid" id="divTitle">
    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page"><i class="fas fa-list"></i> @ViewBag.Title</h4>
            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>
        </div>

        <div class="col-auto">
            <div class="row title-page">
                <div class="pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.DESCRICAO" autocomplete="off" />
                    <i class="la la-search la-2x" style="color:#999"></i>
                </div>

                @if (AcessoHelper.TemAcesso(_areas, "325"))
                {
                <a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "Segmento")" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color:#fff"></i></a>
                }

                <button type="button" class="btn btn-default btn-add" data-toggle="modal" data-target="#Modal" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button type="button" class="btn btn-default btn-add" id="iLimparFiltroModal" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>


                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    @if (AcessoHelper.TemAcesso(_areas, "327"))
                    {
                    <a class="dropdown-item" id="btnInativar" href="#" onclick="return false;">@RsBase.INATIVAR</a>
                    <a class="dropdown-item" id="btnAtivar" href="#" onclick="return false;">@RsBase.ATIVAR</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
        <thead class="tb-head">

        </thead>
    </table>
</div>


<!-- Modal -->
<div class="modal fade" id="Modal" tabindex="-1" role="dialog" aria-labelledby="ModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="ModalLabel"><b>Filtro</b></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <h4>@RsCadastros.STATUS</h4>
                <select class="form-control" id="iSeleciona" style="width:100%">
                    <option value="" selected>Todos</option>
                    <option value="0">Inativos</option>
                    <option value="1">Ativos</option>
                </select>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="submit" class="btn btn-success" id="iPesquisar">Filtrar</button>
            </div>
        </div>
    </div>
</div>