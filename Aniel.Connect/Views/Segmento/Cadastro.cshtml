@model Aniel.Connect.Models.Segmento_CadastroModel
@using Aniel.Connect.Models.T5
@using Aniel.Connect.Core.Helpers

@{
    ViewBag.Title = "Cadastro de Segmento";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

    @if (@Model.Codigo == null)
    {
        <text>
            <script>
                $("#iStatus").val(true);
                $("#divStatus").hide();

                $(document).ready(function () {
                    $("#iStatus").prop("checked", true);
                });
            </script>
        </text>
        Model.Codigo = null;
    }
    else
    {
<script>
    $(document).ready(function () {
        $("#iCodigo").attr("readonly", "readonly");
        $("#divStatus").show();
    });

</script>
    }

    <script>
        var clicked = false;
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

    </script>
}


@using (Html.BeginForm("Cadastro", "Segmento", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-list"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Segmento")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">Listagem de Segmentos</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>
                    </div>
                </div>
                <div class="card div-card-accord">
                    <div class="title-card" id="heading-1">
                    </div>
                    <div class="card-body body-card-accord">
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group" id="iCodigoAble">
                                    <label for="iCodigo"><span class="text-danger">*</span>Código: </label>
                                    @Html.TextBoxFor(model => model.Codigo, new { @class = "form-control", @id = "iCodigo", @autocomplete = "off", @required = true })
                                    @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iDescricao"><span class="text-danger">*</span>Descrição do Segmento: </label>
                                    @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off", @required = true })
                                    @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-sm-2" id="divStatus">
                                <div class="form-group">
                                    <label for="iStatus">@RsFinanceiro.STATUS:</label><br />
                                    @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_off = RsBase.INATIVAR, @data_on = RsBase.ATIVAR, @data_onstyle = "success", @data_offstyle = "light" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Segmento")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}