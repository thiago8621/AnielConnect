@model Aniel.Connect.Models.MapaModelView

@{
    ViewBag.Title = "Popup";
    Layout = "~/Views/Shared/_LayoutZero.cshtml";
}

@section scripts
{
    <script type="text/javascript" src="https://maps.google.com/maps/api/js?language=pt&region=BR&key=@CONSTANTES.TokenGoogleAPI"></script>
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/Scripts/maps.js")


<script>

        @if (String.IsNullOrEmpty(Request.Params["Latitude"]) == false)
        {
            <text>
            geocodificarLatitudeLongitude('map', parseFloat("@Request.Params["Latitude"]"), parseFloat("@Request.Params["Longitude"]"));
            </text>
        }
        else
        {
            <text>
            geocodificarEndereco('map', @Html.Raw(Json.Encode(Model.Endereco)));
            </text>
        }

</script>
}

@section styles {

    <style>
        html, body, .container, #map {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        #map {
            position: relative;
        }
    </style>
}

<div id="map">
</div>
<div id="alerta">
</div>
<div id="legenda">
</div>