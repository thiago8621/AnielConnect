@model Aniel.Connect.Models.Equipe_MapaModel
@using Aniel.Connect.Core.Helpers
@using Sinapse.Model.enumerados;

@{
    var areas = ViewBag.Areas;

    ViewBag.Title = RsCadastros.LOCALIZACAO_EQUIPE_MAPA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    <script src="~/bin/Scripts/jquery-3.3.1.min.js"></script>
    <link href="~/Content/leaflet.css" rel="stylesheet" />
    <script src="~/Scripts/leaflet.js"></script>

    <link href="~/Content/map.css" rel="stylesheet" />
    <style>
        .leaflet-popup-content {
            width: 600px;
        }
    </style>
}

@section variaveis
{
    @Scripts.Render("~/bundles/jslayoutlimpo")
}

@section scripts
{

    <script>
        @if (AcessoHelper.TemAcesso(areas, "176"))
        {
        <text>
        var HandleSupervMonitor = function () {
            $('#iSupervisor, #iMonitor').change(function () {
                if ($("#iSupervisor").is(":checked")) {
                    $("#divSupervisor").show();
                    $("#divMonitor").hide();
                    $("#idMonitor").val("").trigger("change");
                }
                else {
                    $("#divSupervisor").hide();
                    $("#divMonitor").show();

                    $("#idSupervisor").val("").trigger("change");
                }
            });
        }
        </text>
        }

        const HandleGrupoArea = function () {
            $('#iGrupoArea').unbind('select2:select select2:unselecting');
            $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

                GrupoSelecionado = e.params.data
                if (GrupoSelecionado) {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false, HandleArea, null, null, { UsaPerfilVisualizacaoServico: true });
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, null, null, null, { UsaPerfilVisualizacaoServico: true });
                }

                else {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea, null, null, { UsaPerfilVisualizacaoServico: true });
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, null, null, null, { UsaPerfilVisualizacaoServico: true });
                }

            });
        };

        const HandleArea = function () {
            $('#iArea').unbind('select2:select select2:unselecting');
            $('#iArea').on('select2:select select2:unselecting', function (e) {
                const AreaSelecionada = e.params.data;

                if (AreaSelecionada) {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id), null, "@RsBase.SELECIONE", false, null, null, null, { UsaPerfilVisualizacaoServico: true });
                }
                else {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, null, null, null, { UsaPerfilVisualizacaoServico: true });
                }
            });
        };

        $(document).ready(function () {
            @if (Model.Itens.Count() == 0)
            {
                <text>
                    Notificar("@RsBase.ATENCAO_","@RsCadastros.NENHUM_REGISTRO","warning");
                </text>
            }

            @if (!String.IsNullOrEmpty(Model.Id_Monitor))
            {
                <text>
                $('#iMonitor').prop("checked", true).change();
                </text>
            }

            @if (!String.IsNullOrEmpty(Model.Endereco))
            {
                <text>
                $('#idEndereco').trigger("focusout");
                </text>
            }

            @if (AcessoHelper.TemAcesso(areas, "176"))
            {
            <text>
            HandleSupervMonitor();
            $('#iSupervisor').trigger('change');

            AddSelect("idMonitor", "@CONSTANTES.URLPortal/api/IdentityUserApi/GetComboMonitor", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Monitor", "@RsBase.SELECIONE", false);
            AddSelect("idSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Num_Fre_Supervisor", "@RsBase.SELECIONE", false);
            </text>
            }
            AddSelect("idEquipe", "@CONSTANTES.URLPortal/api/Equipeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Equipe", "@RsBase.SELECIONE", false, null, null, null, { ExibirApenasTecnicosSupervisorMonitor: @(AcessoHelper.TemAcesso(areas, "176") ? "false" : "true") });
            AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Cod_Escritorio", "@RsBase.SELECIONE", false, HandleGrupoArea, null, null, { UsaPerfilVisualizacaoServico: true });
            AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, "@Model.Cod_Escritorio", "@Model.Cod_Area", "@RsBase.SELECIONE", "@Model.Cod_Area" ? false : true, HandleArea, null, null, { UsaPerfilVisualizacaoServico: true });
            AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, "@Model.Cod_Escritorio", "@Model.Cod_Area", "@Model.Cod_Localidade", "@RsBase.SELECIONE", "@Model.Cod_Localidade" ? false : true, null, null, null, { UsaPerfilVisualizacaoServico: true });
        });

    </script>
}


