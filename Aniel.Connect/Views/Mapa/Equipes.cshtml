                    <div class="row">
                        <div class="col-12 mt-1">
                            <div class="form-group">
                                <label for="iLocalidade">@RsCadastros.LOCALIDADE:</label>
                                @Html.DropDownListFor(model => model.Cod_Localidade, new SelectList(new List<object>()), new { @class = "form-control", @id = "iLocalidade" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 mt-1">
                            <div class="form-group">
                                <label for="iIdNatureza">@RsCadastros.HABILIDADE_TECNICA</label>
                                @Html.DropDownListFor(model => model.Id_Natureza, new SelectList(ViewBag.Natureza, "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iIdNatureza", @autocomplete = "off" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 text-center">
                            <div class="mt-2 mb-2" style="">
                                <button class="btn btn-success pl-2 pr-2" type="submit" id="btnAtualizar" title="Aplicar" onclick="ShowPageLoading();">
                                    @RsCadastros.APLICAR
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal-->





}
