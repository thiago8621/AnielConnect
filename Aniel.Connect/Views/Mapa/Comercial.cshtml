                                                                       '<span> <b> Descrição: </b>  @item.Desc_Nome_Venda </span><br>' +
                                                                       '<span> <b> Endereço: </b> @item.Endereco </span><br>' +
                                                                       '<span> <b> Atualizado: </b> @item.Atualizado_Em </span><br>' +
                                                                       '<span> <b> Precisão: </b> @item.Precisao </span><br>' +
                                                                       '<span> <b> Bateria: </b> @item.Bateria</span><br>' +
                                                                       '<span> <b> Status GPS: </b> @item.Status_Gps </span><br>' +
                                                                       '<span> <b> Dispositivo Móvel: </b> @item.Dispositivo </span><br>' +
                                                                       '<span> <b> Versão Android: </b> @item.Versao_Android </span><br>' +
                                                                       '<span> <b> Versão App: </b> @item.Versao_App </span><br><br>' +
                                                                       '<span> <b> Check-in Realizado: </b> @(item.CheckIn ? "Sim" : "Não") </span><br>' +
                                                                       '<span> <b> Check-out Realizado: </b> @(item.CheckOut ? "Sim" : "Não") </span><br>'
                                                                    </text>
                                                                }
                                                                else
                                                                {
                                                                    <text>
                                                                       '<span> <b> @item.Vendedor </b> </span><br><br>' +
                                                                       '<span> <b> Descrição: </b>  @item.Desc_Nome_Venda </span><br>' +
                                                                       '<span> <b> Endereço: </b> @item.Endereco </span><br>' +
                                                                       '<span> <b> Atualizado: </b> - </span><br>' +
                                                                       '<span> <b> Precisão: </b> - </span><br>' +
                                                                       '<span> <b> Bateria: </b> - </span><br>' +
                                                                       '<span> <b> Status GPS: </b> - </span><br>' +
                                                                       '<span> <b> Dispositivo Móvel: </b> - </span><br>' +
                                                                       '<span> <b> Versão Android: </b> - </span><br>' +
                                                                       '<span> <b> Versão App: </b> - </span><br>' +
                                                                       '<span> <b> Check-in Realizado: </b> @(item.CheckIn ? "Sim" : "Não") </span><br>' +
                                                                       '<span> <b> Check-out Realizado: </b> @(item.CheckOut ? "Sim" : "Não") </span><br>'
                                                                    </text>
                                                                }

                                                            ).openPopup();
                                                        </text>
                                                    }
                                                    else if (item.Checkpoint == true)
                                                    {
                                                        <text>
                                                            L.marker([@item.Latitude.Value.ToString().Replace(",","."), @item.Longitude.Value.ToString().Replace(",",".")], {
                                                                icon: L.divIcon({
                                                                    html: '<i class="fas fa-map-pin fa-2x" style="color: #008000"></i>',
                                                                    iconSize: [40, 40],
                                                                    className: 'myDivIcon'
                                                                })
                                                            }).addTo(map).bindPopup(

                                                                '<span> <b> @item.Vendedor </b> </span><br><br>' +
                                                                '<span> <b> Endereço: </b>  @item.Endereco</span><br>' +
                                                                '<span> <b> Atualizado: </b> @item.Atualizado_Em</span><br>' +
                                                                '<span> <b> Precisão: </b> @item.Precisao</span><br>' +
                                                                '<span> <b> Bateria: </b> @item.Bateria</span><br>' +
                                                                '<span> <b> Status GPS: </b> @item.Status_Gps</span><br>' +
                                                                '<span> <b> Dispositivo Móvel: </b> @item.Dispositivo</span><br>' +
                                                                '<span> <b> Versão Android: </b> @item.Versao_Android</span><br>' +
                                                                '<span> <b> Versão App: </b> @item.Versao_App</span><br>' +
                                                                '<span> <b> Tipo de Check Point: </b> @item.Tipo</span><br>'+
                                                                '<span> <b> Observação do Check Point: </b> @item.Obs_Checkpoint</span><br>'
                                                            ).openPopup();
                                                        </text>
                                                    }
                                                }
                                            }

                                            @if(latlongRealizadaLista.Count > 0)
                                            {
                                                var latlng = latlongRealizadaLista.FirstOrDefault().Replace(",", ".").Replace("|", ",").Split(',');
                                                <text>
                                                try {
                                                    map.setView(new L.LatLng(@latlng[1],@latlng[0]), 1);
                                                }
                                                catch(ex){

                                                }
                                                </text>
                                            }
                                    setTimeout(() => { map.invalidateSize() }, 500);
                                </script>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @*}
            }*@
        </div>
    </div>
}
