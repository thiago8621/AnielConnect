                                                                                                         $('#iData_Busca').val('@Request.Params["data"]');
                                                                                                        var tempdate = new $('#iData_Busca').val();
                                                                                                        var partesData = tempdate.split("/");
                                                                                                        var tempdate = partesData[1] + '/' + partesData[0] + "/" + partesData[2];
                                                                                                        $('#iData_Busca').val(tempdate);
                                                                             }


                                            });

                                            function recarregaFiltro() {


                                                                        if (!$('#iVendedor_Busca').val() || !$('#iData_Busca').val()) {
                                                                                Notificar("@RsBase.ATENCAO_","@String.Format(RsBase.REQUIRED, RsCadastros.DATA_EQUIPE)","warning");
