                                            @{
                                                List<String> latlongRealizadaLista = new List<String>();

                                                latlongRealizadaLista = (from o in Model.PontoVenda_CheckPoint_Mapa
                                                                         where o.Latitude.HasValue && o.Latitude != 0
                                                                         select String.Format("{0}|{1}", o.Longitude, o.Latitude)).ToList();
                                            }

                                            var polylinePoints_RotaRealizada = []

                                            @foreach (var item in Model.PontoVenda_CheckPoint_Mapa)
                                            {
                                                if (item.CheckIn || item.Checkpoint)
                                                {

                                                    <text>
                                                    polylinePoints_RotaRealizada.push(
                                                        new L.LatLng(@Json.Encode(item.Latitude.Value), @Json.Encode(item.Longitude.Value))
                                                    )
                                                    </text>
                                                }
                                            }

                                            var polyline_RotaRealizadaOptions = {
                                                color: '#007bff',
                                                weight: 6,
                                                opacity: 0.9
                                            }

                                            var polyline_Rota_Realizada = new L.Polyline(polylinePoints_RotaRealizada, polyline_RotaRealizadaOptions);

                                            map.addLayer(polyline_Rota_Realizada);

                                            @if (Model.PontoVenda_CheckPoint_Mapa.Count() > 0)
                                            {
                                                foreach (var item in Model.PontoVenda_CheckPoint_Mapa)
                                                {
                                                    if (
                                                        (item.Latitude_CheckIn == null && item.Longitude_CheckIn == null)
                                                        && (item.Latitude_CheckOut == null && item.Longitude_CheckOut == null)
                                                        && item.Ponto_Venda
                                                    )
                                                    {
                                                        <text>
                                                            L.marker([@item.Latitude.Value.ToString().Replace(",","."), @item.Longitude.Value.ToString().Replace(",",".")], {
                                                                icon: L.divIcon({
                                                                    html:
                                                                    @if (item.CheckIn && item.CheckOut)
                                                                    {
                                                                        <text> '<i class="icofont-location-pin icofont-2x" style="color:#EC1418"></i>' </text>
                                                                    }
                                                                    else if(item.CheckIn)
                                                                    {
                                                                        <text> '<i class="icofont-location-pin icofont-2x" style="color:#207D0A"></i>' </text>
                                                                    }
                                                                    else
                                                                    {
                                                                        <text> '<i class="icofont-location-pin icofont-2x" style="color:#2D2D2D"></i>' </text>
                                                                    },
                                                                    iconSize: [40, 40],
                                                                    className: 'myDivIcon'
                                                                })
                                                            }).addTo(map).bindPopup(

                                                                @if (item.CheckIn)
