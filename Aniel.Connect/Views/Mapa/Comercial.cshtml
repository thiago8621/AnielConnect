                                                                        }

                                                                     var tempdate = new $('#iData_Busca').val();
                                                                     //var partesData = tempdate.split("/");
                                                                     //var tempdate = partesData[1] + '/' + partesData[0]  + "/" + partesData[2];

                                                                        var url = "@Url.Action("Comercial", "Mapa")" + "?id_Vendedor=" + $('#iVendedor_Busca').val()
                                                                      + "&Data=" + tempdate + "&nome_equipe=" /*+ $('#iMatricula_Nome').val() */+ "&Pagina=@Request.Params["pagina"]";
                                                                     window.location.href = url;
                                                                    ShowPageLoading();

                                             }

                                            //Aqui


                                            var map = new L.Map('map-rotas', { maxZoom: 18 });

                                            /******************
                                            tratando bug zoom
                                            ******************/
                                            var mapZoomLevel = localStorage.theZoom;
                                            if (isNaN(mapZoomLevel)) {
                                                mapZoomLevel = 15;  //default
                                            }
                                            map.on('load', function (e) {
                                                map.setZoom(mapZoomLevel);
                                            },
                                                //store
                                                map.on('moveend', function (e) {
                                                    localStorage.theZoom = map.getZoom();
                                                }));
                                            /**fim bug zoom**/

                                            L.tileLayer('http://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                                attribution: '&copy; <a href="http://openstreetmap.org">OpenStreetMap</a> contributors',
                                                maxZoom: 20
                                            }).addTo(map);

