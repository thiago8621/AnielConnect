    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

<script>


    $(document).ready(function () {

        //DATEPICKER
        $("#iData_Busca").val('@Model.Data_Busca');


        $(".datepicker").mask("00/00/0000");
        $(".datepicker")
            .datepicker({
                format: "dd/mm/yyyy",
                language: "pt-BR",
                todayHighlight: "true",
                autoclose: true
            })
            .on("changeDate", function (e) {
                if ($(this).val().length === 10) return $(this).trigger("focusout");
                else return true;
            })
            .after(function () {
                var nameLink = `${$(this)[0].id}_dp`;
            });


            @if (Model.PontoVenda_CheckPoint_Mapa == null || Model.PontoVenda_CheckPoint_Mapa.Count() == 0)
            {
                <text>

        Swal.fire({
            title: "Nenhum registro para ser apresentado!",
            type: 'warning',
            showCancelButton: false,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'OK'
        }).then((result) => {
            if (result.value)
                AddAba("@Url.Action("Dashboard_Vendas", "Venda")");
            else if (result.dismiss == "cancel")
                AddAba("@Url.Action("Dashboard_Vendas", "Venda")");
        });

        </text>
            }
            else
            {
                 <text>
                $(".divCorpo").show();
                </text>
                }
            });
</script>
}



