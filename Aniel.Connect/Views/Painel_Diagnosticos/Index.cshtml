        var handleDataTableButtons = function () {

            "use strict";

           function AlterarStatusObj(Status) {
    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/clienteApi/AlterarStatus")';

                if (rows_selected.length === 0) {
                    Notificar("@RsBase.ATENCAO_", "Selecione um item", "warning");
                    return;
                           }

               if (rows_selected.length > 1) {
                    Notificar("@RsBase.ATENCAO_", "Selecione apenas um item", "warning");
                    return;
               }


    var idSelecionado = rows_selected[0];

    $.ajax({
        url: link,
        type: 'POST',
        dataType: 'json',
        data: {
            ids: [idSelecionado],
            status: Status
        }
    })
    .done(function (data) {
        if (data.ok) {
            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
            rows_selected = [];
            oDatatable.draw();
        } else {
            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
        }
    });

    rows_selected = [];
}


