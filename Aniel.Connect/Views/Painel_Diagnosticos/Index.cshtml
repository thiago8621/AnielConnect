}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")


<script>
        let rows_selected = [];
        let oDatatable;
        let id_login_selected = [];

        var HandleConcentradora = function () {
            $('#iConcentradora').on('select2:select select2:unselecting', function (e) {

                if (e.params.data != undefined) {
                    AddSelect("iPoolIp", "@CONSTANTES.URLPortal/api/pool_Ipapi/GetComboDisponiveis", @CONSTANTES.PaginacaoRegistros, null, e.params.data.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iPoolIp", "@CONSTANTES.URLPortal/api/pool_Ipapi/GetComboDisponiveis", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.TODOS", false);
                }
                return true
            });
    }

    const HandleSlot = function () {
         $('#iSlot').on('select2:select select2:unselecting', function (e) {
             const SlotSelecionado = e.params.data;

             if ($('#iPon').val()) {
                 AddSelect("iPon", "@CONSTANTES.URLPortal/api/PONApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, SlotSelecionado.id, $('#iPON').val(), "@RsBase.SELECIONE", false);
             }
             else {
                 AddSelect("iPon", "@CONSTANTES.URLPortal/api/PONApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, SlotSelecionado.id, null, "@RsBase.SELECIONE", false);
             }

             $(".select2-selection").addClass("outlineNone")

             return true;
         });
    }

    const HandleOLT = function () {
     $('#iOLT').on('select2:select select2:unselecting', function (e) {
         const OLTSelecionada = e.params.data;

         if ($('#iSlot').val()) {
             AddSelect("iSlot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, OLTSelecionada.id, $("#iSlot").val(), "@RsBase.SELECIONE", false);
         }
         else {
             AddSelect("iSlot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, OLTSelecionada.id, null, "@RsBase.SELECIONE", false);
         }

         $(".select2-selection").addClass("outlineNone")

         return true;
     });
 }


   const HandleEstadosBrasil = function () {
       $('#iEstadosBrasil').on('select2:select', function (e) {
           const EstadoSelecionado = e.params.data;


           if ($("#iCidade").val()) {
               AddSelect("iCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo",@CONSTANTES.PaginacaoRegistros, null, EstadoSelecionado.id, $("#iCidade").val(), "@RsBase.SELECIONE", false);

        } else {
               AddSelect("iCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo",@CONSTANTES.PaginacaoRegistros, null, EstadoSelecionado.id, null, "@RsBase.SELECIONE", false);
           }

           $(".select2-selection").addClass("outlineNone")
           return true;
    });
};

const HandleCidade = function () {
    $('#iCidade').on('select2:select', function (e) {
        const CidadeSelecionada = e.params.data;


        if ($("#iBairro").val()) {
            AddSelect("iBairro", "@CONSTANTES.URLPortal/api/Bairroapi/GetCombo",@CONSTANTES.PaginacaoRegistros, null, CidadeSelecionada.id, $("iBairro").val(), "@RsBase.SELECIONE", false);
        } else {
            AddSelect("iBairro", "@CONSTANTES.URLPortal/api/Bairroapi/GetCombo",@CONSTANTES.PaginacaoRegistros, null, CidadeSelecionada.id, null, "@RsBase.SELECIONE", false);
        }

        $(".select2-selection").addClass("outlineNone")
        return true;
    });
};





    $(document).ready(async function () {

        if (localStorage.getItem("filtro_painel") != null) {
            var storedFilters = JSON.parse(localStorage.getItem("filtro_painel"));
            await recuperarFiltrosCache(storedFilters);
        }
        else {
            AddSelect("iPlano", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.INDIFERENTE", false);
            AddSelect("iCliente", "@CONSTANTES.URLPortal/api/clienteapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.INDIFERENTE", false);
            AddSelect("iOLT", "@CONSTANTES.URLPortal/api/OLTapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleOLT);
            AddSelect("iSlot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleSlot);
            AddSelect("iPon", "@CONSTANTES.URLPortal/api/PONApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iConcentradora", "@CONSTANTES.URLPortal/api/ConcentradoraApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.TODOS", false, HandleConcentradora);
            AddSelect("iPoolIp", "@CONSTANTES.URLPortal/api/pool_Ipapi/GetComboDisponiveis", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.TODOS", false);
            AddSelect("iCaixaFtth", "@CONSTANTES.URLPortal/api/Elemento_RedeApi/GetComboCaixa", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iEstadosBrasil", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.TODOS", false, HandleEstadosBrasil);
            AddSelect("iCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.TODOS", false, HandleCidade);
            AddSelect("iBairro", "@CONSTANTES.URLPortal/api/Bairroapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }


            var filters = {
                cliente: $("#iCliente").val(),
                plano: $("#iPlano").val(),
                status: $("#iStatus").val(),
                statusOnu: $("#iStatusOnu").val(),
                statusAutenticacao: $("#iStatusAutenticacao").val(),
                olt: $("#iOLT").val(),
                concentradora: $("#iConcentradora").val(),
                poolIp: $("#iPoolIp").val(),
                caixaFtth: $("#iCaixaFtth").val(),
                portaFtth: $("#iPortaFtth").val(),
                slot: $("#iSlot").val(),
                pon: $("#iPon").val(),
                estado: $("#iEstadosBrasil option:selected").text(),
                estadoId: $("#iEstadosBrasil").val(),
                cidade: $("#iCidade option:selected").text(),
                cidadeId: $("#iCidade").val(),
                bairro: $("#iBairro option:selected").text(),
                bairroId: $("#iBairro").val()
            };


            $("#iOLT, #iCliente, #iPlano, #iStatus, #iStatusOnu, #iStatusAutenticacao, #iConcentradora, #iPoolIp, #iCaixaFtth, #iPortaFtth, #iSlot, #iPon, #iEstadosBrasil, #iCidade, #iBairro").on("change", function () {
                // Atualiza os campos no objeto "filters"
                var fieldId = $(this).attr("id");

                //Mapeia o ID da chave correspondente do objeto que foi criado (filters)
                switch (fieldId) {
                    case "iCliente":
                        filters.cliente = $(this).val();
                        break;
                    case "iPlano":
                        filters.plano = $(this).val();
                        break;
                    case "iStatus":
                        filters.status = $(this).val();
                        break;
                    case "iStatusOnu":
                        filters.statusOnu = $(this).val();
                        break;
                    case "iStatusAutenticacao":
                        filters.statusAutenticacao = $(this).val();
                        break;
                    case "iOLT":
                        filters.olt = $(this).val();
                        break;
                    case "iConcentradora":
                        filters.concentradora = $(this).val();
                        break;
                    case "iPoolIp":
                        filters.poolIp = $(this).val();
                        break;
                    case "iCaixaFtth":
                        filters.caixaFtth = $(this).val();
                        break;
                    case "iPortaFtth":
                        filters.portaFtth = $(this).val();
                        break;
                    case "iSlot":
                        filters.slot = $(this).val();
                        break;
                    case "iPon":
                        filters.pon = $(this).val();
                        break;
                    case "iEstadosBrasil":
                        filters.estado = $(this).find("option:selected").text();
                        filters.estadoId = $(this).val();
                        break;
                    case "iCidade":
                        filters.cidade = $(this).find("option:selected").text();
                        filters.cidadeId = $(this).val();
                        break;
                    case "iBairro":
                        filters.bairro = $(this).find("option:selected").text();
                        filters.bairroId = $(this).val();
                        break;
                }


                // Salva o objeto atualizado no localStorage
                localStorage.setItem("filtro_painel", JSON.stringify(filters));


            });





        });

    async function recuperarFiltrosCache(storedFilters) {
        const tasks = [];

        AddSelect("iPlano", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, storedFilters?.plano ?? null, "@RsBase.INDIFERENTE", false);
        AddSelect("iCliente", "@CONSTANTES.URLPortal/api/clienteapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, storedFilters?.cliente ?? null, "@RsBase.INDIFERENTE", false);

        tasks.push(AddSelect("iOLT", "@CONSTANTES.URLPortal/api/OLTapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, storedFilters?.olt ?? null, "@RsBase.SELECIONE", false, HandleOLT)
            .then(() => {
                AddSelect("iSlot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, storedFilters?.olt ?? null, storedFilters?.slot ?? null, "@RsBase.SELECIONE", false, HandleSlot)
                    .then(() => {
                        AddSelect("iPon", "@CONSTANTES.URLPortal/api/PONApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, storedFilters?.slot ?? null, storedFilters?.pon ?? null, "@RsBase.SELECIONE", false)
                    })
            })
        );

        tasks.push(AddSelect("iConcentradora", "@CONSTANTES.URLPortal/api/ConcentradoraApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, storedFilters?.concentradora ?? null, "@RsBase.TODOS", false, HandleConcentradora)
            .then(() => {
                AddSelect("iPoolIp", "@CONSTANTES.URLPortal/api/pool_Ipapi/GetComboDisponiveis", @CONSTANTES.PaginacaoRegistros, null, storedFilters?.concentradora ?? null, storedFilters?.poolIp ?? null, "@RsBase.TODOS", false);
            }));

        AddSelect("iCaixaFtth", "@CONSTANTES.URLPortal/api/Elemento_RedeApi/GetComboCaixa", @CONSTANTES.PaginacaoRegistros, null, null, storedFilters?.caixaFtth ?? null, "@RsBase.SELECIONE", false);

        tasks.push(AddSelect("iEstadosBrasil", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, storedFilters?.estadoId ?? null, "@RsBase.TODOS", false, HandleEstadosBrasil)
            .then(() => {
                AddSelect("iCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, storedFilters?.estadoId ?? null, storedFilters?.cidadeId ?? null, "@RsBase.TODOS", false, HandleCidade)
                    .then(() => {
                        AddSelect("iBairro", "@CONSTANTES.URLPortal/api/Bairroapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, storedFilters?.cidadeId ?? null, storedFilters?.bairroId ?? null, "@RsBase.SELECIONE", false)
                    })
            })
        );

        $("#iStatus").val(storedFilters?.status ?? "");
        $("#iStatusOnu").val(storedFilters?.statusOnu ?? "");
        $("#iStatusAutenticacao").val(storedFilters?.statusAutenticacao ?? "");

        await Promise.all(tasks);
    }

    function AlterarStatus(status, id_motivo_cancelamento, flagSuspensao) {
    if (rows_selected.length == 0) {
        Notificar("@RsCadastros.ATENCAO", "Selecione um login", "warning");
    }
    else {
        const link = "@CONSTANTES.URLPortal/api/PlanoProdutoapi/AlterarStatus"
        const selectData = oDatatable.data().toArray().filter(p => rows_selected.includes(p.id))
        var listaClientePPNULL = [];
        for (var i = 0; i < selectData.length; i++) {
            if (selectData[i].idClientePlanoProduto == null) {
                listaClientePPNULL.push(selectData[i]);
                selectData.splice(i, 1);
            }
        }


        var idsClientePlanoProduto = selectData.map(p => p.idClientePlanoProduto);
        var idsLogins = selectData.map(p => p.id);



        $.ajax({
            url: link,
            type: "POST",
            dataType: "json",
            data: {
                ids: idsClientePlanoProduto,
                Status: status,
                id_motivo_cancelamento: id_motivo_cancelamento,
                observacao_motivo_suspensao: $("#iMotivo_Observacao_Suspensao_Plano_Login_Outros").val(),
                idsLogins: idsLogins
            },
            beforeSend: function () {
                ShowPageLoading();
            },
            complete: function () {
                HideLoading();
            }
        })
        .done(async function (data) {
            if (data.ok) {
                if (listaClientePPNULL.length > 0) {
                    var txt = flagSuspensao == true ? "SUSPENSÃO" : "REATIVAÇÃO";
                    const result = await Swal.fire({
                        title: "Log de Login(s) não bloqueada!",
                        text: `Não é possível efetuar a ${txt} de um ou mais LOGIN(s), pois não possuem PLANO/PRODUTO vinculado. Deseja visualizar o LOG de Login(s) não bloqueados?`,
                        icon: 'question',
                        cancelButtonText: 'Não',
                        confirmButtonText: 'Sim',
                        showCancelButton: true,
                    });

                    if (result.value) {
                        $('#modal-LoginSemClientePlanoProduto').modal('show');
                        $("#datatableLoginSemClientePlanoProduto").length && $("#datatableLoginSemClientePlanoProduto").DataTable({
                            dom: "Bfrti",
                            data: listaClientePPNULL,
                            paging: false,
                            destroy: true,
                            deferRender: true,
                            scrollResize: true,
                            buttons: [
                                {
                                    extend: "excelHtml5",
                                    title: "LOG LOGIN",
                                    exportOptions: { orthogonal: "export" },
                                    messageTop: "Emitido por " + username + " em " + RetornaDataHoraAtual(),
                                    sheet_name: "Sinapse"
                                }
                            ],
                            scrollX: true,
                            columns: [
                                { data: "login", title: "@RsCadastros.LOGIN" },
                                { data: "pop", title: "@RsCadastros.POP" },
                                { data: "olt", title: "@RsCadastros.OLT" },
                                { data: "slot", title: "@RsCadastros.SLOT" },
                                { data: "pon", title: "@RsCadastros.PON" }
                            ]
                        });
                    }
                }

                //Quando login Radius não pôde ser bloqueado/desbloqueado.
                if (data.mensagem != undefined && data.mensagem != null)
                    Notificar("@RsBase.INFORMACAO", data.mensagem, "warning");
                else
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");

                oDatatable.draw()
            }
            else {
                Notificar("@RsCadastros.ATENCAO", data.mensagem, "warning")
            }
        })
    }
}


