         $("#btnSusPlano").on('click', async function (e) {
        if (rows_selected.length == 0) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
            return;
             }

            if (rows_selected.length > 1) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.APENAS_UM_REGISTRO_PODE_SER_SELECIONADO", "info");
                return;
            }

        const result = await Swal.fire({
            title: "Deseja suspender o plano?",
            text: "Atenção! Não será possível retornar essa ação. Deseja Continuar?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Sim',
            cancelButtonText: 'Não'
        });

        if (result.value) {
            $("#iMotivo_Observacao_Suspensao_Plano_Login_Outros").val("");
            $('#iMotivo_Suspensao_Plano_Login_Outros').addClass('d-none');
            $('#iModal_Motivo_Suspender_Plano_Login').modal({ backdrop: 'static', keyboard: false });
            AddSelect("iMotivo_Suspensao_Plano_Login", "@CONSTANTES.URLPortal/api/Motivo_Suspensao_ContratualApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, 2, null, "@RsBase.SELECIONE", false);
            $("#btnMotivoSuspensaoPlano_Login").off("click").on("click", function (e) {
                if (($("#iMotivo_Suspensao_Plano_Login").val() > 0) || ($("#iMotivo_Observacao_Suspensao_Plano_Login_Outros").val() != "" && $("#iMotivo_Suspensao_Plano_Login").val() == -1)) {
                    AlterarStatus(4, $("#iMotivo_Suspensao_Plano_Login").val(), true);
                } else {
                    Notificar("@RsBase.ATENCAO_", "Para efetuar a suspensão, é necessário, que selecione o motivo!!", "warning");
                    return false;
                }
                $('#iModal_Motivo_Suspender_Plano_Login').modal('hide');
            });

        }
        e.stopPropagation();
    });

$('#iMotivo_Suspensao_Plano_Login').change(function (e) {
    var id = e.target.value;
    if (id == "-1") {
        $('#iMotivo_Suspensao_Plano_Login_Outros').removeClass('d-none');
