@model Aniel.Connect.Models.AcessoEquipamentoClienteModel

@{
    ViewBag.Title = RsCadastros.ACESSO_EQUIPAMENTO_CLIENTE_HTTP;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts {

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>

        var model = @Html.Raw(Json.Encode(Model));

        $("#iAcessarEquipamento").on("click", function () {

            @*if ($("#iEnderecoMac").val()) {*@

                if ($("#iUltimoIp").val()) {
                let url_equipamento;
                    if (!$("#iPortaHttp").val()) {
                        url_equipamento = "http://" + model.Ultimo_Ip + ":80/";
                    }
                    else {
                        url_equipamento = "http://" + model.Ultimo_Ip + ":" + $("#iPortaHttp").val() + "/";
                    }
                 window.open(url_equipamento, '_blank');
                    }
                    else {
                         Notificar("@RsBase.ATENCAO_", "Não há endereço IP vinculado a este equipamento", "info");
                    }
           @* }
            else
            {
                Notificar("@RsBase.ATENCAO_", "Não há ONU vinculada a este login", "info");
            }*@



        });

</script>
}


<div class="mx-auto mt-5 col-10 col-md-10 col-lg-6">
    <div class="row" style="width:100%">
        <div class="col-sm-3">
            <div class="form-group">
                <label>@RsCadastros.CODIGO_CLIENTE</label>
                @Html.TextBoxFor(model => model.Id_Login_Radius, new { @class = "form-control", @id = "iCodCliente", disabled = "disabled" })
            </div>
        </div>

        <div class="col-sm-4">
            <div class="form-group">
                <label>@RsCadastros.USUARIO</label>
                @Html.TextBoxFor(model => model.Desc_Login_Radius, new { @class = "form-control", @id = "iDescLoginRadius", disabled = "disabled" })
            </div>
        </div>

        <div class="col-sm-5">
            <div class="form-group">
                <label>@RsCadastros.MAC</label>
                @Html.TextBoxFor(model => model.Endereco_Mac, new { @class = "form-control", @id = "iEnderecoMac", disabled = "disabled" })
            </div>
        </div>
    </div>

    <div class="row" style="width:100%">
        <div class="col-sm-12">
            <div class="form-group">
                <label>@RsCadastros.CLIENTE</label>
                @Html.TextBoxFor(model => model.Desc_Cliente, new { @class = "form-control", @id = "iDescCliente", disabled = "disabled" })
            </div>
        </div>
    </div>

    <br />

    <div class="row" style="width:100%">
        <div class="col-sm-4">
            <div class="form-group">
                <label>@RsCadastros.ULTIMO_IP_CONEXAO</label>
                @Html.TextBoxFor(model => model.Ultimo_Ip, new { @class = "form-control", @id = "iUltimoIp", disabled = "disabled" })
            </div>
        </div>
        <div class="col-sm-4">
            <div class="form-group">
                <label>@RsCadastros.SENHA</label>
                @Html.TextBoxFor(model => model.Senha_Equipamento, new { @class = "form-control", @id = "iSenhaEquipamento" })
            </div>
        </div>
        <div class="col-sm-4">
            <div class="form-group">
                <label>@RsCadastros.PORTA_HTTP</label>
                @Html.TextBoxFor(model => model.Porta_Http, new { @class = "form-control", @id = "iPortaHttp" })
            </div>
        </div>
    </div>

    <div class="row" style="width:100%">
        <div class="col-sm-4">
            <div class="form-group">
                <label>@RsCadastros.FRAMED_IPV6</label>
                @Html.TextBoxFor(model => model.Framed_Ipv6, new { @class = "form-control", @id = "iFramedIpv6", disabled = "disabled" })
            </div>
        </div>
        <div class="col-sm-4">
            <div class="form-group">
                <label>@RsCadastros.DELEGATED_IPV6</label>
                @Html.TextBoxFor(model => model.Delegated_Ipv6, new { @class = "form-control", @id = "iDelegatedIpv6", disabled = "disabled" })
            </div>
        </div>
    </div>

    <br />

    <div class="form-group col-sm-12" style="padding: 15px;">
        <div class="text-center">
            <button type="button" class="btn btn-success" id="iAcessarEquipamento">@RsBase.ACESSAR</button>
        </div>
    </div>
</div>


