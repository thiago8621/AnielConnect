        </div>
    </div>
    <br />

    <div class="form-group mt-4" style="padding: 15px;">
        <div class="text-center">
            <button type="button" class="btn btn-danger" data-dismiss="modal">@RsBase.CANCELAR</button>
            <button type="button" class="btn btn-success" id="btnAlterarIp">@RsBase.ALTERAR</button>
        </div>
    </div>
