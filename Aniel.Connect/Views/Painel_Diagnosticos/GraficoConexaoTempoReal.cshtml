        </div>

        <div class="row">
            <div class="form-group">
                <label for="iUploadAtual">@RsCadastros.UPLOAD_ATUAL: </label>
                <div style="font-weight:bold" id="iUploadAtual">0Kb</div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <label for="iUploadTotal">@RsCadastros.UPLOAD_TOTAL: </label>
                <div style="font-weight:bold" id="iUploadTotal">0Kb</div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <label for="iUploadMaximo">@RsCadastros.UPLOAD_MAXIMO: </label>
                <div style="font-weight:bold" id="iUploadMaximo">0Kb</div>
            </div>
        </div>
    </div>

</div>





