@model Aniel.Connect.Models.PainelDiagnostico_FrameModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.PAINELDIAGNOSTICOS;
    ViewBag.Sessao = RsCadastros.DIAGNOSTICO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")


    <script>
        let rows_selected = [];
        let oDatatable;
        let id_login_selected = [];

        $(document).ready(async function() {
            ExibirGraficoConexaoTempoReal();
            ExibirGraficoConsumo();
            ExibirGraficoPotenciaRxTx();
            ExibirGraficoPingClienteConcentradora();
            ExibirGraficoTempoOnlineOffline();
        });

        async function ExibirRelatorioConexao(idLogin) {
            ShowDialog(true, true, '@Html.Raw(RsCadastros.RELATORIO_CONEXAO)', '@Url.Action("RelatorioConexao", "Painel_Diagnosticos")' + '?Id_Login_Radius=' + idLogin, 'divRelatorioConexao', 900, 650, 'iframeRelatorioConexao');
        }

        async function ExibirGraficoConsumo() {
            $("#iframeGraficoConsumoConexao").attr("src", "@Html.Raw(Url.Action("GraficoConsumoConexao", "Painel_Diagnosticos", new { Id_Login_Radius = Model.Id_Login_Radius }))");
            @*ShowDialog(true, true, '@Html.Raw(RsCadastros.GRAFICO_CONSUMO_CONEXAO)', '@Url.Action("GraficoConsumoConexao", "Painel_Diagnosticos")' + '?Id_Login_Radius=' + idLogin, 'divGraficoConsumoConexao', 1000, 600, 'iframeGraficoConsumoConexao');*@
        }

        async function ExibirGraficoConexaoTempoReal() {
            $("#iframeGraficoConexaoTempoReal").attr("src", "@Html.Raw(Url.Action("GraficoConexaoTempoReal", "Painel_Diagnosticos", new { Id_Login_Radius = Model.Id_Login_Radius }))");
            @*ShowDialog(true, true, '@Html.Raw(RsCadastros.GRAFICO_CONEXAO_TEMPO_REAL)', '@Url.Action("GraficoConexaoTempoReal","Painel_Diagnosticos")' + '?Id_Login_Radius=' + idLogin, 'divGraficoConexaoTempoReal', 1000, 600, 'iframeGraficoConexaoTempoReal');*@
        }

        async function ExibirGraficoTempoOnlineOffline() {
            $("#iframeGraficoTempoOnlineOffline").attr("src", "@Html.Raw(Url.Action("GraficoTempoOnlineOffline", "Painel_Diagnosticos", new { Id_Login_Radius = Model.Id_Login_Radius }))");
            @*ShowDialog(true, true, '@Html.Raw(RsCadastros.GRAFICO_TEMPO_ONLINE_OFFLINE)', '@Url.Action("GraficoTempoOnlineOffline", "Painel_Diagnosticos")' + '?Id_Login_Radius=' + idLogin, 'divGraficoTempoOnlineOffline', 1200, 600, 'iframeGraficoTempoOnlineOffline');*@
        }

        async function ExibirGraficoPotenciaRxTx() {
            $("#iframeGraficoPotenciaRxTx").attr("src", "@Html.Raw(Url.Action("GraficoPotenciaRxTx", "Painel_Diagnosticos", new { Id_Login_Radius = Model.Id_Login_Radius }))");
            @*ShowDialog(true, true, '@Html.Raw(RsCadastros.GRAFICO_POTENCIA_RX_TX)', '@Url.Action("GraficoPotenciaRxTx","Painel_Diagnosticos")' + '?Id_Login_Radius=' + idLogin, 'divGraficoPotenciaRxTx', 1000, 600, 'iframeGraficoPotenciaRxTx');*@
        }

        async function ExibirGraficoPingClienteConcentradora() {
            $("#iframeGraficoPingClienteConcentradora").attr("src", "@Html.Raw(Url.Action("GraficoPingClienteConcentradora", "Painel_Diagnosticos", new { Id_Login_Radius = Model.Id_Login_Radius }))");
            @*ShowDialog(true, true, '@Html.Raw(RsCadastros.GRAFICO_PING_CLIENTE_CONCENTRADOR)', '@Url.Action("GraficoPingClienteConcentradora", "Painel_Diagnosticos")' + '?Id_Login_Radius=' + idLogin, 'divGraficoPingClienteConcentradora', 1200, 600, 'iframeGraficoPingClienteConcentradora');*@
        }

        function ExibirAcessoEquipamentoCliente(idLogin) {
             ShowDialog(true, true, '@Html.Raw(RsCadastros.ACESSO_EQUIPAMENTO_CLIENTE_HTTP)', '@Url.Action("AcessoEquipamentoCliente", "Painel_Diagnosticos")' + '?Id_Login_Radius=' + idLogin, 'divAcessarEquipamentoCliente', 700, 500, 'iframeAcessarEquipamentoCliente');
        }                                    
                  
    </script>
}

<div class="container-fluid px-4" style="height:100%">
    <!--main-->

    <div class="row">
        <!--GRÁFICO CONEXÃO EM TEMPO REAL-->
        <div class="accordion mb-2 mt-2 mr-2" id="accordion_1" style="width:100%">
            <div class="card div-card-accord">
                <div class="card-header title-card" id="heading_1">
                    <h5 class="mb-0">
                        <a role="button" data-toggle="collapse" data-target="#collapse_1" aria-expanded="true" aria-controls="collapse_1">
                            <span class="text-bold-card">@RsCadastros.GRAFICO_CONEXAO_TEMPO_REAL</span>
                        </a>
                    </h5>
                </div>

                <div id="collapse_1" class="collapse show" aria-labelledby="heading_1" data-parent="#accordion_1">
                    <div class="card-body" style="margin-top: -20px;">
                        <iframe id="iframeGraficoConexaoTempoReal" style="width: 100%; height: 600px" name="iframeGraficoConexaoTempoReal" frameBorder="0" class="mt-1" scrolling="no"></iframe>
                    </div>
                </div>
            </div>
        </div>

        <!--GRÁFICO CONSUMO DE CONEXÃO-->
        <div class="accordion mb-2 mt-4 mr-2" id="accordion_2" style="width:100%">
            <div class="card div-card-accord">
                <div class="card-header title-card" id="heading_2">
                    <h5 class="mb-0">
                        <a role="button" data-toggle="collapse" data-target="#collapse_2" aria-expanded="true" aria-controls="collapse_2">
                            <span class="text-bold-card">@RsCadastros.GRAFICO_CONSUMO_CONEXAO</span>
                        </a>
                    </h5>
                </div>

                <div id="collapse_2" class="collapse show" aria-labelledby="heading_2" data-parent="#accordion_2">
                    <div class="card-body" style="margin-top: -20px;">
                        <iframe id="iframeGraficoConsumoConexao" style="width: 100%; height: 600px" name="iframeGraficoConsumoConexao" frameBorder="0" class="mt-1" scrolling="no"></iframe>
                    </div>
                </div>
            </div>
        </div>

        <!--GRÁFICO POTÊNCIA RX/TX-->
        <div class="accordion mb-2 mt-4 mr-2" id="accordion_3" style="width:100%">
            <div class="card div-card-accord">
                <div class="card-header title-card" id="heading_3">
                    <h5 class="mb-0">
                        <a role="button" data-toggle="collapse" data-target="#collapse_3" aria-expanded="true" aria-controls="collapse_3">
                            <span class="text-bold-card">@RsCadastros.GRAFICO_POTENCIA_RX_TX</span>
                        </a>
                    </h5>
                </div>

                <div id="collapse_3" class="collapse show" aria-labelledby="heading_3" data-parent="#accordion_3">
                    <div class="card-body" style="margin-top: -20px;">
                        <iframe id="iframeGraficoPotenciaRxTx" style="width: 100%; height: 600px" name="iframeGraficoPotenciaRxTx" frameBorder="0" class="mt-1" scrolling="no"></iframe>
                    </div>
                </div>
            </div>
        </div>


        <!--GRÁFICO PING CLIENTE/CONCENTRADORA-->
        <div class="accordion mb-2 mt-4 mr-2" id="accordion_4" style="width:100%">
            <div class="card div-card-accord">
                <div class="card-header title-card" id="heading_4">
                    <h5 class="mb-0">
                        <a role="button" data-toggle="collapse" data-target="#collapse_4" aria-expanded="true" aria-controls="collapse_4">
                            <span class="text-bold-card">@RsCadastros.GRAFICO_PING_CLIENTE_CONCENTRADOR</span>
                        </a>
                    </h5>
                </div>

                <div id="collapse_4" class="collapse show" aria-labelledby="heading_4" data-parent="#accordion_4">
                    <div class="card-body" style="margin-top: -20px;">
                        <iframe id="iframeGraficoPingClienteConcentradora" style="width: 100%; height: 600px" name="iframeGraficoPingClienteConcentradora" frameBorder="0" class="mt-1" scrolling="no"></iframe>
                    </div>
                </div>
            </div>
        </div>

        <!--GRÁFICO TEMPO ONLINE/OFF-LINE-->
        <div class="accordion mb-2 mt-4 mr-2" id="accordion_5" style="width:100%">
            <div class="card div-card-accord">
                <div class="card-header title-card" id="heading_5">
                    <h5 class="mb-0">
                        <a role="button" data-toggle="collapse" data-target="#collapse_5" aria-expanded="true" aria-controls="collapse_5">
                            <span class="text-bold-card">@RsCadastros.GRAFICO_TEMPO_ONLINE_OFFLINE</span>
                        </a>
                    </h5>
                </div>

                <div id="collapse_5" class="collapse show" aria-labelledby="heading_5" data-parent="#accordion_5">
                    <div class="card-body" style="margin-top: -20px;">
                        <iframe id="iframeGraficoTempoOnlineOffline" style="width: 100%; height: 600px" name="iframeGraficoTempoOnlineOffline" frameBorder="0" class="mt-1" scrolling="no"></iframe>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <!--./main-->
</div>

<div id="divRelatorioConexao"></div>
<div id="divGraficoConsumoConexao"></div>
<div id="divGraficoConexaoTempoReal"></div>
<div id="divGraficoTempoOnlineOffline"></div>
<div id="divGraficoPingClienteConcentradora"></div>
<div id="divAcessarEquipamentoCliente"></div>
<div id="divGraficoPotenciaRxTx"></div>