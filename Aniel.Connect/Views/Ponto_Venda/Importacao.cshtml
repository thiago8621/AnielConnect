@model  Sinapse.Util.ExcelServiceLog<Aniel.Connect.Models.Ponto_VendaImportacao>

@{
    ViewBag.Title = RsCadastros.IMPORTACAO_PONTO_VENDA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    ViewBag.Modelo = CONSTANTES.URLPortal + @"/Arquivos/Ponto_Venda/Modelo_Padrao_Importacao_Ponto_Venda.xlsx";
}

@section styles
{
    @Styles.Render("~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />

    <style>
        .popover {
            max-width: 45%; /* Max Width of the popover (depending on the container!) */
        }
    </style>
}


@section  scripts
{
    @Scripts.Render("~/bundles/jsDataTable")
    <script src="~/bin/Scripts/download.js"></script>

    <script>

        let datatableExportMuni
        var oDatatable = undefined

        //Download Planilha UF Sistema
        $("#iPlanilha_Sistema").click(function () {
            ShowPageLoading()
            $.ajax({
                url: '@CONSTANTES.URLPortal/api/enderecoapi/PlanilhaEstadosMunicipios',
                type: 'GET',
                dataType: 'json',

            }).done(function (data) {


                //DataTable
                if (oDatatable != undefined) {
                    oDatatable.destroy();
                    $("#datatable").empty();
                }

                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "Bfrti",
                    data: data,
                    buttons: buttonsDataTableRelatorio({
                        sheet_name: "Estados e Municípios",
                        title: "Tabela de Estados e Municípios"
                    }),
                    columns: [
                        { data: "uf", title: "@RsCadastros.UF" },
                        { data: "descricao", title: "@RsCadastros.MUNICIPIO" }
                    ]
                });

                oDatatable.buttons(0).trigger()
                HidePageLoading()

              });

        });
        //Fim Planilha UF Sistema

        $('#iArquivo').on('change', function () {

            var myfile = $(this).val();
            var ext = myfile.split('.').pop();
            if (!(ext == "xls" || ext == "xlsx")) {

                Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                $(this).val("");
            }
            else {

                var arquivo = $(this)[0].files[0];

                var fileName = arquivo.name;
                $(this).next('.custom-file-label').html(fileName);
            }
        });

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;
            var erro = false;

            myfile= $("#iArquivo").val();
            if (!myfile) {

                if ($('#iArquivo').next('.custom-file-label').html() == '') {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ARQUIVO)", "warning");
                    erro = true;
                }
                else {

                    var ext = $('#iArquivo').next('.custom-file-label').html().split('.').pop();
                    if (!(ext == "xlsx" || ext == "xls")) {

                        Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                        erro = true;
                    }
                }
            }
            else {

                var ext = myfile.split('.').pop();
                if (!(ext == "xlsx" || ext == "xls")) {

                    Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                    erro = true;
                }
            }

            if (erro) {

                clicked = false;
                return false;
            }

            $("#divProgress").show();

            $('#form').submit();
        }

        $(document).ready(function () {
              $('[data-toggle="popover"]').popover()

            var sucesso = "@Html.Raw(ViewBag.Sucesso)";
            if (sucesso == "S") {
                Notificar("@RsCadastros.INFORMACAO", "@RsCadastros.IMPORTACAO_CLIENTES_FINALIZADA", "info");
            }

        });

    </script>


    @if (Model.Log.Count() > 0)
    {
        <text>
            <script>

           var array = @Html.Raw(Json.Encode(Model.Log));
           var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                scrollX: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '30vh',
                paging:false,
                drawCallback: function (settings) {
                    $('.switchToggle').bootstrapToggle('state', true);
                },
                columns: [
                    {
                        data: "Chave",
                        title: "@Html.Raw(RsCadastros.IDENTIFICACAO_CLIENTE)",
                    },
                    {
                        data: "Erro",
                        title: "Mensagem"
                    }
                ]
            });
            </script>
        </text>
    }
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col">

            <h4 class="title-page"><i class="fas fa-file-download"></i> @RsBase.IMPORTAR</h4>

            <nav aria-label="breadcrumb" class="mt-25">

                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Ponto_Venda")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PONTO_VENDA</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@RsBase.IMPORTAR</span>
                    </li>

                </ol>
            </nav>
        </div>





    </div>
    <!--./main-->
</div>

<div class="container-fluid">

    <div class="accordion" id="accordion_5">
        <div class="card div-card-accord mb-3">
            <div class="collapse show" aria-labelledby="heading_5" data-parent="#heading_5">
                <div class="card-body pb-0">


                    <div class="row mb-3">
                        <div class="col-10">
                            <label>Para importar os pontos de venda siga os seguintes passos:</label>
                        </div>
                        <div class="col text-right">
                            <a tabindex="0" class="btn text-right" role="button" data-toggle="popover" data-html="true" data-placement="left" data-trigger="focus" title="Informação"
                               data-content="
                                <ul>
                                    <b>Planilha Ponto de Venda:</b>
                                    <li><b>Código</b> - <span class='text-danger'>Obrigatório</span> - Informar código do ponto de venda. </li>
                                    <li><b>Status</b> -  <span class='text-danger'>Obrigatório</span> - Informar status ATIVO ou INATIVO.</li>
                                    <li><b>Descrição</b> -  <span class='text-danger'>Obrigatório</span> -Informar descrição. Campo alfanumérico de até 255 caracteres.</li>
                                    <li><b>CEP</b> - <span class='text-danger'>Obrigatório</span> - Informar CEP da localização.</li>
                                    <li><b>Logradouro</b> - <span class='text-danger'>Obrigatório</span> - Informar logradouro da localização.</li>
                                    <li><b>Bairro</b> -  <span class='text-danger'>Obrigatório</span> - Informar o bairro.</li>
                                    <li><b>Cidade</b> - <span class='text-danger'>Obrigatório</span> - Informar a cidade.</li>
                                    <li><b>UF</b> - <span class='text-danger'>Obrigatório</span> - Informar estado nesse campo com 2 caracteres. Ex.: RJ, SP </li>
                                    <li><b>Complemento</b> - Não Obrigatório - Informar se houver um complemento do endereço.</li>
                                    <li><b>Latitude</b> - Não Obrigatório - Informar a latitude da localização.</li>
                                    <li><b>Longitude</b> - Não Obrigatório - Informar a longitude da localização.</li>

                                    <b>Planilha Vendedor:</b>
                                    <li><b>Código</b> - <span class='text-danger'>Obrigatório</span> - Informar código correspondente do ponto de venda da planilha ponto venda. </li>
                                    <li><b>Matricula Vendedor</b> -  <span class='text-danger'>Obrigatório</span> - Informar matrícula do vendedor.</li>
                                    <li><b>Data Inicial</b> -  <span class='text-danger'>Obrigatório</span> - Informar data inicial no formato dd/mm/aaaa.</li>
                                    <li><b>Data Final</b> - <span class='text-danger'>Obrigatório</span> - Informar data final no formato dd/mm/aaaa.</li>

                                </ul>
                            ">
                            <i class="fas fa-info-circle icofont-1dot5x ml-2" style="color:#486B91;"></i>
                            </a>
                        </div>
                        <div class="col-12">
                            <label>1 - Faça o download da planilha padrão;</label>
                        </div>
                        <div class="col-12">
                            <label>2 - A primeira linha da planilha está preenchida com um exemplo para auxiliá-lo no preenchimento;</label>
                        </div>
                        <div class="col-12">
                            <label>3 - Apague o exemplo e preencha a planilha com os dados dos clientes que deseja importar para o cadastro;</label>
                        </div>
                        <div class="col-12">
                            <label>
                                4 - Verifique a nomenclatura dos <a href="#" id="iPlanilha_Sistema">Estados e Municípios </a> cadastrados no sistema para o preenchimento correto;
                            </label>
                        </div>
                        <div class="col-12">
                            <label>5 - Para saber mais informações sobre os campos, clique no ícone informativo no canto superior direito da tela;</label>
                        </div>
                        <div class="col-12">
                            <label>6 - Ao preencher a planilha, salve em seu computador e faça o upload do arquivo;</label>
                        </div>
                        <div class="col-12">
                            <label>7 - Ao final do processo será exibido um log de registros importados e não importados.</label>
                        </div>
                    </div>
                    <div class="row mb-1">
                        <div class="form-group col-sm-12" style="padding: 15px;" id="teste3">
                            <div class="form-group">
                                <a href="@ViewBag.Modelo" type="button" class="btn btn-primary" id="iLimparFiltroModal" data-dismiss="modal"><i class="fas fa-download"></i> @RsPontoEletronico.DOWNLOADPLANILHAPADRAO</a>
                                <button type="button" data-toggle="modal" data-target="#modal-filter" class="btn btn-success" id="iPesquisar"><i class="fas fa-upload"></i> @RsCadastros.UPLOAD</button>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

@if (Model.Log.Count() > 0)
{
    <text>
        <div class="container-fluid">
            <div class="accordion" id="accordion_5">
                <div class="card div-card-accord mb-3">

                    <div class="card-header title-card mb-0" id="heading_5">
                        <h5 class="mb-0">
                            <span class="text-bold-card">Log de Importação Ponto Venda</span>
                        </h5>
                    </div>
                    <div class="collapse show" aria-labelledby="heading_5" data-parent="#heading_5">
                        <table class="table table-hover nowrap table-responsive" id="datatable">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </text>
}
@using (Html.BeginForm("Importacao", "Ponto_Venda", FormMethod.Post, new { enctype = "multipart/form-data", @id = "form", autocomplete = "off" }))
{
    @*@Html.AntiForgeryToken()*@

    <!--Modal Filters-->
    <div class="modal" id="modal-filter">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title text-muted">@RsCadastros.UPLOAD</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">

                    <div class="row">

                        <div class="col-sm-12">

                            <div class="row">

                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label><strong>@RsCadastros.ARQUIVO</strong></label>
                                        <div class="input-group mb-3">
                                            <input type="file" class="custom-file-input" name="Arquivo" id="iArquivo" />
                                            <label for="Arquivo" id="arquivoi" class="custom-file-label"><i class="fas fa-upload"></i> @RsBase.ESCOLHAUMARQUIVO</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="form-group col-sm-12" style="padding: 15px;">
                        <div class="text-center">
                            <button type="button" class="btn btn-danger" id="iLimparFiltroModal" data-dismiss="modal">@RsBase.CANCELAR</button>
                            <button type="button" class="btn btn-success" id="iImportar" onclick="return ValidaSubmit();">@RsBase.IMPORTAR</button>
                        </div>
                    </div>

                </div>

            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal-->
}

<div class="overlay" id="divProgress" style="display:none;">
    <div class="preloaderbar show active">
        <span class="bar"></span>
        <span class="text">@RsCadastros.PROCESSANDO ...</span>
    </div>
</div>

<table id="datatable" class="d-none"></table>