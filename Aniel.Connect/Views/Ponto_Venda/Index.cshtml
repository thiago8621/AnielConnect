@model Aniel.Connect.Models.Ponto_VendaListaModel

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.PAINEL_PONTO_VENDA;
    ViewBag.Sessao = RsCadastros.PONTO_VENDA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>

}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

        var rows_selected = [];

        $.holdReady(false);

        var handleDataTableButtons = function () {
            "use strict";

            function AlterarStatusObj(Status) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/ponto_vendaApi/alterarstatus")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected,
                        status: Status

                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });

                rows_selected = [];
            }


            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '73vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/ponto_vendaapi/GetAll',
                    type: 'POST',
                    data: function (data) {

                        // Read values

                        var estado = $("#iEstadosBrasil option:selected").val();
                        var cidade = $("#iCidade option:selected").val();
                        var bairro = $("#iBairro").val();

                        var status = $('#iStatus').val();
                        var supervisor = $("#iSupervisor option:selected").val();
                        var vendedor = $("#iVendedor option:selected").val();

                        if ($("#iCidade option:selected").val() == "Selecione")
                            cidade = null;
                        if ($('#iBairro').val() == "")
                            bairro = null;
                        if ($("#iData_Inicial").val() == "")
                            data_inicial = null;

                        if ($("#iData_Final").val() == "")
                            data_final = null;
                        // Append to data


                        data.Estado = estado;
                        data.Cidade = cidade;
                        data.Bairro = bairro;

                        data.Status_Filtro = status;
                        data.id_supervisor = supervisor;
                        data.id_vendedor = vendedor;

                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "status", title: "@RsCadastros.STATUS" },
                    { data: "nome", title: "@RsCadastros.DESCRICAO", orderable: false },
                    { data: "cep", title: "@RsCadastros.CEP", orderable: false },
                    { data: "logradouro", title: "@RsCadastros.LOGRADOURO", orderable: false },
                    { data: "numero", title: "@RsCadastros.NUMERO", orderable: false },
                    { data: "bairro", title: "@RsCadastros.BAIRRO", orderable: false },
                    { data: "cidade", title: "@RsCadastros.CIDADE", orderable: false },
                    { data: "complemento", title: "@RsCadastros.COMPLEMENTO", orderable: false },
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });

            $("#iPesquisar").on("click", function () {
                $("#modal-filter").modal('hide');
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();

                return true;
            });


            $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {

                $("#iSupervisor").val("");
                $("#iVendedor").val("");
                $("#iEstadosBrasil").val("");
                $("#iCidade").val("");
                $("#iBairro").val("");
                $('#iStatus').val('0,1');

                $('#txtSearch').val("");
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
            });

            $("#btnInativar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);

            });

            $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });

            $("#btnExcluir").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/ponto_vendaApi/excluirlista")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function () {

                @if (AcessoHelper.TemAcesso(_areas, "80"))
                {
                    <text>
                    if (oDatatable.row(this).data() != null) {

                        var _id = oDatatable.row(this).data().id;

                        var url = '@Url.Action("Cadastro", "Ponto_Venda", new { id = "__id__" })';
                        window.location.href = url.replace('__id__', _id);
                        ShowPageLoading();
                    }
                    </text>
                }
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

            $('#iEstadosBrasil').change(function () {

            var estado = $('#iEstadosBrasil option:selected').val();
                var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

            $('#iCidade').empty();

                $.getJSON(enderecoApi, function (data) {
                    $('#iCidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                    $.each(data, function (key, value) {
                        $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
                    });

                });

                @*var estado = $('#iEstadosBrasil option:selected').val();
                  var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

                $("#iCidade").empty();
                //$("#iCidade").val("");
                $("#iBairro").val("");

                $.getJSON(enderecoApi, function (data) {



                    $('#iCidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                    $.each(data, function (key, value) {
                        $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
                    });
                });*@
            });

            $('#iSupervisor').change(function () {

                var id_supervisor = $('#iSupervisor option:selected').val();

                var valorConvertido = parseInt(id_supervisor);

                $('#iIdSupervisorHidden').val(valorConvertido);

            });

            $('#iVendedor').change(function () {

                var id_vendedor = $('#iVendedor option:selected').val();

                var valorConvertido = parseInt(id_vendedor);

                $('#iIdVendedorHidden').val(valorConvertido);

            });



        $('#iCidade').change(function () {

            var cidade = $('#iCidade option:selected').val();
            var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getbairros?Id_Cidade=" + cidade;

            $('#iBairro').empty();
             $('#iBairro').attr(input[type='text']);
            @*$('#iBairro').append($('<option></option>').attr('value', 0).text('@RsBase.SELECIONE'));*@
            $.getJSON(enderecoApi, function (data) {

                $.each(data, function (key, value) {

                $('#iBairro').attr('value', value.id).text(value.descricao);
                   @* $('#iBairro').append($('<option></option>').attr('value', value.id).text(value.descricao));*@
                });

            });

                @*var cidade = $('#iCidade option:selected').val();
                  var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getbairros?Id_Cidade=" + cidade;

                //$("#iCidade").val("");
                $("#iBairro").empty();
                //$("#iBairro").val("");


                $('#iBairro').append($('<option></option>').attr('value', null).text('@RsBase.SELECIONE'));
                $.getJSON(enderecoApi, function (data) {
                    $.each(data, function (key, value) {
                        $('#iBairro').append($('<option></option>').attr('value', value.id).text(value.descricao));
                    })
                });*@
        });


    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-headset"></i> @RsCadastros.LISTAGEM_PONTO_VENDA</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Comercial")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.COMERCIAL</a>
                    </li>

                    <li class="breadcrumb-item">
                        <span>@RsCadastros.LISTAGEM_PONTO_VENDA</span>
                    </li>
                </ol>
            </nav>

            @*<span style="font-size:11px" id="dtLegend"></span>*@
        </div>

        <div class="col-auto mb-3">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.DESCRICAO_OU_CEP" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
                @if (AcessoHelper.TemAcesso(_areas, "80"))
                {
                    <a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "Ponto_Venda")" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>
                }
                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">

                    <a class="dropdown-item" id="btnImportarProspecto" href="@Url.Action("Importacao","Ponto_Venda")">@RsBase.IMPORTAR</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTARLISTAGEM</a>
                    @if (AcessoHelper.TemAcesso(_areas, "177"))
                    {
                        <a class="dropdown-item" id="btnInativar" href="#" onclick="return false;">@RsBase.INATIVAR</a>
                        <a class="dropdown-item" id="btnAtivar" href="#" onclick="return false;">@RsBase.ATIVAR</a>
                    }
                </div>
            </div>
        </div>

    </div>

    <!--./main-->
</div>
<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>


