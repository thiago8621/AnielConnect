                                @Html.DropDownListFor(m => m.Id_Supervisor, new SelectList(ViewBag.Supervisor, "Id", "Nome"), RsBase.SELECIONE, new { @class = "form-control", @id = "iSupervisor", @autocomplete = "off" })
