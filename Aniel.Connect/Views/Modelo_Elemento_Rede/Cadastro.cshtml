@model  Aniel.Connect.Models.T5.Modelo_Elemento_RedeCadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    /**/

    ViewBag.Title = RsCadastros.CADASTRO_MODELO_ELEMENTO_REDE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
<script>

    /** DataTable das Colunas Disponiveis */
    let oDatatableColunasAdicionar = null;
    /** DataTable das Colunas Adicionadas */
    let oDatatableColunas = null;

    function handleExcluirColuna() {
                $(".btnExcluirColuna").unbind('click');
                $(".btnExcluirColuna").click(function (e) {
                    e.preventDefault();

                    var idColuna = $(this).attr("excluir");
                    var Coluna = $(this).attr("coluna");
                    var Descricao = $(this).attr("descricao");
                    var Dinamico = $(this).attr("idcolunadinamica");
                    var trLinkButton = $(this).parents('tr');

                    if (idColuna === "0") {
                        oDatatableColunas.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        if (Dinamico!=="undefined") {
                            oDatatableColunasAdicionar.row.add({
                                Descricao: Descricao,
                                Coluna: Coluna,
                                IdCampoDinamico:Dinamico

                            }).draw(false);
                            //$("#btnAdicionarColuna_"+Coluna).val(Dinamico);

                        }
                        else {
                            oDatatableColunasAdicionar.row.add({
                                Descricao: Descricao,
                                Coluna: Coluna
                            }).draw(false);
                        }

                        handleAdicionar();
                    }
                    else {

                        var link = '@(String.Concat(CONSTANTES.URLPortal, "/api/Modelo_Elemento_RedeApi/ExcluirGridColuna?value="))' + idColuna;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatableColunas.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");

                                    oDatatableColunasAdicionar.row.add({
                                        Descricao: Descricao,
                                        Coluna: Coluna
                                    }).draw(false);
                                    handleAdicionar()

                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }
                });
        }

    var handleDataTableColunas = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Colunas));

            var nome_lista = "Colunas";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            oDatatableColunas = $("#datatableColunas").length && $("#datatableColunas").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                paging: false,
                drawCallback: function () {
                    $(".checkObrigatorio").click(function () {
                        if ($(this).is(":checked")) {
                            $(this).val(true);
                        }
                        else {
                            $(this).val(false);
                        }
                    });
                },
                order:[],
                columns: [
                    {
                        data: "Id",
                        orderable:false,
                        render: function (data, type, row, meta) {
                           /* if (row.Dinamico == null) {*/
                            data = `<a href="#" class="btnExcluirColuna" coluna="${row.Coluna}" id="btnExcluir_${meta.row}" descricao="${row.Descricao}" idcolunadinamica="${TrataNulo(row.IdColunaDinamica)}" excluir="${row.Id}">
                                        <i class="far fa-trash-alt" style = "font-size:16px;padding-right:2px;" >
                                        </i>
                                    </a>
                                    <input id="${nome_lista}_${meta.row}__IdColunaDinamica" name="${nome_lista}[${meta.row}].IdColunaDinamica" type="hidden" idcolunadinamica="${TrataNulo(row.IdColunaDinamica)}" value="${TrataNulo(row.IdColunaDinamica)}">
                                    <input id="${nome_lista}_${meta.row}__Id" name="${nome_lista}[${meta.row}].Id" type="hidden" value="${TrataNulo(data) }">`;

                            if (row.Coluna!=="null") {
                                data += ` <input id="${nome_lista}_${meta.row}__Coluna" name="${nome_lista}[${meta.row}].Coluna" type="hidden" value="${TrataNulo(row.Coluna)}">`;
                            }
                            else {
                                data += ` <input id="${nome_lista}_${meta.row}__Coluna" name="${nome_lista}[${meta.row}].Coluna" type="hidden" value>`;
                            }
                            return data;
                        }
                    },
                    {
                        data: "Descricao",
                        title: "@RsCadastros.NOME",
                        orderable: false,
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = `${data} <input id="${nome_lista}_${meta.row}__Descricao" descricao="${data}" name="${nome_lista}[${meta.row}].Descricao" type="hidden" value="${TrataNulo(data)}">`;
                            }
                            return data;
                        }
                    },
                    {
                        data: "Obrigatorio",
                        title: "@RsCadastros.OBRIGATORIO",
                        orderable: false,
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = `<input class="checkObrigatorio" chave="${meta.row}" name="${nome_lista}[${meta.row}].Obrigatorio" type="checkbox"${(data === true ? 'checked' : '')} value="${data}/>`;
                            }
                            return data;
                        }
                    }
                ]
            });

            handleExcluirColuna();

        },
            TableManageButtonsColunas = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableColunas();
                    }
                }
            }();

        TableManageButtonsColunas.init();

        /**DataTable dos Campos Adicionados no modelo.
         * Bfrti */

        function handleAdicionar() {
            $(".btnAdicionarColuna").unbind('click');
            $(".btnAdicionarColuna").click(function (e) {
                e.preventDefault();

                let Coluna = $(this).attr("adicionar"),
                 Dinamico = $(this).attr("IdCampoDinamico") == "undefined" ? null : $(this).attr("IdCampoDinamico"),
                 Descricao = $(this).attr("descricao");
              /*  var Dinamico = $(this).attr("dinamico");*/

                var trLinkButton = $(this).parents('tr');
                //if(Dinamico==)
                oDatatableColunas.row.add({
                    Descricao: Descricao,
                  /*  Dinamico:Dinamico,*/
                    Coluna: Coluna,
                    Obrigatorio:false,
                    Id: 0,
                    IdColunaDinamica: Dinamico
                }).draw(false);
                handleExcluirColuna();

                oDatatableColunasAdicionar.row(trLinkButton).remove().draw(false);

            });
        }

       async function CampoDyn(arrayDyn) {
            "use strict";

            var ObjDyn = new Object();
            let Dyn = await $.ajax({
                    type: 'POST',
                    dataType: 'json',
                    url: '@String.Concat(CONSTANTES.URLPortal, "/api/Modelo_Elemento_RedeApi/GetCampoDinamico")'
            })
                .then(function (data) {
                    ObjDyn = data;
                    var j = arrayDyn.length;
                    for (var i = 0; i < ObjDyn.objeto.lista.length; i++) {

                        var IdCampo = ObjDyn.objeto.lista[i].id;
                        Object.defineProperties(ObjDyn.objeto.lista[i], {
                            Coluna: {
                                value: null
                            },
                            idcolunaDinamica: { value:IdCampo}

                        });

                        ObjDyn.objeto.lista[i].Descricao = ObjDyn.objeto.lista[i].descricao,
                        delete ObjDyn.objeto.lista[i].descricao;
                        arrayDyn.push(data.objeto.lista[i]);
                        j++;
                    }

                /* array.concat(arrayDyn);*/
                    return data;

                }).fail(function () { Notificar("@RsBase.ATENCAO_", "Erro ao Coletar Campos Dinamicos", "warning"); });
        }


        var handleDataTableColunasAdicionar = async  function () {

            /**Array principal para a definição das colunas*/
            let array = @(Html.GetArrayEnum<Aniel.T5.Model.enumerado.ColunaModeloElementoEnum>());

            let enum_values = @(Json.Encode(Enum.GetValues(typeof (Aniel.T5.Model.enumerado.ColunaModeloElementoEnum)).Cast<Aniel.Connect.Model.enumerado.Coluna_PainelServicoEnum>()));@*@Html.Raw(Json.Encode(Model.Filtros))*@
            array = array.map((p, i) => ({ Descricao: p, Coluna: enum_values[i]}));


            /**Lista das Colunas adicionadas */
            var array_adicionadas = @Html.Raw(Json.Encode(Model.Colunas));
            await CampoDyn(array);

            for (let x of array)
            {
                delete x['tipo']; delete x['tipoStr']; delete x['gravado']; delete x['opcoesStr']; delete x['opcoes']; delete x['id'];
            }

            array = array.filter(p => array_adicionadas.map(y => y.Coluna).filter(y => y == p.Coluna).length == 0);

            oDatatableColunasAdicionar = $("#datatableColunasAdicionar").length && $("#datatableColunasAdicionar").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                order: [],
                paging: false,
                columns: [
                    {
                        data: "Descricao",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = `<a href="#" class="btnAdicionarColuna p-3" idcampodinamico="${row.idcolunaDinamica}" descricao="${data}" id="btnAdicionarColuna_'${row.Coluna}" adicionar="${row.Coluna}">
                                            <i class="fas fa-plus-circle PR-2" style="font-size:16px;"></i>
                                        </a>
                                        ${data}`;
                            }
                            return data;
                            }

                    }
                ]
            });

            handleAdicionar();

        },
            TableManageColunasAdicionar = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableColunasAdicionar();
                    }
                }
            }();

        TableManageColunasAdicionar.init();

        $('#iTemCarencia').change(function () {
            if ($('#iTemCarencia').is(':checked')) {
                $('#iDivPeriodoCarencia').show();
                $('#iDivMultaCarencia').show();
            }
            else {
                $('#iDivPeriodoCarencia').hide();
                $('#iDivMultaCarencia').hide();
            }
        });

        $('#iArquivo').on('change', function () {

            var myfile = $(this).val();
            var ext = myfile.split('.').pop();
            if (!ext == "docx") {

                Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_DOCX", "warning");
                $(this).val("");
            }
            else {

                var arquivo = $(this)[0].files[0];
                getBase64($("#btnDownloadModelo"), arquivo)

                var fileName = arquivo.name;
                $(this).next('.custom-file-label').html(fileName);
            }
        });

        function getBase64(btnDownload, arquivo) {

            var reader = new FileReader();
            reader.onload = function (e) {

                btnDownload.prop('href', e.target.result)
                btnDownload.prop('download', arquivo.name)
            }

            reader.readAsDataURL(arquivo)
        }

        var clicked = false;

        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;

            let erro = false;

            if (ValidaCamposObrigatorios(erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning");
                erro = true
            }
            if (oDatatableColunas.data().length == 0)
            {
                Notificar("@RsBase.ATENCAO_", "Modelo sem parâmetros para Recepção de Dados", "warning");
                erro = true;
            }



            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();

        }
         function Exibircadastro_campo(id)
        {
            //pegar o id do checkbox
          id = 1;


            //pmodal, presizable, ptitle, purl,
            ShowDialog(true, true, '@RsCadastros.CADASTRO', '@Url.Action("CadastroCampo","Modelo_Elemento_Rede")'/*+`?Id=${id}`*/, 'divCadastroCampo', 960, 540, 'iframeCadastro',
                    function () {
                        try {

                            setTimeout(function () {
                                rows_selected = [];

                            }, 500);

                        }
                        catch {
                            setTimeout(function () {
                                rows_selected = [];

                            }, 500);
                        }
                    }
            );

             ShowPageLoading();
        }

        $(document).ready(function () {

        });

</script>

    <script src="~/bin/Scripts/download.js"></script>
}

<div style="padding:10px">
    <div class="card" style="border:none;">

    </div>
</div>

@using (Html.BeginForm("Cadastro", "Modelo_Elemento_Rede", FormMethod.Post, new { enctype = "multipart/form-data", @id = "form", autocomplete = "off" }))
{
    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">

                <div class="row">

                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-server"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">

                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index","Projeto_Rede")" style="color: #367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.ANIEL_GEOGRAPHY</a>
                                </li>

                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index","Modelo_Elemento_Rede")" style="color: #367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_MODELO_ELEMENTO_REDE</a>
                                </li>

                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>

                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>

                    </div>
                    <div class="col-sm-1">
                        <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                        </button>

                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">

                            <a class="dropdown-item" onclick=" return Exibircadastro_campo(1); return false;">Cadastrar Novo Campo</a>

                        </div>
                    </div>

                </div>

                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <span class="text-bold-card pt-0">@ViewBag.Title</span>
                        </h5>
                    </div>

                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body">
                            <div class="row">

                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iId"><strong>@RsCadastros.ID</strong></label>
                                        @Html.TextBoxFor(model => model.Id, new { @class = "form-control", @id = "iId", disabled = "disabled", @autocomplete = "off" })

                                    </div>
                                </div>

                                <div class="col-sm-4 mr-auto">
                                    <div class="form-group">
                                        <label for="iDescricao"><strong>@RsCadastros.DESCRICAO do Modelo de Elemento de Rede</strong></label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control obrigatorio", @id = "iDescricao", @autocomplete = "off", @maxlength = "100" })

                                    </div>
                                </div>

                                @if (Model.Id != 0)
                                {
                                    <div class="col-sm-2">
                                        <label for="iStatus" class="mr-3">@RsCadastros.STATUS:</label>
                                        <div class="form-group">
                                            @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @style = "min-width: 52px;", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>
                                }

                            </div>

                        </div>
                    </div>
                </div>

                <div class="row mt-2">

                    <div class="col-sm-6">
                        <div role="tabpanel" class="tab-pane-active " id="iColunaDisponivel">
                            <div class="card div-card-accord">
                                <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                                    <div class="card-body">
                                        <div class="card-header title-card ">
                                            <h5 class="text-bold-card"> @RsCadastros.CAMPOS_DISPONIVEIS</h5>
                                        </div>

                                        <div class="row">
                                            <div class="col-sm-12">
                                                <div class="form-group">
                                                    <table class="table table-hover nowrap" id="datatableColunasAdicionar" style="width:100%"></table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div role="tabpanel" class="tab-pane-active " id="iColunaDisponivel">
                            <div class="card div-card-accord">
                                <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                                    <div class="card-body">
                                        <div class="card-header title-card ">
                                            <h5 class="text-bold-card"> @RsCadastros.CAMPOS_ADICIONADOS</h5>
                                        </div>

                                        <div class="row">
                                            <div class="col-sm-12">
                                                <div class="form-group">
                                                    <table class="table table-hover nowrap" id="datatableColunas" style="width:100%"></table>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div id="divCadastroCampo"></div>
}

<!--Button Float-->
<a href="@Url.Action("Index", "Modelo_Elemento_Rede")" class="float-cancel" onclick="ShowPageLoading(); return true;">
    <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
        <i class="fas fa-times fa-2x"></i>
    </div>
</a>

<a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
    <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
        <i class="fas fa-save fa-2x"></i>
    </div>
</a>

