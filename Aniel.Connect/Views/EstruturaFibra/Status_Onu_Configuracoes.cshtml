@model Aniel.Connect.Models.StatusOnuConfiguracoes

@using Resources

@{    
    ViewBag.Title = RsCadastros.STATUS_EQUIPAMENTO;
    ViewBag.Sessao = RsCadastros.STATUS_EQUIPAMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script>
        $("#iInfoBasicas").on('click', function () {
            ShowPageLoading()
            window.location.href = '@Url.Action("Status_Onu_Informacoes_Basicas", "EstruturaFibra")?Id_Onu=@Model.Id_Onu';
        });

        $("#iHardware").on('click', function () {
            ShowPageLoading()
            window.location.href = '@Url.Action("Status_Onu_Hardware", "EstruturaFibra")?Id_Onu=@Model.Id_Onu';
        });

        $("#iConfEquipamento").on('click', function () {
            ShowPageLoading()
            window.location.href = window.location.href;
        });

        $("#iPingExterno").on('click', function () {
            ShowPageLoading()
            window.location.href = '@Url.Action("Status_Onu_Ping", "EstruturaFibra")?Id_Onu=@Model.Id_Onu';
        });
    </script>
}

<div class="container-fluid" id="divTitle">
    <ul class="nav nav-tabs" id="tab" role="tablist">
        <li class="nav-item">
            <a class="nav-link " id="iInfoBasicas" data-toggle="tab" href="#" role="tab" aria-selected="false">@RsCadastros.INFORMACOES_BASICAS</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="iHardware" data-toggle="tab" href="#" role="tab" aria-selected="false">@RsCadastros.HARDWARE</a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" id="iConfEquipamento" data-toggle="tab" href="#" role="tab" aria-selected="true">@RsCadastros.CONFIGURACOES_EQUIPAMENTO</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="iPingExterno" data-toggle="tab" href="#" role="tab" aria-selected="false">@RsCadastros.PING_EXTERNO</a>
        </li>
    </ul>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.NOME_SERVICO:</label>
            <span class="form-group">@(Model.Nome_Servico ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.MODO_CONEXAO:</label>
            <span class="form-group">@(Model.Modo_Conexao ?? "-")</span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.TIPO_CONEXAO:</label>
            <span class="form-group">@(Model.Tipo_Conexao ?? "-")</span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.VLAN_ID:</label>
            <span class="form-group">@(Model.VLAN_ID ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.VLAN_COS:</label>
            <span class="form-group">@(Model.VLAN_COS ?? "-")</span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.NAT:</label>
            <span class="form-group">@(Model.NAT ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.TIPO_IP:</label>
            <span class="form-group">@(Model.Tipo_IP ?? "-")</span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.PPPOE_PROXY:</label>
            <span class="form-group">@(Model.PPPOE_Proxy ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.PPPOE_USUARIO:</label>
            <span class="form-group">@(Model.PPPOE_Usuario ?? "-")</span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.PPPOE_SERVICENAME:</label>
            <span class="form-group">@(Model.PPPOE_ServicoName ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.IP:</label>
            <span class="form-group">@(Model.IP_Estatico ?? "-")</span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
        <label class="fs-12">@RsCadastros.IP_MASK:</label>
        <span class="form-group">@(Model.IP_Mascara ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.IP_GATEWAY:</label>
            <span class="form-group">@(Model.IP_Gateway ?? "-")</span>
        </div>        
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.DNS_MASTER:</label>
            <span class="form-group">@(Model.DNS_Master ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.DNS_SLAVE:</label>
            <span class="form-group">@(Model.DNS_Slave ?? "-")</span>
        </div>        
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.PPPOE_MODE:</label>
            <span class="form-group">@(Model.PPPOEMODE ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.QOS:</label>
            <span class="form-group">@(Model.QoS ?? "-")</span>
        </div>        
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.PORTA_ONU:</label>
            <span class="form-group">@(Model.Porta_ONU ?? "-")</span>
        </div>
    </div>


    <!--./main-->
</div>