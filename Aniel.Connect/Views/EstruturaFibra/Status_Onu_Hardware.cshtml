@model Aniel.Connect.Models.StatusOnuHardware

@using Resources

@{
    ViewBag.Title = RsCadastros.STATUS_EQUIPAMENTO;
    ViewBag.Sessao = RsCadastros.STATUS_EQUIPAMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script>
        $("#iInfoBasicas").on('click', function () {
            ShowPageLoading()
            window.location.href = '@Url.Action("Status_Onu_Informacoes_Basicas", "EstruturaFibra")?Id_Onu=@Model.Id_Onu';
        });

        $("#iHardware").on('click', function () {
            ShowPageLoading()
            window.location.href = window.location.href;
        });

        $("#iConfEquipamento").on('click', function () {
            ShowPageLoading()
            window.location.href = '@Url.Action("Status_Onu_Configuracoes", "EstruturaFibra")?Id_Onu=@Model.Id_Onu';
        });

        $("#iPingExterno").on('click', function () {
            ShowPageLoading()
            window.location.href = '@Url.Action("Status_Onu_Ping", "EstruturaFibra")?Id_Onu=@Model.Id_Onu';
        });
    </script>
}

<div class="container-fluid" id="divTitle">
    <ul class="nav nav-tabs" id="tab" role="tablist">
        <li class="nav-item">
            <a class="nav-link " id="iInfoBasicas" data-toggle="tab" href="#" role="tab" aria-selected="false">@RsCadastros.INFORMACOES_BASICAS</a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" id="iHardware" data-toggle="tab" href="#" role="tab" aria-selected="true">@RsCadastros.HARDWARE</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="iConfEquipamento" data-toggle="tab" href="#" role="tab" aria-selected="false">@RsCadastros.CONFIGURACOES_EQUIPAMENTO</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="iPingExterno" data-toggle="tab" href="#" role="tab" aria-selected="false">@RsCadastros.PING_EXTERNO</a>
        </li>
    </ul>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.MODELO:</label>
            <span class="form-group">@(Model.Modelo ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.VERSAO_SOFTWARE:</label>
            <span class="form-group">@(Model.Versao_Software ?? "-")</span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.CPU:</label>
            <span class="form-group">@(Model.CPU ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.MEMORIA:</label>
            <span class="form-group">@(Model.Memoria ?? "-")</span>
        </div>
    </div>
</div>


