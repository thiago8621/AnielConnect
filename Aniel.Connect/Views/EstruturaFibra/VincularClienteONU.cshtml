@model Aniel.Connect.Models.ClienteVinculoONUCadastro

@using Resources

@{
    var valor_divida = Request.Params["valor_divida"];

    ViewBag.Title = RsCadastros.PROVISIONAMENTO;
    ViewBag.Sessao = RsCadastros.PROVISIONAMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.Render("~/Content/cssDataTable")

    <style>
        .select2-dropdown {
            z-index: 1500 !important;
        }

        #iValorRecebidoSwal, #iDataRecebimentoSwal::placeholder {
            text-align: center
        }

        #iValorRecebidoSwal, #iDataRecebimentoSwal {
            text-align: center
        }

        .ui-dialog .ui-dialog-title {
            float: none !important;
        }
    </style>
}


@section  scripts
{
    @Scripts.Render("~/bundles/jsDataTable")
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/maskip")

    <script>

        var OLTSelecionada = null;
        var HandleOLT = function () {
            // Categoria do Cliente
            $('#iId_OLT').on('select2:select select2:unselecting', function (e) {
                OLTSelecionada = e.params.data;

                $('#iId_Slot').val(null).trigger('change');

                AddSelect("iId_Slot", "@CONSTANTES.URLPortal/api/SlotApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, OLTSelecionada.id, null, "@RsBase.SELECIONE", false);

                return true;
            });
        };

        var SLOTSelecionada = null;
        var HandleSLOT = function () {
            // Categoria do Cliente
            $('#iId_Slot').on('select2:select select2:unselecting', function (e) {
                SLOTSelecionada = e.params.data;

                $('#iId_PON').val(null).trigger('change');

                AddSelect("iId_PON", "@CONSTANTES.URLPortal/api/PONapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, SLOTSelecionada.id, null, "@RsBase.SELECIONE", false);

                return true;
            });
        };

        AddSelect("iId_OLT", "@CONSTANTES.URLPortal/api/OLTapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_OLT", "@RsBase.SELECIONE", false, HandleOLT);

        AddSelect("iId_Slot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, "@Model.Id_OLT", "@Model.Id_Slot", "@RsBase.SELECIONE", false, HandleSLOT);

        AddSelect("iId_PON", "@CONSTANTES.URLPortal/api/PONapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, "@Model.Id_Slot", "@Model.Id_PON", "@RsBase.SELECIONE", false);



        @if (!String.IsNullOrEmpty(Request.Params["Sucesso"]))
        {
            <text>
                $(document).ready(function () {

                    parent.dial.dialog('close');
                })
            </text>
        }
        else {
            <text>
                $(document).ready(function () {

                });
            </text>
        }

        $(document).ready(function () {

        })



        let clicked = false;
        function ValidaSubmit()
        {


            clicked = true;

            let erro = false;

            
            clicked = true;

            
            if (ValidaCamposObrigatorios(erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            

            
           if (erro) {
                clicked = false;
                return false;
           }

            
            ShowPageLoading();

            $('#form').submit();

        }


    </script>
}

@using (Html.BeginForm("VincularClienteONU", "EstruturaFibra", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.Id_ONU)

    <div class="container-fluid" id="divTitle">

        <div class="row justify-content-center">
            <div class="col-12">
                <label for="iCliente" class="fs-12">@RsCadastros.CLIENTE</label>
                <div class="form-group">
                    @Html.TextBoxFor(model => model.Cliente, new { @id = "iCliente", @class = "form-control readonly", @autocomplete = "off" })
                </div>
            </div>
            <div class="col-4">
                <label for="iId_OLT" class="fs-12">@RsCadastros.OLT</label>
                <div class="form-group">
                    @Html.DropDownListFor(p => p.Id_OLT, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iId_OLT", @autocomplete = "off" })
                    @Html.ValidationMessageFor(model => model.Id_OLT, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-4">
                <label for="iId_Slot" class="fs-12">@RsCadastros.SLOT</label>
                <div class="form-group">
                    @Html.DropDownListFor(p => p.Id_Slot, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iId_Slot", @autocomplete = "off" })
                    @Html.ValidationMessageFor(model => model.Id_Slot, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-4">
                <label for="iId_PON" class="fs-12">@RsCadastros.PON</label>
                <div class="form-group">
                    @Html.DropDownListFor(p => p.Id_PON, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iId_PON", @autocomplete = "off" })
                    @Html.ValidationMessageFor(model => model.Id_PON, "", new { @class = "text-danger" })
                </div>
            </div>


        </div>


        <div class="form-group col-sm-12 mt-2" style="padding: 5px;">
            <div class="text-center">
                <button type="button" onclick="parent.dial.dialog('close'); return false;" class="btn btn-danger" id="iCancelar" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" onclick="ValidaSubmit()" id="iSalvar">@RsBase.SALVAR</button>
            </div>
        </div>

        <!--./main-->
    </div>
}


