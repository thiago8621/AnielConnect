@model Aniel.Connect.Models.StatusOnuInformacoesBasicas

@using Resources

@{
    ViewBag.Title = RsCadastros.STATUS_EQUIPAMENTO;
    ViewBag.Sessao = RsCadastros.STATUS_EQUIPAMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script>
        $("#iInfoBasicas").on('click', function () {
            ShowPageLoading()
            window.location.href = window.location.href;
        });

        $("#iHardware").on('click', function () {
            ShowPageLoading()
            window.location.href = '@Url.Action("Status_Onu_Hardware","EstruturaFibra")?Id_Onu=@Model.Id_Onu';
        });

        $("#iConfEquipamento").on('click', function () {
            ShowPageLoading()
            window.location.href = '@Url.Action("Status_Onu_Configuracoes","EstruturaFibra")?Id_Onu=@Model.Id_Onu';
        });

        $("#iPingExterno").on('click', function () {
            ShowPageLoading()
            window.location.href = '@Url.Action("Status_Onu_Ping","EstruturaFibra")?Id_Onu=@Model.Id_Onu';
        });
    </script>
}

<div class="container-fluid" id="divTitle">
    <ul class="nav nav-tabs" id="tab" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" id="iInfoBasicas" data-toggle="tab" href="#" role="tab" aria-selected="true">@RsCadastros.INFORMACOES_BASICAS</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="iHardware" data-toggle="tab" href="#" role="tab" aria-selected="false">@RsCadastros.HARDWARE</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="iConfEquipamento" data-toggle="tab" href="#" role="tab" aria-selected="false">@RsCadastros.CONFIGURACOES_EQUIPAMENTO</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="iPingExterno" data-toggle="tab" href="#" role="tab" aria-selected="false">@RsCadastros.PING_EXTERNO</a>
        </li>
    </ul>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.TEMPO_ONLINE:</label>
            <span class="form-group">@(Model.TempoOnline ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.STATUS:</label>
            <span class="form-group">@(Model.Status ?? "-")</span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.TIPO_AUTENTICACAO:</label>
            <span class="form-group">@(Model.Auth ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.INFO_AUTENTICACAO:</label>
            <span class="form-group">@(Model.Auth_Info ?? "-")</span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">Temperatura:</label>
            <span class="form-group">@(Model.Temperatura ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">Status Temperatura:</label>
            <span class="form-group">@(Model.StatusTemperatura ?? "-")</span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.SINAL_RX (ONU):</label>
            <span class="form-group">@(Model.Rx ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.SINAL_TX (ONU):</label>
            <span class="form-group">@(Model.Tx ?? "-")</span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.SINAL_RX (OLT):</label>
            <span class="form-group">@(Model.Rx_OLT ?? "-")</span>
        </div>
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.SINAL_TX (OLT):</label>
            <span class="form-group">@(Model.Tx_OLT ?? "-")</span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.DISTANCIA:</label>
            <span class="form-group">@(Model.Distancia ?? "-")</span>
        </div>

        <div class="col-sm-4">
            <label class="fs-12">@RsCadastros.VOLTAGEM:</label>
            <span class="form-group">@(Model.Voltagem ?? "-")</span>
        </div>
    </div>
</div>
