@model  Sinapse.Util.ExcelServiceLog<Aniel.Connect.Models.ONU_Importacao>

@{
    ViewBag.Title = RsCadastros.IMPORTAR_ONUS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    ViewBag.Modelo = CONSTANTES.URLPortal + @"/Arquivos/ONU/Modelo_Padrao_Importacao_Onus.xlsx";
}

@section styles
{
    @Styles.Render("~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />

    <style>
        .popover{
            max-width: 45%; /* Max Width of the popover (depending on the container!) */
        }

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}


@section  scripts
{
    @Scripts.Render("~/bundles/jsDataTable")
    <script src="~/bin/Scripts/download.js"></script>

    <script>

        let datatableExportMuni
        var oDatatable = undefined        

        $('#iArquivo').on('change', function () {

            var myfile = $(this).val();
            var ext = myfile.split('.').pop();
            if (!(ext == "xls" || ext == "xlsx")) {

                Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                $(this).val("");
            }
            else {

                var arquivo = $(this)[0].files[0];

                var fileName = arquivo.name;
                $(this).next('.custom-file-label').html(fileName);
            }
        });

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;
            var erro = false;

            myfile= $("#iArquivo").val();
            if (!myfile) {

                if ($('#iArquivo').next('.custom-file-label').html() == '') {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ARQUIVO)", "warning");
                    erro = true;
                }
                else {

                    var ext = $('#iArquivo').next('.custom-file-label').html().split('.').pop();
                    if (!(ext == "xlsx" || ext == "xls")) {

                        Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                        erro = true;
                    }
                }
            }
            else {

                var ext = myfile.split('.').pop();
                if (!(ext == "xlsx" || ext == "xls")) {

                    Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                    erro = true;
                }
            }

            if (erro) {

                clicked = false;
                return false;
            }

            $("#divProgress").show();

            $('#form').submit();
        }

        $(document).ready(function () {
              $('[data-toggle="popover"]').popover()

            var background = "@Html.Raw(ViewBag.Background)";

            if (background == "S") {
                Notificar("@RsCadastros.INFORMACAO", "Devido ao grande volume de dados a importação está sendo realizada em segudo plano, após a conclusão você será notificado no sistema!", "info");
            }
            else {
                var sucesso = "@Html.Raw(ViewBag.Sucesso)";
                if (sucesso == "S") {
                    Notificar("@RsCadastros.INFORMACAO", "@RsCadastros.IMPORTACAO_ONUS_FINALIZADA", "info");
                }

                @if (ViewBag.Erro == "S")
                {                
                    <text>
                    Notificar("Operação Finalizada", "Importação concluida com sucesso, verifique os logs para mais informações.", "info");
                    </text>                
                }
            }
            

        });

    </script>


