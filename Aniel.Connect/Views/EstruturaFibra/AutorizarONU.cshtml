                            <select class="form-control obrigatorio" id="iModal_Cliente"></select>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <label for="iModal_Contrato">@RsCadastros.CONTRATO_CLIENTE:</label>
                            <br />
                            <select class="form-control obrigatorio" id="iModal_Contrato"></select>
                        </div>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <label for="iModal_ClientePlanoProd">@RsCadastros.PLANOSPRODUTOS_CLIENTE:</label>
                            <br />
                            <select class="form-control obrigatorio" id="iModal_ClientePlanoProd"></select>
                        </div>
