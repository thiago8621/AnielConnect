                <div class="row mb-2">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <label for="iModal_PerfilAtivacao">@RsCadastros.PERFIL_ATIVACAO:</label>
                            <br />
                            <select class="form-control obrigatorio" id="iModal_PerfilAtivacao"></select>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <label for="iModal_SsidWifi">@RsCadastros.SSID_WIFI:</label>

                            <input type="text" class="form-control" id="iModal_SsidWifi">
