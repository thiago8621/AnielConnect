                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <label for="iModal_SenhaWifi">@RsCadastros.SENHA_WIFI:</label>

                            <input type="text" class="form-control" id="iModal_SenhaWifi">
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <label for="iModal_NumOS">@RsCadastros.NUMERO_ORDEM_SERVICO:</label>

                            <input type="text" class="form-control" id="iModal_NumOS">
                        </div>
                    </div>
                </div>

                <div class="form-group mt-4">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" data-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-success ml-2" id="btnVincularClientePlanoProd">Vincular</button>
                    </div>
                </div>

            </div>
            <!--<div class="modal-footer">
                <div class="text-center">
                    <button type="button" class="btn btn-danger" data-dismiss="iModal_Alterar_FormaPagto" id="btnAlterarFormaPagto">Cancelar</button>
                    <button type="button" class="btn btn-success" id="btnAlterarFormaPagto">Alterar</button>
                </div>
            </div>-->
        </div>
    </div>
</div>

<!-- Modal de Confirmação -->
<div class="modal fade" id="modalConfirmacaoOS" tabindex="-1" role="dialog" aria-labelledby="modalConfirmacaoOSTitulo" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
