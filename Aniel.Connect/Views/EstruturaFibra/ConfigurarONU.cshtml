@using Microsoft.AspNet.Identity
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado

@model Sinapse.Integracao.Ativacao.Models.ConfigurarONUModel

@{
    ViewBag.Title = RsCadastros.CONFIGURAR_ONU;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    <style>
        #listVariaveis, #listVariaveisONU {
            overflow-y: auto;
            padding-left: 15px;
            margin: 0
        }

        #listVariaveis li, #listVariaveisONU li {
            list-style: none
        }
    </style>
}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/maskip")

<script>

        let carregandoAddSelect, ip, statusOnu, statusOnuStr, dataHoraUltimaAtualizacaoOnu, bloquearCampos;

        $("#iDiagnosticoONU").on("click", function () {
            ShowDialog(true, true, '@Html.Raw(RsCadastros.DIAGNOSTICO_ONU)', '@Url.Action("Status_Onu_Informacoes_Basicas", "EstruturaFibra")?Id_ONU=@Model.Id', 'divDiagnosticoONU', 900, 600, 'iframeDiagnosticoONU');
        })

        //#region StatusOnu
        function atualizaStatusOnu() {
            $("#iBtnAtualizaStatusOnuElement").addClass("fa-spin");
            document.getElementById("iCirculoStatusOnu").style.color = "gray";
            document.getElementById("iStatusOnu").style.color = "gray";
            document.getElementById("iStatusOnu").innerHTML = "Consultando...";
            document.getElementById("iUltimaAtualizacaoStatusOnu").innerHTML = "-";

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/IntegracaoAtivacaoApiController/GetStatusONUById?IdOnu="+Model.Id)';

            $.ajax({
                url: link,
                type: 'GET',
                dataType: 'json',                
            })
            .done(function (data) {

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");                                        
                }
                else {
                    let mensagemTratada = data.mensagem;
                    if (data.innerException) {
                        mensagemTratada += '\n Motivo:' + data.innerException;
                    }

                    Notificar("@RsBase.ATENCAO_", mensagemTratada, "warning");                    
                }

                if (data.objeto) {
                    statusOnu = data.objeto.status;
                    statusOnuStr = data.objeto.statusStr;
                    dataHoraUltimaAtualizacaoOnu = data.objeto.dataHoraUltimaAtualizacaoStr;
                }
                refreshCamposStatusOnu();
                $("#iBtnAtualizaStatusOnuElement").removeClass("fa-spin");
            });
        }

        function refreshCamposStatusOnu() {
            document.getElementById("iStatusOnu").innerHTML = statusOnuStr;
            document.getElementById("iUltimaAtualizacaoStatusOnu").innerHTML = dataHoraUltimaAtualizacaoOnu;
            //document.getElementById("iStatusOnu").style.fontWeight = 'bold'

            if (statusOnu == 0) {                
                document.getElementById("iCirculoStatusOnu").style.color = "green"; //Online                                
                document.getElementById("iStatusOnu").style.color = "green"; //Online                                
            }
            else if (statusOnu == 2) {                
                document.getElementById("iCirculoStatusOnu").style.color = "gray"; //Indisponivel                               
                document.getElementById("iStatusOnu").style.color = "gray"; //Indisponivel                               
            }
            else {               
                document.getElementById("iCirculoStatusOnu").style.color = "red"; //Offline / Erro                                
                document.getElementById("iStatusOnu").style.color = "red"; //Offline / Erro                                
            }
        }
        //#endregion

        //#region Script

        $("#iScriptOLT, #iModeloScriptOLT").on("mouseup", function() {

            const scriptHeight = Number($("#iScriptOLT").css("height").replace("px", ""))
            const modeloScriptHeight = Number($("#iModeloScriptOLT").css("height").replace("px", ""))

            const newHeight = scriptHeight + modeloScriptHeight + 26

            $("#listVariaveis").css("height", newHeight + "px")
        })

        $("#iScriptONU, #iModeloScriptONU").on("mouseup", function () {

            const scriptHeight = Number($("#iScriptONU").css("height").replace("px", ""))
            const modeloScriptHeight = Number($("#iModeloScriptONU").css("height").replace("px", ""))

            const newHeight = scriptHeight + modeloScriptHeight + 26

            $("#listVariaveisONU").css("height", newHeight + "px")
        })

        $("#iScriptOLT").on("keyup", function () {
            var scriptOLT = $(this).val()

            const script = scriptOLT
                              .replace("GABINETE", $("#iGabinete").val() != "" ? $("#iGabinete").val() : "GABINETE")
                              .replace("GEM_PORT", $("#iGemPort").val() != "" ? $("#iGemPort").val() : "GEM_PORT")
                              .replace("IP_GERENCIA", ip.getIp() != "" ? ip.getIp() : "IP_GERENCIA")
                              .replace("LOGIN_ONU_CLIENTE", $("#iLoginONU").val() != "" ? $("#iLoginONU").val() : "LOGIN_ONU_CLIENTE")
                              .replace("NOME", $("#iNome").val() != "" ? $("#iNome").val() : "NOME")
                              .replace("OLT_DOWNLOAD", $("#iDownload").val() != "" ? $("#iDownload").val() : "OLT_DOWNLOAD")
                              .replace("OLT_UPLOAD", $("#iUpload").val() != "" ? $("#iUpload").val() : "OLT_UPLOAD")
                              .replace("OLT_IP", $("#iIpOLT").val() != "" ? $("#iIpOLT").val() : "OLT_IP")
                              .replace("OLT_ID", $("#iOLT").val() != "" ? $("#iOLT").val() : "OLT_ID")
                              .replace("ONU_MAC", $("#iMAC").val() != "" ? $("#iMAC").val() : "ONU_MAC")
                              .replace("ONU_TIPO", $("#iDescricao").val() != "" ? $("#iDescricao").val() : "ONU_TIPO")
                              .replace("PLANO_CLIENTE", $("#iPlano").text() != "" ? $("#iPlano").text() : "PLANO_CLIENTE")
                              .replace("SLOT_ID", $("#iSlot").val() != "" ? $("#iSlot").val() : "SLOT_ID")
                              .replace("PON_ID", $("#iPON").val() != "" ? $("#iPON").val() : "PON_ID")
                              .replace("PORTA_TELNET_ONU", $("#iPortaTelnet").val() != "" ? $("#iPortaTelnet").val() : "PORTA_TELNET_ONU")
                              .replace("VLAN_UPLINK", $("#iVlanUplink").val() != "" ? $("#iVlanUplink").val() : "VLAN_UPLINK")
                              //.replace("PPPOE_LOGIN", $("#i").val() != "" ? $("#iPortaTelnet").val() : "PORTA_TELNET_ONU")

            $("#iModeloScriptOLT").val(script)

            // Update do campo em base64
            $("#iScriptOLTBase64").val(btoa(scriptOLT))
        })

        /*$("#iScriptONU").on("keyup", function () {
            const scriptONU = $(this).val()

            const script = scriptONU
                              .replace("GABINETE", $("#iGabinete").val() != "" ? $("#iGabinete").val() : "GABINETE")
                              .replace("GEM_PORT", $("#iGemPort").val() != "" ? $("#iGemPort").val() : "GEM_PORT")
                              .replace("IP_GERENCIA", ip.getIp() != "" ? ip.getIp() : "IP_GERENCIA")
                              .replace("LOGIN_ONU_CLIENTE", $("#iLoginONU").val() != "" ? $("#iLoginONU").val() : "LOGIN_ONU_CLIENTE")
                              .replace("NOME", $("#iNome").val() != "" ? $("#iNome").val() : "NOME")
                              .replace("OLT_DOWNLOAD", $("#iDownload").val() != "" ? $("#iDownload").val() : "OLT_DOWNLOAD")
                              .replace("OLT_UPLOAD", $("#iUpload").val() != "" ? $("#iUpload").val() : "OLT_UPLOAD")
                              .replace("OLT_IP", $("#iIpOLT").val() != "" ? $("#iIpOLT").val() : "OLT_IP")
                              .replace("OLT_ID", $("#iOLT").val() != "" ? $("#iOLT").val() : "OLT_ID")
                              .replace("ONU_MAC", $("#iMAC").val() != "" ? $("#iMAC").val() : "ONU_MAC")
                              .replace("ONU_TIPO", $("#iDescricao").val() != "" ? $("#iDescricao").val() : "ONU_TIPO")
                              .replace("PLANO_CLIENTE", $("#iPlano").text() != "" ? $("#iPlano").text() : "PLANO_CLIENTE")
                              .replace("SLOT_ID", $("#iSlot").val() != "" ? $("#iSlot").val() : "SLOT_ID")
                              .replace("PON_ID", $("#iPON").val() != "" ? $("#iPON").val() : "PON_ID")
                              .replace("PORTA_TELNET_ONU", $("#iPortaTelnet").val() != "" ? $("#iPortaTelnet").val() : "PORTA_TELNET_ONU")
                              .replace("VLAN_UPLINK", $("#iVlanUplink").val() != "" ? $("#iVlanUplink").val() : "VLAN_UPLINK")
                              //.replace("PPPOE_LOGIN", $("#i").val() != "" ? $("#iPortaTelnet").val() : "PORTA_TELNET_ONU")

            $("#iModeloScriptONU").val(script)

            // Update do campo em base64
            $("#iScriptONUBase64").val(btoa(scriptONU))
        })*/

        //#endregion
        let primeiraVez = true;
        $(document).ready(async function () {
            $("#iUsuario").val("@User.Identity.GetUserId()")            

            @if(Model.Id != 0)
            {
                <text>
                    bloquearCampos = true;
                    statusOnu = @(Model.StatusOnu.HasValue ? (int)Model.StatusOnu : (int)Sinapse.Model.enumerados.StatusONU.Indisponivel);
                    statusOnuStr = "@Html.Raw(Model.StatusOnu.HasValue ? Model.StatusOnu.Value.ToString() : RsCadastros.INDISPONIVEL)";
                    dataHoraUltimaAtualizacaoOnu = "@Html.Raw(Model.UltimaAtualizacaoStatus)";
                    $('#divAtualizacaoStatusOnu').show();
                    refreshCamposStatusOnu();
                    $('#iOLT').prop('disabled', true);
                    $('#iSlot').prop('disabled', true);
                    $('#iPON').prop('disabled', true);
                    $('#iCliente').prop('disabled', true);
                    $('#iPlano').prop('disabled', true);
                    $('#iLogin').prop('disabled', true);

                </text>
            }
            else
            {
                <text>
                    bloquearCampos = false;
                    $('#divAtualizacaoStatusOnu').hide();
                </text>
            }

            ip = $('#iIp').ipInput();
            ip.setIp('@Model.IpGerencia');

            function toggleFields() {
                var idValue = $("#iId").val();
                var isIdZero = parseInt(idValue) === 0;


                $("#iMAC, #iSerial, #iOntID, #iMarcaModelo").prop("disabled", !isIdZero);

            }


            toggleFields();


            $("#iId").on("change", toggleFields);

            carregandoAddSelect = true;

            const HandleOLT = function () {
                $('#iOLT').on('select2:select select2:unselecting', function (e) {
                    const OLTSelecionada = e.params.data;

                    $("#iIpOLT").val(OLTSelecionada.ip)
                    $("#iGabinete").val(OLTSelecionada.gabinete)

                    if (!carregandoAddSelect) {
                        if ($('#iSlot').val()) {
                            AddSelect("iSlot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, OLTSelecionada.id, $("#iSlot").val(), "@RsBase.SELECIONE", false);
                        }
                        else {
                            AddSelect("iSlot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, OLTSelecionada.id, null, "@RsBase.SELECIONE", false);
                        }
                    }

                    $(".select2-selection").addClass("outlineNone")

                    return true;
                });
            }

            const HandleCliente = function () {
                $('#iCliente').on('select2:select select2:unselecting', function (e) {
                    const clienteSelecionado = e.params.data;

                    $("#iNome").val(clienteSelecionado.cpf)

                    if (!carregandoAddSelect) {
                        AddSelect("iPlano", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboVinculoONUCliente", @CONSTANTES.PaginacaoRegistros, null, clienteSelecionado.id, null, "@RsBase.SELECIONE", false);
                        $(".select2-selection").addClass("outlineNone")
                    }

                    return true;
                });
            }

            const HandlePlano = function () {
                $('#iPlano').on('select2:select', function (e) {
                    const data = e.params.data;

                    $("#iUpload").val(data.upload)
                    $("#iDownload").val(data.download)
                })
            }

            const HandlePerfilAtivacao = function () {
                $("#iPerfilAtivacao").on("select2:select", function (e) {
                    if (!$("#iScriptONU").val() && !$("#iScriptOLT").val()) {
                        const data = e.params.data

                        $("#iScriptOLT").val(data.scriptAtivacao)
                        $("#iScriptONU").val(data.scriptONU)

                        $("#iScriptOLT").trigger("mouseup").trigger("keyup")
                        $("#iScriptONU").trigger("mouseup").trigger("keyup")
                    }
                })
            }

            const HandleCaixaFTTH = function () {

            $('#iCaixa_FTTH').on('select2:select select2:unselecting', function (e) {
                if (primeiraVez && e.params.data != undefined) {
                    e.params.data = undefined;
                    primeiraVez = false;
                }

                if (e.params.data != undefined) {
                    AddSelect("iPorta_FTTH", "@CONSTANTES.URLPortal/api/Elemento_Rede_PortaApi/GetComboPortaDisponivel", @CONSTANTES.PaginacaoRegistros, null, e.params.data.id, null, "@RsBase.SELECIONE", false);                    
                }
               
                return true
            });

        };

            Promise.all([
                AddSelect("iOLT", "@CONSTANTES.URLPortal/api/OLTapi/GetCombo", "@CONSTANTES.PaginacaoRegistros", null, null, "@Model.IdOLT", "@RsBase.SELECIONE", false, HandleOLT),
                AddSelect("iSlot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", "@CONSTANTES.PaginacaoRegistros", null, "@Model.IdOLT", "@Model.IdSlot", "@RsBase.SELECIONE", false),

                AddSelect("iPON", "@CONSTANTES.URLPortal/api/PONApi/GetCombo", "@CONSTANTES.PaginacaoRegistros", null, null, "@Model.IdPon", "@RsBase.SELECIONE", false),

                AddSelect("iCliente", "@CONSTANTES.URLPortal/api/clienteapi/GetCombo", "@CONSTANTES.PaginacaoRegistros", null, null, "@Model.IdCliente", "@RsBase.SELECIONE", false, HandleCliente),
                AddSelect("iPlano", "@CONSTANTES.URLPortal/api/PlanoApi/GetCombo", "@CONSTANTES.PaginacaoRegistros", null, "@Model.IdCliente", "@Model.IdPlano", "@RsBase.SELECIONE", false, HandlePlano),

                AddSelect("iLogin", "@CONSTANTES.URLPortal/api/LoginRadiusapi/GetCombo", "@CONSTANTES.PaginacaoRegistros", null, null, "@Model.IdLogin", "@RsBase.SELECIONE", false),
                AddSelect("iPerfilAtivacao", "@CONSTANTES.URLPortal/api/PerfilAtivacaoApi/GetCombo", "@CONSTANTES.PaginacaoRegistros", null, null, "@Model.IdPerfilAtivacao", "@RsBase.SELECIONE", false, HandlePerfilAtivacao),
                AddSelect("iCaixa_FTTH", "@CONSTANTES.URLPortal/api/Elemento_RedeApi/GetComboCaixa", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdCaixaFTTH", "@RsBase.SELECIONE", false, HandleCaixaFTTH),
                AddSelect("iPorta_FTTH", "@CONSTANTES.URLPortal/api/Elemento_Rede_PortaApi/GetComboPortaDisponivel", @CONSTANTES.PaginacaoRegistros, null, "@Model.IdCaixaFTTH", "@Model.IdPortaFTTH", "@RsBase.SELECIONE", false),
            ]).then(function () {

                carregandoAddSelect = false;

                /*if ($("#iScriptONUBase64").val() != "") {
                    let scriptONU = atob($("#iScriptONUBase64").val())
                    $("#iScriptONU").val(scriptONU);
                }*/

                if ($("#iScriptOLTBase64").val() != "") {
                    let scriptOLT = atob($("#iScriptOLTBase64").val())
                    $("#iScriptOLT").val(scriptOLT);
                }

                $("#iScriptOLT").trigger("mouseup").trigger("keyup")
                $("#iScriptONU").trigger("mouseup").trigger("keyup")
            })
        })

        var clicked = false;
        function ValidaSubmit() {

            const ipVal = ip.getIp()
            $("#iHiddenIp").val(ipVal)

            if (clicked) {
                return false
            }

            clicked = true

            let erro = false

            if (ValidaCamposObrigatorios(erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            if ($("#iCaixa_FTTH option:selected").val() && !$('#iPorta_FTTH option:selected').val()) {
                Notificar("@RsBase.ATENCAO_", "Obrigatório preencher Porta FTTH pois foi informada Caixa FTTH", "warning")
                erro = true;
            }

            ValidaCampoIP(ip, "iIp")

            if (erro) {
                clicked = false
                return false
            }

            ShowPageLoading()
            $('#form').submit()

            parent.dial.dialog('close')
        }
</script>
}

