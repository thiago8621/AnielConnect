
@{
    ViewBag.Title = RsCadastros.ESTRUTURA_REDE_OPTICA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section scripts{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsTreeview")
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script type="text/javascript">

        var oDatatable

        function LimparFiltroModal() {
            $('#iEmpresa').val(null).trigger('change')
            $('#iFilial').val(null).trigger('change')
            $('#iId_OLT').val(null).trigger('change')
            $('#iId_SLOT').val(null).trigger('change')
            $('#iId_PON').val(null).trigger('change')
            Initializing_Tree()
        }

        var OLTSelecionada = null;
        const HandleOLT = function () {
            // Categoria do Cliente
            $('#iId_OLT').on('select2:select select2:unselecting', function (e) {
                OLTSelecionada = e.params.data;

                $('#iId_Slot').val(null).trigger('change');

                if (typeof OLTSelecionada != typeof undefined) {
                    AddSelect("iId_Slot", "@CONSTANTES.URLPortal/api/SlotApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, OLTSelecionada.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iId_Slot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleSLOT);
                    AddSelect("iId_PON", "@CONSTANTES.URLPortal/api/PONapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                }

                return true;
            });
        };

        var SLOTSelecionada = null;
        const HandleSLOT = function () {
            // Categoria do Cliente
            $('#iId_Slot').on('select2:select select2:unselecting', function (e) {
                SLOTSelecionada = e.params.data;

                $('#iId_PON').val(null).trigger('change');

                AddSelect("iId_PON", "@CONSTANTES.URLPortal/api/PONapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, SLOTSelecionada.id, null, "@RsBase.SELECIONE", false);

                return true;
            });
        };

        const handleEmpresa = function () {

            $("#iEmpresa").on("select2:select select2:unselecting", function (e) {

                var idEmpresa = e.params.data;

                if (typeof idEmpresa != typeof undefined) {
                    AddSelect('iFilial', '@CONSTANTES.URLPortal/api/FilialApi/GetComboDescricao', @CONSTANTES.PaginacaoRegistros, null, idEmpresa.id, null, '@RsBase.SELECIONE', false,HandleFilial)
                }
                else {
                    AddSelect('iFilial', '@CONSTANTES.URLPortal/api/FilialApi/GetComboDescricao', @CONSTANTES.PaginacaoRegistros, null, null, null, '@RsBase.SELECIONE', false, HandleFilial)
                    AddSelect("iId_OLT", "@CONSTANTES.URLPortal/api/OLTapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleOLT);
                    AddSelect("iId_Slot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleSLOT);
                    AddSelect("iId_PON", "@CONSTANTES.URLPortal/api/PONapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                }
            })
        };

        let FilialSelecionada = null;
        const HandleFilial = function () {

            $("#iFilial").on("select2:select select2:unselecting", function (e) {

                FilialSelecionada = e.params.data

                if (typeof FilialSelecionada != typeof undefined) {
                    AddSelect("iId_OLT", "@CONSTANTES.URLPortal/api/OLTapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, FilialSelecionada.id, null, "@RsBase.SELECIONE", false, HandleOLT);
                }
                else {
                    AddSelect("iId_OLT", "@CONSTANTES.URLPortal/api/OLTapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleOLT);
                    AddSelect("iId_Slot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleSLOT);
                    AddSelect("iId_PON", "@CONSTANTES.URLPortal/api/PONapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                }
            })
        };



        AddSelect("iEmpresa", "@CONSTANTES.URLPortal/api/Empresaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false,handleEmpresa);
        AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetComboDescricao", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iId_OLT", "@CONSTANTES.URLPortal/api/OLTapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleOLT);
        AddSelect("iId_Slot", "@CONSTANTES.URLPortal/api/Slotapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleSLOT);
        AddSelect("iId_PON", "@CONSTANTES.URLPortal/api/PONapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);


        function Initializing_Tree() {

            //Initializing Tree

            //Tree Context Menu Structure
            var contex_menu = {
                'context1': {
                    elements: [
                        {
                            text: 'Alterar',
                            icon: null,
                            action: function (node) {
                                var arrtag = node.tag.split('_');
                                var origem = arrtag[0];
                                var id_origem = arrtag[1];


                            }
                        }
                    ]
                }
            };

            //Creating the tree
            tree = createTree('div_tree', 'white', contex_menu);

            //div_log = document.getElementById('div_log');

            //Setting custom events
            tree.nodeBeforeOpenEvent = function (node) {
                var arrtag = node.tag.split('_');
                var origem = arrtag[0];
                var id_origem = arrtag[1];

                if (origem === "empresa") {
                    cria_childFilial(node, id_origem);
                } else if (origem === "filial") {
                    cria_childOLT(node, id_origem);
                } else if (origem === "olt") {
                    cria_childSlot(node, id_origem);
                } else if (origem === "slot") {
                    cria_childPon(node, id_origem);
                } else if (origem === "pon") {
                    cria_childOnu(node, id_origem);
                }
            }

            tree.nodeAfterOpenEvent = function (node) {
                //div_log.innerHTML += node.text + ': After expand event<br/>';
            }

            tree.nodeBeforeCloseEvent = function (node) {
                //div_log.innerHTML += node.text + ': Before collapse event<br/>';
            }

            //Carrega Primeiro Nó
            let empresa_id = $('#iEmpresa').val()
            var _url = "@CONSTANTES.URLPortal" + `/api/EmpresaApi/GetTreeView?IdEmpresa=${empresa_id}`;

            $.ajax({

                url: _url,
                type: "GET",
                dataType: "json"
            })
                .done(function (data) {

                    if (data.ok) {

                        $.each(data.objeto, function (name, value) {
                            var nodechild = tree.createNode('Empresa: ' + value.nome, false, '@CONSTANTES.URLPortal/images/treeview/empresa.png', null, 'empresa_' + value.id, null); //'context1'

                            nodechild.createChildNode(null, false, '@CONSTANTES.URLPortal/images/loading/loading.gif', null, null);
                        });
                    }
                });

            //Rendering the tree
            tree.drawTree();

            //Adding node after tree is already rendered
            //tree.createNode('<a href="http://www.google.com">Link to Google</a', false, 'images/leaf.png', null, null, 'context1');

            if (oDatatable) {
                $('#datatable').dataTable().fnDestroy();
                $('#datatable').empty();
                $('#datatable').empty();
                $('#datatable').empty();
                oDatatable = null;
            }

            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                select: {
                    style: 'multi'
                },
                order: [[2, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/ClienteApi/GetTreeViewFibraExport',
                    type: 'POST',
                    data: function (data) {
                        data.Id_Empresa = $('#iEmpresa').val()
                        data.Id_Filial = $('#iFilial').val()
                        data.Id_OLT = $('#iId_OLT').val()
                        data.Id_SLOT = $('#iId_SLOT').val()
                        data.Id_PON = $('#iId_PON').val()
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                   
                },
                rowCallback: function (row, data, dataIndex) {
                     
                     
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTableRelatorio,
                columns: [
                    { data: "empresa", title: "@RsCadastros.EMPRESA" },
                    { data: "filial", title: "@RsCadastros.FILIAL" },
                    { data: "olt", title: "@RsCadastros.OLT" },
                    { data: "slot", title: "@RsCadastros.SLOT" },
                    { data: "pon", title: "@RsCadastros.PON" },
                    { data: "equipamento", title: "@RsCadastros.EQUIPAMENTO" },
                    { data: "cliente", title: "@RsCadastros.CLIENTE" },
                    { data: "plano", title: "@RsCadastros.PLANO" },
                    { data: "login", title: "@RsCadastros.LOGIN" },
                ]
            });

        };

        window.onload = Initializing_Tree()


        function cria_childFilial(node, id_empresa) {

            let filial_id = $('#iFilial').val()
            var _url = "@CONSTANTES.URLPortal" + `/api/FilialApi/GetTreeView?IdEmpresa=${id_empresa}&IdFilial=${filial_id}`;

            $.ajax({

                url: _url,
                type: "GET",
                dataType: "json"
            })
                .done(function (data) {

                    if (data.ok) {

                        node.removeChildNodes();
                        $.each(data.objeto, function (name, value) {
                            var nodechild = node.createChildNode('Filial: ' + value.nome, false, '@CONSTANTES.URLPortal/images/treeview/filial.png', 'filial_' + value.id, null);

                            nodechild.createChildNode(null, false, '@CONSTANTES.URLPortal/images/loading/loading.gif', null, null);
                        });
                    }
                });
        }

        function cria_childOLT(node, id_filial) {

            let id_olt = $('#iId_OLT').val()
            var _url = "@CONSTANTES.URLPortal" + `/api/OLTApi/GetTreeView?IdFilial=${id_filial}&IdOlt=${id_olt}`;

            $.ajax({

                url: _url,
                type: "GET",
                dataType: "json"
            })
                .done(function (data) {

                    if (data.ok) {

                        node.removeChildNodes();
                        $.each(data.objeto, function (name, value) {
                            var nodechild = node.createChildNode('OLT: ' + value.descricao, false, '@CONSTANTES.URLPortal/images/treeview/olt.png', 'olt_' + value.id, null);

                            nodechild.createChildNode(null, false, '@CONSTANTES.URLPortal/images/loading/loading.gif', null, null);
                        });
                    }
                });
        }

        function cria_childSlot(node, id_olt) {

            let slot_id = $('#iId_Slot').val()
            var _url = "@CONSTANTES.URLPortal" + `/api/SlotApi/GetTreeView?Id_OLT=${id_olt}&Id_Slot=${slot_id}`;

            $.ajax({

                url: _url,
                type: "GET",
                dataType: "json"
            })
                .done(function (data) {

                    if (data.ok) {

                        node.removeChildNodes();
                        $.each(data.objeto, function (name, value) {
                            var nodechild = node.createChildNode('SLOT: ' + value.descricao, false, '@CONSTANTES.URLPortal/images/treeview/slot.png', 'slot_' + value.id, null);

                            nodechild.createChildNode(null, false, '@CONSTANTES.URLPortal/images/loading/loading.gif', null, null);
                        });
                    }
                });
        }

        function cria_childPon(node, id_slot) {

            let pon_id = $('#iId_PON').val()
            var _url = "@CONSTANTES.URLPortal" + `/api/PonApi/GetTreeView?Id_Slot=${id_slot}&Id_Pon=${pon_id}` ;

            $.ajax({

                url: _url,
                type: "GET",
                dataType: "json"
            })
                .done(function (data) {

                    if (data.ok) {

                        node.removeChildNodes();
                        $.each(data.objeto, function (name, value) {
                            var nodechild = node.createChildNode('PON: ' + value.descricao, false, '@CONSTANTES.URLPortal/images/treeview/pon.png', 'pon_' + value.id, null);

                            nodechild.createChildNode(null, false, '@CONSTANTES.URLPortal/images/loading/loading.gif', null, null);
                        });
                    }
                });
        }

        function cria_childOnu(node, id_pon) {

            var _url = "@CONSTANTES.URLPortal" + "/api/ClienteApi/GetTreeViewFibra?Id_Pon=" + id_pon;

            $.ajax({

                url: _url,
                type: "GET",
                dataType: "json"
            })
                .done(function (data) {

                    if (data.ok) {

                        node.removeChildNodes();
                        $.each(data.objeto, function (name, value) {

                            if (value.equipamento.trim() != "-")
                                node.createChildNode(`Equipamento (ONU): ${value.equipamento} - ${value.login} / Cliente: ${value.cliente} / Plano: ${value.plano}`, false, '@CONSTANTES.URLPortal/images/ok.png', 'onu_' + value.id, null);
                            else
                                node.createChildNode(`Equipamento (ONU): ${value.equipamento} - ${value.login} / Cliente: ${value.cliente} / Plano: ${value.plano}`, false, '@CONSTANTES.URLPortal/images/alert-icon2.png', 'onu_' + value.id, null);
                        });
                    }
                });
        }

        function expand_all() {
            tree.expandTree();
        }

        function collapse_all() {
            tree.collapseTree();
        }
    </script>
}

@section styles{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssTreeview")

    <style>
    .verde{
        color:green
    }
    .vermelho{
        color:red
    }
    .laranja{
        color:orange
    }
    </style>
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-sitemap"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mb-20">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GERENCIAMENTO_REDE</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>

                </ol>
            </nav>

            <span style="font-size:11px" id="dtLegend"></span>
        </div>

        <div class="">
            <div class="form-group col-sm-push-1">
                <label for="iId_WidePay" class="mr-3"></label><br>
                <i class="fas fa-question-circle fa-2x" style="color: #2092EC" data-toggle="popover" data-html="true" title="Legenda de status para ONU"
                data-content="<div style='font-size: 12px'>
                <span class='p-3'><i class='fas fa-circle verde'></i> Equipamento está com funcionamento correto</span><br />
                <span class='p-3'><i class='fas fa-circle vermelho'></i> Equipamento está apresentando problemas de funcionamento</span><br />
                <span class='p-3'><i class='fas fa-circle laranja'></i> Equipamento provisionado</span><br />
</div>"></i>
            </div>
        </div>

        <div class="col-auto">


            <button class="btn btn-default btn-add mt-3" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>


            <button class="btn btn-default btn-add mt-3" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
            </button>
            <div class="row title-page">
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="@Url.Action("Cadastro", "OLT")">@RsCadastros.CADASTRO_OLT</a>
                    <a class="dropdown-item" href="@Url.Action("Cadastro", "SLOT")">@RsCadastros.CADASTRO_SLOT</a>
                    <a class="dropdown-item" href="@Url.Action("Cadastro", "PON")">@RsCadastros.CADASTRO_PON</a>
                </div>
            </div>

        </div>


    </div>

</div>

<div class="container-fluid" id="divTable">
    <div class="row">
        <div class="col-sm-12 ml-3">
            <div id="div_tree"></div>
        </div>
    </div>
</div>

<div id="divTableExport" class="d-none">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>

<div class="modal" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">

                    <div class="col-sm-8 container" style="align-content:center;">

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="iEmpresa" class="fs-12">@RsCadastros.EMPRESA:</label>
                                    @Html.DropDownList("Sel2Empresa", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>()), RsBase.SELECIONE, new { @id = "iEmpresa", @class = "form-control" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="iFilial" class="fs-12">@RsCadastros.FILIAL:</label>
                                    @Html.DropDownList("Sel2Filial", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>()), RsBase.SELECIONE, new { @id = "iFilial", @class = "form-control" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="iId_OLT" class="fs-12">@RsCadastros.OLT:</label>
                                    @Html.DropDownList("Sel2OLT", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iId_OLT", @autocomplete = "off" })
                                </div>
                            </div>
                        </div>


                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="iId_Slot" class="fs-12">@RsCadastros.SLOT:</label>
                                    @Html.DropDownList("Sel2SLOT", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iId_Slot", @autocomplete = "off" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="iId_PON" class="fs-12">@RsCadastros.PON:</label>
                                    @Html.DropDownList("Sel2PON", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iId_PON", @autocomplete = "off" })
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" onclick="$('#modal-filter').modal('toggle');LimparFiltroModal()" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="$('#modal-filter').modal('toggle');Initializing_Tree()" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->