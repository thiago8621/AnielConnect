@model Aniel.Connect.Models.VinculoONUCliente

@using Resources

@{
    var valor_divida = Request.Params["valor_divida"];

    ViewBag.Title = RsCadastros.VINCULAR_ONU;
    ViewBag.Sessao = RsCadastros.VINCULAR_ONU;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.Render("~/Content/cssDataTable")

    <style>
        .select2-dropdown {
            z-index: 1500 !important;
        }
    </style>
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/maskip")

    <script>

        let nro_Ip = undefined
        let ip_inicio = undefined
        let ip_final = undefined
        let ip_mask = undefined
        let estatico_nro_ip = undefined
        let estatico_ip_mask = undefined
        let estatico_getway = undefined

        $('input[type=radio][name=Tipo_Conexao]').change(function() {
            if (this.value == 'PPPoE') {
                $("#iLogin_PPPOE").removeClass("readonly");
                $("#iSenha_PPPOE").removeClass("readonly");
                $("#iLoginAdmin").removeClass("readonly");
                $("#iSenhaAdmin").removeClass("readonly");
                $("#iPortaVLan").removeClass("readonly");
                $("#iWireless_SSID").addClass("readonly");
                $("#iSenha_WPA2").addClass("readonly");
                $("#iSenha_WPA2").removeClass("is-invalid");
                $("#iNro_Ip").removeClass("readonly");
                $("#iIp_Inicio").removeClass("readonly");
                $("#iIp_Final").removeClass("readonly");
                $("#iIp_Mask").removeClass("readonly");
                $("#accordion_3").hide();
            }
            else if (this.value == 'BRIDGE') {
                $("#iLogin_PPPOE").addClass("readonly");
                $("#iSenha_PPPOE").addClass("readonly");
                $("#iLogin_PPPOE").removeClass("is-invalid");
                $("#iSenha_PPPOE").removeClass("is-invalid");
                $("#iLoginAdmin").removeClass("readonly");
                $("#iSenhaAdmin").removeClass("readonly");
                $("#iPortaVLan").removeClass("readonly");
                $("#iWireless_SSID").addClass("readonly");
                $("#iWireless_SSID").removeClass("is-invalid");
                $("#iSenha_WPA2").addClass("readonly");
                $("#iSenha_WPA2").removeClass("is-invalid");
                $("#iNro_Ip").removeClass("readonly");
                $("#iIp_Inicio").removeClass("readonly");
                $("#iIp_Final").removeClass("readonly");
                $("#iIp_Mask").removeClass("readonly");
                $("#accordion_3").hide();
            }
            else if (this.value == 'DHCP') {
                $("#iLogin_PPPOE").addClass("readonly");
                $("#iSenha_PPPOE").addClass("readonly");
                $("#iLoginAdmin").addClass("readonly");
                $("#iSenhaAdmin").addClass("readonly");
                $("#iPortaVLan").addClass("readonly");
                $("#iLogin_PPPOE").removeClass("is-invalid");
                $("#iSenha_PPPOE").removeClass("is-invalid");
                $("#iLoginAdmin").removeClass("is-invalid");
                $("#iSenhaAdmin").removeClass("is-invalid");
                $("#iPortaVLan").removeClass("is-invalid");
                $("#iWireless_SSID").addClass("readonly");
                $("#iSenha_WPA2").addClass("readonly");
                $("#iNro_Ip").addClass("readonly");
                $("#iIp_Inicio").addClass("readonly");
                $("#iIp_Final").addClass("readonly");
                $("#iIp_Mask").addClass("readonly");
                $("#iSenha_WPA2").removeClass("is-invalid");
                $("#iNro_Ip").removeClass("is-invalid");
                $("#iIp_Inicio").removeClass("is-invalid");
                $("#iIp_Final").removeClass("is-invalid");
                $("#iIp_Mask").removeClass("is-invalid");
                $("#accordion_3").hide();
            }
            else if (this.value == 'IP_ESTATICO') {
                $("#iLogin_PPPOE").addClass("readonly");
                $("#iSenha_PPPOE").addClass("readonly");
                $("#iLoginAdmin").addClass("readonly");
                $("#iSenhaAdmin").addClass("readonly");
                $("#iPortaVLan").addClass("readonly");
                $("#iWireless_SSID").addClass("readonly");
                $("#iSenha_WPA2").addClass("readonly");
                $("#iNro_Ip").addClass("readonly");
                $("#iIp_Inicio").addClass("readonly");
                $("#iIp_Final").addClass("readonly");
                $("#iIp_Mask").addClass("readonly");

                $("#iLogin_PPPOE").removeClass("is-invalid");
                $("#iSenha_PPPOE").removeClass("is-invalid");
                $("#iLoginAdmin").removeClass("is-invalid");
                $("#iSenhaAdmin").removeClass("is-invalid");
                $("#iPortaVLan").removeClass("is-invalid");
                $("#iWireless_SSID").removeClass("is-invalid");
                $("#iSenha_WPA2").removeClass("is-invalid");
                $("#iNro_Ip").removeClass("is-invalid");
                $("#iIp_Inicio").removeClass("is-invalid");
                $("#iIp_Final").removeClass("is-invalid");
                $("#iIp_Mask").removeClass("is-invalid");

                $("#accordion_3").show();
            }

            $(".readonly").attr("tabindex", "-1");

        });

        var ClienteSelecionado = null;
        var HandleCliente = function () {
            // Categoria do Cliente
            $('#iId_Cliente2').on('select2:select select2:unselecting', function (e) {
                ClienteSelecionado = e.params.data;

                $('#iId_PlanoProduto2').val(null).trigger('change');

                AddSelect("iId_PlanoProduto2", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, ClienteSelecionado.id, null, "@RsBase.SELECIONE", true);

                return true;
            });
        };

        var PlanoSelecionado = null;
        var HandlePlano = function () {
            // Categoria do Cliente
            $('#PlanoSelecionado').on('select2:select select2:unselecting', function (e) {
                PlanoSelecionado = e.params.data;

                $('#iLogin_PPPOE').val(PlanoSelecionado.login);
                $('#iSenha_PPPOE').val(PlanoSelecionado.senha);

                return true;
            });
        };

        var ObraSelecionada = null;
        var HandleObra = function () {
            // Categoria do Cliente
            $('#iNum_Obra').on('select2:select select2:unselecting', function (e) {
                ObraSelecionada = e.params.data;

                $('#iId_Cliente').val(null).trigger('change');
                $('#Id_PlanoProduto').val(null).trigger('change');

                $('#iCodCt').val(ObraSelecionada.codct);
                $('#iProjeto').val(ObraSelecionada.projeto);
                $('#iNum_Doc').val(ObraSelecionada.num_Doc);
                $('#iCodMat').val(ObraSelecionada.codMat);
                $('#iCodCpl').val(ObraSelecionada.codCpl);
                $('#iId_Cliente').val(ObraSelecionada.id_Cliente);
                $('#iId_PlanoProduto').val(ObraSelecionada.id_PlanoProduto);
                $('#iId_Cliente_Plano_Produto').val(ObraSelecionada.id_Cliente_PlanoProduto);


                if (ObraSelecionada.id_Cliente) {
                    AddSelect("iId_Cliente2", "@CONSTANTES.URLPortal/api/ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, ObraSelecionada.id_Cliente, "@RsBase.SELECIONE", true);
                    AddSelect("iId_PlanoProduto2", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboVinculoONUCliente", @CONSTANTES.PaginacaoRegistros, null, ObraSelecionada.id_Cliente, ObraSelecionada.id_PlanoProduto, "@RsBase.SELECIONE", true, HandlePlano);
                }
                else {
                    AddSelect("iId_Cliente2", "@CONSTANTES.URLPortal/api/ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleCliente);
                    AddSelect("iId_PlanoProduto2", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboVinculoONUCliente", @CONSTANTES.PaginacaoRegistros, null, null, -1, "@RsBase.SELECIONE", false, HandlePlano);
                }

                return true;
            });
        };

        @if (String.IsNullOrEmpty(Model.Num_Obra))
        {
            <text>
            AddSelect("iNum_Obra", "@CONSTANTES.URLPortal/api/Documento_ProducaoApi/GetComboVincularONU", @CONSTANTES.PaginacaoRegistros, null, '@Model.Mac', null, "@RsBase.SELECIONE", false, HandleObra);
            AddSelect("iId_Cliente2", "@CONSTANTES.URLPortal/api/ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iId_PlanoProduto2", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboVinculoONUCliente", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            </text>
        }
        else
        {
            <text>
            AddSelect("iNum_Obra", "@CONSTANTES.URLPortal/api/Documento_ProducaoApi/GetComboVincularONU", @CONSTANTES.PaginacaoRegistros, null, '@Model.Mac', '@Model.Num_Obra', "@RsBase.SELECIONE", true);
            AddSelect("iId_Cliente2", "@CONSTANTES.URLPortal/api/ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, '@Model.Id_Cliente', "@RsBase.SELECIONE", true);
            AddSelect("iId_PlanoProduto2", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboVinculoONUCliente", @CONSTANTES.PaginacaoRegistros, null, null, '@Model.Id_PlanoProduto', "@RsBase.SELECIONE", true);
            </text>
        }

        function ValidaIPChange() {
                $('input[type=radio][name=Tipo_Conexao]').change(function () {

                    if (this.value == 'PPPoE') {
                        ValidaCampoIP(nro_Ip, "iNro_Ip")
                        ValidaCampoIP(ip_inicio, "iIp_Inicio")
                        ValidaCampoIP(ip_final, "iIp_Final")
                        ValidaCampoIP(ip_mask, "iIp_Mask")
                        $('.ip-input-item, .ip-input-container').css({ 'background-color': '#FFFFFF' })

                    } else if (this.value == 'BRIDGE') {
                        ValidaCampoIP(nro_Ip, "iNro_Ip")
                        ValidaCampoIP(ip_inicio, "iIp_Inicio")
                        ValidaCampoIP(ip_final, "iIp_Final")
                        ValidaCampoIP(ip_mask, "iIp_Mask")
                        ValidaCampoIP(estatico_nro_ip, "iEstatico_Nro_Ip")
                        $('.ip-input-item, .ip-input-container').css({ 'background-color': '#FFFFFF' })

                    } else if (this.value == 'DHCP') {
                        let arrayID = ["#iNro_Ip", "#iIp_Inicio", "#iIp_Final", "#iIp_Mask", "#iEstatico_Nro_Ip"]
                        for (var tiraValidacao of arrayID) {
                            $(tiraValidacao).unbind('keyup')
                            $(tiraValidacao).children('.is-valid').removeClass('is-valid')
                            $(tiraValidacao).children('.is-invalid').removeClass('is-invalid')
                            $('.ip-input-item, .ip-input-container').css({ 'background-color': '#E9ECEF' })
                        }
                    } else if (this.value == 'IP_ESTATICO') {
                        let arrayID = ["#iNro_Ip", "#iIp_Inicio", "#iIp_Final", "#iIp_Mask"]
                        for (var tiraValidacao of arrayID) {
                            $(tiraValidacao).unbind('keyup')
                            $(tiraValidacao).children('.is-valid').removeClass('is-valid')
                            $(tiraValidacao).children('.is-invalid').removeClass('is-invalid')
                            $('.ip-input-item, .ip-input-container').css({ 'background-color': '#E9ECEF' })
                            ValidaCampoIP(estatico_nro_ip, "iEstatico_Nro_Ip")
                            $('#iEstatico_Nro_Ip').children('.ip-input-container').children('.ip-input-item').css({ 'background-color': '#FFFFFF' })
                            $('#iEstatico_Nro_Ip').children('.ip-input-container').css({ 'background-color': '#FFFFFF' })
                            ValidaCampoIP(estatico_ip_mask, "iEstatico_Ip_Mask")
                            $('#iEstatico_Ip_Mask').children('.ip-input-container').children('.ip-input-item').css({ 'background-color': '#FFFFFF' })
                            $('#iEstatico_Ip_Mask').children('.ip-input-container').css({ 'background-color': '#FFFFFF' })
                            ValidaCampoIP(estatico_getway, "iEstatico_Getway")
                            $('#iEstatico_Getway').children('.ip-input-container').children('.ip-input-item').css({ 'background-color': '#FFFFFF' })
                            $('#iEstatico_Getway').children('.ip-input-container').css({ 'background-color': '#FFFFFF' })


                        }


                    }

                })

                $('input[type=radio][name=Tipo_Conexao][value=PPPoE]').trigger("change");

            }


        @if (!String.IsNullOrEmpty(Request.Params["Sucesso"]))
        {
            <text>
                $(document).ready(function () {
                    parent.dial.dialog('close');
                })
            </text>
        }
        $(document).ready(function () {
            nro_Ip = $('#iNro_Ip').ipInput()
            ip_inicio = $('#iIp_Inicio').ipInput()
            ip_final = $('#iIp_Final').ipInput()
            ip_mask = $('#iIp_Mask').ipInput()
            estatico_nro_ip = $('#iEstatico_Nro_Ip').ipInput()
            estatico_ip_mask = $('#iEstatico_Ip_Mask').ipInput()
            estatico_getway = $('#iEstatico_Getway').ipInput()

                 $('.ip-input-container').addClass('form-control')

            nro_Ip.setIp('@Model.Nro_Ip')
            ip_inicio.setIp('@Model.Ip_Inicio')
            ip_final.setIp('@Model.Ip_Final')
            ip_mask.setIp('@Model.Ip_Mask')
            estatico_nro_ip.setIp('@Model.Estatico_Nro_Ip')
            estatico_ip_mask.setIp('@Model.Estatico_Ip_Mask')
            estatico_getway.setIp('@Model.Estatico_Gatway')

            ValidaIPChange()

            })
        let clicked = false;
        function ValidaSubmit()
        {

            let nroIP_value = nro_Ip.getIp()
            $('#iHiddenNroIP').val(nroIP_value)

            let ip_inicio_value = ip_inicio.getIp()
            $('#iHiddenIpInicio').val(ip_inicio_value)

            let ip_final_value = ip_final.getIp()
            $('#iHiddenIpFinal').val(ip_final_value)

            let ip_mask_value = ip_mask.getIp()
            $('#iHiddenIpMask').val(ip_mask_value)

            let estatico_nro_ip_value = estatico_nro_ip.getIp()
            $('#iHiddenEstaticoNroIp').val(estatico_nro_ip_value)

            let estatico_ip_mask_value = estatico_ip_mask.getIp()
            $('#iHiddenEstaticoIpMask').val(estatico_ip_mask_value)

            let estatico_gateway_value = estatico_getway.getIp()
            $('#iHiddenEstaticoGateway').val(estatico_gateway_value)

            clicked = true;

            let erro = false;

            if (ValidaCamposObrigatorios(erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            ValidaIPChange()

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();

            $('#form').submit();

    }

    </script>
}

@using (Html.BeginForm("VincularONUCliente", "EstruturaFibra", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.Id_Pon)
    @Html.HiddenFor(model => model.Mac)
    @Html.HiddenFor(model => model.TipoONU)

    @Html.HiddenFor(model => model.CodCt, new { Id = "iCodCt" })
    @Html.HiddenFor(model => model.Projeto, new { Id = "iProjeto" })
    @Html.HiddenFor(model => model.Num_Doc, new { Id = "iNum_Doc" })
    @Html.HiddenFor(model => model.CodMat, new { Id = "iCodMat" })
    @Html.HiddenFor(model => model.CodCpl, new { Id = "iCodCpl" })
    @Html.HiddenFor(model => model.Id_Cliente, new { Id = "iId_Cliente" })
    @Html.HiddenFor(model => model.Id_PlanoProduto, new { Id = "iId_PlanoProduto" })
    @Html.HiddenFor(model => model.Id_Cliente_PlanoProduto, new { Id = "iId_Cliente_Plano_Produto" })

    <div class="container-fluid" id="divTitle">

        <div class="accordion" id="accordion_1">
            <div class="card div-card-accord mb-3">
                <div class="card-header title-card" id="heading_1">
                    <h5 class="mb-0">
                        <a role="button" data-toggle="collapse" data-target="#collapse_1" aria-expanded="true" aria-controls="collapse_1">
                            <span class="text-bold-card">@RsCadastros.CLIENTE_PLANO</span>
                        </a>
                    </h5>
                </div>
                <div id="collapse_1" class="collapse show" aria-labelledby="heading_1" data-parent="#accordion_1">
                    <div class="card-body body-card-accord">
                        <div class="row">
                            <div class="col-sm-3">
                                <label for="iMAC" class="fs-12">@RsCadastros.MAC</label>
                                <div class="form-group">
                                    @Html.TextBoxFor(model => model.Mac, new { @id = "iMAC", @class = "form-control readonly", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <label for="iSerial" class="fs-12">@RsCadastros.SERIAL</label>
                                <div class="form-group">
                                    @Html.TextBoxFor(model => model.Serial, new { @id = "iSerial", @class = "form-control readonly", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <label for="iTipoONU" class="fs-12">@RsCadastros.TIPO_ONU</label>
                                <div class="form-group">
                                    @Html.TextBoxFor(model => model.TipoONU, new { @id = "iTipoONU", @class = "form-control readonly", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <label for="iDescricaoPon" class="fs-12">@RsCadastros.PONID</label>
                                <div class="form-group">
                                    @Html.TextBoxFor(model => model.DescricaoPon, new { @id = "iDescricaoPon", @class = "form-control readonly", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <label for="iNUM_OBRA" class="fs-12">@RsCadastros.ORDEM_SERVICO</label>
                                <div class="form-group">
                                    @Html.DropDownListFor(p => p.Num_Obra, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iNum_Obra", @autocomplete = "off" })
                                    
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <label for="iId_Cliente" class="fs-12">@RsCadastros.CLIENTE</label>
                                <div class="form-group">
                                    @Html.DropDownListFor(p => p.Id_Cliente, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iId_Cliente2", @autocomplete = "off" })
                                    
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <label for="iId_PlanoProduto" class="fs-12">@RsCadastros.PLANO_PRODUTO</label>
                                <div class="form-group">
                                    @Html.DropDownListFor(p => p.Id_PlanoProduto, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iId_PlanoProduto2", @autocomplete = "off" })
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion" id="accordion_2">
            <div class="card div-card-accord mb-3">
                <div class="card-header title-card" id="heading_2">
                    <h5 class="mb-0">
                        <a role="button" data-toggle="collapse" data-target="#collapse_2" aria-expanded="true" aria-controls="collapse_2">
                            <span class="text-bold-card">@RsCadastros.CONECTIVIDADE</span>
                        </a>
                    </h5>
                </div>
                <div id="collapse_2" class="collapse show" aria-labelledby="heading_2" data-parent="#accordion_2">
                    <div class="card-body body-card-accord">
                        <div class="row">
                            <div class="col-sm-6 mb-2">
                                <label for="iPrioridade">@RsCadastros.TIPO_DE_CONEXAO:</label>
                                <br>
                                <div class="btn-group btn-group-toggle btn-group-sm" data-toggle="buttons">
                                    <label for="iPPPoE" id="labelPrioridadeAlta" class="btn btn-danger active">
                                        @Html.RadioButtonFor(m => m.Tipo_Conexao, "PPPoE", new { @id = "iPPPoE" })<span>@RsCadastros.PPPOE</span>
                                    </label>
                                    <label id="iBRIDGE" class="btn btn-danger">
                                        @Html.RadioButtonFor(m => m.Tipo_Conexao, "BRIDGE", new { @id = "iBRIDGE" })<span>@RsCadastros.BRIDGE</span>
                                    </label>
                                    <label id="iDHCP" class="btn btn-danger">
                                        @Html.RadioButtonFor(m => m.Tipo_Conexao, "DHCP", new { @id = "iDHCP" })<span>@RsCadastros.DHCP</span>
                                    </label>
                                    <label id="iDHCP" class="btn btn-danger">
                                        @Html.RadioButtonFor(m => m.Tipo_Conexao, "IP_ESTATICO", new { @id = "iIP_ESTATICO" })<span>@RsCadastros.IP_ESTATICO</span>
                                    </label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="iTipo_Identificacao">@RsCadastros.TIPO_IDENTIFICACAO:</label>
                                    @Html.EnumDropDownListFor(m => m.Tipo_Identificacao, RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iTipo_Identificacao", @autocomplete = "off" })
                                    
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label for="iLogin" class="fs-12">@RsCadastros.LOGIN_PPPOE</label>
                                <div class="form-group">
                                    @Html.TextBoxFor(model => model.Login, new { @id = "iLogin_PPPOE", @class = "form-control obrigatorio", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <label for="iSenha" class="fs-12">@RsCadastros.SENHA_PPPOE</label>
                                <div class="form-group">
                                    @Html.TextBoxFor(model => model.Senha, new { @id = "iSenha_PPPOE", @type = "password", @class = "form-control obrigatorio", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label for="iLoginAdmin" class="fs-12">@RsCadastros.LOGIN_ADMIN</label>
                                <div class="form-group">
                                    @Html.TextBoxFor(model => model.LoginAdmin, new { @id = "iLoginAdmin", @class = "form-control obrigatorio", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <label for="iSenha" class="fs-12">@RsCadastros.SENHA_ADMIN</label>
                                <div class="form-group">
                                    @Html.TextBoxFor(model => model.SenhaAdmin, new { @id = "iSenhaAdmin", @type = "password", @class = "form-control obrigatorio", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <label for="iPortaVLan" class="fs-12">@RsCadastros.PORTA_VLAN</label>
                                <div class="form-group">
                                    @Html.TextBoxFor(model => model.PortaVLan, new { @id = "iPortaVLan", @type = "number", @min = 1, @max = 4, @class = "form-control obrigatorio", @autocomplete = "off" })
                                </div>
