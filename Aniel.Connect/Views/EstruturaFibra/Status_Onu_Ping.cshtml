@model Aniel.Connect.Models.StatusOnuPing

@using Resources

@{
    ViewBag.Title = RsCadastros.STATUS_EQUIPAMENTO;
    ViewBag.Sessao = RsCadastros.STATUS_EQUIPAMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script>
        $("#iInfoBasicas").on('click', function () {
            ShowPageLoading()
            window.location.href = '@Url.Action("Status_Onu_Informacoes_Basicas", "EstruturaFibra")?Id_Onu=@Model.Id_Onu';
        });

        $("#iHardware").on('click', function () {
            ShowPageLoading()
            window.location.href = '@Url.Action("Status_Onu_Hardware", "EstruturaFibra")?Id_Onu=@Model.Id_Onu';
        });

        $("#iConfEquipamento").on('click', function () {
            ShowPageLoading()
            window.location.href = '@Url.Action("Status_Onu_Configuracoes", "EstruturaFibra")?Id_Onu=@Model.Id_Onu';
        });

        $("#iPingExterno").on('click', function () {
            ShowPageLoading()
            window.location.href = window.location.href;
        });
    </script>
}

<div class="container-fluid" id="divTitle">
    <ul class="nav nav-tabs" id="tab" role="tablist">
        <li class="nav-item">
            <a class="nav-link" id="iInfoBasicas" data-toggle="tab" href="#" role="tab" aria-selected="false">@RsCadastros.INFORMACOES_BASICAS</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="iHardware" data-toggle="tab" href="#" role="tab" aria-selected="false">@RsCadastros.HARDWARE</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="iConfEquipamento" data-toggle="tab" href="#" role="tab" aria-selected="false">@RsCadastros.CONFIGURACOES_EQUIPAMENTO</a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" id="iPingExterno" data-toggle="tab" href="#" role="tab" aria-selected="true">@RsCadastros.PING_EXTERNO</a>
        </li>
    </ul>

    @if (Model.Respostas_Ping != null)
    {
        for (var i = 0; i < Model.Respostas_Ping.Count(); i++)
        {
            <div class="row">
                <div class="col-sm-4">
                    <label class="fs-12">Teste @i:</label>
                    <div class="form-group">@Model.Respostas_Ping[i]</div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-sm-12">
                Não foi possivél realizar testes de Ping.
            </div>
        </div>
    }
</div>



