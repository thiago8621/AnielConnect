@model Aniel.Connect.Models.Faixa_ComissionamentoCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_FAIXA_COMISSIONAMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

    <script>

        $(document).ready(function () {

            AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null,  null, "@Model.Id_Filial", "@RsBase.SELECIONE", false);
        });


        //somenteNumeros("iFaixa_Inicial");
        //somenteNumeros("iFaixa_Final");
        $('.percent').mask('000,00', { reverse: true });

        var oDatatable;

        var handleDataTableButtons = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Itens));

        var nome_lista = "Itens";//Nome_utilizado para enganar o razor

            //"Blfrtip"
        oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                paging: false,
                ordering: false,
                columns: [
                    {
                        data: "Id",
                        orderable: false,
                        render: function (data, type, row, meta) {
                            return '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir="' + row.Id +'"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id_Faixa_Comissionamento" name="' + nome_lista + '[' + meta.row + '].Id_Faixa_Comissionamento" type="hidden" value="' + TrataNulo(row.Id_Faixa_Comissionamento) + '">';
                        }
                    },
                    {
                        data: "Faixa_Inicial",
                        title: "@RsCadastros.FAIXA_INICIAL",
                        orderable: false,
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Faixa_Inicial" name="' + nome_lista + '[' + meta.row + '].Faixa_Inicial" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Faixa_Final",
                        title: "@RsCadastros.FAIXA_FINAL",
                        orderable: false,
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Faixa_Final" name="' + nome_lista + '[' + meta.row + '].Faixa_Final" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                     {
                        data: "Coeficiente",
                        title: "@RsCadastros.COEFICIENTE",
                        orderable: false,
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Coeficiente" name="' + nome_lista + '[' + meta.row + '].Coeficiente" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    }
                ]
            });

        function handleExcluir() {
            $(".btnExcluir").unbind('click');
                $(".btnExcluir").click(function (e) {
                    e.preventDefault();

                    var item = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (item === "0") {
                        oDatatable.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Faixa_ComissionamentoApi/ExcluirFaixaItem?item=")' + item + '&faixa=@Model.Id';

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatable.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });
            }


            handleExcluir();

            $("#btnAdicionar").on('click', function () {

                var erro = false;

                @*if (!$("#iMeio").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MEIO_CAPTACAO)", "warning");
                    erro = true;
                }*@

            @*for (var i = 0; i < oDatatable.rows().data().length; i++) {

                    if (oDatatable.rows().data()[i].Id_Meio == $("#iMeio option:selected").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.MEIO_CAPTACAO)", "warning");
                        erro = true;
                        i = oDatatable.rows().data().length;
                    }

                }*@

                for (let iterator = 0; iterator < oDatatable.rows().data().length; iterator++) {

                    if (Number($('#iFaixa_Inicial').val()) <= Number(oDatatable.rows().data()[iterator].Faixa_Final)) {
                        Notificar("@RsBase.ATENCAO_", "A faixa inicial deve ser maior do que a última faixa final adicionada", "warning");
                        erro = true;
                    }

                    if (Number($('#iFaixa_Final').val()) <= Number(oDatatable.rows().data()[iterator].Faixa_Final)) {

                        Notificar("@RsBase.ATENCAO_", "A faixa final deve ser maior do que a última faixa final adicionada", "warning");
                        erro = true;
                    }
                }

                if (Number($('#iFaixa_Inicial').val()) >= Number($('#iFaixa_Final').val())) {
                    Notificar("@RsBase.ATENCAO_", "A faixa inicial não pode ser maior ou igual do que a faixa final", "warning");
                    erro = true;
                }


                if (parseFloat($('#iFaixa_Inicial').val().replace(".", "").replace(",", ".")) >= parseFloat($('#iFaixa_Final').val().replace(".", "").replace(",", "."))) {
                    Notificar("@RsBase.ATENCAO_", "A faixa inicial não pode ser maior ou igual do que a faixa final", "warning");
                    erro = true;
                }



                if ($('#iFaixa_Inicial').val() == "" || $('#iFaixa_Inicial').val() <= 0) {
                    Notificar("@RsBase.ATENCAO_", "Informe a faixa inicial", "warning");
                    erro = true;
                }

                if ($('#iFaixa_Final').val() == "" || $('#iFaixa_Final').val() <= 0) {
                    Notificar("@RsBase.ATENCAO_", "Informe a faixa final", "warning");
                    erro = true;
                }

                if ($('#iCoeficiente').val() == "" || $('#iCoeficiente').val() <= 0) {
                    Notificar("@RsBase.ATENCAO_", "Informe o coeficiente", "warning");
                    erro = true;
                }

                if (erro == false) {
                    for (var faixa of oDatatable.data().toArray()) {


                        var faixa_inicial_adicionar = parseFloat($('#iFaixa_Inicial').val().replace(".", "").replace(",", "."))
                        var faixa_final_adicionar = parseFloat($('#iFaixa_Final').val().replace(".", "").replace(",", "."));

                        var faixa_inicial = parseFloat(faixa.Faixa_Inicial.replace(".", "").replace(",", "."));
                        var faixa_final = parseFloat(faixa.Faixa_Final.replace(".", "").replace(",", "."));

                        

                        if ( (faixa_inicial_adicionar >= faixa_inicial && faixa_inicial_adicionar <= faixa_final) || (faixa_final_adicionar >= faixa_inicial && faixa_final_adicionar <= faixa_final)) {
                            Notificar("@RsBase.ATENCAO_", "Faixa informada está atingindo valores de outras faixas", "warning");
                            erro = true;
                            break;
                        }
                    }
                }

                if (erro) {
                    return false;
                    $('#iFaixa_Inicial');
                }


                

                oDatatable.row.add({

                    Id: 0,
                    Id_Faixa_Comissionamento: 0,
                    Faixa_Inicial: $("#iFaixa_Inicial").val(),
                    Faixa_Final: $("#iFaixa_Final").val(),
                    Coeficiente: $("#iCoeficiente").val(),

                }).draw(false);

                $("#iFaixa_Inicial").val(null);
                $("#iFaixa_Final").val(null);
                $("#iCoeficiente").val(null);

                handleExcluir();
            });


        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();




    var clicked = false;
    function ValidaSubmit()
    {

        if (clicked) {
            return false;
        }

        clicked = true;


        var erro = false;
        if (ValidaCamposObrigatorios(erro)) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning");
            erro = true;
        }

        if (oDatatable.rows().data().length < 1) {
            erro = true;
            Notificar("@RsBase.ERRO", "@String.Format(RsBase.REQUIRED, RsCadastros.FAIXA_DE_COMISSIONAMENTO)", "warning");
        }


        if (erro) {
            clicked = false;
            return false;
        }

        ShowPageLoading();
        $('#form').submit();

    }

    </script>
}


@using (Html.BeginForm("Cadastro", "Faixa_Comissionamento", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;width:99%">
            <div class="card-body">

                <div class="col main-title">
                    <h4 class="title-page"><i class="fas fa-dollar-sign"></i> @ViewBag.Title</h4>

                    <nav aria-label="breadcrumb" class="mb-20">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index", "Faixa_Comissionamento")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_FAIXA_COMISSIONAMENTO</a>
                            </li>
                            <li class="breadcrumb-item">
                                <span>@ViewBag.Title</span>
                            </li>

                        </ol>
                    </nav>

                    <span style="font-size:11px" id="dtLegend"></span>
                </div>




                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <span class="text-bold-card">@ViewBag.Title</span>
                        </h5>
                    </div>

                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="row mt-2 mb-2">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iCodigo" class="mr-3">@RsConfiguracao.CODIGO:</label>
                                        @Html.TextBoxFor(model => model.Codigo, new { @class = "form-control", @id = "iCodigo", @autocomplete = "off", @readonly = "true" })
                                        @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iDescricao" class="mr-3">@RsConfiguracao.DESCRICAO:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control obrigatorio", @id = "iDescricao", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <label for="iFilial"> @RsCadastros.FILIAL :</label>
                                    @Html.DropDownListFor(m => m.Id_Filial, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iFilial", @autocomplete = "off" })
                                </div>

                                @if (Model.Id != 0)
                                {
                                    <div class="col-sm-3 pt-3">
                                        <div class="form-group">
                                            <label for="iStatus" class="mr-3">@RsConfiguracao.STATUS:</label>
                                            @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                </div>




                <div class="row mt-3">
                    <div id="accordion" class="col-sm-6">
                        <div class="card div-card-accord">
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body">



                                    <div class="row mt-2 mb-2">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iFaixa_Inicial" class="mr-3">@RsConfiguracao.FAIXA_INICIAL:</label>
                                                @Html.TextBoxFor(model => model.Faixa_Inicial, new { @class = "form-control money", @id = "iFaixa_Inicial", @autocomplete = "off" })
                                                @if (Model.Id == 0)
                                                {
                                                    @Html.ValidationMessageFor(model => model.Faixa_Inicial, "", new { @class = "text-danger" })
                                                }

                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iDescricao" class="mr-3">@RsConfiguracao.FAIXA_FINAL:</label>
                                                @Html.TextBoxFor(model => model.Faixa_Final, new { @class = "form-control money", @id = "iFaixa_Final", @autocomplete = "off" })
                                                @if (Model.Id == 0)
                                                {
                                                    @Html.ValidationMessageFor(model => model.Faixa_Final, "", new { @class = "text-danger" })
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-2 mb-2">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="Coeficiente" class="mr-3">@RsConfiguracao.COEFICIENTE:</label>
                                                @Html.TextBoxFor(m => m.Coeficiente, new { @class = "form-control money", @placeholder = "0,00", @id = "iCoeficiente", @autocomplete = "off" })
                                                @if (Model.Id == 0)
                                                {
                                                    @Html.ValidationMessageFor(model => model.Coeficiente, "", new { @class = "text-danger" })
                                                }
                                            </div>
                                        </div>

                                    </div>

                                    <div class="col-sm-12 text-right mt-3">
                                        <input type="button" id="btnAdicionar" value="Adicionar" class="btn btn-success" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div id="accordion" class="col-sm-6">
                        <div class="card div-card-accord">
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body">

                                    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>

                                </div>

                            </div>
                        </div>

                    </div>


                </div>


            </div>
        </div>

    </div>




    <!--Button Float-->
    <a href="@Url.Action("Index", "Faixa_Comissionamento")" class="float-cancel" onclick="ShowPageLoading(); return true;">
        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
            <i class="fas fa-times fa-2x"></i>
        </div>
    </a>

    <a href="#" class="float-save" onclick="return ValidaSubmit();" return false;">
        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
            <i class="fas fa-save fa-2x"></i>
        </div>
    </a>




}