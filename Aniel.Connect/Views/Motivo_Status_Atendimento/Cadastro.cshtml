@model Aniel.Connect.Models.Motivo_Status_AtendimentoCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_MOTIVO_STATUS_ATENDIMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script>
        var clicked = false;
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

/**/</script>
}


@using (Html.BeginForm("Cadastro", "Motivo_Status_Atendimento", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-list-alt"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">

                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>

                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Motivo_Status_Atendimento")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAMOTIVO_STATUS_ATENDIMENTO</a>
                                </li>

                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>
                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">

                                <div class="col-sm-7">
                                    <div class="form-group">
                                        <label for="iNome">@RsCadastros.DESCRICAO:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off", @required = true })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    @if (Model.Id != 0)
                                    {
                                        <div class="form-group">
                                            <label for="iStatus" class="mr-3">@RsFinanceiro.STATUS:</label><br>
                                            @Html.CheckBoxFor(model => model.Status, new { @class = "form-control", @id = "iStatus", @name = "iStatus", @data_toggle = "toggle", @data_on = RsCadastros.ATIVO, @data_off = RsCadastros.INATIVO, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    }
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label for="iStatus_Motivo">@RsCadastros.STATUS_MOTIVO:</label>
                                        @Html.EnumDropDownListFor(m => m.Status_Motivo, RsBase.SELECIONE, new { @class = "form-control", @id = "iStatus_Motivo", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(m => m.Status_Motivo, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Motivo_Status_Atendimento")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}

