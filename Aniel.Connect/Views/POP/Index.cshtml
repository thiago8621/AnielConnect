@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.LISTAGEM_POP;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")

<script>
        var rows_selected = [];
        var oDatatable;

        const handleEmpresa = function () {
            $("#iEmpresa").on("select2:select select2:unselecting", function (e) {
                const empresaSelecionada = e.params.data

                if (!empresaSelecionada) {
                    AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetComboFilialAniel", @CONSTANTES.PaginacaoRegistros, null,  null, null, "@RsBase.SELECIONE", true);
                }
                else {
                    AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetComboFilialAniel", @CONSTANTES.PaginacaoRegistros, null, empresaSelecionada.id, null, "@RsBase.SELECIONE", false);
                }
            })
        }

        const handleContrato = function () {
            $("#iCodCt").on("select2:select select2:unselecting", function (e) {
                const contratoSelecionado = e.params.data

                if (!contratoSelecionado) {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
                else {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, contratoSelecionado.id, null, "@RsBase.SELECIONE", false);
                }
            })
        }

        $(document).ready(function () {
            AddSelect("iEmpresa", "@CONSTANTES.URLPortal/api/Empresaapi/GetComboEmpresaAniel", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, handleEmpresa);
            AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetComboFilialAniel", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iCodCt", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, handleContrato);
            AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iPais", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboPais",@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);            
        })

        $('#iUF').change(function () {
            const estado = $('#iUF option:selected').text();
            const enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

            $('#iCidade').empty();
            $('#iBairro').empty();

            $.getJSON(enderecoApi, function (data) {
                $('#iCidade').append($('<option></option>').attr("value", "").text('@RsBase.SELECIONE'));

                $.each(data, function (key, value) {
                    $('#iCidade').append($('<option></option>').attr("value", value.id).text(value.descricao));
                })
            });
        });

        $('#iCidade').change(function () {
            const cidade = $('#iCidade option:selected').val();
            const enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/GetBairros?Id_Cidade=" + cidade;

            $('#iDesc_Cidade').val($('#iCidade option:selected').text());
            $("#iBairro").empty();

            $.getJSON(enderecoApi, function (data) {
                $('#iBairro').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));

                $.each(data, function (key, value) {
                    $('#iBairro').append($('<option></option>').attr('value', value.id).text(value.descricao));
                })
            });
        });

        var handleDataTableButtons = function () {
            "use strict";

            //"Blfrtip"

            oDatatable = new DataTable("#datatable", {
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    },
                    {
                        targets: [1, 3, 4, 5, 6, 7, 8, 9, 10],
                        searchable: false,
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '79vh',
                /*stateSave: true,*/
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, 250, 750, 1000], [10, 25, 50, 100, 250, 750, 1000]],
                ajax: {
                    url: baseUrl + '/api/POPapi/GetAll',
                    type: 'POST',
                    data: function (data) {
                        data.IdEmpresa = $("#iEmpresa").val()
                        data.IdFilial = $("#iFilial").val()

                        data.CodCt = $("#iCodCt").val()
                        data.Projeto = $("#iProjeto").val()

                        data.IdPais = $("#iPais").val()
                        data.UF = $("#iUF").val()
                        data.IdCidade = $("#iCidade").val()
                        data.IdBairro = $("#iBairro").val()
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "id", title: "@RsCadastros.ID" },
                    { data: "nome", title: "@RsCadastros.NOME" },


                    { data: "empresa", title: "@RsCadastros.EMPRESA" },
                    { data: "filial", title: "@RsCadastros.FILIAL" },

                    { data: "contrato", title: "@RsCadastros.CONTRATO" },
                    { data: "projeto", title: "@RsCadastros.PROJETO" },

                    { data: "pais", title: "@RsCadastros.PAIS" },
                    { data: "cidade", title: "@RsCadastros.CIDADE" },
                    { data: "uf", title: "@RsCadastros.UF" },

                    { data: "endereco", title: "@RsCadastros.ENDERECO" },
                    { data: "cep", title: "@RsCadastros.CEP" },

                    { data: "latitude", title: "@RsCadastros.LATITUDE" },
                    { data: "longitude", title: "@RsCadastros.LONGITUDE" },

                    { data: "status", title: "@RsCadastros.STATUS" }
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });

            $("#iPesquisar").on("click", function () {
                $("#modal-filter").modal('hide');

                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();

                return true;
            });

            $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {
                $("#iEmpresa").val(null).trigger("change")
                $("#iFilial").val(null).trigger("change")

                $("#iCodCt").val(null).trigger("change")
                $("#iProjeto").val(null).trigger("change")

                $("#iUF").val("")
                $("#iPais").val("")
                $("#iCidade").val("")
                $("#iBairro").val("")

                $('#txtSearch').val("")

                rows_selected = []
                oDatatable.search($('#txtSearch').val()).draw()
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;
                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function () {
                if (oDatatable.row(this).data() != null) {
                    const _id = oDatatable.row(this).data().id;
                    const url = '@Url.Action("Cadastro", "POP", new { id = "__id__" })';

                    window.location.href = url.replace('__id__', _id);

                    ShowPageLoading();
                }
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtons();
                }
            }
        }();

        TableManageButtons.init();

</script>
}


<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-server"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GERENCIAMENTO_REDE</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

            @*<span style="font-size:11px;margin-left: 15px;" id="dtLegend"></span>*@
        </div>

        <div class="col-auto mb-3">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.POP" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
                <a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "POP")" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>

                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltro" onclick="$('#txtSearch').val('');oDatatable.search('').draw();" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" id="btnImportarPop" onclick="AddAba('@Url.Action("importacao","POP")');">Importar POP</a>

                </div>
            </div>
        </div>

    </div>
    <!--./main-->
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>

<!--Modal Filters-->

<div class="modal" id="modal-filter">
