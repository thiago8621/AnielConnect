        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title text-muted"> Filtros POP </h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iEmpresa">@RsCadastros.EMPRESA</label>
                            <select class="form-control" id="iEmpresa">
                                <option value="">@RsBase.SELECIONE</option>
                            </select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iFilial">@RsCadastros.FILIAL</label>
                            <select class="form-control" id="iFilial">
                                <option value="">@RsBase.SELECIONE</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iCodCt">@RsCadastros.CONTRATO</label>
                            <select class="form-control" id="iCodCt">
                                <option value="">@RsBase.SELECIONE</option>
                            </select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iProjeto">@RsCadastros.PROJETO</label>
                            <select class="form-control" id="iProjeto">
                                <option value="">@RsBase.SELECIONE</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iPais">@RsCadastros.PAIS</label>
                            <select class="form-control" id="iPais">
                                <option value="">@RsBase.SELECIONE</option>
                            </select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iUF">@RsCadastros.UF</label>
                            <select class="form-control" id="iUF">
                                <option value="">@RsBase.SELECIONE</option>
                                <option value="AC">AC</option>
                                <option value="AL">AL</option>
                                <option value="AP">AP</option>
                                <option value="AM">AM</option>
                                <option value="BA">BA</option>
                                <option value="CE">CE</option>
                                <option value="DF">DF</option>
                                <option value="ES">ES</option>
                                <option value="GO">GO</option>
                                <option value="MA">MA</option>
                                <option value="MT">MT</option>
                                <option value="MS">MS</option>
                                <option value="MG">MG</option>
                                <option value="PA">PA</option>
                                <option value="PB">PB</option>
                                <option value="PR">PR</option>
                                <option value="PE">PE</option>
                                <option value="PI">PI</option>
                                <option value="RJ">RJ</option>
                                <option value="RN">RN</option>
                                <option value="RS">RS</option>
                                <option value="RO">RO</option>
                                <option value="RR">RR</option>
                                <option value="SC">SC</option>
                                <option value="SP">SP</option>
                                <option value="SE">SE</option>
                                <option value="TO">TO</option>
                            </select>
                        </div>
                    </div>                    
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iCidade">@RsCadastros.CIDADE</label>
                            <select class="form-control" id="iCidade">
                                <option value="">@RsBase.SELECIONE</option>
                            </select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iBairro">@RsCadastros.BAIRRO</label>
                            <select class="form-control" id="iBairro">
                                <option value="">@RsBase.SELECIONE</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<!-- /.modal-->