        $("#btnConsultaViabilidade").on("click", async function () {
            let latitude = Number(latitudeBanco.replace(",", "."));
            let longitude = Number(longitudeBanco.replace(",", "."));

            if (latitude == 0 && longitude == 0) {
                latitude = Number($("#iLatitudeInstalacao").val().replace(",", "."));
                longitude = Number($("#iLongitudeInstalacao").val().replace(",", "."));
            }

            const logradouro = $("#iId_Endereco_LogradouroInstalacao").val();
            const numero = $("#iNumeroInstalacao").val();

            const descricaoLogradouro = $("#iLogradouroInstalacao").val();
            const cidade = $("#iCidadeInstalacao").val();

            //Condomínio
            const bloco = $("#iBlocoSelectInstalacao").val();
            const apto_numero = $("#iApartamentoSelectInstalacao").val();
            const condominio = $("#iId_Condominio_PredioInstalacao").val();

            try {
                $("#divProgress").show();
                const result = await ExecutarConsultaViabilidade(latitude, longitude, logradouro, numero, descricaoLogradouro, cidade, condominio, bloco, apto_numero);
                consultaViabilidadeResult = result;
                if (result != null && result.ok) {
                    let possuiDisponibilidade = null;
                    possuiDisponibilidade = result.objeto.possuiDisponibilidade;

                    if (possuiDisponibilidade == VIABILIDADE_APROVADA) {
                        AtualizarIndicadorStatusConsulta(CONSULTA_VIABILIDADE, STATUS_CONSULTA_APROVADA);
                    }
                    else if (possuiDisponibilidade == VIABILIDADE_APROVADA_RESSALVA) {
                        AtualizarIndicadorStatusConsulta(CONSULTA_VIABILIDADE, STATUS_CONSULTA_AGUARDANDO_AVALIACAO_GESTOR)
                    }
                    else {
                        AtualizarIndicadorStatusConsulta(CONSULTA_VIABILIDADE, STATUS_CONSULTA_REPROVADA);
                    }

                    @if (AcessoHelper.TemAcesso(_areas, "322"))
                    {
                    <text>
                    @*
                        Renderiza o botão da exibição de resultados da consulta de viabilidade
                        caso ele ainda não tenha sido renderizado
                    *@
                    if ($("#btnResultadoConsultaViabilidade").length == 0) {
                        RenderResultadosConsultaViabilidade(result);
                    }
                    </text>
                    }
                }

                Notificar("@RsBase.INFORMACAO", "Consulta de viabilidade concluída", "info");
            }
            catch {
                Notificar("@RsBase.ATENCAO_", "Um erro ocorreu durante a consulta de viabilidade", "warning");
            }
            finally {
                $("#divProgress").hide();
            }
        });

        async function ExecutarConsultaViabilidade(
        latitude,
        longitude,
        logradouro = null,
        numero = null,
        logradouroStr = "",
        cidade = null,
        condominio,
        bloco,
        apto_numero
        )
        {

        const requestConsultaViabilidade = {
            Latitude: latitude,
            Longitude: longitude
        };

        if (logradouro) {
            requestConsultaViabilidade.IdEnderecoLogradouro = logradouro
        }

        if (numero) {
            requestConsultaViabilidade.Numero = numero;
        }

        if (logradouroStr) {
            requestConsultaViabilidade.Logradouro = logradouroStr;
        }

        if (cidade) {
            requestConsultaViabilidade.IdCidade = cidade;
        }

        if (condominio) {
            requestConsultaViabilidade.IdCondominio = condominio;
        }

        if (bloco) {
            requestConsultaViabilidade.IdBloco = bloco;
        }

        if (apto_numero) {
            requestConsultaViabilidade.IdApto_Numero = apto_numero;
        }

        return await $.ajax({
                type: "POST",
                url: "@CONSTANTES.URLPortal/api/Consulta_ViabilidadeApi/ExecutarConsultaViabilidade",
                dataType: "json",
                data: requestConsultaViabilidade
            });

        }

        function AtualizarIndicadorStatusConsulta(consulta, status) {
            let statusClass = null;
            switch (status) {
                case STATUS_CONSULTA_PENDENTE:
                    statusClass = "circle-consulta-pendente";
                    break;
                case STATUS_CONSULTA_APROVADA:
                    statusClass = "circle-consulta-aprovada";
                    break;
                case STATUS_CONSULTA_REPROVADA:
                case STATUS_CONSULTA_AGUARDANDO_AVALIACAO_GESTOR:
                    statusClass = "circle-consulta-reprovada";
                    break;
            }

            if (statusClass != null) {
                let statusElemSelector = null;

                switch (consulta) {
                    case CONSULTA_VIABILIDADE:
                        statusElemSelector = "#statusConsultaViabilidade";
                        AtualizaStatusConsulta(statusElemSelector, vendedorVisualiza.CONSULTA_VIABILIDADE, statusClass);

                        statusConsultaViabilidade = status;
                        $("#iStatusConsultaViabilidade").val(status);
                        break;
                    case CONSULTA_PENDENCIA_FINANCEIRA:
                        statusElemSelector = "#statusConsultaPendenciaFinanceira";
                        AtualizaStatusConsulta(statusElemSelector, vendedorVisualiza.CONSULTA_PENDENCIA_FINANCEIRA, statusClass);

                        $("#iStatusConsultaPendenciaFinanceira").val(status);
                        break;
                    case CONSULTA_PENDENCIA_ENDERECO:
                        statusElemSelector = "#statusConsultaPendenciaEndereco";
                        AtualizaStatusConsulta(statusElemSelector, vendedorVisualiza.CONSULTA_PENDENCIA_ENDERECO, statusClass);

                        $("#iStatusConsultaPendenciaEndereco").val(status);
                        break;
                    case CONSULTA_CREDITO:
                        statusElemSelector = "#statusConsultaCredito";
                        AtualizaStatusConsulta(statusElemSelector, vendedorVisualiza.CONSULTA_CREDITO, statusClass);

                        $("#iStatusConsultaCredito").val(status);
                        break;
                }
            }
        }

        function AtualizaStatusConsulta(element, visualiza, classe) {
            $(element).removeClass("circle-consulta-pendente");
            $(element).removeClass("circle-consulta-aprovada");
            $(element).removeClass("circle-consulta-reprovada");

            if (@Html.Raw(Json.Encode(AcessoHelper.TemAcesso(_areas, "322")))) {
                $(element).addClass(classe);
            }
            else if (visualiza) {
                $(element).addClass(classe);
            }
            else {
                $(element).addClass("circle-consulta-pendente");
            }
        }

        @* Ações da Consulta de Viabilidade *@
        function RenderResultadosConsultaViabilidade(consulta = null) {
            $("#rowConsultaViabilidade").append(
                `<div class="col-3 d-flex">
                    <a href="javascript:void(0)"
                       id="btnResultadoConsultaViabilidade"
                       class="btn btn-success">Resultado</a>
                </div>`
            );

            if (consulta != null) {
                $("#btnResultadoConsultaViabilidade").on("click", function () {
                    notificacaoViabilidade(consulta);
                    $("#iModalConsultaViabilidade").modal("show");

                });
            }

            $("#iVerificarMapa").on("click", function () {
                let url = "@Url.Action("Index", "Viabilidade")";
                let latitude =  $("#iLatitudeInstalacao").val().replace(",", ".");
                let longitude = $("#iLongitudeInstalacao").val().replace(",", ".");

                url = `${url}?latitude=${latitude}&&longitude=${longitude}`;
                parent.AddAba(url);
            })
        }

        function notificacaoViabilidade(request = null) {
            let mensagemRetorno = "";
            let mensagens = [];
            let motivos = [];
            if (!request || request?.objeto?.caixas?.length == 0 || request?.objeto?.idConsultaViabilidade == 0) {
                mensagemRetorno = `<span>Aguardando realização da consulta de viabilidade</span>`;
            }
            else {
                //Sem Viabilidade
                for (var passo of request.objeto.passos) {
                    mensagemRetorno = mensagemRetorno.concat(` <br> <span> ${passo} </span> `);
                }
                if ((request.objeto.possuiDisponibilidade == VIABILIDADE_REPROVADA)) {

                    request.objeto.motivos.forEach(obj => motivos.push(obj.motivo));
                    mensagemRetorno = mensagemRetorno.concat(` <br> <span> Resultado da consulta de viabilidade: ${motivos.join(" - ")} </span> `);

                    @* Criação do div de alerta *@
                }
                else if (request.objeto.caixas.length > 0) {
                    //Com Viabilidade
                    mensagens.push(`Caixa reservada: ${request.objeto.caixas[0].descricao}`);
                    mensagens.push(`Porta reservada: ${request.objeto.caixas[0].portasDisponiveis[0]}`);
                }
            }

            $("#spanMotivoAprovManualViabiliadade").text("");

            if (request?.objeto?.motivoAprovacaoManual) {
                $("#divMotivoAprovManualViabilidade").show();
                $("#spanMotivoAprovManualViabiliadade").text(request?.objeto?.motivoAprovacaoManual);
            }

            let div = $("#iResultadoViabilidade");
            let alerta = $("#iAlertaViabilidade");

            $("#iResultadoViabilidade").empty();
            $("#iAlertaViabilidade").empty();

            for (let mensagem of mensagens) {
                if (!mensagemRetorno) {
                    mensagemRetorno = mensagem;
                }
                else {
                    mensagemRetorno = `${mensagemRetorno} <br> ${mensagem}`;
                }
            }
            div.append($.parseHTML(mensagemRetorno));
            alerta.append($.parseHTML(mensagemRetorno));

            alerta.removeClass("d-none");
            alerta.parent().removeClass("d-none");
            $("#iVerificarMapa").attr("hidden", false);
        }
        $("#iButtonConfirmarMap").on("click", function (data) {

            confirmarLocalizacao()

        });
    @if (!String.IsNullOrEmpty(Request.Params["atendimento"]))
    {
        <text>
        $('#iId_Atendimento').val(@Request.Params["atendimento"]);
        </text>
    }

    @if (!String.IsNullOrEmpty(Request.Params["IdClientePlanoProduto"]))
    {
        <text>
                $('#iId_ClientePlanoProduto').val(@Request.Params["IdClientePlanoProduto"]);
        </text>
    }
    </script>

