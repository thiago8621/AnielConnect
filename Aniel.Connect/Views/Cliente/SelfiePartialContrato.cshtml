@model Aniel.Connect.Model.ContratoFormularioClienteModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Core
@using Aniel.Connect.Models
@using Aniel.Connect.ControllersWebApi
@using Aniel.Connect.Model.enumerado
@{


    var camposObrigatorios = (Dictionary<String, Boolean>)ViewBag.CamposObrigatorios;
    var camposBloqueados = new Dictionary<string, bool>();

    var stringObrigatorio = Html.Raw("<span class=\"text-danger\">* </span>");

}

@if (Model.ExigeFotoTermo == false) {

    <div class="tab card-body body-card-accord">
        <div id="divNaoObrigatorio" class="form-group">

            <div class="mt-4 row" style="display:inline-block">
                <div id="iDivTipoAtividade" style="">
                    <label class="form-control">
                        Deseja enviar o documento de identificação?
                    </label>
                    <input type="radio" value="1" name="deseja_enviar" id="sim"> Sim
                    <input type="radio" value="0" checked name="deseja_enviar" id="nao"> Não
                </div>
            </div>
        </div>

        <div id="DivSelecionar" style="overflow:auto;">
            <div style="float:right;">
                <button type="button" class="btn botao btn-lg btn-primary DesejaSelecionar" id="nextBtn">Próximo</button>
            </div>
        </div>

    </div>
}

@*//PASSO 1: ENVIO DE DOCUMENTO DE IDENTIFICAÇÃO*@
<div class="tab card-body body-card-accord passo1">
    <div id="Camera" class="form-group">

        <div class="area">
            <video autoplay="true" id="webCamera">
            </video>

            <input type="text" id="base_img" name="base_img" style="display:none">
            <button type="button" onclick="takeSnapShot()">Tirar foto e salvar</button>
        </div>
    </div>

    <div style="overflow:auto;">
        <div style="float:right;">
            <button type="button" class="btn botao btn-lg btn-primary" id="prevBtn" onclick="nextPrev(-1)">Anterior</button>
            <button type="button" class="btn botao btn-lg btn-primary" id="nextBtn" onclick="nextPrev(1)">Próximo</button>
        </div>
    </div>
</div>



@*//PASSO 2: CONFIRMAÇÃO DE FOTOGRAFIA*@
<div class="tab passo2" id="passo2">
    <div class="form-group">
        <div class="area">
            <img id="imagemConvertida">

            @Html.TextBoxFor(model => model.Base64, new { @class = "form-control", @id = "InputBase64", @autocomplete = "off", @style = "display:none" })

            <p id="caminhoImagem" class="caminho-imagem"><a href="" target="_blank" rel="noopener"></a></p>
        </div>
    </div>
    <div style="overflow:auto;">
        <div style="float:right;">
            <button type="button" class="btn botao btn-lg btn-primary" id="prevBtn" onclick="nextPrev(-1)">Anterior</button>
            <button type="button" class="btn botao btn-lg btn-primary" id="nextBtn" onclick="nextPrev(1)">Próximo</button>
        </div>
    </div>
</div>


@*//PASSO 3: TERMO DE ACEITE*@
<div class="tab passo3">
    @if (Model.isIntegracao) {
        <text>
            <iframe class="termo"
                    src="@Model.Termo"
                    frameborder="0"
                    id="iframeTermo"></iframe>
        </text>
    } else {
        <text>
            <embed src="@Model.Termo" width="1000" height="720" type="application/pdf">
        </text>
    }

    <div class="row" style="justify-content: center; position:relative">
        <div class="col-1">
            @Html.CheckBoxFor(model => Model.Aceito, new { @class = "form-check-input", @id = "check-termo", name = "check-termo" })
        </div>
        <span>Li e concordo plenamente com o termo apresentado</span>
    </div>

    <div  style="overflow:auto;">
        <button class="btn btn-success btn-lg botao" id="iAceitar" onclick="return ValidaSubmit(true);">Aceitar Termo</button>
        <button class="btn btn-danger btn-lg botao" id="iRecusar" onclick="return ValidaSubmit(false);">Recusar Termo</button>
    </div>


    <div style="overflow:auto;">
        <div style="float:right;">
            @if (Model.ExigeFotoTermo == false) {
                <button class="btn botao btn-lg btn-primary" type="button" id="prevBtn" onclick="nextPrev(-3)">Anterior</button>
            } else {
                <button class="btn botao btn-lg btn-primary" type="button" id="prevBtn" onclick="nextPrev(-1)">Anterior</button>
            }
        </div>
    </div>
</div>

@*//MOSTRA OS PASSOS*@
<div style="text-align:center;margin-top:40px;">
    <span class="step" id="step1"></span>
    <span class="step" id="step2"></span>
    <span class="step" id="step3"></span>
</div>