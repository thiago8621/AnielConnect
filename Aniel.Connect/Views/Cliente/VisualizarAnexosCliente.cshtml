@model Aniel.Connect.Models.ClienteAnexoModelView
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = "Anexar Arquivo";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    ViewBag.URLArquivo = String.Format("{0}/Arquivos/Cliente/{1}", CONSTANTES.URLPortal, Model.Id_Cliente);
    List<Aniel.Connect.Models.T5.AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")

    <style>
        th.dt-center, td.dt-center {
            text-align: center;
        }
    </style>
}


@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>

        var oDatatable = null;

        $(document).ready(function () {

            $("#iTitulo").val("");
            $("#hiddenFotoWebCam").val("");

            $("#iArquivo").val("");
            $("#iArquivo").next('.custom-file-label').html("@RsBase.ESCOLHAUMARQUIVO");

            $("#iFotoPerfil").prop("checked", false).change();

            oDatatable.draw();
        })

        var handleDataTableButtons = function () {
            "use strict";

            //"Blfrtip"
            var array = @Html.Raw(Json.Encode(ViewBag.Lista));

            var nome_lista = "Model";


            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                columnDefs: [
                    { className: "dt-center", targets: "_all" }
                ],
                language: traducaoDataTableSimples,
                paging: false,
                scrollY: "300px",
                scrollCollapse: true,
                data: array,
                columns: [
                    {
                        data: 'Usuario',
                        title: '@RsCadastros.USUARIO',
                        orderable: false,
                        defaultContent: '-'
                    },
                    {
                        data: "DataHora",
                        title: '@RsCadastros.DATAHORA',
                        orderable: false,
                        defaultContent: '-'
                    },
                    {
                        data: "NumeroContrato",
                        title: '@RsCadastros.CONTRATO',
                        orderable: false,
                        defaultContent: '-'
                    },
                      {
                        data: "Nome_Arquivo",
                        title: "@RsCadastros.TITULO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Nome_Arquivo" name="' + nome_lista + '[' + meta.row + '].Nome_Arquivo" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                       data: "Extensao_Arquivo",
                       title: "@RsCadastros.EXTENSAO_ARQUIVO",
                       render: function (data, type, row, meta) {
                             if (type === 'display') {
                                  data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Extensao_Arquivo" name="' + nome_lista + '[' + meta.row + '].Extensao_Arquivo" type="hidden" value="' + TrataNulo(data) + '">';
                             }
                            return data;
                        }
                    },
                    {
                        data: "StatusAceiteContrato",
                        title: '@RsCadastros.STATUS',
                        orderable: false,
                        defaultContent: '-'
                    },
                    {
                        data: null,
                        title: 'Enviar/Reenviar',
                        orderable: false,
                        defaultContent: '-',
                        render: function (data, type, row, meta) {
                            let dadosEnviar = row;

                            if (row.NumeroContrato != "") {
                                return '<td>' +
                                    `<a href="#" class="iEnviarDocContrato"><i class="fa fa-paper-plane" style="font-size:16px;"></i></a>` +
                                    '</td>';
                            }
                        }
                    },
                    {
                       data: null,
                       title: '@RsCadastros.DOWNLOAD',
                       orderable: false,
                       defaultContent: '-',
                       render: function (data, type, row, meta) {
                            if (row.Extensao_Arquivo == "pdf") {
                                return '<td>' +
                                    `<a href="@ViewBag.URLArquivo/${row.Nome_Arquivo}.${row.Extensao_Arquivo}" download="${row.Nome_Arquivo}.${row.Extensao_Arquivo}"><i class="fa fa-download" style="font-size:16px;"></i></a>` +
                                    '</td>';
                            }
                            else {
                                 return '<td>' +
                                    `<a href="@ViewBag.URLArquivo/${row.Id}.${row.Extensao_Arquivo}" download="${row.Id}.${row.Extensao_Arquivo}"><i class="fa fa-download" style="font-size:16px;"></i></a>` +
                                    '</td>';
                            }
                        }
                    },
                    {
                        data: null,
                        title: "@RsBase.VISUALIZAR",
                        render: function (data, type, row, meta) {
                            if (data != 0) {
                                if (row.Extensao_Arquivo == "pdf") {
                                    return '<td>' +
                                        `<a href="@ViewBag.URLArquivo/${row.Nome_Arquivo}.${row.Extensao_Arquivo}" target="_blank"><i class="far fa-eye" style="font-size:16px;"></i></a>` +
                                        '</td>';
                                }
                                else {
                                     return '<td>' +
                                         `<a href="@ViewBag.URLArquivo/${row.Id}.${row.Extensao_Arquivo}" target="_blank"><i class="far fa-eye" style="font-size:16px;"></i></a>` +
                                    '</td>';
                                }

                            }
                            else {
                                return '<td>' +
                                    '<input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                    '</td>';
                            }
                        },
                    },
                    {
                        data: 'Id',
                        title: "Remover",
                        render: function (data, type, row, meta) {

                            if (data != 0) {
                                if (row.NumeroContrato != "") {
                                    return '<td>' +
                                        '<input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                        '</td>';
                                }
                                else {
                                    return '<td>' +
                                        '<input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                        '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '"><i class="far fa-trash-alt" style="font-size:16px;padding-right:2px;"></i></a>' +
                                        '</td>';
                                }                         
                            }
                            else {
                                return '<td>' +
                                    '<input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                    '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '"><i class="far fa-trash-alt" style="font-size:16px;padding-right:2px;"></i></a>'+
                                    '</td>';
                            }
                        },
                    },
                    {
                        data: "FotoWebCam",
                        render: function (data, type, row, meta) {

                            return ' <input id="' + nome_lista + '_' + meta.row + '__FotoWebCam" name="' + nome_lista + '[' + meta.row + '].FotoWebCam" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                    },
                    {
                        data: "Id_Cliente",
                        render: function (data, type, row, meta) {

                            return ' <input id="' + nome_lista + '_' + meta.row + '__Id_Cliente" name="' + nome_lista + '[' + meta.row + '].Id_Cliente" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                    },
                    {
                        data: "IsArquivoContratoAditivo",visible:false
                    },
                    {
                        data: "Foto_Perfil",
                        render: function (data, type, row, meta) {

                            return ' <input id="' + nome_lista + '_' + meta.row + '__Foto_Perfil" name="' + nome_lista + '[' + meta.row + '].Foto_Perfil" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                    },
                ]
            });
          
            $("#btnAdicionarArquivo").on("click", function () {

                var erro = false;
                if (!$("#iTitulo").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TITULO)", "warning");
                    erro = true;
                }
                if ($("#iArquivo")[0].files.length == 0 && !$("#hiddenFotoWebCam").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ARQUIVO)", "warning");
                    erro = true;
                }

                if ($("#iArquivo")[0].files.length != 0) {

                    var nomeArquivoSplitArray = $("#iArquivo")[0].files[0].name.split('.')
                    var extArquivo = nomeArquivoSplitArray[nomeArquivoSplitArray.length - 1]

                    if (extArquivo != "png" && extArquivo != "jpg" && extArquivo != "jpeg") {

                        if ($("#iFotoPerfil").prop("checked")) {
                            Notificar("@RsBase.ATENCAO_", "Formato de arquivo não permitido como foto de perfil", "warning");
                            erro = true;
                        }
                    }
                }

                var qtdFotoPerfil = $.grep(oDatatable.rows().data(), obj => obj.Foto_Perfil)
                if (qtdFotoPerfil != 0 && $("#iFotoPerfil").prop("checked")) {

                    Notificar("@RsBase.ATENCAO_", "É permitido apenas uma foto de perfil", "warning");
                    erro = true;
                }

                if (erro)
                    return false;

                ShowPageLoading();

                if (!$("#hiddenFotoWebCam").val()) {
                    var nomeArquivo = $("#iArquivo").val().replace('C:\\fakepath\\', ' ');
                }
                else {
                    var nomeArquivo = "Camera.png";
                }

                oDatatable.row.add({
                    Usuario: @Html.Raw(Json.Encode(User.Identity.Name)),
                    DataHora: '',
                    Nome_Arquivo: $("#iTitulo").val(),
                    Extensao_Arquivo: nomeArquivo.substr(-4),
                    FotoWebCam: $("#hiddenFotoWebCam").val(),
                    Id_Cliente: @Html.Raw(Json.Encode(Model.Id_Cliente)),
                    Foto_Perfil: $("#iFotoPerfil").prop("checked"),
                    Id: 0,
                }).draw(false);

                $("#iTitulo").val("");
                $("#hiddenFotoWebCam").val("");

                //$("#iArquivo").val("");
                $("#iArquivo").next('.custom-file-label').html("@RsBase.ESCOLHAUMARQUIVO");

                $("#iFotoPerfil").prop("checked", false).change();

                $("#iModalFoto").modal('hide');

                ValidaSubmit();
            });
            const True = true;
            const False = false;
            const area = @AcessoHelper.TemAcesso(_areas, "265");




            $("#datatable").on("click", ".btnExcluir", function (e) {
                if (area) {
                    Swal.fire({
                        title: "Deseja excluir o Anexo ?",
                        text: "Não será possível restaurar o anexo excluído!",
                        type: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Sim',
                        cancelButtonText: 'Não'
                    }).then(async (result) => {
                        if (result.value) {

                            e.preventDefault();

                            var rowSelecionada = $(this).parents('tr');
                            var _id = oDatatable.row(rowSelecionada).data().Id;

                            if (_id != 0) {

                                $.ajax({
                                    type: 'GET',
                                    url: "@CONSTANTES.URLPortal/api/clienteapi/ExcluirAnexo?Id=" + _id,
                                    dataType: 'json'
                                }).
                                    done(function (data) {

                                        if (data.ok) {

                                            oDatatable.row(rowSelecionada).remove().draw(false);
                                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                        }
                                        else {

                                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                        }
                                    })
                            }
                            else {

                                oDatatable.row(rowSelecionada).remove().draw(false);
                            }
                        }

                    });

                }
                else {
                      var url = '@Html.Raw(Url.Action("ErroSemAcesso", "Home", new { Id_Cliente = Model.Id, Pagina = "Home" }))';
                       window.location=url;
                }
                })



        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

        $("#iCancelarFoto").on("click", function() {

            $(".modal-dialog").removeClass("modal-lg");
            $("#rowFotos").css({"padding-left":"6vw"})
            $(this).hide();

            $("#canvas").prop("width", "300");
            $("#iArquivo").next('.custom-file-label').html("@RsBase.ESCOLHAUMARQUIVO");

            $("#divFoto").hide();

            $("#hiddenFotoWebCam").val("");
        });

        $('#iArquivo').on('change', function () {

            var fileName = $(this).val().replace('C:\\fakepath\\', ' ');
            $(this).next('.custom-file-label').html(fileName);
        })

</script>

    <script src="~/bin/Scripts/download.js"></script>

    <script>

        // Tirar foto com a Web Cam

        'use strict';

        const video = document.getElementById('video'); // Tag <video>. Preview da foto a ser tirada
        const canvas = document.getElementById('canvas'); // Tag <canvas>. Amostra a foto tirada
        const snap = document.getElementById("iSnap"); // Botão que tira a foto

        const constraints = {
            audio: false,
            video: {
                width: 300, height: 300
            }
        };

        // Access webcam
        async function init() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia(constraints);
                handleSuccess(stream);
            } catch (e) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NAVEGADORSEMSUPORTECAM", "warning");
                $("#divCam").hide();
            }
        }

        // Success
        function handleSuccess(stream) {

            window.stream = stream;
            video.srcObject = stream;
        }

        // Load init
        init();

        function salvarImagem() {
            var image = canvas.toDataURL("image/jpg"); // !!!
            download(image, "teste");
        };

        function drawImage() {
            context.drawImage(video, 0, 0, 300, 300);
        }

        // Desenhar a imagem no canvas e baixar o arquivo
        var context = canvas.getContext('2d');
        snap.addEventListener("click", function () {

            $(".modal-dialog").addClass("modal-lg");
            $("#rowFotos").css({ 'padding-left': '3vw' });
            $("#divFoto").show();


            drawImage();
            $("#iArquivo").val('');
            $("#iArquivo").next('.custom-file-label').html("Camera.png");

            $("#iCancelarFoto").show();
            //$("#iGravarFoto").show();

            var image = canvas.toDataURL("image/png");
            $("#hiddenFotoWebCam").val(image);
        });

        $("#iModalFoto").on("hidden.bs.modal", function () {

            $("#iGravarFoto").hide();
        })

        $("#iModalFoto").on("show.bs.modal", function () {

            $("#rowFotos").css({ 'padding-left': '6vw' });
        })

        function validaFoto() {

            $("#iModalFoto").modal();
        }

        async function EnviarDocContratoEmail(element) {

            var $row = $(element).closest('tr');
            var data = $('#datatable').DataTable().row($row).data();

            let modeloSelecionado = data.ModeloSelecionadoId;
            let idCliente = data.Id_Cliente;
            let numContrato = data.NumeroContrato;
            let idCliContratoo = data.IdContrato;
            let idAnexo = data.Id;
            let isAnexoAditivo = data.IsArquivoContratoAditivo;

            let model = {
                IdCliente: idCliente,
                IdModeloSelecionado: modeloSelecionado,
                NumeroContrato: numContrato,
                IdCliContrato: idCliContratoo,
                Aditivo: isAnexoAditivo,
                IdClienteAnexo: idAnexo
            };

            ShowPageLoading();

            try {
                let response = await $.ajax({
                    url: baseUrl + '/api/clienteapi/enviarContratoCliente',
                    method: 'POST',
                    data: model
                });

                HidePageLoading();

                if (response.ok) {
                    Notificar('', `${response.idObjeto}`, 'success');
                } else {
                    Notificar('', 'Não foi possível enviar o documento/contrato para o email do Cliente', 'warning');
                }
            } catch (error) {
                HidePageLoading();
                Notificar('', 'Erro ao enviar o documento/contrato para o email do Cliente', 'error');
            }
        }

        $(document).ready(function () {
            $(document).on('click', '.iEnviarDocContrato', function (event) {
                event.preventDefault();
                EnviarDocContratoEmail(this);
            });
        });


        $('#iEnviarDocContrato').on('click', async function EnviarDocContratoEmail() {

            var $row = $(this).closest('tr');
            var data = $('#datatable').DataTable().row($row).data();

            let modeloSelecionado = data.ModeloSelecionadoId;
            let idCliente = data.Id_Cliente;
            let numContrato = data.NumeroContrato;
            let idCliContratoo = data.IdContrato;
            let idAnexo = data.Id;
            let isAnexoAditivo = data.IsArquivoContratoAditivo;

            let model = {
                IdCliente: idCliente,
                IdModeloSelecionado: modeloSelecionado,
                NumeroContrato: numContrato,
                IdCliContrato: idCliContratoo,
                Aditivo: isAnexoAditivo,
                IdClienteAnexo: idAnexo
            };

            ShowPageLoading();

        await $.ajax({
                    url: baseUrl + '/api/clienteapi/enviarContratoCliente',
                    method: 'POST',
                    data: model
                })
                .done(function (data) {
                    HidePageLoading();
                    if (data.ok) {
                        Notificar('', `${data.idObjeto}`, 'success')
                    } else {
                        Notificar('', 'Não foi possível enviar o documento/contrato para o email do Cliente', 'warning')
                    }
                });
        });

        function ValidaSubmit() {
            var erro = false;

            if (oDatatable.rows().count() == 0) {
                Notificar("@RsCadastros.ATENCAO", "Nenhum Arquivo foi Inserido", "warning");
                erro = true;
            }

            if (erro)
                return false;

            ShowPageLoading();
            $('#form').submit();
        }

    </script>
}

@using (Html.BeginForm("VisualizarAnexosCliente", "Cliente", FormMethod.Post, new { enctype = "multipart/form-data", @id = "form", autocomplete = "off" }))
{
    @Html.Hidden("Pagina", Request.Params["Pagina"])
    @Html.AntiForgeryToken()

<div style="padding:10px">
    <div class="card" style="border:none;">
        <div class="card-body">
            <div id="accordion">
                <div class="card div-card-accord">
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body">

                            <div class="row">

                                <div class="col-sm-8">
                                    <div class="form-group">
                                        @Html.HiddenFor(p => p.Id_Cliente)
                                        @Html.HiddenFor(p => p.FotoWebCam, new { @id = "hiddenFotoWebCam" })
                                        <label for="iTitulo"><strong>@RsCadastros.TITULO</strong></label>
                                        @Html.TextBoxFor(model => model.Titulo, new { @class = "form-control", @id = "iTitulo" })
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-sm-8">
                                    <div class="form-group">

                                        <label><strong>@RsCadastros.ARQUIVO</strong></label>
                                        <div class="input-group mb-3">

                                            <input type="file" class="custom-file-input" name="Arquivo" id="iArquivo" />
                                            <label for="iArquivo" class="custom-file-label"><i class="fas fa-upload"></i> @RsBase.ESCOLHAUMARQUIVO</label>

                                        </div>

                                    </div>
                                </div>
                                <!-- Ativa o modal de foto -->
                                <div class="col-sm-2" style="display: flex; align-items: center;" id="divCam">
                                    <div class="form-group">
                                        <button type="button" class="btn btn-outline-secondary" onclick="return validaFoto()" id="iTirarFoto">
                                            <i class="fas fa-camera"></i> @RsBase.TIRARFOTO
                                        </button>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iFotoPerfil">@RsCadastros.DEFINIR_FOTO_PERFIL</label>
                                        @Html.CheckBoxFor(model => model.Foto_Perfil, new { @class = "form-control", @id = "iFotoPerfil", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                                @if (AcessoHelper.TemAcesso(_areas, "264")) {
                                    <div class="col-sm-3" style="margin-left: 40.5% !important;">
                                        <div class="form-group">
                                            <button type="button" class="btn btn-success" id="btnAdicionarArquivo">@RsCadastros.ADICIONAR_ARQUIVO</button>
                                        </div>
                                    </div>
                                }

                            </div>

                        </div>

                    </div>
                </div>

            </div>
            <h5><strong>Arquivos Anexados ao Cadastro</strong></h5>


            <div id="accordion" style="margin-top: 30px;">
                <div class="card div-card-accord">
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body">

                            <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>

                        </div>

                    </div>
                </div>

            </div>

        </div>

    </div>

    <!-- Modal -->
    <div class="modal fade" id="iModalFoto" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel"> @RsBase.TIRARFOTO </h5>
                    <button type="button" id="iClose" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">

                    <div id="rowFotos">
                        <div class="row">

                            <div class="col-sm-6">

                                <!-- Imagem da câmera em tempo real -->
                                <div class="video-wrap">
                                    <video id="video" playsinline autoplay></video>
                                </div>

                            </div>

                            <div class="col-sm-6" id="divFoto">

                                <!-- Amostra da imagem -->
                                <canvas id="canvas" width="300" height="300"></canvas>

                            </div>

                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary btn-block" id="iSnap">
                        <i class="fas fa-camera"></i> @RsBase.TIRARFOTO
                    </button>
                    <button type="button" class="btn btn-danger btn-block" id="iCancelarFoto" style="margin-top: auto; display: none">
                        <i class="fas fa-times"></i> @RsBase.CANCELAR
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

}