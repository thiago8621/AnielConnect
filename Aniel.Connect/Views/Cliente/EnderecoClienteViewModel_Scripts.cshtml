    async function carregarCidades(tipoEndereco, id_cidade_inicial) {
        var ufSelecionada = $("#iUF" + tipoEndereco).val();

        if (!ufSelecionada) return;

        var enderecoApiCidade = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + ufSelecionada;

        try {
            const data = await $.getJSON(enderecoApiCidade);
            const $selectCidade = $('#iCidade' + tipoEndereco);

            $selectCidade.empty();
            $selectCidade.append($('<option></option>').val("").text('@RsBase.SELECIONE'));

            if (data) {
                data.sort((a, b) => a.descricao.localeCompare(b.descricao));
                $.each(data, function (key, value) {
                    $selectCidade.append($('<option></option>').val(value.id).text(value.descricao));
                });
            }

            if (id_cidade_inicial) {
                $selectCidade.val(id_cidade_inicial).trigger('change');
            } else {
                var tipoEnderecoTmp = "@Model.Tipo";
                var cidadeTmp = @Html.Raw(Json.Encode(Model.Cidade));

                $(`#iCidade${tipoEnderecoTmp} option:selected`).text(cidadeTmp);
                $(`#iDesc_Cidade${tipoEnderecoTmp}`).text(cidadeTmp).val(cidadeTmp);
            }

        } catch (error) {
            console.error("Erro ao carregar cidades:", error);
        }
    }

