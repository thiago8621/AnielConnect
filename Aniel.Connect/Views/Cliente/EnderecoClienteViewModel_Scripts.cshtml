                    .trigger('change.select2');

                $selectCodLocalidade.empty()
                    .append('<option value="">Selecione a Area primeiro</option>')
                    .prop('disabled', true)
                    .trigger('change.select2');

                return;
            }

            $selectCodArea.empty().append('<option value="">Carregando...</option>').prop('disabled', true).trigger('change.select2');
            try {
                var enderecoApi = "@CONSTANTES.URLPortal/api/Areaapi/GetList?grupo_area=" + cod_grupo;
                const retorno = await $.ajax({
                    url: enderecoApi,
                    type: 'GET',
                    dataType: 'json'
                });

                $selectCodArea.empty().append('<option value="">Selecione a Área</option>');

                if (retorno && retorno.objeto && retorno.objeto.length > 0) {
                    retorno.objeto.forEach(item => {
                        $selectCodArea.append(new Option(item.label, item.value));
                    });

                    $selectCodArea.prop('disabled', false).removeClass('readonly');

                    if (valorParaSetarArea) {
                        $selectCodArea.val(valorParaSetarArea).trigger('change', [valorParaSetarLocalidade]);
                    } else {
                        $selectCodLocalidade.empty()
                            .append('<option value="">Selecione a Area primeiro</option>')
                            .prop('disabled', true)
                            .trigger('change');
                    }
                } else {
                    $selectCodArea.append('<option value="">Nenhuma área encontrada</option>');
                }

            } catch (error) {
                console.error("Erro ao carregar áreas:", error);
                $selectCodArea.empty().append('<option value="">Erro ao carregar</option>');
            } finally {
                $selectCodArea.trigger('change.select2');
            }
