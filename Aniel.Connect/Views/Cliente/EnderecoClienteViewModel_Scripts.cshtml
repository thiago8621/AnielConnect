<script>

    async function initMap() {

        if (@Json.Encode(ViewBag.Ofertar_Plano_Produto_Cobertura != null && ViewBag.Ofertar_Plano_Produto_Cobertura)) {
            if (`@Model.Tipo` !== `Principal`) {
                if (!(document.getElementById('iEndereco_Instalacao').checked)) { /*registro 3*/
                    var matrizLat = Number($("#iLatitudeInstalacao").val().replace(",", "."));
                    var matrizLng = Number($("#iLongitudeInstalacao").val().replace(",", "."));
                } else if (document.getElementById('iEndereco_InstalacaoProspecto').checked) {

                    var matrizLat = Number($("#iLatitudeProspecto").val().replace(",", "."));
                    var matrizLng = Number($("#iLongitudeProspecto").val().replace(",", "."));
                    console.log(matrizLat);
                }
                else {
                    var matrizLat = Number($("#iLatitudePrincipal").val().replace(",", "."));
                    var matrizLng = Number($("#iLongitudePrincipal").val().replace(",", "."));
                }
            } else {
                var matrizLat = Number($("#iLatitudeProspecto").val().replace(",", "."));
                var matrizLng = Number($("#iLongitudeProspecto").val().replace(",", "."));
            };

            if (!((matrizLat == 0 || matrizLng == 0))) {

                var LatlngList = [];
                Id_AreacoberturaPlano = [];
                poligonosbanco = [];

                $.ajax({
                    type: "GET",
                    url: '@String.Concat(CONSTANTES.URLPortal, "/api/Mapa_Analise_ComercialApi/GetComboPoligonosMongo")',
                    data: { Latitude: matrizLat, Longitude: matrizLng },
                    dataType: "json",
                    async: false
                }).done(function (data) {
                    //Lendo de retangulos no mongo
                    console.log(data);

                    for (data of data.objeto) {
                        var Id_AreacoberturaDataPlano = data.id;
                        data.coordenadas.forEach(function (retangulo) {
                            LatlngList.push(retangulo);
                            var latlng = [];

                            for (var i = 0; i < retangulo.length; i++) {
                                var lat = retangulo[i];
                                i++;
                                var lng = retangulo[i];

                                latlng.push(new google.maps.LatLng(lat, lng));
                            }

                            polygon = new google.maps.Polygon({
                                strokeColor: data.cor,
                                strokeOpacity: 0.8,
                                strokeWeight: 2,
                                fillColor: data.cor,
                                /*posicao: LatlngList.findIndex(i => i === retangulo),*/
                                fillOpacity: 0.35,
                                editable: false,
                                paths: latlng,
                            });



                            console.log(latlng);
                            var point = new google.maps.LatLng(matrizLat, matrizLng);

                            if (google.maps.geometry.poly.containsLocation(point, polygon) == true) {


                                Id_AreacoberturaPlano.push(Id_AreacoberturaDataPlano);
                                console.log(Id_AreacoberturaPlano, "...........");
                                pathlatlng = [];
                                for (var a = 0; a < polygon.getPath().length; a++) {


                                    pathlatlng.push(polygon.getPath().getAt(a).lat(), polygon.getPath().getAt(a).lng());
                                }
                                //pathlatlng = poligonos
                                //trazer cor,id
                                poligonosbanco.push(pathlatlng, polygon.strokeColor, Id_AreacoberturaDataPlano);


                            } else { console.log("no") }

                        });
                    }
                });
            }

        }

    }

    var cep_on_focus_@Model.Tipo;
    var EnderecoLogradouroSelecionado = null;

    window["idCondominioPredio" + "@Model.Tipo"] =  Number("@Model.Id_Condominio_Predio") || 0;
    window["blocoSelecionado" + "@Model.Tipo"] = Number("@Model.Id_Bloco") || 0;


    $(document).off("change", "#iBuscaEndereco" + "@Model.Tipo").on("change", "#iBuscaEndereco" + "@Model.Tipo", function () {
        let $abaAtual = $(this).closest('.tab-pane, .container-fluid, body');

        let endereco = Number($(this).val());
        let name = `Endereco ${"@Model.Tipo"}`;

        switch (endereco) {
            default:
                $abaAtual.find(`[name="${name} .divEnderecoVazio"]`).hide();
                $abaAtual.find(`[name="${name} .divEnderecoLogradouro"]`).hide();
                $abaAtual.find(`[name="${name} .divCondominioPredio"]`).hide();
                $abaAtual.find('.BlocoApartamento').hide();
                $abaAtual.find(`[name="${name} .divBlocoApVazio"]`).hide();

                // CORREÇÃO DOS TÍTULOS
                $abaAtual.find("#txtEnderecoLogradouro").html("Digite o Endereço:");
                $abaAtual.find("#txtCondominioPredio").html("@RsBase.SELECIONE:");
                break;

            case 1:
                $abaAtual.find(`[name="${name} .divEnderecoLogradouro"]`).show();
                $abaAtual.find("#txtEnderecoLogradouro").html("Digite o Endereço:");

                $abaAtual.find(`#iCondominioPredio`).hide();
                $abaAtual.find(`[name="${name} .divEnderecoLogradouro"]`).show();
                $abaAtual.find(`[name="${name} .divCondominioPredio"]`).hide();
                $abaAtual.find('.BlocoApartamento').hide();
                $abaAtual.find(`[name="${name} .divEnderecoVazio"]`).show();
                $abaAtual.find(`[name="${name} .divBlocoApVazio"]`).hide();

                $abaAtual.find("#iId_Condominio_Predio" + "@Model.Tipo").val(null).trigger('change');
                $abaAtual.find("#txtCondominioPredio").html("@RsBase.SELECIONE:");
                break;

            case 2:
                $abaAtual.find(`[name="${name} .divCondominioPredio"]`).show();
                $abaAtual.find("#txtCondominioPredio").html("Selecione o Condomínio:");

                $abaAtual.find(`#iCondominioPredio`).show();
                $abaAtual.find(`[name="${name} .divEnderecoLogradouro"]`).hide();
                $abaAtual.find(`[name="${name} .divCondominioPredio"]`).show();
                $abaAtual.find(`[name="${name} .divEnderecoVazio"]`).show();
                $abaAtual.find(`[name="${name} .divBlocoApVazio"]`).show();
                $abaAtual.find('.BlocoApartamento').show();

                $abaAtual.find("#iId_Endereco_Logradouro" + "@Model.Tipo").val(null).trigger('change');
                $abaAtual.find("#txtEnderecoLogradouro").html("Digite o Endereço:");
                break;
        }
    });

    $("#iBuscaEndereco" + "@Model.Tipo").trigger('change');

    async function selecionarEnderecoEncontrado(cep) {
        let $ctx = $(".modal.show").last();

        if ($ctx.length === 0) {
            $ctx = $(".tab-pane.active:visible, .bloco-contexto-endereco:visible").last();
        }

        if ($ctx.length === 0) $ctx = $("body");
        await consultaCEP_VIACEP(cep, false,  "@Model.Tipo");

        $ctx.find("#containerManual").addClass("d-none");

        $ctx.find("#selectUF").val("").trigger("change");

        $ctx.find("#selectCidade")
            .empty()
            .append('<option value="">Selecione a UF primeiro</option>')
            .prop("disabled", true)
            .trigger("change");

        $ctx.find("#containerResultados").addClass("d-none");

        $ctx.find("#resultBox").show();
    }

    function consultaENDERECO_VIACEP(logradouroParam, abrirModal) {
        let $ctx = $(".modal.show").last();
        if ($ctx.length === 0) {
            $ctx = $(".bloco-contexto-endereco:visible, .tab-pane.active").last();
        }
        if ($ctx.length === 0) $ctx = $("body");

        if (abrirModal) {
            let $modal = $ctx.find("#addressModal");
            $modal.modal("show");
            $ctx = $modal;
        }

        const uf = $ctx.find("#selectUF").val();
        const cidade = $ctx.find("#selectCidade").val();
        var logradouro = $ctx.find("#cepInput").val();

        logradouro = logradouro != "" ? logradouro : logradouroParam;
        $ctx.find("#cepInput").val(logradouro);

        if (!uf || !cidade || logradouro.length < 3) {
            Notificar("@RsBase.ATENCAO_", "Preencha UF, Cidade e Logradouro.", "warning");
            $ctx.find("#containerManual").removeClass("d-none");
            $ctx.find("#txtCEP").html("Endereço/Logradouro:");
            return;
        }

        const url = `https://viacep.com.br/ws/${uf}/${encodeURIComponent(cidade)}/${encodeURIComponent(logradouro)}/json/`;

        $.getJSON(url, function (data) {
            let htmlCards = "";
            if (Array.isArray(data) && data.length > 0) {
                data.forEach(item => {
                    htmlCards += `
                    <div class="list-group-item list-group-item-action border rounded p-3 mb-2"
                         style="cursor: pointer;"
                         onclick="selecionarEnderecoEncontrado('${item.cep.replace('-', '')}')">
                        <h6 class="mb-1">
                            <strong class="fw-bold">${item.logradouro}</strong>
                        </h6>
                        <p class="mb-0 small">${item.bairro}, ${item.localidade} - ${item.uf} | CEP: ${item.cep}</p>
                    </div>`;
                });
                $ctx.find("#listaEnderecos").html(htmlCards);
                $ctx.find("#containerResultados").removeClass("d-none");
                $ctx.find("#resultBox").hide();
            } else {
                Notificar("@RsBase.ATENCAO_", "Nenhum endereço encontrado.", "warning");
            }
        });
    }

    var obj_endereco = {};
    async function consultaCEP_VIACEP(cep, abrirModal,tipo) {
        let $ctx = $(".modal.show, .tab-pane.active, .bloco-contexto-endereco:visible").last();
        if ($ctx.length === 0) $ctx = $("body");

        if (abrirModal) {
            let $modal = $ctx.find("#addressModal");
            $modal.modal("show");
            $ctx = $modal;
        }

        const url = `https://viacep.com.br/ws/${cep}/json/`;

        try {
            const data = await $.getJSON(url);
            $ctx.find("#cepInput").val(cep);
            if (data?.erro == "true" || !data.logradouro || !data.bairro) {
                exibirErroCepNaoEncontrado($ctx);
                return;
            }

            obj_endereco = data;
            let htmlSucesso = `
                <p class="result-title">Endereço encontrado:</p>
                <p><strong>Logradouro:</strong> <span>${data.logradouro}</span></p>
                <p><strong>Bairro:</strong> <span>${data.bairro}</span></p>
                <p><strong>Cidade/UF:</strong> <span>${data.localidade} - ${data.uf}</span></p>
                <p><strong>CEP:</strong> <span>${data.cep}</span></p>`;

            $ctx.find("#resultBox").html(htmlSucesso).removeClass("result-error").addClass("result-success").show();
            $ctx.find("#containerManual").addClass("d-none");
            $ctx.find("#txtCEP").html("CEP:");
            $ctx.find("#btnBuscarEndereco_"+ tipo +",#btnCancelarEndereco, #btnCadastrarEndereco").addClass("d-none");
            $ctx.find("#btnNovaBuscaEndereco, #btnConfirmarBuscaEndereco_" + tipo).removeClass("d-none");

        } catch (error) {
            exibirErroCepNaoEncontrado($ctx);
        }
    }

    function exibirErroCepNaoEncontrado($ctx) {
        if (!$ctx || $ctx.length === 0) {
            $ctx = $(".modal.show, .tab-pane.active, .bloco-contexto-endereco:visible").last();
        }
        if ($ctx.length === 0) $ctx = $("body");

        const resultBox = $ctx.find("#resultBox");

        let htmlErro = `
    <div class="error-container d-flex justify-content-between align-items-center w-100">
        <span>CEP não encontrado</span>
        <div class="info-icon-wrapper">
            <i class="fas fa-info-circle info-icon"></i>
            <div class="custom-tooltip">
                <i class="fas fa-info-circle me-1"></i>
                Caso o CEP seja genérico/único, entre em contato com o administrador do sistema.
            </div>
        </div>
    </div>`;

        resultBox.html(htmlErro)
            .removeClass("result-success")
            .addClass("result-error")
            .show();

