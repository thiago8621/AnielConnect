@model Aniel.Connect.Repository.Model.EnderecoClienteViewModel
@using Aniel.Connect.Models
@using Aniel.Connect.Model.enumerado
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNet.Identity;

@{
    var listaEnum = Enum.GetValues(typeof(Tipo_Endereco_Logradouro))
        .Cast<Tipo_Endereco_Logradouro>()
        .Select(e =>
        {
            var field = e.GetType().GetField(e.ToString());
            var display = (DisplayAttribute)Attribute.GetCustomAttribute(field, typeof(DisplayAttribute));
            return new
            {
                id = (int)e,
                nome = display != null ? display.Name : e.ToString()
            };
        }).ToList();

    var jsonEnum = Newtonsoft.Json.JsonConvert.SerializeObject(listaEnum);
}

