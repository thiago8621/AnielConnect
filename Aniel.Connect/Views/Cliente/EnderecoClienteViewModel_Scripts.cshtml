            $("#iTipo" + tipoEndereco).prop(classBlock, false);
            $("#iCondominioPredio" + tipoEndereco).prop(classBlock, false);
            $("#iTipo_Imovel" + tipoEndereco).prop(classBlock, false);
            $("#iNumero" + tipoEndereco).prop(classBlock, false);
        });

