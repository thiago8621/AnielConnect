            let hasCadastroEndereco = !!$("#iBuscaEndereco" +  "@Model.Tipo").val();

            let cidade = hasCadastroEndereco ? $("#iCidadeText" + "@Model.Tipo").html() : $("#iCidade" + "@Model.Tipo option:selected").text();
            let bairro = hasCadastroEndereco ? $("#iBairroText" + "@Model.Tipo").html() : $("#iBairro" + "@Model.Tipo").val();

            if (cidade && bairro) {
                await GetGrupoAreabyEndereco(bairro, cidade, "@Model.Tipo");
            }
        }
    });

    $('#iUF' + "@Model.Tipo").change(function () {
        var tipoEndereco = "@Model.Tipo";
        var estado = $('#iUF' + tipoEndereco + ' option:selected').text();
        var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

        $('#iCidade' + tipoEndereco).empty();
        $('#iBairro' + tipoEndereco).empty();

        $.getJSON(enderecoApi, function (data) {
            $('#iCidade' + tipoEndereco).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
            $.each(data, function (key, value) {
                $('#iCidade' + tipoEndereco).append($('<option></option>').attr('value', value.id).text(value.descricao));
            })
        });
    });



    $('#iCidade' + "@Model.Tipo").change(function () {

        var tipoEndereco = "@Model.Tipo";
        var cidade = $('#iCidade' + tipoEndereco + ' option:selected').val();
        var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/GetBairros?Id_Cidade=" + cidade;

        $('#iDesc_Cidade' + tipoEndereco).val($('#iCidade' + tipoEndereco + ' option:selected').text());


        //$("#iBairro" + tipoEndereco).val("");
        $("#iBairro" + tipoEndereco).empty();

        $.getJSON(enderecoApi, function (data) {
            $('#iBairro' + tipoEndereco).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
            $.each(data, function (key, value) {
                $('#iBairro' + tipoEndereco).append($('<option></option>').attr('value', value.id).text(value.descricao));
            })
        });

    });

    $('#iBairro' + "@Model.Tipo").change(function () {
            var tipoEndereco = "@Model.Tipo";

        $('#iDesc_Bairro' + tipoEndereco).val($('#iBairro' + tipoEndereco + ' option:selected').text());
        });


    $("#iCEP" + "@Model.Tipo").focus(function(){
        window["cep_on_focus_@Model.Tipo"] = cep_on_focus = $("#iCEP" + "@Model.Tipo").val();
    });


    $("#iCEP" + "@Model.Tipo").focusout(function () {
            if ($("#iCEP" + "@Model.Tipo").val() != window["cep_on_focus_@Model.Tipo"]) {
                $('#iReferencia' + "@Model.Tipo").val("");
                $('#iUF' + "@Model.Tipo").val("");
                $('#iCidade' + "@Model.Tipo").val("");
                $('#iBairro' + "@Model.Tipo").val("");
                //$('#iTipo_Imovel' + "@Model.Tipo").val("");
                //$('#iPais' + "@Model.Tipo").val("");
                $('#iComplemento' + "@Model.Tipo").val("");
                $('#iBairro' + "@Model.Tipo").val("");
                $('#iLatitude' + "@Model.Tipo").val("");
                $('#iLongitude' + "@Model.Tipo").val("");
                $('#iNumero' + "@Model.Tipo").val("");
                $('#iLogradouro' + "@Model.Tipo").val("");
                $('#iLongitude' + "@Model.Tipo").val("");
                $('#iLongitude' + "@Model.Tipo").val("");
            }


            var tipoEndereco = "@Model.Tipo";
            var cepcliente = $("#iCEP" + "@Model.Tipo").val();

            var link = "https://viacep.com.br/ws/";
            link = link.concat(cepcliente);
            link = link.concat("/json/");

            try {
                parent.App.startPageLoading();
            }
            catch (ex) { console.log(ex); }

        $.ajax({
            url: link,
            type: 'GET',
            dataType: 'json'

        })
            .done(async function (data) {
                $("#iLogradouro" + tipoEndereco).val(data.logradouro);
                $("#iUF" + tipoEndereco).val(data.uf);
                let cidade = data.localidade;
                let bairro = data.bairro.toUpperCase();

                let estado = $('#iUF' + tipoEndereco + ' option:selected').text();
                let enderecoApiCidade = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;
                let enderecoApiBairro = "@CONSTANTES.URLPortal/api/enderecoapi/GetBairrosViaCep?Bairro=" + bairro;

                if (!$("#iUFPrincipal option:selected").val() == "") {
                    $('#iPais' + tipoEndereco).val(1);
                }

                $('#iCidade' + tipoEndereco).empty();
                $('#iBairro' + tipoEndereco).empty();
                $('#iBairro' + tipoEndereco).val(bairro);

                if ($('#iCidade' + tipoEndereco).empty()) {
                    $('iPais' + tipoEndereco).empty();
                }

                await getCidades(enderecoApiCidade, tipoEndereco, cidade);
                await getBairros(enderecoApiBairro, tipoEndereco, bairro);

                if (!$(`#iCidade${tipoEndereco}`).val()) {
                    $(`#iCidade${tipoEndereco} option:selected`).text(cidade);

                    $(`#iCidadeTextModel${tipoEndereco}`).text(cidade);
                    $(`#iCidadeTextModel${tipoEndereco}`).val(cidade);

                    $(`#iDesc_Cidade${tipoEndereco}`).text(cidade);
                    $(`#iDesc_Cidade${tipoEndereco}`).val(cidade);
                }

                jQuery(':input').keyup(function(){
                  $(this).val($(this).val().toUpperCase());
                });

                $("#iNumero" + "@Model.Tipo").focus();
            })
            .fail(function () {
                console.log("error");
            })
            .always(function () {
                try {
                    parent.App.stopPageLoading();
                }
                catch (ex) { console.log(ex); }

            });



    });

    async function getCidades(enderecoApiCidade, tipoEndereco, cidade = "") {

        await $.getJSON(enderecoApiCidade, function (data) {
            $('#iCidade' + tipoEndereco).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
            $.each(data, function (key, value) {
                $('#iCidade' + tipoEndereco).append($('<option></option>').attr('value', value.id).text(value.descricao));
            });
            if (cidade) {
                $('#iCidade' + tipoEndereco).val($('#iCidade' + tipoEndereco +' > option:contains("' + cidade.toUpperCase() + '")').val());
            }
        });
    }
    async function getBairros(enderecoApiBairro, tipoEndereco, bairro = "") {

        await $.getJSON(enderecoApiBairro, function (data) {
            $('#iBairro' + tipoEndereco).empty();
            $('#iBairro' + tipoEndereco).append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
            $.each(data, function (key, value) {
                $('#iBairro' + tipoEndereco).append($('<option></option>').attr('value', value.id).text(value.descricao));
            });
            if (bairro) {
                $("#iBairro" + tipoEndereco + " option:contains('" + bairro + "')").attr("selected", true);
            }
            $('#iDesc_Cidade' + tipoEndereco).val($('#iCidade' + tipoEndereco + ' option:selected').text());
            $('#iDesc_Bairro' + tipoEndereco).val($('#iBairro' + tipoEndereco + ' option:selected').text());
        });
    }

    async function GetGrupoAreabyEndereco(bairro, cidade, tipoEndereco) {
        let request = { DescricaoBairro: bairro, DescricaoCidade: cidade };
        let link = '@String.Concat(CONSTANTES.URLPortal, "/api/GrupoAreaapi/GetGrupoAreaLocalidadeByBairro")';

        await $.ajax({
            url: link,
            type: "POST",
            dataType: "json",
            data: request,
        })
            .done(async function (data) {
                if (data.ok) {

                    let grupo_area = data.objeto.idGrupoArea;
                    let area = data.objeto.idArea;
                    let localidade = data.objeto.idLocalidade;

                    $("#iGrupoArea" + tipoEndereco).val(grupo_area);

                    $('#iArea' + tipoEndereco).empty();
                    $('#iLocalidade' + tipoEndereco).empty();

                     let enderecoApi = "@CONSTANTES.URLPortal/api/Areaapi/GetList?grupo_area=" + grupo_area;

                    await $.ajax({
                        url: enderecoApi,
                        type: 'GET',
                        dataType: 'json'
                    })
                        .done(async function (data) {
                            $('#iArea' + tipoEndereco).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));

                            $.each(data.objeto, function (key, value) {
                                $('#iArea' + tipoEndereco).append($('<option></option>').attr('value', value.value).text(value.label));
                            });

                            $("#iArea" + tipoEndereco).removeClass("readonly");
                            $("#iArea" + tipoEndereco).val(area);

                            let localidadeApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

                            await $.ajax({
                                url: localidadeApi,
                                type: "GET",
                                dataType: "json"
                            })
                                .done(function (data) {
                                $('#iLocalidade' + tipoEndereco).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));


                                $.each(data.objeto, function (key, value) {
                                    $('#iLocalidade' + tipoEndereco).append($('<option></option>').attr('value', value.value).text(value.label));

                                });

                                    $("#iLocalidade" + tipoEndereco).removeClass("readonly");
                                    $("#iLocalidade" + tipoEndereco).val(localidade);
                            });
                        });
                }
            });
    }

    function ExibeMapa(tipoEndereco) {

        if (($("#iLogradouro" + tipoEndereco).val() == "" || $("#iCEP" + tipoEndereco).val() == "") &&
            ($("#iLogradouro" + tipoEndereco).html() == "" || $("#iCEP" + tipoEndereco).html() == "")) {


                Notificar("@RsBase.ATENCAO_", " Campos CEP e Logradouro são obrigatórios. Por Favor Preencher!", "warning");
                return false;
            }

            var endereco = GetEndereco(tipoEndereco);


            ShowDialog(true, true, 'Mapa', '@Url.Action("Endereco", "Mapa")' + '?Endereco=' + endereco, 'mapa', 800, 500, 'iframeMapa' + tipoEndereco);
            return false;
    }

