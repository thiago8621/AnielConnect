        $(document).off("click", "#btnConfirmarBuscaEndereco_@(Model.Tipo)").on("click", "#btnConfirmarBuscaEndereco_@(Model.Tipo)", async function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            let contextoOrigem_tipoEndereco = $("#addressModal").data("contexto-origem");
            let $ctx = $(this).closest('.modal-content');
            const tiposLogradouro = @Html.Raw(jsonEnum);

            const tipoEncontrado = tiposLogradouro.find(t =>
                obj_endereco.logradouro.toLowerCase().includes(t.nome.toLowerCase())
            ) || { id: 0, nome: "" };

            if (!obj_endereco.logradouro || !obj_endereco.bairro) {
                Notificar("@RsBase.ATENCAO_", "Você será redirecionado para o cadastro de endereço, pois, o CEP informado é genérico.", "warning");
                AddAba("@(Url.Action("Cadastro", "Endereco_Logradouro"))");
                return;
            }

            try {
                const $optionSelecionada = $ctx.find("#selectCidade option:selected");
                let idCidade = $optionSelecionada.attr("id_cidade");
                let id_uf = $optionSelecionada.attr("id_uf");

                if (!idCidade || !id_uf) {
                    const retornoCidadeAPI = await $.ajax({
                        url: "@CONSTANTES.URLPortal/api/Cidadeapi/ConsultaCidadePorIBGE",
                        type: "GET",
                        data: { Codigo_IBGE: obj_endereco.ibge }
                    });
                    id_uf = retornoCidadeAPI.id_UF;
                    idCidade = retornoCidadeAPI.id;
                }

                var mArea = {
                    UF: obj_endereco.uf,
                    Descricao: (obj_endereco.localidade || "").toUpperCase().trim(),
                    Bairro: (obj_endereco.bairro || "").toUpperCase().trim()
                };

                if (!$ctx.find("#selectCOD_GRUPO_MODAL_ADDRESS_@Model.Tipo").val() ||
                    !$ctx.find("#selectCOD_AREA_MODAL_ADDRESS_@Model.Tipo").val() ||
                    !$ctx.find("#selectCOD_LOCALIDADE_MODAL_ADDRESS_@Model.Tipo").val()) {
                    const retornoAPIArea = await $.ajax({
                        url: "@CONSTANTES.URLPortal/api/Areaapi/ConsultaAreaPorDescricao_Uf",
                        type: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(mArea)
                    });

                    const listaGrupos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.GruposArea ?? new List<object>()));
                    const $selectGrupo = $ctx.find("#selectCOD_GRUPO_MODAL_ADDRESS_@Model.Tipo");

                    $selectGrupo.val(null).empty();
                    $selectGrupo.append(new Option("Selecione o Grupo", "", true, true));

                    if (listaGrupos && listaGrupos.length > 0) {
                        $.each(listaGrupos, function (i, item) {
                            if (item.Value || item.Label) {
                                $selectGrupo.append(new Option(item.Label, item.Value));
                            }
                        });
                    }

                    $selectGrupo.trigger('change.select2');

                    if (!retornoAPIArea.ok || !retornoAPIArea.objeto || !retornoAPIArea.objeto.grupo_Area) {

                        if (!$ctx.find("#containerDadosAdicionais").hasClass("d-none")) {
                            Notificar("@RsBase.ATENCAO_", "Preencha os campos obrigatórios: Grupo Área, Área e Localidade.", "warning");
                        }

                        $ctx.find("#containerDadosAdicionais").removeClass("d-none");
                        return;
                    }

                    const obj = retornoAPIArea.objeto;
                    $selectGrupo.val(obj.grupo_Area);
                    $selectGrupo.trigger('change', [obj.area, obj.cod_Localidade]);

                    if (!obj.area || !obj.cod_Localidade) {
                        $ctx.find("#containerDadosAdicionais").removeClass("d-none");
                        return;
                    }
                    $ctx.find("#containerDadosAdicionais").addClass("d-none");
                }

                try {
                    ShowPageLoading($('#addressModal'));
                    var mBairro = {
                        Descricao: (obj_endereco.bairro || "").toUpperCase().trim(),
                        Status: 1,
                        UF: parseInt(id_uf),
                        Pais: 1,
                        Cidade: parseInt(idCidade),
                        ViaCep: true
                    };

                    const retornoBairro = await $.ajax({
                        url: "@CONSTANTES.URLPortal/api/Bairroapi/Gravar",
                        type: "POST",
                        contentType: "application/json",
                        data: JSON.stringify({ Objeto: mBairro }),
                        beforeSend: function () {
                            $("#divProgress").show();
                            $('#btnConfirmarBuscaEndereco').prop('disabled', true);
                        }
                    });

                    const model = {
                        Cep: obj_endereco.cep,
                        Descricao: obj_endereco.logradouro,
                        Status: true,
                        UF: id_uf,
                        Pais: 1,
                        Cidade: idCidade,
                        Bairro: retornoBairro.idObjeto,
                        Tipo_Endereco_Logradouro: tipoEncontrado.id,
                        Tipo_Zona: 0,
                        Cod_Area: $ctx.find("#selectCOD_AREA_MODAL_ADDRESS_@Model.Tipo").val(),
                        Cod_Escritorio: $ctx.find("#selectCOD_GRUPO_MODAL_ADDRESS_@Model.Tipo").val(),
                        Cod_Localidade: $ctx.find("#selectCOD_LOCALIDADE_MODAL_ADDRESS_@Model.Tipo").val(),
                        ViaCep: true
                    };

                    const retornoAPI_Endereco = await $.ajax({
                        url: "@CONSTANTES.URLPortal/api/EnderecoLogradouroapi/Gravar",
                        type: "post",
                        contentType: "application/json",
                        data: JSON.stringify({ Objeto: model, Usuario: "@User.Identity.GetUserId()" })
                    });
                    tipoEndereco = contextoOrigem_tipoEndereco;
                    $("#iCidadeText" + contextoOrigem_tipoEndereco).html(obj_endereco.localidade);
                    $("#iCidadeTextModel" + contextoOrigem_tipoEndereco).val(obj_endereco.localidade);
                    $("#iBairroText" + contextoOrigem_tipoEndereco).html(obj_endereco.bairro);
                    $("#iUFText" + contextoOrigem_tipoEndereco).html(obj_endereco.uf);
                    $("#iCEPText" + contextoOrigem_tipoEndereco).html(obj_endereco.cep);
                    $("#iLogradouroText" + contextoOrigem_tipoEndereco).html(obj_endereco.logradouro);
                    $("#iTipo" + contextoOrigem_tipoEndereco).html(tipoEncontrado.nome);
                    $("#iPaisText" + contextoOrigem_tipoEndereco).html("Brasil");

                    $("#iCidade" + contextoOrigem_tipoEndereco).val(idCidade);
                    $("#iCEP" + contextoOrigem_tipoEndereco).val(obj_endereco.cep);
                    $("#iLogradouro" + contextoOrigem_tipoEndereco).val(obj_endereco.logradouro);
                    $("#iBairro" + contextoOrigem_tipoEndereco).val(obj_endereco.bairro);
                    $("#iUF" + contextoOrigem_tipoEndereco).val(obj_endereco.uf);
                    $("#iPais" + contextoOrigem_tipoEndereco).val(1);
                    $("#iTipo" + contextoOrigem_tipoEndereco).val(tipoEncontrado.id);
                    $("#iGrupoArea" + contextoOrigem_tipoEndereco).val($("#selectCOD_GRUPO_MODAL_ADDRESS_@Model.Tipo").val());
                    await handleChangeGrupoArea();

                    $("#iArea" + contextoOrigem_tipoEndereco).val($("#selectCOD_AREA_MODAL_ADDRESS_@Model.Tipo").val());
                    await handleChangeArea();

                    $("#iLocalidade" + contextoOrigem_tipoEndereco).val($("#selectCOD_LOCALIDADE_MODAL_ADDRESS_@Model.Tipo").val());
                    $("#iLocalidade" + contextoOrigem_tipoEndereco).trigger("change");

                    var id = retornoAPI_Endereco.idObjeto;
                    var texto = tipoEncontrado.nome + ',' + obj_endereco.bairro + ',' + obj_endereco.localidade + ',' + obj_endereco.uf + ', Brasil';
                    var $select = $("#iId_Endereco_Logradouro" + contextoOrigem_tipoEndereco);

                    if ($select.find("option[value='" + id + "']").length === 0) {
                        var newOption = new Option(texto, id, true, true);
                        $select.append(newOption).trigger('change');
                    } else {
                        $select.val(id).trigger('change');
                    }

                    $ctx.closest(".modal").modal("hide");
                    $('#btnConfirmarBuscaEndereco').prop('disabled', false);
                    $("#divProgress").hide();
                }
                catch (error) {
                    console.error("Erro ao processar endereço:", error);
                }
                finally
                {
                    HidePageLoading();
                }

            } catch (error) {
                console.error("Erro ao processar endereço:", error);
            }
        });

        $(document).off("change", "#selectCOD_GRUPO_MODAL_ADDRESS_@Model.Tipo").on("change", "#selectCOD_GRUPO_MODAL_ADDRESS_@Model.Tipo", async function (e, valorParaSetarArea, valorParaSetarLocalidade) {
            const $comboGrupo = $(this);
            const cod_grupo = $comboGrupo.val();

            let $container = $(this).closest('.modal-content, .tab-pane, body');
            const $selectCodArea = $container.find("#selectCOD_AREA_MODAL_ADDRESS_@Model.Tipo");
            const $selectCodLocalidade = $container.find("#selectCOD_LOCALIDADE_MODAL_ADDRESS_@Model.Tipo");

            if (!cod_grupo) {
                $selectCodArea.empty()
                    .append('<option value="">Selecione o Grupo primeiro</option>')
