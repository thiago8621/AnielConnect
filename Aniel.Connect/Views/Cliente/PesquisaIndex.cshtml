@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers

@{
    ViewBag.Title = RsCadastros.PESQUISA_RESPOSTA;
    ViewBag.Sessao = RsCadastros.PESQUISA_SATISFACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion,"~/Content/cssDataTable")

}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion,"~/bundles/jsDataTable")

<script>

    var rows_selected = [];
    function ExibirRespostas(idPesquisaResposta) {

        var url = '@Url.Action("VisualizarRespostas", "Pesquisa_Satisfacao")?Id_Pesquisa_Resposta=' + idPesquisaResposta;
        parent.location = url
    }

    var handleDataTableButtons = function () {
        "use strict";

        function AlterarStatusObj(Status) {
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/pesquisa_Satisfacaoapi/alterarstatus")';

            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    ids: rows_selected,
                    status: Status
                }
            })
            .done(function (data) {

                    if (data.ok) {
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                        rows_selected = [];
                        oDatatable.draw();
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                });

            rows_selected = [];
        }

        //"Blfrtip"
        var oDatatable = $("#datatable").length && $("#datatable").DataTable({
            dom: "Bfrti",
            select: {
                style: 'multi'
            },
            order: [[1, 'asc']],
            serverSide: true,
            searching: true,
            ordering: true,
            paging: true,
            deferRender: true,
            scrollY: '73vh',
            scroller: {
                loadingIndicator: true,
                rowHeight: 40,
                boundaryScale: 0.5,
                displayBuffer: 3
            },
            stateSave: true,
            scrollX: true,
            fixedHeader: true,
            initComplete: dataTableInitComplete,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
            ajax: {
                url: baseUrl + '/api/pesquisa_Satisfacaoapi/BuscaPorCliente',
                type: 'POST',
                data: function (data) {
                    data.Id_Cliente = @ViewBag.Id_Cliente;
                },
                error: function (e) {
                    console.log(e);
                },
                dataSrc: function (d) {
                    return d.data;
                }
            },
            infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                var str = "@RsCadastros.INFODATATABLE";
                if (iTotal == 0) { iEnd = 0; iStart = 0; }
                str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                $("#dtLegend").html(str);

                return "";
            },
            rowCallback: function(row, data, dataIndex){
                // Get row ID
                var rowId = data.id;

                // If row ID is in the list of selected row IDs
                if($.inArray(rowId, rows_selected) !== -1){
                $(row).find('input[type="checkbox"]').prop('checked', true);
                $(row).addClass('selected');
                }
            },
            pageLength: 10,
            language: traducaoDataTableSimples,
            buttons: buttonsDataTable,
            columns: [
                {
                    data: "id",
                    render: function (data, type, row, meta) {
                        return "<input type='hidden' id='Id_Pesquisa_Resposta__" + meta.row + "' value='" + row.id + "'>"
                    }
                },
                {
                    data: "titulo_Da_Pesquisa",
                    title: "@RsCadastros.TITULO_DA_PESQUISA"
                },
                {
                    data: "quem_Preenche",
                    title: "@RsCadastros.QUEM_PREENCHE",
                    orderable: false
                },
                {
                    data: "data_Hora_Criacao",
                    title: "@RsCadastros.DATAHORA_ENVIO",
                    orderable: false
                },
                {
                    data: "usuario_Criacao",
                    title: "@RsCadastros.USUARIO_ENVIO",
                    orderable: false
                },
                {
                    data: "data_Hora_Respondida",
                    title: "@RsCadastros.DATA_HORA_RESPOSTA",
                    orderable: false
                },
                {
                    title: "Visualizar Repostas",
                    orderable: false,
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            return '<div class="d-flex"><a href="#" class="align-horizontal" id="btnRespostas' + meta.row + '" onclick="ExibirRespostas(' + row.id + '); return false;">' +
                                       '<i class="fas fa-paste" style="font-size:16px;padding-right:2px;"></i>' + 
                                   '</a></div>';
                        }
                        return data;
                    }
                }
            ]
        });

        $('#txtSearch').val(oDatatable.search());
        $('#txtSearch').keyup(function () {
            rows_selected = [];
            oDatatable.search($(this).val()).draw();
        });


        $("#btnInativar").on("click", function () {

            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            //Alterando para Inativo
            AlterarStatusObj(0);

        });

        $("#btnAtivar").on("click", function () {

            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            //Alterando para Inativo
            AlterarStatusObj(1);
        });

    },
        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtons();
                }
            }
        }();

    TableManageButtons.init();

</script>
}


<div style="padding:10px;">

    <div class="accordion mb-3" id="accordion_7">
        <div class="card div-card-accord">

            <div class="card-header title-card" id="heading_7" data-parent="#accordion_7">
                <h5 class="mb-0">
                    <span class="text-bold-card">Pesquisa de Satisfação</span>
                </h5>
            </div>

            <table class="table table-hover nowrap" id="datatable" style="width:100%">
                <thead class="tb-head">

                </thead>
            </table>

        </div>
    </div>

</div>