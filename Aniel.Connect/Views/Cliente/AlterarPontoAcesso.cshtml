@model Aniel.Connect.Models.AlterarPontoAcesso

@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado

@{
    ViewBag.Title = "AlterarEndereco";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts{


    <script>
        AddSelect("iPoolIp", "@CONSTANTES.URLPortal/api/pool_Ipapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Pool_Ip", "@RsBase.SELECIONE", false);

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            let erro = false
            if (ValidaCamposObrigatorios(erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }


            if (erro) {
                clicked = false;
                return false;
            }

            clicked = true;
            ShowPageLoading();

            $('#form').submit();
            

            try {
                parent.dial.dialog('close');
            }
            catch (ex) {
                console.log(ex);
            }

            return true;
        }
    </script>
}

@using (Html.BeginForm("AlterarPontoAcesso", "Cliente", FormMethod.Post, htmlAttributes: new { @id = "form", @autocomplete = "off" }))
{
    @Html.HiddenFor(p => p.Id)

    <div class="row">
        <div class="col-sm-8 container" style="align-content:center;">
            <div class="form-group">
                <label for="iPoolIp">@RsCadastros.POOL_IP</label>
                @Html.DropDownListFor(model => model.Id_Pool_Ip,new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE,  new { @class = "form-control obrigatorio", @id = "iPoolIp" })
            </div>
        </div>
    </div>
}

<div class="form-group col-sm-12" style="padding: 25px;">
    <div class="text-center">
        <button type="button" onclick="parent.dial.dialog('close'); return false;" class="btn btn-danger" id="iCancelar" data-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-success" onclick="ValidaSubmit()" id="iSalvar">@RsBase.SALVAR</button>
    </div>
</div>