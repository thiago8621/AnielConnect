                //        title: 'Oops...',
                //        text: 'Ocorreu um erro. Necessário realizar a gravação novamente!',
                //    });
                //    $("#fileInputVio").val('');
                //    $("#fileInputContent").val('');
                //    nextPrev(-2);
                //}
            });
        }


        //Envio de Doc para API Content
        function enviarDocumentacaoMostQIExtractContent() {
            $("#divProgress").show();
            var fileInputVio = document.getElementById('fileInputContent');
            var file = fileInputVio.files[0];
            var type = file.type;
            var reader = new FileReader();

            reader.onloadend = function () {
                var base64String = reader.result.split(',')[1];
                $('#InputBase64Vio').val(base64String);
                $('#InputBase64Type').val(type);

                var url = (`@CONSTANTES.URLPortal/api/clienteapi/EnviarDocumentacaoMostQIExtractContent`);

                var formData = new FormData();
                formData = $('#form').serialize();

                $.ajax({
                    type: 'POST',
                    url: url,
                    data: formData,
                    contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                    success: function (response) {
                        $("#divProgress").hide();

                        if (response.result) {
                            nextPrev(1);
                        } else {
                            Swal.fire({
