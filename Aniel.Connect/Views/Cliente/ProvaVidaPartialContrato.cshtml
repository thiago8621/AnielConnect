@{
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script>

        $(document).ready(function () {

            function ajustarClasses() {
                var larguraTela = window.innerWidth;

                if (larguraTela < 758) {
                    var divBlocos = document.querySelectorAll('.blocoDiv');
                    divBlocos.forEach(function (divBloco) {
                        divBloco.classList.remove('divideTela');
                        divBloco.classList.add('telaInteira');
                    });
                } else {
                    var divBlocos = document.querySelectorAll('.blocoDiv');
                    divBlocos.forEach(function (divBloco) {
                        divBloco.classList.remove('telaInteira');
                        divBloco.classList.add('divideTela');
                    });
                }
            }

            window.addEventListener('load', ajustarClasses);
            window.addEventListener('resize', ajustarClasses);


            $('#cameraSelect').on('change', function () {
                const selectedDeviceId = $(this).val();

                navigator.mediaDevices.getUserMedia({ video: { deviceId: selectedDeviceId } })
                    .then(stream => {
                        $('#webCameraVideo')[0].srcObject = stream;
                    })
                    .catch(error => console.error('Erro ao obter stream da câmera: ', error));
            });

            $('#cameraSelectContent').on('change', function () {
                const selectedDeviceId = $(this).val();

                navigator.mediaDevices.getUserMedia({ video: { deviceId: selectedDeviceId } })
                    .then(stream => {
                        $('#webCameraVideoDocContent')[0].srcObject = stream;
                    })
                    .catch(error => console.error('Erro ao obter stream da câmera: ', error));
            });

            function isMobile() {
                const regex = /Mobi|Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i;
                return regex.test(navigator.userAgent);
            }

            if (isMobile()) {
                $('#cameraDesktop').hide();
                $('#cameraDesktopVio').hide();
                $('#cameraDesktopContent').hide();
                $('#cameraMobile').show();
                $('#cameraMobileVio').show();
                $('#cameraMobileContent').show();

                let videoStream;
                let useFrontCamera = true;

                function applyTransformToVideo(selector, useTransform) {
                    var videoElement = document.querySelector(selector);
                    videoElement.style.transform = useTransform ? 'scaleX(-1)' : null;
                }

                // inicializar
                async function initializeCamera() {

                    //Para o vídeo caso inicializado
                    const currentStream = $('#webCameraVideo').get(0).srcObject;
                    if (currentStream) {
                        currentStream.getTracks().forEach(track => track.stop());
                    }
                    const currentStreamContent = $('#webCameraVideoDocContent').get(0).srcObject;
                    if (currentStreamContent) {
                        currentStreamContent.getTracks().forEach(track => track.stop());
                    }

                    //Monta a estrutura de ids de vídeos disponíveis no navegador
                    const videoDeviceIds = [];
                    const devices = await navigator.mediaDevices.enumerateDevices();
                    devices.forEach(device => {
                        if (device.kind === 'videoinput') { videoDeviceIds.push(device.deviceId); }
                    });


                    if (useFrontCamera) {
                        applyTransformToVideo("#webCameraVideo", true);
                        applyTransformToVideo("#webCameraVideoDocContent", true);
                    } else {
                        applyTransformToVideo("#webCameraVideo", false);
                        applyTransformToVideo("#webCameraVideoDocContent", false);
                    }

                    //VÍDEO INICIAL
                    const currentDeviceIndex = videoDeviceIds.indexOf($('#webCameraVideo').prop('srcObject').getVideoTracks()[0].getSettings().deviceId);
                     const nextDeviceIndex = (currentDeviceIndex + 1) % videoDeviceIds.length;
                     const nextDeviceId = videoDeviceIds[nextDeviceIndex];
                    const constraints = {
                        video: {
                            deviceId: nextDeviceId,
                            facingMode: {
                                exact: useFrontCamera ? "user" : "environment"
                            },
                        }
                    };
                                         navigator.mediaDevices.getUserMedia(constraints)
                        .then(videoStream => {
                            $('#webCameraVideo').prop('srcObject', videoStream);
                        })
                        .catch(err => {
                            Notificar("@RsBase.ATENCAO_", "Não foi possível se conectar com sua webcam", "warning");
                        });

                    var videoContent = document.querySelector("#webCameraVideoDocContent");
                    videoContent.setAttribute('autoplay', '');
                    videoContent.setAttribute('muted', '');
                    videoContent.setAttribute('playsinline', '');
                    const currentDeviceIndexContent = videoDeviceIds.indexOf($('#webCameraVideoDocContent').prop('srcObject').getVideoTracks()[0].getSettings().deviceId);
                    const nextDeviceIndexContent = (currentDeviceIndexContent + 1) % videoDeviceIds.length;
                    const nextDeviceIdContent = videoDeviceIds[nextDeviceIndexContent];
                    const constraintsContent = {
                        video: {
                            deviceId: nextDeviceId,
                            facingMode: {
                                exact: useFrontCamera ? "user" : "environment"
                            },
                        }
                    };
                    navigator.mediaDevices.getUserMedia(constraintsContent)
                        .then(videoContent => {
                            $('#webCameraVideoDocContent').css('transform', 'none');
                            $('#webCameraVideoDocContent').prop('srcObject', videoContent);
                        })
                        .catch(err => {
                            Notificar("@RsBase.ATENCAO_", "Não foi possível se conectar com sua webcam", "warning");
                        });
                 }

                initializeCamera();

                $('#btnChangeCamera, #btnChangeCameraVio, #btnChangeCameraContent').on('click', async function () {
                    useFrontCamera = !useFrontCamera;

                    initializeCamera();
                });


            } else {

                $('#cameraDesktop').show();
                $('#cameraDesktopVio').show();
                $('#cameraDesktopContent').show();
                $('#cameraMobile').hide();
                $('#cameraMobileVio').hide();
                $('#cameraMobileContent').hide();

                // Monta o select das câmeras para Desktop
                try {
                    navigator.mediaDevices.enumerateDevices()
                        .then(devices => {
                            const cameraSelect = $('#cameraSelect');
                            const cameraSelectVio = $('#cameraSelectVio');
                            const cameraSelectContent = $('#cameraSelectContent');

                            cameraSelect.empty();
                            cameraSelectVio.empty();
                            cameraSelectContent.empty();

                            devices.forEach(device => {
                                if (device.kind === 'videoinput') {
                                    const option = $('<option>', {
                                        value: device.deviceId,
                                        text: device.label || `Camera ${cameraSelect.children().length + 1}`
                                    });
                                    cameraSelect.append(option.clone());
                                    cameraSelectVio.append(option.clone());
                                    cameraSelectContent.append(option.clone());
                                }
                            });

                            if (cameraSelect.children().length === 0) {
                                const option = $('<option>', { text: 'Nenhuma câmera encontrada' });
                                cameraSelect.append(option);
                                cameraSelectVio.append(option.clone());
                                cameraSelectContent.append(option.clone());
                            }
                        })
                        .catch(error => console.error('Erro ao acessar as câmeras: ', error));
                } catch (error) {
                    console.error('Erro ao executar o código: ', error);
                }
            }




            // Executar uma ação quando a confirmação é aceita
            $(window).on('unload', function () {
                var url = (`@CONSTANTES.URLPortal/api/clienteapi/ExcluirArquivosTemp`);
                $.ajax({
                    type: 'POST',
                    url: url,
                    data: {idContrato : "@Model.IdContrato"},
                    contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                });
            });

            //Monta TD com retorno de Model
            if (objetoJson != "") {
                var novaLinha = $('<td>');
                objetoJson.forEach(function (item) {
                    var resultText;
                    switch (item.Valor) {
                        case "UP":
                            resultText = "Vire a cabeça lentamente para cima";
                            break;
                        case "DOWN":
                            resultText = "Vire a cabeça lentamente para baixo";
                            break;
                        case "LEFT":
                            resultText = "Vire a cabeça lentamente para o lado esquerdo";
                            break;
                        case "RIGHT":
                            resultText = "Vire a cabeça lentamente para o lado direito";
                            break;
                        case "SMILE":
                            resultText = "Sorria para a câmera";
                            break;
                        case "BLINK":
                            resultText = "Olhando para a câmera, pisque os olhos por duas vezes";
                            break;
                    }

                    novaLinha.append($('<tr>').text(resultText));
                });
                $('#movimentos tbody').append(novaLinha);
            } else {
                var novaLinha = $('<td>');
                novaLinha.append($('<tr>').text('Mantenha os olhos fixos na câmera por três segundos.'));
                $('#movimentos tbody').append(novaLinha);

            }


            //Chama a função de envio de Doc para API Vio
            $('#fileInputVio').on('change', function () {
                var fileInputVio = document.getElementById('fileInputVio');
                var file = fileInputVio.files[0];
                var type = file.type;
                var reader = new FileReader();

                reader.onloadend = function () {
                    var base64String = reader.result;
                    $('#InputBase64Vio').val(base64String);
                    $('#InputBase64Type').val(type);
                };

                reader.readAsDataURL(file);

                var formData = new FormData();
                formData = $('#form').serialize();

                enviarDocumentacaoMostQIExtractVio();
            });

            //Chama a função de envio de Doc para API Content
            $('#fileInputContent').on('change', function () {
                var fileInputVio = document.getElementById('fileInputContent');
                var file = fileInputVio.files[0];
                var type = file.type;
                var reader = new FileReader();

                reader.onloadend = function () {
                    var base64String = reader.result;
                    $('#InputBase64Content').val(base64String);
                    $('#InputBase64Type').val(type);
                };

                reader.readAsDataURL(file);

                var formData = new FormData();
                formData = $('#form').serialize();

                enviarDocumentacaoMostQIExtractContent();
            });

        });

        //Monta a barra de progresso de acordo com o tempo das ações
        function startProgress(tempo) {
            var progressBar = document.getElementById('myProgressBar');
            var width = 1;

            var interval = setInterval(function () {
                if (width >= 100) {
                    clearInterval(interval);
                } else {
                    width++;
                    progressBar.style.width = width + '%';
                    progressBar.innerHTML = width + '%';
                }
            }, Math.floor(tempo / 100));
        }

        const jsonString = '@Html.Raw(Json.Encode(Model.Acoes_Prova_Vida))';

        //Estrutura do json
        const jsonStringDecoded = $("<div/>").html(jsonString).text();
        var jsonStringSemAspas = jsonString.replace(/^"|"$/g, '');
        var jsonStringSemAspasSimples = jsonStringSemAspas.replace(/'/g, '');
        const objetoJson = JSON.parse(jsonStringSemAspasSimples);

        function lerTextoMovimentos(texto) {
            const mensagem = new SpeechSynthesisUtterance(texto);
            window.speechSynthesis.speak(mensagem);
        }

        //Inicia a gravação
        function StartGravacao() {
            var startGravacao = document.getElementById('startGravacao');
            startGravacao.innerHTML = '<i class="fas fa-video"></i> Iniciar Gravação';
            startGravacao.style.backgroundColor = 'blue';

            var video = document.querySelector("#webCameraVideo");
            // As opções abaixo são necessárias para o funcionamento correto no iOS
            video.setAttribute('autoplay', '');
            video.setAttribute('muted', '');
            video.setAttribute('playsinline', '');

            // Desativar o espelhamento da câmera
            //video.style.transform = 'scaleX(-1)';

            selectedDeviceId = $('#cameraSelect').val();

            navigator.mediaDevices.getUserMedia({ video: { deviceId: selectedDeviceId, mirror:false } })
                .then(function (stream) {
                    video.srcObject = stream;

                    var recordedChunks = [];
                    var mediaRecorder = new MediaRecorder(stream);

                    mediaRecorder.ondataavailable = function (event) {
                        if (event.data.size > 0) {
                            recordedChunks.push(event.data);
                        }
                    };

                    mediaRecorder.onstop = function () {
                        var blob = new Blob(recordedChunks, { type: 'video/webm' });
                        var videoURL = URL.createObjectURL(blob);

                        var videoNode = document.getElementById('videoConvertido');
                        videoNode.src = videoURL;
                        videoNode.controls = true;

                        var reader = new FileReader();
                        reader.readAsDataURL(blob);
                        reader.onloadend = function () {
                            var base64data = reader.result;
                            document.querySelector("#base_img").value = base64data;
                            $("#InputBase64").val(base64data);
                        }
                    };

                    mediaRecorder.start();

                    var tabela = document.getElementById('movimentos');
                    var linhas = tabela.getElementsByTagName('tr').length;
                    var tempoDeGravacao = linhas * 3000; //3 Segundos //// Define um tempo de gravação (em milissegundos)

                    if (typeof objetoJson !== "undefined" && objetoJson !== "") {
                        $('#movimentos tbody tr').each(function (index) {

                            $("#startGravacao").hide();
                            $("#buttonGravando").show();
                            startProgress(tempoDeGravacao);
                            const tdAtual = $(this);
                            const texto = tdAtual.text();

                            setTimeout(function () {
                                tdAtual.css('color', 'red');
                                lerTextoMovimentos(texto);
                            }, index * 3000);

                            setTimeout(function () {
                                tdAtual.css('color', '');
                            }, (index + 2) * 3000);
                        });
                    } else {
                        startProgress(3000);
                        lerTextoMovimentos("Mantenha os olhos fixos na câmera por três segundos.")
                        setTimeout(function () {
                            nextPrev(1);
                            $("#startGravacao").show();
                            $("#buttonGravando").hide();
                        }, 3000);
                    }

                    setTimeout(function () {
                        mediaRecorder.stop();
                        nextPrev(1);
                        $("#startGravacao").show();
                        $("#buttonGravando").hide();
                    }, tempoDeGravacao);
                })
                .catch(function (error) {
                    console.error('Erro ao acessar a câmera:', error);
                    $("#startGravacao").show();
                    $("#buttonGravando").hide();
                });
        }

        function ExibirDivDoc(val) {
            loadCameraDoc(val);
            if (val == 1) {
                //document.getElementById('divVio').style.display = 'block';
                document.getElementById('divContent').style.display = 'none';
            } else {
                document.getElementById('divContent').style.display = 'block';
                //document.getElementById('divVio').style.display = 'none';
            }
            nextPrev(1)
        }

        //Pega o mime type do base 64
        function getBase64MimeType(base64String) {
            var mimePart = base64String.match(/^data:([a-zA-Z]+\/[a-zA-Z]+);base64,/);
            if (mimePart && mimePart.length > 1) {
                return mimePart[1];
            }
            return null;
        }


        //Envio de Doc para API Vio
        function enviarDocumentacaoMostQIExtractVio() {
            $("#divProgress").show();
                var fileInputVio = document.getElementById('fileInputVio');
                var file = fileInputVio.files[0];
                var type = file.type;
                var reader = new FileReader();

            reader.onloadend = function () {
                var base64String = reader.result.split(',')[1];
                $('#InputBase64Vio').val(base64String);
                $('#InputBase64Type').val(type);

                var url = (`@CONSTANTES.URLPortal/api/clienteapi/EnviarDocumentacaoMostQIExtractVio`);

                var formData = new FormData();
                formData = $('#form').serialize();

                $.ajax({
                    type: 'POST',
                    url: url,
                    data: formData,
                    contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                    success: function (response) {
                        $("#divProgress").hide();

                        if (response.result) {
                            nextPrev(1);
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Oops...',
                                text: response.message,
                            });
                            $("#fileInputVio").val('');
                            $("#fileInputContent").val('');
                            nextPrev(-1);
                        }
                    },
                    //error: function (error) {
                    //    $("#divProgress").hide();
                    //    Swal.fire({
                    //        icon: 'error',
                    //        title: 'Oops...',
                    //        text: 'Ocorreu um erro. Necessário realizar a gravação novamente!',
                    //    });
                    //    $("#fileInputVio").val('');
                    //    $("#fileInputContent").val('');
                    //    nextPrev(-2);
                    //}
                });

            };

                reader.readAsDataURL(file);
        }

