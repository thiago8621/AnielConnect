        }

        function enviarFotoMostQIExtractContent() {
            $("#divProgress").show();
            var url = (`@CONSTANTES.URLPortal/api/clienteapi/EnviarDocumentacaoMostQIExtractContent`);

            var type = getBase64MimeType($('#InputBase64').val());
            $('#InputBase64Type').val(type);

            var formData = new FormData();
            formData = $('#form').serialize();

            $.ajax({
                type: 'POST',
                url: url,
                data: formData,
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                success: function (response) {
                    $("#divProgress").hide();

                    if (response.result) {
                        nextPrev(1);
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: response.message,
                        });
                        $("#fileInputVio").val('');
                        $("#fileInputContent").val('');
                        nextPrev(-1);
                    }
                },
                //error: function (error) {
                //    $("#divProgress").hide();
                //    Swal.fire({
                //        icon: 'error',
                //        title: 'Oops...',
                //        text: 'Ocorreu um erro. Necessário realizar a gravação novamente!',
                //    });
                //    $("#fileInputVio").val('');
                //    $("#fileInputContent").val('');
                //    nextPrev(-2);
                //}
            });
        }


        //Envio de Vídeo para API Liveness
        function enviarVideoMostQILivenessDetect() {
            $("#divProgress").show();

            var url = (`@CONSTANTES.URLPortal/api/clienteapi/EnviarVideoLivenessDetect`);
            var formData = $('#form').serialize();
            $.ajax({
                type: 'POST',
                url: url,
                data: formData,
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                dataType: 'json',
                success: function (response) {
                    $("#divProgress").hide();

                    if (response.result) {
                        nextPrev(1);
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: response.message || 'Ocorreu um erro ao processar o vídeo. Necessário realizar a gravação novamente!',
                        });
                        nextPrev(-1);
                    }
                },
                error: function (error) {
                    $("#divProgress").hide();

                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: 'Ocorreu um erro ao processar o vídeo. Necessário realizar a gravação novamente!',
                    });
                    nextPrev(-1);
                }
            });
        }


        function loadCameraDoc(val) {
            //if (val == "1") {
            //    //Captura elemento de vídeo
            //    var video = document.querySelector("#webCameraVideoDocVio");
            //    var selectedDeviceId = $('#cameraSelectVio').val();
            //} else {
                //Captura elemento de vídeo
                var video = document.querySelector("#webCameraVideoDocContent");
                var selectedDeviceId = $('#cameraSelectContent').val();
/*            }*/

            const currentStream = $('#webCameraVideo').get(0).srcObject;
            if (currentStream) {
                currentStream.getTracks().forEach(track => track.stop());
            }
            //const currentStreamVio = $('#webCameraVideoDocVio').get(0).srcObject;
            //if (currentStreamVio) {
            //    currentStreamVio.getTracks().forEach(track => track.stop());
            //}
            const currentStreamContent = $('#webCameraVideoDocContent').get(0).srcObject;
            if (currentStreamContent) {
                currentStreamContent.getTracks().forEach(track => track.stop());
            }

            //Captura elemento de vídeo
            //var video = document.querySelector("#webCameraVideoDoc");
            //As opções abaixo são necessárias para o funcionamento correto no iOS
            video.setAttribute('autoplay', '');
            video.setAttribute('muted', '');
            video.setAttribute('playsinline', '');

            // Desativar o espelhamento da câmera
            //video.style.transform = 'scaleX(-1)';
            //--

            //Verifica se o navegador pode capturar mídia
            if (navigator?.mediaDevices?.getUserMedia != null) {
                navigator.mediaDevices.getUserMedia({ video: { deviceId: selectedDeviceId, mirror: false } })
                    .then(function (stream) {
                        //Definir o elemento vídeo a carregar o capturado pela webcam
                        video.srcObject = stream;
                    })
                    .catch(function (error) {
                        Notificar("@RsBase.ATENCAO_", "Não foi possível se conectar com sua webcam", "warning");
                    });
            }
        }

        function dataURLtoFile(dataurl, filename) {
            var arr = dataurl.split(','),
                mime = arr[0].match(/:(.*?);/)[1],
                bstr = atob(arr[arr.length - 1]),
                n = bstr.length,
                u8arr = new Uint8Array(n);
            while (n--) {
                u8arr[n] = bstr.charCodeAt(n);
            }
            return new File([u8arr], filename, { type: mime });
        }

        function takeSnapShotDoc(val) {
            //if (val == "1") {
            //    //Captura elemento de vídeo
            //    var video = document.querySelector("#webCameraVideoDocVio");
            //    var imageNode = document.querySelector("#imagemConvertidaVio");
            //} else {
                var video = document.querySelector("#webCameraVideoDocContent");
                var imageNode = document.querySelector("#imagemConvertidaContent");
            //}

            //Criando um canvas que vai guardar a imagem temporariamente
            var canvas = document.createElement('canvas');
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            var ctx = canvas.getContext('2d');

            //Desenhando e convertendo as dimensões
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

            //Criando o JPG
            var dataURI = canvas.toDataURL('image/jpeg'); //O resultado é um BASE64 de uma imagem.
            document.querySelector("#base_img").value = dataURI;

            imageNode.src = dataURI;

            var FilesSelfie = document.getElementById('FilesSelfie');
            FilesSelfie = dataURLtoFile(dataURI, 'imagem.jpg');

            $("#InputBase64").val(dataURI);

            if (val == "1") {
                $('#divTirarFotoVio').hide();
                $('#divExibirFotoVio').show();
            } else {
                $('#divTirarFotoContent').hide();
                $('#divExibirFotoContent').show();
            }
        }

        function tirarFotoNovamente(val) {
            loadCameraDoc(val);
            $("#InputBase64").val("");
            $("#base_img").val("");
            if (val == "1") {
                $('#divTirarFotoVio').show();
                $('#divExibirFotoVio').hide();
            } else {
                $('#divTirarFotoContent').show();
                $('#divExibirFotoContent').hide();
            }
        }


    </script>
}


