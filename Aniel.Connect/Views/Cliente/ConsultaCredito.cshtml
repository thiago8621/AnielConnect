<html>
<head>
    <meta charset="utf-8" />
    <style>
        @@media print {
            .noPrint {
                display: none;
            }
        }

        @@media print {
            page-break {
                display: block;
                page-break-after: always;
            }
        }

        .header, .header-space {
            height: 40px;
        }

        .header {
            top: 0;
        }

        .table > :not(caption) > * > * {
            padding: .25rem .25rem !important;
        }

        th {
            font-size: 14px !important
        }

        .tableDefault td {
            max-width: 250px !important;
            border: 0.5px solid #e0dfdf !important;
            padding: 2.5px !important;
            font-size: 12px !important
        }

        .tableHeader td {
            font-size: 12px !important
        }

        .blocos {
            background-color: #b6b2b23d;
            border-radius: 8px;
            margin-bottom: 10px;
            padding: 10px;
        }

        .vl {
            border-left: 2px solid #fff;
            height: 115px;
        }

        .img {
            max-height: 100px;
            margin-left: 70px;
        }

        .valores {
            float: right;
        }

        hr {
            color: #000;
        }
    </style>
</head>


