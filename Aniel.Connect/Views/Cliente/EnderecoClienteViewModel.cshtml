                <br>
                @Html.DropDownList("Endereco" + Model.Tipo + ".Id_Bloco", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<long>>(), "Id", "Text"), RsBase.SELECIONE, new { @id = "iBlocoSelect" + @Model.Tipo, @class = "form-control BlocoApartamento Condominio_Predio" })
                @Html.HiddenFor(m => m.Id_Bloco, new { @id = "iId_Bloco" + Model.Tipo })
</div>
