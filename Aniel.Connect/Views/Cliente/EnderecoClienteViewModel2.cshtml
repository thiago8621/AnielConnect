@model Aniel.Connect.Repository.Model.EnderecoClienteViewModel
@using Aniel.Connect.Model.enumerado

@Html.HiddenFor(model => model.Id_Endereco, new { @id = "iId_Endereco" + Model.Tipo })

@{
    var camposObrigatorios = (Dictionary<String, Boolean>)ViewBag.CamposObrigatorios;
    var stringObrigatorio = Html.Raw("<span class=\"text-danger\">* </span>");
}

@if (ViewBag.Utiliza_Cadastro_Endereco != null && ViewBag.Utiliza_Cadastro_Endereco == true)
{
    @Html.HiddenFor(model => model.Id_Endereco, new { @id = "iId_Endereco" + Model.Tipo })

    <div class="row mb-4">
        <div class="col-3">
            <div class="form-group">
                <label for="iBuscarEndereco">@RsCadastros.BUSCAR_ENDERECO:</label>
            </div>

            @Html.DropDownList("Endereco" + Model.Tipo + ".Busca_Endereco", EnumHelper.GetSelectList(typeof(Busca_Endereco)), RsBase.SELECIONE, new { @class = "form-control", @id = "iBuscaEndereco" + Model.Tipo, @autocomplete = "off" })

            @Html.HiddenFor(m => m.Busca_Endereco, new { @id = "iBuscaEndereco" + Model.Tipo })

        </div>

        <div class="col-5 Endereco_Logradouro" name="Endereco @Model.Tipo .divEnderecoLogradouro">
            <div class="form-group">
                <label for="iId_Endereco_Logradouro">@RsBase.SELECIONE:</label>
            </div>
            @Html.DropDownList("Endereco" + Model.Tipo + ".Id_Endereco_Logradouro", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @name = "Endereco" + " " + Model.Tipo + " .DivEnderecoLogradouro", @class = "form-control", @id = "iId_Endereco_Logradouro" + Model.Tipo, @autocomplete = "off", @style = "width:100%;" })
            @Html.HiddenFor(m => m.Id_Endereco_Logradouro, new { @id = "iId_Endereco_Logradouro" + Model.Tipo })

        </div>

        <div class="col-5 Condominio_Predio" name="Endereco @Model.Tipo .divCondominioPredio">
            <div class="form-group">
                <label for="iId_Condominio_Predio">@RsBase.SELECIONE:</label>
            </div>
            @Html.DropDownList("Endereco" + Model.Tipo + ".Id_Condominio_Predio", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @name = "Endereco" + " " + Model.Tipo + " .divCondominioPredio", @class = "form-control", @id = "iId_Condominio_Predio" + Model.Tipo, @autocomplete = "off", @style = "width:100%;" })
            @Html.HiddenFor(m => m.Id_Condominio_Predio, new { @id = "iId_Condominio_Predio" + Model.Tipo })

        </div>

        <div class="mt-auto ml-5 Endereco_Vazio" name="Endereco @Model.Tipo .divEnderecoVazio">
            <button type="button" class="btn btn-success h-50 d-block" id="@("btnDisponibilidade" + Model.Tipo)" onclick="verificar_disponibilidade(this.id);">
                <span style="font-size:16px">@RsCadastros.VERIFICAR_DISPONIBILIDADE</span>
            </button>
        </div>

    </div>

    <div class="row mb-4 Endereco_Vazio" name="Endereco @Model.Tipo .divEnderecoVazio">
        <div class="col-sm-1">
            <div class="form-group">
                <label for="iCep">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.CEP) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.CEP:</label>
                <br>
                <span id="@("iCEP" + Model.Tipo)"></span>
            </div>
        </div>

        <div class="col-sm-3">
            <div class="form-group">
                <label for="iTipo">@RsCadastros.TIPO_ENDERECO_LOGRADOURO:</label>
                <br>
                <span id="@("iTipo" + Model.Tipo)"></span>
            </div>
        </div>

        <div class="col-sm-3">
            <div class="form-group">
                <label for="iLogradouro">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.LOGRADOURO) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.ENDERECO_LOGRADOURO:</label>
                <br>
                <span id="@("iLogradouro" + Model.Tipo)"></span>
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group" id="iCondominioPredio">
                <label for="iCondominioPredio">@RsCadastros.CONDOMINIO_PREDIO:</label>
                <br>
                <span id="@("iCondominioPredio" + Model.Tipo)"></span>
            </div>
        </div>

    </div>

    <div class="row mb-4 Endereco_Vazio" name="Endereco @Model.Tipo .divEnderecoVazio">
        <div class="col-sm-2">
            <div class="form-group">
                <label for="iPais">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.PAIS) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.PAIS:</label>
                <br>
                <span id="@("iPais" + Model.Tipo)"></span>
            </div>
        </div>

        <div class="col-sm-1">
            <div class="form-group">
                <label for="iUF">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.UF) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.UF:</label>
                <br>
                <span id="@("iUF" + Model.Tipo)"></span>
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <label for="iCidade">@RsCadastros.CIDADE:</label>
                <br>
                <span id="@("iCidade" + Model.Tipo)"></span>


            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <label for="iBairro">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.BAIRRO) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.BAIRRO:</label>
                <br>
                <span id="@("iBairro" + Model.Tipo)"></span>
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <label for="iNumero">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.NUMERO) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))N°/Lote/Apto/Casa:</label>
                @Html.TextBoxFor(model => model.Numero, new { @class = "form-control endereco", @id = "iNumero" + Model.Tipo, @autocomplete = "off", @Maxlength = 8 })
                @Html.ValidationMessageFor(model => model.Numero, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="row mb-4 Endereco_Vazio" name="Endereco @Model.Tipo .divEnderecoVazio">
        <div class="col-sm-3">
            <div class="form-group">
                <label for="iComplemento">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.COMPLEMENTO) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.COMPLEMENTO:</label>
                @Html.TextBoxFor(model => model.Complemento, new { @class = "form-control", @id = "iComplemento" + Model.Tipo, @autocomplete = "off", @Maxlength = 80 })
                @Html.ValidationMessageFor(model => model.Complemento, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-3">
            <div class="form-group">
                <label for="iReferencia">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.PONTO_REFERENCIA) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.PONTO_REFERENCIA:</label>
                @Html.TextBoxFor(model => model.Ponto_Referencia, new { @class = "form-control endereco", @id = "iReferencia" + Model.Tipo, @autocomplete = "off", @Maxlength = 80 })
                @Html.ValidationMessageFor(model => model.Ponto_Referencia, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-3">
            <div class="form-group">
                <label for="iTipoImovel" + @Model.Tipo>@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.TIPO_IMOVEL) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.TIPO_IMOVEL:</label>
                @Html.HiddenFor(m => m.Desc_Tipo_Imovel, new { @id = "Desc_Tipo_Imovel" + Model.Tipo })
                <select class="form-control" name="Id_Tipo_Imovel" id="iTipo_Imovel@(Model.Tipo)">
                    <option>
                        @RsBase.SELECIONE
                    </option>
                </select>
            </div>
        </div>
    </div>

    <div class="row mb-4 Endereco_Vazio" name="Endereco @Model.Tipo .divEnderecoVazio">
        <div class="col-sm-3">
            <div class="form-group">
                <label for="iAno">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.GRUPO_AREA) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.GRUPO_AREA:</label>
                @Html.DropDownListFor(model => model.Cod_Escritorio, new SelectList(ViewBag.GruposArea, "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iGrupoArea" + Model.Tipo })

            </div>

        </div>

        <div class="col-sm-3">
            <div class="form-group">
                <label for="iAno">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.AREA) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.AREA:</label>
                @Html.DropDownListFor(model => model.Cod_Area, new SelectList(ViewBag.Areas), RsBase.SELECIONE, new { @class = "form-control", @id = "iArea" + Model.Tipo })

            </div>
        </div>

        <div class="col-sm-3">
            <div class="form-group">
                <label for="iAno">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.LOCALIDADE) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.LOCALIDADE:</label>
                @Html.HiddenFor(m => m.Localidade, new { @id = "iDescLocalidade" })
                @Html.DropDownListFor(model => model.Cod_Localidade, new SelectList(ViewBag.Localidades), RsBase.SELECIONE, new { @class = "form-control", @id = "iLocalidade" + Model.Tipo })

            </div>
        </div>
    </div>

    <div class="row mb-4 Endereco_Vazio" name="Endereco @Model.Tipo .divEnderecoVazio">

        <div class="col-sm-2">
            <div class="form-group">
                <label for="iLatitude">@RsCadastros.LATITUDE:</label>
                @Html.TextBoxFor(model => model.Latitude, new { @class = "form-control readonly", @id = "iLatitude" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Latitude, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <label for="iLongitude">@RsCadastros.LONGITUDE:</label>
                @Html.TextBoxFor(model => model.Longitude, new { @class = "form-control readonly", @id = "iLongitude" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Longitude, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-1 text-center">
            <button type="button" id="@( "iBtnAlert" + Model.Tipo )" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Mapa" style="margin-top: 20px;margin-bottom: 20px;"
                    onclick="return ExibeMapa('@Model.Tipo');">
                <i class="fas fa-map-marker-alt mr-1"></i>@RsCadastros.VISUALIZAR_MAPA
            </button>
        </div>

    </div>
}
else
{
    <div class="row ml-1">
        <div class="col-sm-3 mb-2">
            <div class="form-group">
                <label for="iCEP">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.CEP) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.CEP:</label>
            </div>
            @Html.TextBoxFor(model => model.CEP, new { @class = "form-control busca cep", @id = "iCEP" + Model.Tipo, @autocomplete = "off", @placeholder = "Pesquisar" })
            @Html.ValidationMessageFor(model => model.CEP, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row ml-1">
        <div class="col-sm-4">
            <div class="form-group">
                <label for="iLograduro">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.LOGRADOURO) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.LOGRADOURO:</label>
                @Html.TextBoxFor(model => model.Logradouro, new { @class = "form-control", @id = "iLogradouro" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Logradouro, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-1">
            <div class="form-group">
                <label for="iNumero">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.NUMERO) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.NUMERO:</label>
                @Html.TextBoxFor(model => model.Numero, new { @class = "form-control", @id = "iNumero" + Model.Tipo, @autocomplete = "off", @maxlength = "10" })
                @Html.ValidationMessageFor(model => model.Numero, "", new { @class = "text-danger" })
            </div>
        </div>

    </div>

    <div class="row ml-1">
        <div class="col-sm-2">
            <div class="form-group">
                <label for="">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.UF) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.UF:</label>
                <select class="form-control" id="@( "iUF" + Model.Tipo)" autocomplete="off">
                    <option value="" selected>@RsBase.SELECIONE</option>
                    <option value="AC">AC</option>
                    <option value="AL">AL</option>
                    <option value="AP">AP</option>
                    <option value="AM">AM</option>
                    <option value="BA">BA</option>
                    <option value="CE">CE</option>
                    <option value="DF">DF</option>
                    <option value="ES">ES</option>
                    <option value="GO">GO</option>
                    <option value="MA">MA</option>
                    <option value="MT">MT</option>
                    <option value="MS">MS</option>
                    <option value="MG">MG</option>
                    <option value="PA">PA</option>
                    <option value="PB">PB</option>
                    <option value="PR">PR</option>
                    <option value="PE">PE</option>
                    <option value="PI">PI</option>
                    <option value="RJ">RJ</option>
                    <option value="RN">RN</option>
                    <option value="RS">RS</option>
                    <option value="RO">RO</option>
                    <option value="RR">RR</option>
                    <option value="SC">SC</option>
                    <option value="SP">SP</option>
                    <option value="SE">SE</option>
                    <option value="TO">TO</option>
                </select>

                @Html.ValidationMessageFor(model => model.UF, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <label for="iCidade">@RsCadastros.CIDADE:</label>
                @Html.HiddenFor(m => m.Cidade, new { @id = "iDesc_Cidade" + Model.Tipo })
                @Html.DropDownListFor(m => m.Id_Cidade, new SelectList(ViewBag.ComboTmp, "Id", "Descricao"), RsBase.SELECIONE, new { @class = "form-control", @id = "iCidade" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Cidade, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <label for="iBairro">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.BAIRRO) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.BAIRRO:</label>
                @Html.TextBoxFor(model => model.Bairro, new { @class = "form-control endereco", @id = "iBairro" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Bairro, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12">         
            <div class="col-sm-6">
                <div class="form-group">
                    <label for="iTipoImovel" + @Model.Tipo>@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.TIPO_IMOVEL) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.TIPO_IMOVEL:</label>
                    @Html.HiddenFor(m => m.Desc_Tipo_Imovel, new { @id = "Desc_Tipo_Imovel" + Model.Tipo })
                    @Html.DropDownListFor(model => model.Id_Tipo_Imovel, new SelectList(ViewBag.Tipos_Imovel, "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iTipo_Imovel" + @Model.Tipo })
                    @Html.ValidationMessageFor(model => model.Id_Tipo_Imovel, "", new { @class = "text-danger" })
                </div>               
            </div>

            <div class="col-sm-6">

                <div class="form-group">
                    <label for="iPais" + @Model.Tipo>@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.PAIS) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.PAIS:</label>
                    @Html.HiddenFor(m => m.Pais, new { @id = "Pais" + Model.Tipo })
                    <select class="form-control" name="Id_Pais" id="iPais@(Model.Tipo)">
                        <option>
                            @RsBase.SELECIONE
                        </option>
                    </select>
                </div>

            </div>


        </div>
    </div>

    <div class="row ml-1">

        <div class="col-sm-4">
            <div class="form-group">
                <label for="iComplemento">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.COMPLEMENTO) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.COMPLEMENTO:</label>
                @Html.TextBoxFor(model => model.Complemento, new { @class = "form-control", @id = "iComplemento" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Complemento, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <label for="iLatitude">@RsCadastros.LATITUDE:</label>
                @Html.TextBoxFor(model => model.Latitude, new { @class = "form-control readonly", @id = "iLatitude" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Latitude, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <label for="iLongitude">@RsCadastros.LONGITUDE:</label>
                @Html.TextBoxFor(model => model.Longitude, new { @class = "form-control readonly", @id = "iLongitude" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Longitude, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-1 text-center">
            <button type="button" id="@( "iBtnAlert" + Model.Tipo )" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Mapa" style="margin-top: 20px;margin-bottom: 20px;"
                    onclick="return ExibeMapa('@Model.Tipo');">
                <i class="fas fa-map-marker-alt mr-1"></i>@RsCadastros.VISUALIZAR_MAPA
            </button>
        </div>

        <div class="col-sm-12">
            <div class="form-group">
                <label for="iReferencia">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.PONTOREFERENCIA) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.PONTOREFERENCIA:</label>
                @Html.TextAreaFor(model => model.Ponto_Referencia, new { @class = "form-control", @id = "iReferencia" + Model.Tipo, @autocomplete = "off", @rows = "6" })
                @Html.ValidationMessageFor(model => model.Ponto_Referencia, "", new { @class = "text-danger" })
            </div>
        </div>

    </div>

    <div class="row mt-2 ml-1">

        <div class="col-sm-3">
            <div class="form-group">
                <label for="iGrupoArea">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.GRUPO_AREA) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.GRUPO_AREA:</label>
                @Html.DropDownListFor(model => model.Cod_Escritorio, new SelectList(ViewBag.GruposArea, "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iGrupoArea" + Model.Tipo })

            </div>

        </div>

        <div class="col-sm-3">
            <div class="form-group">
                <label for="iArea">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.AREA) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.AREA:</label>
                @Html.DropDownListFor(model => model.Cod_Area, new SelectList(ViewBag.Areas), RsBase.SELECIONE, new { @class = "form-control", @id = "iArea" + Model.Tipo })

            </div>
        </div>

        <div class="col-sm-3">
            <div class="form-group">
                <label for="iLocalidade">@(camposObrigatorios != null ? (camposObrigatorios.ContainsKey(RsCadastros.LOCALIDADE) ? Html.Raw(stringObrigatorio) : Html.Raw("")) : Html.Raw(""))@RsCadastros.LOCALIDADE:</label>
                @Html.HiddenFor(m => m.Localidade, new { @id = "iDescLocalidade" })
                @Html.DropDownListFor(model => model.Cod_Localidade, new SelectList(ViewBag.Localidades), RsBase.SELECIONE, new { @class = "form-control", @id = "iLocalidade" + Model.Tipo })

            </div>
        </div>

    </div>
}
