@model Aniel.Connect.Repository.Model.PlanoProdutoListModel
@using Aniel.Connect.Model.enumerado
@{
    ViewBag.Title = "DetalhesPlanoProduto";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section scripts
{
    <style>
        .bloqueiodatas {
            padding-top: 25px;
            padding-right: 20px;
            padding-bottom: 5px;
        }
    </style>

    <script>
        function Gravar() {
            $.ajax({
                url: "@CONSTANTES.URLPortal/api/clienteapi/GravarDetalhesPlanoProduto",
                type: "POST",
                data: {
                    Objeto: {
                        Id: @Model.Id,
                        ImpedirBloqueio_Feriados: $("#ImpedirBloqueio_Automaticoferiado").prop('checked'),
                        ImpedirBloqueio_Domingo: $("#ImpedirBloqueio_Automaticodomingo").prop('checked'),
                        ImpedirBloqueio_Sabado: $("#ImpedirBloqueio_Automaticosabado").prop('checked'),
                        ImpedirBloqueio_Sexta: $("#ImpedirBloqueio_Automaticosexta").prop('checked'),
                        ImpedirBloqueio_Automatico: $("#ImpedirBloqueio_Automatico").prop('checked'),
                        BloqueioAutomatico_Debito: $("#iBloqueioAutomatico_Debito").prop('checked'),

                        Dias_Atraso: $("#iDias_Atraso").val(),
                        Reducao_Velocidade: $("#iReducao_Velocidade").prop('checked'),
                        QtdDiasAtraso: $("#iQtdDiasAtraso").val(),
                        Velocidade_DownloadReduzida: $("#iVelocidade_DownloadReduzida").val(),
                        Velocidade_UploadReduzida: $("#iVelocidade_UploadReduzida").val(),

                        QtdDiasbloqueados: $("#QtdDiasbloqueados").val(),

                        Frequencia_Desbloqueio: $("#iFrequencia_Desbloqueio").val(),
                        dias_desbloq: $("#iDias_Desbloq").val(),
                        Desbloqueio_Conf: $("#idesblqueio_conf").prop('checked'),

                        Meses_Carencia: $("#iMeses_Carencia").val(),
                        Qtde_Dias: $("#iQtde_Dias").val(),
                        Numero_Parcelas: $("#iNumero_Parcelas").val(),
                        ValorInstalacao: $("#iConsultaValorPlano").val(),
                        CobrarInstalacaoEntrada: $("#iCobrancaInstalacaoEntrada").prop('checked'),
                        ValorInstalacaoEntrada: $("#iValorInstalacaoEntrada").val(),
                        Quantidade: $("#iQuantidade").val(),
                        ValorPlanoOriginal: $("#ivalorPlano").val(),
                        Parcela: $("#iParcela").val(),
                        Valor_Entrada: $("#iValor_Entrada").val()
                    }
                },
                beforeSend: function () {
                    ShowPageLoading();
                },
                complete: function () {
                    HidePageLoading();
                }
            })
                .done(function (data) {
                    if (data.ok) {
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                        parent.salvou = true;
                        parent.dial.dialog('close');
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                });
        }

    let [poligonosbanco, lista_Analise_Comercial, geoCliente] = [[], [], [@Model.Latitude,@Model.Longitude]];

    async function reservarCaixa_Porta() {
        let [matrizLat, matrizLng] = [Number("@Model.Latitude".replace(",", ".")), Number("@Model.Longitude".replace(",", "."))];
        if (!((matrizLat == 0 || matrizLng == 0))) {
            geoCliente = [];
            lista_Analise_Comercial = [];
            geoCliente.push(matrizLat, matrizLng);
            parent.AddAba(`@Html.Raw(Url.Action("Index","Viabilidade"))?latitude=${matrizLat}&longitude=${matrizLng}&idClientePlanoProduto=@Model.Id`, "Consulta de Viabilidade");
        }
        else {
            Notificar("Aten&#231;&#227;o!", " O Endereço é obrigatório. Por Favor Preencher!", "warning");
        }
    }

    function closeModal(id_plano_produto) {
        parent.VincularOnu(id_plano_produto)
        parent.dial.dialog('close');
        return false;
    }

    function closeModalStatusOnu(id_plano_produto) {
        parent.StatusOnu(id_plano_produto)
        parent.dial.dialog('close');
        return false;
    }

        $(document).ready(function () {
           @if (Model.Meses_Carencia == 0 || Model.Meses_Carencia == null)
           {
            <text>
            $('#iConsultaMeses_Carencia').text('0');
            </text>
            }

            $('#ImpedirBloqueio_Automatico').trigger('change');
            $('#iBloqueioAutomatico_Debito').trigger('change');
            $('#iReducao_Velocidade').trigger('change');
            $('#idesblqueio_conf').trigger('change');

            @if(Model.CobrarInstalacaoEntrada == false)
            {
              <text>
              $("#divValorInstalacaoEntrada").hide();
               </text>
            }

        });

        $('#idesblqueio_conf').change(function () {
            if ($('#idesblqueio_conf').is(':checked')) {

                $(".bloqueio_DesbloqueioConf").show();
            }
            else {
                $(".bloqueio_DesbloqueioConf").hide();
            };
        });

        $('#ImpedirBloqueio_Automatico').change(function () {
            if ($('#ImpedirBloqueio_Automatico').is(':checked')) {

                $(".bloqueiodatas").show();
            }
            else {
                $(".bloqueiodatas").hide();
            };
        });

        $('#iCobrancaInstalacaoEntrada').change(function () {
            if ($('#iCobrancaInstalacaoEntrada').is(':checked')) {

                $("#divValorInstalacaoEntrada").show();
            }
            else {
                $("#divValorInstalacaoEntrada").hide();
            };
        });

        $('#iReducao_Velocidade').change(function () {
            if ($('#iReducao_Velocidade').is(':checked')) {

                $(".propriedades_Velocidade").show();
            }
            else {
                $(".propriedades_Velocidade").hide();
            };
        });

        $('#iBloqueioAutomatico_Debito').change(function () {

            if ($('#iBloqueioAutomatico_Debito').is(':checked')) {
                $('#iQtdDiasbloqueados').show();
            }
            else {
                $('#iQtdDiasbloqueados').hide();
            }
        });

        $(".float-cancel").on("click", function () {
            window.parent.$('.ui-dialog-content').dialog('close');
        });

    </script>
}

