<div class="main">
    <div class="section section-basic">
        <div class="container text-center">



            @if (Model.ExigeFotoTermo && Model.TipoComprovanteTermo == Sinapse.Model.enumerados.Tipo_Comprovante_Termo.ProvaVida)
            {
                <text>
                    <p class="texto margem-topo">Prezado(a) @Model.Cliente. Para confirmar o seu contrato e realizar o aceite, é necessário realizar algumas etapas de confirmações de identidade.</p><hr size="10" width="auto">
                </text>
            }
            else
            {
                <text>
                            <p class="texto margem-topo">Prezado(a) @Model.Cliente. Para confirmar o seu contrato é necessário realizar a assinatura e o aceite no Contrato.</p><hr size="10" width="auto">
                </text>
            }

            @if (ViewBag.StatusContrato == Aniel.Connect.Model.enumerado.Status_Aceite_Contrato.Cancelado)
            {
                <div class="main pt-2">
                    <div class="section section-basic">
                        <div class="container text-center">
                            <div class="jumbotron mt-3">
                                <div class="container">
                                    <p class="lead">Infelizmente, a venda associada a este formulário foi cancelada.</p>
                                    <p class="lead">Caso tenha alguma dúvida ou precise de mais informações, entre em contato conosco.</p>
                                    <p class="lead">Agradecemos pela compreensão.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                using (Html.BeginForm("FormularioCliente", "Cliente", FormMethod.Post, htmlAttributes: new { enctype = "multipart/form-data", @id = "form" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.HiddenFor(model => model.Cliente)
                    @Html.HiddenFor(model => model.IdContrato)


                    //SELFIE
                    if (Model.ExigeFotoTermo && Model.TipoComprovanteTermo == Sinapse.Model.enumerados.Tipo_Comprovante_Termo.Selfie)
                    {
                        Html.RenderPartial("~/Views/Cliente/SelfiePartialContrato.cshtml", Model);
                    }


                    //TERMO PROVA DE VIDA
                    else if (Model.ExigeFotoTermo && Model.TipoComprovanteTermo == Sinapse.Model.enumerados.Tipo_Comprovante_Termo.ProvaVida)
                    {
                        Html.RenderPartial("~/Views/Cliente/ProvaVidaPartialContrato.cshtml", Model);
                    }

                    //TERMO SEM COMPROVANTE
                    else
                    {
                        Html.RenderPartial("~/Views/Cliente/SelfiePartialContrato.cshtml", Model);

                    }

                }
            }
        </div>
    </div>
</div>
