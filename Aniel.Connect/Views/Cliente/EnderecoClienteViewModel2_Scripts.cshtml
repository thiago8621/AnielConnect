                            <text>
                                $('#iLocalidade' + "@Model.Tipo").val('@Model.Cod_Localidade');
                            </text>
                            }
                     });*@
                })
                .fail(function () {
                    console.log("error");
                })
                .always(function () {
                    try {
                        parent.App.stopPageLoading();
                    }
                    catch (ex) { console.log(ex); }

                });


        });

        $('#iArea' + "@Model.Tipo").change(async function () {

            $('#iLocalidade' + "@Model.Tipo").empty();

            var grupo_area = $('#iGrupoArea'+ '@Model.Tipo' +' option:selected').val();
            var area = $('#iArea'+ '@Model.Tipo' +' option:selected').val();

            var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

            await $.getJSON(enderecoApi, function (data) {
                $('#iLocalidade' + "@Model.Tipo").append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                $.each(data.objeto, function (key, value) {
                    $('#iLocalidade' + "@Model.Tipo").append($('<option></option>').attr('value', value.value).text(value.label));
                });
            });

            $('#iLocalidade' + "@Model.Tipo").trigger('change');

            if (!abertura_boolean_localidade)
            {
                $('#iLocalidade' + "@Model.Tipo").val('@Model.Cod_Localidade');
                abertura_boolean_localidade = true
                $('#iLocalidade' + "@Model.Tipo").trigger('change');
            }

        });


    $('#iLocalidade' + "@Model.Tipo").change(function () {


        $('#iDescLocalidade').val('');
        $('#iDescLocalidade').val($('#iLocalidade' + '@Model.Tipo' +' option:selected').text());

        //$('#iDescLocalidade').val();
        //$('#iDescLocalidade').val(null);
    });

    reloadData("@(CONSTANTES.URLPortal + "/api/Tipo_ImovelAnielapi/busca")", "idTipo_Imovel", "iTipo_Imovel");
</script>
