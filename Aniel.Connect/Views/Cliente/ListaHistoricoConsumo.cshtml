@model IEnumerable<Aniel.Connect.Models.HistoricoConsumoRadiusModel>

@{
    ViewBag.Title = "ListaLoginRadius";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts {

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

    <script>

         @if (!String.IsNullOrEmpty(Request.Params["Login_Radius"]))
    {
        <text>
            
        $('#Login_Radius').val(@Request.Params["Login_Radius"]);
            
        </text>
        }
        var array = JSON.parse('@Html.Raw(Json.Encode(Model))');


        var datatable = $("#datatableLogin").length && $("#datatableLogin").DataTable({
        dom: "",
        language: traducaoDataTableSimples,
        data: array,
        paging: false,


        columns: [
        {
        data: "Data_Inicio",
        title: "@RsCadastros.DATA_HORA_INICIO"
        },
        {
        data: "Data_Fim",
        title: "@RsCadastros.DATA_HORA_FIM"
        },

        {
        data: "Tempo_Uso", title: "@RsCadastros.DURACAO Minutos",
        render: function (data, type, row, meta) {
        if(data!='')
        return '<span>' + data + ' Minutos</span>';
        else
        return '<span></span>';
        }
        },
        {
        data: "MacUser",
        title: "@RsCadastros.MAC"
        },
        {
        data: "IpUser",
        title: "@RsCadastros.IP"
        },
        {
        data: "Trafego_Total", title: "@RsCadastros.TRAFEGO_TOTAL MB",
        render: function (data, type, row, meta) {
        return '<span>' + data + 'MB</span>';
        }
        },
        {
        data: "Trafego_Download", title: "@RsCadastros.TRAFEGO_DOWN MB",
        render: function (data, type, row, meta) {
        return '<span>' + data + 'MB</span>';
        }
        },
        {
        data: "Trafego_Upload", title: "@RsCadastros.TRAFEGO_UPLOAD MB",
        render: function (data, type, row, meta) {
        return '<span>' + data + 'MB</span>';
        }
        },

        ]
        });

        </script>
}

<table class="table table-hover nowrap" id="datatableLogin" style="width:100%">
</table>