                    onclick="return ExibeMapa('@Model.Tipo');">
                <i class="fas fa-map-marker-alt mr-1"></i>@RsCadastros.VISUALIZAR_MAPA
            </button>
        </div>


    </div>

    if (Model.Tipo == Tipo_EnderecoCliente.Principal || Model.Tipo == Tipo_EnderecoCliente.Instalacao || Model.Tipo == Tipo_EnderecoCliente.Prospecto)
    {
