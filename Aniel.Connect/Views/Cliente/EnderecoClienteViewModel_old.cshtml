        <div class="col-sm-2">
            <div class="form-group">
                <label for="iLatitude">@RsCadastros.LATITUDE:</label>
                @Html.TextBoxFor(model => model.Latitude, new { @class = "form-control readonly", @id = "iLatitude" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Latitude, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <label for="iLongitude">@RsCadastros.LONGITUDE:</label>
                @Html.TextBoxFor(model => model.Longitude, new { @class = "form-control readonly", @id = "iLongitude" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Longitude, "", new { @class = "text-danger" })
            </div>
        </div>

