                @Html.HiddenFor(m => m.Desc_Tipo_Imovel, new { @id = "Desc_Tipo_Imovel" + Model.Tipo })
                @Html.DropDownListFor(model => model.Id_Tipo_Imovel, new SelectList(ViewBag.Tipos_Imovel, "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control " + (camposBloqueados.ContainsKey(RsCadastros.TIPO_IMOVEL) ? "readonly" : ""), @id = "iTipo_Imovel" + @Model.Tipo })
                @Html.ValidationMessageFor(model => model.Id_Tipo_Imovel, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-4">

            <div class="form-group">
                <label for="iPais" + @Model.Tipo>@(camposObrigatorios.ContainsKey(RsCadastros.PAIS) ? Html.Raw(stringObrigatorio) : Html.Raw(""))@RsCadastros.PAIS:</label>
                @Html.HiddenFor(m => m.Pais, new { @id = "Pais" + Model.Tipo })

                @Html.DropDownListFor(model => model.Id_Pais, new SelectList(ViewBag.Paises, "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control endereco " + (camposBloqueados.ContainsKey(RsCadastros.PAIS) ? "readonly" : ""), @id = "iPais" + @Model.Tipo })
                @Html.ValidationMessageFor(model => model.Id_Pais, "", new { @class = "text-danger" })
            </div>

        </div>

