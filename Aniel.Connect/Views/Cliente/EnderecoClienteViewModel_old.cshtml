                @Html.TextBoxFor(model => model.Bairro, new { @class = "form-control endereco", @id = "iBairro" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Bairro, "", new { @class = "text-danger" })

            </div>
        </div>

    </div>


    <div class="row">

