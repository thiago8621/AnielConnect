        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <label for="iCidade">@RsCadastros.CIDADE:</label>
                @Html.HiddenFor(m => m.Cidade, new { @id = "iDesc_Cidade" + Model.Tipo })
                @Html.DropDownListFor(m => m.Id_Cidade, new SelectList(ViewBag.ComboTmp, "Id", "Descricao"), RsBase.SELECIONE, new { @class = "form-control endereco", @id = "iCidade" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Cidade, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <label for="iBairro">@RsCadastros.BAIRRO:</label>
