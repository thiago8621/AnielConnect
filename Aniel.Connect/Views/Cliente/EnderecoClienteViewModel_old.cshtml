                                </b>
                            </p>

                        </div>
                    </div>

                </div>*@
        }

    </div>

    <div class="row">

        <div class="col-sm-4">
            <div class="form-group">
                <label for="iLograduro"><span class="text-danger">*</span> @RsCadastros.LOGRADOURO:</label>
                @Html.TextBoxFor(model => model.Logradouro, new { @class = "form-control endereco", @id = "iLogradouro" + Model.Tipo, @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Logradouro, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-sm-1">
            <div class="form-group">
                <label for="iNumero"><span class="text-danger">*</span> @RsCadastros.NUMERO:</label>
                @Html.TextBoxFor(model => model.Numero, new { @class = "form-control endereco", @id = "iNumero" + Model.Tipo, @autocomplete = "off", @Maxlength = 8 })
                @Html.ValidationMessageFor(model => model.Numero, "", new { @class = "text-danger" })
            </div>
        </div>

    </div>

    <div class="row">

        <div class="col-sm-2">
            <div class="form-group">
                <label for=""><span class="text-danger">*</span> @RsCadastros.UF:</label>
                <select class="form-control endereco" id="@( "iUF" + Model.Tipo)" autocomplete="off">
