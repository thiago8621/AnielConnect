@model  Sinapse.Util.ExcelServiceLog<Aniel.Connect.Models.Cliente_Importacao>

@{
    ViewBag.Title = RsCadastros.IMPORTAR_CLIENTES;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    ViewBag.Modelo = CONSTANTES.URLPortal + @"/Arquivos/Cliente/Modelo_Padrao_Importacao_Clientes.xlsx";
}

@section styles
{
    @Styles.Render("~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />

    <style>
        .popover{
            max-width: 45%; /* Max Width of the popover (depending on the container!) */
        }
    </style>
}


@section  scripts
{
    @Scripts.Render("~/bundles/jsDataTable")
    <script src="~/bin/Scripts/download.js"></script>

    <script>

        let datatableExportMuni
        var oDatatable = undefined

        //Download Planilha UF Sistema
        $("#iPlanilha_Sistema").click(function () {
            ShowPageLoading()
            $.ajax({
                url: '@CONSTANTES.URLPortal/api/enderecoapi/PlanilhaEstadosMunicipios',
                type: 'GET',
                dataType: 'json',

            }).done(function (data) {


                //DataTable
                if (oDatatable != undefined) {
                    oDatatable.destroy();
                    $("#datatable").empty();
                }

                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "Bfrti",
                    data: data,
                    buttons: buttonsDataTableRelatorio({
                        sheet_name: "Estados e Municípios",
                        title: "Tabela de Estados e Municípios"
                    }),
                    columns: [
                        { data: "uf", title: "@RsCadastros.UF" },
                        { data: "descricao", title: "@RsCadastros.MUNICIPIO" }
                    ]
                });

                oDatatable.buttons(0).trigger()
                HidePageLoading()

              });

        });
        //Fim Planilha UF Sistema

        $('#iArquivo').on('change', function () {

            var myfile = $(this).val();
            var ext = myfile.split('.').pop();
            if (!(ext == "xls" || ext == "xlsx")) {

                Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                $(this).val("");
            }
            else {

                var arquivo = $(this)[0].files[0];

                var fileName = arquivo.name;
                $(this).next('.custom-file-label').html(fileName);
            }
        });

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;
            var erro = false;

            myfile= $("#iArquivo").val();
            if (!myfile) {

                if ($('#iArquivo').next('.custom-file-label').html() == '') {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ARQUIVO)", "warning");
                    erro = true;
                }
                else {

                    var ext = $('#iArquivo').next('.custom-file-label').html().split('.').pop();
                    if (!(ext == "xlsx" || ext == "xls")) {

                        Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                        erro = true;
                    }
                }
            }
            else {

                var ext = myfile.split('.').pop();
                if (!(ext == "xlsx" || ext == "xls")) {

                    Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                    erro = true;
                }
            }

            if (erro) {

                clicked = false;
                return false;
            }

            $("#divProgress").show();

            $('#form').submit();
        }

        $(document).ready(function () {
              $('[data-toggle="popover"]').popover()

            var sucesso = "@Html.Raw(ViewBag.Sucesso)";
            if (sucesso == "S") {
                Notificar("@RsCadastros.INFORMACAO", "@RsCadastros.IMPORTACAO_CLIENTES_FINALIZADA", "info");
            }

        });

    </script>


    @if (Model.Log.Count() > 0)
    {
        <text>
            <script>

           var array = @Html.Raw(Json.Encode(Model.Log));
           var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                scrollX: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '30vh',
                drawCallback: function (settings) {
                    $('.switchToggle').bootstrapToggle('state', true);
                },
                columns: [
                    {
                        data: "Chave",
                        title: "@Html.Raw(RsCadastros.IDENTIFICACAO_CLIENTE)",
                    },
                    {
                        data: "Erro",
                        title: "Mensagem"
                    }
                ]
            });
            </script>
        </text>
    }
}

