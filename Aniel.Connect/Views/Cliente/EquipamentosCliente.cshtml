@{
    ViewBag.Title = RsFinanceiro.EQUIPAMENTOS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion,"~/bundles/jsDataTableSimples")
    <script>
        var oDatatable = null;

        "use strict";

        $(document).ready(function () {

            //"Blfrtip"
           var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                select: {
                    style: 'multi'
                },
                //order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                processing: true,
                //ordering: true,
                paging: true,
                deferRender: true,
                autoWidth: false,
                //scrollY: '75vh',
                async: false,
                //scroller: {
                //    loadingIndicator: true
                //},
                //stateSave: true,
                //scrollX: true,
                //fixedHeader: true,
                //initComplete: dataTableInitComplete,
                //sScrollY: "400px",
                //bScrollCollapse: true,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/clienteapi/GetAllEquipamentos',
                    type: 'POST',
                    async: false,//TESTE
                    data: function (data) {
                        data.cpf_Cnpj = '@Html.Raw(ViewBag.Cpf_Cnpj)'
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
               columns: [
                   { data: "codMat", title: "@RsCadastros.CODIGO" },
                    { data: "descMat", title: "@RsCadastros.DESCRICAO", orderable: false },
                   { data: "codCpl", title: "@RsCadastros.CODIGO_COMPLEMENTAR", orderable: false },
                    { data: "saldo", title: "@RsCadastros.SALDO", orderable: false }
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                //updateDataTableSelectAllCtrl(oDatatable);
                rows_selected = [];
            });

        });

    </script>
}
<div style="padding:10px">
    <div class="card" style="border:none;">
        <div id="accordion">

            <div class="card div-card-accord">
                <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                    <div class="card-body">

                        <table class="table table-hover nowrap" id="datatable" style="width:100%">
                            <thead class="tb-head">

                            </thead>
                        </table>
                    
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
