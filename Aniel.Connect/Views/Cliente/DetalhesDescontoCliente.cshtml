@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "DescontoDetalhes";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    long? IdClienteDesconto = ViewBag.ClienteDesconto;//ViewBag.Desconto;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTableSimples")

    <style>
        #infoResumo {
            display: flex;
            justify-content: flex-start;
            gap: 100px; /* ajuste até alinhar com a coluna Valor */
        }

        .col-mes {
            min-width: 100px;
            font-size: 16px;
        }
    </style>
}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>

        let oDatatable
        if (oDatatable != null) {
            oDatatable.destroy();
            $("#datatableDescontosDetalhes").empty();
            oDatatable = null;
        }

    oDatatable = $("#datatable").length && $("#datatable").DataTable({

        dom: "frti",
        columnDefs: [{
            targets: 0,
            searchable: false,
            orderable: false,
            width: '1%',
            className: 'dt-body-center',
            render: function (data, type, full, meta) {
                return "";
            }
        },
        {
            targets: 1,
            searchable: false,
            orderable: false,
            width: '1%',
            className: 'dt-body-center'
        }],
        select: {
            style: 'single'
        },
        order: [[0, 'asc']],
        serverSide: true,
        searching: true,
        ordering: false,
        paging: true,
        deferRender: true,
        scrollResize: true,
        scrollY: '50vh',
        scroller: {
            loadingIndicator: true,
            rowHeight: 10,
            boundaryScale: 0.2,
            displayBuffer: 100
        },
        scrollX: true,
        initComplete: dataTableInitComplete,
        lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
        ajax: {
            url: baseUrl + '/api/Descontoapi/DetalhesDesconto',
            type: 'POST',
            data: function (data) {
                const id = Number("@IdClienteDesconto");

                data.IdClienteDesconto = id;

            },
            error: function (e) {
                console.log(e);
            },
            dataSrc: function (d) {
                if (d.data && d.data.length > 0) {
                    const resumo = d.data[0];
                    $("#duracaoDesconto").text(resumo.duracaoDesconto);
                    $("#valorUnico").text(resumo.valorUnico);
                }
                return d.data;
            }
        },
        infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

            var str = "@RsCadastros.INFODATATABLE";
            if (iTotal == 0) { iEnd = 0; iStart = 0; }
            str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
            $("#dtLegend").html(str);

            return "";
        },
        rowCallback: function (row, data, dataIndex) {

        },
        drawCallback: function () {
            //handleExcluir();
            //handleEditar();
        },
        language: traducaoDataTable,
        buttons: buttonsDataTable,
        columns: [
            {
                data: "mesInicio", title: "@RsCadastros.MES_INICIAL", className: "col-mes",
                render: function (data, type, row, meta) {
                    return data;
                }
            },
            {
                data: "mesFinal", title: "@RsCadastros.MES_FINAL", className: "col-mes",
                render: function (data, type, row, meta) {
                    return data;
                }
            },
            {
                data: "valor", title: "@RsCadastros.VALOR",
                render: function (data, type, row, meta) {
                    return data;
                }
            },
            {
                data: "percentual", title: "@RsCadastros.PERCENTUAL",
                render: function (data, type, row, meta) {
                    return data;
                }
            },
            {
                data: "usuarioCriacao", title: "@RsCadastros.USUARIO_ADICIONOU",
                render: function (data, type, row, meta) {
                    return data;
                }
            },
        ]
    });
    oDatatable.draw();
</script>
}

<div class="container" style="padding: 20px;">
    <div id="infoResumo" style="display: flex; margin: 0px 0px 10px 11px;">
        <div style="flex: 1; font-family: 'Roboto', sans-serif; font-size: 12px;">
            <strong>Tempo de Duração (Em Meses):</strong> <span id="duracaoDesconto"></span>
        </div>
        <div style="flex: 1; font-family: 'Roboto', sans-serif; font-size: 12px; text-align: center; margin: 0 0 0 -47.6rem;">
            <strong>Valor único?</strong> <span id="valorUnico"></span>
        </div>
    </div>
    <div style="border-top: 1px solid #ccc; margin: 10px 0;"></div>
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>
