@model IEnumerable<Aniel.Connect.Models.Cliente_ListaLoginRadius>

@{
    ViewBag.Title = "ListaLoginRadius";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts {

    @Styles.RenderFormat(SiteKeys.ScriptVersion,"~/bundles/jsDataTableSimples")

    <script>

        var array = @Html.Raw(Json.Encode(Model));

        $("#datatableLogin").DataTable({
            dom: "",
            language: traducaoDataTableSimples,            
            data: array,
            columns: [
                        {
                            data: "Login",
                            title: "@RsCadastros.LOGIN_RADIUS"
                        },
                        {
                            data: "Plano",
                            title: "@RsCadastros.PLANO"
                        }
                    ]
        });

    </script>
}

<table class="table table-hove nowrapr" id="datatableLogin" style="width:100%">
</table>