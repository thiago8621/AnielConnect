            let url = "@CONSTANTES.URLPortal/api/Vendaapi/FindVendaById_Cpp?Id_cpp=" + $("#iIdPlanoProduto").val();
            let venda = null;

            try {
                  @*Ajax para obter venda*@

                await $.ajax({
                    type: "GET",
                    url: url,
                    dataType: "json",
                    success: (retorno) => { venda = retorno.objeto },
                    error: (retorno) => { throw retorno.mensagem; },
                });

            @*Url de mudanca com parâmetro da venda agora*@
            let urlMudanca = "@Url.Action("ClienteDadosGerais", "Venda", new { @*Id_Venda="__venda__",*@ Id_Cliente = "__cliente__"@*, IdAtendimento = "__atendimento__"*@})";
            urlMudanca = urlMudanca.replace("__cliente__","@Model.Id");

            AddAba(urlMudanca, "@RsCadastros.MUDANCA_CONTRATO_SEM_ACENTO");

            }
            catch (error) {
                Notificar("@RsBase.ATENCAO_", `${error}`, "warning");
            }
        };

