        async function AlterarEndereco() {
            var _IdCliente = "@Model.Id";
            var _IdClientePlanoProduto = $("#iIdPlanoProduto").val();
            var retornoOS = await $.ajax({
                url: `@CONSTANTES.URLPortal/api/Atendimentoapi/GetOrdensServicos_TrocaEndereco?IdCliente=${_IdCliente}&IdClientePlanoProduto=${_IdClientePlanoProduto}`,
                type: 'GET',
                dataType: 'json',
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                }
            });

            if (retornoOS.length > 0) {
                var html = `Atenção! Cliente já possui uma troca de endereço pendente para este plano/produto {trocarNrOS} Por favor trate a OS (baixando ou cancelando) e depois tente trocar o endereço novamente.\n`;
                var numOs = ``;
                for (var i = 0; i < retornoOS.length; i++) {
                    numOs += `Ordem de Serviço gerada Nº ${retornoOS[i].numero_Obra_Original};\n`;
                }
                html = html.replace("{trocarNrOS}", numOs);
                const _resultSwalConsultaOS = await Swal.fire({
                    text: html,
                    type: 'question',
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'OK',
                });

                return false;
            }
            var idEndereco = @Model.EnderecoPrincipal.Id;
            if (idEndereco != 0) {
                await ShowDialog(true, true, 'Alterar Endereço', '@Url.Action("AlterarEndereco", "Cliente")' + '?IdClientePlanoProduto=' + $("#iIdPlanoProduto").val() + '&IdEndereco=' + idEndereco + '&IdCliente=' + "@Model.Id", 'divAlterarEndereco', 1250, 850, 'iframeEndereco', async function (e) {
                    if (salvou == true) {

                        salvou = false;
                        const getDadosPlanoProduto = await $.ajax({
                            url: "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetDadosPlanoProduto_Atendimento?IdPlano=" + $("#iIdPlano").val() + "&IdAtendimento=" + 0,
                            type: 'GET',
                            dataType: 'json',
                            beforeSend: function () {
                                $("#divProgress").show();
                            }
                        });

                        if (getDadosPlanoProduto == true) {
                            var obj_plano_produto = await getContratoPlanoProduto($("#iIdPlanoProduto").val());
                            let retorno = null;
                            if (obj_plano_produto.ok) {
                                retorno = obj_plano_produto.objeto;
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", obj_plano_produto.mensagem, "warning");
                                return false;
                            }
                            var model = {};
                            model.Usuario = "@User.Identity.GetUserId()";
                            model.Objeto = {
                                Cod_Localidade: retorno.cod_Localidade,
                                Cod_Area: retorno.cod_Area,
                                Cod_Escritorio: retorno.cod_Escritorio,
                                Projeto: retorno.projeto,
                                Contrato: retorno.contrato,
                                Id_Tipo_servico: retorno.id_Tipo_Servico,
                                Tipo: "C",
                                Id_Cliente_Plano_Produto: $("#iIdPlanoProduto").val(),
                                Id_Categoria_Cliente: "@Model.Id_Categoria_Cliente",
                                CPF_CNPJ_Cliente: "@Model.TipoPessoa" == "Fisica" ? "@Model.CpfCnpj" : "@Model.CPFResponsavel",
                                Id_Cliente: "@Model.Id",
                                Nome_Cliente: "@Model.TipoPessoa" == "Fisica" ? "@Model.NomeCompleto" : "@Model.NomeFantasia",
                                Observacao_OS: "Troca de endereço do cliente.",
                                Id_Atendimento: "",
                                Id_Plano_Produto: $("#iIdPlano").val()
                            };

                            const doc_producao = await $.ajax({
                                url: "@CONSTANTES.URLPortal/api/Documento_ProducaoApi/Gravar",
                                type: 'POST',
                                dataType: 'json',
                                data: model,
                                beforeSend: function () {
                                    $("#divProgress").show();
                                },
                                complete: function () {
                                    $("#divProgress").hide();
                                }
                            });

                            if (doc_producao.ok) {
                                var _numObra = doc_producao.idObjeto.num_Obra.replace("/1", "");
                                var _numDoc = doc_producao.idObjeto.num_Doc;
                                var _contrato = doc_producao.idObjeto.codCt;
                                var _projeto = doc_producao.idObjeto.projeto;

                                const _resultSwalCriarOs = await Swal.fire({
                                    text: `Para trocar o endereço foi gerada a OS nº ${_numObra}! Deseja Agendar?`,
                                    type: 'question',
                                    showCancelButton: true,
                                    confirmButtonColor: '#3085d6',
                                    cancelButtonColor: '#d33',
                                    confirmButtonText: 'Sim',
                                    cancelButtonText: 'Não'
                                });

                                $("#divProgress").show();
                                if (_resultSwalCriarOs.value) {
                                    let urlos = '@Url.Action("Index", "Acompanhamento_Servico")' + `?CodCt=${_contrato}&Projeto=${_projeto}&Num_Obra=${_numObra}&Num_Doc=${_numDoc}`;
                                    AddAba(urlos);

                                    location.href = "@Html.Raw(Url.Action(" ClienteDadosGerais ", " Cliente ", new { Id = Model.Id }))";
                                    window.location.reload(true);
                                } else {
                                    location.href = "@Html.Raw(Url.Action(" ClienteDadosGerais ", " Cliente ", new { Id = Model.Id }))";
                                    window.location.reload(true);
                                }
                            } else {
                                Notificar("@RsBase.ATENCAO_", doc_producao.mensagem, "warning");
                            }
                        } else {
                            await Notificar("Atenção!", "Endereço de instalação, alterado com sucesso.", "info");

                            location.href = "@Html.Raw(Url.Action("ClienteDadosGerais", "Cliente", new { Id = Model.Id }))";
                            window.location.reload(true);
                        }
                    }
                });
            }
        }

