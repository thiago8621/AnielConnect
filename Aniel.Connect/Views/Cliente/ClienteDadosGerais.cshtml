        function OptionsPlano(obj = [{}], hascontrato = false) {

            try {
                for (let property of obj) {

                    //property["element"] = HTMLOptionElement;
                    property["hasContrato"] = property.id != undefined ? true : false;

                }
                //Se tiver contrato
                if (hascontrato) { obj = obj.filter(p => p.hasContrato == true); }

                //Se não tiver contrato
                else {
                    obj.forEach(property, index => {
                        contador = 0;
                        if (property.id == null || property.id == undefined) {
                            //property.id = index;
                            property.id = contador++;
                        }
                    });
                    obj = obj.filter(p => p.hasContrato == false);
                }
            }
            catch (exception) { return []; }

            return obj;
        }

