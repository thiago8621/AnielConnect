        function CancelarContrato() {
            if (oDatatableContrato != null && oDatatableContrato.data().length > 0) {

                const dataTmp = oDatatableContrato.data().toArray();
                const verificaStatus = dataTmp.filter(x => x.status == "Aguardando aprovação da venda");

                if (verificaStatus.length > 0) {
                    Notificar("@RsBase.INFORMACAO", "Atenção!!! Não foi possível cancelar o Contrato, pois existe planos / produtos AGUARDANDO APROVAÇÃO DA VENDA.", "info");
                } else {
                Swal.fire({
                    title: "Deseja cancelar o contrato?",
                    text: "Não será possível retornar essa ação!",
                    type: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sim',
                    cancelButtonText: 'Não'
                }).then((result) => {
                    if (result.value) {
                            $('#iModal_Motivo_Cancelamento').modal({ backdrop: 'static', keyboard: false });

                        $("#btnMotivoCancelamento").click(function (e) {
                            e.preventDefault();

                            if (!ValidaObrigatoriosPorClasse("obrigatorioCancelar", false)) {
                                const idMotivoCancelamento = $("#iMotivo_Cancelamento").val();

                                const dataContrato = oDatatableContrato.data().toArray();
                                    const idsPlanoProdutoContrato = dataContrato.filter(x => x.status).map(p => p.id);


                                for (let idPlanoProduto of idsPlanoProdutoContrato) {
                                    AlterarStatusObj(5, idPlanoProduto, idMotivoCancelamento);
                                }

                                $("#iMotivo_Cancelamento").val(null).trigger("change");
                                $('#iModal_Motivo_Cancelamento').modal('hide');
                            }
                        })
                    }
                });
            }
            }
            else {
                Notificar("@RsBase.INFORMACAO", "É necessário selecionar um contrato", "info");
            }
        }

        function AlterarStatusObj(Status, idPlanoProduto, idMotivo_cancelamento = null) {

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/PlanoProdutoapi/AlterarStatus")';
            $("#divProgress").show();
            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    ids: [idPlanoProduto],
                    status: Status,
                    id_motivo_cancelamento: idMotivo_cancelamento,
                    observacao_motivo_suspensao: $("#iMotivo_Observacao_Suspensao_Plano_Cliente_Outros").val()
                }
            })
            .done(async function (data) {
                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");

                    await AddSelect("iPesquisaNumContrato", "@CONSTANTES.URLPortal/api/clienteapi/GetComboContratoCliente", @CONSTANTES.PaginacaoRegistros, null, @Model.Id, null, "@RsBase.SELECIONE", false, HandleCliente_Plano_Contrato);
                    $('#accordion_17').hide();

                    $("#numContrato").val(null);
                    $("#numContrato").text(null);
                    $("#iDesc_Plano").text(null);

                    $("#iCliPlanBloq").text(null);
                    $("#iVelocidadeReduzida").text(null);
                    $("#iTermoAdesão").text(null);
                    $("#iCarregaPlanosCancelados").prop('checked', false);

                    HandleDatatablePlanoContrato();
                } else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    $("#divProgress").hide();
                }
            });
        }
