        function ExibirContrato() {
            let idContrato = 0;
            let idPlanoProdutoExibir = 0;

            if (oDatatableContrato != null && oDatatableContrato.data().length > 0) {
                let tableContratoExibir = oDatatableContrato.rows().data();
                for (let i = 0; i < tableContratoExibir.length; i++)
                {
                    idContrato = tableContratoExibir[i].id_Modelo_Contrato;
                    idPlanoProdutoExibir = tableContratoExibir[i].id_Plano_Produto;
                }
            }
            else
            {
                Notificar("@RsBase.INFORMACAO", "É necessário selecionar um contrato", "info");
                return;
            }

            if (idContrato) {
                if (idPlanoProdutoExibir == 0) {
                    $.ajax({
                        url: "@CONSTANTES.URLPortal/api/ClienteContratoApi/GetPdf?idContrato=" + idContrato,
                        type: "GET",
                        beforeSend: function () {
                            ShowPageLoading();
                        },
                        complete: function () {
                            HidePageLoading();
                        }
                    })
                    .done(function (data) {
                        if (data.ok) {
                            ShowDialog(true, true, data.objeto.descricao, data.objeto.urlArquivo, 'divModeloContrato', '80%', 850, 'iframeModeloContrato')
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", "O arquivo do contrato não foi encontrado", "warning")
                        }
                    })
                }
                else {
                    $.ajax({
                        url: "@CONSTANTES.URLPortal/api/Modelo_ContratoApi/GetPdfContrato?Id_Modelo_Contrato=" + idContrato,
                        type: "GET",
                        beforeSend: function () {
                            ShowPageLoading();
                        },
                        complete: function () {
                            HidePageLoading();
                        }
                    })
                    .done(function (data) {
                        if (data.ok) {
                            const urlContrato = `@CONSTANTES.URLPortal/Arquivos/Tmp/${data.objeto.nome_Pdf}`;
                            ShowDialog(true, true, data.objeto.descricao_Modelo_Contrato, urlContrato, 'divModeloContrato', '80%', 850, 'iframeModeloContrato')
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", "O arquivo do contrato não foi encontrado", "warning")
                        }
                    })
                }
            }
            else {
                Notificar("@RsBase.ATENCAO_", "O arquivo do contrato não foi encontrado", "warning")
            }
        }

