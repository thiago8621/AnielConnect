        function SuspenderContrato() {
            if (oDatatableContrato != null && oDatatableContrato.data().length > 0) {
                const dataTmp = oDatatableContrato.data().toArray();
                const verificaStatus = dataTmp.filter(x => x.status != "Habilitado");
                if (verificaStatus.length > 0) {
                    Notificar("@RsBase.ATENCAO_", "Para efetuar a suspensão, é necessário, que o CONTRATO, PLANO/PRODUTO, esteja, HABILITADO!!", "warning");
                    return false;
                } else {
                    Swal.fire({
                        title: "Deseja suspender Contrato?",
                        text: "Atenção! Todos os Planos/Produtos vinculados ao contrato também serão suspensos. Deseja Continuar?",
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Sim',
                        cancelButtonText: 'Não'
                    }).then((result) => {
                        if (result.value) {
                            $("#iMotivo_Observacao_Suspensao_Plano_Cliente_Outros").val("");
                            $('#iMotivo_Suspensao_Plano_Cliente_Outros').addClass('d-none');
                            $('#iModal_Motivo_Suspender_Plano_Cliente').modal({
                                backdrop: 'static',
                                keyboard: false
                            });
                            AddSelect("iMotivo_Suspensao_Plano_Cliente", "@CONSTANTES.URLPortal/api/Motivo_Suspensao_ContratualApi/GetCombo",  @CONSTANTES.PaginacaoRegistros, null, 3, null, "@RsBase.SELECIONE", false);
                            $("#btnMotivoSuspensaoPlano_Cliente").click(function (e) {
                                if (($("#iMotivo_Suspensao_Plano_Cliente").val() > 0) || ($("#iMotivo_Observacao_Suspensao_Plano_Cliente_Outros").val() != "" && $("#iMotivo_Suspensao_Plano_Cliente").val() == -1)) {
                                    var idMotivo_suspensao_contrato = $("#iMotivo_Suspensao_Plano_Cliente").val();

                                    $("#divProgress").show();
                                    var link = `@CONSTANTES.URLPortal/api/clienteContratoapi/AlterarStatusContrato`;
                                    var IdContrato = $("#iPesquisaNumContrato").val();
                                    $.ajax({
                                        url: link,
                                        type: 'POST',
                                        dataType: 'json',
                                        data: {
                                            id: IdContrato,
                                            status: 3,
                                            idMotivo_suspensao_contrato: $("#iMotivo_Suspensao_Plano_Cliente").val(),
                                            observacao_motivo_suspensao: $("#iMotivo_Observacao_Suspensao_Plano_Cliente_Outros").val()
                                        },
                                        success: function (data) {
                                            if (data.ok) {
                                                Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                                                //$("#divProgress").show();
                                                location.href = "@Html.Raw(Url.Action("ClienteDadosGerais", "Cliente", new { Id = Model.Id }))";
                                                window.location.reload(true);
                                            } else {
                                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                            }
                                            $('#iModal_Motivo_Suspender_Plano_Cliente').modal('hide');
                                        },
                                        error: function () {
                                            Notificar("@RsBase.ATENCAO_", ata.mensagem, "error");
                                            $("#divProgress").hide();
                                        }
                                    });
                                } else {
                                    Notificar("@RsBase.ATENCAO_", "Para efetuar a suspensão, é necessário, que selecione o motivo!!", "warning");
                                    return false;
                                }
                            });
                        }
                    });
                }
            } else {
                Notificar("@RsBase.INFORMACAO", "É necessário selecionar um contrato", "info");
            }
        }

