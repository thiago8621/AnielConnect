        function modalInfPlano(button) {
            var planoId = $(button).data('id');
            var idCliente = "@Model.Id";
            var planosCancelados = $("#iCarregaPlanosCancelados").is(":checked");
            //var IdModeloContrato = $('#iPesquisaNumContrato').val();
            var IdClienteContrato = idContratoCliente;
            contrato = $('#numContrato').val();

            var requestContratoDataTable = {
                Contrato: contrato,
                PlanosCancelados: planosCancelados,
                IdClienteContrato: IdClienteContrato,
                //IdModeloContrato: IdModeloContrato,
                IdCliente: idCliente,
                IdPlanoProduto: planoId
            };

            if (oDatatableContrato != null && planoId) {
                $.ajax({
                    url: baseUrl + '/api/clienteapi/FindByPlanoByContrato',
                    type: 'POST',
                    data: JSON.stringify(requestContratoDataTable),
                    contentType: 'application/json; charset=utf-8',
                    beforeSend: function () {
                        $("#divProgress").show();
                    },
                    complete: function () {
                        $("#divProgress").hide();
                    },
                    success: function (response) {
                        if (response.data && response.data.length > 0) {
                            var plano = response.data[0];

                            // Preenche as informações no modal com os dados do plano obtido da API
                            $("#iAutenticacaoRadius").text(plano.autenticacao_Radius);
                            $("#iDetalhesOLT").text(plano.descricao_OLT);
                            $("#iDetalhesONU").text(plano.descricao_ONU);
                            $("#iDetalhesPON").text(plano.descricao_PON);
                            $("#iDetalhesLogin").text(plano.login_Radius);
                            $("#iDetalhesSenha").text(plano.senha_PPPOE);
                            $("#iDetalhesSlot").text(plano.descricao_PON);
                            $("#iSenhaCircuito").text(plano.senha_Circuito_Sip);
                            $("#iNumCircuitoSIP").text(plano.numero_Sip);
                            $("#iPlanoProdutosSpan").text(plano.descricao);
                            $("#iFranquiMin").text(plano.franquia_Minutos);
                            $("#iVelocidadeMB").text(plano.velocidade_Nominal);
                            $("#iFrequenciaCobranca").text(plano.frequencia_Cobranca);
                            $("#iFormatoCobranca").text(plano.formato_Cobranca);
                            $("#iDetalhes ").text(plano.detalhes_Plano);
                            $("#iDiasAtraso").text(plano.dias_Atraso);

                            $("#iBloqAutoDebito").text(plano.bloquei_Automatico_Debito == 1 ? "SIM" : "NÃO");
                            $("#iImpBloqAuto").text(plano.impedir_Bloqueio_Automatico == 1 ? "SIM" : "NÃO");
                            $("#iHavReducaoVelocidade").text(plano.reducao_Velocidade == 1 ? "SIM" : "NÃO");

                            if (plano.impedir_Bloqueio_Automatico == 1) {
                                $("#iSexta").prop('checked', plano.impedir_Bloqueio_Sexta == 1).addClass("readonly");
                                $("#iSabado").prop('checked', plano.impedir_Bloqueio_Sabado == 1).addClass("readonly");
                                $("#iDomingo").prop('checked', plano.impedir_Bloqueio_Domingo == 1).addClass("readonly");
                                $("#iFeriados").prop('checked', plano.impedir_Bloqueio_Feriados == 1).addClass("readonly");
                            } else {
                                $("#iSexta, #iSabado, #iDomingo, #iFeriados").addClass("readonly");
                            }

                            // Exibe o modal
                            $('#iModal_Informacoes_Plano').modal("show");
                        }
                        else {
                            console.log('Nenhum dado encontrado para o plano selecionado.');
                            Notificar("@RsBase.ATENCAO_", "Nenhum dado encontrado para o plano selecionado.", "warning");
                        }
                    },
                    error: function (error) {
                        console.log(error);
                        Notificar("@RsBase.ERRO", "Erro ao carregar os detalhes do plano.", "error");
                    }
                });
            } else {
                Notificar("@RsBase.INFORMACAO", "É necessário selecionar um plano", "info");
            }
        }

