        async function valorFinalPago(valores = detalhesPropostaInicial) {
            try {
                let percentDesconto = valores.calculoDescontoPercentual;
                let percentAcrescimo = valores.calculoAcrescimoPercentual;
                let valorDesconto = valores.calculoDesconto;
                let valorAcrescimo = valores.calculoAcrescimo;
                let subValorTotal = valores.subValorTotal;
                let valor_final_total = valores.valor_final_total;
                let calculoInstalacao = valores.calculoInstalacao;
                let valor_final_total_com_instalacao = valores.valor_final_total_com_instalacao;
                let valInstalacao = oDatatableContrato.data().toArray().map(p => { return p != NaN ? parseFloat(p.valor_Instalacao) : 0; }).filter(p => { return p; }).reduce((a, b) => a + b, 0);
                let valFinalPago = oDatatableContrato.data().toArray().map(p => { return p != NaN ? parseFloat(p.valor_Final) : 0; }).filter(p => { return p; }).reduce((a, b) => a + b, 0);
                let valPlanoProduto = 0;

                let valPlanoProdutoPercent = 0;
                let valAcresPlanoProdutoPercent = 0;

                //Desconto percentual
                if (percentDesconto > 0) {
                    valPlanoProdutoPercent = (valFinalPago * percentDesconto) / 100;
                }

                //Acrescimo percentual
                if (percentAcrescimo > 0) {
                    valAcresPlanoProdutoPercent = (valFinalPago * percentAcrescimo) / 100;
                }

                valPlanoProduto = valFinalPago - (valPlanoProdutoPercent + valAcresPlanoProdutoPercent);
                var valor_string = valPlanoProduto.toLocaleString('pt-br', { style: 'currency', currency: 'BRL' });

                $("#iDetalhesValorSubTotal").text((subValorTotal).toLocaleString('pt-br', { style: 'currency', currency: 'BRL' }));
                $("#iDetalhesValorAcrescimo").text((valorAcrescimo).toLocaleString('pt-br', { style: 'currency', currency: 'BRL' }));
                $("#iDetalhesValorDesconto").text((valorDesconto).toLocaleString('pt-br', { style: 'currency', currency: 'BRL' }));
                $("#iDetalhesValorSemInstalacao").text((valor_final_total).toLocaleString('pt-br', { style: 'currency', currency: 'BRL' }));
                $("#iDetalhesValorTotalInstalacao").text((calculoInstalacao).toLocaleString('pt-br', { style: 'currency', currency: 'BRL' }));
                $("#iDetalhesValorAcrescimo_Porcentagem").text(percentAcrescimo.toFixed(2).toLocaleString('pt-br', { style: 'percent', minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "%");
                $("#iDetalhesValorDesconto_Porcentagem").text(percentDesconto.toFixed(2).toLocaleString('pt-br', { style: 'percent', minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "%");
                $("#iDetalhesValorInstalacao").text((valor_final_total_com_instalacao).toLocaleString('pt-br', { style: 'currency', currency: 'BRL' }));
            } catch (error) {
                Notificar("@RsBase.ATENCAO_", error, "warning");
                }
        };


        const detalhesPropostaInicial = {
            get calculoAcrescimoPercentual() {
                if (oDatatableContrato.data().toArray().length > 0) {
                    var obj = oDatatable.data().toArray();
                    if (obj.length > 0) {
                        var valor_desconto = 0, valor_percentual = 0;
                        for (var i = 0; i < obj.length; i++) {
                            if (obj[i].Formato == 0) {
                                valor_desconto += parseFloat(obj[i].Valor_Desconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.'));
                                valor_percentual += parseFloat(obj[i].Percentual_Desconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.'));
                            }
                        }
                        var formato = obj.filter(x => x.Formato == 0);
                        var resultado_percentual = 0;
                        if (formato.length > 0) {
                            let valorAPagar = (this.subValorTotal);

                            valor_desconto = valor_desconto > 0 ? ((valor_desconto / valorAPagar) * 100) : 0;
                            resultado_percentual = valor_desconto > 0 ? valor_desconto + valor_percentual : valor_percentual;
                        } else {
                            resultado_percentual = 0.0;
            }
                        return resultado_percentual;
                    } else {
                        return 0.0;
                    }
                } else {
                    return 0.0;
                }
            },
            get calculoAcrescimo() {
                let valor_Pagar = (this.subValorTotal);
                let totalPagar = ((valor_Pagar * this.calculoAcrescimoPercentual) / 100);
                return totalPagar;
            },
            get calculoDescontoPercentual() {
                if (oDatatableContrato.data().toArray().length > 0) {
                    var obj = oDatatable.data().toArray();
                    if (obj.length > 0) {
                        var valor_desconto = 0;
                        var valor_percentual = 0;
                        for (var i = 0; i < obj.length; i++) {
                            if (obj[i].Formato == 1) {
                                valor_desconto += obj[i].Valor_Desconto != null && obj[i].Valor_Desconto != undefined && obj[i].Valor_Desconto != "" && obj[i].Valor_Desconto != "0" ?
                                    parseFloat(obj[i].Valor_Desconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.')) : "0";
                                valor_percentual += obj[i].Percentual_Desconto != null && obj[i].Percentual_Desconto != undefined && obj[i].Percentual_Desconto != "" && obj[i].Percentual_Desconto != "0" ?
                                    parseFloat(obj[i].Percentual_Desconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.')) : 0;
                            }
                        }

                        var formato = obj.filter(x => x.Formato == 1);
                        var resultado_percentual = 0;
                        if (formato.length > 0) {
                            let valorAPagar = (this.subValorTotal);
                            valor_desconto = valor_desconto > 0 ? ((valor_desconto / valorAPagar) * 100) : 0;
                            valor_percentual = valor_percentual > 0 ? valor_percentual : 0;

                            resultado_percentual = valor_desconto + valor_percentual;
                        } else {
                            resultado_percentual = 0;
                        }
                        return resultado_percentual;
                    } else {
                        return 0.0;
                    }
                } else {
                    return 0.0;
                }
            },
            get calculoDesconto() {
                let valorAPagar = (this.subValorTotal);
                let calcularDesconto = (valorAPagar * this.calculoDescontoPercentual) / 100;
                return calcularDesconto;
            },
            get calculoInstalacao() {
                if (oDatatableContrato.data().toArray().length > 0) {
                    return oDatatableContrato.data().toArray().map(p => parseFloat(p.valor_Instalacao)).reduce((b, c) => b + c)
                }
                else {
                    return 0.0;
                }
            },
            get subValorTotal() {
                if (oDatatableContrato.data().toArray().length > 0) {
                    return oDatatableContrato.data().toArray().map(p => parseFloat(p.valor_Final)).reduce((b, c) => b + c)
                }
                else {
                    return 0.0;
                }
            },
            get valor_final_total() {
                let valorPagar = (this.subValorTotal + this.calculoAcrescimo);
                return valorPagar - this.calculoDesconto;
            },
            get valor_final_total_com_instalacao() {
                let valorPagar = (this.calculoInstalacao + this.subValorTotal + this.calculoAcrescimo);
                return valorPagar - this.calculoDesconto;
            }
        };

