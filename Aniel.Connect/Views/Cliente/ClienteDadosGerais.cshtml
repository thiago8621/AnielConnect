        function geraAgrupamento(nomeColuna) {
            let placeholderDescricao = nomeColuna.split("_").join(" de ");
            let groupDescricao = "";

            let appender = {
                emptyDataGroup: `Valor da Coluna ${placeholderDescricao} inexistente`,
                dataSrc: [nomeColuna],
                startRender: function (rows, group, level) {
                    //Numero_Contrato
                    if (nomeColuna == "Numero_Contrato") {

                        if (group == "" || group == null) {

                            group = nomeColuna.includes("Contrato") ? "Contrato não gerado/a" : "Venda não gerado/a";

                        }
                    }

                    @{
                        //List<String> enumNames = Enum.GetNames(typeof(Status_Venda)).ToList();
                        //List<Object> enumValues = Enum.GetValues(typeof(Status_Venda)).Cast<Object>().ToList();
                        //var listagem = enumNames.Zip(enumValues, (name, value) => { return new KeyValuePair<String, Object>(name, value); }).ToList();
                        }

                    //Status_Venda
                    @*else if (nomeColuna == "Status_Venda")
                    {
                        let arrayStatusVenda = @Html.Raw(Json.Encode(listagem)),
                            results = arrayStatusVenda.filter(p => p.Value == group);

                        group = !results.length ? "Status não gerado/a" : results[0].Key;
                    }*@

                    groupDescricao = group.includes("não gerado/a") ? "Valor Inexistente" : group;

                    return $('<tr>').append(`<td class="text-left" colspan="12">${placeholderDescricao}: ${groupDescricao}</td>`);
                }
            };
            return appender;
        }

