                title: 'Link criado com sucesso',
                icon: 'success',
                html: `<div class="text-dark fundo-link-email p-4 border">${link}</div>`,
                reverseButtons: true,
                showCancelButton: true,
                focusConfirm: false,
                confirmButtonColor: '#031f4c',
                cancelButtonColor: '#43acf7',
                confirmButtonText: '<i class="mr-2 fas fa-envelope"></i> Enviar por E-mail',
                cancelButtonText: '<i class="mr-2 fas fa-copy"></i> Copiar link',
            }).then((result) => {
                if (result.isConfirmed) {
                    if ($("#iemail").val()) {
                        Notificar("@RsBase.ATENCAO_", "Enviando email, aguarde", "info");
                        $.ajax({
                            url: "@CONSTANTES.URLPortal" + "/api/clienteapi/EnviaEmailCadastroCartao",
                            method: "POST",
                            data: { emailCliente: emailCliente, link: link },
                        })
                            .done(function (result) {
                                if (result.ok) {
                                    Notificar("Sucesso", "E-mail enviado", "success");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", `${result.mensagem}`, "warning");
                                }
                            })
                            .fail(function () {
                                Notificar("@RsBase.ATENCAO_", "Erro ao enviar o email", "error");
                            });
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", "Cliente sem E-mail cadastrado no sistema!", "warning");
                    }
                }
                else if (result.dismiss === Swal.DismissReason.cancel) {
                    navigator.clipboard.writeText(link).then(function () {
                        Notificar("Sucesso", "Link copiado", "success");
                    }, function (err) {
                        console.error('erro ao copiar texto : ', err);
                    });
                }
            })

        }

