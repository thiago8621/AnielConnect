        //Datatable Forma Pagamento
        function handleExcluirFormaPagamento() {

            $("#btnExcluirFormaPagamento").unbind('click');
            $("#datatableFormaPagamento").on('click', '#btnExcluirFormaPagamento', function (e) {
                e.preventDefault();

                Swal.fire({
                    title: 'Deseja excluir Forma de Pagamento? ',
                    icon: 'question',
                    html: '<p>Não será possível retroceder a ação.</p>',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sim',
                    cancelButtonText: 'Não'
                }).then(async (result) => {
                    if (!result.value) {
                        return;
                    } else {
                        var idArquivo = $(this).attr("excluir");
                        var trLinkButton = $(this).parents('tr');

                        if (idArquivo == 0) {
                            oDatatableFormaPagamento.row(trLinkButton).remove().draw(false);

                            listaFormasPagamento = [];
                            listaFormasPagamento = oDatatableFormaPagamento.rows().data();

                            AtualizaSelectFormasPagamento();

                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Forma_Pagamento_Clienteapi/ExcluirGrid?value=")' + idArquivo + '&idVenda=';;

                            const retornoAPI = await $.ajax({
                                url: link,
                                type: 'GET',
                                dataType: 'json',
                            });

                            if (retornoAPI.ok) {
                                oDatatableFormaPagamento.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", retornoAPI.mensagem, "warning");
                            }
                        }

                    }
                });

            });
        }
