        function atualizarValorPlano() {
            if ($("#iValorPlanoComp").length) {
                const valor = $("#iValorPlanoComp").val();
                const retiraCifrao = valor.replace(/[^\d,.-]/g, "").replace(",", ".");
                valorPlanoGlobal = parseFloat(retiraCifrao);
            }
        }

        function rateioProduto(idRateiro) {
            var linhaTabela = [], qtdeRegistros = 0;

            linhaTabela = oDatatableAtividade.data().filter(x => x.id_Produtos_Comp == idRateiro).toArray();
            oDatatableAtividade.row.add({
                action:`<a href="#" class="btnExcluirAtividade" excluir="0"><i class="far fa-trash-alt"></i></a>`,
                id: linhaTabela[0].id,
                id_Produtos_Comp: linhaTabela[0].id_Produtos_Comp,
                descProduto: linhaTabela[0].descProduto,
                valorDiscriminado: linhaTabela[0].valorDiscriminado,
                percentualDiscriminado: linhaTabela[0].percentualDiscriminado,
                valorDiscriminadoNf: linhaTabela[0].valorDiscriminadoNf,

                id_Empresa: linhaTabela[0].id_Empresa,
                descEmpresa: linhaTabela[0].descEmpresa,
                id_Filial: linhaTabela[0].id_Filial,
                descFilial: linhaTabela[0].descFilial,
                idClassificacaoTributaria: linhaTabela[0].idClassificacaoTributaria,
                descClassificacaoTributaria: linhaTabela[0].descClassificacaoTributaria,
                modeloNotaFiscal: linhaTabela[0].modeloNotaFiscal,
                descModeloNotaFiscal: linhaTabela[0].descModeloNotaFiscal,
                planoId: linhaTabela[0].planoId
            }).draw(true);

            qtdeRegistros = oDatatableAtividade.data().filter(x => x.id_Produtos_Comp == idRateiro).toArray().length;

            oDatatableAtividade.rows().data().each(function (value, index) {
                if (value.id_Produtos_Comp == idRateiro) {
                var vlrDiscriminadoNf = 0, strVlrDiscriminadoNf = "", vlrPercentual = 0, strVlrPercentual = "", vlrComposicao = 0, strVlrComposicao = "";

                    vlrComposicao = value.valorDiscriminado.replace(",", ".") / qtdeRegistros;
                    strVlrComposicao = vlrComposicao.toFixed(2).replace(".", ",");
                value.valorDiscriminado = strVlrComposicao;

                    vlrDiscriminadoNf = value.valorDiscriminadoNf.replace(",", ".") / qtdeRegistros;
                    strVlrDiscriminadoNf = vlrDiscriminadoNf.toFixed(2).replace(".", ",");
                value.valorDiscriminadoNf = strVlrDiscriminadoNf;//formatarValor(strVlrDiscriminadoNf);

                strVlrPercentual = value.percentualDiscriminado.includes("%") ? value.percentualDiscriminado.replace("%", "") : value.percentualDiscriminado.toString();
                    vlrPercentual = strVlrPercentual.replace(",", ".") / qtdeRegistros;
                    strVlrPercentual = vlrPercentual.toFixed(2).replace(".", ",");
                value.percentualDiscriminado = strVlrPercentual;//formatarValor(strVlrPercentual);

                    oDatatableAtividade.row(index).data(value);
                }
            }).draw(true);
        }

        function vlrPercentualDiscriminado(idPercentual, vlrPercentualAlterado, idCampo) {
            var qtde100Porcento = 100 - parseFloat(vlrPercentualAlterado);
            var qtdeRegistros = oDatatableAtividade.data().filter(x => x.id_Produtos_Comp == idPercentual).toArray().length;

            var resultadoDistribuidoPorcentagem = qtdeRegistros > 2 ? (qtde100Porcento / (qtdeRegistros - 1)) : qtde100Porcento;
            oDatatableAtividade.rows().data().each(function (value, index) {
                if (value.id == idPercentual) {
                var vlrDiscriminadoNf = 0, strVlrDiscriminadoNf = "", vlrPercentual = 0, strVlrPercentual = "";
                if (idCampo === `configuracaoNF_${[index]}__percentualDiscriminado`) {
                    vlrDiscriminadoNf = (parseFloat(value.valorDiscriminado) * parseFloat(vlrPercentualAlterado)) / 100;
                    vlrPercentual = parseFloat(vlrPercentualAlterado);
                } else {
                    vlrDiscriminadoNf = (parseFloat(value.valorDiscriminado) * parseFloat(resultadoDistribuidoPorcentagem)) / 100;
                    vlrPercentual = parseFloat(resultadoDistribuidoPorcentagem);
                }

                strVlrDiscriminadoNf = vlrDiscriminadoNf.toFixed(2).toString().replace(".", ",");
                    value.valorDiscriminadoNf = strVlrDiscriminadoNf;//strVlrDiscriminadoNf.includes(",") ? formatarValor(strVlrDiscriminadoNf) : strVlrDiscriminadoNf;

                strVlrPercentual = vlrPercentual.toString().replace(".", ",");
                    value.percentualDiscriminado = strVlrPercentual;// strVlrPercentual.includes(",") ? formatarValor(strVlrPercentual) : strVlrPercentual;

                    oDatatableAtividade.row(index).data(value);
                }
            }).draw(true);
        }


        function formatarValor(value) {
            var index = value.indexOf(",");
            var strVlrPre = value.substring(0, index);
            var strVlrPos = value.substring(index + 1);

            strVlrPos = strVlrPos.padEnd(2, "0");

            return `${strVlrPre},${strVlrPos}`;
    }
        }


        async function AdicionarComposicaoNF() {


         //Validação adicionada para caso o usuário clique em "adicionar"
         // sem ter selecionado um contrato ou plano.
        if (oDatatableAtividade === null || oDatatableAtividade === undefined) {
            Notificar("Atenção!", "Nenhum Contrato/Plano com Produtos selecionado.", "warning");
            return false;
        }
        if (oDatatableComp === null || oDatatableComp === undefined) {
            Notificar("Atenção!", "Nenhum Contrato/Plano com Produtos selecionado.", "warning");
            return false;
            }

        let todosProdutos = oDatatableAtividade.rows().data().toArray();
        let todosProdutosComp = oDatatableComp.rows().data().toArray();
        let planoSelecionado = $("#iPlanoProdutos option:selected").text();
        let idPlano = $("#iPlanoProdutos option:selected").val();
        let contratoSelecionado = $("#iContratoSelect option:selected").text();
        let idContrato = $("#iContratoSelect option:selected").val();
        let valorFinalTotal = $("#iValorPlanoFinalTotal").val();

        // Validação adicional para Contrato e Plano
        if (!idContrato || !idPlano || idContrato === "" || idPlano === "") {
            Notificar("Atenção!", "Nenhum Contrato/Plano com Produtos selecionado.", "warning");
            return false;
        }

        if (todosProdutos.length === 0 || todosProdutos === null ||
            todosProdutos.length === undefined)
        {
            Notificar("Atenção!", `Não existe composição fiscal para o Contrato/Plano Produtos selecionado.`, "warning");
            return false;
        }

        //Validação criada para impedir que valor da composição
        //seja maior que o valor do plano
        let valorTotalComposicao = 0;

        $(".valorComposicao").each(function () {
            let getValorComposicao = parseFloat($(this).val().replace(",", "."));
            if (!isNaN(getValorComposicao)) {
                valorTotalComposicao += getValorComposicao;
            }
        });


    if (valorTotalComposicao > valorPlanoGlobal) {
        Notificar("@RsBase.ATENCAO_", `Total da composição da nota fiscal do plano <strong class=text-primary> R$ ${valorTotalComposicao} </strong><br> deve ser igual ao valor do plano <strong class=text-danger> R$ ${valorPlanoGlobal} </strong>.`, "warning")
        return false;
    }

        for (let prod of todosProdutos) {

            var idProdComp = prod.id_Produtos_Comp;
            var idNumModelo = prod.modeloNotaFiscal;

            let jaAdicionado = todosProdutosComp.find(a =>
                a.IdPlano == idPlano &&
                (a.IdContrato == `${idContrato}` || a.IdContrato == idContrato) &&
                a.IdProdutoComp == idProdComp &&
                a.ModeloNotaNum === idNumModelo
            );

            if (jaAdicionado)
            {
                Notificar("Atenção!", `Produto já adicionado ${prod.descProduto}`, "warning");
                continue;
            }

            oDatatableComp.row.add({
                Id: 0,
                DescricaoContrato: contratoSelecionado ?? "",
                DescricaoPlano: planoSelecionado ?? "",
                DescricaoProdutoComp: prod.descProduto ?? "",
                Valor: prod.valorDiscriminado ?? "",
                ValorFinalTotal: valorFinalTotal ?? "",
                PercentualRateio: prod.percentualDiscriminado ?? "",
                ValorDiscriminadoNf: prod.valorDiscriminadoNf ?? "",
                ModeloNota: prod.descModeloNotaFiscal ?? "",
                DescricaoClassificacao: prod.descClassificacaoTributaria ?? "",
                DescricaoEmpresa: prod.descEmpresa ?? "",
                DescricaoFilial: prod.descFilial ?? "",
                IdProdutoComp: prod.id_Produtos_Comp ?? null,
                IdPlano: idPlano ?? null,
                IdContrato: idContrato ?? null,
                ModeloNotaNum: prod.modeloNotaFiscal ?? null,
                IdEmpresa: prod.id_Empresa ?? null,
                IdFilial: prod.id_Filial ?? null,
                IdConfigTributaria: prod.idClassificacaoTributaria ?? null,
            }).draw(false);




            $("#iContratoSelect").val(null);
            $("#iPlanoProdutos").text("");
            $("#iPlanoProdutos").val(null);
            $("#iContratoSelect").text("");
            $("#divIdDescricaoPlanoComp").empty();
            CarregarGridAtividades();



            }

    }


    function handleExcluirComp() {
        $(".btnExcluirComp").off("click").on("click", function (e) {

            e.preventDefault();

            var idAtividade = $(this).attr("excluirr");
            var trLinkButton = $(this).parents('tr');
            var $row = $(this).closest('tr');
                var rowData = $('#datatableComp').DataTable().row($row).data();
                $("#divIdDescricaoPlanoComp").empty();


                if (idAtividade === "0") {
                    oDatatableComp.row(trLinkButton).remove().draw(false);
                    const novaLista = oDatatableComp.rows().data().toArray();
                    atualizarTabelaComposicao(novaLista);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");

                }
                else {

                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/PlanoProdutoApi/ExcluirConfigNF?value=")' + rowData.Id;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',

                    })
                    .done(function (data) {

                        if (data.ok) {
                            oDatatableComp.row(trLinkButton).remove().draw(false);
                            const novaLista = oDatatableComp.rows().data().toArray();
                            atualizarTabelaComposicao(novaLista);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {

                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    })
                    .fail(function (e) {

                        Notificar("@RsBase.ATENCAO_", e.responseJSON.message, "warning");
                    })
                }
            });
        }

        function atualizarTabelaComposicao(dados) {
            oDatatableComp.clear();
            oDatatableComp.rows.add(dados);
            oDatatableComp.draw(false);
        }


    </script>

    <script>

        var tipoReajuste;

        function modalInfContrato()
        {
            if (oDatatableContrato != null && oDatatableContrato.data().length > 0) {
                let tableContrato = oDatatableContrato.rows().data();
                for (let i = 0; i < tableContrato.length; i++)
                {

                    $("#iTemFidelidade").text(tableContrato[i].tem_Carencia);
                    $("#iPeriodoFidelidade").text(tableContrato[i].periodo_Carencia);
                    $("#iMultaFidelidade").text(tableContrato[i].multa_Carencia);
                    $("#iRenCarAuto").text(tableContrato[i].renova_Carencia_Automaticamente);
                    $("#iTemReajuste").text(tableContrato[i].tem_Reajuste);
                    $("#iFrequenciaReajuste").text(tableContrato[i].frequencia_Reajuste);
                    $("#iDiasTesteGratis").text(tableContrato[i].diasTeste);
                    $("#iCanContratoAutoFinalCarencia").text(tableContrato[i].cancela_Contrato_Automaico_Final_Carencia);
                    $("#iEncerraFidelidade").text(tableContrato[i].encerra_Carencia);
                    $("#iDescCombo").text();

                    tipoReajuste = tableContrato[i].tipo_Reajuste;
                    if (tableContrato[i].tipo_Reajuste == "Percentual") {
                        $("#iValorReajuste").val(tableContrato[i].percentual_Reajuste);
                        $("#iLabelReajuste").text("Percentual do reajuste: (%)");
                    } else {
                        $("#iValorReajuste").val(tableContrato[i].valor_Reajuste);
                        $("#iLabelReajuste").text("Valor do reajuste: (R$)");
                    }

                    $("#iDataAceite").text(tableContrato[i].data_Aceite);
                    $("#idesblqueio_conf").prop("checked", tableContrato[i].desbloqueio_Conf);
                    $("#iQuantidadeDiasBloqueio").val(tableContrato[i].quantidadeDiasBloqueio);
                    $("#iFrequenciaDesbloqueio").val(tableContrato[i].frequencia_Desbloqueio);
                    $("#iBloquearNumeroDias").val(tableContrato[i].bloquearNumeroDias);
                    $("#iBloquearAtrasarRenegociadas").val(tableContrato[i].bloquearAtrasarRenegociadas);
                    $("#iMaximoTitulosAberto").val(tableContrato[i].maximoTitulosAberto);
                    $("#ImpedirBloqueio_Automatico").prop("checked", tableContrato[i].impedirBloqueio_Automatico);
                    $("#ImpedirBloqueio_Automaticosegunda").prop("checked", tableContrato[i].impedirBloqueio_Segunda);
                    $("#ImpedirBloqueio_Automaticoterca").prop("checked", tableContrato[i].impedirBloqueio_Terca);
                    $("#ImpedirBloqueio_Automaticoquarta").prop("checked", tableContrato[i].impedirBloqueio_Quarta);
                    $("#ImpedirBloqueio_Automaticoquinta").prop("checked", tableContrato[i].impedirBloqueio_Quinta);
                    $("#ImpedirBloqueio_Automaticosexta").prop("checked", tableContrato[i].impedirBloqueio_Sexta);
                    $("#ImpedirBloqueio_Automaticosabado").prop("checked", tableContrato[i].impedirBloqueio_Sabado);
                    $("#ImpedirBloqueio_Automaticodomingo").prop("checked", tableContrato[i].impedirBloqueio_Domingo);
                    $("#ImpedirBloqueio_Automaticoferiado").prop("checked", tableContrato[i].impedirBloqueio_Feriados);
                };

                $("#ImpedirBloqueio_Automatico").trigger("change");
                $("#idesblqueio_conf").trigger("change");
                $("#iBloqueioAutomaticoDebito").trigger("change");

                $('#iModal_Informacoes_Contrato').modal("show")
            }
            else
            {
                Notificar("@RsBase.INFORMACAO", "É necessário selecionar um contrato", "info");
            }

        };

        function SalvarInfContrato() {
            const dados = {
                IdContrato: $("#iPesquisaNumContrato").val(),
                ValorReajuste: $("#iValorReajuste").val(),
                TipoReajuste: tipoReajuste,
                PermiteDesbloqueio: $("#idesblqueio_conf").is(':checked'),
                QuantidadeDiasBloqueio: $("#iQuantidadeDiasBloqueio").val(),
                FrequenciaDesbloqueio: $("#iFrequenciaDesbloqueio").val(),
                BloqueioAutomaticoDebito: $("#iBloqueioAutomaticoDebito").is(':checked'),
                BloqueioDiasAtrasar: $("#iBloquearNumeroDias").val(),
                BloqueioDiasAtrasarRenegociadas: $("#iBloquearAtrasarRenegociadas").val(),
                MaximoTitulosAbertos: $("#iMaximoTitulosAberto").val(),
                ImpedirBloqueioAutomatico: $("#ImpedirBloqueio_Automatico").is(':checked'),
                ImpedirBloqueioAutomaticoDomingo: $("#ImpedirBloqueio_Automaticodomingo").is(':checked'),
                ImpedirBloqueioAutomaticoSegunda: $("#ImpedirBloqueio_Automaticosegunda").is(':checked'),
                ImpedirBloqueioAutomaticoTerca: $("#ImpedirBloqueio_Automaticoterca").is(':checked'),
                ImpedirBloqueioAutomaticoQuarta: $("#ImpedirBloqueio_Automaticoquarta").is(':checked'),
                ImpedirBloqueioAutomaticoQuinta: $("#ImpedirBloqueio_Automaticoquinta").is(':checked'),
                ImpedirBloqueioAutomaticoSexta: $("#ImpedirBloqueio_Automaticosexta").is(':checked'),
                ImpedirBloqueioAutomaticoSabado: $("#ImpedirBloqueio_Automaticosabado").is(':checked'),
                ImpedirBloqueioAutomaticoFeriados: $("#ImpedirBloqueio_Automaticoferiado").is(':checked'),
            };

            ShowPageLoading();

            fetch('@String.Concat(CONSTANTES.URLPortal, "/api/clienteapi/AtualizarInformacoesContrato")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(dados)
            })
                .then(response => {
                    HidePageLoading();
                    if (!response.ok) throw new Error('Erro ao enviar');
                    return response.json();
                })
                .then(data => {
                    Notificar("Sucesso", "Dados do contrato salvos", "success");
                    $('#iModal_Informacoes_Contrato').modal('hide');
                })
                .catch(error => {
                    Notificar("Erro", error, "warning");
                });

        }

    </script>

    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

