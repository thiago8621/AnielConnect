        function handleExcluir() {

                $(".btnExcluirDesconto").unbind('click');
                $(".btnExcluirDesconto").click(function (e) {

                    e.preventDefault();

                    // Calculando o Valor Sem Descontos

                    /*
                     * Soma do valor dos descontos percentuais.
                     *
                     * OBS.: A porcentagem de desconto é aplicada sempre ao valor
                     *       total antes de aplicar os descontos
                     */

                    var valorDescontoPercentual = 0
                    var valorTotalNew = floatValorComDesconto

                    var rows_desconto = oDatatable.rows().data()
                    var descontoExcluido = oDatatable.row($(this).parents("tr")).data()

                    var pctDesconto = null;

                    $.each(rows_desconto, function (index, value) {

                        if (rows_desconto[index].Id_Desconto == descontoExcluido.Id_Desconto) {

                            if (rows_desconto[index].Valor_Desconto == "-" || !rows_desconto[index].Valor_Desconto) {

                                pctDesconto = stringParaFloat(rows_desconto[index].Percentual_Desconto);
                                valorDescontoPercentual += valorTotalInicial * (pctDesconto / 100)
                            }
                            else {

                                valorTotalNew += stringParaFloat(rows_desconto[index].Valor_Desconto)
                            }
                        }
                    })

                    valorTotalNew += valorDescontoPercentual;
                    floatValorComDesconto = valorTotalNew;
                    $("#iValorFinalComDesconto").val(floatParaString(valorTotalNew))

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatable.row(trLinkButton).remove().draw(false);
                        if (!temMeioCaptacaoComDesconto) {
                            if (e.isTrigger == undefined) {
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                        }
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Descontoapi/ExcluirGrid?value=")' + idArquivo;

                        $.ajax({

                            url: link,
                            type: 'GET',
                            dataType: 'json'
                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatable.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");

                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }


                });
            }

        handleExcluir();

        //Validação do Desconto a adicionar

        $("#btnAdicionarDesconto").unbind('click');
        $("#btnAdicionarDesconto").on('click', function () {

                var erro = false;
                if (Num_Cont_Sel == null)
                {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CONTRATO)", "warning");
                    erro = true;
                }

                if (!$("#iDesconto").val() && !temMeioCaptacaoComDesconto)
                {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DESCONTO)", "warning");
                    erro = true;
                }

                var rows_desconto = oDatatable.rows().data();

                let id_contrato = Num_Cont_Sel.contrato;
                let valor_total_plano_contrato = oDatatableContrato.rows().data().toArray().map(p => p.valor_Final).reduce((b, c) => b + c, 0);

                let percentual_total_descontos = rows_desconto.filter(x => x.Numero_ContratoVinculado == id_contrato).map(p => parseFloat(p.Percentual_Desconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.'))).reduce((b, c) => b + c, 0);
                let valor_total_descontos = rows_desconto.filter(x => x.Numero_ContratoVinculado == id_contrato).map(p => parseFloat(p.Valor_Desconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.'))).reduce((b, c) => b + c, 0);

                let percentual_objeto = DescontoSelecionado.percentual_Desconto != null ? parseFloat(DescontoSelecionado.percentual_Desconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.')) : 0;
                let valor_objeto = DescontoSelecionado.valor_Desconto != null ? parseFloat(DescontoSelecionado.valor_Desconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.')) : 0;

                percentual_total_descontos = percentual_total_descontos > 0 ? percentual_total_descontos : 0;
                valor_total_descontos = valor_total_descontos > 0 ? valor_total_descontos : 0;

                percentual_total_descontos += percentual_objeto;
                valor_total_descontos += valor_objeto;

                let valor_percentual = 0, valor_desconto = 0;
                valor_percentual = (valor_total_plano_contrato * percentual_total_descontos) / 100;
                valor_desconto = valor_total_descontos;

                let soma_total_descontos = valor_percentual + valor_desconto;
                if (soma_total_descontos > valor_total_plano_contrato) {
                    Notificar("@RsBase.ATENCAO_", "@RsCadastros.DESCONTO_MAIOR_QUE_VALOR", "warning");
                    return false;
                }

                if (temMeioCaptacaoComDesconto && descontoCaptacaoAnterior != null) {
                    $('#btnExcluirDesconto_' + descontoCaptacaoAnterior).click();
                    descontoCaptacaoAnterior = null;
                }

                for (var i = 0; i < rows_desconto.length; i++) {
                    let DescontosDiferentes = @Json.Encode(ViewBag.Descontos_Tipo_Diferente);
                    let Acumula_DescontosMT = @Json.Encode(ViewBag.Acumula_Descontos_Mesmo_Tipo);

                    if (!DescontosDiferentes) {

                        if ((!Acumula_DescontosMT) && (!DescontosDiferentes)) {

                            if (rows_desconto[i].Id_Desconto == $("#iDesconto option:selected").val()) {

                                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.DESCONTO)", "warning");
                                erro = true;

                                return false;
                            }
                            else {

                                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.SOMENTE_UM_DESCONTO_VIEW)", "warning");
                                erro = true;

                                return false;
                            }
                        }
                        else if (rows_desconto[i].Tipo_Desconto != DescontoSelecionado.tipo_Desconto) {

                            if (rows_desconto[i].Id_Desconto == $("#iDesconto option:selected").val()) {

                                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.DESCONTO)", "warning");
                                erro = true;

                                return false;
                            }
                            else {

                                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.TIPO_DESCONTO_DIFERENTE_VIEW)", "warning");
                                erro = true;

                                return false;
                            }
