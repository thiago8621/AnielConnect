@model Aniel.Connect.Repository.Model.PlanoProdutoListModel
@{
    ViewBag.Title = "DetalhesPlanoProduto";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section scripts
{
    <script>

        @*$(document).ready(function () {
            @if (Model.Meses_Carencia == 0 || Model.Meses_Carencia == null)
            {
                <text>
                    $('#iConsultaMeses_Carencia').text('0');
                </text>
            }
        });*@

        var clicked = false;
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;
            ShowPageLoading();

            $('#form').submit();

            try {
                parent.dial.dialog('close');
            }
            catch (ex) {
                console.log(ex);
            }
        }

    </script>
}

    @using (Html.BeginForm("AlterarDetalhesPlanoProduto", "Cliente", FormMethod.Post, htmlAttributes: new { @id = "form", @autocomplete = "off" }))
    {
        @Html.HiddenFor(p => p.Id)
        <div class="container-fluid">
            <hr />
            <h4 class="text-muted" style="font-size:15px">@RsCadastros.PLANO_PRODUTO</h4>
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="iConsultaValor_Final">@RsCadastros.VALOR_FINAL:</label>
                        @Html.TextBoxFor(m => m.ValorPlanoProduto_Final, new { @class = "form-control" })
                    </div>
                </div>

                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="iConsultaCheckTesteGratis">@RsCadastros.TESTE_GRATIS:</label>
                        @Html.TextBoxFor(m => m.Qtde_Dias, new { @class = "form-control", @type = "number" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label>@RsCadastros.VALOR_INSTALACAO_FINAL:</label>
                        @Html.TextBoxFor(m => m.ValorInstalacao_Final, new { @class = "form-control" })
                    </div>
                </div>

                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="iConsultaCheckPeriodoCarencia">@RsCadastros.PERIODO_CARENCIA:</label>
                        @Html.TextBoxFor(m => m.Meses_Carencia, new { @class = "form-control", @type = "number" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="iConsultaNumero_Parcelas_Instalacao">@RsCadastros.NUMERO_PARCELAS_INSTALACAO:</label>
                        @Html.TextBoxFor(m => m.Numero_Parcelas, new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="form-group text-center col-sm-12" style="padding: 15px;" id="teste3">
                <div class="form-group">
                    <button type="button" onclick="parent.dial.dialog('close'); return false;" class="btn btn-danger" id="iLimparFiltroModal" data-dismiss="modal">Cancelar</button>
                    <button type="button" onclick="ValidaSubmit();" class="btn btn-success" id="iPesquisar">Salvar</button>
                </div>
            </div>
        </div>
    }