                                            @Html.CheckBoxFor(model => model.Utiliza_AgrupamentoDistancia, new { @class = "form-control", @id = "iUtiliza_AgrupamentoDistancia", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
