                                            @Html.CheckBoxFor(model => model.Exige_Agendamento_Servico, new { @class = "form-control", @id = "iExige_Agendamento_Servico", @name = "iExige_Agendamento_Servico", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
