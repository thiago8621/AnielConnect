                                                @Html.CheckBoxFor(model => model.Criterio_SLA_Execucao, new { @class = "form-control", @id = "iCriterio_SLAHora" })
                                                <label for="iCriterio_SLA" class="pl-1 pr-1">Considerar SLA por data e hora</label>
                                            </div>
                                        </div>
