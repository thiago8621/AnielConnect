                                        @Html.CheckBoxFor(model => model.Exige_Avaliacao_Comercial, new { @class = "form-control", @id = "iExige_Avaliacao_Comercial", @name = "iExige_Avaliacao_Comercial", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iExige_Termo_Adesao" class="mr-3">@RsCadastros.EXIGE_TERMO_ADESAO</label><br>
                                        @Html.CheckBoxFor(model => model.Exige_Termo_Adesao, new { @class = "form-control", @id = "iExige_Termo_Adesao", @name = "iExige_Termo_Adesao", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iOfertar_Plano_Produto_Cobertura" class="mr-3">@RsCadastros.OFERTAR_PLANO_PRODUTO_COBERTURA</label><br>
                                        @Html.CheckBoxFor(model => model.Ofertar_Plano_Produto_Cobertura, new { @class = "form-control", @id = "iOfertar_Plano_Produto_Cobertura", @name = "iOfertar_Plano_Produto_Cobertura", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iUtilizar_Cadastro_Endereco" class="mr-3">@RsCadastros.UTILIZA_CADASTRO_ENDERECO ?</label><br>
                                        @Html.CheckBoxFor(model => model.Utiliza_Cadastro_Endereco, new { @class = "form-control", @id = "iUtiliza_Cadastro_Endereco", @name = "iUtiliza_Cadastro_Endereco", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iAtribuir_Tempo_Limite_Venda" class="mr-3">@RsCadastros.ATRIBUIR_TEMPO_LIMITE_VENDA ?</label><br>
                                        @Html.CheckBoxFor(model => model.Atribuir_Tempo_Limite_Venda, new { @class = "form-control", @id = "iAtribuir_Tempo_Limite_Venda", @name = "iAtribuir_Tempo_Limite_Venda", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>
                           <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iReservaPortaAutomatica" class="mr-3">@RsCadastros.RESERVA_PORTA_AUTOMATICA ?</label><br>
                                        @Html.CheckBoxFor(model => model.Reserva_Porta_Automatica, new { @class = "form-control", @id = "iReservaPortaAutomatica", @name = "iReservaPortaAutomatica", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>
                            <div class="row d-none" id="iDivQtde_Meses_Visualizacao_Venda">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iQtde_Meses_Visualizacao_Venda" class="mr-3">@RsCadastros.QTDE_MESES_VISUALIZACAO_VENDA</label><br>
                                        @Html.TextBoxFor(model => model.Qtde_Meses_Visualizacao_Venda, new { @maxlength = "2", @class = "form-control col-sm-5", @id = "Qtde_Meses_Visualizacao_Venda", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Qtde_Meses_Visualizacao_Venda, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row d-none" id="iDivQtde_Dias_Avaliacao_Comercial">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iQtde_Dias_Avaliacao_Comercial" class="mr-3">@RsCadastros.QTDE_DIAS_AVALIACAO_COMERCIAL</label><br>
                                        @Html.TextBoxFor(model => model.Qtde_Dias_Avaliacao_Comercial, new { @maxlength = "2", @class = "form-control col-sm-5", @id = "Qtde_Dias_Avaliacao_Comercial", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Qtde_Dias_Avaliacao_Comercial, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iDia_Mes_Finaliza_Medicao_Comissao" class="mr-3">@RsCadastros.DIA_MES_FINALIZA_MEDICAO_COMISSAO</label><br>
                                        @Html.TextBoxFor(model => model.Dia_Mes_Finaliza_Medicao_Comissao, new { @maxlength = "2", @class = "form-control col-sm-5", @id = "iDia_Mes_Finaliza_Medicao_Comissao", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Dia_Mes_Finaliza_Medicao_Comissao, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iMax_Dias_Sem_Contato" class="mr-3">@RsCadastros.MAX_DIAS_SEM_CONTATO</label><br>
                                        @Html.TextBoxFor(model => model.Max_Dias_Sem_Contato, new { @class = "form-control col-sm-5", @id = "iMax_Dias_Sem_Contato", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Max_Dias_Sem_Contato, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">
                                    <label for="iDistancia_Elemento" class="mr-3">@RsCadastros.DISTANCIA_EXIBICAO_CAIXA_PORTA_DISPONIVEL</label><br>
                                    @Html.TextBoxFor(model => model.Distancia_Exibicao_Elemento, new { id = "iDistancia_Elemento", @type = "number", @class = "form-control col-sm-5", @placeholder = "x", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Distancia_Exibicao_Elemento, "", new { @class = "text-danger" })

                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">
                                    <label for="iDisponibilidade" class="mr-3">@RsCadastros.EXIBIR_CAIXA_PORTA_DISPONIVEL</label><br>
                                    @Html.TextBoxFor(model => model.Disponibilidade, new { id = "iDisponibilidade", @type = "number", @class = "form-control col-sm-5", @placeholder = "x", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Disponibilidade, "", new { @class = "text-danger" })

                                </div>
                            </div>

                            <div class="row mt-2">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iUsa_Dias_Liberacao_Did" class="mr-3">
                                            Definir Qtd. de dias de Quarentena para DID’s desassociado?
                                        </label><i class="fas fa-question-circle fa-2x" style="color: #2092EC" data-toggle="popover" title="Configuração Dias de Liberação" data-content="Defina a quantidade de dias que os DID’s
removidos de um plano cancelado poderá ser liberado para venda novamente"></i>
                                        <br>
                                        @Html.CheckBoxFor(model => model.Usa_Dias_Liberacao_Did, new { @class = "form-control", @id = "iUsa_Dias_Liberacao_Did", @name = "iUsa_Dias_Liberacao_Did", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>

                                <div class="col-sm-6" id="iDivDias_Liberacao_Did" style="display:none">
                                    <label for="iDias_Liberacao_Did" class="mr-3">Defina a quantidade de dias</label><br>
                                    @Html.TextBoxFor(model => model.Dias_Liberacao_Did, new { id = "iDias_Liberacao_Did", @type = "number", @class = "form-control col-sm-5", @placeholder = "", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Disponibilidade, "", new { @class = "text-danger" })

                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <!--Configurações Para Integrações-->
                <div class="card mt-3 mb-3" style="border:none;">
                    <div class="accordion div-card-accord" id="accordion_2">
                        <div class="card-header title-card" id="heading_2">
                            <h5 class="mb-0">
                                <a role="button" data-toggle="collapse" data-target="#collapse_2" aria-expanded="true" aria-controls="collapse_2">
                                    <span class="text-bold-card">@RsCadastros.CONFIGURACAO_INTEGRACAO</span>
                                </a>
                            </h5>
                        </div>
                        <div id="collapse_2" style="margin-top: -20px;" class="collapse show" aria-labelledby="heading_2" data-parent="#accordion_2">
                            <div class="card-body">
                                @if (User.Identity.GetUserId().ToUpper() == "ADMIN")
                                {
                                    <div class="row">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iToken_Widepay" class="mr-3">@RsCadastros.USUARIO_APPANIEL:</label><br>
                                                @Html.TextBoxFor(model => model.Usuario_APIANIEL, new { @class = "form-control", @id = "iUsuario_APIANIEL", @autocomplete = "off" })
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iToken_Widepay" class="mr-3">@RsCadastros.SENHA_APPANIEL:</label><br>
                                                @Html.PasswordFor(model => model.Senha_APIANIEL, new { @class = "form-control", @id = "iSenha_APIANIEL", @autocomplete = "off" })
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iToken_Widepay" class="mr-3">@RsCadastros.TOKEN_APPANIEL:</label><br>
                                                @Html.TextBoxFor(model => model.Token_APIANIEL, new { @class = "form-control", @id = "iToken_APIANIEL", @autocomplete = "off" })
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iUtilizar_Integracao_Externa" class="mr-3">Utiliza Integração Externa</label><br>
                                            @Html.CheckBoxFor(model => model.Utilizar_Integracao_Externa, new { @class = "form-control", @id = "iUtilizar_Integracao_Externa", @name = "iUtilizar_Integracao_Externa", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })

                                        </div>
                                    </div>

                                </div>

                                <div id="iIntegracaoExterna">
                                    <div class="row">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iIntegracaoExterna">Integração Externa</label>
                                                @Html.EnumDropDownListFor(m => m.IntegracaoExterna, RsBase.SELECIONE, new { @class = "form-control", @id = "iIntegracaoExterna", @autocomplete = "off" })
