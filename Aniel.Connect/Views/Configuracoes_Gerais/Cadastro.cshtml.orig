                                                @Html.CheckBoxFor(model => model.Criterio_Habilidade, new { @class = "form-control", @id = "iCriterio_Habilidade" })
                                                <label for="iCriterio_Habilidade" class="pl-1 pr-1">@RsCadastros.HABILIDADES_SKILS</label>
