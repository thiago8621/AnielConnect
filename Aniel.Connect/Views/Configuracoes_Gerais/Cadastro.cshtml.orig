                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iOLA_Cor_Assests">@RsCadastros.OLA_COR_ASSESTS:</label>
                                            @Html.TextBoxFor(model => model.OLA_Cor_Assests, new { @type = "color", @class = "form-control", @id = "iOLA_Cor_Assests", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.OLA_Cor_Assests, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iOLA_Cor_Fonte">@RsCadastros.OLA_COR_FONTE:</label>
                                            @Html.TextBoxFor(model => model.OLA_Cor_Fonte, new { @type = "color", @class = "form-control", @id = "iOLA_Cor_Fonte", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.OLA_Cor_Fonte, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iOLA_Cor_Principal">@RsCadastros.OLA_COR_PRINCIPAL:</label>
                                            @Html.TextBoxFor(model => model.OLA_Cor_Principal, new { @type = "color", @class = "form-control", @id = "iOLA_Cor_Principal", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.OLA_Cor_Principal, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iOLA_Cor_Principal_Dark">@RsCadastros.OLA_COR_PRINCIPAL_DARK:</label>
                                            @Html.TextBoxFor(model => model.OLA_Cor_Principal_Dark, new { @type = "color", @class = "form-control", @id = "iOLA_Cor_Principal_Dark", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.OLA_Cor_Principal_Dark, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-4">
                                    <div class="col-sm-8">
                                        <div class="form-group">
                                            <label for="iOLA_URL_Logo">@RsCadastros.OLA_URL_LOGO:</label>
                                            @Html.TextBoxFor(model => model.OLA_URL_Logo, new { @class = "form-control", @id = "iOLA_URL_Logo", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.OLA_URL_Logo, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <hr>
                                <div class="row mt-2">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label for="iSistema">@RsCadastros.SISTEMA:</label>
                                            @Html.EnumDropDownListFor(m => m.Sistema, RsBase.SELECIONE, new { @class = "form-control", @id = "iSistema", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.Sistema, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group">
                                            <label for="iURL">@RsCadastros.URL:</label>
                                            @Html.TextBoxFor(model => model.URL, new { @class = "form-control", @id = "iURL", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.URL, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="mt-3">
                                            <input type="button" id="btnAdicionar" value="Adicionar" class="btn btn-success" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <!--URL Sistema-->
                                    <div id="accordion" class="col-sm-12 mt-3">
                                        <div class="card div-card-accord">
                                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                                <div class="card-body">
                                                    <table class="table table-hover nowrap" id="datatable" style="width:100%">
                                                        <thead class="tb-head"></thead>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>

    <!--Button Float-->
    <a href="@Url.Action("Index", "Configuracao")" class="float-cancel">
        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
            <i class="fas fa-times fa-2x"></i>
        </div>
    </a>
    <a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
            <i class="fas fa-save fa-2x"></i>
        </div>
    </a>
}
<!--./BeginForm-->

<div class="modal fade" id="modal-editar-email">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">Editar Conta de Email</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input id="idConta" type="hidden">
                <div class="row">
                    <div class="col-sm-12 container" style="align-content:center;">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="iemailEditar" class="mr-3">@RsCadastros.EMAIL:</label><br>
                                    <input type="text" class="form-control emailEditarObrigatorio" id="iEmailEditar">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="iSenhaEditar" class="fs-12 mr-3">@RsCadastros.SENHA:</label><br>
                                    <div class="input-group" style="flex-wrap: nowrap !important;">
                                        <input type="password" style="width:inherit" class="form-control emailEditarObrigatorio" id="iSenhaEditar">
                                        <div class="input-group-append" style="width:10%">
                                            <span class="input-group-text input-password-hide" id="iSenhaEditarIcon" style="cursor: pointer;"><i class="fa fa-eye"></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-8">
                                <div class="form-group">
                                    <label for="iServidorRecebimentoEditar" class="mr-3">@RsCadastros.SERVIDOR_RECEBIMENTO (IMAP):</label><br>
                                    <input type="email" class="form-control emailEditarObrigatorio" id="iServidorRecebimentoEditar">
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iPortaRecebimentoEditar" class="mr-3">@RsCadastros.PORTA:</label><br>
                                    <input type="text" class="form-control emailEditarObrigatorio" id="iPortaRecebimentoEditar">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-8">
                                <div class="form-group">
                                    <label for="iServidorEnvioEditar" class="mr-3">@RsCadastros.SERVIDOR_ENVIO (SMTP):</label><br>
                                    <input type="email" class="form-control emailEditarObrigatorio" id="iServidorEnvioEditar">
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iPortaEnvioEditar" class="mr-3">@RsCadastros.PORTA:</label><br>
                                    <input type="text" class="form-control emailEditarObrigatorio" id="iPortaEnvioEditar">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-8">
                                <div class="form-group">
                                    <label for="iAuthMethodImapEditar" class="">@RsCadastros.METODO_AUTENTICACAO:</label>
                                    @Html.EnumDropDownListFor(model => model.AuthMethodImap, new { @class = "form-control emailEditarObrigatorio", @id = "iAuthMethodImapEditar", @name = "iAuthMethodImapEditar" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iUtilizar_SSL_ImapEditar" class="">Utilizar SSL Imap:</label>
                                    @Html.CheckBoxFor(model => model.Utilizar_SSL, new { @class = "mt-4", @id = "iUtilizar_SSL_ImapEditar", @name = "iUtilizar_SSL_ImapEditar" })
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iUtilizar_SSL_SmtpEditar" class="">Utilizar SSL Smtp:</label>
                                    @Html.CheckBoxFor(model => model.Utilizar_SSL, new { @class = "mt-4", @id = "iUtilizar_SSL_SmtpEditar", @name = "iUtilizar_SSL_SmtpEditar" })
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-success" id="iEditarEmail">Editar</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->

<div class="modal fade" id="modal-editar-integracao">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">Editar Integração Externa</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input id="idConta" type="hidden">
                <div class="row">
                    <div class="col-sm-12 container" style="align-content:center;">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="iIntegracaoEditar" class="mr-3">@RsCadastros.EMAIL:</label><br>
                                    <select type="text" class="form-control integracaoEditarObrigatorio" id="iIntegracaoEditar">
                                        <option value="0">@RsCadastros.SAPERX</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="iUrlIntegracaoEditar" class="fs-12 mr-3">@RsCadastros.SENHA:</label><br>
                                    <input type="text" style="width:inherit" class="form-control integracaoEditarObrigatorio" id="iUrlIntegracaoEditar">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-8">
                                <div class="form-group">
                                    <label for="iUsuarioIntegracaoEditar" class="mr-3">@RsCadastros.USUARIO:</label><br>
                                    <input type="email" class="form-control emailEditarObrigatorio" id="iUsuarioIntegracaoEditar">
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iSenhaIntegracaoEditar" class="mr-3">@RsCadastros.SENHA:</label><br>
                                    <input type="text" class="form-control emailEditarObrigatorio" id="iSenhaIntegracaoEditar">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-8">
                                <div class="form-group">
                                    <label for="iTokenIntegracaoEditar" class="mr-3">@RsCadastros.TOKEN:</label><br>
                                    <input type="text" class="form-control emailEditarObrigatorio" id="iTokenIntegracaoEditar">
                                </div>
                            </div>
                            
                        </div>
                        

                    </div>

                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-success" id="iEditarEmail">Editar</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
