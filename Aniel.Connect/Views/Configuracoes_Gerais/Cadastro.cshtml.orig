                                                    <thead class="tb-head"></thead>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!--Configurações Atendimento e Ordem de Serviço-->
                <div class="card mt-3 mb-3" style="border:none;">
                    <div class="accordion div-card-accord" id="accordion_3">
                        <div class="card-header title-card" id="heading_3">
                            <h5 class="mb-0">
                                <a role="button" data-toggle="collapse" data-target="#collapse_3" aria-expanded="true" aria-controls="collapse_3">
                                    <span class="text-bold-card">@RsCadastros.CONFIGURACAO_ATENDIMENTO</span>
                                </a>
