                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iUrlApiIntegracaoExterna">URL da API</label>
                                                @Html.TextBoxFor(model => model.UrlApiIntegracaoExterna, new { @class = "form-control", @id = "iUrlApiIntegracaoExterna", @autocomplete = "off" })
                                                @Html.ValidationMessageFor(model => model.UrlApiIntegracaoExterna, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iUsuarioIntegracaoExterna" class="mr-3">@RsCadastros.USUARIO</label><br>
                                                @Html.TextBoxFor(model => model.UsuarioIntegracaoExterna, new { @class = "form-control", @id = "iUsuarioIntegracaoExterna", @autocomplete = "off" })
                                                @Html.ValidationMessageFor(model => model.UsuarioIntegracaoExterna, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iSenhaIntegracaoExterna">@RsCadastros.SENHA</label>
                                                @Html.TextBoxFor(model => model.SenhaIntegracaoExterna, new { @class = "form-control", @id = "iSenhaIntegracaoExterna", @autocomplete = "off" })
                                                @Html.ValidationMessageFor(model => model.SenhaIntegracaoExterna, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iTokenIntegracaoExterna">@RsCadastros.TOKEN</label>
                                                @Html.TextBoxFor(model => model.TokenIntegracaoExterna, new { @class = "form-control", @id = "iTokenIntegracaoExterna", @autocomplete = "off" })
                                                @Html.ValidationMessageFor(model => model.TokenIntegracaoExterna, "", new { @class = "text-danger" })
                                            </div>
