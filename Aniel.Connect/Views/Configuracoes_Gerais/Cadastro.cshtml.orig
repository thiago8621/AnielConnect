                                            @Html.CheckBoxFor(model => model.RoteirizarSemLatLong, new { @class = "form-control", @id = "iRoteirizarSemLatLong", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
