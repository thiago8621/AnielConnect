                                        <div class="form-group">
                                            <label for="iSLA_Servico_Padrao">@RsCadastros.SLA_SERVICO_PADRAO</label>
                                            @Html.TextBoxFor(m => m.SLA_Servico_Padrao, new { @class = "form-control hora99", @id = "iSLA_Servico_Padrao", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.SLA_Servico_Padrao, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
