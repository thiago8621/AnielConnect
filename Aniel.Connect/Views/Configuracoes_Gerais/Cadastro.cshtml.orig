                                            @Html.CheckBoxFor(model => model.RoteirizarPorCaixa, new { @class = "form-control", @id = "iRoteirizarPorCaixa", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
