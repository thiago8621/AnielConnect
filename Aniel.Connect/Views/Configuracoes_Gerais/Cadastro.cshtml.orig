                                            @Html.ValidationMessageFor(model => model.Identificacao_Cliente, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-10">
                                        <div class="form-group">
                                            <label for="iPessoaContato" class="mr-3">@RsCadastros.PESSOA_CONTATO_CLIENTE_OU_PROSPECT</label>
                                            <br>
                                            <div class="form-inline" style="padding-left: 25px;">
                                                @Html.RadioButtonFor(m => m.Pessoa_Contato_Primeira_Vez, "Prospect", new { @id = "iradioProspect", @checked = true })
                                                <label for="iradioProspect" class="pl-1 pr-1">@RsCadastros.PROSPECTO</label>
                                            </div>
                                            <div class="form-inline" style="padding-left: 25px;">
                                                @Html.RadioButtonFor(m => m.Pessoa_Contato_Primeira_Vez, "Cliente", new { @id = "iradioCliente" })
                                                <label for="iradioCliente" class="pl-1 pr-1">@RsCadastros.CLIENTE</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!--<div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iTrava_Atendimento_OS" class="mr-3">@RsCadastros.TRAVA_ATENDIMENTO_OS ?</label><br>
                                            @Html.CheckBoxFor(model => model.Trava_Atendimento_OS, new { @class = "form-control", @id = "iTrava_Atendimento_OS", @name = "iEncerrar_Atendimento_Junto_OS", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label for="iEncerrar_Atendimento_Junto_OS" class="mr-3">@RsCadastros.ENCERRAR_ATENDIMENTO_JUNTO_OS ?</label><br>
                                            @Html.CheckBoxFor(model => model.Encerrar_Atendimento_Junto_OS, new { @class = "form-control", @id = "iEncerrar_Atendimento_Junto_OS", @name = "iEncerrar_Atendimento_Junto_OS", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>
                                </div>-->

                                <div class="row">
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label for="iAtendimento_Cria_Cliente" class="mr-3">Permitir Cadastrar Cliente na tela de Atendimento ?</label><br>
                                            @Html.CheckBoxFor(model => model.Atendimento_Cria_Cliente, new { @class = "form-control", @id = "iAtendimento_Cria_Cliente", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>
                                </div>


                                <div class="title-card mt-3">
                                    <h5 class="mb-1">
                                        <a role="button">
                                            <span class="text-bold-card">Configure abertura de  atendimento e-mail</span>
                                        </a>
                                    </h5>
                                </div>

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iUtilizaCriacaoEmailAtendimento" class="mr-3">@RsCadastros.UTILIZAR_CRIACAO_EMAIL_ATENDIMENTO</label><br>
                                            @Html.CheckBoxFor(model => model.Utilizar_Criacao_Email_Atendimento, new { @class = "form-control", @id = "iUtilizaCriacaoEmailAtendimento", @name = "iExige_Agendamento_Servico", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                            <i class=" ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="Será gerado atendimento para e-mail's vinculados a um Cliente"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iExige_Agendamento_Servico" class="mr-3">@RsCadastros.UTILIZAR_CRIACAO_DOMINIOEMAIL_ATENDIMENTO</label><br>
                                            @Html.CheckBoxFor(model => model.Utilizar_Criacao_Dominio_Email_Atendimento, new { @class = "form-control", @id = "iUtilizar_Criacao_Dominio_Email_Atendimento", @name = "iExige_Agendamento_Servico", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                            <i class="ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="Será gerado atendimento para domínios cadastrados em Organizações"></i>
                                        </div>
                                    </div>
                                </div>

                                <div id="iContasEmail" class="mt-5" style="display:none">

                                    <div class="title-card">
                                        <h5 class="mb-1">
                                            <a role="button">
                                                <span class="text-bold-card">Adicionar Conta de E-mail</span>
                                            </a>
                                        </h5>
                                    </div>

                                    <div class="row mt-2">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iemail" class="mr-3">@RsCadastros.EMAIL:</label><br>
                                                <input type="text" class="form-control emailObrigatorio" id="iEmail">
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iSenha" class="mr-3">@RsCadastros.SENHA:</label><br>
                                                <div class="input-group" style="flex-wrap: nowrap !important; width:inherit">
                                                    <input type="password" style="width:inherit" class="form-control col-sm-11 emailObrigatorio" id="iSenha">
                                                    <div class="input-group-append">
                                                        <span class="input-group-text input-password-hide" id="iSenhaIcon" style="cursor: pointer;"><i id="" class="fa fa-eye"></i></span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iServidorRecebimento" class="mr-3">@RsCadastros.SERVIDOR_RECEBIMENTO (IMAP):</label><br>
                                                <input type="email" class="form-control emailObrigatorio" id="iServidorRecebimento">
                                            </div>
                                        </div>
                                        <div class="col-sm-1">
                                            <div class="form-group">
                                                <label for="iPortaRecebimento" class="mr-3">@RsCadastros.PORTA:</label><br>
                                                <input type="text" class="form-control emailObrigatorio" id="iPortaRecebimento">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iServidorEnvio" class="mr-3">@RsCadastros.SERVIDOR_ENVIO (SMTP):</label><br>
                                                <input type="email" class="form-control emailObrigatorio" id="iServidorEnvio">
                                            </div>
                                        </div>
                                        <div class="col-sm-1">
                                            <div class="form-group">
                                                <label for="iPortaEnvio" class="mr-3">@RsCadastros.PORTA:</label><br>
                                                <input type="text" class="form-control emailObrigatorio" id="iPortaEnvio">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iAuthMethodImap" class="">@RsCadastros.METODO_AUTENTICACAO:</label>
                                                @Html.EnumDropDownListFor(model => model.AuthMethodImap, new { @class = "form-control emailObrigatorio", @id = "iAuthMethodImap", @name = "iAuthMethodImap" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iUtilizar_SSL_Imap" class="">Utilizar SSL Imap:</label>
                                                @Html.CheckBoxFor(model => model.Utilizar_SSL, new { @class = "mt-4", @id = "iUtilizar_SSL_Imap", @name = "iUtilizar_SSL_Imap" })
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iUtilizar_SSL_Smtp" class="">Utilizar SSL Smtp:</label>
                                                @Html.CheckBoxFor(model => model.Utilizar_SSL, new { @class = "mt-4", @id = "iUtilizar_SSL_Smtp", @name = "iUtilizar_SSL_Smtp" })
                                            </div>
                                        </div>
                                    </div>


                                    <div class="mt-3">
                                        <input type="button" id="btnAdicionarEmail" value="Adicionar" class="btn btn-success" />
                                    </div>
                                    <div class="row">
                                        <!--URL Sistema-->
                                        <div id="accordion" class="col-sm-12 mt-5">
                                            <div class="">
                                                <div class="title-card">
                                                    <h5 class="mb-1">
                                                        <a role="button">
                                                            <span class="text-bold-card">Lista de Contas de E-mail</span>
                                                        </a>
                                                    </h5>
                                                </div>
                                                <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                                    <div class="card-body">
                                                        <table class="table table-hover nowrap" id="datatableEmail" style="width:100%">
                                                            <thead class="tb-head"></thead>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>


                        </div>





                    </div>
                </div>

                <div class="card mt-3 mb-3" style="border:none;">
                    <div class="accordion div-card-accord" id="accordion_3">
                        <div class="card-header title-card" id="heading_3">
