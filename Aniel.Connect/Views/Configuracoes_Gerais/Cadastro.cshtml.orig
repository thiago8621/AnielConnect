                                            @Html.EnumDropDownListFor(m => m.Formato_Protocolo_Atendimento, RsBase.SELECIONE, new { @class = "form-control", @id = "iFormato_Protocolo_Atendimento", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.Formato_Protocolo_Atendimento, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
