                                            @Html.TextBoxFor(m => m.DistanciaMinimaDeslocamento, new { @maxlength = "6", @class = "form-control", @id = "iDistanciaMinimaDeslocamento", @autocomplete = "off", @placeholder = "valor em metros" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
