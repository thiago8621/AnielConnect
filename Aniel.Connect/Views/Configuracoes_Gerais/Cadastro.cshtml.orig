                                            @Html.CheckBoxFor(model => model.UtilizaPoint_RoteirizacaoAgendamento, new { @class = "form-control", @id = "iUtilizaPoint_RoteirizacaoAgendamento", @name = "iUtilizaPoint_RoteirizacaoAgendamento", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
