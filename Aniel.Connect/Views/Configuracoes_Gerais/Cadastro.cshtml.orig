                                                @Html.CheckBoxFor(model => model.Criterio_SLA_Execucao, new { @class = "form-control", @id = "iCriterio_SLA" })
                                                <label for="iCriterio_SLA" class="pl-1 pr-1">SLA de Execução</label>
                                            </div>
