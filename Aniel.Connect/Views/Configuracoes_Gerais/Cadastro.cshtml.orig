                                            @Html.CheckBoxFor(model => model.Empresa_Roteirizacao_Servico, new { @class = "form-control", @id = "iEmpresa_Roteirizacao_Servico", @name = "iEmpresa_Roteirizacao_Servico", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
