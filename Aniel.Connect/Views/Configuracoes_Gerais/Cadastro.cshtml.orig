                                                @Html.CheckBoxFor(model => model.Criterio_Area, new { @class = "form-control", @id = "iCriterio_Area" })
                                                <label for="iCriterio_Area" class="pl-1 pr-1">@RsCadastros.AREAS_ATUACAO</label>
