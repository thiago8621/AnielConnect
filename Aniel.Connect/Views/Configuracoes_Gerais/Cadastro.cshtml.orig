                                            @Html.TextBoxFor(m => m.Tempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico, new { @class = "form-control tempo", @id = "iTempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico", @autocomplete = "off", @placeholder = "00:00" })
