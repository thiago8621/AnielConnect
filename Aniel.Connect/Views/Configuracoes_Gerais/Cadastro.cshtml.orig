@model Aniel.Connect.Models.Configuracoes_GeraisCadastroModel
@using Aniel.Connect.Models
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = RsCadastros.CONFIGURACOES_EMPRESA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>

        var onready = false;
        let oDatatableEmail;
        let oDatatableIntegracaoExterna;
        function ValidateEmail(inputText)
        {
            var mailformat = @Html.Raw(@"/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/");
            if(inputText.match(mailformat))
            {
                return true;
            }
            else
            {
                return false
            }
        }



        $('#iCriterio_SLA').click(function () {
            if ($(this).is(':checked')) {
                $('#diviCriterio_SLAHora').show();
            }
            else {
                $('#diviCriterio_SLAHora').hide();
                $('#iCriterio_SLAHora').val(false);
            }
        });

        $('#iradioigual').change(function () {
            if ($(this).is(':checked')) {
                $('#iUtiliza_AgrupamentoDistancia').bootstrapToggle('off');;
            }
        });

        $('#iUtiliza_AgrupamentoDistancia').change(function () {
            if ($('#iradioigual').is(':checked')) {
                $('#iUtiliza_AgrupamentoDistancia').bootstrapToggle('off');;
            }
        });


        $('#iSenhaIcon').on('mousedown touchstart', function (e) {
            const id = $(this).attr('id');
            const type = $('#iSenha').attr('type');

            if (type == "password") {
                $('#iSenha').attr('type', 'text')
            }

        }).bind('mouseup mouseleave touchend', function () {
            const id = $(this).attr('id');
            const type = $('#iSenha').attr('type');
            if (type == "text") {
                $('#iSenha').attr('type','password')
            }
        });

        $('#iSenhaEditarIcon').on('mousedown touchstart', function (e) {
            const id = $(this).attr('id');
            const type = $('#iSenhaEditar').attr('type');

            if (type == "password") {
                $('#iSenhaEditar').attr('type', 'text')
            }

        }).bind('mouseup mouseleave touchend', function () {
            const id = $(this).attr('id');
            const type = $('#iSenhaEditar').attr('type');
            if (type == "text") {
                $('#iSenhaEditar').attr('type','password')
            }
        });




        $(document).ready(function () {
            onready = true;
            $(".tempo").mask('00:00', { reverse: true });
            $(".hora").mask('00:00', { reverse: true });
            $(".horaSemRegra").mask('00:00', { reverse: true });
            $(".hora99").mask('000:00', { reverse: true });
            $("#iValorPadraoEstimadoLitro").mask('0000,00', { reverse: true });
            $("#iMediaPadraoKmL").mask(' 0000,00', { reverse: true });

            //Dispara os eventos ao carregar a página
            $('#iTrava_Atendimento_OS').change();
            $("#iEmpresa_Roteirizacao_Servico").trigger('change');
            $('#iUsa_Dias_Liberacao_Did').trigger('change');
            $('#iExige_Agendamento_Servico').trigger('change');
            $('#iradioigual').trigger('change');
            $('#iExige_Avaliacao_Comercial').trigger('change');
            $('#iAtribuir_Tempo_Limite_Venda').trigger('change');
            $('#iExige_Termo_Adesao').trigger('change');
            $('#iUtilizar_Criacao_Dominio_Email_Atendimento').trigger('change');
            $('#iUtilizaCriacaoEmailAtendimento').trigger('change');
            $('#iRoteirizarPorCaixa').trigger('change');
            $('#iRoteirizarSemLatLong').trigger('change');

            //Verifica se valor está entre 1 e 31 (aceita somente letras)
            $('body').on('keyup', '#iDia_Mes_Finaliza_Medicao_Comissao', function()
            {

                 var _quantity = $("#iDia_Mes_Finaliza_Medicao_Comissao").val().length;

                 var valorConvertido = parseInt($("#iDia_Mes_Finaliza_Medicao_Comissao").val());

                 if (_quantity > 2 || valorConvertido > 31 || valorConvertido < 1 || isNaN($("#iDia_Mes_Finaliza_Medicao_Comissao").val()))
                 {
                    var oldStr = $("#iDia_Mes_Finaliza_Medicao_Comissao").val();
                    var newStr = oldStr.slice(0, oldStr.length-1);
                    $("#iDia_Mes_Finaliza_Medicao_Comissao").val(newStr);

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.NUMEROS_VALIDOS_1_31)", "warning");
                 }
             });

            $('#iSenha_APIANIEL').attr("value", "@Model.Senha_APIANIEL");
            onready = false;
        });

        $(".hora99").on("focusout", function () {

            let value = $(this).val();
            hora_min = value.split(':');


            if (hora_min.length === 0) {
                $(this).val("");
                Notificar("@RsBase.ATENCAO_", "@RsCadastros.HORA_INVALIDA", "warning");
            }

            @* Foi pedido para retirar critica #683
            let min = hora_min[1];
            if (((parseInt(min) % 5) != 0.00) && parseInt(min) != 0.00) {
                Notificar("@RsBase.ATENCAO_", "@RsCadastros.EX_HORAMULTIPLO_5MIN", "warning");
                $(this).focus();
            }*@


        });

        //
        $(".hora").on("focusout", function () {

            if ($(this).val()) {
                let min = ($(this).val().substr(3, 2));
                if (((parseInt(min) % 5) != 0.00) && parseInt(min) != 0.00) {
                    $(this).val("");
                    Notificar("@RsBase.ATENCAO_", "@RsCadastros.INTERVALO_MULTIPLO_5_MIN", "warning");
                }
            }

        });



        $("#iTempoBaseDeslocamentoPorKm").on("focusout", function () {
         var tamanho = $(this).val();
            if (tamanho.length < 5) { // 00:00 = 5 caracteres
                $("#iTempoBaseDeslocamentoPorKm").val("");
            }
        });

        $("#iTempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico").on("focusout", function () {
            var tamanho = $(this).val();
            if (tamanho.length < 5) { // 00:00 = 5 caracteres
                $("#iTempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico").val("");
            }
        });

        $("#iTempo_Medio_Deslocamento").on("focusout", function () {
                var tamanho = $(this).val();
                if (tamanho.length < 5) { // 00:00 = 5 caracteres
                    $("#iTempo_Medio_Deslocamento").val("");
                }
            });

        $("#iTempo_Execucao_Padrao").on("focusout", function () {
                var tamanho = $(this).val();
                if (tamanho.length < 5) { // 00:00 = 5 caracteres
                    $("#iTempo_Execucao_Padrao").val("");
                }
            });


        //Campo somente Números
        //somenteNumeros("iDia_Mes_Finaliza_Medicao_Comissao");

       // somenteNumeros_1_31("iDia_Mes_Finaliza_Medicao_Comissao");

        //Retirarndo preenchimento obrigatório dos campos se flag NÂO estiver habilitada
        $("#iEmpresa_Roteirizacao_Servico").change(function () {
            if (!$("#iEmpresa_Roteirizacao_Servico").is(':checked') && !$("#iExige_Agendamento_Servico").is(':checked')) {
                if (!onready) {
                    $('#iTempo_Medio_Deslocamento').val("");
                    $('#iTempo_Execucao_Padrao').val("");
                    $('#iTempoBaseDeslocamentoPorKm').val("");
                }

            }
        });

        $('#iUsa_Dias_Liberacao_Did').change(function () {

            if ($("#iUsa_Dias_Liberacao_Did").is(':checked')) {
                $('#iDivDias_Liberacao_Did').show();
            }
            else {
                $('#iDivDias_Liberacao_Did').hide();
            }
        });


        $('#iCheckin_Checkout_Auto').change(function () {

            if ($("#iCheckin_Checkout_Auto").is(':checked')) {
                if(!onready)
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "Ao ativar esta configuração os serviços serão inciados e finalizados, ainda que não estejam baixados, automaticamente pelo sistema quando o técnico atingir um raio de aproximadamente 50 metros em relação ao endereço do serviço.", "info");
            }
        });

        $('#iUtilizar_Criacao_Dominio_Email_Atendimento').change(function () {
            if ($("#iUtilizar_Criacao_Dominio_Email_Atendimento").is(':checked')) {
                $("#iUtilizaCriacaoEmailAtendimento").prop('checked', true).change()
                if(!onready)
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "Ao ativar esta configuração, o sistema importará os e-mail's pelo domínio. Para a rotina funcionar, é necessário que haja organizações(Empresas) cadastradas.", "info");
            }
        });

        $('#iUtilizaCriacaoEmailAtendimento').change(function () {
            if ($("#iUtilizaCriacaoEmailAtendimento").is(':checked')) {
                $('#iContasEmail').show()
                $('#iUtilizar_SSL').prop('checked', false).change()
            }
            else {
                $('#iContasEmail').hide()
                $('#iUtilizar_Criacao_Dominio_Email_Atendimento').prop('checked', false).change()

            }
        });


        $("#iExige_Agendamento_Servico").change(function () {
            if (!$("#iEmpresa_Roteirizacao_Servico").is(':checked') && !$("#iExige_Agendamento_Servico").is(':checked')) {

                if (!onready) {
                    $('#iTempo_Medio_Deslocamento').val("");
                    $('#iTempo_Execucao_Padrao').val("");
                    $('#iTempoBaseDeslocamentoPorKm').val("");
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "Ao ativar esta configuração, para criar ordens de serviço, o usuário deverá selecionar um agendamento (data/hora) dísponivel. O sistema mostrará a agenda a partir do horário de agendamento padrão cadastrado com as escalas das técnicos e de acordo com os critérios definidos aqui nas configurações.", "info");
                }
            }

            if ($("#iExige_Agendamento_Servico").is(':checked')) {
                //$("#iCriterio_SLA").prop("checked", false).change();
                //$("#diviCriterio_SLA").hide();

                if(!onready)
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA","Ao ativar esta configuração, para criar ordens de serviço, o usuário deverá selecionar um agendamento (data/hora) dísponivel. O sistema mostrará a agenda a partir do horário de agendamento padrão cadastrado com as escalas das técnicos e de acordo com os critérios definidos aqui nas configurações.", "info");
            }


            else {

                //$("#iCriterio_SLA").prop("checked", false).change();
                $("#diviCriterio_SLA").show();

                if(!onready)
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "Ao desativar esta configuração o agendamento pode ser realizado livremente pelo usuário, nos campos data/hora agendamento após a gravação da ordem de serviço. Caso utilize roteirização; o agendamento será feito automaticamente pelo sistema com base nos critérios aqui definidos.", "info");

            }

        });

        $("#iExige_Avaliacao_Comercial").change(function () {
            if ($("#iExige_Avaliacao_Comercial").is(':checked')) {
                $('#iDivQtde_Dias_Avaliacao_Comercial').removeClass("d-none");
            }
            else{
                $('#iDivQtde_Dias_Avaliacao_Comercial').addClass("d-none");
            }
        });





        $("#iAtribuir_Tempo_Limite_Venda").change(function () {
            $("#iAtribuir_Tempo_Limite_Venda").is(":checked") ? $("#iDivQtde_Meses_Visualizacao_Venda").removeClass("d-none") : $("#iDivQtde_Meses_Visualizacao_Venda").addClass("d-none");
            console.log("la")
        });




        $('#iEditarEmail').click(async function () {


            if (ValidaObrigatoriosPorClasse("emailObrigatorioEditar", false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                return false;
            }


            ShowPageLoading();

            const result = await $.ajax({
                url: '@String.Concat(CONSTANTES.URLPortal, "/api/Configuracoes_Geraisapi/ContaEmailEditar")',
                type: 'POST',
                dataType: 'json',
                data: {
                    id : $('#idConta').val(),
                    email : $('#iEmailEditar').val(),
                    senha :$('#iSenhaEditar').val(),
                    servidorRecebimento:$('#iServidorRecebimentoEditar').val(),
                    portaRecebimento :$('#iPortaRecebimentoEditar').val(),
                    servidorEnvio :$('#iServidorEnvioEditar').val(),
                    portaEnvio: $('#iPortaEnvioEditar').val(),
                    authMethodImap : $('#iAuthMethodImapEditar').val(),
                    utilizar_SSL_Imap: $('#iUtilizar_SSL_ImapEditar').prop('checked'),
                    utilizar_SSL_Smtp: $('#iUtilizar_SSL_SmtpEditar').prop('checked')
                }
            })

            HidePageLoading();

            if (!result.ok) {
                Notificar("@RsBase.ATENCAO_", result.mensagem, "warning");
            }
            else {
                $('#modal-editar-email').modal('hide')
                let updatedData = oDatatableEmail.rows().data().toArray()
                let atualizar = updatedData.filter(p => p.Id == $('#idConta').val())[0]

                atualizar.Email = $('#iEmailEditar').val();
                atualizar.Senha = $('#iSenhaEditar').val();
                atualizar.ServidorRecebimento = $('#iServidorRecebimentoEditar').val();
                atualizar.PortaRecebimento = $('#iPortaRecebimentoEditar').val();
                atualizar.ServidorEnvio = $('#iServidorEnvioEditar').val();
                atualizar.PortaEnvio = $('#iPortaEnvioEditar').val();
                atualizar.AuthMethodImap = $('#iAuthMethodImapEditar').val();
                atualizar.AuthMethodImap_Descricao = $('#iAuthMethodImapEditar option:selected').text();
                atualizar.Utilizar_SSL_Imap = $('#iUtilizar_SSL_ImapEditar').prop('checked');
                atualizar.Utilizar_SSL_Smtp = $('#iUtilizar_SSL_SmtpEditar').prop('checked');

                $('#datatableEmail').dataTable().fnClearTable();
                $('#datatableEmail').dataTable().fnAddData(updatedData);
            }

        })

        //Botao Foi colocado em Lista de atendimento
        //O botão "Encerrar Atendimento junto a Ordem de Serviço" deve habilitar somente se o botão "Travar Atendimento estiver SIM"
       //  $("#iTrava_Atendimento_OS").change(function () {

         //    if ($('#iTrava_Atendimento_OS').is(':checked')) {
           //          $('#iEncerrar_Atendimento_Junto_OS').attr('disabled', false).change();
             //}
             //if (!$('#iTrava_Atendimento_OS').is(':checked')) {
               //  $('#iEncerrar_Atendimento_Junto_OS').prop('checked', false).change();
                 //$("#iEncerrar_Atendimento_Junto_OS").attr("disabled", true).change();
             //}

         // });

        ////Se o botão "Travar Atendimento estiver NÃO" o botão "Encerrar Atendimento junto a Ordem de Serviço" deve ficar NÃO também
        //$("#iEncerrar_Atendimento_Junto_OS").change(function () {
        //    if ($("#iEncerrar_Atendimento_Junto_OS").is(":checked")) {
        //        if (!$('#iTrava_Atendimento_OS').is(':checked'))
        //            $("#iTrava_Atendimento_OS").prop("checked", true).change();
        //    }
        //    else {
        //        if ($('#iTrava_Atendimento_OS').is(':checked'))
        //            $("#iTrava_Atendimento_OS").prop("checked", false).change();
        //    }
        //});

        var handleDataTableButtons = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.URL_Sistemas));

            var nome_lista = "URL_Sistemas";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            return '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir=' + row.Id + '><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                    },
                    {
                        data: "Sistema",
                        title: "@RsCadastros.SISTEMA",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Sistema" name="' + nome_lista + '[' + meta.row + '].Sistema" type="hidden" value="' + TrataNulo(data) + '">' +
                                              ' <input id="' + nome_lista + '_' + meta.row + '__Id_Sistema" name="' + nome_lista + '[' + meta.row + '].Id_Sistema" type="hidden" value="' + TrataNulo(row.Id_Sistema) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "URL",
                        title: "@RsCadastros.URL_SISTEMAS",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__URL" name="' + nome_lista + '[' + meta.row + '].URL" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    }

                ]
            });

            function handleExcluir() {
                $(".btnExcluir").unbind('click');
                $(".btnExcluir").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");//[0].id.replace("btnExcluir_", "");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatable.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/URL_Sistemaapi/Excluir?id=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatable.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });


            }

            handleExcluir();



            $("#btnAdicionar").on('click', function () {

                var erro = false;

                if (!$("#iSistema option:selected").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.SISTEMA)", "warning");
                    erro = true;
                }

                if (!erro) {
                    for (var i = 0; i < oDatatable.rows().data().length; i++) {

                        if (oDatatable.rows().data()[i].Id_Sistema == $("#iSistema option:selected").val()) {
                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.SISTEMA)", "warning");
                            erro = true;
                            i = oDatatable.rows().data().length;
                        }
                    }
                }

                if (erro) {
                    return false;
                }

                oDatatable.row.add({
                    Id: 0,
                    URL: $("#iURL").val(),
                    Id_Sistema: $("#iSistema option:selected").val(),
                    Sistema: $("#iSistema option:selected").text()
                }).draw(false);

                $("#iURL").val("");
                $("#iSistema").val("");

                handleExcluir();
            });


        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

        var handleDataTableButtonsEmail = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Emails));

            var nome_lista = "Emails";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            oDatatableEmail = $("#datatableEmail").length && $("#datatableEmail").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                drawCallBack: () => {

                },
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            var retorno = "";
                            retorno += '<a href="#" class="btnExcluirEmail mr-3" id="btnExcluirEmail_' + meta.row + '" excluir=' + row.Id + '><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>';
                            if (row.Id != 0) {
                                retorno += '<a href="#" data-toggle="modal" data-target="#modal-editar-email" class="btnEditarEmail ml-2" id="btnEditarEmail_' + meta.row + '" editar=' + row.Id + '><i class="fas fa-user-edit"></i></a>';
                            }
                            retorno += ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                            retorno += ' <input id="' + nome_lista + '_' + meta.row + '__Senha" name="' + nome_lista + '[' + meta.row + '].Senha" type="hidden" value="' + TrataNulo(row.Senha) + '">';
                            return retorno;
                        }
                    },
                    {
                        data: "Principal",
                        title: "@RsCadastros.PRINCIPAL",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {

                                if (data) {
                                    data = '<input class="radioPrincipal"  id="' + nome_lista + '_' + meta.row + '__Principal" checked name="' + nome_lista + '[' + meta.row + '].Principal" type="radio" value="true">';
                                }
                                else {
                                    data = '<input class="radioPrincipal" id="' + nome_lista + '_' + meta.row + '__Principal"  name="' + nome_lista + '[' + meta.row + '].Principal" type="radio" value="true">';
                                }
                            }
                            return data;
                        }
                    },
                    {
                        data: "Email",
                        title: "@RsCadastros.EMAIL",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Email" name="' + nome_lista + '[' + meta.row + '].Email" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "ServidorEnvio",
                        title: "@RsCadastros.SERVIDOR_ENVIO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__ServidorEnvio" name="' + nome_lista + '[' + meta.row + '].ServidorEnvio" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "PortaEnvio",
                        title: "@RsCadastros.PORTA_ENVIO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__PortaEnvio" name="' + nome_lista + '[' + meta.row + '].PortaEnvio" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "ServidorRecebimento",
                        title: "@RsCadastros.SERVIDOR_RECEBIMENTO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__ServidorRecebimento" name="' + nome_lista + '[' + meta.row + '].ServidorRecebimento" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "PortaRecebimento",
                        title: "@RsCadastros.PORTA_RECEBIMENTO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__PortaRecebimento" name="' + nome_lista + '[' + meta.row + '].PortaRecebimento" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "AuthMethodImap",
                        title: "@RsCadastros.METODO_AUTENTICACAO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = row.AuthMethodImap_Descricao + ' <input id="' + nome_lista + '_' + meta.row + '__AuthMethodImap" name="' + nome_lista + '[' + meta.row + '].AuthMethodImap" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Utilizar_SSL_Imap",
                        title: "Utilizar SSL Imap",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = (data ? "@Html.Raw(RsBase.SIM)" : "@Html.Raw(RsBase.NAO)" )  + ' <input id="' + nome_lista + '_' + meta.row + '__Utilizar_SSL_Imap" name="' + nome_lista + '[' + meta.row + '].Utilizar_SSL_Imap" type="hidden" value="' + data  + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Utilizar_SSL_Smtp",
                        title: "Utilizar SSL Smtp",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = (data ? "@Html.Raw(RsBase.SIM)" : "@Html.Raw(RsBase.NAO)" )  + ' <input id="' + nome_lista + '_' + meta.row + '__Utilizar_SSL_Smtp" name="' + nome_lista + '[' + meta.row + '].Utilizar_SSL_Smtp" type="hidden" value="' + data  + '">';
                            }
                            return data;
                        }
                    },

                ]
            });

            $(".radioPrincipal").on("change", function () {

                let id = $(this).attr("id");

                $(".radioPrincipal").each(function (i,item) {
                    if ($(item).attr("id") != id) {

                        $(item).prop('checked', false);

                    }
                });

            });

            $('#datatableEmail tbody').on('click', '.btnEditarEmail', function (e) {


                var $row = $(this).closest('tr');

                const data_row = oDatatableEmail.row($row).data();

                $('#iEmailEditar').val(data_row.Email);
                $('#iSenhaEditar').val(data_row.Senha);
                $('#iServidorRecebimentoEditar').val(data_row.ServidorRecebimento);
                $('#iServidorEnvioEditar').val(data_row.ServidorEnvio);
                $('#iPortaRecebimentoEditar').val(data_row.PortaRecebimento);
                $('#iPortaEnvioEditar').val(data_row.PortaEnvio);
                $('#iSenhaEditar').val(data_row.Senha);
                $('#idConta').val(data_row.Id);
                $('#iAuthMethodImapEditar').val(data_row.AuthMethodImap);

                $('#iUtilizar_SSL_ImapEditar').prop('checked', data_row.Utilizar_SSL_Imap)
                $('#iUtilizar_SSL_SmtpEditar').prop('checked' , data_row.Utilizar_SSL_Smtp)

            });


            function handleExcluirEmail() {
                $(".btnExcluirEmail").unbind('click');
                $(".btnExcluirEmail").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");//[0].id.replace("btnExcluir_", "");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatableEmail.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Configuracoes_Geraisapi/ContaEmailExcluir?id=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatableEmail.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });


            }

            handleExcluirEmail();

            $("#btnAdicionarEmail").on('click', function () {

                var erro = false;

                if (ValidaObrigatoriosPorClasse("emailObrigatorio", false)) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                    return false;
                }

                if (!ValidateEmail($("#iEmail").val())) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.INVALIDO_FORMAT,RsCadastros.EMAIL)", "warning");
                    erro = true
                }





                if (!erro) {
                    for (var i = 0; i < oDatatableEmail.rows().data().length; i++) {

                        if (oDatatableEmail.rows().data()[i].Email == $("#iEmail").val()) {
                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.EMAIL)", "warning");
                            erro = true;
                            i = oDatatableEmail.rows().data().length;
                        }
                    }
                }

                if (erro) {
                    return false;
                }

                oDatatableEmail.row.add({
                    Id: 0,
                    Email: $("#iEmail").val(),
                    Senha: $("#iSenha").val(),
                    ServidorEnvio: $("#iServidorEnvio").val(),
                    PortaEnvio: $("#iPortaEnvio").val(),
                    ServidorRecebimento: $("#iServidorRecebimento").val(),
                    PortaRecebimento: $("#iPortaRecebimento").val(),
                    Utilizar_SSL_Imap: $("#iUtilizar_SSL_Imap").prop('checked'),
                    Utilizar_SSL_Smtp: $("#iUtilizar_SSL_Smtp").prop('checked'),
                    AuthMethodImap: $("#iAuthMethodImap").val(),
                    AuthMethodImap_Descricao: $("#iAuthMethodImap option:selected").text(),
                }).draw(false);

                $("#iEmail").val("");
                $("#iSenha").val("");
                $("#iServidorEnvio").val("");
                $("#iPortaEnvio").val("");
                $("#iPortaRecebimento").val("");
                $("#iServidorRecebimento").val("");
                $("#iAuthMethodImap").val("");
                $('#iUtilizar_SSL_Imap').prop('checked', false).change()
                $('#iUtilizar_SSL_Smtp').prop('checked', false).change()


                handleExcluir();
            });


        },
            TableManageButtonsEmail = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtonsEmail();
                    }
                }
            }();

        TableManageButtonsEmail.init();

        var handleDataTableButtonsIntegracoesExternas = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Integracoes));

            var nome_lista = "Integracoes";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            oDatatableIntegracaoExterna = $("#datatableIntegracoesExternas").length && $("#datatableIntegracoesExternas").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                drawCallBack: () => {
                    handleExcluirIntegracaoExterna();

                },
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            var retorno = "";
                            retorno += '<a href="#" class="btnExcluirIntegracaoExterna mr-3" id="btnExcluirIntegracaoExterna_' + meta.row + '" excluir=' + row.Id + '><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>';
                            if (row.Id != 0) {
                                retorno += '<a href="#" data-toggle="modal" data-target="#modal-editar-integracao" class="btnEditarEmail ml-2" id="btnEditarEmail_' + meta.row + '" editar=' + row.Id + '><i class="fas fa-user-edit"></i></a>';
                            }
                            retorno += ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                            retorno += ' <input id="' + nome_lista + '_' + meta.row + '__Senha" name="' + nome_lista + '[' + meta.row + '].Senha" type="hidden" value="' + TrataNulo(row.Senha) + '">';
                            return retorno;
                        }
                    },
                    {
                        data: "IntegracaoDesc",
                        title: "@RsCadastros.INTEGRACAO",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__IntegracaoDesc" name="' + nome_lista + '[' + meta.row + '].IntegracaoDesc" type="hidden" value="' + TrataNulo(data) + '">' +
                                    ' <input id="' + nome_lista + '_' + meta.row + '__IntegracaoExterna" name="' + nome_lista + '[' + meta.row + '].IntegracaoExterna" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "UrlApi",
                        title: "@RsCadastros.URL",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__UrlApi" name="' + nome_lista + '[' + meta.row + '].UrlApi" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Usuario",
                        title: "@RsCadastros.USUARIO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Usuario" name="' + nome_lista + '[' + meta.row + '].Usuario" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Senha",
                        title: "@RsCadastros.SENHA",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Senha" name="' + nome_lista + '[' + meta.row + '].Senha" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Token",
                        title: "@RsCadastros.TOKEN",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Token" name="' + nome_lista + '[' + meta.row + '].Token" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    }

                ]
            });



            $('#datatableIntegracoesExternas tbody').on('click', '.btnEditarIntegracaoExterna', function (e) {


                var $row = $(this).closest('tr');

                const data_row = oDatatableIntegracaoExterna.row($row).data();

                $('#iEmailEditar').val(data_row.Email);
                $('#iSenhaEditar').val(data_row.Senha);
                $('#iServidorRecebimentoEditar').val(data_row.ServidorRecebimento);
                $('#iServidorEnvioEditar').val(data_row.ServidorEnvio);
                $('#iPortaRecebimentoEditar').val(data_row.PortaRecebimento);
                $('#iPortaEnvioEditar').val(data_row.PortaEnvio);
                $('#iSenhaEditar').val(data_row.Senha);
                $('#idConta').val(data_row.Id);
                $('#iAuthMethodImapEditar').val(data_row.AuthMethodImap);

                $('#iUtilizar_SSL_ImapEditar').prop('checked', data_row.Utilizar_SSL_Imap)
                $('#iUtilizar_SSL_SmtpEditar').prop('checked' , data_row.Utilizar_SSL_Smtp)

            });


            function handleExcluirIntegracaoExterna() {

                $(".btnExcluirIntegracaoExterna").unbind('click');
                $(".btnExcluirIntegracaoExterna").click(function (e) {
                     Swal.fire({
                    text: "Tem certeza de que deseja excluir esta Integração?",
                    showCancelButton: true,
                    confirmButtonColor: '#357ca5',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Excluir',
                    cancelButtonText: 'Cancelar',
                    target: "#iChecklist"
                }).then(async (okay) => {
                    if (okay.value)
                    {
                        e.preventDefault();

                    var idArquivo = $(this).attr("excluir");//[0].id.replace("btnExcluir_", "");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatableIntegracaoExterna.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Configuracoes_Geraisapi/Excluir_IntegracaoExterna?id=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatableIntegracaoExterna.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                    }

                    HidePageLoading();

                })


                });


            }

            handleExcluirIntegracaoExterna();

            $("#btnAdicionarIntegracaoExterna").on('click', function () {

                var erro = false;

                if (ValidaObrigatoriosPorClasse("integracaoExternaObrigatorio", false)) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                    return false;
                }



                if (erro) {
                    return false;
                }

                oDatatableIntegracaoExterna.row.add({
                    Id: 0,
                    IntegracaoDesc: $("#iIntegracaoExterna option:selected").text(),
                    Usuario: $("#iUsuarioIntegracaoExterna").val(),
                    Senha: $("#iSenhaIntegracaoExterna").val(),
                    Token: $("#iTokenIntegracaoExterna").val(),
                    UrlApi: $("#iUrlApiIntegracaoExterna").val()
                }).draw(false);


                handleExcluirIntegracaoExterna();
            });


        },
            TableManageButtonsIntegracoesExternas = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtonsIntegracoesExternas();
                    }
                }
            }();

        TableManageButtonsIntegracoesExternas.init();

