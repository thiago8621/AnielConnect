                                            @Html.CheckBoxFor(model => model.Considerar_Agendamento_Periodo, new { @class = "form-control", @id = "iEmpresa_Roteirizacao_Servico", @name = "iConsiderar_Agendamento_Periodo", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
