                                            @Html.EnumDropDownListFor(m => m.Formato_Protocolo_OS, RsBase.SELECIONE, new { @class = "form-control", @id = "iFormato_Protocolo_OS" })
                                            @Html.ValidationMessageFor(model => model.Formato_Protocolo_OS, "", new { @class = "text-danger" })
