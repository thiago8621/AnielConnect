                oDatatableAnuncios.row(trLinkButton).remove().draw(false);
                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
            } else {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/AnunciosOLAapi/Excluir?id=")' + idArquivo;

                $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',
                }).done(function (data) {
                    if (data.ok) {
                        oDatatableAnuncios.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    } else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                }).fail(function () {

                }).always(function () {

                });
            }
        });

