        $("#iConsultaCreditoExibeVenda").on("click", function () {
            if (!$(this).prop("checked")) {
                $("#iConsultaCreditoExecutaAutoApp").prop("checked", false);
                $("#iConsultaCreditoExecutaAutoApp").addClass("d-none");
            }
            else {
                $("#iConsultaCreditoExecutaAutoApp").removeClass("d-none");
            }
        });

    $("#iValidaNumeroTelefone").on("change",function () {

        if (!$("#iValidaNumeroTelefone").is(":checked")) {
            $("#divModeloMSG").addClass("d-none");
            //$("#iModeloMSG").val(null).trigger("change");
        }
        else {
            $("#divModeloMSG").removeClass("d-none");
        }
    });

    if ($("input[name=iValidaDocLead]").is(":checked")) {
        $(".divKeysCPF").show();
        $(".divKeysCNPJ").show();
    }

    $('#iValidaDocLead').change(function () {
        if ($(this).is(':checked')) {
            $(".divKeysCPF").show();
            $(".divKeysCNPJ").show();

        }
        else {
            $(".divKeysCPF").hide();
            $(".divKeysCNPJ").hide();
        }
    });

        document.getElementById("iTempoAtualizacaoAlertaSOS").addEventListener("input", function (e) {
            let valor = parseInt(e.target.value);

            // Se for 0 ou menor, define como 1
            if (!isNaN(valor) && valor <= 0) {
                e.target.value = 1;
            }

            // Remove qualquer caractere que não seja número
            e.target.value = e.target.value.replace(/[^0-9]/g, '');
        });

</script>
