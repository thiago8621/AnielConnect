@{
    ViewBag.Title = RsCadastros.CONFIGURACOES_EMPRESA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    ViewBag.enumAcoesProvaVida = Html.GetArrayEnum<AcoesProvaVidaTermoEnum>();
    ViewBag.enumAcoesSelecionadas = Model != null ? Model.Acoes_Prova_Vida : "";
}

@section styles
{
    <style>
        .tooltip {
            position: relative;
            display: inline-block;
        }

            .tooltip .tooltiptext {
                visibility: hidden;
                width: 120px;
                background-color: #333;
                color: #fff;
                text-align: center;
                padding: 5px;
                border-radius: 5px;
                position: absolute;
                z-index: 1;
                bottom: 125%;
                left: 50%;
                margin-left: -60px;
                opacity: 0;
                transition: opacity 0.3s;
            }

            .tooltip:hover .tooltiptext {
                visibility: visible;
                opacity: 1;
            }

        .facet-container {
            width: 330px;
        }

        .right {
            float: right;
        }

        .left {
            float: left;
        }

        p {
            clear: both;
            padding-top: 1em;
        }

        .facet-list {
            list-style-type: none;
            margin: 0;
            padding: 0;
            margin-right: 10px;
            background: #eee;
            padding: 5px;
            width: 143px;
            min-height: 1.5em;
            font-size: 0.85em;
        }

            .facet-list li {
                margin: 5px;
                padding: 5px;
                font-size: 1.2em;
                width: 120px;
            }

                .facet-list li.placeholder {
                    height: 1.2em
                }

        .facet {
            border: 1px solid #bbb;
            background-color: #fafafa;
            cursor: move;
        }

            .facet.ui-sortable-helper {
                opacity: 0.5;
            }

        .placeholder {
            border: 1px solid orange;
            background-color: #fffffd;
        }

        #listPadrao_Login, #listPadrao_Senha {
            overflow-y: auto;
            padding-left: 15px;
            margin: 0
        }

            #listPadrao_Login li, #listPadrao_Senha li {
                list-style: none;
                cursor: pointer
            }

                #listPadrao_Login li:hover, #listPadrao_Senha li:hover {
                    font-weight: bold;
                    color: dodgerblue;
                }

        .bold {
            font-weight: bold;
        }

        input.form-control.readonly[type=checkbox] {
            accent-color: gray
        }

        .popover-body {
            background-color: #357CA5;
            color: white;
        }
    </style>

}

