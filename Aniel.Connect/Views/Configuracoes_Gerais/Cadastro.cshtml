        var clicked = false;
        function ValidaSubmit()
        {

            //Monta JSON Ações
            var objetoJSON = {};
            var index = 0;
            $('#userFacets li').each(function (index) {
                var chave = (index + 1);
                var valor = $(this).text();
                objetoJSON[chave] = valor;
            });
            var JsonString = JSON.stringify(objetoJSON);
            $('#jsonInput').val(JsonString);

            //Remover a cada submit
            $(".msginvalid").html("")
            $("#iPadrao_login").trigger("mouseup").trigger("keyup")

            if (clicked) {
                return false;
            }

            clicked = true;


            var erro = false;


             @*
            //if ($("#iTempo_Execucao_Padrao").val() == "") {
            //if ($("#iTempo_Execucao_Padrao").is(':checked')) {
                //Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TEMPO_EXECUCAO_PADRAO)", "warning");
                //erro = true;
            //}
            //else

           if ($("#iDia_Mes_Finaliza_Medicao_Comissao").val() > 0 && $("#iDia_Mes_Finaliza_Medicao_Comissao").val() <= 31) {
                ("#iDia_Mes_Finaliza_Medicao_Comissao").val();
            } else {
                 Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.NUMEROS_VALIDOS_1_31)", "warning");
                 erro = true;
            }*@

            //Caso a opção de criticar a baixa da OS esteja ativa, deve-se validar que a distancia configurada seja maior do que 0

            if ($("#iCriticaBaixaLocalServico").is(':checked')) {

                let distancia = Number($("#iLimiteDistanciaBaixaServico").val());
                if (distancia <= 0) {

                    Notificar("@RsBase.ATENCAO_", `A configuração "criticar baixa da OS fora do local do serviço" não pode ser 0 (zero), por favor digitar 1 ou maior`, "warning");
                    erro = true;
                }
            }
            if ($("#iCriticaBaixaSinalOnu").is(':checked')) {

                if (!$("#iLimitePotenciaOnuBaixa").val()) {
                    Notificar("@RsBase.ATENCAO_", `Obrigatório informar limite de potência da ONU pois a configuração "Criticar baixa da O.S com sinal de ONU baixo" está ativa`, "warning");
                }

                let potencia = Number($("#iLimitePotenciaOnuBaixa").val());
                if (potencia == 0) {

                    Notificar("@RsBase.ATENCAO_", `Favor informar um valor válido para o limite de potência da ONU`, "warning");
                    erro = true;
                }
            }

            if ($("#iExibirApenasCaixaRaio").is(':checked')) {

                if (!$("#iLimiteDistanciaCaixa").val()) {
                    Notificar("@RsBase.ATENCAO_", `Obrigatório informar raio da Caixa de Atendimento pois a configuração "Exibir apenas Caixas de Atendimento dentro do Raio" está ativa`, "warning");
                    erro = true;
                }

                let distancia = Number($("#iLimiteDistanciaCaixa").val());
                if (distancia <= 0) {

                    Notificar("@RsBase.ATENCAO_", `A configuração "Exibir apenas Caixas de Atendimento dentro do Raio" não pode ser 0 (zero), por favor digitar 1 ou maior`, "warning");
                    erro = true;
                }
            }

            if ($('#iTempoCienciaAlertaSOS').val()) {
                let tempo = Number($("#iTempoCienciaAlertaSOS").val());
                if (tempo <= 0) {

                    Notificar("@RsBase.ATENCAO_", `A configuração "Tempo para confirmar ciência do alerta" não pode ser 0 (zero), por favor digitar 1 ou maior`, "warning");
                    erro = true;
                }
            }

            @* --    Validação de SMS está ativada mas sem modelo de mensagem    -- *@
            if ($("#iValidaNumeroTelefone").is(":checked") && !$("#iModeloMSG").val()) {
                Notificar("@RsBase.ATENCAO_","Lógica de validação de Número por SMS não tem modelo de mensagem configurada.","warning")
                erro = true;
            }
            //validação Tempo limite para visualização de painel de vendas
            if (($("#iAtribuir_Tempo_Limite_Venda").is(":checked")) && $("#Qtde_Meses_Visualizacao_Venda").val() == '') {
                   Notificar("@RsBase.ATENCAO_", "Informe o tempo limite para visualização de vendas", "warning");
                erro = true;
            };

            //Validação 00:00
            if ($("#iTempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico").val() == "00:00") {
                Notificar("@RsBase.ATENCAO_", "Tempo de Atualização deve ser a parir de 00:01 minuto.", "warning");

                $("#iTempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico").css('border-color', '#ff0000')
                $("#iTempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico").parent().append('<span class="text-danger msginvalid">Deve ser a parir de 1 minuto. Ex.: 00:01</span>')

                erro = true;
            }

            //Validação 0
            if ($("#iTempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico").val() == "0") {

                $("#iTempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico").css('border-color', '#ff0000')
                $("#iTempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico").parent().append('<span class="text-danger msginvalid">O formato deve ser HH:MM</span>')

                Notificar("@RsBase.ATENCAO_", "Tempo de Atualização deve ser HH:MM", "warning");
                erro = true;
            }

            //Focusout
            $("#iTempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico").focusout(function () {
                if ($("#iTempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico").length > 0) {
                    $(".msginvalid").html("")
                    $("#iTempo_Atualizacao_Automatica_Painel_Acompanhamento_Tecnico").css('border-color', '#ced4da')

                }
            });




            var _sla_servico_padrao = $("#iSLA_Servico_Padrao").val().split(":");

            if ((_sla_servico_padrao[0] == "00" && _sla_servico_padrao[1] == "00") || (_sla_servico_padrao[0] == "000" && _sla_servico_padrao[1] == "00")) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.SLA_SERVICO_PADRAO)", "warning");
                erro = true;
            }

            //Se Roteirização ou Agendamento estiver SIM (checked)
            if ($("#iEmpresa_Roteirizacao_Servico").is(':checked') || $("#iExige_Agendamento_Servico").is(':checked'))  {

                if (!$('#iTempo_Medio_Deslocamento').val()) {
                    $("#iTempo_Medio_Deslocamento").prop('required', true);
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TEMPO_MEDIO_DESLOCAMENTO)", "warning");
                    erro = true;
                }
                else {
                    var _tempo_medio_deslocamento = $("#iTempo_Medio_Deslocamento").val().split(":");

                    if (parseInt(_tempo_medio_deslocamento[1]) % 5 != 0.00) {
                        Notificar("@RsBase.ATENCAO_", "@RsCadastros.TEMPO_MEDIO_INVALIDO", "warning")
                        erro = true;
                    }
                }

                if (!$('#iTempo_Execucao_Padrao').val()) {
                   $("#iTempo_Execucao_Padrao").prop('required', true);
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TEMPO_EXECUCAO_PADRAO)", "warning");
                    erro = true;
                }
                else {

                    var _tempo_execucao_padrao = $("#iTempo_Execucao_Padrao").val().split(":");

                    if (parseInt(_tempo_execucao_padrao[1]) % 5 != 0.00) {
                        Notificar("@RsBase.ATENCAO_", "@RsCadastros.TEMPO_EXECUCAO_INVALIDO", "warning")
                        erro = true;
                    }

                }

                if (!$('#iTempoBaseDeslocamentoPorKm').val()) {
                    $("#iTempoBaseDeslocamentoPorKm").prop('required', true);
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TEMPO_BASE_DESLOCAMENTO_POR_KM)", "warning");
                    erro = true;
                } else {

                    var _tempo_execucao_padrao = $("#iTempo_Execucao_Padrao").val().split(":");

                    if (parseInt(_tempo_execucao_padrao[1]) % 5 != 0.00) {
                        Notificar("@RsBase.ATENCAO_", "@RsCadastros.TEMPO_BASE_DESLOCAMENTO_POR_KM", "warning")
                        erro = true;
                    }

                }


            }

            HoraSLA = document.getElementById("iSLA_Servico_Padrao");
            hrs = (HoraSLA.value.split(':')[0]);
            min = (HoraSLA.value.split(':')[1]);

            estado = "";
            if ((hrs < 00) || (hrs > 999) || (min < 00) || (min > 59)) {
                document.getElementById("iSLA_Servico_Padrao").style.borderColor = "red";
                estado = "errada";
                erro = true;

            }
            if (HoraSLA == "") {
                document.getElementById("iSLA_Servico_Padrao").style.borderColor = "red";
                estado = "errada";
                erro = true;

            }
            if (estado == "errada") {
                document.getElementById("iSLA_Servico_Padrao").style.borderColor = "red";
                document.getElementById("iSLA_Servico_Padrao").focus();
                erro = true;

            }

            if ($("#iConsultaViabilidadeTempoValidade").val()) {
                let consultaViabilidadeTempoValidade = Number($("#iConsultaViabilidadeTempoValidade").val());

                if (Number.isNaN(consultaViabilidadeTempoValidade) || consultaViabilidadeTempoValidade < 0) {
                    Notificar("@RsBase.ATENCAO_", "Tempo de validade da consulta de viabilidade inválido", "warning");
                    erro = true;
                }
            }

            if ($("#iConsultaPendenciaFinanceiraTempoValidade").val()) {
                let consultaPendenciaFinanceiraTempoValidade = Number($("#iConsultaPendenciaFinanceiraTempoValidade").val());

                if (Number.isNaN(consultaPendenciaFinanceiraTempoValidade) || consultaPendenciaFinanceiraTempoValidade < 0) {
                    Notificar("@RsBase.ATENCAO_", "Tempo de validade da consulta de pend. financeira inválido", "warning");
                    erro = true;
                }
            }

            if ($("#iConsultaPendenciaEnderecoTempoValidade").val()) {
                let consultaPendenciaEnderecoTempoValidade = Number($("#iConsultaPendenciaEnderecoTempoValidade").val());

                if (Number.isNaN(consultaPendenciaEnderecoTempoValidade) || consultaPendenciaEnderecoTempoValidade < 0) {
                    Notificar("@RsBase.ATENCAO_", "Tempo de validade da consulta de pend. de endereço inválido", "warning");
                    erro = true;
                }
            }

            if ($("#iConsultaCreditoTempoValidade").val()) {
                let consultaCreditoTempoValidade = Number($("#iConsultaCreditoTempoValidade").val());

                if (Number.isNaN(consultaCreditoTempoValidade) || consultaCreditoTempoValidade < 0) {
                    Notificar("@RsBase.ATENCAO_", "Tempo de validade da consulta de crédito inválido", "warning");
                    erro = true;
                }
            }

            if ($("#iExige_Foto_Termo").prop("checked") && $("#iTipo_Comprovacao_Termo").val() == '') {
                Notificar("@RsBase.ATENCAO_", "Necessário selecionar Tipo de Comprovaçao de Termo de Adesão", "warning");
                erro = true;
            }

            if (($("#iTipo_Comprovacao_Termo").val() == '1' && $("#iPorcentagem_Similaridade").val() == '') ||
                ($("#iTipo_Comprovacao_Termo").val() == '1' && $("#iPorcentagem_Video").val() == '')) {
                Notificar("@RsBase.ATENCAO_", "Necessário cadastrar a porcentagem de similiaridade e qualidade de video", "warning");
                erro = true;
            }


            if (erro) {
                clicked = false;
                return false;
            }
            else {
                document.getElementById("iSLA_Servico_Padrao").style.borderColor = "";
            }

            ShowPageLoading();
            $('#form').submit();
        }

        $("#iLimiteDistanciaBaixaServico").on("focusout", function (e) {

            let value = Number($(this).val());
            if (value <= 0 ) {

                Notificar("@RsBase.ATENCAO_","Valor inválido! Por favor digitar número maior que zero","warning");
                $("#iLimiteDistanciaBaixaServico").val(null).trigger('change');
            }
        });

        $("#iConsultaViabilidadeExibeVenda").on("click", function () {
