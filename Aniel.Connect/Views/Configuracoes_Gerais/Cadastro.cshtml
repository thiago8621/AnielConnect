    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>

    $('[data-toggle="tooltip"]').tooltip();

    //MONTA LISTA DE AÇÕES A SELECIONAR
    var enumAcoesProvaVida = @ViewBag.enumAcoesProvaVida;
    var resultDiv = document.getElementById('left');
    var htmlString = `<label><b>Ações</b><i class="fas fa-question-circle fa-1x" style="color: #2092EC" data-toggle="popover" data-html="true" title="Legenda Prova de Vida"
                                               data-content="<div style='font-size: 10px'>
                            <span class='p-3'><i class='fas fa-arrow-up' style='color:#000000'></i> <b>UP:</b> Virar rosto para cima</span><br />
                            <span class='p-3'><i class='fas fa-arrow-down' style='color:#000000'></i> <b>DOWN:</b> Virar rosto para baixo</span><br />
                            <span class='p-3'><i class='fas fa-arrow-left' style='color:#000000'></i> <b>LEFT:</b> Virar rosto para esquerda</span><br />
                            <span class='p-3'><i class='fas fa-arrow-right' style='color:#000000'></i> <b>RIGHT:</b> Virar rosto para direita</span><br />
                            <span class='p-3'><i class='fas fa-eye' style='color:#000000'></i> <b>BLINK:</b> Valida se o usuário piscou com os dois olhos</span><br />
                            <span class='p-3'><i class='fas fa-smile' style='color:#000000'></i> <b>SMILE:</b> Valida se o usuário fez um sorriso</span><br />
                        </div>">
                    </i></label><ul id="allFacets" class="facet-list">`;
    enumAcoesProvaVida.forEach(function (item) {
        htmlString += '<li class="facet">' + item + '</li>';
    });
    htmlString += '</ul>';
    resultDiv.innerHTML = htmlString;


    //MONTA LISTA DE AÇÕES SELECIONADAS
    var jsonString = '@ViewBag.enumAcoesSelecionadas';
    if (jsonString != "") {
        var jsonStringDecoded = $("<div/>").html(jsonString).text();
        var objetoJson = JSON.parse(jsonStringDecoded);
        var resultDivRight = document.getElementById('right');
        var htmlStringRight = '<label><b>Ações Selecionadas</b></label><ul id="userFacets" class="facet-list">';
        if (objetoJson != "") {
            objetoJson.forEach(function (item) {
                htmlStringRight += '<li class="facet">' + item.Valor + '</li>';
            });
        }
        htmlStringRight += '</ul>';
        resultDivRight.innerHTML = htmlStringRight;
    } else {
        var resultDivRight = document.getElementById('right');
        var htmlStringRight = '<label><b>Ações Selecionadas</b></label><ul id="userFacets" class="facet-list">';
        htmlStringRight += '</ul>';
        resultDivRight.innerHTML = htmlStringRight;
    }

    //ARRASTAR E SOLTAR AÇÕES
    $(function () {
        $("#allFacets, #userFacets").sortable({
            connectWith: "ul",
            placeholder: "placeholder",
            delay: 150
        })
            .disableSelection()
            .dblclick(function (e) {
                var item = e.target;
                if (e.currentTarget.id === 'allFacets') {
                    //move from all to user
                    $(item).fadeOut('fast', function () {
                        $(item).appendTo($('#userFacets')).fadeIn('slow');
                    });
                } else {
                    //move from user to all
                    $(item).fadeOut('fast', function () {
                        $(item).appendTo($('#allFacets')).fadeIn('slow');
                    });
                }
            });
    });



        const scriptVars = $("#listPadrao_Login li").toArray().map(elem => $(elem).text())
