        $("#iTipo_Integracao_Sms").change(function () {
            const tipoIntegracaoSms = $(this).val();

            switch (tipoIntegracaoSms) {
                case "@((int)Sinapse.Model.enumerados.Tipo_Integracao_SMS.BVTelecom)":
                    $('#iDivToken_Integracao_Sms').show();
                    $('#iDivLogin_Integracao_Sms').hide();
                    break;
                case "@((int)Sinapse.Model.enumerados.Tipo_Integracao_SMS.PontalTech)":
                    $('#iDivToken_Integracao_Sms').hide();
                    $('#iDivLogin_Integracao_Sms').show();
                    break;
                case "@((int)Sinapse.Model.enumerados.Tipo_Integracao_SMS.Blip)":
                    $('#iDivToken_Integracao_Sms').hide();
                    $('#iDivLogin_Integracao_Sms').hide();
                    break;
                default:
                    $('#iDivToken_Integracao_Sms').hide();
                    $('#iDivLogin_Integracao_Sms').hide();
                    break;
            }
