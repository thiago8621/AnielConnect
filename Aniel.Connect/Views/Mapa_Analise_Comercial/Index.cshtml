            objretorno.Uf = $("#iUF").val();

            objretorno.Ids_Check = Ids;

            return objretorno;
        }

        async function renderPolygon(Data, map, check = false) {
            //Lendo de retangulos no mongo


            Data = Data.filter(p => { return p.coordenadas != null });
            for (var obj of Data) {

                for (var coordenada of obj.coordenadas) {
                    let latlng = [];
                    for (var i = 0; i < coordenada.length; i++) {

                        let lat = coordenada[i];
                            lng = coordenada[++i]; //i = i + 1;

                        latlng.push(new google.maps.LatLng(lat, lng));
                        //console.log(latlng);
                    }

                    const polygon = new google.maps.Polygon({
                        strokeColor: obj.cor,
                        strokeOpacity: 0.8,
                        strokeweight: 2,
                        fillColor: obj.cor,
                        fillOpacity: 0.35,
                        editable: false,
                        map,
                        paths: latlng
                    });
                    polygons_Analysis.push(polygon);
                }
            }
            if (!check) {
                polygons_Analysis.forEach(poly => { poly.setMap(null) });
                polygons_Analysis.length = 0;
            }
        }

