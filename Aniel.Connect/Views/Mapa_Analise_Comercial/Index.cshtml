         function Show_ObjJson(json,geocliente){
             //#region json
             if ((json !== null) && (geocliente !== "")) {
                //cliente_planoprod lat long

                 let objjson = JSON.parse(json);

                //console.log(objjson);

                 let geo_latitude = Number(objjson[0].objeto[0].latitude),
                     geo_longitude = Number(objjson[0].objeto[0].longitude);

                 let LatlngList = [],
                     Id_AreacoberturaPlano = [],
                     poligonosbanco = [];

                map.setCenter(new google.maps.LatLng(geo_latitude, geo_longitude));
                  $.ajax({
                type: "GET",
                    url: '@String.Concat(CONSTANTES.URLPortal, "/api/Mapa_Analise_ComercialApi/GetComboPoligonosMongo")',
                      data: { Latitude: geo_latitude, Longitude: geo_longitude },
                    dataType: "json",
                    async:false
                }).done(function (data) {
                //Lendo de retangulos no mongo
                //console.log(data);

                    for (data of data.objeto) {
                     let Id_AreacoberturaDataPlano = data.id;
                        data.coordenadas.forEach(function (retangulo) {
                         LatlngList.push(retangulo);
                         let latlng = [];

                            for (var i = 0; i < retangulo.length; i++) {
                             let lat = retangulo[i];
                             i++;
                             let lng = retangulo[i];
                             latlng.push(new google.maps.LatLng(lat, lng));
                            }

                            let polygon = new google.maps.Polygon({
                                strokeColor: data.cor,
                                strokeOpacity: 0.8,
                                strokeWeight: 2,
                                fillColor: data.cor,
                                /*posicao: LatlngList.findIndex(i => i === retangulo),*/
                                fillOpacity: 0.35,
                                editable: false,
                                paths: latlng,

                            });
                            console.log(latlng);
                            let point = new google.maps.LatLng(geo_latitude, geo_longitude);

                if (google.maps.geometry.poly.containsLocation(point, polygon) == true) {
                    polygon.setMap(map);
                    Id_AreacoberturaPlano.push(Id_AreacoberturaDataPlano);
                    console.log(Id_AreacoberturaPlano,"...........");
                    pathlatlng = [];

                    poligonosbanco.push(Id_AreacoberturaDataPlano);
                }
                else
                {
                    console.log("no");
                }

                        });
                    }
                })
               // #region plano
                let jsonPoligonos = JSON.stringify(poligonosbanco);
                $.ajax({

                    url: `@String.Concat(CONSTANTES.URLPortal, "/api/Mapa_Analise_ComercialApi/GetInfo")?jsonrequest=${jsonPoligonos}`,
                    type: "GET",
                    dataType: "json"
                    //testar agora
                }).done(function (data) {
                    let array = [];
                    for (var i = 0; i < data.objeto.length; i++) {
                        let div = `<div class=\"rcorners2\" id=\"iContainer_${i}\" style=\"padding-bottom:100px;margin-bottom:16px;line-height: 15px;\">` +
