@section styles{



    <style>

        .rcorners2 {
            /*border-radius: 25px;*/
            border: 1px solid #cccccc;
            border-top-left-radius: 15px;
            border-bottom-left-radius: 15px;
            padding: 20px;
            width: 300px;
            height: 100px;
        }

        .rcorners3 {
            border-radius: 25px;
            border: 1px solid #cccccc;
            padding: 20px;
            width: 300px;
            height: 100px;
        }
        /*Map*/

        .map-icon-label {
            font-size: 24px;
            color: white;
            line-height: 55px;
            text-align: center;
            white-space: nowrap;
            opacity: 1;
        }

        #map {
            height: 100%;
        }

        /* Optional: Makes the sample page fill the window. */
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
        }
        /*Collapse*/
        .collapse {
            visibility: hidden;
        }

            .collapse.show {
                visibility: visible;
                display: block;
            }

        .collapsing {
            position: relative;
            height: 0;
            overflow: hidden;
            -webkit-transition-property: height, visibility;
            transition-property: height, visibility;
            -webkit-transition-duration: 0.35s;
            transition-duration: 0.35s;
            -webkit-transition-timing-function: ease;
            transition-timing-function: ease;
        }

            .collapsing.width {
                -webkit-transition-property: width, visibility;
                transition-property: width, visibility;
                width: 0;
                height: auto;
            }

        .iLimparFiltro {
        }

        .icons-bar {
            color: #999;
            font-size: 1.3rem;
        }

        .popover-header {
            color: #357ca5;
            background-color: transparent;
            border: none;
        }

        .imagesvg {
            background: url('data:image/svg+xml;base64,');
        }
    </style>
}
}



