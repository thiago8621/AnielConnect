        async function get_Objetos_Analise(checked, ...Ids) {

            let filters = fulfillObject(filterAnalysis, Ids);

            let url = "@CONSTANTES.URLPortal/api/Mapa_Analise_ComercialApi/Get_Objetos_Analise";

            $.ajax({
                url: url,
                type: "POST",
                dataType: "json",
                data: filters,
            }).done(async function (data) {

                console.log(data);

                    /*      initialize(map);*/
                    for (let Id of Ids) {
                        switch (Id) {
                            case "0": { await renderPolygon(data.objeto, map, checked); break; }
                            case "1": { await renderSingle(data.objeto, map, checked); break; }
                            case "2": { await renderSingle(data.objeto, map, checked); break; }
                            case "3": { await renderSingle(data.objeto, map, checked); break; }
                            case "4": { await renderSingle(data.objeto, map, checked); break; }
                        }
                    }

            });

            }

