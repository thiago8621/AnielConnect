        async function importarLeads() {
            let url = "@CONSTANTES.URLPortal/api/Mapa_Analise_ComercialApi/Importar_Leads_Mongo";
            try {
                @if (AcessoHelper.TemAcesso(_areas, "137"))
                {

                    <text>
                await $.ajax({
                    url: url,
                    type: "POST",
                    dataType: "Application/json",

                })
                    .done(data => {
                        data.forEach(message => {
                            let sucessoMessage = message.Tipo == 0 ? true : false;

                            Notificar(
                                sucessoMessage ? "@RsBase.OPERACAOBEMSUCEDIDA" : "@RsBase.ATENCAO_",
                                `${message.mensagem}`,
                                sucessoMessage ? "info" : "warning");
                        });
                    });
                    </text>
                }
                else
                {

                    <text>
                throw "@RsBase.USUARIO_SEM_ACESSO ";
                    </text>
                }
            } catch (Exception) { Notificar("@RsBase.ATENCAO_",`${Exception}`,"warning") }
        }

