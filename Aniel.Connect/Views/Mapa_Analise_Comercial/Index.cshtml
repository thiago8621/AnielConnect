        async function renderSingle(Data, map, check = false)
        {
            let marker = null,
                infoWindow = null;

            if (check) {

                Data.forEach(single => {



                    let has_icone = single.hasOwnProperty("icone_Str");
                    if (has_icone) {

                        let icon = {
                            path: single.icone_Str,
                            fillColor: single.color,
                            fillOpacity: 0.6,
                            strokeWeight: 2,
                            rotation: 0,
                            scale: 0.3,
                            anchor: new google.maps.Point(15, 30)
                        };

                        marker = new google.maps.Marker({
                            map,
                            title: "",
                            position: new google.maps.LatLng(single.latitude, single.longitude),
                            icon: icon
                        });
                    }
                    else {
                        marker = new google.maps.Marker({
                            map,
                            title: "",
                            position: new google.maps.LatLng(single.latitude, single.Longitude)
                        });
                    }

                    infoWindow = generate_InfoView(single);
                    array_infomap.push({ info: infoWindow, marker: marker });

                
                    array_markers.push(marker);

                });
                bind_Info(array_infomap);
            }

            else
            {
            array_markers.forEach(marker => { marker.setMap(null); });
            array_markers.length = 0;
            array_infomap.length = 0;
            }

            console.log(Data);
        }

