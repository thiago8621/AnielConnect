            buttons: buttonsDataTable,
            pageLength: 10,
            columns: [
                { title: "<input name='select_all' value='1' type='checkbox'>" },
                { data: "descricao", title: "@RsCadastros.ELEMENTO_REDE" },
                { data: "descricao_Tipo", title: "Tipo de Elemento de Rede" },
                { data: "descricao_Modelo", title: "Modelo de Elemento de Rede" },
                { data: "latitude", title: "@RsCadastros.LATITUDE" },
                { data: "longitude", title: "@RsCadastros.LONGITUDE" }
            ]

        });
        //#endregion

            // Handle click on checkbox
        $('#idatatablemedal tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
            var rowId = odatatableMedal.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


        $('#idatatablemedal tbody').on('click', 'tr', function () {

            if (odatatableMedal.row(this).data() != null) {

                let _id = odatatableMedal.row(this).data().id;

                    let url = '@Url.Action("Cadastro", "Elemento_Rede", new { id = "__id__" })';
                    window.location.href = url.replace('__id__', _id);
                    ShowPageLoading();
                }
            });

            // Handle click on table cells with checkboxes
        $('#idatatablemedal').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
        });

        // Handle click on "Select all" control
        $('thead input[name="select_all"]', odatatableMedal.table().container()).on('click', function (e) {
            if (this.checked) {
                $('#idatatablemedal tbody input[type="checkbox"]:not(:checked)').trigger('click');
            } else {
                $('#idatatablemedal tbody input[type="checkbox"]:checked').trigger('click');
            }

            // Prevent click event from propagating to parent
            e.stopPropagation();
        });

        $("#btnMedalha").click(function () {
            $('#modal-medal').modal('show');
            odatatableMedal.columns.adjust();
        });

        let TipoIconesCabo = [];
        listagemTiposConexao.forEach(estilo => {

            let obj = null;

            switch (estilo) {
                case "dashed":
                    obj = {
                        descricao: estilo,
                        path: 'M 0,-1 0,1',
                        strokeOpacity: 1,
                        scale: 4,
                    };
                    break;

                case "dotted":
                    obj = {
                        descricao: estilo,
                        path: 'M10, 50a40, 40 0 1, 0 80, 0a40, 40 0 1, 0 -80, 0',
                        strokeOpacity: 1,
                        scale: 4,
                        offset: '0',
                        repeat: '20px'
                    };
                    break;
                case "groove":
                    obj = {
                        descricao: estilo,
                        //path: google.maps.SymbolPath.CIRCLE,
                        strokeOpacity: 1,
                        scale: 4
                    };
                    break;
                case "inset":
                    obj = {
                        descricao: estilo,
                        //path: 'M 0,-1 0,1',
                        strokeOpacity: 1,
                        scale: 4,
                    };
                    break;

                case "ridge":
                    obj = {
                        descricao: estilo,
                        //path: google.maps.SymbolPath.CIRCLE,
                        strokeOpacity: 1,
                        scale: 4
                    };
                    break;

                case "solid":
                    obj = {
                        descricao: estilo,
                        //path: google.maps.SymbolPath.CIRCLE,
                        strokeOpacity: 1,
                        scale: 4
                    };

                    break;
                case "outset":
                    obj = {
                        descricao: estilo,
                        //path: google.maps.SymbolPath.CIRCLE,
                        strokeOpacity: 1,
                        scale: 4
                    };

                    break;
            }
            TipoIconesCabo.push(obj);
        });

    </script>

}

