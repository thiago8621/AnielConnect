        //#endregion
         function teste(objfiltro = null) {
            var url = "@String.Concat(CONSTANTES.URLPortal, "/api/Elemento_RedeApi/Gestao_Rede_Consulta")";
            if (MasterTree.selectedNodes.length > 0) {
                let vetor = recebecheck();
