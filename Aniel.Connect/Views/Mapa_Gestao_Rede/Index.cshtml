                                                }],
                                                geodesic: true,
                                                strokeColor: obj.situacao == "1" ? obj.corLinhaAtiva : obj.corLinhaInativa,
                                                strokeOpacity: 0.3,
                                                strokeWeight: obj.espessura * 3,
                                            });
                                        }
                                    }
                                    else {
                                        if (obj.estilo_Linha_Inativa == "solid") {
                                            linha = new google.maps.Polyline({
                                                path: latlng,
                                                geodesic: true,
                                                strokeColor: obj.situacao == "1" ? obj.corLinhaAtiva : obj.corLinhaInativa,
                                                strokeOpacity: 1.0,
                                                strokeWeight: obj.espessura * 3,
                                            });
                                        }
                                        if (obj.estilo_Linha_Inativa == "dashed") {
                                            linha = new google.maps.Polyline({
                                                path: latlng,
                                                icons: [{
                                                    icon: {
                                                        path: 'M 0,-1 0,1',
                                                        strokeOpacity: 1,
                                                        scale: 4,
                                                    },
                                                    offset: '0',
                                                    repeat: '20px'
                                                }],
                                                geodesic: true,
                                                strokeColor: obj.situacao == "1" ? obj.corLinhaAtiva : obj.corLinhaInativa,
                                                strokeOpacity: 0.3,
                                                strokeWeight: obj.espessura * 3,
                                            });
                                        }
                                        if (obj.estilo_Linha_Inativa == "dotted") {
                                            linha = new google.maps.Polyline({
                                                path: latlng,
                                                icons: [{
                                                    icon: {
                                                        path: google.maps.SymbolPath.CIRCLE,
                                                        strokeOpacity: 1,
                                                        scale: 4,
                                                    },
                                                    offset: '0',
                                                    repeat: '20px'
                                                }],
                                                geodesic: true,
                                                strokeColor: obj.situacao == "1" ? obj.corLinhaAtiva : obj.corLinhaInativa,
                                                strokeOpacity: 0.3,
                                                strokeWeight: obj.espessura * 3,
                                            });
                                        }
                                    }

                                    linha.setMap(map);

                                }
                                else {
                                    const svgMarker_tree = {
                                        path: obj.path,
                                        fillColor: obj.cor,
                                        fillOpacity: 0.6,
                                        strokeWeight: 2,
                                        rotation: 0,
                                        scale: 1,
                                        anchor: new google.maps.Point(15, 30)
                                    };


                                    let latlng = [];
                                    latlng.push(obj.latitude, obj.longitude);

                                   let markerAdicionado = new google.maps.Marker({
                                       position: new google.maps.LatLng(latlng[0], latlng[1]),
                                       icon:svgMarker_tree,
                                       map,
                                       title: obj.descricao,
                                       elemId: obj.id_Elemento
                                   });

                                    const infowindow = new google.maps.InfoWindow({
                                        content: '<div id="content" >' +
                                            '<div id="siteNotice" style="display:flex">' +
                                            `   <h4 id="firstHeading" class="firstHeading">Descrição: ${obj.descricao}</h4>` +

                                            `   <i class="fas fa-trash ml-2"
                                                onclick="apagarElemento(${obj.id_Elemento})">
                                                </i>

                                                <i class="icofont-connection ml-2"
                                                onclick="verificarConexoes(${obj.id_Elemento})">
                                                </i>

                                                <i class="fas fa-pencil-alt ml-2"
                                                onclick="editarElemento(${obj.id_Elemento})">
                                                </i>
                                            ` +
                                            "</div>" +

                                            `<div id="bodyContent">'
                                                <p>Tipo de elemento : ${obj.descricao_Tipo}</p>
                                                <p>Latitude : ${latlng[0]} | Longitude: ${latlng[1]}</p>
                                            </div>` +
                                            "</div>",
                                    });

                                    const actionwindow = obj.poste ? new google.maps.InfoWindow({
                                        content: '<div id="content" >' +
                                            '<div id="siteNotice" style="display:flex">' +
                                                `<h4 id="firstHeading" class="firstHeading">Ações</h4>` +
                                            "</div>" +

                                            `<div id="bodyContent">
                                                <p><button onclick="VincularPosteCaixa(${obj.id_Elemento})" type="button" class="btn">Vincular Caixa</button></p>
                                                <p><button type="button" onclick="AdicionarCaixa(${obj.id_Elemento})" class="btn">Adicionar Caixa</button></p>
                                            </div>` +
                                            "</div>",
                                    }) : undefined;

                                    markerAdicionado.addListener("click", () => {

                                        if (actionwindow)
                                            actionwindow.close();
                                        infowindow.open({
                                            anchor: markerAdicionado,
                                            map,
                                            shouldFocus: false,
                                        });
                                    });

                                    google.maps.event.addListener(markerAdicionado, 'rightclick', function (mouseEvent) {
                                        infowindow.close();
                                        if (actionwindow) {
                                            actionwindow.open({
                                                anchor: markerAdicionado,
                                                map,
                                                shouldFocus: false,
                                            });
                                        }
                                    });

                                    markersAdicionados.push(markerAdicionado);

                                }
                            }
                        }
                    });
            }
            else {
                return false;
            }
         }

         function recebecheck()
        {
             var newId = []
             var arrayarea=[]
             var array = MasterTree.selectedNodes;
             for (var check of array) {
                 if (check.id.includes("Area Cobertura")) {
                     var areanovo = check.id.split("-");
                     if (areanovo.length > 1) {
                         arrayarea.push(areanovo[1]);
                     }
                 }
                 else {
                     var novo = check.id.split("-");
                     if (novo.length > 4) {
                         newId.push(novo[novo.length - 1]);
                     }
                 }
             }

             var retorno = {
                 ids_Elemento: newId,
                 ids_Area: arrayarea
             }
             return retorno;
        }
