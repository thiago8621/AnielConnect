            async function Gerar_Conexoes(elements) {
                let arrayConexoes = [],
                    errors = [];
                try {

                    if (elements.length <=1) {
                        errors.push("Elementos insuficientes para gerar conexão");
                    }

                    if (errors.length > 0) {

                        let textError = errors.length > 1 ? `${errors.length} erros` : "1 erro";
                        textError += `<br> ${errors.join(" <br> e <br> ")}`;

                        throw textError;
                    }

                    @*iterar pela quantidade de elementos parametrizados em busca de criar as conexões*@
                    for (let origem = 0, destino = 1; destino < elements.length; origem++, destino++) {

                        @*captura das portas*@

                        let conexao_origem = await getPortaConexao(itensVinculados[origem].id),
                            conexao_destino = await getPortaConexao(itensVinculados[destino].id);

                        @*Criação das conexões aqui!*@
                        arrayConexoes.push({

                            Elemento_Origem:elements[origem].id,
                            Porta_Origem:conexao_origem,

                            Elemento_Destino: elements[destino].id,
                            Porta_Destino:conexao_destino,
                        });
                    }
                }

                catch (exception) {
                    console.log(exception);
                    Notificar("@RsBase.ERRO", `${exception}`, 'warning');
                }


            }

