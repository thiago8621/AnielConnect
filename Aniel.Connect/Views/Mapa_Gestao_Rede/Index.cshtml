                {
                     vetor = Object.assign(vetor, objfiltro);
                }

                $.ajax({
                    url: url,
                    data: vetor,
                    type: "POST",
                    dataType: "json",
                })
                    .done(async function (data) {
                        await initMap(map);

                        if (data.objeto.filter(p => p.latitude && p.longitude).length > 0) {

                            var lat = data.objeto.filter(p => p.latitude && p.longitude)[0].latitude;
                            let lng = data.objeto.filter(p => p.latitude && p.longitude)[0].longitude;

                            latlng = { lat: lat, lng: lng };
                            map.setCenter(latlng)
                        }

                        for (var obj of data.objeto) {
                            if (obj.id_Area != null && obj.coordenadas_Area) {


                                for(var coordenada of obj.coordenadas_Area)
