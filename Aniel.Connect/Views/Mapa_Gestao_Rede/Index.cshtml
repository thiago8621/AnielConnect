        async function apagarElemento(id) {

            if (!id || id == 0) {
                Notificar("@RsBase.ATENCAO_","@RsBase.NENHUMREGISTROSELECIONADO", "warning");
                return false;

            }

            let result = await Swal.fire({
                title: 'Certeza que deseja excluir o elemento?',
                text: 'O elemento excluído não pode ser recuperado.',
                confirmButtonText: '@RsCadastros.SIM',
                cancelButtonText: '@RsCadastros.NAO',
                heightAuto: false,
                showCancelButton: true,
            });

            if (result.value) {
                let url = "@CONSTANTES.URLPortal/api/Elemento_RedeApi/Excluir";
                $.ajax({
                    url: url,
                    type: "POST",
                    dataType: "json",
                    data: { Objeto: id }
                }).done(function () {

                    let markerFiltrado = markersAdicionados.filter(p => p.elemId == id);
                    if (markerFiltrado.length > 0)
                    {
                        markerFiltrado[0].setMap(null);
                    }

                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                });
            } else {
                return false;
            }
        }

