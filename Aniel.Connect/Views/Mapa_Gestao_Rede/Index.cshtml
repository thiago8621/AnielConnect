        async function MasterTreeView(dados = null,text_reference = '' ) {
            url = `@String.Concat(CONSTANTES.URLPortal, "/api/Elemento_RedeApi/GetTreeView_Gestao")`;
            if (text_reference != '')
            {
                $("#iDescricao").val(text_reference);
                url = url + `?text_Reference=${$("#iDescricao").val()} `;
                window.localStorage.removeItem("Descricao_TreeView");

            }

            if (dados != null)
            {
                dados = JSON.parse(dados);
                await $.ajax({
                    url: url,
                    type: "GET",
                    dataType: "json"
                    })
                    .done(function (data) {
                        MasterTree = new Tree('.treeclass', {
                            data: data.objeto,
                            closeDepth: text_reference ? 4 : 1,
                            loaded: function () { this.values = dados }
                        });

                    })

                    .fail(function () {

                        Notificar("@RsBase.ATENCAO_", "Houve um erro na Obtenção dos dados", "warning");

                    });
                window.localStorage.removeItem("Opcoes_Id");
            }
            else {
                await $.ajax({
                    url: url,

                    type: "GET",
                    dataType: "json"
                })
                    .done(function (data) {
                        MasterTree = new Tree('.treeclass', {
                            data: data.objeto,
                            closeDepth: text_reference ? 4 : 1,
                        });
                    })
                    .fail(function () {
                        Notificar("@RsBase.ATENCAO_", "Houve um erro na Obtenção dos dados", "warning");
                    });
        } }

