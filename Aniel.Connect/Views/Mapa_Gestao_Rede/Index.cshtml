                                        i = i + 1;
                                        var lng = obj.coordenadas_Elemento[i];

                                        latlng.push(new google.maps.LatLng(lat, lng));
                                    }

                                    let linha;

                                    if (obj.situacao == "1") {
                                        if (obj.estilo_Linha_Ativa == "solid") {
