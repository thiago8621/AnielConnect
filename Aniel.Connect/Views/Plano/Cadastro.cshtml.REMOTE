@model Aniel.Connect.Models.PlanoCadastroModel
@using Sinapse.Model.enumerados
@using Resources
@using Aniel.Connect.Model.enumerado

@{ ViewBag.Title = "Planos/Produtos";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml"; }

@section styles
    {
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .popover-body {
            background-color: #357CA5;
            color: white;
        }
    </style>
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>

    let global_plano_valor_discriminado_total = 0;
    let global_plano_valor_plano_final = 0;

    let global_instalacao_valor_discriminado_total = 0;
    let global_instalacao_valor_instalacao_final = 0;

    let global_instalacao_percentual_total = 0;
    const utiliza_eva = @Json.Encode(@ViewBag.UtilizaEva);

    var oDatatable = null;
    var oDatatableMensalidade = null
    var oDatatableInstalacao = null
    var oDatatableMaterial = null
    var oDatatablelistaPlanos = null
    var oDatatablePlanoProdutosComp = null;

    let global_valor_discriminado_total = 0;
    let global_valor_plano_final = 0;

    var arrayFilial = [], arrayEmpresa = [], arrayConfTributaria = [];

    var HandleEmpresaIntslacao = function ()
    {
        $(`#iEmpresaInstalacao`).on('select2:select select2:unselecting', async function (e) {
            var EmpresaSelecionado = e.params.data;

            if ($(this).val()) {
                await AddSelect(`iFilialInstalacao`, "@CONSTANTES.URLPortal/api/FilialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, EmpresaSelecionado.id, null, "@RsBase.SELECIONE", false);
            } else {
                await AddSelect(`iFilialInstalacao`, "@CONSTANTES.URLPortal/api/FilialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }
        });
    };


    $(document).ready(async function () {

            $("#apenasBoleto").hide();
            $("#mdcontratope").hide()
            $("#PercntDisc").hide();
            $("#valordisc").hide();
            $('#iTipo_Discriminado_Comp').change();
        function ReduzVelocidade() {
            let reduzVelocidade = $("#iReducaoVelocidade").prop("checked");
            if (reduzVelocidade == true) {
                $("#diasatraso").show();
                $("#velocidadedownreduzida").show();
                $("#velocidadeupreduzida").show();
            } else {
                $("#diasatraso").hide();
                $("#velocidadedownreduzida").hide();
                $("#velocidadeupreduzida").hide();
            }
        }
        await ReduzVelocidade();

        $("#qtdDiasbloqueados").hide();

        $('[data-toggle="popover"]').popover()


        AddSelect("iDescontoSelect", "@CONSTANTES.URLPortal/api/Descontoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iFranquia", "@CONSTANTES.URLPortal/api/FranquiaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdFranquia", "@RsBase.SELECIONE", false);
        AddSelect("iRadius", "@CONSTANTES.URLPortal/api/radiusapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Radius", "@RsBase.SELECIONE", false);
        AddSelect("iNomeIPOE", "@CONSTANTES.URLPortal/api/Atributo_IPOEapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.NomeIPOE", "@RsBase.SELECIONE", false);
        AddSelect("iMaterial", "@CONSTANTES.URLPortal/api/MaterialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iPlanoProduto", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iFormaPagCob", "@CONSTANTES.URLPortal/api/Forma_PagamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, "1", "@Model.IdFormaPagamentoCob", "@RsBase.SELECIONE", false);

        await AddSelect("iModeloContrato", "@CONSTANTES.URLPortal/api/Modelo_ContratoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdModeloContrato", "@RsBase.SELECIONE", false, handleModeloContrato);

        AddSelect("iClassificacaoTributaria", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboClassificacaoTributaria", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        await AddSelect("idContaFinanceiraInstalacao", "@CONSTANTES.URLPortal/api/Conta_FinanceiraApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_ContaFinanceiraInstalacao", "@RsBase.SELECIONE", false);
        await AddSelect("idContaFinanceiraPlano", "@CONSTANTES.URLPortal/api/Conta_FinanceiraApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_ContaFinanceiraPlano", "@RsBase.SELECIONE", false);
        AddSelect(`iEmpresaInstalacao`, "@CONSTANTES.URLPortal/api/Empresaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleEmpresaIntslacao);
        AddSelect(`iFilialInstalacao`, "@CONSTANTES.URLPortal/api/FilialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        AddSelect("iClassificacaoTributariaInstalacao", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboClassificacaoTributaria", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        @*AddSelect("iId_Cfop_Instalacao", "@CONSTANTES.URLPortal/api/cfopApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);*@
        AddSelect("iTecnologiaAnatel", "@CONSTANTES.URLPortal/api/TecnologiaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iId_Cfop", "@CONSTANTES.URLPortal/api/cfopApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        AddSelect("iId_Recibo", "@CONSTANTES.URLPortal/api/Modelo_ReciboApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Recibo", "@RsBase.SELECIONE", false);

        AddSelect("iId_ReciboInstalacao", "@CONSTANTES.URLPortal/api/Modelo_ReciboApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_ReciboInstalacaco", "@RsBase.SELECIONE", false);

        AddSelect("iTecnologia", "@CONSTANTES.URLPortal/api/TecnologiaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Tecnologia", "@RsBase.SELECIONE", false);

        //AddSelect("iDesconto", "@CONSTANTES.URLPortal/api/Descontoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null,null, null, "@RsBase.SELECIONE", false);

        $('#iStatusInicial option').each(function () {
            if (!['@Convert.ToInt16(Status_PlanoProduto.Aguardando_Criacao_OS)', '@Convert.ToInt16(Status_PlanoProduto.Habilitado)', ''].includes($(this).val())) {
                $(this).remove();
            }
        });

        await AddSelect("iTipo_Servico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Tipo_Servico", "@RsBase.SELECIONE", false, HandleTipoServico);
        await AddSelect("iSubtipo_Servico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, "@Model.Id_Tipo_Servico", "@Model.Id_Subtipo_Servico", "@RsBase.SELECIONE", false, HandleSubTipoServico);

        await AddSelect("iTipo_ServicoOS", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Tipo_ServicoOS", "@RsBase.SELECIONE", false, HandleTipoServicoOS);
        await AddSelect("iSubtipo_ServicoOS", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, "@Model.Id_Tipo_ServicoOS", "@Model.Id_Subtipo_ServicoOS", "@RsBase.SELECIONE", false, HandleSubTipoServicoOS);

        await AddSelect("iProdutosComp", "@CONSTANTES.URLPortal/api/ProdutosCompApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        //AddSelect("iProdutosComp", "@CONSTANTES.URLPortal/api/ProdutosCompApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdProdutosComp", "@RsBase.SELECIONE", false);

        $("#div_cobrancaTelefonia").hide();
        $("#iUtiliza_Integracao_Externa").hide();

        $('#iUtilizaDesconto').trigger('change');

        if ("@Model.Id" == "0") {
            $('#iPlano_Comercializavel').prop('checked', true);
        }
        $('#iPlano_Comercializavel').trigger('change');
        $('#iHabilitarLc').trigger('change');
        $('#iHabilitarLdn').trigger('change');
        $('#iHabilitarLdi').trigger('change');
        $('#iCobranca_Telefonia').trigger('change');
        $('#iHabilitarVc1').trigger('change');
        $('#iHabilitarVc2').trigger('change');
        $('#iHabilitarVc3').trigger('change');
        $('#iCobrarBloqueioChamadaCobrar').trigger('change');
        $('#iCobrarBina').trigger('change');
        $('#iCobrarBlacklist').trigger('change');
        $('#iCobrarSigame').trigger('change');


        $('#iTipoTecnologia').trigger('change');
        $('#iPossuiConsumoMinimo').trigger('change');
        $('#iPossuiFranquia').trigger('change');
        $('#iModeloNotaFiscal').trigger('change');
        $("#iModeloNotaFiscalInstalacao").trigger('change')

        /*$('#iReducaoVelocidade').trigger('change');*/

        $('#iAtivarValidade').trigger('change');

        $('#iOsMudacaPlano').trigger('change');
        $("#iDefinirTipo_SubTipoOS").trigger('change');
        $('#iUsaPlanoAdicional').trigger('change');

        $('#iTesteGratis').trigger('change');

        $('#iProRata').trigger('change');


        $('#iComprovantePagamento').trigger('change');

        $('#iComprovantePagamentoInstalacao').trigger('change');

        $('#iMomentoCobrancaInstalcao').trigger('change');


        CarregaModeloAnatel(false);

        CarregaRegimeAnatel(false);
        //$('#iModelo_Anatel').trigger('change');
        /*  $('#iRegime').trigger('change');*/

        $('#IFrequenciaCobranca').trigger('change');

        $('#iValorDescontoProgressivo').trigger('change');

        $('#iValorDescontoAntecipado').trigger('change');

        $('#iPercentualDescontoProgressivo').trigger('change');

        $('#iPercentualDescontoAntecipado').trigger('change');

        $('#iDescontoProgressivo').trigger('change');

        $('#iCobrancaInstalacao').trigger('change');

        $('#iServidorRadius').trigger('change');

        $('#iNomeIPOE').trigger('change');

        $('#iTipoCobrancaInstalacao').trigger('change');

        $('#iAutenticacaoRadius').trigger('change');

        $('#iAtributoIPOE').trigger('change');

        $('#iUsaQoSProfile').trigger('change');

        $('#desbloqueio_conf ').trigger('change');

        //$('#ImpedirBloqueio_Automatico').trigger('change');

        $('#iUtiliza_Integracao_Externa').trigger('change');

        $('#iStatusInicial').trigger('change');

        $(".somentenumero").bind("keyup blur focus", function (e) {
            e.preventDefault();
            var expre = /[^\d]/g;
            $(this).val($(this).val().replace(expre, ''));
        });

        $(".numeroInteiroDecimal").bind("keyup blur focus", function (e) {
            e.preventDefault();
            var expre = /^\d*\,?\d{0,2}$/;
            var input = $(this).val();
            if (input.match(expre)) {
                $(this).val(input);
            } else {
                var validInput = input.match(/^(\d*\,?\d{0,2}),*/);
                $(this).val(validInput[1]);
            }
        });

        CarregarGridAtividades();

        // Variaveis globais Financeiro
        const valor_discriminado_total = oDatatablePlanoProdutosComp.data().map(p => parseFloat(p.ValorTotal)).reduce((a, b) => a + b, 0)
        const valor_plano = parseFloat($('#iValorPlano').val().replace(",", "."))
        const valor_plano_final = isNaN(valor_plano) ? 0 : valor_plano

        global_plano_valor_discriminado_total = valor_discriminado_total;
        global_plano_valor_plano_final = valor_plano_final;

        //// Variaveis globais Instalacao
        //var valor_discriminado_total_Instalacao = oDatatableInstalacao.data().map(p => parseFloat(p.ValorDiscriminado)).reduce((a, b) => a + b, 0)
        //const valor_instalacao = parseFloat($('#iValorInstalacao').val().replace(",", "."))
        //const valor_instalacao_final = isNaN(valor_instalacao) ? 0 : valor_instalacao

        var percentual_discriminado_total = oDatatableInstalacao.data().map(p => p.PercentualDiscriminado === NaN || p.PercentualDiscriminado === "" ? 0 : parseFloat(p.PercentualDiscriminado)).reduce((a, b) => a + b, 0);
        global_instalacao_percentual_total = percentual_discriminado_total;
    });

         $('#iUtilizaVendaAgroup').on('change', function () {
             if ($('#iUtilizaVendaAgroup').is(":checked"))
                 $('#divVendaAgroup').show();
             else
                $('#divVendaAgroup').hide();
         });

        //})

        $('#iTipo_Discriminado').change(function () {

            // Se igual a analitico
            if ($('#iTipo_Discriminado').val() == 1) {

                $("#PercntDisc").hide();
                $("#iPercentual_Discriminado").val(null);
                $("#valordisc").show();


            } else if ($('#iTipo_Discriminado').val() == 2) {
                $("#PercntDisc").show();
                $("#valordisc").hide();
                $("#iValor_Discriminado").val(null);
            } else {
                $("#PercntDisc").hide();
                $("#valordisc").hide();
                $("#iValor_Discriminado").val(null);
                $("#iPercentual_Discriminado").val(null);
            }

        });

        $('#iTipo_Discriminado_Comp').change(function () {
            if ($('#iTipo_Discriminado_Comp').val() == 1) {
                $("#PercntDiscComp").hide();
                $("#iPercentual_Discriminado_Comp").val(null);
                $("#valordiscComp").show();

                $("#divBtnAdicionarProdutosComp").removeClass("col-sm-6");
                $("#divBtnAdicionarProdutosComp").addClass("col-sm-4");
            } else if ($('#iTipo_Discriminado_Comp').val() == 2) {
                $("#PercntDiscComp").show();
                $("#valordiscComp").hide();
                $("#iValor_Discriminado_Comp").val(null);

                $("#divBtnAdicionarProdutosComp").removeClass("col-sm-6");
                $("#divBtnAdicionarProdutosComp").addClass("col-sm-4");
            } else {
                $("#PercntDiscComp").hide();
                $("#valordiscComp").hide();
                $("#iValor_Discriminado_Comp").val(null);
                $("#iPercentual_Discriminado_Comp").val(null);

                $("#divBtnAdicionarProdutosComp").removeClass("col-sm-4");
                $("#divBtnAdicionarProdutosComp").addClass("col-sm-6");
            }
        });


        'use strict';

        //$('#iPlano_Comercializavel').prop('checked', true);

        $('a[data-toggle="tab"]').on('shown.bs.tab', () => {
            $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle('destroy')
            $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle()
            $("#datatableMaterial").DataTable().columns.adjust();
        });

        $(".cadencia").prop("placeholder", "3/30/60");

        $(".cadencia").on("keyup", function () {
            let mask = "",
                value = $(this).val(),
                size = value.length;
            const arrayMasks = ["00/00", "00/00/00"]
            if (size == 5) {
                mask = arrayMasks[1];
                $(this).mask(mask);
                $(this).val(value + "/60");
                //$(this).trigger("keyup");
            }
            else if (size < 4) {
                mask = arrayMasks[0];
                $(this).mask(mask);
            }
            else { return false; }
        });

        $('#iTipoTecnologia').change(function () {
            const valor = $(this).val();
            if (valor == "2") {
                $("#iNavInternet").show();
                $("#iNavTelefonia").hide();

                $("#divProductId").hide();
            }
            else if (valor == "1" || valor == "4") {
                $("#iNavInternet").hide();
                $("#iNavTelefonia").show();

                $("#divProductId").hide();

                $("#iFormatoPlanoNacional").prop("checked", true);
            }
            else if (valor == "5") {
                $("iNavInternet").hide();
                $("#iNavTelefonia").hide();

                $("#divProductId").show();

                $("#iFormatoPlanoNacional #iFormatoPlanoInternacional").prop("checked", false);
            }
            else {
                $("#iNavInternet").hide();
                $("#iNavTelefonia").hide();

                $("#divProductId").hide();

                $("#iFormatoPlanoNacional #iFormatoPlanoInternacional").prop("checked", false);
            }
        });

        somenteNumeros('iParcela_Ini');
        somenteNumeros('iParcela_Fin');

        $('.money').mask('000000000000000,00', { reverse: true });
        $('.percent').mask('000,00', { reverse: true });

        //bloqueio por debito
        $('#ibloq_auto_debito').change(function () {
            if ($('#ibloq_auto_debito').is(':checked')) {
                $('#qtdDiasbloqueados').show();
            }
            else {
                $('#qtdDiasbloqueados').hide();
            }
        });

        $("input[type='radio'][name='TipoValor']").click(function () {
            var value = $(this).val();

            if (value == 'valor') {
                $('#iValor_Discriminado').removeClass('readonly');
                $('#iPercentual_Discriminado').addClass('readonly');
            }
            else {
                $('#iValor_Discriminado').addClass('readonly');
                $('#iPercentual_Discriminado').removeClass('readonly');
            }
        });

        $("input[type='radio'][name='TipoValorInstalacao']").click(function () {
            var value = $(this).val();

            if (value == 'valor') {
                $('#iValor_Discriminado_Instalacao').removeClass('readonly');
                $('#iPercentual_Discriminado_Instalacao').addClass('readonly');
            }
            else {
                $('#iValor_Discriminado_Instalacao').addClass('readonly');
                $('#iPercentual_Discriminado_Instalacao').removeClass('readonly');
            }
        });

        $('#iHabilitarLc').change(function () {
            if ($('#iHabilitarLc').is(':checked')) {
                $('#iDivValorLc').show();
                $('#iDivCadenciaLc').show();
            }
            else {
                $('#iDivValorLc').hide();
                $('#iDivCadenciaLc').hide();
            }
        });

        $('#iHabilitarLdn').change(function () {
            if ($('#iHabilitarLdn').is(':checked')) {
                $('#iDivValorLdn').show();
                $('#iDivCadenciaLdn').show();
            }
            else {
                $('#iDivValorLdn').hide();
                $('#iDivCadenciaLdn').hide();
            }
        });
        $('#iHabilitarLdi').change(function () {
            if ($('#iHabilitarLdi').is(':checked')) {
                $('#iDivValorLdi').show();
                $('#iDivCadenciaLdi').show();
            }
            else {
                $('#iDivValorLdi').hide();
                $('#iDivCadenciaLdi').hide();
            }
        });
        $('#iHabilitarVc1').change(function () {
            if ($('#iHabilitarVc1').is(':checked')) {
                $('#iDivValorVc1').show();
                $('#iDivCadenciaVc1').show();
            }
            else {
                $('#iDivValorVc1').hide();
                $('#iDivCadenciaVc1').hide();
            }
        });

        $('#iHabilitarVc2').change(function () {
            if ($('#iHabilitarVc2').is(':checked')) {
                $('#iDivValorVc2').show();
                $('#iDivCadenciaVc2').show();
            }
            else {
                $('#iDivValorVc2').hide();
                $('#iDivCadenciaVc2').hide();
            }
        });

        $('#iHabilitarVc3').change(function () {
            if ($('#iHabilitarVc3').is(':checked')) {
                $('#iDivValorVc3').show();
                $('#iDivCadenciaVc3').show();
            }
            else {
                $('#iDivValorVc3').hide();
                $('#iDivCadenciaVc3').hide();
            }
        });


        $("#iNum_Dids").change(function () {
            if ($("#iNum_Dids").val() != "0") {
                $("#div_cobrancaTelefonia").show();
            }
            else {
                $("#div_cobrancaTelefonia").hide();
            }
        });

        $("#iFormatoPlanoNacional, #iFormatoPlanoInternacional").on("click", function () {
            if ($(this).val() == "Nacional") {
                $("#divCadenciaInternacional").hide();
                $("#divHabilitarLc").show();
                if ($('#iHabilitarVc1').is(':checked')) {
                    $('#iDivValorVc1').show();
                    $('#iDivCadenciaVc1').show();
                }
                if ($('#iHabilitarVc2').is(':checked')) {
                    $('#iDivValorVc2').show();
                    $('#iDivCadenciaVc2').show();
                }
                if ($('#iHabilitarVc3').is(':checked')) {
                    $('#iDivValorVc3').show();
                    $('#iDivCadenciaVc3').show();
                }
                if ($('#iHabilitarLc').is(':checked')) {
                    $('#iDivValorLc').show();
                    $('#iDivCadenciaLc').show();
                }
                if ($('#iHabilitarLdn').is(':checked')) {
                    $('#iDivValorLdn').show();
                    $('#iDivCadenciaLdn').show();
                }
                if ($('#iHabilitarLdi').is(':checked')) {
                    $('#iDivValorLdi').show();
                    $('#iDivCadenciaLdi').show();
                }
                if ($('#iCobrarBina').is(':checked')) {
                    $('#iDivValorBina').show();
                }

                if ($('#iCobrarBlacklist').is(':checked')) {
                    $('#iDivValorBlacklist').show();
                }

                if ($('#iCobrarSigame').is(':checked')) {
                    $('#iDivValorSigame').show();
                }
                if ($("#iCobrarBloqueioChamadaCobrar").is(":checked")) {
                $('#iDivBloqueioChamadaCobrar').hide();
                }
                $("#divHabilitarLdn").show();
                $("#divHabilitarLdi").show();
                $("#divHabilitarVc1").show();
                $("#divHabilitarVc2").show();
                $("#divHabilitarVc3").show();
                $("#diviIntragrupoLcGratuita").show();
                $("#diviIntragrupoGratuita").show();
                $("#divcobrarBina").show();
                $("#divSigame").show();
                $("#divBlackList").show();
                $("#divCobrarBloqueioChamadaCobrar").show();
                $("#divCadenciaInternacional").hide();

                $(".semititulo").show()


            }
            else if ($(this).val() == "Internacional") {

                $("#divCadenciaInternacional").show();
                $("#divHabilitarLc").hide();
                $("#divHabilitarLdn").hide();
                $("#divHabilitarLdi").hide();
                $("#divHabilitarVc1").hide();
                $("#divHabilitarVc2").hide();
                $("#divHabilitarVc3").hide();
                $("#diviIntragrupoLcGratuita").hide();
                $("#diviIntragrupoGratuita").hide();
                $("#divcobrarBina").hide();
                $("#divSigame").hide();
                $("#divBlackList").hide();
                $("#divCobrarBloqueioChamadaCobrar").hide();
                $(".semititulo").hide();
                $('#iDivValorVc1').hide();
                $('#iDivCadenciaVc1').hide();
