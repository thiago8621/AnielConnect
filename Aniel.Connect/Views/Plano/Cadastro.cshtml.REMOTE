                                                <div class="form-group">
                                                    @Html.DropDownListFor(p => p.Id_Subtipo_Servico, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iSubtipo_Servico", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.Id_Subtipo_Servico, "", new { @class = "text-danger" })
