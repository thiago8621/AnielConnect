                ]
            });

            function handleExcluir() {
                $(".btnExcluirAtividade").click(function (e) {
                    e.preventDefault();

                    var idAtividade = $(this).attr("excluir");
                    var trLinkButton = $(this).parents('tr');

                    if (idAtividade === "0") {
                        oDatatable.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");

                        atualizaValorGlobalFinanceiro();
                    }
                    else {
                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/planoapi/ExcluirConfigNF?value=")' + idAtividade;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json'
                        })
                        .done(function (data) {
                            if (data.ok) {
                                oDatatable.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");

                                atualizaValorGlobalFinanceiro();
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                         .fail(function (e) {
                            Notificar("@RsBase.ATENCAO_", e.responseJSON.message, "warning");
                        })
                    }
                });
            }

            function limpaControlesNotaFiscalFinanceiro() {
                $("#iValor_Discriminado").val(null)
                $("#iModeloNotaFiscal").val(null).trigger("change")
                $('#iId_Cfop').val(null).trigger("change")
            }

            handleExcluir();

            $("#idBotao").on("click", function () {
                let vari = $("#iTipo_Discriminado").val();
                let valorPlano = 0;
                Discriminado(vari, valorPlano);

            })

            /**
             * @@param number_Type {number} número do valor a ser discriminado
             */
            function Discriminado(number_Type, valorPlano) {
                //Com o valor discriminado e valor do plano, adquirir percentual
                if (number_Type == 1) {
                    let valor = parseFloat($("#iValor_Discriminado").val().replace(",", "."));
                    let discriminadoPercentual = parseFloat(((valor * 100) / valorPlano).toFixed(2));
                    $("#iPercentual_Discriminado").val(discriminadoPercentual.toLocaleString());
                }

                //Com o percentual discriminado e valor do plano, adquirir valor
                else if (number_Type == 2) {
                    let discriminadoValor = parseFloat((($("#iPercentual_Discriminado").val() * (valorPlano)) / (100)).toFixed(2));
                    $("#iValor_Discriminado").val(discriminadoValor.toLocaleString());
                }
            }

           $("#btnAdicionarAtividade").on('click', function () {
                 var erro = false
                 const valor_plano = parseFloat(($('#iValorPlano').val()).replace(",", "."))
                 const valor_plano_final = isNaN(valor_plano) ? 0 : valor_plano
                 let tipoDiscriminado = $("#iTipo_Discriminado").val();
                 Discriminado(tipoDiscriminado, valor_plano);


                if (!$("#iClassificacaoTributaria").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CLASSIFICACAO_TRIBUTARIA)", "warning")
                    erro = true
                }

                if (!$("#iModeloNotaFiscal").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MODELO_NOTA_FISCAL)", "warning")
                    erro = true
                }

                if (!$("#iValor_Discriminado").val() && !$("#iPercentual_Discriminado").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.VALOR_DISCRIMINADO)", "warning")
                    erro = true
                }
                else
                {
                    var valor_discriminado_total = 0;
                    for (var i = 0; i < oDatatable.data().length; i++) {
                        valor_discriminado_total = valor_discriminado_total + parseFloat(oDatatable.data()[i].ValorDiscriminado.toString().replace(',', '.'))
                    }
                    valor_discriminado_total = valor_discriminado_total + parseFloat($("#iValor_Discriminado").val().replace(",", "."));
                    valor_discriminado_total = mascaraValorDiscriminado(valor_discriminado_total);

                    if (valor_discriminado_total > valor_plano_final)
                    {
                        valor_discriminado_total = oDatatable.data().map(p => parseFloat(p.ValorDiscriminado)).reduce((a, b) => a + b, 0)
                        limpaControlesNotaFiscalFinanceiro()
                        Notificar("@RsBase.ATENCAO_", "Total de valores discriminados está ultrapassando o valor total do produto.", "warning")
                        erro = true
                    }

                    global_valor_discriminado_total = valor_discriminado_total;
                    global_valor_plano_final = valor_plano_final;
                }

                if (erro) {
                    return false;
                }
                oDatatable.row.add({
                    Id: 0,

                    ModeloNotaFiscal: $("#iModeloNotaFiscal").val(),
                    DescModeloNotaFiscal: $("#iModeloNotaFiscal option:selected").text(),
                    a: $("#iTipo_Discriminado").val(),
                    IdClassificacaoTributaria: $("#iClassificacaoTributaria").val(),
                    DescClassificacaoTributaria: $("#iClassificacaoTributaria option:selected").text(),
                    PercentualDiscriminado: $("#iPercentual_Discriminado").val() ? parseFloat($("#iPercentual_Discriminado").val()).toLocaleString() : null,
                    ValorDiscriminado: $("#iValor_Discriminado").val(),
                }).draw(false);

               $("#iValor_Discriminado").val(null);
               $("#iTipo_Discriminado").val(null).trigger("change");
               $("#iModeloNotaFiscal").val(null).trigger("change");
               $('#iId_Cfop').val(null).trigger("change");
               $("#iPercentual_Discriminado").val(null);
               $("#iClassificacaoTributaria").val(null).trigger("change");



                atualizaValorGlobalFinanceiro();
                handleExcluir();
            });
        },
        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtons();
                }
            }
    }();*@
    //TableManageButtons.init();


        function atualizaValorGlobalFinanceiro() {
            let valor_discriminado_total = oDatatable.data().map(p => {
                if (p.ValorDiscriminado) {
                    // Remover pontos de milhar e substituir a vírgula decimal
                    let valorCorrigido = parseFloat(p.ValorDiscriminado.replace(/\./g, "").replace(",", "."));
                    return isNaN(valorCorrigido) ? 0 : valorCorrigido;
                } else {
                    let valorPlano = parseFloat($('#iValorPlano').val().replace(/\./g, "").replace(",", "."));
                    let percentual = parseFloat(p.PercentualDiscriminado.replace('%', '').replace(",", ".")) / 100;
                    let valor = valorPlano * percentual;
                    return isNaN(valor) ? 0 : parseFloat(valor.toFixed(2));
                }
            }).reduce((a, b) => a + b, 0);
            const valor_plano = parseFloat($('#iValorPlano').val().replace(",", "."))
            const valor_plano_final = isNaN(valor_plano) ? 0 : valor_plano

            var somaTotal = mascaraValorDiscriminado(valor_discriminado_total.toFixed(2));
            global_plano_valor_discriminado_total = somaTotal;
            global_plano_valor_plano_final = valor_plano_final;
        }

        function mascaraValorDiscriminado(valor_discriminado_total) {
            var saldo = "";
            var valorPreVirgula = "";
            var index = valor_discriminado_total.toString().indexOf(".");
            var valorPosVirgula = valor_discriminado_total.toString().substring(index + 1);

            if (index !== -1) {
                valorPosVirgula = valorPosVirgula.substring(0, 2);
                valorPreVirgula = valor_discriminado_total.toString().substring(0, index);
                saldo = valorPreVirgula + "." + valorPosVirgula;
            } else
            {
                saldo = valor_discriminado_total.toString();
            }

            return parseFloat(saldo);
        }

       var handleDataTableButtonsMaterial = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Material_Os));
           var nome_lista = "Material_Os";

           oDatatableMaterial = $("#datatableMaterial").length && $("#datatableMaterial").DataTable({
               dom: "Bfrti",
               language: traducaoDataTableSimples,
               data: array,
               columns: [{
                   data: "Id",
                   render: function (data, type, row, meta) {
                       return '<a href="#" class="btnExcluir" id="btnExcluirMaterial_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                           ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                   }
               }, {
                   data: "Codigo",
                   className: "nonClickable",
                   title: "@RsCadastros.CODIGO",
                   render: function (data, type, row, meta) {
                       if (type === 'display') {
                           data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Codigo" name="' + nome_lista + '[' + meta.row + '].Codigo" type="hidden" value="' + TrataNulo(data) + '">';
                       }
                       return data;
                   }
               }, {
                   data: "Descricao",
                   title: "@RsCadastros.DESCRICAO",
                   render: function (data, type, row, meta) {
                       if (type === 'display') {
                           data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Descricao" name="' + nome_lista + '[' + meta.row + '].Descricao" type="hidden" value="' + TrataNulo(data) + '">' +
                               ' <input id="' + nome_lista + '_' + meta.row + '__Descricao" name="' + nome_lista + '[' + meta.row + '].Descricao" type="hidden" value="' + TrataNulo(row.Descricao) + '">';
                       }
                       return data;
                   }
               }
               ]
           });

           function handleExcluir() {
               $(".btnExcluir").click(function (e) {
                   e.preventDefault();

                   var idAtividade = $(this).attr("excluir");
                   var trLinkButton = $(this).parents('tr');
                   var $row = $(this).closest('tr');
                   var rowData = $('#datatableAtividade').DataTable().row($row).data();

                   if (idAtividade === "0") {
                       oDatatableMaterial.row(trLinkButton).remove().draw(false);
                       Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                   }
                   else {
                       var link = '@String.Concat(CONSTANTES.URLPortal, "/api/planoapi/ExcluirMaterialOS_PlanoProduto?value=")' + rowData.Id;

                       $.ajax({
                           url: link,
                           type: 'GET',
                           dataType: 'json'
                       })
                           .done(function (data) {
                               if (data.ok) {
                                   oDatatableMaterial.row(trLinkButton).remove().draw(false);
                                   Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");

                                   atualizaValorGlobalFinanceiro();
                               }
                               else {
                                   Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                               }
                           })
                           .fail(function (e) {
                               Notificar("@RsBase.ATENCAO_", e.responseJSON.message, "warning");
                           });
                   }
               });
           }

           handleExcluir();

           $("#btnAdicionarMaterial").on('click', async function () {
               var erro = false

               if (oDatatableMaterial.data().filter(x => x.Codigo == $("#iMaterial").val()).toArray().length > 0) {
                   Notificar("@RsBase.ATENCAO_", "@String.Format("O Material informado, já está inserido na lista abaixo!!")", "warning");
                   erro = true;
               }

               if (!$("#iMaterial").val()) {
                   Notificar("@RsBase.ATENCAO_", "@String.Format("Informe o Material!!")", "warning");
                   erro = true;
               }

               if (erro) {
                   return false;
               }

               oDatatableMaterial.row.add({
                   Id: 0,
                   Codigo: $("#iMaterial").val(),
                   Descricao: $("#iMaterial option:selected").text()
               }).draw(false);

               await AddSelect("iMaterial", "@CONSTANTES.URLPortal/api/MaterialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
               handleExcluir();
           });
        },
        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtonsMaterial();
                }
            }
        }();

        TableManageButtons.init();

        //..Datatable Atividades

        //Datatable Atividades Instalação
        var handleDataTableButtonsInstalacao = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.ConfiguracaoNFInstalacao));
            var nome_lista = "ConfiguracaoNFInstalacao";//Nome_utilizado para enganar o razor


            oDatatableInstalacao = $("#datatableAtividadeInstalacao").length && $("#datatableAtividadeInstalacao").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                ordering: false,
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            return '<a href="#" class="btnExcluirAtividadeInstalacao" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;padding-right:2px;"></i></a>' +
                                '<input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(row.Id) + '">' +
                                '<input id="' + nome_lista + '_' + meta.row + '__IdClassificacaoTributaria" name="' + nome_lista + '[' + meta.row + '].IdClassificacaoTributaria" type="hidden" value="' + TrataNulo(row.IdClassificacaoTributaria) + '">' +
                                '<input id="' + nome_lista + '_' + meta.row + '__ModeloNotaFiscal" name="' + nome_lista + '[' + meta.row + '].ModeloNotaFiscal" type="hidden" value="' + TrataNulo(row.ModeloNotaFiscal) + '">';
                        }
                    },
                    {
                        data: "DescModeloNotaFiscal",
                        title: "@RsCadastros.MODELO_NOTA_FISCAL"
                    },
                    {
                        data: "DescClassificacaoTributaria",
                        title: "@RsCadastros.CLASSIFICACAO_TRIBUTARIA",
                    },
                    {
                        data: "PercentualDiscriminado",
                        title: "@RsCadastros.PERCENTUAL_DISCRIMINADO %",
                        render: function (data, type, row, meta) {
                            return data + ' <input id="' + nome_lista + '_' + meta.row + '__PercentualDiscriminado" name="' + nome_lista + '[' + meta.row + '].PercentualDiscriminado" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                    },
                    {
                        data: "DescEmpresa",
                        title: "@RsCadastros.EMPRESA",
                        render: function (data, type, row, meta) {
                            return data + ' <input id="' + nome_lista + '_' + meta.row + '__Id_Empresa" name="' + nome_lista + '[' + meta.row + '].Id_Empresa" type="hidden" value="' + TrataNulo(row.Id_Empresa) + '">';
                        }
                    },
                    {
                        data: "DescFilial",
                        title: "@RsCadastros.FILIAL",
                        render: function (data, type, row, meta) {
                            return data + ' <input id="' + nome_lista + '_' + meta.row + '__Id_Empresa" name="' + nome_lista + '[' + meta.row + '].Id_Filial" type="hidden" value="' + TrataNulo(row.Id_Filial) + '">';
                        }
                    },
                ]
            });

            function handleExcluir() {

                $(".btnExcluirAtividadeInstalacao").click(function (e) {
                    e.preventDefault();

                    var idAtividade = $(this).attr("excluir");
                    var trLinkButton = $(this).parents('tr');

                    if (idAtividade === "0") {

                        oDatatableInstalacao.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");

                        atualizaValorGlobalInstalacao()
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/planoapi/ExcluirConfigNF?value=")' + idAtividade;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                        .done(function (data) {

                            if (data.ok) {

                                oDatatableInstalacao.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");

                                atualizaValorGlobalInstalacao();
                            }
                            else {

                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                        .fail(function (e) {

                            Notificar("@RsBase.ATENCAO_", e.responseJSON.message, "warning");
                        })
                    }
                });
            }


            function limpaControlesNotaFiscalInstalacao() {
                $("#iPercentual_Instalacao").val(null)
                $("#iModeloNotaFiscalInstalacao").val(null).trigger("change")
               /* $('#iId_Cfop_Instalacao').val(null).trigger("change")*/
            }

            function atualizaValorGlobalInstalacao() {

                const valor_discriminado_total = oDatatableInstalacao.data().map(p => {
                    if (p.ValorDiscriminado)
                        return parseFloat(p.ValorDiscriminado);
                    else {
                        let valorPlano = parseFloat($('#iValorPlano').val().replace(",", "."))
                        let valor = valorPlano * (p.PercentualDiscriminado.replace('%', '') / 100);
                        return parseFloat(valor.toFixed(2));
                    }
                }).reduce((a, b) => a + b, 0)

                const valor_instalacao = parseFloat($('#iValorInstalacao').val().replace(",", "."))
                const valor_instalacao_final = isNaN(valor_instalacao) ? 0 : valor_instalacao

                global_instalacao_valor_discriminado_total = valor_discriminado_total;
                global_instalacao_valor_instalacao_final = valor_instalacao_final;

            }

            handleExcluir();

            $("#btnAdicionarAtividadeInstalacao").on('click', function () {

                var erro = false;

                if (!$("#iModeloNotaFiscalInstalacao").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MODELO_NOTA_FISCAL)", "warning")
                    erro = true
                }

                if (!$("#iClassificacaoTributariaInstalacao").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CLASSIFICACAO_TRIBUTARIA)", "warning")
                    erro = true
                }

                if (!$("#iPercentual_Instalacao").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, "Percentual da Instalação")", "warning")
                    erro = true
                }
                else {
                    let percentual_install_datatable = oDatatableInstalacao.data().map(p => p.PercentualDiscriminado === NaN || p.PercentualDiscriminado === "" ? 0 : parseFloat(p.PercentualDiscriminado.replace('%', ''))).reduce((a, b) => a + b, 0);
                    let percentual_install_total = 0;

                    if (!isNaN(percentual_install_datatable)) {

                        if (percentual_install_datatable >= 100) {
                            Notificar("@RsBase.ATENCAO_", "O total da composição da NF não pode ser maior que 100%.", "warning")
                            erro = true;
                        }
                        else {

                            let valorAdc = parseFloat($("#iPercentual_Instalacao").val().replace(",", "."));

                            percentual_install_total = parseFloat(valorAdc + percentual_install_datatable);

                            console.log("valor percentual total");
                            console.log(percentual_install_total);

                            if (percentual_install_total > 100) {
                                Notificar("@RsBase.ATENCAO_", "O total da composição da NF ultrapassa o 100%.", "warning")
                                erro = true;
                            }
                        }
                    }

                    global_instalacao_percentual_total = percentual_install_total;
                }

                if (erro) {
                    return false;
                }

                oDatatableInstalacao.row.add({
                    Id: 0,
                    ModeloNotaFiscal: $("#iModeloNotaFiscalInstalacao").val(),
                    DescModeloNotaFiscal: $("#iModeloNotaFiscalInstalacao option:selected").text(),
                    IdClassificacaoTributaria: $("#iClassificacaoTributariaInstalacao").val(),
                    DescClassificacaoTributaria: $("#iClassificacaoTributariaInstalacao option:selected").text(),
                    PercentualDiscriminado: $("#iPercentual_Instalacao").val(),
                    Id_Empresa: $('#iEmpresaInstalacao').val(),
                    Id_Filial: $('#iFilialInstalacao').val(),
                    DescEmpresa: $('#iEmpresaInstalacao option:selected').text(),
                    DescFilial: $('#iFilialInstalacao option:selected').text()
                }).draw(false);

                $("#iValor_Discriminado_Instalacao").val(null);
                $("#iClassificacaoTributariaInstalacao").val(null).trigger("change");
                $('#iModeloNotaFiscalInstalacao').val(null).trigger('change')
                $("#iPercentual_Instalacao").val(null).trigger("change");
                $('#iEmpresaInstalacao').val(null).trigger('change');
                $('#iFilialInstalacao').val(null).trigger('change');

                atualizaValorGlobalInstalacao();

                handleExcluir();
            });
        },
        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtonsInstalacao();
                }
            }
        }();

        TableManageButtons.init();

        //..Datatable Atividades Instalação

        //Datatable Mensalidades

        var handleDataTableButtons = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Mensalidades));
            var nome_lista = "Mensalidades";//Nome_utilizado para enganar o razor


            oDatatableMensalidade = $("#datatableMensalidade").length && $("#datatableMensalidade").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            return '<a href="#" class="btnExcluirMensalidade" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">'
                        }
                    },
                    {
                        data: "Parcela_Ini",
                        title: "@RsCadastros.PARCELA_INI",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Parcela_Ini" name="' + nome_lista + '[' + meta.row + '].Parcela_Ini" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Parcela_Fin",
                        title: "@RsCadastros.PARCELA_FIN",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Parcela_Fin" name="' + nome_lista + '[' + meta.row + '].Parcela_Fin" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Percentual_Desconto",
                        title: "@RsCadastros.PERCENTUAL_DESCONTO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                if (data == null)
                                    data = '';
                                else
                                    data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Percentual_Desconto" name="' + nome_lista + '[' + meta.row + '].Percentual_Desconto" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Valor_Desconto",
                        title: "@RsCadastros.VALOR_DESCONTO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                if (data == null)
                                    data = '';
                                else
                                    data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Valor_Desconto" name="' + nome_lista + '[' + meta.row + '].Valor_Desconto" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    }
                ]
            });

            function handleExcluir() {
                $(".btnExcluirMensalidade").click(function (e) {
                    e.preventDefault();

                    var idMensalidade = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idMensalidade === "0") {
                        oDatatableMensalidade.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {
                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/planoapi/ExcluirMensalidade?value=")' + idMensalidade;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json'
                        })
                        .done(function (data) {
                            if (data.ok) {
                                oDatatableMensalidade.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                        .fail(function (e) {
                            Notificar("@RsBase.ATENCAO_", e.responseJSON.message, "warning");
                        });
                    }
                });
            }

            handleExcluir();

            $("#btnAdicionarMensalidade").on('click', function () {
                var erro = false;

                if (!$("#iParcela_Ini").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PARCELA_INI)", "warning");
                    erro = true;
                }
                if (!$("#iParcela_Fin").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PARCELA_FIN)", "warning");
                    erro = true;
                }

                if (erro) {
                    return false;
                }

                oDatatableMensalidade.row.add({
                    Id: 0,
                    Parcela_Ini: $("#iParcela_Ini").val(),
                    Parcela_Fin: $("#iParcela_Fin").val(),
                    Percentual_Desconto: $("#iPercentual_Desconto").val(),
                    Valor_Desconto: $("#iValor_Desconto").val()
                }).draw(false);

                $("#iParcela_Ini").val(null);
                $("#iParcela_Fin").val(null);
                $("#iPercentual_Desconto").val(null);
                $("#iValor_Desconto").val(null);

                handleExcluir();
            });
        },
        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtons();
                }
            }
        }();

        TableManageButtons.init();

        //..Datatable Mensalidades

        function NotificarMais60CaracteresNaoAbrirModal(Titulo, Texto, Status, Tempo = 10000, onClose) {

            Texto = Traduzir(decodeHtmlEntity(Texto));

            try {
                parent.mkNoti(
                    Titulo,
                    Texto,
                    {
                        status: Status,
                        icon: {
                            class: null,
                            color: null,
                            background: null
                        },
                        dismissable: true,
                        duration: Tempo,
                        callback: null,
                        sound: false,
                        customSound: null
                    }
                );
            }
            catch (ex) {
                mkNoti(
                    Titulo,
                    Texto,
                    {
                        status: Status,
                        icon: {
                            class: null,
                            color: null,
                            background: null
                        },
                        dismissable: true,
                        duration: Tempo,
                        callback: null,
                        sound: false,

                        customSound: null
                    }
                );
            }
        }

        $("#instalacao-tab, #composicao-plano-tab, #financeiro-tab, #desconto-tab, #telefonia-tab, #configuracoes-rede-tab, #configuracoes-adicionais-tab, #relatorio-anatel-tab").
            on("click", function (e) {
                var idDesc = $("#iDescricaoPlano").val();
                var idVal = $("#iValorPlano").val();
                $("#divIdDescricaoPlanoComp, #divIdDescricaoPlanoComp01").empty();
                var html = `
                <label for="iDescricaoPlanoComp"><b>Plano</b></label>
                <div class="col-sm-12">
                    <div class="row">
                        <div class="col-sm-8">
                            <input id="iDescricaoPlanoComp" type="text" class="form-control" style="width: 40rem !important; border: none" value="${idDesc}"/>
                        </div>
                        <div class="col-sm-4">
                            <input id="iValorPlanoComp" type="text" class="form-control" style="border: none" value="R$ ${idVal}"/>
                        </div>
                    </div>
                </div>
                `;
                $("#divIdDescricaoPlanoComp, #divIdDescricaoPlanoComp01").append(html);
        });

        var handleModeloContrato = function () {
            $('#iModeloContrato').on('select2:select select2:unselecting', function (e) {
                var ModeloContratoSelecionado = e.params.data;
                let possuiCarencia = ModeloContratoSelecionado.possuiCarencia;
                let periodoCarencia = ModeloContratoSelecionado.periodoCarencia;
                if (possuiCarencia == true) {
                    $("#iTemCarencia").text("Sim");
                    $("#mdcontratope").show();
                    $("#iPeriodoCarencia").text(periodoCarencia);
                    @Model.Tem_Carencia = true;
                }
                else {
                    $("#iTemCarencia").text("@RsBase.NAO");
                    $("#mdcontratope").hide();
                    @Model.Tem_Carencia = false;
                }
                return true;
            }
            )}


</script>
}

@using (Html.BeginForm("Cadastro", "Plano", FormMethod.Post, htmlAttributes: new { @id = "form", @autocomplete = "off" }))
{
    @Html.AntiForgeryToken()

    Model.Cobranca_Recorrente = Sinapse.Model.enumerados.Padrao.Nao;
    Model.Momento_Cobranca_Plano = Momento_Cobranca_Plano.Fechamento_Faturamento;

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">

                <div class="sticky-top bg-white">
                    <div class="row">
                        <div class="col main-title">
                            <h4 class="title-page"> @RsCadastros.CADASTRO_PLANO</h4>

                            <nav aria-label="breadcrumb" class="mb-20">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                    </li>

                                    <li class="breadcrumb-item">
                                        <a href="@Url.Action("Index", "Plano_Produto")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELPLANOSPRODUTOS</a>
                                    </li>

                                    <li class="breadcrumb-item">
                                        <span>@RsCadastros.CADASTRO_PLANO</span>
                                    </li>

                                </ol>
                            </nav>
                        </div>


                    </div>

                    <div class="sticky-top">
                        <ul class="nav nav-tabs" id="myTab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="dados-gerais-tab" data-toggle="tab" href="#iDadosGerais" role="tab" aria-selected="true"><i class="fas fa-wifi"></i> &nbsp; @RsCadastros.PLANO</a>

                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="instalacao-tab" data-toggle="tab" href="#iInstalacao" role="tab" aria-selected="false"> <i class="fas fa-cogs"></i> @RsCadastros.INSTALACAO</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="composicao-plano-tab" data-toggle="tab" href="#iComposicaoPlano" role="tab" aria-selected="false"> <i class="fa fa-align-justify"></i> @RsCadastros.COMPOSICAO_PLANO</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="financeiro-tab" data-toggle="tab" href="#iFinanceiro" role="tab" aria-selected="false"><i class="fas fa-hand-holding-usd"></i> @RsCadastros.FINANCEIRO </a>
                            </li>
                            @*<li class="nav-item">
                                    <a class="nav-link" id="desconto-tab" data-toggle="tab" href="#iDesconto" role="tab" aria-selected="false"><i class="fas fa-percentage"></i> @RsCadastros.DESCONTO </a>
                                </li>*@
                            <li class="nav-item" id="iNavTelefonia" style="display:none">
                                <a class="nav-link" id="telefonia-tab" data-toggle="tab" href="#iTelefonia" role="tab" aria-selected="false"><i class="fas fa-mobile"></i> &nbsp; @RsCadastros.TELEFONIA</a>
                            </li>
                            <li class="nav-item" id="iNavInternet" style="display:none">
                                <a class="nav-link" id="configuracoes-rede-tab" data-toggle="tab" href="#iConfiguracoesRede" role="tab" aria-selected="false"><i class="icofont-wifi-router"></i> &nbsp; @RsCadastros.CONFIGURACOES_REDE </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="configuracoes-adicionais-tab" data-toggle="tab" href="#iConfiguracoesAdicionais" role="tab" aria-selected="false"><i class="fas fa-plus"></i> @RsCadastros.CONFIGURACOES_ADICIONAIS </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="relatorio-anatel-tab" data-toggle="tab" href="#iRelatorioAnatel" role="tab" aria-selected="false"><i class="fas fa-plus"></i> @RsCadastros.RELATORIO_ANATEL_DICI </a>
                            </li>
                        </ul>
                    </div>

                </div>

                <div class="tab-content">

                    <div role="tabpanel" class="tab-pane active" id="iDadosGerais">

                        <!--Bloco1-->
                        <!--Dados do Plano-->
                        <div id="accordion">
                            <div class="card div-card-accord">
                                <div class="card-header title-card" id="heading-1">
                                    <h5 class="mb-0">
                                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                            <span class="text-bold-card">@RsConfiguracao.DADOSPLANO</span>
                                        </a>
                                    </h5>
                                </div>
                                <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                    <div class="card-body body-card-accord">

                                        <div class="row  mt-3">
                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label for="iCodigoPlano">@RsConfiguracao.CODIGO :</label>
                                                    @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control col-sm-8 ", @id = "iCodigoPlano", disabled = "disabled" })
                                                    @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    <label for="iDescricaoPlano">@RsConfiguracao.DESCRICAO :</label>
                                                    @Html.TextBoxFor(m => m.Descricao, new { @class = "form-control", @id = "iDescricaoPlano", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="col-sm-2">
                                                <label for="iTipoPlanoProduto">@RsCadastros.TIPO :</label>
                                                <div class="form-group">
                                                    @Html.EnumDropDownListFor(p => p.Tipo, RsBase.SELECIONE, new { @class = "form-control", @id = "iTipoPlanoProduto", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.Tipo, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            @if (Model.Id != 0)
                                            {
                                                <div class="col-sm-2">
                                                    <div class="form-group">
                                                        <label for="iSituacaoPlano" class="mb-1">@RsConfiguracao.STATUS :</label><br>
                                                        @Html.CheckBoxFor(m => m.SituacaoPlano, new { @class = "form-control", @id = "iSituacaoPlano", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                                        @Html.ValidationMessageFor(model => model.SituacaoPlano, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <div class="row  mt-3">
                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label for="ValorPlano">@RsConfiguracao.VALORPLANO<span style="color:red">*</span></label>
                                                    @Html.TextBoxFor(m => m.ValorPlano, new { @class = "form-control money", @placeholder = "0,00", @id = "iValorPlano", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.ValorPlano, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <label for="iTipoTecnologia">@RsCadastros.TIPO_PLANO :</label>
                                                <div class="form-group">
                                                    @Html.EnumDropDownListFor(p => p.Tipo_Tecnologia, RsBase.SELECIONE, new { @class = "form-control", @id = "iTipoTecnologia", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.Tipo_Tecnologia, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label for="iNomeVenda">Nome Para Venda:</label>
                                                    @Html.TextBoxFor(m => m.Nome_Venda, new { @class = "form-control", @id = "iNomeVenda", @autocomplete = "off", @maxlength = "100" })
                                                    @Html.ValidationMessageFor(model => model.Nome_Venda, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                        </div>
                                        <div class="row mt-3">

                                            <div class="col-sm-10">
                                                <div class="form-group">
                                                    <label for="iDetalhesPlano">@RsConfiguracao.DETALHES :</label>
                                                    @Html.TextAreaFor(m => m.Detalhes, new { @class = "form-control", @id = "iDetalhesPlano", @rows = "4" })
                                                    @Html.ValidationMessageFor(model => model.Detalhes, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mt-3 center">
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label for="iStatusInicial">@RsConfiguracao.STATUSINICIAL :</label>
                                                    @Html.EnumDropDownListFor(m => m.StatusInicial, RsBase.SELECIONE, new { @class = "form-control", @id = "iStatusInicial", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.StatusInicial, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                </div>
                            </div>
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane " id="iInstalacao">
                        <!--Instalação-->
                        <div id="accordion">
                            <div class="card div-card-accord">
                                <div class="card-header title-card" id="heading-2">
                                    <h5 class="mb-0">
                                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-2" aria-expanded="true" aria-controls="collapse-2">
                                            <span class="text-bold-card"> @RsCadastros.INSTALACAO</span>
                                        </a>
                                    </h5>
                                </div>
                                <div id="collapse-2" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                                    <div class="card-body body-card-accord">

                                        <div class="row mt-3">
                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label for="iCobrancaInstalacao" class="mb-1">@RsConfiguracao.COBRANCAINSTALACAO ?</label><br>
                                                    @Html.CheckBoxFor(m => m.CobrancaInstalacao, new { @class = "form-control", @id = "iCobrancaInstalacao", @name = "my-checkbox", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>

                                            <!--Ativado por opCobrancaInstalacaoSim-->


                                            <div class="col-sm-3" id="diviCobrancaInstalacaoEntrada" style="display:none;">
                                                <div class="form-group">
                                                    <label for="iCobrancaInstalacaoEntrada" class="mb-1">@RsCadastros.HAVERA_VALOR_ENTRADA_INSTALACAO</label><br>
                                                    @Html.CheckBoxFor(m => m.CobrancaInstalacaoEntrada, new { @class = "form-control", @id = "iCobrancaInstalacaoEntrada", @name = "my-checkbox", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })

                                                </div>
                                            </div>
                                            <div class="col-sm-2" id="diviValorInstalacao" style="display:none;">
                                                <div class="form-group">
                                                    <label for="lblValorInstalacao">@RsConfiguracao.VALORINSTALACAO :</label>
                                                    @Html.TextBoxFor(m => m.ValorInstalacao, new { @class = "form-control money", @placeholder = "0,00", @id = "iValorInstalacao", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.ValorInstalacao, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-sm-3" id="divQtdParcelas" style="display:none;">
                                                <div class="form-group">
                                                    <label for="iQtdParcelas">@RsConfiguracao.QTDPARCELAS @RsCadastros.INSTALACAO:</label>
                                                    @Html.TextBoxFor(m => m.QtdParcelas, new { @class = "form-control col-sm-6 integer", @id = "iQtdParcelas" })
                                                </div>
                                            </div>
                                            <div class="col-sm-2" id="divcomprovantepagamentoInstalacao" style="display:none">
                                                <div class="form-group">
                                                    <label for="iComprovantePagamento" class="mb-1">@RsConfiguracao.COMPROVANTEPAGAMENTO:</label><br>
                                                    @Html.EnumDropDownListFor(m => m.ComprovantePagamentoFinanceiro, RsBase.SELECIONE, new { @class = "form-control", @id = "iComprovantePagamentoInstalacao", @autocomplete = "off", @required = "True" })
                                                </div>
                                            </div>

                                            <div class="col-sm-3" id="divmomentocobrancainstalacao" style="display:none">
                                                <div class="form-group">
                                                    <label for="iMomentoCobrancaInstalcao" class="mb-1">@RsCadastros.MOMENTO_COBRANCA_INSTALACAO:</label><br>
                                                    @Html.EnumDropDownListFor(m => m.Momento_Cobra_Instalacao, RsBase.SELECIONE, new { @class = "form-control", @id = "iMomentoCobrancaInstalcao", @autocomplete = "off", @required = "True" })
                                                </div>
                                            </div>

                                            <div class="col-sm-3" id="ModReciboInstalacao" style="display:none">
                                                <div class="form-group">
                                                    <label for="iId_ReciboInstalacao">@RsConfiguracao.MODELORECIBO:</label>
                                                    @Html.DropDownListFor(p => p.Id_ReciboInstalacaco, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iId_ReciboInstalacao", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.Id_ReciboInstalacaco, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                        </div>

                                        <div class="row mt-3">

                                            <div class="col-sm-4" id="iDescContaFinanceiraInstalacao">
                                                <label for="iDescContaFinanceira">@RsConfiguracao.CONTAFINANCEIRAINSTALACAO :</label>
                                                <div class="form-group">
                                                    @Html.DropDownListFor(p => p.Id_ContaFinanceiraInstalacao, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "idContaFinanceiraInstalacao", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.Id_ContaFinanceiraInstalacao, "", new { @class = "text-danger" })
                                                </div>
                                            </div>



                                        </div>
                                        <div class="row mt-3">

                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label for="iOSTrocaEndereco" class="mb-1">@RsConfiguracao.OSTROCAENDERECO ?</label><br>
                                                    @Html.CheckBoxFor(m => m.OSTrocaEndereco, new { @class = "form-control", @id = "iOSTrocaEndereco", @name = "my-checkbox", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>

                                        </div>

                                        <div class="row mt-3">

                                            <!--Ativado por opPrimeiroFaturamento-->


                                        </div>
                                        @*<div class="row mt-3">
                                                <div class="col-sm-3">
                                                    <div class="form-group">
                                                        <label for="ImpedirBloqueio_Automatico">@RsConfiguracao.IMPEDIRBLOQUEIO ?</label><br>
                                                        @Html.CheckBoxFor(m => m.ImpedirBloqueio_Automatico, new { @class = "form-control", @id = "ImpedirBloqueio_Automatico", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                        <br>

                                                        <div class="bloqueiodatas">
                                                            @Html.CheckBoxFor(m => m.ImpedirBloqueio_Sexta, new { @id = "ImpedirBloqueio_Automaticosexta" })
                                                            <span> @RsConfiguracao.SEXTAFEIRA </span><br>
                                                        </div>
                                                        <div class="bloqueiodatas">
                                                            @Html.CheckBoxFor(m => m.ImpedirBloqueio_Sabado, new { @id = "ImpedirBloqueio_Automaticosabado" })
                                                            <span> @RsConfiguracao.SABADO </span><br>
                                                        </div>
                                                        <div class="bloqueiodatas">
                                                            @Html.CheckBoxFor(m => m.ImpedirBloqueio_Domingo, new { @id = "ImpedirBloqueio_Automaticodomingo" })
                                                            <span> @RsConfiguracao.DOMINGO </span><br>
                                                        </div>
                                                        <div class="bloqueiodatas">
                                                            @Html.CheckBoxFor(m => m.ImpedirBloqueio_Feriados, new { @id = "ImpedirBloqueio_Automaticoferiado" })
                                                            <span> @RsConfiguracao.FERIADOS </span>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>*@
                                        <!--Nota Fiscal Instalação-->
                                        <div id="bloconf_instalacao">
                                            <div class="card-header mt-3" style="background:white" id="heading-7">
                                                <h5 class="col-sm-6">
                                                    <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-5" aria-expanded="true" aria-controls="collapse-5">
                                                        <span class="text-bold-card">@RsConfiguracao.NOTAFISCAL</span>
                                                    </a>
                                                </h5>
                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-sm-3">
                                                    <div class="form-group">
                                                        <label for="iModeloNotaFiscalInstalacao" class="mb-1">@RsConfiguracao.MODELONOTAFISCAL:</label><br>
                                                        @Html.EnumDropDownListFor(m => m.ModeloNotaFiscalInstalacao, RsBase.SELECIONE, new { @class = "form-control", @id = "iModeloNotaFiscalInstalacao", @autocomplete = "off" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-3">
                                                    <div class="form-group">
                                                        <label for="iClassificacaoTributariaInstalacao">@RsCadastros.CLASSIFICACAO_TRIBUTARIA:</label>
                                                        <select id="iClassificacaoTributariaInstalacao" class="form-control">
                                                            <option value="">@RsBase.SELECIONE</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-sm-2">
                                                    <div class="form-group">
                                                        <label for="iValor_Discriminado_Instalacao" class="mb-1">@RsCadastros.DESC_VALOR_PERCENTUAL:</label><br>
                                                        @Html.TextBoxFor(model => model.Valor_Discriminado_Instalacao, new { @id = "iPercentual_Instalacao", @class = "form-control money" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-3">
                                                    <div class="form-group" id="cfop">
                                                        <label for="iEmpresaInstalacao">@RsCadastros.EMPRESA :</label>
                                                        @Html.DropDownListFor(p => p.Id_Empresa, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iEmpresaInstalacao", @autocomplete = "off" })
                                                        @Html.ValidationMessageFor(model => model.Id_Filial, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-3">
                                                    <div class="form-group" id="cfop">
                                                        <label for="iFilialInstalacao">@RsCadastros.FILIAL :</label>
                                                        @Html.DropDownListFor(p => p.Id_Filial, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iFilialInstalacao", @autocomplete = "off" })
                                                        @Html.ValidationMessageFor(model => model.Id_Filial, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>

                                            </div>
                                            <div class="col-sm-12 text-right m-2">
                                                <input type="button" id="btnAdicionarAtividadeInstalacao" value="Adicionar" class="btn btn-success" />
                                            </div>

                                            <div class="col-sm-12">
                                                <div class="card-header title-card" id="heading-6">
                                                    <h5 class="col-sm-6">
                                                        <span class="text-bold-card">@RsConfiguracao.COMPOSICAONF</span>
                                                    </h5>
