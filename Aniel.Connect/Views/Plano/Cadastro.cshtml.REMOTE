                                                </div>
                                            </div>
                                        </div>-->
                                        @*</div>*@

                                        <!--Fim opNotaFiscal-->
                                        <!--Ativado por opCfop-->
                                        <!--<div class="row mt-3">
                                                <div class="col-sm-2">
                                                    <div class="form-group" id="cfop">
