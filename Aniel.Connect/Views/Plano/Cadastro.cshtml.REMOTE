                                    </div>

                                    <div class="col-sm-12 text-right m-2">
                                        <input type="button" id="btnAdicionarAtividade" value="Adicionar" class="btn btn-success" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="idivNotaFiscal">
                            <div class="card div-card-accord">
                                <div class="card-header title-card" id="heading-41">
                                    <h5 class="mb-0">
                                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-41" aria-expanded="true" aria-controls="collapse-41">
                                            <span class="text-bold-card">@RsConfiguracao.COMPOSICAONF</span>
                                        </a>
                                    </h5>
                                </div>
                                <div id="collapse-41" class="collapse show" data-parent="#accordion" aria-labelledby="heading-41">
                                    <div class="card-body body-card-accord">
                                        <div class="card-body body-card-accord">
                                            <div class="col-sm-12">
                                                @*<div class="card-header title-card" id="heading-6">
                                                    <h5 class="col-sm-6">
                                                        <span class="text-bold-card">@RsConfiguracao.COMPOSICAONF</span>
                                                    </h5>
                                                                </div>*@
                                                <div class="row mt-3">
                                                    <div class="form-group">
                                                        <div id="divIdDescricaoPlanoComp01">
                                                        </div>
                                                    </div>
                                                </div>
                                                <table class="table table-hover nowrap" id="datatableAtividade" style="width:100%"></table>
                                            </div>
