                        </div>
                    </div>

                    <div role="tabpanel" class="tab-pane " id="iDesconto">
                        <!--Descontos-->
                        <div id="accordion">
                            <div class="card div-card-accord">
                                <div class="card-header title-card" id="heading-5">
                                    <h5 class="mb-0">
                                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-5" aria-expanded="true" aria-controls="collapse-5">
                                            <span class="text-bold-card">@RsConfiguracao.DESCONTO</span>
                                        </a>
                                    </h5>
                                </div>
                                <div id="collapse-5" class="collapse show" data-parent="#accordion" aria-labelledby="heading-5">
                                    <div class="card-body body-card-accord">

                                        <div class="row">

                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label for="iUtilizaDesconto">@RsCadastros.DESCONTO.Insert(0, "Utiliza ") ? </label><br>
                                                    @Html.CheckBoxFor(m => m.Utiliza_Desconto, new { @class = "form-control", @id = "iUtilizaDesconto", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })

                                                </div>
                                            </div>


                                            <div class="col-sm-2 d-none" id="iDivDesconto">
                                                <div class="form-group">
                                                    <label for="iDescontoSelect">Escolha o desconto que será vinculado a este modelo: </label>
                                                    @Html.DropDownListFor(m => m.Desconto, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @id = "iDescontoSelect", @class = "form-control" })

                                                </div>
                                            </div>
                                        </div>


                                    </div>
                                </div>
                            </div>
                        </div>
                        <!--Desconto-->

                        <div class="row ml-0 mr-0" id="iFaixaMensalidaContainer" style="display:none">
                            <div id="accordion" class="col-sm-6 pl-0">
                            </div>
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane " id="iTelefonia">
                        <div id="accordion">
                            <div class="card div-card-accord">
                                <div class="card-header title-card" id="heading-8">
                                    <h5 class="mb-0">
                                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-8" aria-expanded="true" aria-controls="collapse-8">
                                            <span class="text-bold-card">@RsCadastros.TELEFONIA</span>
                                        </a>
                                    </h5>
                                </div>
                                <div id="collapse-8" class="collapse show" data-parent="#accordion" aria-labelledby="heading-8">
                                    <div class="card-body body-card-accord">

                                        <div class="row  mt-3">
                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label for="iFormatoPlano" class="">Formato do Plano</label>

                                                </div>
                                            </div>
                                        </div>
                                        <div class="row  mt-1">
                                            <div class="col-sm-1">
                                                <div class="form-group">
                                                    @Html.RadioButtonFor(model => model.Formato_do_plano, "Nacional", new { @id = "iFormatoPlanoNacional", @data_toggle = "toggle" })
                                                    <label for="iFormatoPlanoNacional"> @RsCadastros.NACIONAL </label>
                                                </div>
                                            </div>

                                            <div class="col-sm-1">
                                                <div class="form-group">
                                                    @Html.RadioButtonFor(model => model.Formato_do_plano, "Internacional", new { @id = "iFormatoPlanoInternacional", @data_toggle = "toggle" })
                                                    <label for="iFormatoPlanoInternacional"> @RsCadastros.INTERNACIONAL</label>
                                                </div>
                                            </div>
                                        </div>


                                        <div class="row  mt-1">

                                            <div class="col-sm-2">
                                                <label for="iFormatoTarifaTelefonia">@RsCadastros.FORMATO_TARIFACAO :</label>
                                                <i class="fas fa-info-circle" style="color: #2092EC" data-placement="top" data-toggle="popover"
                                                   data-content="Brasil = O Cliente realizará chamadas no formato que
                                                                 salvou em seu celular para completar ligações para qualquer lugar do Brasil ou
                                                                 E.164 = Neste modelo o padrão de envio de chamadas será definido por: código
                                                                 país + Código Nacional + número. Ex: 55 54 21218910">
                                                </i>
                                                <div class="form-group">
                                                    @Html.EnumDropDownListFor(p => p.FormatoTarifaTelefonia, RsBase.SELECIONE, new { @class = "form-control", @id = "iFormatoTarifaTelefonia", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.FormatoTarifaTelefonia, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>


                                        <div class="row  mt-1">
                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label for="iUtiliza_Integracao_Externa"> @RsCadastros.UTILIZA_INTEGRACAO_? </label>
                                                    @Html.CheckBoxFor(model => model.Utiliza_Integraca_Externa, new { @id = "iUtiliza_Integracao_Externa", @class = "form-control", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row  mt-1" id="iDivIntegracao">
                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label for="iIntegracao_Externa"> @(RsBase.SELECIONE + " o " + RsCadastros.SERVICO_INTEGRACAO): </label>

                                                    @Html.EnumDropDownListFor(model => model.Integracao, new { @id = "iIntegracao_Externa", @class = "form-control" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row  mt-1">
                                            <div class="col-sm-3">
                                                <div class="form-group">
                                                    <label for="iNum_Dids">@RsCadastros.SELECIONE_QUANTIDADE_DID_AUTO</label>
                                                    @{
                                                        var listaNumDids = new List<Aniel.Connect.Core.ObjComboResult<String>>();
                                                        for (int i = 0; i < 1000; i++)
                                                        {
                                                            listaNumDids.Add(new Aniel.Connect.Core.ObjComboResult<string>
                                                            {
                                                                Id = i.ToString(),
                                                                Text = i.ToString()
                                                            });
                                                        }
                                                    }

                                                    @Html.DropDownListFor(p => p.Num_Dids, new SelectList(listaNumDids, "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iNum_Dids", @autocomplete = "off" })
                                                </div>
                                            </div>

                                            <div class="col-sm-3" id="div_cobrancaTelefonia">
                                                <div class="form-group">
                                                    <label for="iCobranca_Telefonia"> Cobrar Por: </label>
                                                    <i class="fas fa-info-circle" style="color: #2092EC" data-placement="top" data-toggle="popover"
                                                       data-content="Cobrar por Circuito - Só um DID será cobrado e os demais
                                                                   serão zerados Ex.: DID1 = R$ 19,90 + DID2 = R$ 0,00 = TOTAL = R$ 19,90
                                                                   Cobrar por DID - O valor será cobrado para cada DID Ex.: DID1 = R$ 19,90
                                                                   + DID2 = R$ 19,90 = TOTAL = R$ 39,80">
                                                    </i>
                                                    @Html.EnumDropDownListFor(model => model.Cobrar_Por_Telefonia, RsBase.SELECIONE, new { @id = "iCobranca_Telefonia", @class = "form-control" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-1" id="divCadenciaInternacional">
                                            <div class="col-sm-1">
                                                <div class="form-group">
                                                    <label for="">Multiplicador</label>
                                                    @Html.TextBoxFor(m => m.MultiplicadorInternacional, new { @id = "iMultiplicadorInternacional", @type = "number", @class = "form-control", @min = "1" })
                                                    @Html.ValidationMessageFor(m => m.MultiplicadorInternacional, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-sm-1">
                                                <div class="form-group">
                                                    <label for="iCadenciaInternacional">@RsCadastros.CADENCIA :</label>
                                                    <i class="fas fa-info-circle" style="color: #2092EC" data-toggle="popover" data-placement="top"
                                                       data-content="Cadência é o método utilizado
                                                                     na telefonia para cobrar o minuto de uma ligação, representam (em
                                                                     segundos): 30 = Tempo mínimo de tarifação da chamada - 6 = Cobrança
                                                                     será realizada de 6 em 6 segundos"></i>
                                                    @Html.TextBoxFor(m => m.CadenciaInternacional, new { @class = "form-control cadencia", @id = "iCadenciaInternacional", @maxlength = "8" })
                                                    @Html.ValidationMessageFor(model => model.CadenciaInternacional, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-1">
                                            <div class="col-auto" id="iDivPossuiFranquia">
                                                <div class="form-group">
                                                    <label for="iPossuiFranquia" class="mb-1">@RsCadastros.POSSUI_FRANQUIA  ?</label><br>
                                                    @Html.CheckBoxFor(m => m.PossuiFranquia, new { @class = "form-control", @id = "iPossuiFranquia", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>
                                            <div class="col-sm-2" id="iDivFranquia" style="display:none">
                                                <div class="form-group">
                                                    <label for="iFranquia">@RsCadastros.ESCOLHA_FRANQUIA :</label>
                                                    @Html.DropDownListFor(p => p.IdFranquia, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iFranquia", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.IdFranquia, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-1">
                                            <div class="col-auto" id="iDivPossuiConsumoMinimo">
                                                <div class="form-group">
                                                    <label for="iPossuiConsumoMinimo" class="mb-1">@RsCadastros.VALOR_MINIMO  ?</label>
                                                    <i class="fas fa-info-circle" style="color: #2092EC" data-toggle="popover" data-placement="top"
                                                       data-content="Permite definir um valor de consumo mínimo das ligações do cliente, ou seja,
                                                                     se ele gastar em ligações menos que este valor, será cobrado este valor em
                                                                     sua conta mensal">

                                                    </i><br>
                                                    @Html.CheckBoxFor(m => m.PossuiConsumoMinimo, new { @class = "form-control", @id = "iPossuiConsumoMinimo", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>
                                            <div class="col-sm-1" id="iDivConsumoMinimo" style="display:none">
                                                <div class="form-group">
                                                    <label for="iConsumoMinimo">@RsCadastros.VALOR a Cobrar :</label>
                                                    @Html.TextBoxFor(m => m.ConsumoMinimo, new { @class = "form-control money", @id = "iConsumoMinimo" })
