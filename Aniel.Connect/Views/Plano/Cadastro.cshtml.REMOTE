                                        </div>


                                    </div>
                                </div>
                            </div>
                            <table class="table table-hover nowrap" id="datatableAtividadeInstalacao" style="width:100%"></table>
                        </div>
                    </div>

                    <div role="tabpanel" class="tab-pane " id="iComposicaoPlano">
                        <!--Composição do Plano-->
                        <div id="accordion">
                            <div class="card div-card-accord">
                                <div class="card-header title-card" id="heading-10">
                                    <h5 class="mb-0">
                                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-10" aria-expanded="true" aria-controls="collapse-10">
                                            <span class="text-bold-card">@RsConfiguracao.COMPOSICAO_PLANO </span>
                                        </a>
                                    </h5>
                                </div>
                                <div id="collapse-10" class="collapse show" data-parent="#accordion" aria-labelledby="heading-10">
                                    <div class="card-body body-card-accord">
                                        <div class="col-sm-12">
                                            <div class="row mt-3">
                                                <div class="col-sm-2">
                                                    <div class="form-group" id="">
                                                        <label for="iProdutosComp">@RsCadastros.PRODUTOS<span style="color:red">*</span>:</label><br>
                                                        @Html.DropDownListFor(m => m.IdProdutosComp, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iProdutosComp", @autocomplete = "off" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-2">
                                                    <div class="form-group" id="">
                                                        <label for="iTipo_Discriminado_Comp">@RsCadastros.TIPO_VALOR_DISCRIMINADO<span style="color:red">*</span>:</label><br>
                                                        @Html.EnumDropDownListFor(m => m.Tipo_Discriminado, RsBase.SELECIONE, new { @class = "form-control", @id = "iTipo_Discriminado_Comp", @autocomplete = "off" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-2" id="PercntDiscComp">
                                                    <div class="form-gorup">
                                                        <label for="iPercentual_Discriminado_Comp">@RsCadastros.PERCENTUAL_DISCRIMINADO:</label>
                                                        @Html.TextBoxFor(model => model.Percentual_Discriminado_Comp, new { @class = "form-control", @id = "iPercentual_Discriminado_Comp", @type = "number", @min = "0" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-2" id="valordiscComp">
                                                    <div class="form-group">
                                                        <label for="iValor_Discriminado_Comp" class="mb-1">@RsCadastros.VALOR_DISCRIMINADO:</label><br>
                                                        @Html.TextBoxFor(model => model.Valor_Discriminado_Comp, new { @id = "iValor_Discriminado_Comp", @class = "form-control money", @placeholder = "0,00" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-4 text-right m-2" id="divBtnAdicionarProdutosComp">
                                                    <input type="button" id="btnAdicionarProdutosComp" value="Adicionar" class="btn btn-success" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-sm-12">
                                            <div class="row mt-3">
                                                <div class="form-group">
                                                    <div id="divIdDescricaoPlanoComp">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-sm-12">
                                            <table class="table table-hover nowrap" id="datatableProdutosComp" style="width:100%"></table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div role="tabpanel" class="tab-pane " id="iFinanceiro">
                        <!--Financeiro-->
                        <div id="accordion">
                            <div class="card div-card-accord">
                                <div class="card-header title-card" id="heading-4">
                                    <h5 class="mb-0">
                                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-4" aria-expanded="true" aria-controls="collapse-4">
                                            <span class="text-bold-card">@RsConfiguracao.FINANCEIRO </span>
                                        </a>
                                    </h5>
                                </div>
                                <div id="collapse-4" class="collapse show" data-parent="#accordion" aria-labelledby="heading-4">
                                    <div class="card-body body-card-accord">


                                        <div class="row mt-3">
                                            <div class="col-sm-2" id="mdcontrato">
                                                <div class="form-group">
                                                    <label for="iModeloContrato">@RsConfiguracao.MODELOCONTRATO :</label>
                                                    @Html.DropDownListFor(m => m.IdModeloContrato, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iModeloContrato", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.DescModeloContrato, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label for="iTemCarencia">@RsCadastros.TEM_CARRENCIA?</label><br />
                                                    <span id="iTemCarencia"> </span>
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <div id="mdcontratope">
                                                    <div class="form-group">
                                                        <label for="iPeriodoCarencia">@RsCadastros.PERIODO_CARENCIA</label><br />
                                                        <span id="iPeriodoCarencia"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label for="FrequenciaCobranca" class="mb-1">@RsConfiguracao.FREQUENCIACOBRANCA :</label><br>
                                                    @Html.EnumDropDownListFor(m => m.FrequenciaCobranca, RsBase.SELECIONE, new { @class = "form-control", @id = "IFrequenciaCobranca", @autocomplete = "off" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mt-3">
                                            <div class="col-sm-2" id="divformatocobranca">
                                                <div class="form-group">
                                                    <label for="IFormatoCobranca">@RsConfiguracao.FORMATOCOBRANCA :</label>
                                                    @Html.EnumDropDownListFor(m => m.FormatoCobranca, RsBase.SELECIONE, new { @class = "form-control", @id = "IFormatoCobranca", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.FormatoCobranca, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label for="iMomento_Cobranca_Plano" class="mb-1">@RsCadastros.MOMENTO_COBRANCA :</label><br>
                                                    @Html.EnumDropDownListFor(m => m.Momento_Cobranca_Plano, RsBase.SELECIONE, new { @class = "form-control", @id = "IMomento_Cobranca_Plano", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.Momento_Cobranca_Plano, "", new { @class = "text-danger" })
                                                </div>
                                            </div>


                                            <div class="col-sm-2" id="iDescContaFinanceiraPlano">
                                                <label for="iDescContaFinanceiraPlano">@RsConfiguracao.CONTAFINANCEIRA :</label>
                                                <div class="form-group">
                                                    @Html.DropDownListFor(p => p.Id_ContaFinanceiraPlano, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "idContaFinanceiraPlano", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.Id_ContaFinanceiraPlano, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="col-sm-2" id="iBloqAutoDebito">
                                                <div class="form-group">
                                                    <label for="ibloq_auto_debito" class="mb-1">@RsConfiguracao.BLOQUEIO_AUTO_DEBITO  ?</label><br>
                                                    @Html.CheckBoxFor(m => m.BLOQUEIO_AUTO_DEBITO, new { @class = "form-control", @id = "ibloq_auto_debito", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>
                                            <div class="col-sm-2" id="qtdDiasbloqueados">
                                                <div class="form-group">
                                                    <label for="QtdDiasbloqueados">@RsConfiguracao.QTDDIASATRASO :</label>
                                                    @Html.TextBoxFor(m => m.QtdDiasbloqueados, new { @class = "form-control col-sm-6", @type = "number", @id = "QtdDiasbloqueados" })
                                                    @Html.ValidationMessageFor(model => model.QtdDiasbloqueados, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            @if (@Model.ProRata == true)
                                            {
                                                <div class="col-sm-2">
                                                    <div class="form-group">
                                                        <label for="iCobranca_Recorrente" class="mb-1">@RsCadastros.COBRANCA_RECORRENTE :</label><br>
                                                        @Html.EnumDropDownListFor(m => m.Cobranca_Recorrente, RsBase.SELECIONE, new { @class = "form-control", @id = "ICobranca_Recorrente", @autocomplete = "off" })
                                                        @Html.ValidationMessageFor(model => model.Cobranca_Recorrente, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            }


                                        </div>
                                        @* fim *@
                                        <div class="row mt-3">


                                            <div class="col-sm-2" id="divcomprovantepagamento">
                                                <div class="form-group">
                                                    <label for="iComprovantePagamento" class="mb-1">@RsConfiguracao.COMPROVANTEPAGAMENTO ?</label><br>
                                                    @Html.EnumDropDownListFor(m => m.ComprovantePagamento, RsBase.SELECIONE, new { @class = "form-control", @id = "iComprovantePagamento", @autocomplete = "off", @required = "True" })
                                                    @Html.ValidationMessageFor(model => model.ComprovantePagamento, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-sm-2" id="ModRecibo">
                                                <div class="form-group">
                                                    <label for="iId_Recibo">@RsConfiguracao.MODELORECIBO:</label>
                                                    @Html.DropDownListFor(p => p.Id_Recibo, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iId_Recibo", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.Id_Recibo, "", new { @class = "text-danger" })
                                                </div>
                                            </div>


                                        </div>

                                        <!--Fim opSemCobranca-->
                                        <!--Ativado por opNotaFiscal-->
                                        <!--<div id="bloconf">
                                            <div class="row mt-3">
                                                <div class="col-sm-2">
                                                    <div class="form-group" id="mdnotafiscal">
                                                        <label for="iModeloNotaFiscal" class="mb-1">@RsConfiguracao.MODELONOTAFISCAL :</label><br>
                                                        @Html.EnumDropDownListFor(m => m.ModeloNotaFiscal, RsBase.SELECIONE, new { @class = "form-control", @id = "iModeloNotaFiscal", @autocomplete = "off" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-2">
                                                    <div class="form-group" id="desc_atividade">
                                                        <label for="iClassificacaoTributaria">@RsCadastros.CLASSIFICACAO_TRIBUTARIA:</label>
                                                        <select id="iClassificacaoTributaria" class="form-control">
                                                            <option value="">@RsBase.SELECIONE</option>
                                                        </select>
                                                    </div>
                                                </div>-->
                                        @*<div class="row">*@
