                                                                      cobrado o valor cadastrado"></i><br>
                                                    @Html.CheckBoxFor(m => m.HabilitarLc, new { @class = "form-control", @id = "iHabilitarLc", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
