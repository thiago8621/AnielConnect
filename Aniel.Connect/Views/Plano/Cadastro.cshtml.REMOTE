        function validaTesteGratis() {
            if ($("#iTesteGratis").is(':checked')) {
                if ($('#IFormatoCobranca').val() == "0") {
                    Notificar("@RsBase.ATENCAO_", 'Não é Possível Habilitar Teste Grátis e Formato de Cobrança Pré-Pago ao mesmo tempo.', "warning");
                    return false
                }
            }

            return true
        }

        function validaProRata() {
            let ok = true;
            if ($("#iProRata").is(':checked')) {
                if ($('#IFormatoCobranca').val() == "0") {
                    Notificar("@RsBase.ATENCAO_", 'Não é Possível Habilitar Pró-Rata e Formato de Cobrança Pré-Pago ao mesmo tempo.', "warning");
                    ok = false;
                    return ok;
                }
                if ($("#iCobranca_Recorrente").is(":checked")) {

                    const param =@Html.Raw(Json.Encode(new List<String> { RsBase.ATENCAO_, RsConfiguracao.PRORATAPLANO, String.Concat("warning") }));

                    Notificar(param[0], param[1], param[2]);
                    ok = false;
                    return ok;
                }
            }

            return ok;
        }

       function CarregaModeloAnatel(param){

            if ($('#iModelo_Anatel option:selected').val() == 1) {

                $('#AnatelTecnologia').show();
                $('#AnatelTipoProduto').show();
                $('#AnatelTipoProdutoST').hide();
                $('#AnatelAcessoAnatel').show();
                $('#AnatelRegime').hide();
                $('#AnatelTarifa').hide();
                $('#AnatelModalidade').hide();
                $('#iRegime').val('');
                $('#iTarifa_Anatel').val('');
                $('#iModalidade_Anatel').val('');

                if (param) {
                    $('#iTecnologia_Anatel').val('');
                    $('#iTipo_Produto').val('');
                    $('#iAcesso_Anatel').val('');
                }

            }
            else if ($('#iModelo_Anatel option:selected').val() == 2) {
                $('#AnatelTecnologia').show();
                $('#AnatelRegime').hide();
                $('#AnatelTipoProduto').hide();
                $('#AnatelTipoProdutoST').show();
                $('#AnatelAcessoAnatel').hide();
                $('#AnatelTarifa').hide();
                $('#AnatelModalidade').hide();
                $('#iAcesso_Anatel').val('');
                $('#iRegime').val('');
                $('#iTarifa_Anatel').val('');
                $('#iModalidade_Anatel').val('');
                if (param) {
                    $('#iTecnologia_Anatel').val('');
                    $('#iTipo_ProdutoST').val('');
                }
            }
            else if ($('#iModelo_Anatel option:selected').val() == 3) {
                $('#AnatelRegime').show();
                $('#AnatelTecnologia').hide();
                $('#AnatelTipoProdutoST').hide();
                $('#AnatelTipoProduto').hide();
                if (param) {
                    $('#iRegime').val('');

                }

            }
            else if ($('#iModelo_Anatel option:selected').val() == 4) {
                $('#AnatelTecnologia').show();
                $('#AnatelRegime').hide();
                $('#AnatelTipoProduto').hide();
                $('#AnatelTipoProdutoST').hide();
                $('#AnatelAcessoAnatel').show();
                $('#AnatelTarifa').hide();
                $('#AnatelModalidade').hide();
                $('#iTipo_Produto').val('');
                $('#iRegime').val('');
                $('#iTarifa_Anatel').val('');
                $('#iModalidade_Anatel').val('');

                if (param) {
                    $('#iTecnologia_Anatel').val('');
                    $('#iAcesso_Anatel').val('');
                }
            }
            else {
                $('#AnatelTecnologia').hide();
                $('#AnatelRegime').hide();
                $('#AnatelTipoProduto').hide();
                $('#AnatelTipoProdutoST').hide();
                $('#AnatelAcessoAnatel').hide();
                $('#AnatelTarifa').hide();
                $('#AnatelModalidade').hide();
                $('#iTecnologia_Anatel').val('');
                $('#iTipo_Produto').val('');
                $('#iAcesso_Anatel').val('');
                $('#iRegime').val('');
                $('#iTarifa_Anatel').val('');
                $('#iModalidade_Anatel').val('');
            }
        };


        $('#IFormatoCobranca').change(function () {
            if (!validaTesteGratis() || !validaProRata()) {
                $('#IFormatoCobranca').val("")
            }
        });

        $("#iCobranca_Recorrente").on("change", function () {
            if ($(this).prop("checked") == true && !validaProRata()) {
                $(this).prop("checked", false);
                $('#iSelectMomento_Cobranca_Plano').val(2);
                return false;
            }
        })

        $('#iTesteGratis').change(function () {

            if (!validaTesteGratis()) {
                $('#iTesteGratis').bootstrapToggle('off');
                $('#iTesteGratis').prop("checked",false);
            }

            // Se igual a analitico
            if ($("#iTesteGratis").is(':checked')) {

                if ($('#IFormatoCobranca').val() == "0") {

                }

                $("#diasdeteste").show();

            }
            else {
                $("#diasdeteste").hide();
            }

        });

        $('#iPlano_Comercializavel').change(function () {

            // Se igual a analitico
            if ($("#iPlano_Comercializavel").is(':checked')) {

                $(".naoComercializavel").hide();

                $('#iMomento_Cobranca').val(null);
                $('#iCobranca_Realizada').val(null);
                $('#iDias_Vencimento').val(null);
            }
            else {
                $(".naoComercializavel").show();
                $("#iMomento_Cobranca").trigger("change");
            }
        });

    $('#iCobranca_Realizada').on("change", function () {

        let valorSelecionado = $("#iCobranca_Realizada").val();

        if (valorSelecionado == "0") {
            $("#apenasBoleto").show();
            $("#iDivDiasVencimentos").show();
        }
        else if (valorSelecionado == "" || valorSelecionado == undefined) {
            $("#apenasBoleto").hide();
            $("#iDivDiasVencimentos").hide();
        } else {
            $("#iDivDiasVencimentos").hide();
            $("#apenasBoleto").hide();
        }
    });

    $("#iMomento_Cobranca").on("change", function () {
        let valorMomento = $("#iMomento_Cobranca").val();

        if (valorMomento == "1") {
            $('#iCobranca_Realizada option[value="0"]').hide();
            $('#iDias_Vencimento').val(null);
            $('#iCobranca_Realizada').val(1).trigger("change");
        }
        else if (valorMomento == "" || valorMomento == undefined) {
            $('#iCobranca_Realizada').val(null).trigger("change");
        }
        else {
            $('#iCobranca_Realizada option[value="0"]').show();
        }
    });

    $('#iProRata').change(function () {

        if (!validaProRata()) {
            $('#iProRata').bootstrapToggle('off');
            $('#iProRata').prop("checked", false);
        }

        // Se igual a analitico
        if ($("#iProRata").is(':checked')) {
            $("#opcoesprorata").show();//show()
            $("#iPro_Rata_Habilitacao").prop('checked', 'true');
            $("#iPro_Rata_Interrupcao").prop('checked', 'true');
            $("#iPro_Rata_Cancelamento").prop('checked', 'true');
        }
        else {
            $("#opcoesprorata").hide();
            $("#iPro_Rata_Habilitacao").prop('checked', 'false');
            $("#iPro_Rata_Habilitacao").prop('checked', 'false');
            $("#iPro_Rata_Habilitacao").prop('checked', 'false');
        }

    });

        $('#iComprovantePagamento').change(function () {
