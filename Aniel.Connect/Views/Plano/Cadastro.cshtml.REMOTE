        var TipoServicoSelecionado = null;
        var HandleTipoServico = function () {
            $('#iTipo_Servico').unbind('select2:select select2:unselecting');
            $('#iTipo_Servico').on('select2:select select2:unselecting', function (e) {
                TipoServicoSelecionado = e.params.data;
                $('#iSubtipo_Servico').val(null).trigger('change');
                if(TipoServicoSelecionado) {
                    AddSelect("iSubtipo_Servico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, TipoServicoSelecionado.id, null, "@RsBase.SELECIONE", false, HandleSubTipoServico);
                } else {
                    AddSelect("iSubtipo_Servico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleSubTipoServico);
                }
                return true;
            });
        };

        var SubTipoServicoSelecionado = null;
        var HandleSubTipoServico = function () {
            $('#iSubtipo_Servico').on('select2:select select2:unselecting', function (e) {
                SubTipoServicoSelecionado = e.params.data;
                return true;
            });
        };

        var TipoServicoSelecionadoOS = null;
        var HandleTipoServicoOS = function () {
            $('#iTipo_ServicoOS').unbind('select2:select select2:unselecting');
            $('#iTipo_ServicoOS').on('select2:select select2:unselecting', function (e) {
                TipoServicoSelecionadoOS = e.params.data;
                $('#iSubtipo_ServicoOS').val(null).trigger('change');
                if(TipoServicoSelecionadoOS) {
                    AddSelect("iSubtipo_ServicoOS", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, TipoServicoSelecionadoOS.id, null, "@RsBase.SELECIONE", false, HandleSubTipoServicoOS);
                } else {
                    AddSelect("iSubtipo_ServicoOS", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleSubTipoServicoOS);
                }
                return true;
            });
        };

        var SubTipoServicoSelecionadoOS = null;
        var HandleSubTipoServicoOS = function () {
            $('#iSubtipo_ServicoOS').on('select2:select select2:unselecting', function (e) {
                SubTipoServicoSelecionadoOS = e.params.data;
                return true;
            });
        };

        function valida_Tipo_Tecnologia_Campos(erro) {
            var count = 0;
            var Tipo_Tecnologia = $("#iTipoTecnologia").val();

            //Tipo_Tecnologia Telefonia Fixo / Tipo_Tecnologia Telefonia Móvel
            if (Tipo_Tecnologia == "1" || Tipo_Tecnologia == "4")
            {
                if ($("#iFormatoTarifaTelefonia").val() == "") {
                    Notificar("@RsBase.ATENCAO_","Campo @RsCadastros.OBRIGATORIO : @RsCadastros.FORMATO_TARIFACAO ","warning");
                    count++;
                }

                if ($("#iCobranca_Telefonia").val() == "") {
                    Notificar("@RsBase.ATENCAO_", "Campo @RsCadastros.OBRIGATORIO : Cobrar Por ", "warning"); count++;
                    count++;
                }
            }

            switch (Tipo_Tecnologia)
            {
                //Tipo_Tecnologia Inválido
                case "":
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TIPO_PLANO)", "warning");
                    count++;
                    break;

                //Tipo_Tecnologia Internet
                case "2":
                    if ($("#iVelocidadeDownload").val() =="") {
                        Notificar("@RsBase.ATENCAO_", "Campo @RsCadastros.OBRIGATORIO : @RsConfiguracao.VELOCIDADEDOWNLOAD ", "warning");
                        count++;
                    }

                    if ($("#iVelocidadeUpload").val() == "") {
                        Notificar("@RsBase.ATENCAO_", "Campo @RsCadastros.OBRIGATORIO : @RsConfiguracao.VELOCIDADEUPLOAD ", "warning");
                        count++;
                    }

                    if ($("#iVelocidadeNominal").val() == "") {
                        Notificar("@RsBase.ATENCAO_", "Campo @RsCadastros.OBRIGATORIO : @RsConfiguracao.VELOCIDADENOMINAL ", "warning");
                        count++;
                    }

                    break;

                //Tipo_Tecnologia TV
                case "3":
                    break;

                //Tipo_Tecnologia Serviços Adicionais
                case "5":
                    break;
            }

            erro = count > 0 ? true : erro;

            return erro;
        }

        var clicked = false;

        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;

            var erro = false;

            if (!validaProRata())
                erro = true

            if (!validaTesteGratis())
                erro = true

            erro = valida_Tipo_Tecnologia_Campos(erro);

            atualizaValorGlobalFinanceiro();


        if ($("#iUsaPlanoAdicional").is(':checked')) {
              if ($('#iUtilizaVendaAgroup').is(":checked")) {

                let valor = $('#iValorVendaAgroup').val();

                let valorVenda = parseFloat(valor.replace(',', '.')).toFixed(2);

                if (valorVenda < 0.01 || valorVenda == NaN || valorVenda === undefined || valor === "") {
                    Notificar("@RsBase.ATENCAO_", `@RsCadastros.OBRIGATORIO preencher com valor maior do que zero`, "warning")
                    erro = true;
                }
            }
        }

            if ($('#iComprovantePagamento').val() === "1") {
                if (global_plano_valor_discriminado_total != global_plano_valor_plano_final &&
                    $('#datatableAtividade').DataTable().rows().data().toArray().length > 0)
                {
                    Notificar("@RsBase.ATENCAO_", `Total da composição da nota fiscal do plano <strong class=text-primary> R$ ${global_plano_valor_discriminado_total} </strong><br> deve ser igual ao valor do plano <strong class=text-danger> R$ ${global_plano_valor_plano_final} </strong>.`, "warning")
                    erro = true
                }
            }

            if ($('#iComprovantePagamentoInstalacao').val() === "1") {
                if (global_instalacao_percentual_total > 100) {
                    Notificar("@RsBase.ATENCAO_", `Total da composição da nota fiscal da instalação <strong class=text-primary> R$ ${global_instalacao_percentual_total} </strong><br> não pode ser maior que <strong class=text-danger> 100% </strong>.`, "warning")
                    erro = true
                }
            }

            if ($("#iAutenticacaoRadius").is(':checked')) {

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/RadiusApi/CadastrarPlano?Name=")' + $("#iDescricaoPlano").val() + "&Download="
                    + $("#iVelocidadeDownload").val() + "&Upload=" + $("#iVelocidadeUpload").val();

                $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',
                    async: false
                })
            }

            if ($("#iTesteGratis").is(':checked')) {
                if ($('#iDiasTeste').val() <= 0 || $('#iDiasTeste').val() == "") {
                    Notificar("@RsBase.ATENCAO_", 'Informe a quantidade de dias de teste ', "warning");
                    erro = true;
                }
            }

            @*if ($('#select2-iTecnologia-container').text() == "Selecione") {
                Notificar("@RsBase.ATENCAO_", 'Informe uma tecnologia', "warning");
                erro = true;
            } else {
                $('#select2-iTecnologia-container').text()
            }*@

            if ($('#iCobrancaInstalacao').is(':checked')) {
                if ($('#iValorInstalacao').val() == "" || $('#iValorInstalacao').val() == 0) {
                    Notificar("@RsBase.ATENCAO_", '@RsFinanceiro.INFORMEVALOR_INSTALACAO', "warning");
                    erro = true;
                }
            }


            if ($('#iAutenticacaoRadius').is(':checked')) {
                if ($('#iServidorRadius option:selected').val() == "") {
                    Notificar("@RsBase.ATENCAO_", 'Informe o Servidor Radius', "warning");
                    erro = true;
                }
            }

            if ($("#iReducaoVelocidade").is(':checked')) {
                if ($('#iQtdDiasAtraso').val() <= 0 || $('#iQtdDiasAtraso').val() == "") {
                    Notificar("@RsBase.ATENCAO_", 'Informe os dias de atraso', "warning");
                    erro = true;
                }

                if ($('#iVelocidadeDownloadReduzida').val() <= 0 || $('#iVelocidadeDownloadReduzida').val() == "") {
                    Notificar("@RsBase.ATENCAO_", '@RsCadastros.INFORME_VELOCIDADEDOWNLOADREDUZIDA', "warning");
                    erro = true;
                }

                if ($('#iVelocidadeUploadReduzida').val() <= 0 || $('#iVelocidadeUploadReduzida').val() == "") {
                    Notificar("@RsBase.ATENCAO_", '@RsCadastros.INFORME_VELOCIDADEUPLOADREDUZIDA', "warning");
                    erro = true;
                }
            }


            if ($('#iValorPlano').val() == 0) {
                Notificar("@RsBase.ATENCAO_", '@RsFinanceiro.INFORMEVALOR_PLANO', "warning");
                erro = true;
            }


            if ($('#iTipoCobrancaInstalacao option:selected').val() == 1 && $('#iQtdParcelas').val() <= 0) {
                Notificar("@RsBase.ATENCAO_", '@RsFinanceiro.INFORMEQTD_PARCELA', "warning");
                erro = true;
            }



            if ($('#iStatusInicial option:selected').val() == @Convert.ToInt16(Status_PlanoProduto.Aguardando_Criacao_OS) &&
                !$('#iTipo_Servico option:selected').val()) {
                Notificar("@RsBase.ATENCAO_", 'Informe um @RsCadastros.TIPO_SERVICO', "warning");
                erro = true;
            }

            if (utiliza_eva) {
                if ($('#idContaFinanceiraPlano').is(":visible")){
                    if(!$('#idContaFinanceiraPlano').val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsConfiguracao.CONTAFINANCEIRA)", "warning");
                        erro = true;
                    }

                }
                if ($('#iCobrancaInstalacao').is(':checked')) {

                    if (!$('#iComprovantePagamentoInstalacao').val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsConfiguracao.COMPROVANTEPAGAMENTOINSTALACAO)", "warning");
                        erro = true;
                    }

                    if (!$('#idContaFinanceiraInstalacao').val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsConfiguracao.CONTAFINANCEIRAINSTALACAO)", "warning");
                        erro = true;
                    }
                    if (!$('#iMomentoCobrancaInstalcao').val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsConfiguracao.MODOCOBRANCAINSTALACAO)", "warning");
                        erro = true;
                    }
                }
                if ($('#IFormatoCobranca').is(":visible")) {

                    if (!$('#IFormatoCobranca').val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsConfiguracao.FORMATOCOBRANCA)", "warning");
                        erro = true;
                    }
                }

                if(!$('#IFrequenciaCobranca').val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsConfiguracao.FREQUENCIACOBRANCA)", "warning");
                    erro = true;
                }

                if ($('#iComprovantePagamento').is(":visible")) {

                    if (!$('#iComprovantePagamento').val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsConfiguracao.COMPROVANTEPAGAMENTO)", "warning");
                        erro = true;
                    }
                }
            }

            if ($("#iDefinirTipo_SubTipoOS").is(":checked")) {
                if (!$('#iTipo_ServicoOS').val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TIPO_SERVICO)", "warning");
                    erro = true;
                }
            }


        @if (Model.Id == 0)
            {
                <text>
                    if ($('#iAtivarValidade').is(':checked')) {
                        var data = $('#iValidade').val();
                        var partesData = data.split("/");

                        var data = new Date(partesData[2], partesData[1] - 1, partesData[0]);

                        if (data < new Date()) {
                            Notificar("Atenção!", '@RsCadastros.INFORME_DATAVALIDA', "warning");
                            erro = true;
                        }

                        if ($('#iValidade').val() == "") {
                            Notificar("@RsBase.ATENCAO_", '@RsCadastros.INFORME_DATAVALIDADEPLANO', "warning");
                            erro = true;
                        }
                    }
                </text>
            }

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
        }

        //Datatable Plano Produtos Composição
    var handleDataPlanoProdutosCompTableButtons = function () {
        "use strict";

        var array = @Html.Raw(Json.Encode(Model.PlanoProdutosComp));
        var nome_lista = "PlanoProdutosComp";

        oDatatablePlanoProdutosComp = $("#datatableProdutosComp").length && $("#datatableProdutosComp").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: array,
            columns: [
                {
                    data: "Id",
                    render: function (data, type, row, meta) {
                        return `<a href="#" class="btnExcluirPlanoProdutosComp" id="btnExcluirPlanoProdutosComp_${meta.row}" excluirPlanoProdutosComp="${row.IdProdutosComp}" excluirPlanoProdutosId="${row.Id}">
                                    <i class="far fa-trash-alt" style="font-size:16px;padding-right:2px;"></i>
                                </a>` +
                            '<input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(row.Id) + '">' +
                            '<input id="' + nome_lista + '_' + meta.row + '__IdProdutosComp" name="' + nome_lista + '[' + meta.row + '].IdProdutosComp" type="hidden" value="' + TrataNulo(row.IdProdutosComp) + '">';
                    },
                    orderable: false
                },
                {
                    data: "DescricaoProdutosComp",
                    title: "@RsCadastros.DESC_ESTRUTURA_PRODUTOS_COMP",
                    render: function (data, type, row, meta) {
                        return data + ' <input id="' + nome_lista + '_' + meta.row + '__DescricaoProdutosComp" name="' + nome_lista + '[' + meta.row + '].DescricaoProdutosComp" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
                {
                    data: "ValorFixo",
                    title: "@RsCadastros.DESC_VALOR_FIXO",
                    render: function (data, type, row, meta) {
                        return data + ' <input id="' + nome_lista + '_' + meta.row + '__ValorFixo" name="' + nome_lista + '[' + meta.row + '].ValorFixo" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
                {
                    data: "ValorPercentual",
                    title: "@RsCadastros.DESC_VALOR_PERCENTUAL",
                    render: function (data, type, row, meta) {
                        return data + ' <input id="' + nome_lista + '_' + meta.row + '__ValorPercentual" name="' + nome_lista + '[' + meta.row + '].ValorPercentual" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
                {
                    data: "ValorTotal",
                    title: "@RsCadastros.DESC_VALOR_TOTAL",
                    render: function (data, type, row, meta) {
                        return data + ' <input id="' + nome_lista + '_' + meta.row + '__ValorTotal" name="' + nome_lista + '[' + meta.row + '].ValorTotal" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
            ]
        });

        function handleExcluir() {
            $(".btnExcluirPlanoProdutosComp").click(function (e) {
                e.preventDefault();

                var idProdutosCompTmp_oDatatable = $(this).attr("excluirPlanoProdutosComp");
                var id_ProdutosCompParam = $(this).attr("excluirPlanoProdutosId");

                var trLinkButton = $(this).parents('tr');
                var rowsDataTableAtividade = $('#datatableAtividade tbody tr').toArray();

                if (id_ProdutosCompParam === "0") {
                    oDatatablePlanoProdutosComp.row(trLinkButton).remove().draw(false);
                    for (var i = 0; i < rowsDataTableAtividade.length; i++) {
                        oDatatable.row(rowsDataTableAtividade).remove().draw(false);
                    }
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");

                    atualizaValorGlobalFinanceiro();
                }
                else {
                    var listaArrayIds = oDatatable.rows().data().toArray();
                    var Ids = listaArrayIds.filter(x => x.Id_Produtos_Comp == idProdutosCompTmp_oDatatable).map(x => x.Id);
                    let link = '@String.Concat(CONSTANTES.URLPortal, "/api/ProdutosCompApi/ExcluirPlanoProdutosComp?value=")' + id_ProdutosCompParam + `&IdPlano=${@Model.Id}`;
                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json'
                    })
                        .done(function (data) {
                            if (data.ok) {
                                oDatatablePlanoProdutosComp.row(trLinkButton).remove().draw(false);
                                for (var i = 0; i < rowsDataTableAtividade.length; i++) {
                                    oDatatable.row(rowsDataTableAtividade).remove().draw(false);
                                }
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");

                                atualizaValorGlobalFinanceiro();
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                        .fail(function (e) {
                            Notificar("@RsBase.ATENCAO_", e.responseJSON.message, "warning");
                        });
                }
            });
        }

        function limpaControlesNotaFiscalFinanceiro() {
            $("#iValor_Discriminado_Comp").val(null);
            $("#iPercentual_Discriminado_Comp").val(null);
        }

        function atualizaValorGlobalFinanceiro() {
            const valor_discriminado_total = oDatatablePlanoProdutosComp.data().map(p => {
                if (p.ValorTotal) {
                    // Remover pontos de milhar e substituir a vírgula por ponto decimal
                    let valorCorrigido = parseFloat(p.ValorTotal.replace(/\./g, "").replace(",", "."));
                    return valorCorrigido;
                } else {
                    let valorPlano = parseFloat($('#iValorPlano').val().replace(/\./g, "").replace(",", "."));
                    let percentual = parseFloat(p.ValorPercentual.replace('%', '').replace(",", ".")) / 100;
                    let valor = valorPlano * percentual;
                    return parseFloat(valor.toFixed(2)); // Mantém a precisão de 2 casas decimais
                }
            }).reduce((a, b) => a + b, 0);
            const valor_plano = parseFloat($('#iValorPlano').val().replace(",", "."))
            const valor_plano_final = isNaN(valor_plano) ? 0 : valor_plano

            global_plano_valor_discriminado_total = valor_discriminado_total.toFixed(2);

            global_plano_valor_plano_final = valor_plano_final;
        }

        handleExcluir();

        $("#idBotao").on("click", function () {
            let vari = $("#iTipo_Discriminado_Comp").val();
            let valorPlano = 0;
            Discriminado(vari, valorPlano);

        })

        /**
         * @@param number_Type {number} número do valor a ser discriminado
         */
        function Discriminado(number_Type, valorPlano) {
            //Com o valor discriminado e valor do plano, adquirir percentual
            if (number_Type == 1) {
                let valor = parseFloat($("#iValor_Discriminado_Comp").val().replace(",", "."));
                let discriminadoPercentual = parseFloat(((valor * 100) / valorPlano).toFixed(2));
                $("#iPercentual_Discriminado_Comp").val(discriminadoPercentual.toLocaleString());
            }

            //Com o percentual discriminado e valor do plano, adquirir valor
            else if (number_Type == 2) {
                var valorAcumulado = oDatatablePlanoProdutosComp.data().map(p => parseFloat(p.ValorTotal.replace(',', '.'))).reduce((a, b) => a + b, 0)
                let discriminadoValor = parseFloat((($("#iPercentual_Discriminado_Comp").val() * (valorPlano)) / (100)).toFixed(2));

                if ((discriminadoValor + valorAcumulado) > valorPlano) {
                    discriminadoValor = valorPlano - valorAcumulado
                }

                $("#iValor_Discriminado_Comp").val(discriminadoValor.toLocaleString());
            }
        }

        $("#btnAdicionarProdutosComp").on('click', function () {
            var erro = false;

            const valor_plano = parseFloat(($('#iValorPlano').val()).replace(",", "."));
            const valor_plano_final = isNaN(valor_plano) ? 0 : valor_plano;

            let tipoDiscriminado = $("#iTipo_Discriminado_Comp").val();

            if (tipoDiscriminado == 2) { 
                let percentualAcumulado = oDatatablePlanoProdutosComp.data().map(p => parseFloat(p.ValorPercentual)).reduce((a, b) => a + b, 0);
                if (percentualAcumulado + parseFloat($("#iPercentual_Discriminado_Comp").val()) > 100)
                {
                    Notificar("@RsBase.ATENCAO_", "O total de percentuais está ultrapassando 100%!", "warning");
                    erro = true;
                }
            }

            if (oDatatablePlanoProdutosComp.data().filter(x => x.IdProdutosComp == $("#iProdutosComp").val()).toArray().length > 0) {
                Notificar("@RsBase.ATENCAO_", "O Produto informado, já está inserido na lista abaixo!", "warning");
                erro = true;
            }

            if (!$("#iProdutosComp").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PRODUTOS)", "warning");
                erro = true;
            }

            if (!$("#iTipo_Discriminado_Comp").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TIPO_VALOR_DISCRIMINADO)", "warning");
                erro = true;
            }

            
            if ((!$("#iValor_Discriminado_Comp").val() && !$("#iPercentual_Discriminado_Comp").val()) || $("#iValor_Discriminado_Comp").val() == "0") {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.VALOR_DISCRIMINADO)", "warning");
                erro = true;
            }
            if (erro) {
                return false;
            }
            Discriminado(tipoDiscriminado, valor_plano);
            
            var valor_discriminado_total = 0;

            // Loop para somar os valores do DataTable
            for (var i = 0; i < oDatatablePlanoProdutosComp.data().length; i++) {
                let valorStr = oDatatablePlanoProdutosComp.data()[i].ValorTotal.toString();
                // Substituir apenas a vírgula do decimal, mantendo milhar intacto
                let valorCorrigido = parseFloat(valorStr.replace(/\./g, "").replace(",", "."));
                valor_discriminado_total += valorCorrigido;
            }

            let inputValue = $("#iValor_Discriminado_Comp").val();
            let valorInputCorrigido = parseFloat(inputValue.replace(/\./g, "").replace(",", "."));
            valor_discriminado_total += valorInputCorrigido;

            if (valor_plano_final < valor_discriminado_total.toFixed(2)) {
                valor_discriminado_total = oDatatablePlanoProdutosComp.data().map(p => parseFloat(p.ValorTotal)).reduce((a, b) => a + b, 0);
                limpaControlesNotaFiscalFinanceiro();
                Notificar("@RsBase.ATENCAO_", "Total de valores discriminados está ultrapassando o valor total do produto.", "warning");
                erro = true;
            }

            global_valor_discriminado_total = valor_discriminado_total.toFixed(2);

            global_valor_plano_final = valor_plano_final;
            

            oDatatablePlanoProdutosComp.row.add({
                Id: 0,
                IdProdutosComp: $("#iProdutosComp").val(),
                DescricaoProdutosComp: $("#iProdutosComp option:selected").text(),
                ValorFixo: $("#iValor_Discriminado_Comp").val() ? $("#iValor_Discriminado_Comp").val().toLocaleString() : "0",
                ValorPercentual: $("#iPercentual_Discriminado_Comp").val() ? $("#iPercentual_Discriminado_Comp").val().toLocaleString() : "%",
                ValorTotal: $("#iValor_Discriminado_Comp").val().toLocaleString()
            }).draw(false);

            oDatatable.row.add({
                Id: 0,
                Id_Produtos_Comp: $("#iProdutosComp").val(),
                DescProduto: $("#iProdutosComp option:selected").text(),
                ValorDiscriminado: $("#iValor_Discriminado_Comp").val() ? $("#iValor_Discriminado_Comp").val().toLocaleString() : "0",
                PercentualDiscriminado: $("#iPercentual_Discriminado_Comp").val() ? $("#iPercentual_Discriminado_Comp").val().toLocaleString() : "%",
                ValorDiscriminadoNf: $("#iValor_Discriminado_Comp").val() ? $("#iValor_Discriminado_Comp").val().toLocaleString() : "0",

                DescClassificacaoTributaria: null,
                DescEmpresa: null,
                DescFilial: null,
                DescModeloNotaFiscal: null,

                IdClassificacaoTributaria: null,
                Id_Empresa: null,
                Id_Filial: null,
                ModeloNotaFiscal: null
            }).draw(false);

            $("#iValor_Discriminado_Comp").val(null);
            $("#iTipo_Discriminado_Comp").val(null).trigger("change");
            $("#iProdutosComp").val(null).trigger("change");
            $("#iPercentual_Discriminado_Comp").val(null);

            atualizaValorGlobalFinanceiro();
            handleExcluir();
        });
    },
        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataPlanoProdutosCompTableButtons();
                }
            }
        }();

    TableManageButtons.init();

    var idE = "", idF = "", nome_lista_config = "ConfiguracaoNF";
    function CarregarGridAtividades() {
        var array = @Html.Raw(Json.Encode(Model.ConfiguracaoNF));
        var nome_lista_config = "ConfiguracaoNF";
        oDatatable = $("#datatableAtividade").length && $("#datatableAtividade").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: array,
            destroy: true,
            drawCallback: async (row, data, index) => {
                var classificacao = $(".classificacao-tributaria");
                for (var item of classificacao.toArray()) {
                    await AddSelect(`${item.id}`, "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboClassificacaoTributaria", @CONSTANTES.PaginacaoRegistros, null, null, item.attributes.value.value, "@RsBase.SELECIONE", false);
                }
                var tam = oDatatable != null && oDatatable.data().length > array.length ? oDatatable.data().length : array.length;
                for (var i = 0; i < tam; i++) {
                    idE = `${nome_lista_config}_${i}__Id_Empresa`;
                    idF = `${nome_lista_config}_${i}__Id_Filial`;

                    var HandleEmpresa = function () {
                        $(`#${idE}`).on('select2:select select2:unselecting', async function (e) {
                            var EmpresaSelecionado = e.params.data;

                            var idTmpFilial = idF;
                            if (this.id.includes("__Id_Empresa")) {
                                idTmpFilial = this.id.replace("__Id_Empresa", "__Id_Filial");
                            }
                            if ($(this).val()) {
                                flagBloqueiaFilial = false;
                                await AddSelect(`${idTmpFilial}`, "@CONSTANTES.URLPortal/api/FilialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, EmpresaSelecionado.id, null, "@RsBase.SELECIONE", false);
                            } else {
                                flagBloqueiaFilial = true;
                                await AddSelect(`${idTmpFilial}`, "@CONSTANTES.URLPortal/api/FilialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                            }
                        });
                    };

                    var arrayDataTmp = oDatatable.rows().data().toArray();
                    var flagBloqueiaFilial = arrayDataTmp[i].Id_Empresa == null && arrayDataTmp[i].Id_Filial == null ? true : false;

                    if (arrayDataTmp[i])
                    {
                        await AddSelect(`${idE}`, "@CONSTANTES.URLPortal/api/Empresaapi/GetComboCNPJEmpresa", @CONSTANTES.PaginacaoRegistros, null, null, $(`#${idE}`).attr("value"), "@RsBase.SELECIONE", false, HandleEmpresa);
                        await AddSelect(`${idF}`, "@CONSTANTES.URLPortal/api/FilialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, $(`#${idE}`).attr("value"), $(`#${idF}`).attr("value"), "@RsBase.SELECIONE", flagBloqueiaFilial);
                    }
                }

                $(".btnRateioProduto").off("click");
                $(".btnRateioProduto").click(function (e) {
                    e.preventDefault();
                    var idRateiro = $(this).attr("rateio");
                    rateioProduto(idRateiro);
                });

                $(".vlr-percentual-discriminado").off("change");
                $(".vlr-percentual-discriminado").on("change", function (e) {
                    e.preventDefault();
                    var idPercentual = $(this).attr("idPercentualDiscriminado");
                    var vlrPercentualAlterado = e.target.value;
                    var idCampo = e.target.id; //ConfiguracaoNF_[index]__PercentualDisciminado
                    vlrPercentualDiscriminado(idPercentual, vlrPercentualAlterado, idCampo);
                });

                handleExcluir();
            },
            columns: [
                {
                    data: "Id",
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluirAtividade" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;padding-right:2px;"></i></a>' +
                            '<input id="' + nome_lista_config + '_' + meta.row + '__Id" name="' + nome_lista_config + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(row.Id) + '">';
                    }
                },
                {
                    data: "DescProduto",
                    title: "@RsCadastros.PRODUTOS",
                    render: function (data, type, row, meta) {
                        return data + '<input id="' + nome_lista_config + '_' + meta.row + '__Id" name="' + nome_lista_config + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(row.Id) + '">';
                    }
                },
                {
                    data: "ValorDiscriminado",
                    title: "@RsCadastros.VALOR_COMPOSICAO",
                    render: function (data, type, row, meta) {
                        return data + ' <input id="' + nome_lista_config + '_' + meta.row + '__ValorDiscriminado" name="' + nome_lista_config + '[' + meta.row + '].ValorDiscriminado" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
                {
                    data: "PercentualDiscriminado",
                    title: "@RsCadastros.PERCENTUAL_RATEIO",
                    render: function (data, type, row, meta) {
                        var vlrPercentual = data.includes("%") ? data.replace("%", "") : data.toString();
                        return `<input id="${nome_lista_config}_${meta.row}__PercentualDiscriminado" name="${nome_lista_config}[${meta.row}].PercentualDiscriminado"
                                type="text" value="${vlrPercentual}" class="form-control text-center vlr-percentual-discriminado" idPercentualDiscriminado="${row.Id_Produtos_Comp}" />`;
                    }
                },
                {
                    data: "ValorDiscriminadoNf",
                    title: "@RsCadastros.VALOR_NF",
                    render: function (data, type, row, meta) {
                        return data + ' <input id="' + nome_lista_config + '_' + meta.row + '__ValorDiscriminadoNf" name="' + nome_lista_config + '[' + meta.row + '].ValorDiscriminadoNf" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
                {
                    data: "ModeloNotaFiscal",
                    title: "@RsCadastros.MODELO_NOTA_FISCAL",
                    render: function (data, type, row, meta) {
                        var sel = $('<select />')
                            .addClass("form-control")
                            .attr("id", `${nome_lista_config}_${meta.row}__ModeloNotaFiscal`)
                            .attr("name", `${nome_lista_config}[${meta.row}].ModeloNotaFiscal`)
                            .append($("<option/>", { text: "Modelo 13", value: "0" }))
                            .append($("<option/>", { text: "Modelo 21", value: "1" }))
                            .append($("<option/>", { text: "Modelo 22", value: "2" }))
                            .append($("<option/>", { text: "Modelo 55", value: "3" }))
                            .append($("<option/>", { text: "Nota Fiscal de Debito", value: "4" }))[0];

                        $(sel.options).each(function () {
                            if (this.value == data) {
                                $(this).attr("selected", true);
                    }
                        });

                        return sel.outerHTML;
                    }
                },
                {
                    data: "IdClassificacaoTributaria",
                    title: "@RsCadastros.CLASSIFICACAO_TRIBUTARIA",
                    render: function (data, type, row, meta) {
                        return ' <select class="form-control classificacao-tributaria" id="' + nome_lista_config + '_' + meta.row + '__IdClassificacaoTributaria" name="' + nome_lista_config + '[' + meta.row + '].IdClassificacaoTributaria" type="hidden" value="' + TrataNulo(data) + '">'
                            + '</select>';
                    }
                },
                {
                    data: "Id_Empresa",
                    title: "@RsCadastros.EMPRESA",
                    render: function (data, type, row, meta) {
                        return ' <select class="form-control empresa" id="' + nome_lista_config + '_' + meta.row + '__Id_Empresa" name="' + nome_lista_config + '[' + meta.row + '].Id_Empresa" type="hidden" value="' + TrataNulo(data) + '">'
                            + '</select>';
                    }
                },
                {
                    data: "Id_Filial",
                    title: "@RsCadastros.FILIAL",
                    render: function (data, type, row, meta) {
                        return ' <select class="form-control filial" id="' + nome_lista_config + '_' + meta.row + '__Id_Filial" name="' + nome_lista_config + '[' + meta.row + '].Id_Filial" type="hidden" value="' + TrataNulo(data) + '">'
                            + '</select>';
                    }
                },
                {
                    data: "Id_Produtos_Comp",
                    render: function (data, type, row, meta) {
                        return `<a href="#" class="btnRateioProduto btn btn-primary" id="btnRateioProduto_${meta.row}" rateio="${data}">Rateio</a>
                        <input id="${nome_lista_config}_${meta.row}__Id_Produtos_Comp" name="${nome_lista_config}[${meta.row}].Id_Produtos_Comp" type="hidden" value="${TrataNulo(data)}" />`;
                    },
                    orderable: false
                }
            ],
        });

        function handleExcluir() {

                $(".btnExcluirAtividade").click(function (e) {
                    e.preventDefault();

                    var idAtividade = $(this).attr("excluir");
                    var trLinkButton = $(this).parents('tr');
                    var $row = $(this).closest('tr');
                    var rowData = $('#datatableAtividade').DataTable().row($row).data();

                    if (idAtividade === "0") {

                        oDatatable.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/planoapi/ExcluirConfigNF?value=")' + rowData.Id;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                        .done(function (data) {

                            if (data.ok) {
                                oDatatable.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {

                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                        .fail(function (e) {

                            Notificar("@RsBase.ATENCAO_", e.responseJSON.message, "warning");
                        })
                    }
                });
            }

        function rateioProduto(idRateiro) {
            var linhaTabela = [], qtdeRegistros = 0;

            linhaTabela = oDatatable.data().filter(x => x.Id_Produtos_Comp == idRateiro).toArray();
            oDatatable.row.add({
                Id: linhaTabela[0].Id,
                Id_Produtos_Comp: linhaTabela[0].Id_Produtos_Comp,
                DescProduto: linhaTabela[0].DescProduto,
                ValorDiscriminado: linhaTabela[0].ValorDiscriminado,
                PercentualDiscriminado: linhaTabela[0].PercentualDiscriminado,
                ValorDiscriminadoNf: linhaTabela[0].ValorDiscriminadoNf,

                Id_Empresa: linhaTabela[0].Id_Empresa,
                DescEmpresa: linhaTabela[0].DescEmpresa,
                Id_Filial: linhaTabela[0].Id_Filial,
                DescFilial: linhaTabela[0].DescFilial,
                IdClassificacaoTributaria: linhaTabela[0].IdClassificacaoTributaria,
                DescClassificacaoTributaria: linhaTabela[0].DescClassificacaoTributaria,
                ModeloNotaFiscal: linhaTabela[0].ModeloNotaFiscal,
                DescModeloNotaFiscal: linhaTabela[0].DescModeloNotaFiscal
            }).draw(false);

            qtdeRegistros = oDatatable.data().filter(x => x.Id_Produtos_Comp == idRateiro).toArray().length;
            oDatatable.rows().data().each(function (value, index) {
                if (value.Id_Produtos_Comp == idRateiro) {
                var vlrDiscriminadoNf = 0, strVlrDiscriminadoNf = "", vlrPercentual = 0, strVlrPercentual = "";
                vlrDiscriminadoNf = parseFloat(value.ValorDiscriminadoNf) / qtdeRegistros;
                strVlrDiscriminadoNf = vlrDiscriminadoNf.toString().replace(".", ",");
                    value.ValorDiscriminadoNf = strVlrDiscriminadoNf;//formatarValor(strVlrDiscriminadoNf);

                strVlrPercentual = value.PercentualDiscriminado.includes("%") ? value.PercentualDiscriminado.replace("%", "") : value.PercentualDiscriminado.toString();
                vlrPercentual = parseFloat(strVlrPercentual) / qtdeRegistros;
                strVlrPercentual = vlrPercentual.toString().replace(".", ",");
                    value.PercentualDiscriminado = strVlrPercentual;//formatarValor(strVlrPercentual);

                    oDatatable.row(index).data(value);
                }
            }).draw(true);
        }

        function vlrPercentualDiscriminado(idPercentual, vlrPercentualAlterado, idCampo) {
            var qtde100Porcento = 100 - parseFloat(vlrPercentualAlterado);
            var qtdeRegistros = oDatatable.data().filter(x => x.Id_Produtos_Comp == idPercentual).toArray().length;

            var resultadoDistribuidoPorcentagem = qtdeRegistros > 2 ? (qtde100Porcento / (qtdeRegistros - 1)) : qtde100Porcento;
            oDatatable.rows().data().each(function (value, index) {
                if (value.Id_Produtos_Comp == idPercentual) {
                var vlrDiscriminadoNf = 0, strVlrDiscriminadoNf = "", vlrPercentual = 0, strVlrPercentual = "";
                if (idCampo === `ConfiguracaoNF_${[index]}__PercentualDiscriminado`) {
                    vlrDiscriminadoNf = (parseFloat(value.ValorDiscriminado) * parseFloat(vlrPercentualAlterado)) / 100;
                    vlrPercentual = parseFloat(vlrPercentualAlterado);
                } else {
                    vlrDiscriminadoNf = (parseFloat(value.ValorDiscriminado) * parseFloat(resultadoDistribuidoPorcentagem)) / 100;
                    vlrPercentual = parseFloat(resultadoDistribuidoPorcentagem);
                }

                strVlrDiscriminadoNf = vlrDiscriminadoNf.toFixed(2).toString().replace(".", ",");
                    value.ValorDiscriminadoNf = strVlrDiscriminadoNf;//strVlrDiscriminadoNf.includes(",") ? formatarValor(strVlrDiscriminadoNf) : strVlrDiscriminadoNf;

                strVlrPercentual = vlrPercentual.toString().replace(".", ",");
                    value.PercentualDiscriminado = strVlrPercentual;// strVlrPercentual.includes(",") ? formatarValor(strVlrPercentual) : strVlrPercentual;

                    oDatatable.row(index).data(value);
                }
            }).draw(true);
        }

        function formatarValor(value) {
            var index = value.indexOf(",");
            var strVlrPre = value.substring(0, index);
            var strVlrPos = value.substring(index + 1);

            strVlrPos = strVlrPos.padEnd(2, "0");

            return `${strVlrPre},${strVlrPos}`;
    }
    }

        //Datatable Atividades
    @*var handleDataTableButtons = function () {
