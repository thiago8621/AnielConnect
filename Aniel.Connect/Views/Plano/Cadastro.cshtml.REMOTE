                                                    <label for="iIntragrupoLcGratuita" class="mb-1">@RsCadastros.INTRAGRUPO_LC_GRATUITA ?</label>
                                                    <i class="fas fa-info-circle" style="color: #2092EC" data-toggle="popover" data-placement="top"
                                                       data-content="Marcando como Sim toda vez que um cliente seu
                                                                     ligar para outro cliente seu, e ambos pertencerem a mesma área local, será
                                                                     considerada ligação gratuita e não contabilizará na franquia.">
                                                    </i><br>

                                                    @Html.CheckBoxFor(m => m.IntragrupoLcGratuita, new { @class = "form-control", @id = "iIntragrupoLcGratuita", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>
                                            <div class="col-sm-2" id="diviIntragrupoGratuita">
                                                <div class="form-group">
                                                    <label for="iIntragrupoGratuita" class="mb-1">@RsCadastros.INTRAGRUPO_GRATUITA  ?</label>
                                                    <i class="fas fa-info-circle" style="color: #2092EC" data-toggle="popover" data-placement="top"
                                                       data-content="Marcando como Sim toda vez que
                                                                     um cliente seu ligar para outro cliente seu, será considerada ligação gratuita e
                                                                     não contabilizará na franquia">

                                                    </i><br>
                                                    @Html.CheckBoxFor(m => m.IntragrupoGratuita, new { @class = "form-control", @id = "iIntragrupoGratuita", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row container mt-3">
                                            <span class="container text-bold-card semititulo">Defina os valores a ser cobrados para serviços agregados:</span>
                                        </div>
                                        <div class="row mt-1">
                                            <div class="col-auto" id="divcobrarBina">
                                                <div class="form-group">
                                                    <label for="iCobrarBina" class="mb-1">Cobrar Bina ?</label>
                                                    <i class="fas fa-info-circle" style="color: #2092EC" data-toggle="popover" data-placement="top"
                                                       data-content="Bina = Ao habilitar o
                                                                     cliente poderá identificar quem está ligando para ele, e definir um valor que será
                                                                     cobrado pelo serviço">

                                                    </i><br>
                                                    @Html.CheckBoxFor(m => m.CobrarBina, new { @class = "form-control", @id = "iCobrarBina", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>
                                            <div class="col-sm-1" id="iDivValorBina" style="display:none">
                                                <div class="form-group">
                                                    <label for="iValorBina" class="mb-1">@RsCadastros.VALOR a Cobrar:</label><br>
                                                    @Html.TextBoxFor(m => m.ValorBina, new { @class = "form-control money", @id = "iValorBina" })
                                                    @Html.ValidationMessageFor(model => model.ValorBina, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="col-auto" id="divSigame">
                                                <div class="form-group">
                                                    <label for="iCobrarSigame" class="mb-1">Cobrar Sigame ?</label>
                                                    <i class="fas fa-info-circle" style="color: #2092EC" data-toggle="popover" data-placement="top"
                                                       data-content="Siga-me = Ao habilitar
                                                                     permite programar que todas as chamadas que seriam recebidas pelo o número
                                                                     do cliente serão redirecionadas automaticamente, em uma determinada data
                                                                     e/ou horário específico, para outro número configurado, e definir um valor que
                                                                     será cobrado pelo serviço">

                                                    </i><br>
                                                    @Html.CheckBoxFor(m => m.CobrarSigame, new { @class = "form-control", @id = "iCobrarSigame", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>

                                            <div class="col-sm-1" id="iDivValorSigame" style="display:none">
                                                <div class="form-group">
                                                    <label for="iValorSigame" class="mb-1">@RsCadastros.VALOR  a Cobrar:</label><br>
                                                    @Html.TextBoxFor(m => m.ValorSigame, new { @class = "form-control money", @id = "iValorSigame" })
                                                    @Html.ValidationMessageFor(model => model.ValorSigame, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="col-auto" id="divBlackList">
                                                <div class="form-group">
                                                    <label for="iCobrarBlacklist" class="mb-1">Cobrar Blacklist ?</label>
                                                    <i class="fas fa-info-circle" style="color: #2092EC" data-toggle="popover" data-placement="top"
                                                       data-content="Blacklist = Ao habilitar
                                                                     permite bloquear uma chamada de ENTRADA que esteja perturbando o cliente
                                                                     e definir um valor que será cobrado pelo serviço">

                                                    </i><br>
                                                    @Html.CheckBoxFor(m => m.CobrarBlacklist, new { @class = "form-control", @id = "iCobrarBlacklist", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>
                                            <div class="col-sm-1" id="iDivValorBlacklist" style="display:none">
                                                <div class="form-group">
                                                    <label for="iValorBlacklist" class="mb-1">@RsCadastros.VALOR a Cobrar:</label><br>
                                                    @Html.TextBoxFor(m => m.ValorBlacklist, new { @class = "form-control money", @id = "iValorBlacklist" })
                                                    @Html.ValidationMessageFor(model => model.ValorBlacklist, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                        </div>
                                        <div class="row mt-1">
                                            <div class="col-auto" id="divCobrarBloqueioChamadaCobrar">
                                                <div class="form-group">
                                                    <label for="iCobrarBloqueioChamadaCobrar" class="mb-1">@RsCadastros.COBRAR_BLOQUEIO_COBRAR ?</label>
                                                    <i class="fas fa-info-circle" style="color: #2092EC" data-toggle="popover" data-placement="top"
                                                       data-content="Ao habilitar o sistema bloqueia qualquer chamada de ENTRADA
                                                                     a cobrar e será possível definir um valor que será cobrado pelo serviço">

                                                    </i><br>
                                                    @Html.CheckBoxFor(m => m.CobrarBloqueioChamadaCobrar, new { @class = "form-control", @id = "iCobrarBloqueioChamadaCobrar", @data_toggle = "toggle", @data_on = "Sim", @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>

                                            <div class="col-sm-2" id="iDivBloqueioChamadaCobrar" style="display:none">
                                                <div class="form-group">
                                                    <label for="iBloqueioChamadaCobrar" class="mb-1">@RsCadastros.COBRADO_POR:</label>
                                                    <i class="fas fa-info-circle" style="color: #2092EC" data-toggle="popover" data-placement="top"
                                                       data-content="Circuito: Valor único cobrado para todos os números dentro daquele circuito
                                                                     Did: Valor cobrado para cada DID dentro de um circuito">

                                                    </i><br>
                                                    @Html.EnumDropDownListFor(m => m.BloqueioChamadaCobrar, RsBase.SELECIONE, new { @class = "form-control", @id = "iBloqueioChamadaCobrar", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.BloqueioChamadaCobrar, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-sm-1" id="iDivValorBloqueioChamadaCobrar" style="display:none">
                                                <div class="form-group">
                                                    <label for="iValorBloqueioChamadaCobrar" class="mb-1">@RsCadastros.VALOR a Cobrar:</label><br>
                                                    @Html.TextBoxFor(m => m.ValorBloqueioChamadaCobrar, new { @class = "form-control money", @id = "iValorBloqueioChamadaCobrar" })
                                                    @Html.ValidationMessageFor(model => model.ValorBloqueioChamadaCobrar, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div role="tabpanel" class="tab-pane " id="iConfiguracoesRede">
                        <div id="accordion">
                            <div class="card div-card-accord">
                                <div class="card-header title-card" id="heading-5">
                                    <h5 class="mb-0">
                                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-5" aria-expanded="true" aria-controls="collapse-5">
                                            <span class="text-bold-card">@RsCadastros.CONFIGURACOES_REDE</span>
                                        </a>
                                    </h5>
                                </div>
                                <div id="collapse-5" class="collapse show" data-parent="#accordion" aria-labelledby="heading-5">
                                    <div class="card-body body-card-accord">
                                        <div class="row mt-3">

                                            <div class="col">
                                                <div class="form-group">
