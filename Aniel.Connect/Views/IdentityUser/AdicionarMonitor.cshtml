        deferRender: true,
        scrollY: '65vh',
        stateSave: true,
        scrollX: true,
        fixedHeader: true,
        initComplete: dataTableInitComplete,
        lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
        ajax: {
            url: baseUrl + '/api/EquipeApi/GetAllMonitor',
            type: 'POST',
            data: function (data) {
                data.monitor = $('input[name=radioMonitor]:checked').val()
                data.pesquisa = $('#idMonitorFiltro').val()
            },
            error: function (e) {
                console.log(e);
            },
            dataSrc: function (d) {
                return d.data;
            }
        },
        infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

            var str = "@RsCadastros.INFODATATABLE";
            if (iTotal == 0) { iEnd = 0; iStart = 0; }
            str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
            $("#dtLegend").html(str);
            return "";
        },
        rowCallback: function (row, data, dataIndex) {
            // Get row ID
            var rowId = data.id;

            // If row ID is in the list of selected row IDs
            if ($.inArray(rowId, rows_selected) !== -1) {
                $(row).find('input[type="checkbox"]').prop('checked', true);
                $(row).addClass('selected');
            }
        },
        drawCallback: function () {
            $('#modal-filter').modal("hide");
        }
        ,
        pageLength: 10,
        language: traducaoDataTableSimples,
        buttons: buttonsDataTable,
        columns: [
            { title: "<input name='select_all' value='1' type='checkbox'>" },
            { data: "nome", title: "@RsCadastros.NOME" },
            { data: "monitor", title: "@RsCadastros.MONITOR" },
            {
                data: "equipe",
                render: function (data, type, row) {
                    return `<a onclick="vincular('${row.nome}')" id="btnVincular" data-toggle="modal" data-target="#modalVincular"><i class='icofont-link' style="font-size:20px;color: #000"></i></a>`;
                 },
                 title: "@RsCadastros.VINCULAR_MONITOR"
            },
            {
                data: "equipe",
                render: function (data, type, row) {
                    return `<a onclick="desvincularMonitor('${row.equipe}')"><i class='icofont-link-broken' style="font-size:20px;color: #000"></i></a>`;
                },
                title: "@RsCadastros.DESVINCULAR_MONITOR_EQUIPE"
            }
        ]
    });
          function VincularMonitor(equipe) {

                if (equipe == null || equipe == undefined) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.TECNICOSEMMONITORVINCULADO", "info");
                    return;
                }
                else {
                     let lista_equipe = [];
                     lista_equipe.push(equipe);
                        parent.Swal.fire({
                        type: 'warning',
                        title: 'Confirmar ação',
                        text: 'Confirma a vinculação do monitor ao técnico?',
                        showCancelButton: true,
                        confirmButtonText: 'Sim',
                        cancelButtonText: 'Não',
                    })
                        .then(function (res) {
                            if (res.value) {
                                $.ajax({
                                    url: '@String.Concat(CONSTANTES.URLPortal, "/api/IdentityUserApi/VincularMonitorAoTecnico")',
                                    type: 'GET',
                                    contentType: "application/json",
                                    data: { ids: JSON.stringify(lista_equipe) },
                                }).done(function (data) {

                                    if (data.ok) {
                                        Notificar("Sucesso", "Monitor Vinculado", "success");
                                        oDatatable.draw();
                                    }
                                    else
                                        Notificar("@RsBase.ATENCAO_", data.innerException, "warning");
                                }).fail(data => {
                                    console.log(data);
                                });
                            }
                        });
                }

          }


        $("#btnVincular").on("click", function (event) {
            let equipe = null;
            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            else if (rows_selected.length > 1) {
                parent.Swal.fire({
                    type: 'warning',
                    title: 'Confirmar ação',
                    text: 'Confirma a Vinculação em massa para os técnicos selecionados na lista?',
                    showCancelButton: true,
                    confirmButtonText: 'Sim',
                    cancelButtonText: 'Não',
                }).then(function (res) {
                    if (res.value) {
                        $.ajax({
                            url: '@String.Concat(CONSTANTES.URLPortal, "/api/IdentityUserApi/VincularMonitorAoTecnico")',
                            type: 'POST',
                            contentType: "application/json",
                            data: { ids: JSON.stringify(rows_selected) },
                        }).done(function (data) {

                            if (data.ok) {
                                Notificar("Sucesso", "Monitores Vinculados", "success");
                                oDatatable.draw();
                            }
                            else
                                Notificar("@RsBase.ATENCAO_", data.innerException, "warning");
                        }).fail(data => {
                            console.log(data);
                        });

                    }
                });
            }
            else {
                equipe = rows_selected[0];
                VincularMonitor(equipe);
            }
        });

            //function vincularMonitor()
            //{
            //    if (oDatatable.row().data().monitor.value = true) {

            //        parent.Swal.fire({
            //            type: 'warning',
            //            title: 'Atenção!',
            //            text: 'Ao confirmar, os técnicos vinculados a algum monitor, serão atualizados para o novo monitor selecionado. ',
            //            showCancelButton: true,
            //            confirmButtonText: 'Sim',
            //            cancelButtonText: 'Não',
            //        }).then(function() {
            //            return $('#modalVincular').html();
            //        });
            //        return $('#modalVincular').html();
            //    }
            //}

            function vincular(nome) {
                return $('#divPerfil').html(nome);
            }

        function desvincularMonitor(equipe) {

            if (equipe == null || equipe == undefined) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.TECNICOSEMMONITORVINCULADO", "info");
                return;
            }
            else {
                let lista_equipe = [];
                lista_equipe.push(equipe);
                parent.Swal.fire({
                    type: 'warning',
                    title: 'Confirmar ação',
                    text: 'Confirma a desvinculação do monitor ao técnico?',
                    showCancelButton: true,
                    confirmButtonText: 'Sim',
                    cancelButtonText: 'Não',
                })
                    .then(function (res) {
                        if (res.value) {
                            $.ajax({
                                url: '@String.Concat(CONSTANTES.URLPortal, "/api/EquipeApi/RemoverVinculoMonitor")',
                                type: 'GET',
                                contentType: "application/json",
                                data: { ids: JSON.stringify(lista_equipe) },
                            }).done(function (data) {

                                if (data.ok) {
                                    Notificar("Sucesso", "Monitor desvinculado", "success");
                                    oDatatable.draw();
                                }
                                else
                                    Notificar("@RsBase.ATENCAO_", data.innerException, "warning");
                            }).fail(data => {
                                console.log(data);
                            });
                        }
                    });
            }

        }



            $('#txtSearch').val(oDatatable.search());

            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });

             //filtro btn pesquisar
             $('#iPesquisar').on("click", function () {
              oDatatable.draw();
            });

                //limpar filtros
                $('#iLimparFiltro, #iLimparFiltroModal').on('click', function () {

                    $("#idMonitor").text("");
                    $("#iMonitoresVinculados").prop(":checked", false);
                    $("#iMonitoresDesvinculados").prop(":checked", false);
                    $("#txtSearch").val('');

                    oDatatable.draw();
                });

              @*$("#btnVincular").on("click", function () {

               if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");

                  return false;
                  }
                  if (oDatatable.row().data().monitor.value = true) {
                //  if (rows_selected.length > 1) {
                      parent.Swal.fire({
                          type: 'warning',
                          title: 'Atenção!',
                          text: 'Ao confirmar, os técnicos vinculados a algum monitor, serão atualizados para o novo monitor selecionado. ',
                          showCancelButton: true,
                          confirmButtonText: 'Sim',
                          cancelButtonText: 'Não',
                      }).then(function () {
                          return $('#modalVincular');
                      });
                  }

                  return $('#modalVincular');

              });*@


        $("#btnDesvincular").on("click", function (event) {
            let equipe = null;
            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            else if (rows_selected.length > 1) {
                parent.Swal.fire({
                    type: 'warning',
                    title: 'Confirmar ação',
                    text: 'Confirma a desvinculação em massa para os técnicos selecionados na lista?',
                    showCancelButton: true,
                    confirmButtonText: 'Sim',
                    cancelButtonText: 'Não',
                }).then(function (res) {
                    if (res.value) {
                        $.ajax({
                            url: '@String.Concat(CONSTANTES.URLPortal, "/api/EquipeApi/RemoverVinculoMonitor")',
                            type: 'GET',
                            contentType: "application/json",
                            data: { ids: JSON.stringify(rows_selected) },
                        }).done(function (data) {

                            if (data.ok) {
                                Notificar("Sucesso", "Monitores desvinculados", "success");
                                oDatatable.draw();
                            }
                            else
                                Notificar("@RsBase.ATENCAO_", data.innerException, "warning");
                        }).fail(data => {
                            console.log(data);
                        });

                    }
                });


            }
            else {
                equipe = rows_selected[0];
                desvincularMonitor(equipe);
            }
        });



            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().equipe;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            @*$('#datatable tbody').on('click', 'tr', function () {

                if (oDatatable.row(this).data() != null) {

                    var _id = oDatatable.row(this).data().id;

                    var url = '@Url.Action("Cadastro", "Desconto", new { id = "__id__" })';
                    window.location.href = url.replace('__id__', _id);
                    ShowPageLoading();
                }
            });*@

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        //},
        //    TableManageButtons = function () {
        //        "use strict";
        //        return {
        //            init: function () {
        //                handleDataTableButtons();
        //            }
        //        }
        //    }();

        //TableManageButtons.init();

        var erro = false;
    var clicked = false;
    function ValidaSubmit()
    {
        if (clicked) {
            return false;
        }

        clicked = true;


        if (!$('#idMonitor').val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MONITOR)", "warning");
            clicked = false;
            erro = true;
            return;
        }
         if (rows_selected.length == 0) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
            clicked = false;
            erro = true;
            return;
        }
        $('#iListaEquipes').val(rows_selected);

        erro = false;

	    if (erro) {
            clicked = false;
            return false;
        }

        if (!erro) {
            clicked = true;
            ShowPageLoading();
            $('#form').submit();

            Notificar("@RsBase.INFORMACAO", "@RsBase.SUCESSOMONITORVINCULADO", "info");

            return true;
        }
    }


</script>
}

@using (Html.BeginForm("AdicionarMonitor", "IdentityUser", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()
    <div style="padding:10px;">

        <!--main-->

        @Html.HiddenFor(model => model.Lista_Equipes, new { @id = "iListaEquipes" })

        <div class="row" style="padding-top: 10px;">
            <div class="col" style="margin-top: -10px">

                <h4 class="title-page"><i class="icofont-company"></i> @ViewBag.Title</h4>

                <nav aria-label="breadcrumb" style="font-size:12px">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item" style="margin-top:-18px">
                            <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                        </li>
                        <li class="breadcrumb-item" style="margin-top:-18px">
                            <span>@ViewBag.Title</span>
                        </li>
                    </ol>
                </nav>

                <span style="font-size:11px" id="dtLegend"></span>
            </div>

            <div class="row pr-4">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.EQUIPE" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
               
                <button type="button" class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button type="button" class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button type="button" class="btn btn-default btn-add" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" id="btnVincularMassa" href="#" data-toggle="modal" data-target="#modalVincular" onclick="vincular(oDatatable.data().toArray().filter(p => rows_selected.includes(p.equipe)).map(p => p.nome).join(' - '))">@RsBase.VINCULARMONITOR</a>
                    <a class="dropdown-item" id="btnDesvincular" href="#" onclick="return false">@RsBase.DESVINCULARMONITOR</a>
                    <a class="dropdown-item" href="@Url.Action("VincularMonitorLog", "IdentityUser")" title="@RsBase.VISUALIZAR_LOG">@RsBase.VISUALIZAR_LOG</a>
                </div>
            </div>

        </div>

        <div class="row">

            <div class="col-sm-12">
                <label class="text-danger ml-3 mr-2 mt-1" style="font-size:12px">Para realizar qualquer tipo de alteração em massa, deve-se clicar nos 3 pontinhos que consta no canto direito da tela.</label>

            </div>
        </div>

        <table class="table table-hover nowrap" id="datatable" style="width:100%">
            <thead class="tb-head">

            </thead>
        </table>

        <div class="modal" id="modal-filter">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">

                        <div class="col-sm-11 container" style="align-content:center;">
                            <div class="row">

                                <div class="col-12" style="width: 50%">
                                    <div class="form-group">
                                        <label>@RsCadastros.MONITOR_TECNICO: </label>
                                        @Html.DropDownListFor(m => m.Id, new SelectList(new List<ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "idMonitorFiltro", @autocomplete = "off" })
                                    </div>

                                </div>
                                <br /><br /><br />
                                <div class="col-12" style="width: 50%">
                                    <div class="form-group">
                                        <input type="radio" id="iTodos" value="" name="radioMonitor" checked />
                                        <label for="iTodos">Todos</label>
                                    </div>
                                </div>
                                <div class="col-12" style="width: 50%">
                                    <div class="form-group">
                                        <input type="radio" id="iMonitoresVinculados" value="vinculado" name="radioMonitor" />
                                        <label for="iMonitoresVinculados">Somente técnicos vinculados</label>
                                    </div>
                                </div>
                                <div class="col-12" style="width: 50%">
                                    <div class="form-group">
                                        <input type="radio" id="iMonitoresDesvinculados" value="desvinculado" name="radioMonitor" />
                                        <label for="iMonitoresDesvinculados">Somente técnicos desvinculados</label>
                                    </div>
                                </div>

                            </div>
                            <div class="form-group col-sm-12" style="padding: 15px;">
                                <div class="text-center">
                                    <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                                    <input type="button" class="btn btn-success" id="iPesquisar" value="@RsCadastros.PESQUISAR" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--./main-->
        <!--modal-->
        <div class="modal fade" id="modalVincular">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title text-muted">@RsCadastros.VINCULAR_MONITOR_EQUIPE</h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">

                        <div class="row">
                            <div class="col">
                                <div class="form-group">
                                    <label>@RsCadastros.NOME_TECNICO: </label>
                                    <div id="divPerfil">
                                        <script>
                                            function vincular(nome) {
                                                return $('#divPerfil').html(nome);
                                            }</script>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>@RsCadastros.MONITOR_TECNICO: </label>
                                    @Html.DropDownListFor(m => m.Id, new SelectList(new List<ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "idMonitor", @autocomplete = "off" })
                                </div>

                            </div>
                            <div class="form-group col-sm-12" style="padding: 15px;">
                                <div class="text-center">
                                    <button type="button" class="btn btn-danger" data-dismiss="modal" aria-label="Close">@RsBase.CANCELAR</button>
                                    <button type="button" class="btn btn-success" onclick="oDatatable.draw();return ValidaSubmit();$('#modalVincular').modal('hide')" id="iPesquisar">@RsBase.SALVAR</button>
                                </div>
                            </div>
                        </div>

                    </div>

                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal-->

    </div>





}