@model Aniel.Connect.Models.IdentityUserMonitorModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Core
@using Aniel.Connect.Models.T5
@using Aniel.Connect.Models


@{
    ViewBag.Title = "Log Vincular Monitor ao Técnico";
    ViewBag.Sessao = RsCadastros.VINCULAR_MONITOR_EQUIPE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />

}

@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

<script>

    $(document).ready(function () {
        AddSelect("iMonitorFiltro", "@CONSTANTES.URLPortal/api/EquipeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
    });

        let oDatatable

        var rows_selected = [];

        "use strict";
    //"Blfrtip"
    oDatatable = $("#datatable").length && $("#datatable").DataTable({
        dom: "Bfrti",
        columnDefs: [
            {
                targets: 0,
                searchable: false,
                orderable: false,
                width: '1%',
                className: 'dt-body-center',
                render: function (data, type, full, meta) {
                    return "<input type='checkbox'></input>";
                }
            }
        ],
        select: 'multi',
        order: [[1, 'asc']],
        serverSide: true,
        searching: true,
        ordering: true,
        paging: true,
        deferRender: true,
        scrollResize: true,
        scrollY: '61vh',
        stateSave: true,
        scrollX: true,
        fixedHeader: true,
        processing: true,
        autoWidth: false,
        initComplete: dataTableInitComplete,
        scroller: true,
        lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
        ajax: {
            url: baseUrl + '/api/EquipeApi/GetLogVincularMonitorTecnico',
            type: 'POST',
            data: function (data) {

                data.tecnico = $('#iMonitorFiltro').text();
                data.dt_Inicial_Filtro = $('#iData_Inicial').val();
                data.dt_Final_Filtro = $('#iData_Final').val();

            },
            error: function (e) {
                console.log(e);
            },
            dataSrc: function (d) {
                return d.data;
            }
        },
         infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

            var str = "@RsCadastros.INFODATATABLE";
            if (iTotal == 0) { iEnd = 0; iStart = 0; }
            str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
            $("#dtLegend").html(str);
            return "";
        },
      
       
        drawCallback: function () {
            $('#modal-filter').modal("hide");           
        },
        rowCallback: function (row, data, dataIndex) {
            // Get row ID
            var rowId = data.id;

            // If row ID is in the list of selected row IDs
            //if($.inArray(rowId, rows_selected) !== -1){
            //   $(row).find('input[type="checkbox"]').prop('checked', true);
            //   $(row).addClass('selected');
            //}
        },
        pageLength: 10,
        language: traducaoDataTableSimples,
        buttons: buttonsDataTable,
       columns: [

            { title: "<input name='select_all' value='1' type='checkbox'>" },
            { data: "tecnico", title: "@RsCadastros.TECNICO" },
            { data: "monitor", title: "@RsCadastros.MONITOR" },
            { data: "tipoOperacao", title: "@RsCadastros.TIPO_ALTERACAO" },
            { data: "dataAlteracao", title: "@RsCadastros.DATAHORA_ALTERACAO" },
            { data: "usuarioCriacao", title: "@RsCadastros.USUARIO_ALTERACAO" }
        ]
      });
      

    oDatatable.on('draw', function () {
        updateDataTableSelectAllCtrl(oDatatable);
    });


    // Handle click on checkbox
    $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
        var $row = $(this).closest('tr');

        // Get row data
        var rowId = oDatatable.row($row).data().equipe;

        var index = $.inArray(rowId, rows_selected);

        // If checkbox is checked and row ID is not in list of selected row IDs
        if (this.checked && index === -1) {
            rows_selected.push(rowId);

            // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
        } else if (!this.checked && index !== -1) {
            rows_selected.splice(index, 1);
        }

        if (this.checked) {
            $row.addClass('selected');
        } else {
            $row.removeClass('selected');
        }

        // Prevent click event from propagating to parent
        e.stopPropagation();
    });
    // Handle click on table cells with checkboxes
    $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
        $(this).parent().find('input[type="checkbox"]').trigger('click');
    });

    // Handle click on "Select all" control
    $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
        if (this.checked) {
            $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
        } else {
            $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
        }

        // Prevent click event from propagating to parent
        e.stopPropagation();
    });

    // Handle table draw event
    oDatatable.on('draw', function () {
        // Update state of "Select all" control
        updateDataTableSelectAllCtrl(oDatatable);

    });

    
    //filtro btn pesquisar
    $('#iPesquisar').on("click", function () {
        oDatatable.draw();
    });

     //limpar filtros
    $('#iLimparFiltro, #iLimparFiltroModal').on('click', function () {
     $("#iMonitorFiltro").val("").trigger("change");
     $("#Data_Inicial").text("");
     $("#Data_Final").text("");
     oDatatable.draw();
     });

     // Handle table draw event
     oDatatable.on('draw', function () {
            updateDataTableSelectAllCtrl(oDatatable);
     });

    var erro = false;
    var clicked = false;
    function ValidaSubmit()
    {
        if (clicked) {
            return false;
        }
        clicked = true;

        erro = false;

	    if (erro) {
            clicked = false;
            return false;
        }

        if (!erro) {
            clicked = true;
            ShowPageLoading();
            $('#form').submit();

            Notificar("@RsBase.INFORMACAO", "@RsBase.SUCESSOMONITORVINCULADO", "info");

            return true;
        }
    }

</script>
}

@using (Html.BeginForm("AdicionarMonitor", "IdentityUser", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()
    <div style="padding:10px;">

        <!--main-->

        @Html.HiddenFor(model => model.Lista_Equipes, new { @id = "iListaEquipes" })

        <div class="row" style="padding-top: 10px;">
            <div class="col" style="margin-top: -10px">

                <h4 class="title-page"><i class="icofont-company"></i> @ViewBag.Title</h4>

                <nav aria-label="breadcrumb" style="font-size:12px">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item" style="margin-top:-18px">
                            <a href="@Url.Action("AdicionarMonitor", "IdentityUser")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.VINCULAR_MONITOR_EQUIPE</a>
                        </li>
                        <li class="breadcrumb-item" style="margin-top:-18px">
                            <span>@ViewBag.Title</span>
                        </li>
                    </ol>
                </nav>

                <span style="font-size:11px" id="dtLegend"></span>
            </div>

            <div class="row pr-4">

                <button type="button" class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button type="button" class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button type="button" class="btn btn-default btn-add" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>

                </div>
            </div>

        </div>
        <table class="table table-hover nowrap" id="datatable" style="width:100%">
            <thead class="tb-head">
            </thead>
        </table>
    </div>

    <div class="modal" id="modal-filter">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">

                    <div class="col-sm-11 container" style="align-content:center;">
                        <div class="row">

                            <div class="col-12">
                                <label for="divDatas" class="mb-2">@RsCadastros.TECNICO:</label><br />
                                <div class="form-group" for="divDatas" class="mb-2">
                                    @Html.DropDownListFor(m => m.MonitorFiltro, new SelectList(new List<ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iMonitorFiltro", @autocomplete = "off" })
                                </div>
                                <label for="divDatas" class="mb-2">@RsCadastros.PERIODO:</label><br />
                                <div class="row pl-3" id="divDatas">
                                    @Html.TextBoxFor(m => m.Data_Inicial, new { @tabindex = "7", @class = "form-control datepicker mr-2", @data_provide = "datepicker", @id = "iData_Inicial", @autocomplete = "off" }) @RsBase.A
                                    @Html.TextBoxFor(m => m.Data_Final, new { @tabindex = "7", @class = "form-control datepicker ml-2", @data_provide = "datepicker", @id = "iData_Final", @autocomplete = "off" })

                                </div>
                            </div>
                            <br /><br /><br />

                        </div>
                        <div class="form-group col-sm-12" style="padding: 15px;">
                            <div class="text-center">
                                <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                                <input type="button" class="btn btn-success" id="iPesquisar" value="@RsCadastros.PESQUISAR" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}