@model Aniel.Connect.Models.Motivo_EncerramentoCadastroModel

@{
    ViewBag.Title = RsCadastros.MOTIVO_ENCERRAMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@using (Html.BeginForm("Cadastro", "Motivo_Encerramento", FormMethod.Post, htmlAttributes: new { @id="form" }))
{
    @Html.AntiForgeryToken()
    
<div style="padding:10px">
    <div class="card" style="border:none;">

        <div class="col-sm-6" style="margin-bottom: -22px;">
            <h4 class="title-page"><i class="fas fa-headset"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" style="font-size:12px" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item" style="margin-left:22px; margin-top:-18px">
                        <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9">@RsCadastros.CONFIGURACOES</a>
                    </li>
                    <li class="breadcrumb-item" style="margin-top:-18px">
                        <a href="@Url.Action("Index", "Motivo_Encerramento")" style="color:#367fa9">@RsCadastros.PAINEL_MOTIVO_ENCERRAMENTO</a>
                    </li>
                    <li class="breadcrumb-item" style="margin-top:-18px">
                        <span>@ViewBag.Title</span>
                    </li>

                </ol>
            </nav>

            <span style="font-size:11px" id="dtLegend"></span>
        </div>

       
            <div class="card div-card-accord">
                <div class="card-header title-card" id="heading-1">
                    <h5 class="mb-0">
                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                            <span class="text-bold-card">@ViewBag.Title</span>
                        </a>
                    </h5>
                </div>
                <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                    <div class="card-body body-card-accord">

                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iNome">@RsCadastros.DESCRICAO</label>
                                    @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iNome", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    @if (Model.Id != 0)
                                    {
                                        <label for="iStatus">@RsCadastros.STATUS:</label>
                                        <br />
                                        @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    }

                                </div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
       
    </div>

    <!--Button Float-->
    <a href="@Url.Action("Index", "Motivo_Encerramento")" class="float-cancel">
        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
            <i class="fas fa-times fa-2x"></i>
        </div>
    </a>

    <a href="#" class="float-save" onclick="$('#form').submit(); return false;">
        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
            <i class="fas fa-save fa-2x"></i>
        </div>
    </a>


</div>

}