    /*Conversao campo horas*/

    const converter = (minutos) => {
        const horas = Math.floor(minutos / 60);
        const min = minutos % 60;

        if (minutos < 60) {
            const textoHoras = (`00${horas}`).slice(-5).replace(/\b0+/g, "00");
            const textoMinutos = (`00${min}`).slice(-2);
            return `${textoHoras}:${textoMinutos}`;
        } else {
            const textoHoras = (`00${horas}`).slice(-5).replace(/\b0+/g, "");
            const textoMinutos = (`00${min}`).slice(-2);
            return `${textoHoras}:${textoMinutos}`;
        }
    };

    $('#iPrazo_HorasView').val(converter($('#iPrazo_Horas').val()));

