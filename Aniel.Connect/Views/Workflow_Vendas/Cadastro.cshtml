        let responsavelDesc = $("#iResponsavel option:selected").text();


        let atividadeDecisoria = $("#idAtividade_decisoria").val();
        let atividadeDecisoriaDesc = $("#idAtividade_decisoria option:selected").text();

        let tipoAtividadeDecisoria = $("#idTipo_Atividade_decisoria").val();
        let tipoAtividadeDecisoriaDesc = $("#idTipo_Atividade_decisoria option:selected").text();


        let tipoDias = $("#iTHoras_ativ").val();
