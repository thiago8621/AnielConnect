                render: function (data, type, row, meta) {
                    if (type === 'display') {
                        data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Ativ_Status_Desc" name="' + nome_lista + '[' + meta.row + '].Ativ_Status_Desc" type="hidden" value="' + TrataNulo(data) + '">' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Ativ_Status" name="' + nome_lista + '[' + meta.row + '].Ativ_Status" type="hidden" value="' + TrataNulo(row.Ativ_Status) + '">';


                    }
                    return data;
                }
            },

              {
                  data: "BTN Excluir/Editar",
                  title: "@RsCadastros.ACOES",
                  render: function (data, type, row, meta) {
                      var retorno = "";
                      retorno += '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir=' + row.Id + '><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>';
                      if (row.Id != 0) {
                          retorno += '<a href="#" data-toggle="modal"  class="btnEditar ml-2" id="btnEditar_' + meta.row + '" editar=' + row.Id + '><i class="fas fa-user-edit"></i></a>';
                      }
                      retorno += ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(row.Id) + '">';
                      retorno += ' <input id="' + nome_lista + '_' + meta.row + '__Senha" name="' + nome_lista + '[' + meta.row + '].Senha" type="hidden" value="' + TrataNulo(row.Senha) + '">';
                      return retorno;
                }
            },


        ]
    });

    function handleExcluir() {
        console.log("Função ativada")
        $(".btnExcluir").unbind('click');
        /*$(".btnExcluir").one('click', async function (e)*/
        $(".btnExcluir").click(async function (e)
        {
            /*$(this).prop('disabled', true);*/
             e.preventDefault();

             var idArquivo = $(this).attr("excluir");

             var trLinkButton = $(this).parents('tr');

             if (idArquivo === "0") {
                 oDatatable.row(trLinkButton).remove().draw(false);
                 Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
             }
              else {

                 var link = '@String.Concat(CONSTANTES.URLPortal, "/api/workflow_vendasapi/ExcluirGrid?value=")' + idArquivo;

                 await $.ajax({
                     url: link,
                     type: 'GET',
                     dataType: 'json',

                 })
                     .done(function (data) {

                         if (data.ok) {
                             oDatatable.row(trLinkButton).remove().draw(false);
                             Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                             //qtderegistros -= 1;
                         }
                         else {
                             Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                             /*$(this).prop('disabled', false);*/
                         }
                     })
                     .fail(function () {
                         /*$(this).prop('disabled', false);*/

                     })
                     .always(function () {

                     });
             }


         });

            }

            handleExcluir();

    //Lógica modal


    $('#iEditarAtividades').click(async function () {

         let definirResponsavel = $('#iDefinir_ResponsavelM').is(":checked");
         let setor = $('#iSetorDepartamentoM').val();

         if (definirResponsavel && (!setor || setor === "" || setor === "0")) {
             Notificar("@RsBase.ATENCAO_", "Informe o setor/departamento", "warning");
             return;
         }


        ShowPageLoading();

        const result = await $.ajax({
            url: '@String.Concat(CONSTANTES.URLPortal, "/api/workflow_vendasapi/EditarAtividades")',
            type: 'POST',
            dataType: 'json',
            data: {
                Id: $('#idConta').val(),
                Ativ_Descricao: $('#iDescricao_ativM').val(),
                Ativ_Prazo: $('#iPrazo_Horas_ativM').val(),
                Ativ_Tipodias: $('#iTipo_Horas_ativM').val(),
                Ativ_Decisao: $('#idAtividade_decisoriaM').val(),
                Setor_Departamento: $('#iSetorDepartamentoM').val(),
                Responsavel: $('#iResponsavelM').val(),

                Horario_Atendimento: $('#iHoraAtendimentoM').val(),
                /*Ativ_TipoDecisao: $('#idTipo_Atividade_decisoriaM').val(),*/
                Ativ_StatusVenda: $('#iModal_Status_Venda').val(),
                Ativ_NAtivAprovada: $('#iProxAtivAprovM').val(),
                Ativ_NAtivReprovada: $('#iProxAtivReprovM').val(),
                Ativ_Status: $('#iStatus_ativM').is(":checked"),
                Definir_Responsavel: $('#iDefinir_ResponsavelM').is(":checked"),

            }
        })

        HidePageLoading();

        if (!result.ok) {
            Notificar("@RsBase.ATENCAO_", result.mensagem, "warning");
        }
        else {
            $('#modal-editar-atividade').modal('hide')
            let updatedData = oDatatable.rows().data().toArray()
            let atualizar = updatedData.filter(p => p.Id == $('#idConta').val())[0]

            atualizar.Ativ_Descricao = $('#iDescricao_ativM').val();
            atualizar.Ativ_Prazo = $('#iPrazo_Horas_ativM').val();

            atualizar.Ativ_Tipodias = $('#iTipo_Horas_ativM').val();
            atualizar.Ativ_Tipodias_Desc = $('#iTipo_Horas_ativM option:selected').text();

            atualizar.Horario_Atendimento = $('#iHoraAtendimentoM').val();
            atualizar.Horario_Atendimento_Desc = $('#iHoraAtendimentoM option:selected').text();

            atualizar.Ativ_Decisao = $('#idAtividade_decisoriaM').val();
            atualizar.Ativ_Decisao_Desc = $('#idAtividade_decisoriaM option:selected').text();

            atualizar.Ativ_StatusVenda = $('#iModal_Status_Venda').val();
            atualizar.Ativ_StatusVenda_Desc = $('#iModal_Status_Venda option:selected').text();

            atualizar.Ativ_NAtivAprovada = $('#iProxAtivAprovM').val();
            atualizar.Ativ_NAtivReprovada = $('#iProxAtivReprovM').val();

            atualizar.Ativ_Status = $('#iStatus_ativM').prop('checked');
            atualizar.Ativ_Status_Desc = $('#iStatus_ativM').prop('checked') ? "@RsCadastros.ATIVO" : "@RsCadastros.INATIVO";

            atualizar.Definir_Responsavel = $('#iDefinir_ResponsavelM').prop('checked') ;

            atualizar.Setor_Departamento = $('#iSetorDepartamentoM').val();
            atualizar.Setor_Departamento_Desc = $('#iSetorDepartamentoM option:selected').text();

            atualizar.Responsavel = $('#iResponsavelM').val();
            atualizar.Responsavel_Desc = $('#iResponsavelM option:selected').text();


            $('#datatable').dataTable().fnClearTable();
            $('#datatable').dataTable().fnAddData(updatedData);
        }

    });

    $('#datatable tbody').on('click', '.btnEditar', async function (e) {

        $('#modal-editar-atividade').modal('show');
        var $row = $(this).closest('tr');

        const data_row = oDatatable.row($row).data();

        $('#iDescricao_ativM').val(data_row.Ativ_Descricao);
        $('#iPrazo_Horas_ativM').val(data_row.Ativ_Prazo);
        $('#iTipo_Horas_ativM').val(data_row.Ativ_Tipodias);
        $('#idAtividade_decisoriaM').val(data_row.Ativ_Decisao);
        $('#idTipo_Atividade_decisoriaM').val(data_row.Ativ_TipoDecisao);
        $('#iProxAtivAprovM').val(data_row.Ativ_NAtivAprovada);
        $('#idConta').val(data_row.Id);
        $('#iProxAtivReprovM').val(data_row.Ativ_NAtivReprovada);
        $('#iHoraAtendimentoM').val(data_row.Horario_Atendimento_Desc);
        AddSelect("iSetorDepartamentoM", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, data_row.Setor_Departamento, "@RsBase.SELECIONE", false, handleDepartamentoM);
        AddSelect("iResponsavelM", "@CONSTANTES.URLPortal/api/Identity_UserApi/GetComboUserId", @CONSTANTES.PaginacaoRegistros, null, null, data_row.Responsavel, "@RsBase.SELECIONE", true);
        $('#iModal_Status_Venda').val(data_row.Ativ_StatusVenda);
        var dados = oDatatable.data().toArray().map(p => p.Id)


        /*MODAL Mostrar proxima atividade*/
        var ativDecisoriaM = document.getElementById("idAtividade_decisoriaM").value
        var proxAtiv = document.getElementById("iProximaAtividadeM");
        if (ativDecisoriaM == 1) {
            proxAtiv.classList.remove("d-none")
        }
        else {
            proxAtiv.classList.add("d-none")

            $("#iProxAtivAprovM").val(0);
            $("#iProxAtivReprovM").val(0);
        }



        document.getElementById("idAtividade_decisoriaM").onchange = function () { exibirProxAtividade() };
        function exibirProxAtividade() {
            var ativDecisoria = document.getElementById("idAtividade_decisoriaM").value
            if (ativDecisoria == 1) {
                var proxAtivRemove = document.getElementById("iProximaAtividadeM");
                proxAtivRemove.classList.remove("d-none")
            }
            else {
                var proxAtivAdd = document.getElementById("iProximaAtividadeM");
                proxAtivAdd.classList.add("d-none");

                $("#iProxAtivAprovM").val(0);
                $("#iProxAtivReprovM").val(0);
            }
        }

        /*FIM*/

        /*Mostrar Horário atendimento MODAL*/
        var tipoHorasM = document.getElementById("iTipo_Horas_ativM").value
        var horaDivM = document.getElementById("iHoraDivM");
        if (tipoHorasM == 1) {
            horaDivM.classList.remove("d-none")
        } else {
            horaDivM.classList.add("d-none")
        }
        document.getElementById("iTipo_Horas_ativM").onchange = function () { exibirHorarioAtendimento() };
            function exibirHorarioAtendimento() {
                var tipoHoras = document.getElementById("iTipo_Horas_ativM").value
                if (tipoHoras == 1) {
                    var horaDivMy = document.getElementById("iHoraDivM");
                    horaDivMy.classList.remove("d-none")
                } else {
                    var horaDivMz = document.getElementById("iHoraDivM");
                    horaDivMz.classList.add("d-none")
                }
            }

    /*FIM*/

        if (data_row.Ativ_Status == true)
            $("#iStatus_ativM").bootstrapToggle('on');
        else
            $("#iStatus_ativM").bootstrapToggle('off');

        if (data_row.Definir_Responsavel == true)
            $("#iDefinir_ResponsavelM").bootstrapToggle('on');
        else
            $("#iDefinir_ResponsavelM").bootstrapToggle('off');


        AddSelect("iHoraAtendimentoM", "@CONSTANTES.URLPortal/api/Horarioapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, data_row.Horario_Atendimento, "@RsBase.SELECIONE", false);
        @*AddSelect("iStatusVendaM", "@CONSTANTES.URLPortal/api/Atividade_StatusVendaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, data_row.Ativ_StatusVenda, "@RsBase.TODOS", false);*@

        await AddSelectSemPag('iModal_Status_Venda', '@CONSTANTES.URLPortal/api/Atividade_StatusVendaApi/GetCombo', null, null, data_row.Ativ_StatusVenda,'@RsBase.SELECIONE', false, HandleModeloPainel, "@User.Identity.GetUserId()");



        reiniciarToggle();
    });

    /*Fim Modal*/

    /*LISTA STATUS*/




    /*FIM LISTA STATUS*/



    /*Validação*/
    var clicked = false;

    function ValidaSubmit()
    {

        var erro = false;

        if (clicked) {
            return false;
        }


        if (!$("#iDescricao").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsCadastros.NUMERO)", "warning");
            erro = true;
        }

        if (oDatatable.data().toArray().length == 0)
        {
            Notificar("@RsBase.ATENCAO_", "Informe pelo menos uma atividade", "warning");
            erro = true;
        }


        clicked = true;


	    if (erro) {
            clicked = false;
            return false;
        }

        ShowPageLoading();
        $('#form').submit();
	    return true;
        }


</script>

}


