                                                            @Html.TextBoxFor(m => m.Ativ_NAtivAprovada, new { @class = "form-control", @id = "iProxAtivAprov", @autocomplete = "off" })
                                                            @Html.ValidationMessageFor(model => model.Ativ_NAtivAprovada, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    @*Nº PROXIMA ATIVIDADE REPROVADA*@
                                                    <div class="col-sm-3">
                                                        <div class="form-group">
                                                            <label for="iProxAtivReprov">@RsCadastros.N_PROXIMA_ATIVIDADE_REPROVADA:</label>
                                                            @Html.TextBoxFor(m => m.Ativ_NAtivReprovada, new { @class = "form-control", @id = "iProxAtivReprov", @autocomplete = "off" })
                                                            @Html.ValidationMessageFor(model => model.Ativ_NAtivReprovada, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </section>

                                        </div>

                                        <br>
                                        <div class="row">

                                            @*PRAZO EM HORAS*@
                                            <div class="col-xl-2">
                                                <div class="form-group">
                                                    <label for="iPrazo_Dias_ativ">@RsCadastros.PRAZO_HORAS:</label>
                                                    @Html.TextBoxFor(model => model.Ativ_Prazo, new { @class = "form-control hora99", @id = "iPrazo_Dias_ativ", @placeholder = "000:00", @autocomplete = "off" })
                                                    @*@Html.TextBoxFor(m => m.Horas, new { @class = "form-control hora99", @placeholder = "000:00", @id = "iHoras" })*@
                                                    @Html.ValidationMessageFor(model => model.Ativ_Prazo, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            @*TIPO DE HORAS*@
                                            <div class="col-2">
                                                <div class="form-group">
                                                    <label for="iTHoras_ativ">@RsCadastros.TIPO_HORA:</label>
                                                    @Html.EnumDropDownListFor(m => m.Ativ_Tipodias, new { @class = "form-control", @id = "iTHoras_ativ", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.Ativ_Tipodias, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-2">
                                                <div class="form-group d-none" id="iHoraDiv">
                                                    <label for="iHoraAtendimento">@RsCadastros.HORARIO_ATENDIMENTO:</label>
                                                    @Html.DropDownListFor(m => m.Horario_Atendimento, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iHoraAtendimento", @autocomplete = "off" })
                                                </div>
                                            </div>

                                            @*ID ATIVIDADES*@
                                            <div class="col-sm-1">
                                                <div class="form-group d-none">
                                                    <label for="iIdAtiv">@RsCadastros.ID_WORKFLOW_VENDAS_ATIVIDADES:</label>

                                                    @*@Html.TextBoxFor(m => m.Id, new { @class = "form-control", @id = "iId", @name = " iIdAtiv", @disabled = "true" })*@

                                                </div>
                                            </div>


                                            @*BOTAO STATUS*@
                                            <div class="col">
                                                <div class="form-group d-none">
                                                    <label for="iStatus_ativ">@RsCadastros.STATUS:</label><br>
                                                    @Html.CheckBoxFor(m => m.Ativ_Status, new { @class = "form-control", @id = "iStatus_ativ", @name = " iStatus_ativ", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>

                                        </div>
                                        <div class="row">
                                            <div class="col-sm-3 pt-3">
                                                <label>Definir setor responsável nesta atividade?</label>
                                                <i class="ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="Ao marcar como Sim, será possível definir o setor responsável e o responsável da venda para esta atividade. Ao avançar para esta atividade, o sistema atualizará automaticamente essas informações na venda."></i>
                                                <div class="form-group">
                                                    @Html.CheckBoxFor(m => m.Definir_Responsavel, new { @class = "form-control", @id = "iDefinir_Responsavel", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Nao", @data_onstyle = "success", @data_offstyle = "light" })

                                                </div>
                                            </div>
                                            <section class="col-6" id="Idefinir">
                                                <div class="row">
                                                    <div class="col-3">
                                                        <div class="form-group" id="iSetorDiv">
                                                            <label for="iSetorDepartamento">@RsCadastros.SETOR_RESPONSAVEL:<span class="text-danger">*</span></label>
                                                            @Html.DropDownListFor(m => m.Setor_Departamento, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iSetorDepartamento", @autocomplete = "off" })
                                                        </div>
                                                    </div>

                                                    <div class="col-3">
                                                        <div class="form-group" id="iSetorDiv">
                                                            <label for="iResponsavel">@RsCadastros.RESPONSAVEL:</label>
                                                            @Html.DropDownListFor(m => m.Responsavel, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iResponsavel", @autocomplete = "off" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </section>
                                            @*BOTAO ADICIONAR*@
                                            <div class="col">
                                                <div class="form-group float-right mr-3" style="width:250px">
                                                    <span id="msgnotificao"> </span>
                                                    <input type="button" class="btn btn-success pt-3 pb-3 pr-5 pl-5 font-weight-bold" id="iBtnAdd" value="Adicionar" onclick="validarAtividades()" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="divTable" class="mt-5">
                            <span class="text-bold-card ml-3">@RsCadastros.LISTAGEM_ATIVIDADES_WORKFLOW</span>
                            <hr>
                            <table class="table table-hover nowrap" id="datatable" style="width:100%">
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Button Float-->
    <a href="@Url.Action("Index", "Workflow_Vendas")" class="float-cancel" onclick="ShowPageLoading(); return true;">
        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
            <i class="fas fa-times fa-2x"></i>
        </div>
    </a>

    <a href="#" class="float-save" onclick="return ValidaSubmit();">
        <div id="btnSalvar" class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
            <i class="fas fa-save fa-2x"></i>
        </div>
    </a>

    <div></div>
}

