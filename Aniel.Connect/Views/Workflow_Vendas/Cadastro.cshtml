            var horaAtendimento_Desc = tipoDiasDesc;
        } else {
            horaAtendimento = $("#iHoraAtendimento").val();
            horaAtendimento_Desc = $("#iHoraAtendimento option:selected").text();
        }

        oDatatable.row.add({
            Id: 0,

            StatusPadrao: statusPadrao,
            Id_Status_Padrao: IdstatusPadrao,
