    /*Validar Atividades*/
    function validarAtividades() {

        if (!$("#iDescricao_ativ").val()) {
            Notificar("@RsBase.ATENCAO_", "@RsCadastros.DESCRICAO @RsBase.INVALIDO", "warning");
        }
        else {

            if (!$("#iStatusVenda").val()) {
                Notificar("@RsBase.ATENCAO_", "@RsCadastros.STATUS_VENDA @RsBase.INVALIDO", "warning");
            } else {

                var dados = oDatatable.data().toArray().map(p => p.Id)
                let a = parseInt($('#iProxAtivAprov').val());
                let r = parseInt($('#iProxAtivReprov').val());
                let definirResponsavel = $('#iDefinir_Responsavel').is(":checked");
                let setor = $('#iSetorDepartamento').val();
                var aprovada = dados.includes(a);
                var reprovada = dados.includes(r);
                var ativDecisoria = document.getElementById("idAtividade_decisoria").value

                if (definirResponsavel && (!setor || setor == "" || setor == "0")) {
                    Notificar("@RsBase.ATENCAO_", "Informe o setor/departamento", "warning");
                    return;
                }
                if (ativDecisoria == 1) {
                    if (a && r != 0) {
                        if (aprovada && reprovada == true) {
                            AdicionaAtividade()

                        } else {
                            if (aprovada == false) {
                                Notificar("@RsCadastros.N_PROXIMA_ATIVIDADE_APROVADA", "@RsBase.VALOR_ATIVIDADE", "info")
                                if (reprovada == false) {
                                    Notificar("@RsCadastros.N_PROXIMA_ATIVIDADE_REPROVADA", "@RsBase.VALOR_ATIVIDADE", "info")
                                }

                            } else {
                                Notificar("@RsCadastros.N_PROXIMA_ATIVIDADE_REPROVADA", "@RsBase.VALOR_ATIVIDADE", "info")
                            }


                        }
                    }
                    // aprovada/reprovada valida ZERO
                    else {
                        Notificar("@RsBase.ERRO", "@RsBase.ERRO_NUMERO_ATIVIDADE", "info")
                    }

                }

                // ativDecisoria
                else {
                    AdicionaAtividade();

                }
            }
        }
}
