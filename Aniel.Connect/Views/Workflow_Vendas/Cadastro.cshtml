            Ativ_TipoDecisao_Desc: tipoAtividadeDecisoriaDesc,

            Horario_Atendimento: horaAtendimento,
            Horario_Atendimento_Desc: horaAtendimento_Desc,

            Ativ_NAtivAprovada: numeroProxAtividadeAprovada,

            Ativ_NAtivReprovada: numeroProxAtividadeReprovada,

            Ativ_AgendaTarefa: agendarAtividade,

        }).draw(false);
        $("#iDescricao_ativ").val(" ");
