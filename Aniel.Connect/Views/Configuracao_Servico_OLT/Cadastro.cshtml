@model Aniel.Connect.Models.Configuracao_Servico_OLTModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_CONFIGURACAO_SERVICO_OLT;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")
<script>

        $(document).ready(function () {
            $('#icontainer_periodo_execucao_diag').hide();
            $('#icontainer_horario_execucao_diag').hide();
            $('#icontainer_status_onu').hide();

            @if (Model.Id != 0) {
                if(Model.Extrair_Diagnostico_Onu == true)
                {
                    <text>
                        $('#icontainer_periodo_execucao_diag').show();
                        $('#icontainer_horario_execucao_diag').show();
                    </text>
                }

                if(Model.Consultar_Status_Onu == true)
                {
                     <text>
                        $('#icontainer_status_onu').show();
                    </text>
                }
            }
        });

        $('#iExtrair_Diagnostico').change(function () {
            if ($(this).is(':checked')) {
                $('#icontainer_periodo_execucao_diag').show();
                $('#icontainer_horario_execucao_diag').show();
            }
            else {
                $('#icontainer_periodo_execucao_diag').hide();
                $('#icontainer_horario_execucao_diag').hide();
                $('#iPeriodicidade_Execucao').val('');
                $('#iHora_Execucao').val('');
            }
        });

        $('#iConsultar_Status').change(function () {
            if ($(this).is(':checked')) {
                $('#icontainer_status_onu').show();
            }
            else {
                $('#icontainer_status_onu').hide();
                $('#iMinutos_Consulta_Status').val('');
            }
        });

        var clicked = false;
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;

            let erro = false

            if (ValidaCamposObrigatorios(erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            if ($('#iConsultar_Status').is(':checked')) {
                if (!$('#iMinutos_Consulta_Status').val()) {
                    Notificar("@RsBase.ATENCAO_", "Necessário informar intervalo em minutos para execução da consulta.", "warning")
                    erro = true
                }

                if ($('#iMinutos_Consulta_Status').val() < 5) {
                    Notificar("@RsBase.ATENCAO_", "Intervalo não pode ser menor que 5 minutos.", "warning")
                    erro = true
                }
            }

            if ($('#iExtrair_Diagnostico').is(':checked')) {
                if (!$('#iHora_Execucao').val()) {
                    Notificar("@RsBase.ATENCAO_", "Necessário informar horário de execução para extração de diagnóstico.", "warning")
                    erro = true
                }

                if (!$('#iPeriodicidade_Execucao').val()) {
                    Notificar("@RsBase.ATENCAO_", "Necessário informar periodicidade de execução para extração de diagnóstico.", "warning")
                    erro = true
                }
            }

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }
</script>
}


@using (Html.BeginForm("Cadastro", "Configuracao_Servico_OLT", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">

                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-digital-tachograph"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GERENCIAMENTO_REDE</a></li>
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Configuracao_Servico_OLT")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_CONFIGURACAO_SERVICO_OLT</a></li>
                                <li class="breadcrumb-item"><span>@ViewBag.Title</span></li>
                            </ol>
                        </nav>
                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>

                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">
                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iID" class="mr-3">@RsCadastros.ID:</label>
                                        @Html.TextBoxFor(model => model.Id, new { @class = "form-control", @id = "iID", @autocomplete = "off", @readonly = "readonly" })
                                        @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iDescricao">@RsCadastros.DESCRICAO:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control obrigatorio", @id = "iDescricao", @autocomplete = "off", @required = true })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iMarca_Modelo">@RsCadastros.MARCA_MODELO:</label>
                                        @{
                                            //Apenas os modelos de OLT atualmente compatíveis com o serviço Aniel.ExtratorOLTService
                                            var selectList = Enum.GetValues(typeof(Sinapse.Model.enumerados.Marca_Modelo_OLT))
                                                .Cast<Sinapse.Model.enumerados.Marca_Modelo_OLT>()
                                                .Where(e => e == Sinapse.Model.enumerados.Marca_Modelo_OLT.Huawei || 
                                                e == Sinapse.Model.enumerados.Marca_Modelo_OLT.Fiberhome_A1 ||  
                                                e == Sinapse.Model.enumerados.Marca_Modelo_OLT.Fiberhome_A_B || 
                                                e == Sinapse.Model.enumerados.Marca_Modelo_OLT.Datacom ||
                                                e == Sinapse.Model.enumerados.Marca_Modelo_OLT.ZTE)
                                                .OrderBy(e => Enum.GetName(typeof(Sinapse.Model.enumerados.Marca_Modelo_OLT), e))
                                                .Select(e => new SelectListItem
                                                {
                                                    Value = ((int)e).ToString(),
                                                    Text = e.ToString()
                                                });
                                        }
                                        @Html.DropDownListFor(p => p.Marca_Modelo_OLT, selectList, RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iMarca_Modelo", @autocomplete = "off" })
                                    </div>
                                </div>

                                @if (Model.Id != 0)
                                {
                                    <div class="col-sm-2 offset-3">
                                        <div class="form-group">
                                            <label for="iStatus">@RsFinanceiro.STATUS:</label><br />
                                            @Html.CheckBoxFor(m => m.Status, new { @class = "form-control obrigatorio", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = RsBase.ATIVAR, @data_off = RsBase.INATIVAR, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>

                                }
                            </div>

                            <div class="row">     
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iExtrair_Diagnostico" class="mr-3">@RsCadastros.EXECUTAR_EXTRACAO_DIAGNOSTICO_ONUS?</label><br />
                                        @Html.CheckBoxFor(m => m.Extrair_Diagnostico_Onu, new { @class = "form-control", @id = "iExtrair_Diagnostico", @name = " iExtrair_Diagnostico", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>

                                <div id="icontainer_periodo_execucao_diag" class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iPeriodicidade_Execucao">@RsCadastros.PERIODO_EXECUCAO:</label>
                                        @Html.EnumDropDownListFor(p => p.Periodicidade_Execucao, RsBase.SELECIONE, new { @class = "form-control", @id = "iPeriodicidade_Execucao", @autocomplete = "off" })
                                    </div>
                                </div>

                                <div id="icontainer_horario_execucao_diag" class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iHora_Execucao">@RsCadastros.HORARIO_EXECUCAO:</label>
                                        @Html.TextBoxFor(m => m.Hora_Execucao, new { @class = "form-control hora", @id = "iHora_Execucao", @placeholder = "00:00", @autocomplete = "on" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iConsultar_Status" class="mr-3">@RsCadastros.EXECUTAR_CONSULTA_STATUS_ONUS?</label><br />
                                        @Html.CheckBoxFor(m => m.Consultar_Status_Onu, new { @class = "form-control", @id = "iConsultar_Status", @name = " iConsultar_Status", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>

                                <div id="icontainer_status_onu" class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iMinutos_Consulta_Status">@RsCadastros.INTERVALO_MINUTOS:</label>
                                        @Html.TextBoxFor(m => m.Minutos_Execucao_Status_Onu, new { @class = "form-control integer", @id = "iMinutos_Consulta_Status", @autocomplete = "on", @type = "text", maxlength = "3" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>                
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Gerenciamento_Rede")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}
