    <script>

        var iFrameConversaAberto = false;
        //Lendo as notificações no Banco de Dados e montando o FrontEnd
        var listaNotificacoes = [];
        const messageSound = new Audio('@CONSTANTES.URLPortal/sounds/notificacaoPadrao.wav');
        const messageSoundSOS = new Audio('@CONSTANTES.URLPortal/sounds/warning-alarm-loop-1-279206.mp3');

        function AtualizarNotificacoes() {
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/NotificacoesApi/GetNotificacoes?usuario=")' + '@User.Identity.GetUserId()' + "&tipoStatus=" + ($('#iFiltrarSomenteNaoLidas').is(":checked") ? "1" : "");

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    @*data: {
                        usuario: @User.Identity.GetUserId(),
                        status: 0
                    }*@
                })
                    .done(function (data) {
                        listaNotificacoes = [];
                        console.log(data.length);
                        if (data.length > 0) {
                            $('#divNotificacao').empty();
                            if ($('#iBell').hasClass("notificacoesNaoLidas") == false) {
                                $('#iBell').addClass("notificacoesNaoLidas")
                                //verificar alteração
                                const array_som = ["40", "41"];
                                if (data.filter(x => array_som.includes(x.idNotificacao)).length > 0)
                                    messageSoundSOS.play().catch(e => console.error("Erro ao reproduzir som:", e));
                                else
                                    messageSound.play().catch(e => console.error("Erro ao reproduzir som:", e));
                            }
                            for (var i = 0; i < data.length; i++) {

                                listaNotificacoes.push(data[i].id);

                                var classe = "notification-list";
                                if (data[i].status_Notificacao == 1) {
                                    classe = "notification-list--unread";
                                }

                                $('#divNotificacao').append(
                                    `<a href="#!" class="notification-list ${classe}" id="check_${data[i].id}" data-chave="${data[i].chave}" data-acao="${data[i].acao}" dados-id="${data[i].id}">
                                    <div class="notification-list_img">
                                        <input type="checkbox" class="" ${data[i].status_Notificacao == 0 ? "checked" : ""}  onclick="AlterarStatusNotificacao(${data[i].id},event)" value="${data[i].id}" id="checkBox_${data[i].id}">
                                    </div>
                                    <div class="notification-list_detail">
                                        <p>${data[i].texto_Notificacao}</p>
                                        <p><small>${data[i].data_Envio}</small></p>
                                    </div>
                                </a>`
                                );

                            }
                        } else {
                            $('#iBell').removeClass("notificacoesNaoLidas")
                            $('#divNotificacao').empty();
                            $('#divNotificacao').append(
                                `<a href="#!" class="notification-list ${classe}">
                                    <div class="notification-list_img">
                                    </div>
                                    <div class="notification-list_detail">
                                        <p>Oba! Não há notificações nos últimos 30 dias!</p>
                                    </div>
                                </a>`
                            );
                        }

                        $(".notification-list").click(function (event) {
                            let chave = $(this).attr("data-chave");
                            //if (chave) {
                            //    let chaveSeparada = chave.split("|");
                            //}

                            const target = event.target;
                            const container = $(this); // .notification-list
                            const dados_id = $(this).attr("dados-id");// pega o ID da notificação

                            let chaveSeparada = chave.split("|");
                            let acao = $(this).attr("data-acao");

                            switch (acao) {
                                //Abrir a tela de Acompanhamento com todo os dados referentes ao  atendimento.
                                case "0":
                                    AddAba('@Url.Action("Cadastro","Atendimento")' + `?Id=${chaveSeparada[0]}`, '@Html.Raw(RsCadastros.ACOMPANHAMENTO_ATENDIMENTO)');
                                    break;

                                //Abrir a tela Vincular Monitor ao Técnico, já filtrando pelo monitor logado e listando suas equipes
                                case "1":
                                    AddAba('@Url.Action("AdicionarMonitor", "IdentityUser")', '@Html.Raw(RsCadastros.VINCULAR_MONITOR_EQUIPE)');
                                    break;

                                //Timeline de serviços
                                case "2":
                                    AddAba('@Url.Action("Gestao_Equipe", "Timeline_Servicos")', '@Html.Raw(RsCadastros.TIMELINE_SERVICOS)');
                                    break;

                                //Abrir a tela de cadastro de Ordem de Serviço desta OS
                                case "3":
                                    AddAba('@Url.Action("Index","Acompanhamento_Servico")' + `?CodCt=${chaveSeparada[0]}&Projeto=${chaveSeparada[1]}&Num_Doc=${chaveSeparada[2]}&Num_Obra=${chaveSeparada[3]}`, '@Html.Raw(RsCadastros.ACOMPANHAMENTO_SERVICO)');
                                    break;

                                //Abrir o Painel de Acompanhamento de Técnicos
                                case "4":
                                    AddAba('@Url.Action("Gestao_Equipe", "Acompanhamento_Equipes")', '@Html.Raw(RsCadastros.PAINEL_ACOMPANHAMENTO_EQUIPE)');
                                    break;

                                //Abrir painel de roteirização exibindo apenas os serviços roteirzados na data, ordenado pela data de roteirização da mais recente para mais antiga
                                case "5":
                                    AddAba('@Url.Action("Index", "Painel_Roteirizacao")', '@Html.Raw(RsCadastros.PAINEL_ROTEIRIZACAO)');
                                    break;

                                //Abrir painel de serviços exibindo as ordens de serviço sem data de agendamento da criada mais recente para mais antiga
                                case "6":
                                    AddAba('@Url.Action("Index", "Painel_Servicos")', '@Html.Raw(RsCadastros.PAINEL_SERVICOS)');
                                    break;

                                //Deverá abrir painel de vendas com data atual e todas as vendas no status cancelas até a hora do envio, que sejam daquele supervisor ou vendedor
                                case "8":
                                    AddAba('@Url.Action("Index", "Venda")', '@Html.Raw(RsCadastros.PAINEL_VENDAS)');
                                    break;

                                //Deverá abrir painel de vendas com data atual e todas as vendas no status aprovadas até a hora do envio, que sejam daquele supervisor ou vendedor
                                case "7":
                                    AddAba('@Url.Action("Index", "Venda")', '@Html.Raw(RsCadastros.PAINEL_VENDAS)');
                                    break;

                                //Deverá abrir a listagem de Prospects, exibindo (filtrando) apenas os que foram cadastrados na data atual.
                                case "9":
                                    AddAba('@Url.Action("Index", "Cliente_Prospecto")', '@Html.Raw(RsCadastros.CADASTRO_PROSPECTO)');
                                    break;

                                //Abri o painel de Acompanhamento de Vendedores
                                case "10":
                                    AddAba('@Url.Action("Dashboard_Vendas", "Venda")', '@Html.Raw(RsCadastros.ACOMPANHAMENTO_VENDAS)');
                                    break;

                                //Abrir o cadastro desta campanha
                                case "11":
                                    AddAba('@Url.Action("Cadastro","Campanha")' + `?Id=${chaveSeparada[0]}`, '@Html.Raw(RsCadastros.CAMPANHA)');
                                    break;

                                //Abrir o cadastro desta venda.
                                case "12":
                                    AddAba('@Url.Action("ClienteDadosGerais", "Venda")' + `?Id_Venda=${chaveSeparada[0]}`, '@Html.Raw(RsCadastros.CADASTRO_VENDAS)');
                                    break;

                                 //Abrir o chat em acompanhamento de serviços
                                case "13":
                                    AddAba('@Url.Action("Index","Acompanhamento_Servico")' + `?CodCt=${chaveSeparada[0]}&Projeto=${chaveSeparada[1]}&Num_Doc=${chaveSeparada[2]}&Num_Obra=${chaveSeparada[3]}#iChat`, '@Html.Raw(RsCadastros.ACOMPANHAMENTO_SERVICO)');
                                    break;

                                //Abrir o Log de Importação de ONUs
                                case "14":
                                    AddAba('@Url.Action("LogImportacaoONU", "EstruturaFibra")', '@Html.Raw(RsCadastros.IMPORTAR_ONUS)');
                                    break;

                                //Aceitar convite de chat
                                case "15":
                                    AtivarConvite("@User.Identity.GetUserId()", chaveSeparada[1]);
                                    break;

                                case "16": AddAba('@Url.Action("Painel_Atendimento","Atendimento")' + `?protocolo=${chaveSeparada[1]}`);
                                    break;

                                //Confirmar ciência sobre alerta SOS do técnico
                                case "17":
                                    if (!$(target).is('input[type="checkbox"]'))
                                    {
                                        // Localiza o checkbox dentro da notificação
                                        const checkbox = container.find(`#checkBox_${dados_id}`);
                                        const isChecked = checkbox.is(':checked');

                                        // Inverte o estado
                                        checkbox.prop("checked", !isChecked);
                                        AlterarStatusNotificacao(dados_id, event);
                                    }
                                    break;

                                //Acompanhamento de Serviços
                                case "":
                                    AddAba('@Url.Action("Index","Acompanhamento_Servico")' + `?CodCt=${chaveSeparada[0]}&Projeto=${chaveSeparada[1]}&Num_Doc=${chaveSeparada[2]}&Num_Obra=${chaveSeparada[3]}`, '@Html.Raw(RsCadastros.ACOMPANHAMENTO_SERVICO)');
                                    break;
                            }
                        });
                    });

                rows_selected = [];
            }

        async function AtivarConvite(usuario, protocolo) {

             var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoapi/AtivarConvite")';

             const data = await $.ajax({
                 url: link,
                 type: 'POST',
                 dataType: 'json',
                 data: {
                     usuarioConvidado: usuario,
                     protocolo: protocolo
                 }
             });

             if (data.ok) {
                 AddAba('@Url.Action("Painel_Atendimento", "Atendimento")' + `?protocolo=${protocolo}`, '@Html.Raw(RsCadastros.PAINEL_CONVERSAS_CHAT_ATENDIMENTO)');
             }
        }

        async function ConfirmarCienciaSOS(usuario, uuidNotificacao) {
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/NotificacoesApi/ConfirmarCienciaSOS")';

             const data = await $.ajax({
                 url: link,
                 type: 'POST',
                 dataType: 'json',
                 data: {
                     uuidNotificacao: uuidNotificacao,
                     equipeMonitor: usuario
                 }
             });

            if (data.ok) {
                @*Notificar("@RsBase.INFORMACAO", data.mensagem, "info");*@
                Swal.fire({
                    html: data.mensagem,
                    type: "info",
                    confirmButtonColor: "#3085d6",
                    confirmButtonText: "OK"
                });
            }
            else {
                @*Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");*@
                Swal.fire({
                    html: data.mensagem,
                    type: "warning",
                    confirmButtonColor: "#3085d6",
                    confirmButtonText: "OK"
                });
            }
        }

        async function AlterarStatusNotificacao(IdNotificacao,e) {

            var Status = $('#checkBox_' + IdNotificacao).is(":checked") ? "1" : "0";
            if (Status == '0') {
                Status = '1'
            } else {
                Status = '0'
            }

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/NotificacoesApi/alterarstatus")';

            const data = await $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    ids: IdNotificacao,
                    status: Status
                }
            });

            if (data.ok) {
                //Status = 0 -> Lida -> passar para não lida
                //Status = 1 -> Não Lida -> passar para lida
                if (Status == '0') {
                    $('#check_' + IdNotificacao).removeClass('notification-list--unread');
                    document.querySelector('#checkBox_' + IdNotificacao).value = 1;
                } else {
                    $('#check_' + IdNotificacao).addClass('notification-list--unread');
                    document.querySelector('#checkBox_' + IdNotificacao).value = 0;
                }
                AtualizarNotificacoes();
                /*$('#checkBox_' + IdNotificacao).prop("checked", false);*/
            }

            let dataAcao = $('#check_' + IdNotificacao).attr("data-acao")
            if (dataAcao == 17) {
                ConfirmarCienciaSOS("@User.Identity.GetUserId()", [$('#check_' + IdNotificacao).attr("data-chave")]);
            }

            e.stopImmediatePropagation();
            e.stopPropagation();
        }

        function MarcarComoLidas(e) {

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/NotificacoesApi/alterarstatus")';

            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    ids: listaNotificacoes,
                    status: '0'
                }
            })
                .done(function (data) {

                    if (data.ok) {

                        for (var i = 0; i < listaNotificacoes.length; i++) {
                            $('#check_' + listaNotificacoes[i]).removeClass('notification-list--unread');
                        }

                        AtualizarNotificacoes();

                        let arrayCiencia = [];
                        for (let IdNotificacao of listaNotificacoes)
                        {
                            let dataAcao = $('#check_' + IdNotificacao).attr("data-acao")
                            if (dataAcao == 17) {
                                arrayCiencia.push($('#check_' + IdNotificacao).attr("data-chave"));
                            }
                        }

                        ConfirmarCienciaSOS("@User.Identity.GetUserId()", arrayCiencia);

                    }


                });

            e.stopPropagation();



            //var sList = "";
            //$('input[type=checkbox]').each(function () {
            //    if (this.checked) {
            //        sList += $(this).val() + ",";
            //    }
            //});
            //console.log(sList);
            //e.stopPropagation();
        }

        @if (ViewBag.UsaAlertaNotificacoes)
        {
            int minutos = ViewBag.MinutosAtualizaNotificacoes ?? 1;
            <text>
            try
            {
                let timer = @minutos * 60000; // 1 min = 60000 miliseg.
                setInterval(function () {
                    AtualizarNotificacoes();
                }, timer);
            }
            catch(e)
            {
                console.error(e, e.stack);
            }
            </text>
        }

        //FIM NOTIFICAÇÃO

        var baseUrl = '@CONSTANTES.URLPortal';
        var username = '@HttpContext.Current.User.Identity.Name.ToString()';
        var empresa = '@ViewBag.Empresa';
        var idAcesso = window.localStorage.getItem("ConnectIdAcesso") ? window.localStorage.getItem("ConnectIdAcesso") : '@ViewBag.IdAcesso' ;

        var finalizarConexaoDuranteSolicitacao;
        var AGUARDANDO_CONFIRMACAO = false;

        function SolicitacaoChat(message, chat, chatHub) {

            AGUARDANDO_CONFIRMACAO = true;
            finalizarConexaoDuranteSolicitacao = function () {
                console.log("teste");
                if (chatHub && chatHub.connection.state == 1) {
                    console.log('finalizando conexao')
                    chatHub.server.finalizarConexaoSuporte(chat, '@User.Identity.GetUserId()');
                    $.connection.hub.stop().done(function () {
                        alert('stopped');
                    });
                }
            }

            window.addEventListener("beforeunload", finalizarConexaoDuranteSolicitacao);

            let timerInterval
            const alertSound = new Audio('@CONSTANTES.URLPortal/sounds/livechat-129007.mp3');
            alertSound.play().catch(e => console.error("Erro ao reproduzir som:", e));

            Swal.fire({
                title: 'Você recebeu uma solicitação de atendimento por chat!',
                html: `${message}</br><span style="font-size:12px">Essa solicitação irá fechar em <b></b> segundos.</span>`,
                timer: 15000,
                timerProgressBar: true,
                showConfirmButton: true,
                customClass: "swal2-lg",
                confirmButtonText: "@RsBase.SIM",
                cancelButtonText: "@RsBase.NAO",
                showCancelButton: true,
                allowOutsideClick: false,
                onBeforeOpen: () => {
                    timerInterval = setInterval(() => {
                        const content = Swal.getContent()
                        if (content) {
                            const b = content.querySelector('b')
                            if (b) {
                                b.textContent = Math.round(Swal.getTimerLeft() / 1000)
                            }
                        }
                    }, 100)
                },
                onClose: () => {
                    clearInterval(timerInterval)
                }
            }).then(async (result) => {

                AGUARDANDO_CONFIRMACAO = false;
                window.removeEventListener("beforeunload", finalizarConexaoDuranteSolicitacao);

                /* Read more about handling dismissals below */
                if (!result.value || result.dismiss === Swal.DismissReason.timer) {

                    if (chat.suporte) {
                        chat.suporte.foto = "";
                    }
                    else {
                        chat.suporte = suporte
                    }

                    await chatHub.server.negarAtendimento(chat, '@User.Identity.GetUserId()')
                }
                else {

                    const resultado = await $.ajax({
                        url: `@CONSTANTES.URLPortal/api/Atendimentoapi/BuscaDados?protocolo=${chat.protocolo}`,
                        type: 'GET',
                        dataType: 'json',
                        beforeSend: function () {
                            $("#divProgress").show();
                        },
                        complete: function () {
                            $("#divProgress").hide();
                        }
                    });

                    if (resultado.ok) {
                        const obj = resultado.objeto;
                        if (obj.id_Responsavel) {
                            await Swal.fire({
                                text: `Não é possível assumir atendimento, pois, o mesmo já se encontra em andamento.`,
                                type: 'warning',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'OK',
                            });
                            return false;
                        }
                    } else {
                        Notificar("@RsBase.ATENCAO_", resultado.mensagem, "warning");
                        return false;
                    }

                    if (chat.suporte) {
                        chat.suporte.foto = "";
                    }
                    else {
                        chat.suporte = suporte
                    }

                    await chatHub.server.aceitarAtendimento(chat, '@User.Identity.GetUserId()')
                    AddAba('@Url.Action("Cadastro","Atendimento")' + `?Numero_Protocolo=${chat.protocolo}`, '@RsCadastros.CHAT')
                }
            });
        }



