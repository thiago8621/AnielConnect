    <style>

        .notification-ui a:after {
            display: none;
        }

        .aConfig {
            color: #5f5f5f;
            font-weight: lighter;
        }

        .notification-ui_icon {
            position: relative;
        }

            .notification-ui_icon .unread-notification {
                display: inline-block;
                height: 7px;
                width: 7px;
                border-radius: 7px;
                background-color: #66bb6a;
                position: absolute;
                top: 7px;
                left: 12px;
            }

        .notification-ui_dd {
            padding: 0;
            border-radius: 10px;
            box-shadow: 0 5px 20px -3px rgba(0, 0, 0, 0.16);
            border: 0;
            max-width: 400px;
        }

            .notification-ui_dd:after {
                content: "";
                position: absolute;
                top: -30px;
                left: calc(50% - 7px);
                border-top: 15px solid transparent;
                border-right: 15px solid transparent;
                border-bottom: 15px solid #fff;
                border-left: 15px solid transparent;
            }

            .notification-ui_dd .notification-ui_dd-header {
                border-bottom: 1px solid #ddd;
                padding: 15px;
            }

                .notification-ui_dd .notification-ui_dd-header h3 {
                    margin-bottom: 0;
                }

            .notification-ui_dd .notification-ui_dd-content {
                max-height: 550px;
                overflow: auto;
            }

        .notification-list {
            display: flex;
            /*justify-content: space-between;*/
            padding: 20px 25px;
            border-bottom: 1px solid #ddd;
        }

        .notification-list--unread {
            position: relative;
            background: #e2f1f9;
        }

            .notification-list--unread:before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                height: calc(100% + 1px);
                border-left: 2px solid #007bff;
            }

        .notification-list .notification-list_img img {
            height: 42px;
            width: 42px;
            border-radius: 50px;
            margin-right: 20px;
        }

        .notification-list .notification-list_detail {
            /*margin-right: auto;*/
            /*max-width: 200px;*/
            margin-left: 5px;
            color: #5c5c5c;
            text-align: justify;
        }

            .notification-list .notification-list_detail p {
                margin-bottom: 5px;
                line-height: 1.2;
            }

            .notification-list .notification-list_detail .nt-link {
                border-left: 3px solid #007bff;
                line-height: 1.3;
                padding-left: 10px;
            }

        .small, small {
            color: #969696;
        }

        .checkbox-round {
            width: 1.3em;
            height: 1.3em;
            background-color: white;
            border-radius: 50%;
            vertical-align: middle;
            border: 1px solid #ddd;
            appearance: none;
            -webkit-appearance: none;
            outline: none;
            cursor: pointer;
        }

            .checkbox-round:checked {
                background-color: cornflowerblue;
            }



        /*Status Chat*/
        .chat-online {
            color: limegreen !important;
        }

        .chat-em-atendimento {
            color: red !important;
        }

        .chat-offline {
            color: gray !important;
        }

        .notificacao_index {
            max-width: 50%;
            padding: 5px;
            margin-top: 10px;
            width: 100%;
        }

        .collapse-company-text {
            writing-mode: vertical-rl;
            text-orientation: upright;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: inline-block;
            max-width: 93%;
            color: #b8c7ce;
            max-height: 25%;
            border: 1px solid;
            padding: 5px;
            margin-top: 10px;
            width: 100%;
            padding-right: 10px;
        }

        .uncollapse-company-text {
            writing-mode: initial;
            text-orientation: upright;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: inline-block;
            max-width: 93%;
            color: #b8c7ce;
            max-height: 25%;
            border: 1px solid;
            padding: 5px;
            margin-top: 10px;
            width: 100%;
            padding-right: 10px;
        }


        .swal2-popup .swal2-styled {
            margin: 10px !important;
            padding: 5px !important;
            font-weight: normal !important;
            box-shadow: none !important;
            height: 35px !important;
            width: 75px !important;
        }

        .swal2-popup {
            /*width: 20em !important;*/
        }

        .swal2-lg {
            width: 500px !important
        }

        .swal2-icon.swal2-warning {
            font-size: 10px !important;
        }

        .swal2-popup .swal2-title {
            font-size: 16px !important;
        }

        .swal2-popup .swal2-input {
            height: 1.625em !important;
        }

        .swal2-popup .swal2-actions {
            margin: 0 !important;
        }

        .swal2-popup .swal2-styled.swal2-confirm {
            font-size: 12px !important;
        }

        .swal2-popup .swal2-styled.swal2-cancel {
            font-size: 12px !important;
        }

        .notificacoesNaoLidas {
            background-color: #dc1c1b !important;
            color: white !important;
        }
    </style>

