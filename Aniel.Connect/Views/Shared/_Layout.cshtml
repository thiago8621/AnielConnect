                    $("#iStatusChat").text("Online");

                }
                else {

                    $(".color-status-chat").removeClass("chat-online");
                    $(".color-status-chat").addClass("chat-offline");
                    $("#iStatusChat").text("Offline");
                }
            }

            chatback.client.mensagemResposta = (mensagem) => {
                if (mensagem.usuario.num_fre != "@User.Identity.GetUserId()") {
                    document.querySelectorAll('iframe').forEach(item => {
                        let iframe = item.contentWindow.document.body.querySelector(`iframe[data-pageid="chatback${mensagem.num_os}"]`)
                        if (iframe != null) {
                            item.contentWindow.renderMessage(mensagem.mensagem, mensagem.dataHora, mensagem.usuario, 'recebido', null, mensagem.anexo, mensagem);
                            item.contentWindow.animateMessageScroll();
                        }
                        else {
                            item.contentWindow.document.querySelectorAll('iframe').forEach(subitem => {
                                let iframesub = subitem.contentWindow.document.body.querySelector(`iframe[data-pageid="chatback${mensagem.num_os}"]`)
                                if (iframesub != null) {
                                    subitem.contentWindow.renderMessage(mensagem.mensagem, mensagem.dataHora, mensagem.usuario, 'recebido', null, mensagem.anexo, mensagem);
                                    subitem.contentWindow.animateMessageScroll();
                                }
                            })
                        }
                    })
                }
            }

            chat.client.statusUsuario = (online) => {

                if (online) {

                    $(".color-status-chat").removeClass("chat-offline");
                    $(".color-status-chat").addClass("chat-online");
                    $("#iStatusChat").text("Online");

