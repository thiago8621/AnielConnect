                            if (obj.id_Responsavel === '' || obj.id_Responsavel == null) {
                                SolicitacaoChat(message, chatObject, chat);
                            }
                        }
                    }).fail(function (err) {
                        console.error("Erro na requisição:", err);
                    });

                } else {
                    if (chatObject.suporte) {
                        chatObject.suporte.foto = "";
                    } else {
                        chatObject.suporte = suporte;
                    }

                    chat.server.negarAtendimento(chatObject, '@User.Identity.GetUserId()');
                }

            };

            chat.client.mensagemResposta = (mensagem) => {
                document.querySelectorAll('iframe').forEach(item => {
                    let iframe = item.contentWindow.document.body.querySelector(`iframe[data-pageid="chat${mensagem.protocolo}"]`)
                    if (iframe != null) {
                        iFrameConversaAberto = true;
                        item.contentWindow.renderMessage(mensagem.mensagem, mensagem.dataHora, mensagem.usuario, mensagem.enviadoPeloSuporte, false, mensagem.arquivos, mensagem.protocolo);
                        item.contentWindow.animateMessageScroll();
                    }
                    else {
                        iFrameConversaAberto = false;
                    }
                });
            }

            chat.client.AtualizarPainelConversas = (mensagem) => {

                let abaAtiva = $(".menu_tab.active"); //pego a aba ativa do Connect

                if (document.hidden) /*caso o usuario esteja em outra aba*/ {
                    tocarNotificacaoMensagem();
                }
                else if (!abaAtiva[0].innerText.includes('Painel de Conversas Atendimento')) /*caso a aba do usuario nao seja o painel de cvs */ {
                    tocarNotificacaoMensagem();
                }
                else if (!iFrameConversaAberto) /*frame da conversa aberto*/{
                    tocarNotificacaoMensagem();
                }

                document.querySelectorAll("iframe").forEach(frame => {

                    try {
                        const win = frame.contentWindow;

                        // Verifica se o método existe e é uma função
                        if (win && typeof win["atualizarPainelConversas"] === "function") {
                            win["atualizarPainelConversas"](mensagem); // Executa o método
                        }
                    } catch (err) {
                        console.warn("Erro ao acessar iframe:", err);
                    }

                });
            }
            chat.client.AtualizarNotificacoes = () => {
