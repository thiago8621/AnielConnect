            chat.client.clienteAguardandoAtendimento = function (message, chatObject) {

                if (!AGUARDANDO_CONFIRMACAO) {

                    $.ajax({
                        url: `@CONSTANTES.URLPortal/api/Atendimentoapi/BuscaDados?protocolo=${chatObject.protocolo}`,
