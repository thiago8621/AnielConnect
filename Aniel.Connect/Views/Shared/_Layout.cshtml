    <script type="text/javascript">

        function my_onkeydown_handler(event) {
            switch (event.keyCode) {
                case 116: // 'F5'
                    event.preventDefault();
                    event.keyCode = 0;
                    window.status = "F5 disabled";
                    refreshTab();
                    break;
            }
        }

        function AddAba(url, title, id = 'null') {

            addTabs({
                id: id,
                title: title,
                close: true,
                url: url,
                urlType: "absolute"
            });
        }

        /**
         * Menu de pesquisa local
         */
        function search_menu() {
            //O valor para procurar
            var text = $('input[name=q]').val();

            var $ul = $('.sidebar-menu');
            $ul.find("a.nav-link").each(function () {
                var $a = $(this).css("border", "");

                //Determine se há uma string para procurar
                if ($a.children("span.menu-text").text().indexOf(text) >= 0) {

                    //Se o pai da tag a estiver oculto, expanda
                    $ul = $a.parents("ul");

                    if ($ul.is(":hidden")) {
                        $a.parents("ul").prev().click();
                    }

                    //Clique no menu
                    $a.click().css("border", "1px solid");

                    //                return false;
                }
            });
        }

        $(function () {

            App.setbasePath("@CONSTANTES.URLPortal/");
            App.setGlobalImgPath("Images/");

            @{
                var Tipo = DashBoardService.GetPaginaInicial(User.Identity.GetUserId()).Result;

                if (Tipo == Sinapse.Model.enumerados.DashboardInicialConnect.AtendimentoCliente)
                {
                    <text>
                        addTabs({
                            id: '1',
                            title: '@Html.Raw(RsBase.INICIO)',
                            close: false,
                            url: '@Url.Action("Atendimento", "Dashboard")',
                            urlType: "absolute"
                            });
                    </text>
                }
                else if (Tipo == Sinapse.Model.enumerados.DashboardInicialConnect.Comercial)
                {
                    <text>
                        addTabs({
                            id: '1',
                            title: '@Html.Raw(RsBase.INICIO)',
                            close: false,
                            url: '@Url.Action("Vendas", "Dashboard")',
                            urlType: "absolute"
                            });
                    </text>
                }
                else if (Tipo == Sinapse.Model.enumerados.DashboardInicialConnect.Servicos)
                {
                    <text>
                        addTabs({
                            id: '1',
                            title: '@Html.Raw(RsBase.INICIO)',
                            close: false,
                            url: '@Url.Action("Servicos", "Dashboard")',
                            urlType: "absolute"
                            });
                    </text>
                }
                else
                {
                    <text>
                    addTabs({
                        id: '1',
                        title: '@Html.Raw(RsBase.INICIO)',
                        close: false,
                        url: '@Url.Action("Servicos", "Dashboard")',
                        urlType: "absolute"
                        });
                    </text>
                }
            }

            @if (Request.QueryString["Aba"] == "Comercial")
            {
                <text>
                addTabs({
                        id: null,
                        title: '@Html.Raw(RsCadastros.COMERCIAL)',
                        close: false,
                        url: '@Url.Action("Index", "Comercial")',
                        urlType: "absolute"
                });
                </text>
            }
            else if (Request.QueryString["Aba"] == "Atendimento")
            {
                <text>
                addTabs({
                        id: null,
                        title: '@Html.Raw(RsCadastros.LISTAGEM_ATENDIMENTO)',
                        close: false,
                        url: '@Url.Action("Index", "Atendimento")',
                        urlType: "absolute"
                });
                </text>
            }
            else if (Request.QueryString["Aba"] == "Servico")
            {
                <text>
                addTabs({
                        id: null,
                        title: '@Html.Raw(RsCadastros.GESTAO_EQUIPES)',
                        close: false,
                        url: '@Url.Action("Index", "Gestao_Equipe")',
                        urlType: "absolute"
                });
                </text>
            }
             else if (Request.QueryString["Aba"] == "Roteirizacao")
            {
                <text>
                addTabs({
                        id: null,
                        title: '@Html.Raw(RsCadastros.ROTEIRIZACAO)',
                        close: false,
                        url: '@Url.Action("Index", "Painel_Roteirizacao")',
                        urlType: "absolute"
                });
                </text>
            }
              else if (Request.QueryString["Aba"] == "Cliente")
            {
                <text>
                addTabs({
                        id: null,
                        title: '@Html.Raw(RsCadastros.GESTAO_CLIENTES)',
                        close: false,
                        url: '@Url.Action("Index", "Cliente")',
                        urlType: "absolute"
                });
                </text>
            }

            @*addTabs({
                        id: '1',
                        title: 'Dashboard',
                        close: true,
                        url: '@Url.Action("Atendimento", "Dashboard")',
                        urlType: "absolute"
                        });*@

            App.fixIframeCotent();

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/AcessoConnectApi/GetMenu_IFrame?id_usuario=", User.Identity.GetUserId())';

            $.ajax({
                url: link,
                type: 'GET',
                dataType: 'json',

            })
                .done(function (data) {
                    let menus = data;

                    $('.sidebar-menu').sidebarMenu({ data: menus });

                    $.AdminLTE.layout.fixSidebar();

                    if ($.AdminLTE.options.sidebarSlimScroll) {
                        if (typeof $.fn.slimScroll != 'undefined') {
                            //Destroy if it exists
                            var $sidebar = $(".sidebar");
                            $sidebar.slimScroll({destroy: true}).height("auto");
                            //Add slimscroll
                            $sidebar.slimscroll({
                            height: ($(window).height() - $(".main-header").height()) + "px",
                                color: "rgba(0,0,0,0.2)",
                                size: "3px"
                            });
                        }
                    }



                })
                .fail(function (e) {
                    console.log(e);
                })
                .always(function () {

                });

        });

        $("#iBtnCollapse").click(function () {

            //Desktop
            if ($("body").hasClass("sidebar-collapse")) {
                $("#iCompanyText").removeClass("collapse-company-text");
                $("#iCompanyText").addClass("uncollapse-company-text");
            } else {
                $("#iCompanyText").removeClass("uncollapse-company-text");
                $("#iCompanyText").addClass("collapse-company-text");
            }

        });

        async function Online() {

            $(".color-status-chat").removeClass("chat-offline");
            $(".color-status-chat").addClass("chat-online");
            $("#iStatusChat").text("Online");

            $.ajax({
                url: '@String.Concat(CONSTANTES.URLPortal, "/api/Atendimentoapi/AlterarStatusAgente")',
                type: 'POST',
                data: {
                    motivoAusencia: "",
                    online: true,
                    idSuporte: '@User.Identity.GetUserId()'
                },
                dataType: 'json',
            });

        }

        async function Offline() {

            if ($(".color-status-chat").hasClass("chat-offline") == false) {
                Swal.fire({
                    title: 'Você esta inserindo o status Offline. Deseja Continuar?',
                    text: "",
                    type: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sim',
                    cancelButtonText: 'Não',
                    allowOutsideClick: false
                }).then(async (result) => {
                    if (result.value) {
                        await Confirmar_Offline();
                    }
                });
            }
        }

        async function Confirmar_Offline() {

            const { value: text } = await Swal.fire({
                input: 'textarea',
                inputAttributes: {
                    maxlength: 32
                },
                title: 'Informe o motivo da ausência',
                inputPlaceholder: 'Até 30 caracteres ...',
                inputAttributes: {
                    'aria-label': 'Type your message here'
                },
                showCancelButton: true,
                allowOutsideClick: false
            })

            if (text) {
                Swal.fire(text)
                $(".color-status-chat").removeClass("chat-online");
                $(".color-status-chat").addClass("chat-offline");
                $("#iStatusChat").text("Offline");
            }

            $.ajax({
                url: '@String.Concat(CONSTANTES.URLPortal, "/api/Atendimentoapi/AlterarStatusAgente")',
                type: 'POST',
                data: {
                    motivoAusencia: text,
                    online: false,
                    idSuporte: '@User.Identity.GetUserId()'
                },
                dataType: 'json',
            });

        }

        var idAcesso = window.localStorage.getItem("ConnectIdAcesso") ? window.localStorage.getItem("ConnectIdAcesso") : '@ViewBag.IdAcesso' ;

        function HandleLogOff() {
            var url = "@Url.Action("LogOff", "Account")" + '?IdAcesso=' + idAcesso;
            window.localStorage.setItem("ConnectIdAcesso", "");
            window.location = url;
        }


    </script>

    @RenderSection("scripts", required: false)

</body>
</html>
