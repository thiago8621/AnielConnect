                            idSuporte: '@User.Identity.GetUserId()',
                            categorias: data.categorias,
                            localidades: data.localidades,
                            qtdMaximaAtendimentos: data.qtdeMaximaAtendimentos,
                            nomeAgente: data.nomeAgente,
                            inicioAtendimento: data.inicioAtendimento,
                            terminoAtendimento: data.terminoAtendimento
                        });

                        let timerBuscaAtivaAtendimento = 1 * 60000; // 1 min = 60000 miliseg.
                        setInterval(function () {
                            if (!AGUARDANDO_CONFIRMACAO) {
                                chat.server.buscaAtivaAtendimento('@User.Identity.GetUserId()');
                            }
                        }, timerBuscaAtivaAtendimento);

                    }
                });
            }).fail(function (e) {
                console.log('Could not Connect!');
                console.log(e);
            });

            $.connection.hub.disconnected(function () {
                setTimeout(function () {

                    $.connection.hub.start().done(function () {
                        suporte = {
                            status: 1,
                            idConexaoChat: chatback.connection.id,
                            idSuporte: '@User.Identity.GetUserId()'
                        };

                        chatback.server.iniciarConexaoSuporte({
                            status: 1,
                            idConexaoChat: chatback.connection.id,
                            idSuporte: '@User.Identity.GetUserId()'
                        });

                        let iframesValidar = Array.from(document.querySelectorAll('iframe'))
                                                  .map(y => y.contentWindow.document.body.querySelector('iframe'))
                                                  .filter(p => p != null);

                        for (item of iframesValidar){
                          if ($(item).attr("data-pageid") && $(item).attr("data-pageid").includes("chat"))
                          {
                            let protocoloRevincular = $(item).attr("data-pageid").replace("chat", "");
                            chat.server.entrarChatAtendimento(protocoloRevincular, "@User.Identity.GetUserId()", chat.connection.id);
                            chat.client.mensagemResposta = (mensagem) => {
                                if (!mensagem.enviadoPeloSuporte) {
                                    $('#chatFrame').contentWindow.renderMessage(mensagem.mensagem, mensagem.dataHora, mensagem.usuario, false, false, mensagem.arquivos, mensagem.protocolo)
                              }
                            }
                          }
                        }

                        $.ajax({
                            url: '@String.Concat(CONSTANTES.URLPortal, "/api/agenteapi/getAgente?Usuario=", User.Identity.GetUserId())',
                            type: 'GET',
                            dataType: 'json',
                        }).done(function (data) {
                            if (data.atendeChat) {
                                suporte = {
                                    status: 1,
                                    idConexaoChat: chat.connection.id,
                                    idSuporte: '@User.Identity.GetUserId()',
                                    categorias: data.categorias,
                                    localidades: data.localidades,
                                    qtdMaximaAtendimentos: data.qtdeMaximaAtendimentos,
                                    nomeAgente: data.nomeAgente,
                                    inicioAtendimento: data.inicioAtendimento,
                                    terminoAtendimento: data.terminoAtendimento

                                };

                                chat.server.iniciarConexaoSuporte({
                                    status: 1,
                                    idConexaoChat: chat.connection.id,
                                    idSuporte: '@User.Identity.GetUserId()',
                                    categorias: data.categorias,
                                    localidades: data.localidades,
                                    qtdMaximaAtendimentos: data.qtdeMaximaAtendimentos,
                                    nomeAgente: data.nomeAgente,
                                    inicioAtendimento: data.inicioAtendimento,
                                    terminoAtendimento: data.terminoAtendimento

                                });
                            }

                        });





                    }, 10000);

                });


                //************ FIM CHAT BACKOFFICE ****************
                //************ FIM CHAT BACKOFFICE ****************









            });

            AtualizarNomeEmpresa();
            // This optional function html-encodes messages for display in the page.
            document.addEventListener("keydown", my_onkeydown_handler);
        });




    </script>

    <script>
        $(document).on('click', '.menu_tab', function () {
            setTimeout(function () {
                var pageId = $('.menu_tab.active').data('pageid');
                const iframe = document.querySelector(`iframe[data-pageid="${pageId}"]`);
                var iframeWindow = iframe.contentWindow;

                if (iframeWindow.$.fn.dataTable) {
                    var allSettings = iframeWindow.$.fn.dataTable.settings;

                    var tableSettings = $.grep(allSettings, function (s) {
                        return $(s.nTable).hasClass('trocaAba');
                    });

                    if (tableSettings.length > 0) {
                        var dt = new iframeWindow.$.fn.dataTable.Api(tableSettings[0]);
                        dt.columns.adjust();
                    }
                }
            }, 50);
        });
    </script>

