<!DOCTYPE html>
@using Aniel.Connect.Core
@using System.Configuration
@using Aniel.Connect.Core.Helpers

@*<html lang="@CultureHelper.GetCurrentNeutralCulture()" dir="@(CultureHelper.IsRighToLeft() ? "rtl" : "ltr")" style="overflow:hidden">*@
<html lang="@CultureHelper.GetCurrentNeutralCulture()" dir="@(CultureHelper.IsRighToLeft() ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">

    <meta http-equiv="cache-control" content="max-age=0" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="expires" content="Tue, 01 Jan 1980 1:00:00 GMT" />
    <meta http-equiv="pragma" content="no-cache" />

    <title>@ViewBag.Title</title>

    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/csslayoutlimpo")

    <!--[if lt IE 9]>
        <script src="../assets/js/ie8-responsive-file-warning.js"></script>
        <![endif]-->
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
        <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
    <!-- Favicons -->
    <link rel="shortcut icon" href="~/images/favicon/favicon.png" type="image/x-icon" />
    <link href="~/images/favicon/favicon.png" rel="shortcut icon">
    <link href="~/images/favicon/apple-touch-icon-57-precomposed.png" rel="apple-touch-icon">
    <link href="~/images/favicon/apple-touch-icon-72-precomposed.png" rel="apple-touch-icon" sizes="72x72">
    <link href="~/images/favicon/apple-touch-icon-144-precomposed.png" rel="apple-touch-icon" sizes="114x114">

    @RenderSection("styles", required: false)

    @RenderSection("variaveis", required: false)

    <script>
        var baseUrl = '@CONSTANTES.URLPortal';
        var username = '@HttpContext.Current.User.Identity.Name.ToString()';
        var logoCliente = '@CONSTANTES.LogoCliente64';
        var appName = '@Html.Raw(RsBase.TITULOCONNECT)';
    </script>

    <script src="~/bin/Content/DataTables/datatable.variaveis.js"></script>

    <style>
        #divAlterarEndereco {
            overflow-y: auto !important; /* Adiciona a barra de rolagem vertical */
        }

        /*Status Chat*/
        .chat-online {
            color: limegreen !important;
        }

        .chat-em-atendimento {
            color: red !important;
        }

        .chat-offline {
            color: gray !important;
        }
    </style>


</head>
<body class="hold-transition skin-blue sidebar-mini">

    @RenderBody()

    @Scripts.Render("~/bundles/jslayoutlimpo")

    @if (ViewData.ModelState.Any(x => x.Value.Errors.Any()))
    {
        <script type="text/javascript">
        $(document).ready(function () {

            var erros = @HtmlExtensions.GetStringToast(Html.ValidationSummary());
            var i;
            for (i = 0; i < erros.length; i++) {
                    if (erros[i] != "S" && erros[i] != "N") {
                        Notificar("Atenção!", erros[i], "warning");
                        }
                }

        });
        </script>
    }

    @if (TempData["INFOS"] != null)
    {
        if (((List<String>)TempData["INFOS"]).Count > 0)
        {
            <script type="text/javascript">
                $(document).ready(function () {

                    QueueNotificar(@Html.Raw(Json.Encode(TempData["INFOS"])))

                    if (queueNotificacao.length != 0)
                        Swal.queue(queueNotificacao)
                });
            </script>
        }
    }

    @RenderSection("scripts", required: false)

</body>
</html>
