@model Aniel.Connect.Models.EquipeVendasCadastroModel

@{

    ViewBag.Title = RsCadastros.CADASTRO_EQUIPE_VENDAS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>

    let oDatatableSupervisor = null;
  
    AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/EquipeVendasApi/GetComboSupervisorComercial", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

    var handleDataTableSupervisor = function () {
        "use strict";

        var array = @Html.Raw(Json.Encode(Model.SupervisoresLista));

        var nome_lista = "SupervisoresLista";//Nome_utilizado para enganar o razor
         
        //"Blfrtip"
        oDatatableSupervisor = $("#datatableSupervisor").length && $("#datatableSupervisor").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: array,
            paging: false,
            drawCallback: () => {
                handleExcluir();
            },
            order: [],
            columns: [
                {
                    data: "Id",
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluirSupervisor" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id_Supervisor" name="' + nome_lista + '[' + meta.row + '].Id_Supervisor" type="hidden" value="' + TrataNulo(row.Id_Supervisor) + '">';      
                    }
                },
                {
                    data: "Supervisor",
                    title: "@RsCadastros.NOME",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Supervisor" name="' + nome_lista + '[' + meta.row + '].Supervisor" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                        return data;
                    }
                }
            ]
        });

        function handleExcluir() {
            $(".btnExcluirSupervisor").unbind('click');
            $(".btnExcluirSupervisor").click(function (e) {
                e.preventDefault();

                var idExcluir = $(this).attr("excluir");

                var trLinkButton = $(this).parents('tr');

                if (idExcluir === "0") {
                    oDatatableSupervisor.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
                else
                {
                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/EquipeVendaApi/Excluir?value=")' + idExcluir;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',
                    })
                    .done(function (data) {

                    if (data.ok) {
                        oDatatableSupervisor.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                    })
                    .fail(function () {

                    })
                    .always(function () {

                    });
                }
            });
        }

        handleExcluir();

        $("#btnAdicionarSupervisor").unbind('click');
        $("#btnAdicionarSupervisor").on('click', function () {

            var erro = false;

            if (ValidaObrigatoriosPorClasse("obrigatorioSupervisor", erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            for (var i = 0; i < oDatatableSupervisor.rows().data().length; i++) {

                if (oDatatableSupervisor.rows().data()[i].Id_Supervisor == $("#iSupervisor").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.SUPERVISOR)", "warning");
                    erro = true;
                    i = oDatatableSupervisor.rows().data().length;
                }
            }

            if (erro) {
                return;
            }

            oDatatableSupervisor.row.add({
                Id: 0,
                Id_Supervisor: $("#iSupervisor option:selected").val(),
                Supervisor: $("#iSupervisor option:selected").text()
            }).draw(false);

            handleExcluir();


            $("#iSupervisor").val("").trigger('change');

        });
    },
    TableManageButtonsSupervisor = function () {
        "use strict";
        return {
            init: function () {
                handleDataTableSupervisor();
            }
        }
    }();

    TableManageButtonsSupervisor.init();

    function validaSubmit() {

        var erro = false;

        if (!$('#iDescricao').val()) {

            Notificar("@RsBase.ATENCAO_", '@RsCadastros.DESCRICAO não informada', "warning");
            erro = true;
        }

        if (oDatatableSupervisor.data().toArray() == 0) {
            Notificar("@RsBase.ATENCAO_", "Adicione um Supervisor para salvar Equipe.", "warning");
            erro = true;
        }
        if (erro) {
            return;
        }
        $('#form').submit();
    }

</script>
}


@using (Html.BeginForm("Cadastro", "EquipeVendas", FormMethod.Post, htmlAttributes: new { @id = "form" }))
 {
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fa-solid fa-code-branch"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "EquipeVendas")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_EQUIPE_VENDAS</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>


                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">
                                <div class="col-sm-1">

                                    <div class="form-group">
                                        <label for="iCodigo">@RsCadastros.CODIGO:</label>
                                        @Html.TextBoxFor(model => model.Id, new { @class = "form-control", @id = "iCodigo", @autocomplete = "off", @Maxlength = 100, @readonly = "readonly" })
                                    </div>

                                </div>
                                <div class="col-sm-9">

                                    <div class="form-group">
                                        <label for="iDescricao">@RsCadastros.NOME:<span class="text-danger">*</span></label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off", @Maxlength = 100 })
                                    </div>

                                </div>
                                <div class="col-sm-2">

                                    <div class="form-group">
                                        <label class="mr-3">@RsCadastros.STATUS:</label><br>
                                        @Html.CheckBoxFor(model => model.Status, new { @class = "form-control", @id = "iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                </div>

                <div class="row" style="padding-top:20px;">
                    <div class="col-sm-6">
                        <div class="card div-card-accord">
                            <div class="card-header title-card" id="heading_6">
                                <h5 class="mb-1">
                                    <a role="button">
                                        <span class="text-bold-card">Selecione os Supervisores Vinculados a Equipe de Venda</span>
                                    </a>
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label for="iNatureza">@RsCadastros.SUPERVISOR:</label>
                                    <select class="form-control obrigatorioSupervisor " id="iSupervisor">
                                        <option value="">@RsBase.SELECIONE</option>
                                    </select>
                                </div>
                                <div class="text-right mt-3">
                                    <input type="button" id="btnAdicionarSupervisor" class="btn btn-success" value="Adicionar" />
                                </div>
                            </div>


                        </div>

                    </div>
                    <div class="col-sm-6">
                        <div class="card div-card-accord">
                            <div class="card-header title-card" id="heading_6">
                                <h5 class="mb-1">
                                    <a role="button">
                                        <span class="text-bold-card">Supervisores Adicionados</span>
                                    </a>
                                </h5>
                            </div>
                            <div class="card-body">
                                <table class="table table-hover nowrap" id="datatableSupervisor" style="width:100%"></table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
           
        </div>
    </div>
        <!--Button Float-->
        <a href="@Url.Action("Index", "EquipeVendas")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return validaSubmit();" name="gravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>
      
}