@model Aniel.Connect.Models.CircuitoTelefoniaCadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{

    ViewBag.Title = RsCadastros.CADASTRO_CIRCUITO_TELEFONIA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
    {
    <style>
        .popover-body {
            background-color: #357CA5;
            color: white;
        }
    </style>
}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>

        var handleDataTableButtons = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.DidVinculados));

            var nome_lista = "DidVinculados";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            return '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                    },
                    {
                        data: "Did",
                        title: "DID"
                    },
                    {
                        data: "Mensalidade",
                        title: "Mensalidade"
                    },
                    {
                        data: "SigaMe",
                        title: "SigaMe Ativado"
                    },
                    {
                        data: "BlackList",
                        title: "BlackList Ativado"
                    },
                    {
                        data: "ChamadaCobrar",
                        title: "Chamada a Cobrar Ativado"
                    }
                ]
            });



        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

        AddSelect("iRota", "@CONSTANTES.URLPortal/api/RotaTelefoniaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdRota", "@RsBase.SELECIONE", false);
        $('input[type=radio][name=TipoDiscagem]').change(function () {
            if (this.value == 'Dinamico' && this.checked) {
                $('#iColunaRota').show();
            }
            else {
                $('#iColunaRota').hide();
            }
        });

    async function requisicao_SenhaAutomatica() {
        var word = "";
        let url = `@CONSTANTES.URLPortal/api/CircuitoTelefoniaApi/Generate_PasswordsCircuito`;
            await $.getJSON({ url: url }).done(function (data) {
                word = data.objeto;
            });

        return word;

    }

    async function Gerar_Senha() {
        var texto = await requisicao_SenhaAutomatica();
            $("#iSenha").val(texto);

        }

        $(document).ready(function () {
    @if (AcessoHelper.TemAcesso(_areas, "215") && !AcessoHelper.TemAcesso(_areas, "216"))
    {<text>
            $('input').attr('readonly', true)
            $('.btn').addClass('readonly')
     </text>
    }


            $('input[type=radio][name=TipoDiscagem]').trigger('change');
        });

        function acessoNegado()
        {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NAO_POSSUI_AREA_ACESSO", "warning");
        }

        let clicked = false
        let erro = false
        function validaSubmit() {

            if (clicked) {
                return false
            }

            clicked = true
            erro = false



            if (erro) {
                clicked = false;
                return;
            }

            $('#form').submit();

        }

        document.getElementById("form").readOnly
</script>
}

@using (Html.BeginForm("Cadastro", "CircuitoTelefonia", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{


    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    <div style="padding:10px">
        <div class="card " style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="icofont-recycle-alt"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GESTAO_CONEXOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "CircuitoTelefonia")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_CIRCUITO_TELEFONIA</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>



                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="row container mt-3">
                                <span class="container text-bold-card">Configurações Básicas</span>
                            </div>
                            <div class="row mt-3">
                                <div class="col-sm-3">
                                    <label for="iCliente">@RsCadastros.CLIENTE:</label>
                                    <div class="form-group">
                                        @Html.DisplayFor(model => model.Cliente, new { @class = "form-control", @id = "iCliente", @autocomplete = "off", @Maxlength = 100 })
                                    </div>
                                </div>

                                <div class="col-sm-4 mr-auto">
                                    <label for="iPlanoProduto">@RsCadastros.PLANO:</label>
                                    <div class="form-group">
                                        @Html.DisplayFor(model => model.PlanoProduto, new { @class = "form-control", @id = "iPlanoProduto", @autocomplete = "off", @Maxlength = 100 })
                                        @Html.HiddenFor(model => model.IdPlanoProduto)
                                    </div>
                                </div>

                                @*<div class="col-sm-2">
                                        @if (Model.Id != 0)
                                        {
                                            <div class="form-group">
                                                <label class="mr-3">@RsFinanceiro.STATUS:</label><br>
                                                @Html.CheckBoxFor(model => model.Status, new { @class = "form-control", @id = "iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                            </div>
                                        }
                                    </div>*@

                            </div>

                            <div class="row">

                                <div class="col-sm-2">
                                    <label for="iNumero_Sip">Número SIP:</label>
                                    <div class="form-group">
                                        @Html.TextBoxFor(model => model.Numero_Sip, new { @class = "form-control", @id = "iNumero_Sip", @disabled = "disabled", @autocomplete = "off", @Maxlength = 100 })

                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label for="iSenha">@RsCadastros.SENHA:</label>
                                        @Html.TextBoxFor(model => model.Senha, new { @class = "form-control", @id = "iSenha", @autocomplete = "off", @Maxlength = 20 })
                                    </div>

                                </div>

                                <div class="col-sm-4 mt-3">
                                    <div class="form-group">
                                        <button type="button" class="btn btn-success" onclick=" Gerar_Senha();">
                                            <span>@RsCadastros.GERAR_SENHA_AUTO</span>
                                        </button>
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iRota">Tipo de Discagem:</label>
                                        <br />
                                        @Html.RadioButtonFor(m => m.TipoDiscagem, Aniel.Connect.Model.enumerado.TipoDiscagem.SCM) <label class="pr-2">@RsCadastros.SCM</label>
                                        @Html.RadioButtonFor(m => m.TipoDiscagem, Aniel.Connect.Model.enumerado.TipoDiscagem.STFC) <label class="pr-2">@RsCadastros.STFC</label>
                                        @Html.RadioButtonFor(m => m.TipoDiscagem, Aniel.Connect.Model.enumerado.TipoDiscagem.Dinamico) <label class="pr-2">@RsCadastros.ROTA_PERSONALIZADA</label>
                                    </div>
                                </div>
                                <div class="col-sm-2" id="iColunaRota" style="display:none">
                                    <div class="form-group">
                                        <label for="iSenha">Rota:</label>
                                        @Html.DropDownListFor(model => model.IdRota, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iRota", @autocomplete = "off" })
                                    </div>
                                </div>
                            </div>


                            <div class="row container mt-3">
                                <span class="container text-bold-card">Configurações Técnicas</span>
                            </div>

                            <div class="row mt-3">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iHabilitarLdn" class="mr-3">@RsCadastros.LDN.Insert(0, "Habilitar "):</label>
                                        <i class="fas fa-info-circle" style="color: #2092EC" data-placement="top" data-toggle="popover"
                                           data-content="Ligação Longa Distância
                                                                     Nacional = Ao Habilitar, acabando a franquia ou caso o plano não tenha
                                                                     franquia, será cobrado o valor cadastrado">
                                        </i>
                                        <br>
                                        @Html.CheckBoxFor(model => model.HabilitarLdn, new { @class = "form-control", @id = "iHabilitarLdn", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iHabilitarLc" class="mr-3">@RsCadastros.LC.Insert(0, "Habilitar "):</label>
                                        <i class="fas fa-info-circle" style="color: #2092EC" data-placement="top" data-toggle="popover"
                                           data-content="Ligação Local =
                                                                      Ao Habilitar, acabando a franquia ou caso o plano não tenha franquia, será
                                                                      cobrado o valor cadastrado">
                                        </i>
                                        <br>
                                        @Html.CheckBoxFor(model => model.HabilitarLc, new { @class = "form-control", @id = "iHabilitarLc", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iHabilitarVc1" class="mr-3">@RsCadastros.VC1.Insert(0, "Habilitar "):</label>
                                        <i class="fas fa-info-circle" style="color: #2092EC" data-placement="top" data-toggle="popover"
                                           data-content="Ligação de fixo para móvel
                                                                     local (dentro do mesmo Código Nacional Ex.: 21 = Rio de janeiro) = Ao Habilitar,
                                                                     acabando a franquia ou caso o plano não tenha franquia, será cobrado o valor
                                                                     cadastrado">
                                        </i>
                                        <br>
                                        @Html.CheckBoxFor(model => model.HabilitarVc1, new { @class = "form-control", @id = "iHabilitarVc1", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iHabilitarVc1" class="mr-3">@RsCadastros.VC2.Insert(0, "Habilitar "):</label>
                                        <i class="fas fa-info-circle" style="color: #2092EC" data-placement="top" data-toggle="popover"
                                           data-content="Ligação de fixo para móvel
                                                                     interurbano, porém com CN de origem e destino com o primeiro dígito iguais.
                                                                     Ex: Ligação do Código Nacional 11 para Código Nacional 16 = Ao Habilitar,
                                                                     acabando a franquia ou caso o plano não tenha franquia, será cobrado o valor
                                                                     cadastrado">
                                        </i>
                                        <br>
                                        @Html.CheckBoxFor(model => model.HabilitarVc2, new { @class = "form-control", @id = "iHabilitarVc2", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iHabilitarVc1" class="mr-3">@RsCadastros.VC3.Insert(0, "Habilitar "):</label>
                                        <i class="fas fa-info-circle" style="color: #2092EC" data-placement="top" data-toggle="popover"
                                           data-content="Ligação de fixo para móvel
                                                                     interurbano, que não se enquadra como VC2 = Ao Habilitar, acabando a
                                                                     franquia ou caso o plano não tenha franquia, será cobrado o valor cadastrado">
                                        </i>
                                        <br>
                                        @Html.CheckBoxFor(model => model.HabilitarVc3, new { @class = "form-control", @id = "iHabilitarVc3", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iBloqueioChamadaCobrar" class="mr-3">Ativar Bloqueio de Chamada a Cobrar:</label>
                                        <i class="fas fa-info-circle" style="color: #2092EC" data-placement="top" data-toggle="popover"
                                           data-content="Cobrar por Circuito - Só um DID será cobrado e os demais
                                                                   serão zerados Ex.: DID1 = R$ 19,90 + DID2 = R$ 0,00 = TOTAL = R$ 19,90
                                                                   Cobrar por DID - O valor será cobrado para cada DID Ex.: DID1 = R$ 19,90
                                                                   + DID2 = R$ 19,90 = TOTAL = R$ 49,80">
                                        </i>
                                        <br>
                                        @Html.CheckBoxFor(model => model.BloqueioChamadaCobrar, new { @class = "form-control", @id = "iBloqueioChamadaCobrar", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iHabilitarBina" class="mr-3">Habilitar Bina:</label>
                                        <i class="fas fa-info-circle" style="color: #2092EC" data-placement="top" data-toggle="popover"
                                           data-content="Cobrar por Circuito - Só um DID será cobrado e os demais
                                                                   serão zerados Ex.: DID1 = R$ 19,90 + DID2 = R$ 0,00 = TOTAL = R$ 19,90
                                                                   Cobrar por DID - O valor será cobrado para cada DID Ex.: DID1 = R$ 19,90
                                                                   + DID2 = R$ 19,90 = TOTAL = R$ 49,80">
                                        </i>
                                        <br>
                                        @Html.CheckBoxFor(model => model.HabilitarBina, new { @class = "form-control", @id = "iHabilitarBina", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>

                                </div>

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iQtdLigacaoesSimultaneas" class="mr-3">@RsCadastros.QUANTIDADE_LIGACOES_SIMULTANEAS:</label>
                                        @Html.TextBoxFor(model => model.QtdLigacaoesSimultaneas, new { @class = "form-control", @id = "iQtdLigacaoesSimultaneas", @autocomplete = "off", @type = "number", @min = 0 })
                                    </div>

                                </div>
                            </div>

                            <div class="row mt-3">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iBloqueioChamadaCobrar" class="mr-3">Habilitar Consumo Minimo:</label>
                                        <i class="fas fa-info-circle" style="color: #2092EC" data-placement="top" data-toggle="popover"
                                           data-content="Cobrar por Circuito - Só um DID será cobrado e os demais
                                                                   serão zerados Ex.: DID1 = R$ 19,90 + DID2 = R$ 0,00 = TOTAL = R$ 19,90
                                                                   Cobrar por DID - O valor será cobrado para cada DID Ex.: DID1 = R$ 19,90
                                                                   + DID2 = R$ 19,90 = TOTAL = R$ 49,80">
                                        </i>
                                        <br>
                                        @Html.CheckBoxFor(model => model.BloqueioChamadaCobrar, new { @class = "form-control", @id = "iBloqueioChamadaCobrar", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>


                <div class="card div-card-accord mt-3">
                    <div class="card-header title-card" id="heading_5">
                        <h5 class="mb-1">
                            <a role="button">
                                <span class="text-bold-card"> Editar ou Excluir DIDS Vinculados</span>
                            </a>
                        </h5>
                    </div>
                    <div class="card-body">

                        <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>

                    </div>


                </div>


            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "CircuitoTelefonia")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>
        @if (AcessoHelper.TemAcesso(_areas, "215") && !AcessoHelper.TemAcesso(_areas, "216"))
        {
            <a href="#" class="float-save" onclick="return acessoNegado()" name="gravar">
                <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                    <i class="fas fa-save fa-2x"></i>
                </div>
            </a>
        }
        else
        {

            <a href="#" class="float-save validaSubmit" onclick="return validaSubmit();" name="gravar">
                <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                    <i class="fas fa-save fa-2x"></i>
                </div>
            </a>
        }
    </div>
}