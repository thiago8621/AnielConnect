@model Aniel.Connect.Models.BotEvento_CadastroModel
@using Aniel.Connect.Models
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Microsoft.AspNet.Identity
@using Aniel.Connect.Models.T5

@{
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    ViewBag.Title = RsCadastros.CADASTRO_EVENTO;
    List<AreaModuloModel> _areas = ViewBag.Areas;
    List<Aniel.Connect.Core.ObjComboResult<String>> listaOrdenada = new List<Aniel.Connect.Core.ObjComboResult<String>>();

    foreach (var valor in Enum.GetValues(typeof(Tipo_Bot_Evento_Acoes)))
    {
        string descricao = HtmlEnumExtensions.GetEnumDescription(valor);
        listaOrdenada.Add(new Aniel.Connect.Core.ObjComboResult<string>
        {
            Id = Convert.ToInt32(valor).ToString(),
            Text = descricao
        });
    }

    listaOrdenada = listaOrdenada.OrderBy(x => x.Text).ToList();


    List<Aniel.Connect.Core.ObjComboResult<String>> listaOrdenadaArmazenamento = new List<Aniel.Connect.Core.ObjComboResult<String>>();
    foreach (var valorCampo in Enum.GetValues(typeof(EventoArmazenamento)))
    {
        string descricao = HtmlEnumExtensions.GetEnumDescription(valorCampo);
        listaOrdenadaArmazenamento.Add(new Aniel.Connect.Core.ObjComboResult<string>
        {
            Id = Convert.ToInt32(valorCampo).ToString(),
            Text = descricao
        });
    }

    listaOrdenadaArmazenamento = listaOrdenadaArmazenamento.OrderBy(x => x.Text).ToList();
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")

    <style>
        .swal2-popup .swal2-actions {
            z-index: 0 !important;
        }
    </style>

}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    @if (@Model.Id == 0)
    {
        <text>
            <script>
                $("#iStatusEvento").prop("checked", true).change();;
            </script>
        </text>
    }

    <script>
    let carregamento = true;
        let arrayCamposConsultados = [20, 21, 5, 7, 11, 10, 18];
    var idAtual = "@Model.Id";
    let configCombo = [];

    configCombo.push({ Key: "IDIGNORAR", Value: "@Model.Id" });

    $(document).ready(async () => {


        $("#iStatusDisparoAutomatico").trigger("change");
        $("#iAtivarAcao").trigger("change");
        $("#iAcaoExecutada").trigger("change");

    });

    $("#iStatusDisparoAutomatico").on("change", function () {
        if ($(this).is(':checked')) {

            $("#divEventoDisparo").show();
            //recuperar id do evento
            var idEventoAuto = "@Model.AutoProximoEvento";
            AddSelect('iEventoDisparo', "@CONSTANTES.URLPortal/api/eventoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, @Request.Params["IdBot"], idEventoAuto, "@RsBase.SELECIONE", false, null, null, null, configCombo);
        } else {
            $("#divEventoDisparo").hide();
            AddSelect('iEventoDisparo', "@CONSTANTES.URLPortal/api/eventoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, @Request.Params["IdBot"], idEventoAuto, "@RsBase.SELECIONE", false, null, null, null, configCombo);
        }
    });

    $("#iAcaoExecutada").on("change", function () {

        var acaoSelecionada = Number($("#iAcaoExecutada").val());

        var possuiValores = arrayCamposConsultados.find(id => id === acaoSelecionada);

        if (possuiValores !== undefined) {
            $("#divArmazenamento").show();
        }
        else {
            $("#divArmazenamento").hide();
        }

    });

    $("#iAtivarAcao").on("change", function () {
        if ($(this).is(':checked')) {
            $("#divAcaoConsultada").show();
            $("#divCondicaoEvento").show();
            $("#divAcaoExecutada").show();
            $("#divSetorAtendimento").show();
            $(document).ready(async () => {
                $("#iCondicaoEvento").trigger("change");
            });
            $(document).ready(async () => {
                $("#iAcaoExecutada").trigger("change");
            });
        } else {
            $("#divArmazenamento").hide();
            $("#divAcaoConsultada").hide();
            $("#divCondicaoEvento").hide();
            $("#divPesquisa").hide();
            $("#divAcaoVerdadeiro").hide();
            $("#divAcaoFalso").hide();
            $("#divAcaoExecutada").hide();
            $("#divSetorAtendimento").hide();
            AddSelect('iEventoDisparo', "@CONSTANTES.URLPortal/api/eventoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, @Request.Params["IdBot"], null, "@RsBase.SELECIONE", false, null, null, null, configCombo);
        }
    });

    $("#iAcaoExecutada").on("change", function () {
        //Se ação for pequisa de satisfação
        if ($('#iAcaoExecutada').val() == 8) {
            $("#divPesquisa").show();
            $("#divArmazenamento").hide();
            $("#divSetorAtendimento").hide();
            var idPesquisa = "@Model.PesquisaSatisfacao";
            AddSelect("iPesquisa", "@CONSTANTES.URLPortal/api/Pesquisa_SatisfacaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, idPesquisa, "@RsBase.SELECIONE", false);
        }
        //se ação for transferir atendimento ou cacenlar plano
        else if (($('#iAcaoExecutada').val() == 17) || ($('#iAcaoExecutada').val() == 4)) {
            $("#divSetorAtendimento").show();
            $("#divArmazenamento").hide();
            $("ModeldivPesquisa").hide();
            var idSetorAtendimento = "@Model.SetorAtendimento";
            AddSelect("iSetorAtendimento", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, idSetorAtendimento, "@RsBase.SELECIONE", false);
        }
        else {
            $("#divPesquisa").hide();
            $("#divSetorAtendimento").hide();
            AddSelect("iPesquisa", "@CONSTANTES.URLPortal/api/Pesquisa_SatisfacaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iSetorAtendimento", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }
    });
    $("#iCondicaoEvento").on("change", function () {
        if ($(this).is(':checked')) {

            $("#divAcaoVerdadeiro").show();
            $("#divAcaoFalso").show();

            var idEventoVerdadeiro = "@Model.EventoVerdadeiro";
            var idEventoFalso = "@Model.EventoFalso";


                AddSelect('iEventoVerdadeiro', "@CONSTANTES.URLPortal/api/eventoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, @Request.Params["IdBot"], idEventoVerdadeiro, "@RsBase.SELECIONE", false, null, null, null, configCombo);
                AddSelect('iEventoFalso', "@CONSTANTES.URLPortal/api/eventoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, @Request.Params["IdBot"], idEventoFalso, "@RsBase.SELECIONE", false, null, null, null, configCombo);


        } else {
            $("#divAcaoVerdadeiro").hide();
            $("#divAcaoFalso").hide();
        }
    });

    $("#iEvento").on("change", function () {
        for (let item of $(".ProximoEvento")) {
            var id = $(item).attr("id");
            var valor = $(item).attr(`value`);
            AddSelect(id, "@CONSTANTES.URLPortal/api/eventoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, @Request.Params["IdBot"], valor, "@RsBase.SELECIONE", false);
        }
    });


    let oDatatable = null; // variavel de manipulacao da tabela de anexos
    let oDatatableRespostas = null;// variavel de manipulacao da tabela de respostas

            //adicao de novo linha para anexo
    function addAnexo(nome, extensao, tipo) {
        oDatatable.row.add({
            Tipo: tipo,
            Nome: nome,
            Extensao: extensao
        }).draw(false);
    }

            //adicao de novo linha para resposta
    function addResposta() {
        oDatatableRespostas.row.add({
            IdProximoEvento: "",
            Descricao: ""
        }).draw(false);

/*        $("#iEvento").trigger("change");*/
    }


    function handleExcluirAnexo() {
        $(".btnExcluirAnexo").unbind('click');
        $(".btnExcluirAnexo").click(function (e) {
            e.preventDefault();

            var idAnexo = $(this).attr("id_anexo");

            var trLinkButton = $(this).parents('tr');

            if (idAnexo === "undefined") {
                oDatatable.row(trLinkButton).remove().draw(false);
                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
            }
            else {

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/EventoApi/ExcluirAnexo?value=")' + idAnexo;

                $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',

                })
                    .done(function (data) {

                        if (data.ok) {
                            oDatatable.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    })
                    .fail(function () {

                    })
                    .always(function () {

                    });
            }

        });
    }

    //início
    var rows_selected = [];

    var handleDataTableButtons = function () {
        "use strict";

        //"Blfrtip"
        let arrayAnexos = @Html.Raw(Json.Encode(Model.Anexos));
        let nomeListaAnexos = "Anexos";
        let link = '@String.Concat(CONSTANTES.URLPortal, "/Arquivos/BotEvento/")';
        oDatatable = $("#datatable").length && $("#datatable").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: arrayAnexos,
            paging: false,
            order: [],
            scrollX: true,
            drawCallback: function () {
                handleExcluirAnexo();
            },

            columns: [
                {
                    data: "Excluir", title: "",
                    render: function (data, type, row, meta) {
                        return '<a class="btnExcluirAnexo" href="#" id_anexo="' + row.Id + '" id="btnExcluir"><i class="fas fa-trash-alt" style="font-size:16px;padding-right:2px;"></i></a>' +
                            `
            <input type="hidden" name="${nomeListaAnexos}[${meta.row}].Id">`;
                    }
                },
                {
                    data: "Tipo", title: "@RsCadastros.TIPO",
                    render: function (data, type, row, meta) {
                        return data + `
            <input type="hidden" name="${nomeListaAnexos}[${meta.row}].Tipo">`;
                    }
                },
                {
                    data: "Nome", title: "@RsCadastros.NOME",
                    render: function (data, type, row, meta) {
                        return data + `
            <input type="hidden" name="${nomeListaAnexos}[${meta.row}].Nome">`;
                    }
                },
                {
                    data: "Extensao", title: "@RsCadastros.EXTENSAO",
                    render: function (data, type, row, meta) {
                        if (row.Tipo == 'Url') {
                            return row.Tipo + `
            <input type="hidden" name="${nomeListaAnexos}[${meta.row}].Extensao">`;
                        } else {
                            return data + `
            <input type="hidden" name="${nomeListaAnexos}[${meta.row}].Extensao">`;
                        }
                    }
                },
                {
                    data: "Exibir", title: "@RsCadastros.EXIBIR",
                    render: function (data, type, row, meta) {
                        if (row.Tipo == 'Url') {
                            return '<a href="' + row.Nome + '" target="_blank"><i class="fas fa-search" style="font-size:16px;padding-right:2px;"></i></a>';

                        } else {
                            return '<a href="' + link + row.Id + row.Extensao + '" target="_blank"><i class="fas fa-search" style="font-size:16px;padding-right:2px;"></i></a>';
                        }

                    }
                },
                {
                    data: "Baixar", title: "@RsCadastros.BAIXAR",
                    render: function (data, type, row, meta) {
                        if (row.Tipo == 'Url') {
                            return '';
                        } else {
                            return '<a href="' + link + row.Id + row.Extensao + '" download id="download"><i class="fas fa-download" style="font-size:16px;padding-right:2px;"></i></a>';
                        }

                    }
                },
            ]

        });

    },
    TableManageButtons = function () {
                    "use strict";
                    return {
                        init: function () {
                            handleDataTableButtons();
                        }
                    }
                }();

            TableManageButtons.init();
            handleExcluirAnexo();


    var handleDataTableButtonsRespostas = function () {
        "use strict";

        //"Blfrtip"
        let arrayRespostas = @Html.Raw(Json.Encode(Model.Respostas));
        let nomeLista = "Respostas";
        oDatatableRespostas = $("#datatableRespostas").length && $("#datatableRespostas").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: arrayRespostas,
            destroy: true,
            drawCallback: function () {
                handleExcluirResposta();
                for (let item of $(".ProximoEvento")) {

                    var id = $(item).attr("id");
                    var valor = $(item).attr("value");
                    var texto = $(item).val();

                    const shouldLoadData = !carregamento && texto === 'Selecione' && valor === '';
                    if (shouldLoadData || valor !== '') {
                        const selectedValue = shouldLoadData ? null : valor;
                        AddSelect(id, "@CONSTANTES.URLPortal/api/eventoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, @Request.Params["IdBot"], selectedValue, "@RsBase.SELECIONE", false);
                    }
                }

                carregamento = false;

            },

            columns: [
                {
                    data: "Id", title: "",
                    render: function (data, type, row, meta) {
                        return '<a class="btnExcluirResposta" href="#" id_resposta="' + row.Id + '" id="btnExcluirResposta"><i class="fas fa-trash-alt" style="font-size:16px;padding-right:2px;"></i></a>' +
                            `
            <input type="hidden" value="${data}" name="${nomeLista}[${meta.row}].Id">`;
                    }
                },
                {
                    data: "Descricao",
                    title: `@RsCadastros.RESPOSTA_EVENTO <i class="fas fa-info-circle fa-1x" title="@RsCadastros.INFO_RESPOSTAS"></i>`,
                    render: function (data, type, row, meta) {
                        return `
            <input type="text" name="${nomeLista}[${meta.row}].Descricao" class="form-control obrigatorio" value="${data}">`;
                    }
                },
                {
                    data: "IdProximoEvento",
                    title: `@RsCadastros.PROXIMO_EVENTO <i class="fas fa-info-circle fa-1x" title="@RsCadastros.INFO_EV_RESPOSTAS"></i>`,
                    render: function (data, type, row, meta) {
                        return `<select id="iProximoEvento${meta.row}" name="${nomeLista}[${meta.row}].IdProximoEvento" class="form-control ProximoEvento obrigatorio" value="${TrataNulo(data)}"><option>Selecione</option></select>`;
                    }
                },
                {
                    data: "Adicionar", title: "",
                    render: function (data, type, row, meta) {
                        return '<a class="btnaddResposta" href="#!" id_anexo="' + row.Id + '" id="btnExcluir" onclick="addResposta()"><i class="fas fa-plus-square" style="font-size:16px;padding-right:2px;"></i></a>';
                    }
                },

            ]

        });

    },
                TableManageButtonsRespostas = function () {
                    "use strict";
                    return {
                        init: function () {
                            handleDataTableButtonsRespostas();
                        }
                    }
                }();

            TableManageButtonsRespostas.init();
            handleExcluirResposta(); //substituir linha por metodo de excluir resposta

    function handleExcluirResposta() {
        $(".btnExcluirResposta").unbind('click');
        $(".btnExcluirResposta").click(function (e) {
            e.preventDefault();

            var idResposta = $(this).attr("id_resposta");

            var trLinkButton = $(this).parents('tr');

            if (idResposta === "undefined") {
                oDatatableRespostas.row(trLinkButton).remove().draw(false);
                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
            }
            else {

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/EventoApi/ExcluirResposta?value=")' + idResposta;

                $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',

                })
                    .done(function (data) {

                        if (data.ok) {
                            oDatatableRespostas.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    })
                    .fail(function () {

                    })
                    .always(function () {

                    });
