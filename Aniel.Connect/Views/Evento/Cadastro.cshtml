        });
    }


            //datatable

            var clicked = false;
    function ValidaSubmit() {
        if (clicked) {
            return false;
        }

        clicked = true;

        var erro = false;

        if ($("#iStatusDisparoAutomatico").is(":checked") == true) {
            if (!$("#iEventoDisparo").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.BOT_EVENTO_AUTOMATICO)", "warning");
            erro = true;
          }
        }
        if ($("#iCondicaoEvento").is(":checked") == true) {
            if (!$("#iEventoVerdadeiro").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.RESULTADO_VERDADEIRO_EVENTO)", "warning");
               erro = true;
            }
            if (!$("#iEventoFalso").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.RESULTADO_FALSO_EVENTO)", "warning");
               erro = true;
            }

        }

        if ($('#iDescricao').val() == "") {
            Notificar("@RsBase.ATENCAO_", "Informe a Descrição do Evento!", "warning");
            erro = true;
        }


        if (ValidaCamposObrigatorios(false)) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
            erro = true;
        }

        if (erro) {
            clicked = false;
            return false;
        }
        ShowPageLoading();
        $('#form').submit();
    }


    function adicionarEvento() {

        var tabela = document.body.querySelector(".tabelaEvento tbody");
        var clone = document.body.querySelectorAll(".tabelaEvento tr")[1].cloneNode(true);
        var els = clone.querySelectorAll("input");

        for (let iterator = 0; x < els.length; iterator++) {
            els[iterator].value = '';
        }

        tabela.appendChild(clone);
    }

            let arrayUrl = [];
    function AdicionaUrl() {
        var nomeListaAnexos = 'FilesAnexoUrl';
        var url = $("#iAnexoUrlLink").val();

        try {
            Testeurl = new URL(url);
        } catch (_) {
            Notificar("@RsBase.ATENCAO_", "Adicione uma URL válida!", "warning");
        }

        if (Testeurl.protocol === "http:" || Testeurl.protocol === "https:") {

            addAnexo(url, '', 'Url');
            arrayUrl.push(url);
            $('#modalAnexosLink').modal('hide');
        } else {
            Notificar("@RsBase.ATENCAO_", "Adicione uma URL válida!", "warning");
        }

    }

    function SelecionaArquivo(id, tipoArquivo) {


        var files = $('#' + id)[0].files;
        var fileList = files;

        var numFiles = files.length;
        var erro = false;
        var tamanhoSuportado = 5;

        if (tipoArquivo == 'Imagem') {
            for (var i = 0; i < numFiles; i++) {
                var tamanhoFiles = files[i].size / 1024 / 1024; // in MB
                if (tamanhoFiles > tamanhoSuportado) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.BOT_ANEXO_IMAGEM)", "warning");
                    erro = true;
                    $(".anexarArquivo").val('');
                } else {
                    var nomeFiles = files[i].name;
                    var extensaoArquivo = '.' + nomeFiles.substring(nomeFiles.lastIndexOf('.') + 1);
                    var extensoesPermitidas = /(.jpeg|.jpg|.gif|.png|.bmp|.tiff)$/i;
                    if (!extensoesPermitidas.exec(nomeFiles)) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.BOT_ANEXO_IMAGEM)", "warning");
                        erro = true;
                        $(".anexarArquivo").val('');
                    } else {
                        for (var i = 0; i < numFiles; i++) {
                            addAnexo(nomeFiles, extensaoArquivo, tipoArquivo);
                            $('#modalAnexosImagem').modal('hide');
                        }
                    }
                }
            }
        }


        if (tipoArquivo == 'Vídeo') {
            for (var i = 0; i < numFiles; i++) {
                var tamanhoFiles = files[i].size / 1024 / 1024; // in MB
                if (tamanhoFiles > tamanhoSuportado) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.BOT_TAMANHO_ARQUIVO)", "warning");
                    erro = true;
                    $(".anexarArquivo").val('');
                } else {
                    var nomeFiles = files[i].name;
                    var extensaoArquivo = '.' + nomeFiles.substring(nomeFiles.lastIndexOf('.') + 1);
                    var extensoesPermitidas = /(.mpeg|.mp4|.quicktime|.webm|.3gpp|.3gpp2|.3gpp-tt|.H261|.H263-1998|.H263-2000|.H264)$/i;
                    if (!extensoesPermitidas.exec(nomeFiles)) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.BOT_ANEXO_VIDEO)", "warning");
                        erro = true;
                        $(".anexarArquivo").val('');
                    } else {
                        for (var i = 0; i < numFiles; i++) {
                            addAnexo(nomeFiles, extensaoArquivo, tipoArquivo);
                            $('#modalAnexosVideo').modal('hide');
                        }
                    }
                }
            }
        }


        if (tipoArquivo == 'Áudio') {

            for (var i = 0; i < numFiles; i++) {
                var tamanhoFiles = files[i].size / 1024 / 1024; // in MB
                if (tamanhoFiles > tamanhoSuportado) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.BOT_TAMANHO_ARQUIVO)", "warning");
                    erro = true;
                    $(".anexarArquivo").val('');
                } else {
                    var nomeFiles = files[i].name;
                    var extensaoArquivo = '.' + nomeFiles.substring(nomeFiles.lastIndexOf('.') + 1);
                    var extensoesPermitidas = /(.L24|.mp4|.mpeg|.ogg|.vnd.rn-realaudio|.vnd.wave|.3gpp|.3gpp2|.ac3|.webm|.amr-nb|.amr|.snd|.au)$/i;
                    if (!extensoesPermitidas.exec(nomeFiles)) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.BOT_ANEXO_AUDIO)", "warning");
                        erro = true;
                        $(".anexarArquivo").val('');
                    } else {
                        for (var i = 0; i < numFiles; i++) {
                            addAnexo(nomeFiles, extensaoArquivo, tipoArquivo);
                            $('#modalAnexosAudio').modal('hide');
                        }
                    }
                }
            }
        }

        if (tipoArquivo == 'Arquivo') {
            for (var i = 0; i < numFiles; i++) {
                var tamanhoFiles = files[i].size / 1024 / 1024; // in MB
                if (tamanhoFiles > tamanhoSuportado) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.BOT_TAMANHO_ARQUIVO)", "warning");
                    erro = true;
                    $(".anexarArquivo").val('');
                } else {
                    var nomeFiles = files[i].name;
                    var extensaoArquivo = '.' + nomeFiles.substring(nomeFiles.lastIndexOf('.') + 1);
                    var extensoesPermitidas = /(.vcard|.pdf|.directory|.calendar|.richtext|.rtf|.x-vcard)$/i;
                    if (!extensoesPermitidas.exec(nomeFiles)) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.BOT_ANEXO_ARQUIVO)", "warning");
                        erro = true;
                        $(".anexarArquivo").val('');
                    } else {
                        for (var i = 0; i < numFiles; i++) {
                            addAnexo(nomeFiles, extensaoArquivo, tipoArquivo);
                            $('#modalAnexosArquivo').modal('hide');
                        }
                    }
                }
            }
        }

        if (erro) {
            clicked = false;
            return false;
        }

        //ShowPageLoading();
        //$('#form').submit();
    }

    </script>
}


