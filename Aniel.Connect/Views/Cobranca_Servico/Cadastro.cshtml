@model Aniel.Connect.Models.Cobranca_ServicoCadastroModel

@{
    ViewBag.Title = RsCadastros.CONFIGURACAO_COBRANCA_SERVICO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" media="none" onload="if(media!='all')media='all'" rel="stylesheet" />
    <style>
        /*div#divPerfil {
            height: 180px !important;
        }*/
    </style>
}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
<script>
    $('a[data-toggle="tab"]').on('shown.bs.tab', () => {
        $("#datatableTipoServico").DataTable().columns.adjust();
        $("#datatablePlanoProduto").DataTable().columns.adjust();
    })
   let oDatatablePlanoProduto = null;
    const handlePlanoProduto = function () {

        $('#iPlano_Produto').on('select2:select select2:unselecting', function (e) {
            PlanoProdutoSelecionado = e.params.data;

            //if (PlanoProdutoSelecionado) {
            //    alert("valor:" + PlanoProdutoSelecionado.valorPlanoProduto)

            //}
        });
    };

        let TipoSegmentoSelecionado = "";
        const handleSegmentoServico = function () {
            $('#iSegmento').on('select2:select select2:unselecting', async function (e) {
                TipoSegmentoSelecionado = e.params.data;
                if (TipoSegmentoSelecionado === undefined) {
                    disabledFields();
                } else {
                    await AddSelect("iTipo_Servico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, TipoSegmentoSelecionado.id, null, "@RsBase.SELECIONE", false, handleTipoServico);
                    await AddSelect("iCod_Encerramento", "@CONSTANTES.URLPortal/api/CodigoEncerramentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, TipoSegmentoSelecionado.id, null, "@RsBase.SELECIONE", false, handleCodEncerramento);
                    $("#iEscolhaCobranca").prop("disabled", false);
                    $("#iTodasCod_Encerramento").prop("disabled", false);
                }
            });
        }

        let TipoServicoSelecionado = "";
        const handleTipoServico = function () {
            $('#iTipo_Servico').on('select2:select select2:unselecting',async function (e) {
                TipoServicoSelecionado = e.params.data;

                if (TipoServicoSelecionado === undefined || TipoServicoSelecionado == "") {
                    await AddSelect("iSub_Tipo_Servico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, handleTipoServico);
                } else {
                    await AddSelect("iSub_Tipo_Servico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, TipoServicoSelecionado.id, null, "@RsBase.SELECIONE", false, handleTipoServico);
                    $("#iTodasSubTipoServico").prop("disabled", false);
                }
            });
        }

        let TipoSubTipoSelecionado = "";
        const handleSubTipoServico = function () {
            $('#iSub_Tipo_Servico').on('select2:select select2:unselecting', function (e) {
                TipoSubTipoSelecionado = e.params.data;
            });
        }

        let TipoCodEncerramento = "";
        const handleCodEncerramento = function () {
            $('#iCod_Encerramento').on('select2:select select2:unselecting', function (e) {
                TipoCodEncerramento = e.params.data;
            });
        }


    $(document).ready(async function () {
        await AddSelect("iSegmento", "@CONSTANTES.URLPortal/api/ContratoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, handleSegmentoServico);
        await AddSelect("iPlano_Produto", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, handlePlanoProduto, null, "PLANO_COMERCIALIZAVEL_NAO");
        disabledFields();

        CalcularValorTotal();
    });

    async function disabledFields() {
        await AddSelect("iTipo_Servico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        await AddSelect("iSub_Tipo_Servico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        await AddSelect("iCod_Encerramento", "@CONSTANTES.URLPortal/api/CodigoEncerramentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        $("#iTodasSubTipoServico").prop("disabled", true);
        $("#iTodasSubTipoServico").prop("checked", false);

        $("#iTodasCod_Encerramento").prop("disabled", true);
        $("#iTodasCod_Encerramento").prop("checked", false);

        $("#iEscolhaCobranca").prop("disabled", true);
        $("#iEscolhaCobranca").val("");
    }

    $("#iTodasSubTipoServico").on("change", async function (e) {
        if ($("#iTodasSubTipoServico").is(":checked")) {
            await AddSelect("iSub_Tipo_Servico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        } else {
            await AddSelect("iSub_Tipo_Servico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, $("#iTipo_Servico").val(), null, "@RsBase.SELECIONE", false);
        }
    });

    $("#iTodasCod_Encerramento").on("change", async function (e) {
        if ($("#iTodasCod_Encerramento").is(":checked")) {
            await AddSelect("iCod_Encerramento", "@CONSTANTES.URLPortal/api/CodigoEncerramentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        } else {
            await AddSelect("iCod_Encerramento", "@CONSTANTES.URLPortal/api/CodigoEncerramentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, $("#iSegmento").val(), null, "@RsBase.SELECIONE", false);
        }
    });

    var handleDataTableButtonsTipoServico= function () {
    "use strict";

        var array = @Html.Raw(Json.Encode(Model.TipoServico));
        var nome_lista = "TipoServico";//Nome_utilizado para enganar o razor

        //"Blfrtip"
        var oDatatable = $("#datatableTipoServico").length && $("#datatableTipoServico").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: array,
            scrollX: true,
            scrollCollapse: true,
            paging: false,
            autoPrint: false,
            columns: [
                {
                    data: "Id",
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
                {

                    data: "Segmento_Desc",
                    title: "@RsCadastros.SEGMENTO",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Segmento_Desc" name="' + nome_lista + '[' + meta.row + '].Segmento_Desc" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Segmento" name="' + nome_lista + '[' + meta.row + '].Segmento" type="hidden" value="' + TrataNulo(row.Segmento) + '">';
                        }
                        return data;
                    }

                },
                {
                    data: "Desc_Tipo_Servico",
                    title: "@RsCadastros.TIPO_SERVICO",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Desc_Tipo_Servico" name="' + nome_lista + '[' + meta.row + '].Desc_Tipo_Servico" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Tipo_Servico" name="' + nome_lista + '[' + meta.row + '].Tipo_Servico" type="hidden" value="' + TrataNulo(row.Tipo_Servico) + '">';
                        }
                        return data;
                    }
                },
                {
                    data: "Desc_Sub_Tipo_Servico",
                    title: "@RsCadastros.SUBTIPO_SERVICO",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            var valor = row.TodasSubTipoServico == 1 ? "@RsBase.TODAS" : data;

                            data = valor + ' <input id="' + nome_lista + '_' + meta.row + '__Desc_Sub_Tipo_Servico" name="' + nome_lista + '[' + meta.row + '].Desc_Sub_Tipo_Servico" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Sub_Tipo_Servico" name="' + nome_lista + '[' + meta.row + '].Sub_Tipo_Servico" type="hidden" value="' + TrataNulo(row.Sub_Tipo_Servico) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__TodasSubTipoServico" name="' + nome_lista + '[' + meta.row + '].TodasSubTipoServico" type="hidden" value="' + TrataNulo(row.TodasSubTipoServico) + '">';
                        }
                        return data;
                    },

                },
                {
                    data: "Desc_Cod_Encerramento",
                    title: "@RsCadastros.CODIGO_ENCERRAMENTO",
                    render: function (data, type, row, meta) {
                        var valor = row.TodasCod_Encerramento == 1 ? "@RsBase.TODAS" : data;

                        if (type === 'display') {
                            data = valor + ' <input id="' + nome_lista + '_' + meta.row + '__Desc_Cod_Encerramento" name="' + nome_lista + '[' + meta.row + '].Desc_Cod_Encerramento" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Encerramento" name="' + nome_lista + '[' + meta.row + '].Cod_Encerramento" type="hidden" value="' + TrataNulo(row.Cod_Encerramento) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__TodasCod_Encerramento" name="' + nome_lista + '[' + meta.row + '].TodasCod_Encerramento" type="hidden" value="' + TrataNulo(row.TodasCod_Encerramento) + '">';
                        }
                        return data;
                    }
                },
                {
                    data: "Desc_Forma_Cobranca",
                    title: "@RsCadastros.COBRANCA",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__" name="' + nome_lista + '[' + meta.row + '].Desc_Forma_Cobranca" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Cobranca" name="' + nome_lista + '[' + meta.row + '].Cod_Cobranca" type="hidden" value="' + TrataNulo(row.Cod_Cobranca) + '">';
                        }
                        return data;
                    }
                }
            ]
        });

        function handleExcluir() {
            $(".btnExcluir").unbind('click');
            $(".btnExcluir").click(function (e) {
                e.preventDefault();

                var idArquivo = $(this).attr("excluir");

                var trLinkButton = $(this).parents('tr');

                if (idArquivo === "0") {
                    oDatatable.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
                else {

                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Cobranca_Servicoapi/ExcluirPlanoGrid?value=")' + idArquivo;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',

                    })
                        .done(function (data) {

                            if (data.ok) {
                                oDatatable.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                        .fail(function () {

                        })
                        .always(function () {

                        });
                }

            });
        }

        handleExcluir();

        $("#btnAdicionarTipoServico").unbind('click');
        $("#btnAdicionarTipoServico").on('click', async function () {

           var erro = false;

            if (!$("#iTodasSubTipoServico").is(":checked")) {
                $("#iSub_Tipo_Servico").addClass("obrigatorioTipo_Servico");
            }
            else {
                $("#iSub_Tipo_Servico").removeClass("obrigatorioTipo_Servico");
            }

            if (!$("#iTodasCod_Encerramento").is(":checked")) {
                $("#iCod_Encerramento").addClass("obrigatorioSegmento");
            }
            else {
                $("#iCod_Encerramento").removeClass("obrigatorioSegmento");
            }

            if (ValidaObrigatoriosPorClasse("obrigatorioTipo_Servico",erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            if (ValidaObrigatoriosPorClasse("obrigatorioSegmento",erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            if ($("#iTodasSubTipoServico").is(":checked")) {

                for (var i = 0; i < oDatatable.rows().data().length; i++) {
                    if (oDatatable.rows().data()[i].Sub_Tipo_Servico == $("#iSub_Tipo_Servico").val()) {
                        oDatatable.row(oDatatable.rows().data()[i]).remove().draw(false);
                    }
                }
            }

            if ($("#iTodasCod_Encerramento").is(":checked")) {
                for (var i = 0; i < oDatatable.rows().data().length; i++) {
                    if (oDatatable.rows().data()[i].Cod_Encerramento == $("#iCod_Encerramento").val()) {
                        oDatatable.row(oDatatable.rows().data()[i]).remove().draw(false);
                    }
                }
            }

            for (var i = 0; i < oDatatable.rows().data().length; i++) {

                if (oDatatable.rows().data()[i].Segmento == $("#iSegmento").val() && oDatatable.rows().data()[i].Tipo_Servico == $("#iTipo_Servico").val() &&
                    oDatatable.rows().data()[i].TodasSubTipoServico == true) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.SUBTIPO_SERVICO)", "warning");
                    erro = true;
                    break;
                }
                if (oDatatable.rows().data()[i].Segmento == $("#iSegmento").val() && oDatatable.rows().data()[i].Tipo_Servico == $("#iTipo_Servico").val() &&
                    oDatatable.rows().data()[i].TodasCod_Encerramento == true) {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.CODIGO_ENCERRAMENTO)", "warning");
                    erro = true;
                    break;
                }

                if (oDatatable.rows().data()[i].Segmento == $("#iSegmento").val() && oDatatable.rows().data()[i].Tipo_Servico == $("#iTipo_Servico").val() &&
                    oDatatable.rows().data()[i].Sub_Tipo_Servico == $("#iSub_Tipo_Servico").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.SUBTIPO_SERVICO)", "warning");
                    erro = true;
                    break;
                }

                if (oDatatable.rows().data()[i].Sub_Tipo_Servico == $("#iCod_Encerramento").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.CODIGO_ENCERRAMENTO)", "warning");
                    erro = true;
                    break;
                }

                if (oDatatable.rows().data()[i].Cod_Cobranca == $("#iEscolhaCobranca").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.COBRANCA)", "warning");
                    erro = true;
                    break;
                }
            }

            if (erro) {
                return;
            }

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Cobranca_Servicoapi/ConsultaTipoServico")';
            var model = {
                Id_Segmento: $("#iSegmento").val(),
                Id_Tipo_Servico: $("#iTipo_Servico option:selected").val(),
                Id_Sub_Tipo_Servico: $("#iSub_Tipo_Servico").val(),
                Id_Cod_Encerramento: $("#iCod_Encerramento").val()
            };

            const resultado = await $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: model,
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                }
            });

            if (resultado.ok) {
                Notificar("@RsBase.ATENCAO_", resultado.mensagem, "warning");
                return false;
            }

            oDatatable.row.add({
                Id: 0,
                Segmento_Desc: $("#iSegmento option:selected").text(),
                Segmento: $("#iSegmento").val(),
                Desc_Cod_Encerramento: $("#iCod_Encerramento option:selected").text(),
                Cod_Encerramento: $("#iCod_Encerramento").val(),
                Desc_Tipo_Servico: $("#iTipo_Servico option:selected").text(),
                Tipo_Servico: $("#iTipo_Servico option:selected").val(),
                Desc_Sub_Tipo_Servico: $("#iSub_Tipo_Servico option:selected").text(),
                Sub_Tipo_Servico: $("#iSub_Tipo_Servico").val(),
                TodasSubTipoServico: $('#iTodasSubTipoServico').is(':checked'),
                TodasCod_Encerramento: $('#iTodasCod_Encerramento').is(':checked'),
                Cod_Cobranca: $("#iEscolhaCobranca option:selected").val(),
                Desc_Forma_Cobranca: $("#iEscolhaCobranca option:selected").text()
            }).draw(false);

            $("#iSegmento").val(null).trigger('change');
            disabledFields();
            handleExcluir();
        });
    },
        TableManageButtonsTipoServico = function () {
        "use strict";
        return {
            init: function () {
                handleDataTableButtonsTipoServico();
            }
        }
        }();

    TableManageButtonsTipoServico.init();

    var handleDataTableButtonsPlanoProduto= function () {
    "use strict";

        var array = @Html.Raw(Json.Encode(Model.PlanoProduto));
        var nome_lista = "PlanoProduto";//Nome_utilizado para enganar o razor

        //"Blfrtip"
        oDatatablePlanoProduto = $("#datatablePlanoProduto").length && $("#datatablePlanoProduto").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            scrollX: true,
            data: array,
            columns: [
                {
                    data: "Id",
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluirPlano" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
                {
                    data: "Desc_Plano_Produto",
                    title: "@RsCadastros.PLANOS_E_PRODUTOS",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Desc_Plano_Produto" name="' + nome_lista + '[' + meta.row + '].Desc_Plano_Produto" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Plano_Produto" name="' + nome_lista + '[' + meta.row + '].Plano_Produto" type="hidden" value="' + TrataNulo(row.Plano_Produto) + '">';
                        }
                        return data;
                    }
                },

                 {
                     data: "Valor_Cobrado",
                     title: "@RsCadastros.VALOR_COBRADO",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Valor_Cobrado" name="' + nome_lista + '[' + meta.row + '].Valor_Cobrado" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                        return data;
                    }
                },

            ]
        });

        function handleExcluir() {
            $(".btnExcluirPlano").unbind('click');
            $(".btnExcluirPlano").click(function (e) {
                e.preventDefault();

                var idArquivo = $(this).attr("excluir");

                var trLinkButton = $(this).parents('tr');


                if (idArquivo === "0") {
                    oDatatablePlanoProduto.row(trLinkButton).remove().draw(false);
                    CalcularValorTotal();
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
                else {

                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Cobranca_Servicoapi/ExcluirGrid?value=")' + idArquivo;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',

                    })
                        .done(function (data) {

                            if (data.ok) {
                                oDatatablePlanoProduto.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                            CalcularValorTotal();
                        })
                        .fail(function () {

                        })
                        .always(function () {

                        });
                }
            });
        }

        handleExcluir();

        $("#btnAdicionarPlanoProduto").unbind('click');
        $("#btnAdicionarPlanoProduto").on('click', function () {

            for (var i = 0; i < oDatatablePlanoProduto.rows().data().length; i++) {

                if (oDatatablePlanoProduto.rows().data()[i].Plano_Produto == $("#iPlano_Produto option:selected").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.PLANO_PRODUTO)", "warning");
                        erro = true;
                    i = oDatatablePlanoProduto.rows().data().length;
                }
                if (!$("#iPlano_Produto").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PLANO_PRODUTO)", "warning");
            erro = true;
        }

            }


            oDatatablePlanoProduto.row.add({
                Id: 0,
                Desc_Plano_Produto: $("#iPlano_Produto option:selected").text(),
                Plano_Produto: $("#iPlano_Produto").val(),
                Valor_Cobrado: PlanoProdutoSelecionado.valorPlanoProduto,

            }).draw(false);

            CalcularValorTotal();
            handleExcluir();
            $("#iPlano_Produto").val(null).trigger('change');

        });

    },
        TableManageButtonsPlanoProduto = function () {
        "use strict";
        return {
            init: function () {
                handleDataTableButtonsPlanoProduto();
                CalcularValorTotal();
            }
        }
        }();

        TableManageButtonsPlanoProduto.init();


        function CalcularValorTotal () {
            var valor_total = 0;

            for (var i = 0; i < oDatatablePlanoProduto.data().count(); i++) {

                var valor_row = typeof oDatatablePlanoProduto.row(i).data().Valor_Cobrado == "string"
                    ?
                    oDatatablePlanoProduto.row(i).data().Valor_Cobrado.replace(",", ".")
                    :
                    oDatatablePlanoProduto.row(i).data().Valor_Cobrado;

                valor_row = parseFloat(valor_row);

                valor_total += valor_row;
            }

            var valorStr = floatParaString(valor_total);

            $("#iValorFinal").val(valorStr);
            valorTotalInicial = valor_total;

        };

    var clicked = false;
    function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

</script>
}


