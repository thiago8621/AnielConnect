@model Aniel.Connect.Models.T5.PerfilAgendamentoCadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Aniel.T5.Model.enumerado

@{
    ViewBag.Title = RsCadastros.CADASTRO_PERFIL_AGENDAMENTO_ROTEIRIZACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}


@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
<script>
    const areasPerfilAgendamento = @Html.Raw(Json.Encode(Model.Areas));
    const naturezasPerfilAgendamento = @Html.Raw(Json.Encode(Model.Naturezas));

    var HandleGrupo = function () {
        $('#iGrupoArea').unbind("select2:select select2:unselecting");
        $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

            GrupoSelecionado = e.params.data
            if (GrupoSelecionado) {
                AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false, HandleArea);
                AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }
            else {
                AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
            }

        });
    };

    function reorderRecords(records = []) {
        if (records.length > 0) {
            oDatatableArea.clear();
            for (let record of records) {

                oDatatableArea.row.add({
                    Id: record.Id,
                    GrupoAreaStr: record.GrupoAreaStr,
                    Cod_Escritorio: record.Cod_Escritorio,
                    AreaStr: record.AreaStr,
                    Cod_Area: record.Cod_Area,
                    Nivel: record.Nivel,
                    LocalidadeStr: record.LocalidadeStr,
                    Cod_Localidade: record.Cod_Localidade,
                    Todas_Localidades: record.Todas_Localidades,
                    Todas_Areas: record.Todas_Localidades,
                });
            }
        }
        oDatatableArea.draw(false);
    }

    var HandleArea = function () {
        $('#iArea').unbind('select2:select select2:unselecting');
        $('#iArea').on('select2:select select2:unselecting', function (e) {

            AreaSelecionada = e.params.data
            if (AreaSelecionada) {
                AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id), null, "@RsBase.SELECIONE", false);
            }
            else {
                AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }

        });
    };

        function carregaSelect2(){
            AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupo);
            AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
            AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iNatureza", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iDepartamento", "@CONSTANTES.URLPortal/api/FolhaDeptoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }

        carregaSelect2();

    let oDatatableArea = null;

    var handleDataTableAreas = function () {
        "use strict";

        var nome_lista = "Areas";//Nome_utilizado para enganar o razor

        //"Blfrtip"
         oDatatableArea = $("#datatableAreas").length && $("#datatableAreas").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: areasPerfilAgendamento,
            paging: false,
            drawCallback: () => {
                handleExcluir();
               
            },
            order: [],
            columns: [
                {
                    data: "Id",
                    orderable: false,
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluirArea" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +

                            ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Escritorio" name="' + nome_lista + '[' + meta.row + '].Cod_Escritorio" type="hidden" value="' + TrataNulo(row.Cod_Escritorio) + '">' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Area" name="' + nome_lista + '[' + meta.row + '].Cod_Area" type="hidden" value="' + TrataNulo(row.Cod_Area) + '">' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Localidade" name="' + nome_lista + '[' + meta.row + '].Cod_Localidade" type="hidden" value="' + TrataNulo(row.Cod_Localidade) + '">';
                    }
                },
                {
                    data: "GrupoAreaStr",
                    orderable: false,
                    title: "@RsCadastros.GRUPO_AREA",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__GrupoAreaStr" name="' + nome_lista + '[' + meta.row + '].GrupoAreaStr" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                        return data;
                    },
                    width: 380
                },
                {
                    data: "AreaStr",
                    orderable: false,
                    title: "@RsCadastros.AREA",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            var valor = row.Todas_Areas == 1 ? "@RsBase.TODAS" : data;
                            data = valor + ' <input id="' + nome_lista + '_' + meta.row + '__AreaStr" name="' + nome_lista + '[' + meta.row + '].AreaStr" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Todas_Areas" name="' + nome_lista + '[' + meta.row + '].Todas_Areas" type="hidden" value="' + TrataNulo(row.Todas_Areas) + '">';
                        }
                        return data;
                    },
                    width: 380
                },
                {
                    data: "LocalidadeStr",
                    orderable: false,
                    title: "@RsCadastros.LOCALIDADE",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            var valor = row.Todas_Localidades == 1 ? "@RsBase.TODAS" : data;

                            data = valor + ' <input id="' + nome_lista + '_' + meta.row + '__LocalidadeStr" name="' + nome_lista + '[' + meta.row + '].LocalidadeStr" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Todas_Localidades" name="' + nome_lista + '[' + meta.row + '].Todas_Localidades" type="hidden" value="' + TrataNulo(row.Todas_Localidades) + '">';
                        }
                        return data;
                    },
                    width: 380
                },
                {
                    data: "Nivel",
                    orderable: false,
                    title: "Nivel",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Nivel" name="' + nome_lista + '[' + meta.row + '].Nivel" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                        return data;
                    },
                    width: 380
                }
            ]
        });       

        function handleExcluir() {
            $(".btnExcluirArea").unbind('click');
            $(".btnExcluirArea").click(async function (e) {
                e.preventDefault();

                var idFiltro = $(this).attr("excluir");

                var trLinkButton = $(this).parents('tr');

                if (idFiltro === "0") {
                    oDatatableArea.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
                else {

                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/PerfilAgendamentoApi/ExcluirGridArea?value=")' + idFiltro;

                    await $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',

                    })
                        .done(function (data) {

                            if (data.ok) {
                                oDatatableArea.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                        .fail(function () {

                        })
                        .always(function () {

                        });
                }
                let records = oDatatableArea.rows().data().toArray();
                reorderRecords(records);
            });
        }

        handleExcluir();

        $("#btnAdicionarArea").unbind('click');
        $("#btnAdicionarArea").on('click', function () {

            var erro = false;

            let descricaoGrupoArea = $("#iGrupoArea option:selected").text();
            let codigoGrupoArea = $("#iGrupoArea option:selected").val();

            if (!$("#iTodas_Localidades").is(":checked")) {
                $("#iLocalidade").addClass("obrigatorioArea");
            }
            else {
                $("#iLocalidade").removeClass("obrigatorioArea");
            }

            if ($("#iTodas_Areas").is(":checked")) {
                $("#iArea").removeClass("obrigatorioArea");
                $("#iLocalidade").removeClass("obrigatorioArea");
                $("#iTodas_Localidades").prop("checked", true);
            }


            @*if (ValidaObrigatoriosPorClasse("obrigatorioArea",erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            if ($("#iTodas_Localidades").is(":checked")) {

                for (var i = 0; i < oDatatableArea.rows().data().length; i++) {
                    if (oDatatableArea.rows().data()[i].Cod_Escritorio == $("#iGrupoArea option:selected").val() &&
                        oDatatableArea.rows().data()[i].Cod_Area == $("#iArea option:selected" ).val()) {

                        oDatatableArea.row(oDatatableArea.rows().data()[i]).remove().draw(false);
                    }
                }

            }

            if ($("#iTodas_Areas").is(":checked")) {

                for (var i = 0; i < oDatatableArea.rows().data().length; i++) {
                    if (oDatatableArea.rows().data()[i].Cod_Escritorio == $("#iGrupoArea option:selected").val() &&
                        oDatatableArea.rows().data()[i].Cod_Area == $("#iArea option:selected").val()) {

                        oDatatableArea.row(oDatatableArea.rows().data()[i]).remove().draw(false);
                    }
                }

            }

            for (var i = 0; i < oDatatableArea.rows().data().length; i++) {

                if (oDatatableArea.rows().data()[i].Cod_Escritorio == $("#iGrupoArea option:selected").val() &&
                    oDatatableArea.rows().data()[i].Cod_Area == $("#iArea option:selected").val() &&
                    oDatatableArea.rows().data()[i].LocalidadeStr == $("#iLocalidade option:selected").text()) {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.LOCALIDADE)", "warning");
                    erro = true;
                    break;
                }
                if (oDatatableArea.rows().data()[i].Cod_Escritorio == $("#iGrupoArea option:selected").val("")) {
                    Notificar("@RsBase.ATENCAO_", " Adicione uma Area de atuação para salvar o perfil.", "warning");
                    erro = true;
                    break;
                }

            }*@

            if (erro) {
                return;
            }

            oDatatableArea.row.add({
                Id: 0,
                GrupoAreaStr: descricaoGrupoArea,
                Cod_Escritorio: codigoGrupoArea,
                AreaStr: $("#iArea option:selected").text(),
                Cod_Area: $("#iArea option:selected").val(),
                Nivel: $("#iNivel").val(),
                LocalidadeStr: $("#iLocalidade option:selected").text(),
                Cod_Localidade: $("#iLocalidade option:selected").val(),
                Todas_Localidades: $("#iTodas_Localidades").is(":checked"),
                Todas_Areas: $("#iTodas_Areas").is(":checked")
            }).draw(false);

            handleExcluir();

            $("#iGrupoArea").empty().trigger("change");
            $("#iArea").val(null).trigger("change");
            $("#iLocalidade").val(null).trigger("change");
            $("#iTodas_Localidades").prop("checked", false);
            $('#iTodas_Localidades').trigger("change");
            $("#iTodas_Areas").prop("checked", false);
            $('#iTodas_Areas').trigger("change");
            $("#iGrupoArea").val(0).change();
        });

    },
        TableManageButtonsAreas = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableAreas();
                }
            }
        }();

    TableManageButtonsAreas.init();

    let oDatatableNatureza = null;

    var handleDataTableNaturezas = function () {
        "use strict";

        var nome_lista = "Naturezas";//Nome_utilizado para enganar o razor

        //"Blfrtip"
       oDatatableNatureza = $("#datatableNaturezas").length && $("#datatableNaturezas").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: naturezasPerfilAgendamento,
            paging: false,
            drawCallback: () => {
                handleExcluir();
            },
            order: [],
            columns: [
                {
                    data: "Id",
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluirNatureza" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Departamento" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Id_Natureza" name="' + nome_lista + '[' + meta.row + '].Id_Natureza" type="hidden" value="' + TrataNulo(row.Id_Natureza) + '">';
                    }
                },
                {
                    data: "Descricao",
                    title: "@RsCadastros.DESCRICAO",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Descricao" name="' + nome_lista + '[' + meta.row + '].Descricao" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                        return data;
                    }
                },
                {
                    data: "Departamento",
                    title: "@RsCadastros.DEPARTAMENTO",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Departamento" name="' + nome_lista + '[' + meta.row + '].Departamento" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                        return data;
                    }
                }

            ]
        });

        function handleExcluir() {
            $(".btnExcluirNatureza").unbind('click');
            $(".btnExcluirNatureza").click(function (e) {
                e.preventDefault();

                var idExcluir = $(this).attr("excluir");

                var trLinkButton = $(this).parents('tr');

                if (idExcluir === "0") {
                    oDatatableNatureza.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
                else {

                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/PerfilAgendamentoApi/ExcluirGridNatureza?value=")' + idExcluir;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',

                    })
                        .done(function (data) {

                            if (data.ok) {
                                oDatatableNatureza.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                        .fail(function () {

                        })
                        .always(function () {

                        });
                }
            });
        }

        handleExcluir();

        $("#btnAdicionarNatureza").unbind('click');
        $("#btnAdicionarNatureza").on('click', function () {

            var erro = false;

                if (ValidaObrigatoriosPorClasse("obrigatorioNatureza", erro)) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                    erro = true
                }

            for (var i = 0; i < oDatatableNatureza.rows().data().length; i++) {

                    if (oDatatableNatureza.rows().data()[i].Id_Natureza == $("#iNatureza").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.NATUREZA)", "warning");
                        erro = true;
                        i = oDatatableNatureza.rows().data().length;
                    }

                }

                if (erro) {
                    return;
                }

            oDatatableNatureza.row.add({
                Id: 0,
                Id_Natureza: $("#iNatureza option:selected").val(),
                Descricao: $("#iNatureza option:selected").text(),
                Departamento: $("#iDepartamento option:selected").text(),
            }).draw(false);

            handleExcluir();


            $("#iNatureza").val("").trigger('change');
            $("#iDepartamento").val("").trigger('change');

        });
    },
        TableManageButtonsNaturezas = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableNaturezas();
                }
            }
        }();

    TableManageButtonsNaturezas.init();


        var clicked = false;
    function ValidaSubmit() {

            if (clicked) {
                return false;
            }

            clicked = true;

            erro = false;

            if (ValidaCamposObrigatorios(erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            if ($("#iDescricao").val() == "") {
                Notificar("@RsBase.ATENCAO_", "Preencha o nome do Perfil.", "warning")
                erro = true
        }

            if (oDatatableNatureza.data().toArray() == 0) {
               Notificar("@RsBase.ATENCAO_", "Adicione uma Natureza para salvar o perfil.", "warning");
               erro = true;
            }

           if (oDatatableArea.data().toArray() == 0) {
               Notificar("@RsBase.ATENCAO_", "Adicione uma Área de atuação para salvar o perfil.", "warning");
               erro = true;
            }

            if (erro) {
                clicked = false;
                return false;
            }

            let records = oDatatableArea.rows().data().toArray();
            reorderRecords(records);

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

</script>
}

@using (Html.BeginForm("Cadastro", "PerfilAgendamento", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-cogs"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "PerfilAgendamento")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_PERFIL_AGENDAMENTO_ROTEIRIZACAO</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>

                        @*<span style="font-size:11px" id="dtLegend"></span>*@
                    </div>
                </div>

                <!--Nav Tab-->
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="sobre-tab" data-toggle="tab" href="#iSobre" role="tab" aria-controls="sobre" aria-selected="true"><i class="fa fa-users"></i>Perfil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="filtros-tab" data-toggle="tab" href="#iAreasAtuacao" role="tab" aria-controls="filtros" aria-selected="false"><i class="fa fa-map-marker"></i>Áreas de atuação</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="colunas-tab" data-toggle="tab" href="#iColunas" role="tab" aria-controls="colunas" aria-selected="false"><i class="fas fa-toolbox"></i>Naturezas de Serviço</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane active" id="iSobre">
                        <div class="card div-card-accord">
                            <div class="card-header title-card" id="heading-1">
                                <h5 class="mb-0">
                                    <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                        <span class="text-bold-card">Nome do Perfil</span>
                                    </a>
                                </h5>
                            </div>

                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body body-card-accord">
                                    <div class="row mt-2 mb-2">
                                        <div class="col-sm-7">
                                            <div class="form-group">
                                                <label for="iDescricao" class="mr-3">@RsFinanceiro.DESCRICAO:</label> <!--Alterado maxlength de 20 para 100 Card #154 Apoio Implantação -->
                                                @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control obrigatorio", @id = "iDescricao", @autocomplete = "off", @maxlength = "100", @required = true })
                                                @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        @if (Model.Id != 0)
                                        {
                                            <div class="col-sm-3 pt-3">
                                                <div class="form-group">
                                                    <label for="iSaldo_Caixa" class="mr-3">@RsFinanceiro.STATUS:</label>
                                                    @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>
                                        }
                                    </div>

                                </div>


                            </div>
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane" id="iAreasAtuacao">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="card div-card-accord">
                                    <div class="card-header title-card" id="heading_6">
                                        <h5 class="mb-1">
                                            <a role="button">
                                                <span class="text-bold-card">Adicionar Áreas de Atuação</span>
                                            </a>
                                        </h5>
