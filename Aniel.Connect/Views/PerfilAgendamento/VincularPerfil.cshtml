@model Aniel.Connect.Models.T5.PerfilAgendamentoDatatableRequest

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.VINCULAR_PERFIL_TECNICO;
    ViewBag.Sessao = RsCadastros.LISTAGEM_PERFIL_AGENDAMENTO_ROTEIRIZACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
}


@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

<script>
    var rows_selected = [];
    var lista_perfis = [];
    var oDatatable = null;

    $(document).ready(function () {
        AddSelect("iPerfilAgendamento", "@CONSTANTES.URLPortal/api/PerfilAgendamentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iPerfilAgendamentoModal", "@CONSTANTES.URLPortal/api/PerfilAgendamentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
    });

    $("#btnVincular").on("click", function () {

        if (rows_selected.length == 0) {
            $('#modal-vincular').modal('hide');
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");

            return false;
        }

        if (lista_perfis.length > 0) {
            parent.Swal.fire({
                type: 'warning',
                title: '<b>Um ou mais Técnicos já possuem um perfil</b>',
                text: 'Alguns usuários selecionados já estão vinculados a um perfil, ao prosseguir com a ação os perfis serão atualizados. Deseja continuar?',
                showCancelButton: true,
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não'
            }).then(async (okay) => {
                if (okay.value) {
                    $('#modal-vincular').modal('show');
                }
                else {
                    return false;
                }
            });
        }
        else {
            $('#modal-vincular').modal('show');
        }
    });

    function VincularPerfil() {

        if (!$(`#iPerfilAgendamentoModal`).val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PERFIL_AGENDAMENTO_ROTEIRIZACAO)", "info");
            return;
        }

        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/PerfilAgendamentoApi/VincularPerfil")';

        ShowPageLoading();

        $.ajax({
            url: link,
            type: 'POST',
            dataType: 'json',
            data: {
                equipes: rows_selected,
                id_perfil: $(`#iPerfilAgendamentoModal option:selected`).val()
            }
        })
        .done(function (data) {
            HidePageLoading();

            if (data.ok) {
                Notificar("@RsBase.INFORMACAO", "Sucesso! Perfil Vinculado.", "info");
                $('#modal-vincular').modal('hide');
                rows_selected = [];
                lista_perfis = [];
                oDatatable.draw();
            }
            else {
                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
            }
        });
    }

    async function RemoverPerfil() {

        if (rows_selected.length == 0) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
            return;
        }

        let confirmadoBool = await parent.Swal.fire({
            type: 'warning',
            title: 'Confirmar ação',
            text: 'confirma a remoção de perfis para os usuários selecionados na lista?',
            showCancelButton: true,
            confirmButtonText: 'Sim',
            cancelButtonText: 'Não'
        });

        if (confirmadoBool.value)
        {
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/PerfilAgendamentoApi/RemoverPerfil")';

            ShowPageLoading();

            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    equipes: rows_selected
                }
            })
            .done(function (data) {
                HidePageLoading();

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    rows_selected = [];
                    lista_perfis = [];
                    oDatatable.draw();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });
        }
    }

    var handleDataTableButtons = function () {
        "use strict";
        //"Blfrtip"
        oDatatable = $("#datatable").length && $("#datatable").DataTable({
            dom: "Bfrti",
            columnDefs: [
                {
                    targets: 0,
                    searchable: false,
                    orderable: false,
                    width: '1%',
                    className: 'dt-body-center',
                    render: function (data, type, full, meta) {
                        return "<input type='checkbox'></input>";
                    }
                }
            ],
            select: {
                style: 'multi'
            },
            order: [[2, 'asc']],
            serverSide: true,
            searching: true,
            ordering: true,
            paging: true,
            deferRender: true,
            scrollResize: true,
            scrollY: '66vh',
            scroller: {
                loadingIndicator: true,
                rowHeight: 40,
                boundaryScale: 0.5,
                displayBuffer: 3
            },
            stateSave: true,
            scrollX: true,
            fixedHeader: true,
            initComplete: dataTableInitComplete,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
            ajax: {
                url: baseUrl + '/api/PerfilAgendamentoapi/VincularPerfilGetAll',
                type: 'POST',
                data: function (data) {

                    data.todos = $("#iTodos").is(":checked");
                    data.configurados = $("#iConfigurados").is(":checked");
                    data.naoConfigurados = $("#iNaoConfigurados").is(":checked");
                    data.perfilSearch = $("#iPerfilAgendamento").val();
                    data.perfil = $("#iPerfilAgendamento").text();

                },
                error: function (e) {
                    console.log(e);
                },
                dataSrc: function (d) {
                    return d.data;
                }
            },
            infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                var str = "@RsCadastros.INFODATATABLE";

                if (iTotal == 0) {
                    iEnd = 0; iStart = 0;
                }

                str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);

                $("#dtLegend").html(str);

                return "";
            },
            rowCallback: function (row, data, dataIndex) {
                // Get row ID
                var rowId = data.id;

                // If row ID is in the list of selected row IDs
                if ($.inArray(rowId, rows_selected) !== -1) {
                    $(row).find('input[type="checkbox"]').prop('checked', true);
                    $(row).addClass('selected');
                }
            },
            pageLength: 10,
            language: traducaoDataTableSimples,
            buttons: buttonsDataTable,
            columns: [
                { title: "<input name='select_all' value='1' type='checkbox'>" },
                { data: "usuario", title: "Login" },
                { data: "nomeEquipe", title: "@RsCadastros.TECNICO" },
                { data: "perfilAgendamento", title: "Perfil Equipe" }
            ]
        });

        $('#txtSearch').keyup(function () {
            rows_selected = [];
            lista_perfis = [];
            oDatatable.search($(this).val()).draw();
        });

        $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {
            $("#iTodos").prop("checked", false);
            $("#iConfigurados").prop("checked", false);
            $("#iNaoConfigurados").prop("checked", false);
            $("#iPerfilAgendamento").text("");

            $('#txtSearch').val('');
            rows_selected = [];
            lista_perfis = [];
            oDatatable.search($('#txtSearch').val()).draw();
        });

        $("#iPesquisar").on("click", function () {
            oDatatable.draw();

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                return false;
            }

            $("#modal-filter").modal('hide');
            rows_selected = [];
            lista_perfis = [];
            oDatatable.search($('#txtSearch').val()).draw();

            return true;
        });

        // Handle click on checkbox
        $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
            var $row = $(this).closest('tr');

            // Get row data
            var rowId = oDatatable.row($row).data().equipe;

            var perfil = oDatatable.row($row).data().perfilAgendamento;

            var index = $.inArray(rowId, rows_selected);

            // If checkbox is checked and row ID is not in list of selected row IDs
            if (this.checked && index === -1) {
                rows_selected.push(rowId);

                if (perfil !== 'Nenhum') {
                    lista_perfis.push(perfil);
                }

                // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
            } else if (!this.checked && index !== -1) {
                rows_selected.splice(index, 1);

                if (perfil !== 'Nenhum') {
                    lista_perfis.splice(index, 1);
                }
            }

            if (this.checked) {
                $row.addClass('selected');
            } else {
                $row.removeClass('selected');
            }

            // Prevent click event from propagating to parent
            e.stopPropagation();
        });

        // Handle click on table cells with checkboxes
        $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
            $(this).parent().find('input[type="checkbox"]').trigger('click');
        });

        // Handle click on "Select all" control
        $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
            if (this.checked) {
                $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
            } else {
                $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
            }

            // Prevent click event from propagating to parent
            e.stopPropagation();
        });

        // Handle table draw event
        oDatatable.on('draw', function () {
            // Update state of "Select all" control
            updateDataTableSelectAllCtrl(oDatatable);
        });
    },
        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtons();
                }
            }
        }();

    TableManageButtons.init();
</script>
}


<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-users"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

            @*<span style="font-size:11px;margin-left: 15px;" id="dtLegend"></span>*@
        </div>

        <div class="col-auto">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.LOGIN/@RsCadastros.NOME" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>

                              

                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>

                    <a class="dropdown-item" id="btnVincular" href="#">@RsCadastros.VINCULAR_PERFIL_USUARIO</a>
                    <a class="dropdown-item" id="btnRemover" href="#" onclick="RemoverPerfil();">@RsCadastros.REMOVER_PERFIL_USUARIO</a>
                    <a class="dropdown-item" id="btnLog" href="@Url.Action("LogVincularPerfil", "PerfilAgendamento")">@RsCadastros.VISUALIZAR_LOG</a>
                </div>
            </div>
        </div>

    </div>
    <!--./main-->
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" style="color: darkgray"> <i class="fas fa-filter"></i> @RsCadastros.LISTA_FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" arial-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="col-12" style="width: 100%">
                    <div class="col-12" style="width: 100%">
                        <div class="form-group">
                            <label for="iPerfilAgendamento">@RsCadastros.PERFIL_EQUIPE:</label>
                            @Html.DropDownList("iPerfilAgendamento", new SelectList(new List<object>()), RsBase.SELECIONE, new { @class = "form-control mb-3", @id = "iPerfilAgendamento", @autocomplete = "off" })
                         
                        </div>
                    </div>
                    <div class="form-group">
                        <input type="radio" id="iTodos" name="radio" />
                        <label for="iTodos">Todos os usuários</label>
                    </div>
                </div>
                <div class="col-12" style="width: 100%">
                    <div class="form-group">
                        <input type="radio" id="iConfigurados" name="radio" />
                        <label for="iConfigurados">Somente usuários configurados</label>
                    </div>
                </div>
                <div class="col-12" style="width: 100%">
                    <div class="form-group">
                        <input type="radio" id="iNaoConfigurados" name="radio" />
                        <label for="iNaoConfigurados">Somente usuários não configurados</label>
                    </div>
                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal"> Limpar</button>
                        <button type="button" class="btn btn-success" id="iPesquisar"> Pesquisar</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!--Modal Filters-->
<div class="modal" id="modal-vincular">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted"> @RsCadastros.VINCULAR_PERFIL_AGENDAMENTO_ROTEIRIZACAO</h4>
                <button type="button" class="close" data-dismiss="modal" arial-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="col-sm-11 container" style="align-content:center;">
                    <div class="row col-12" style="width: 100%">
                        <div class="form-group">
                            <label for="iPerfilAgendamentoModal">@RsCadastros.PERFIL_EQUIPE:</label>
                            @Html.DropDownList("iPerfilAgendamentoModal", new SelectList(new List<object>()), RsBase.SELECIONE, new { @class = "form-control mb-3", @id = "iPerfilAgendamentoModal", @autocomplete = "off" })                            
                        </div>
                    </div>                   

                    <div class="form-group col-sm-12" style="padding: 15px;">
                        <div class="text-center">
                            <button type="button" class="btn btn-danger" onclick="$('#modal-vincular').modal('hide')"> @RsBase.CANCELAR</button>
                            <button type="button" class="btn btn-success" onclick="VincularPerfil();"> @RsBase.CONFIRMAR</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
