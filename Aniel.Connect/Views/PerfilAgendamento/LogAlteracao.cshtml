@{
    ViewBag.Title = "Log Perfil Agendamento/Roteirização";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles{
    @Styles.Render("~/Content/cssDataTable")
}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script>

        var oDatatable = null;

        rows_selected = [];

        "use strict";

       function carregaSelect2(){
            AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupo);
            AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
            AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iNatureza", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iPerfil", "@CONSTANTES.URLPortal/api/PerfilAgendamentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
       }

        $(document).ready(async () => {
            carregaSelect2();
            if (oDatatable = null) {
                $('#datatable').rows_selected = [];
            }

        })


       var HandleGrupo = function () {
            $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

                GrupoSelecionado = e.params.data
                if (GrupoSelecionado) {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false, HandleArea);
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
                else {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
                }

            });
        };

        var HandleArea = function () {
            $('#iArea').on('select2:select select2:unselecting', function (e) {

                AreaSelecionada = e.params.data
                if (AreaSelecionada) {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id), null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };



    $("#iLimparFiltro,#iLimparFiltroModal").click(() => {
        $('#iGrupoArea').val(null).trigger('change')
        $('#iArea').val(null).trigger('change')
        $('#iLocalidade').val(null).trigger('change')
        $('#iEquipe').val(null).trigger('change')
        $('#iNatureza').val(null).trigger('change')
        $('#iPerfil').val(null).trigger('change')
        $("#iDataInicial").val(null).trigger('change')
        $("#iDataFinal").val(null).trigger('change')
        carregaSelect2()
        if (oDatatable != null) {
            oDatatable.draw()
        }
    });


        $("#iPesquisar").on("click", function () {

            erro = false;

            @*if ($("#iPerfil").val() == null) {

                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PERFIL)", "warning");
                erro = true;
            }*@

            if ($('#iDataInicial').val() && $('#iDataFinal').val()) {
                const datainicio = moment($('#iDataInicial').val(), "DDMMYYYY")
                const datafim = moment($('#iDataFinal').val(), "DDMMYYYY")

                var result = (datafim.diff(datainicio, "days"))

                if (result > 60) {
                    Notificar("@RsBase.ATENCAO_", "Selecione um período até 60 dias.", "warning");
                    erro = true;

                } else {
                    erro = false;
                }
            }


            if (!erro) {
                CarregaDataTable();
                return true;
            }
        });


        var filter_state = {
            perfil: {
                label: "@RsCadastros.PERFIL",
                getDisplay: () => { return Boolean($('#iPerfil').val()) ? $('#iPerfil option:selected').text() : "" },
                onclick: () => {
                    $('#iPerfil').val(null).trigger("change")
                    oDatatable.draw()
                }

            },
            natureza: {
                label: "@RsCadastros.NATUREZA",
                getDisplay: () => { return Boolean($('#iNatureza').val()) ? $('#iNatureza option:selected').text() : "" },
                onclick: () => {
                    $('#iNatureza').val(null).trigger("change")
                    oDatatable.draw()
                }

            },
            grupo_area: {
                label: "@RsCadastros.GRUPO_AREA",
                getDisplay: () => { return Boolean($('#iGrupoArea').text()) ? $('#iGrupoArea option:selected').text() : "" },
                onclick: () => {
                    $('#iGrupoArea').val(null).trigger("change")
                    $('#iArea').val(null).trigger("change")
                    $('#iLocalidade').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            area: {
                label: "@RsCadastros.AREA",
                getDisplay: () => { return Boolean($('#iArea').text()) ? $('#iArea option:selected').text() : "" },
                onclick: () => {
                    $('#iArea').val(null).trigger("change")
                    $('#iLocalidade').val(null).trigger("change")
                    oDatatable.draw()
                }

            },
            localidade: {
                label: "@RsCadastros.LOCALIDADE",
                getDisplay: () => { return Boolean($('#iLocalidade').text()) ? $('#iLocalidade option:selected').text() : "" },
                onclick: () => {
                    $('#iLocalidade').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            periodoInicio: {
                label: "@RsCadastros.PERIODO",
                getDisplay: () => { return Boolean($('#iDataInicial').val()) ? $('#iDataInicial').val() + " a " + $('#iDataFinal').val() : "" },
                onclick: () => {
                    $('#iDataInicial').val(null).trigger("change")
                    oDatatable.draw()
                }

                //onclick: () => null,
                //removable: false
            }

        }

       var handleDataTableButtons = function () {
            oDatatable.on('draw', function () {
                HidePageLoading();
          });
        }

    function CarregaDataTable() {

        if (oDatatable == null) {

            oDatatableFunction();
        } else {
            oDatatable.draw();
        }


    }

        "use strict";

        function oDatatableFunction() {

                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "Bfrti",
                    select: {
                        style: 'multi'
                    },
                    serverSide: true,
                    searching: true,
                    ordering: true,
                    paging: true,
                    destroy: true,
                    deferRender: true,
                    scrollResize: true,
                    scrollY: '66vh',
                    scroller: {
                        loadingIndicator: true,
                        rowHeight: 40,
                        boundaryScale: 0.5,
                        displayBuffer: 3
                    },
                    stateSave: true,
                    scrollX: true,
                    fixedHeader: true,
                    initComplete: dataTableInitComplete,
                    drawCallback: () => {

                        TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                        ResizeTable('divTable');
                    },
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: baseUrl + '/api/PerfilAgendamentoapi/GetLogPerfilAgendamento',
                        type: 'POST',
                        data: function (data) {

                            data.perfil = $('#iPerfil option:selected').text();
                            data.grupoArea = $("#iGrupoArea option:selected").text();
                            data.area = $("#iArea option:selected").text();
                            data.localidade = $("#iLocalidade option:selected").text();
                            data.natureza = $("#iNatureza option:selected").text();
                            data.periodoInicio = $("#iDataInicial").val();
                            data.periodoFim = $("#iDataFinal").val();
                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
                    },
                    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                        var str = "@RsCadastros.INFODATATABLE";
                        if (iTotal == 0) { iEnd = 0; iStart = 0; }
                        str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                        $("#dtLegend").html(str);

                        return "";
                    },
                    pageLength: 5,
                    order: [],
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTable,
                    columns: [
                        { data: "perfil", title: "@RsCadastros.PERFIL", orderable: false },
                        { data: "natureza", title: "@RsCadastros.NATUREZA", orderable: false },
                        { data: "grupoArea", title: "@RsCadastros.GRUPO_AREA", orderable: false },
                        { data: "area", title: "@RsCadastros.AREA", orderable: false },
                        { data: "localidade", title: "@RsCadastros.LOCALIDADE", orderable: false },
                        { data: "tipo_Alteracao", title: "@RsCadastros.TIPO_ALTERACAO", orderable: false },
                        { data: "periodoInicio", title: "@RsCadastros.DATAHORA_ALTERACAO", orderable: false },
                        { data: "usuario_Alteracao", title: "@RsBase.USUARIO_ALTERACAO", orderable: false }
                    ]
                });

                $('#txtSearch').val(oDatatable.search());
                $('#txtSearch').keyup(function () {
                    oDatatable.search($(this).val()).draw();
                });

                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    rows_selected = [];
                });

                oDatatable.draw();

         }


    </script>
}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="far fa-calendar-check"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "PerfilAgendamento")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PERFIL_AGENDAMENTO_ROTEIRIZACAO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>



    </div>
    <!--./main-->
    <div class="mt-2 mr-2 ml-2">
    </div>
</div>
<div class="container-fluid">

    <div class="row mt-2 mr-2 ml-2">

        <div class="row">
            <div class="col mr-2">
                <div class="form-group">
                    <label for="iPerfil">@RsCadastros.PERFIL:</label>
                    <select class="form-control" id="iPerfil"></select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col mr-2">
                <div class="form-group">
                    <label for="iNatureza">@RsCadastros.NATUREZA:</label>
                    <select class="form-control" id="iNatureza"></select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col mr-2">
                <div class="form-group">
                    <label for="iGrupoArea">@RsCadastros.GRUPO_AREA:</label>
                    <select class="form-control" id="iGrupoArea"></select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col mr-2">
                <div class="form-group">
                    <label for="iArea">@RsCadastros.AREA:</label>
                    <select class="form-control" id="iArea"></select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col mr-2">
                <div class="form-group">
                    <label for="iLocalidade">@RsCadastros.LOCALIDADE:</label>
                    <select class="form-control" id="iLocalidade"></select>
                </div>
            </div>
        </div>
            <div class="row">
                <div class="col ml-2 mr-2">
                    <div class="form-group">
                        <label for="iArea">@RsCadastros.PERIODO:</label>
                        <div class="row mr-2">
                            <div class="form-group form-inline align-horizontal" style="height:100%;">

                                <input type="text" class="form-control datepicker" placeholder="00/00/0000" id="iDataInicial" />
                                <span class="mr-2 ml-2">@RsBase.A</span>
                                <input type="text" class="form-control datepicker" placeholder="00/00/0000" id="iDataFinal" />

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col mr-2">
                    <div class="form-group">
                        <button type="button" class="btn btn-success" id="iPesquisar" style="margin-top: 15px;">@RsBase.FILTRAR</button>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col mr-2">
                    <div class="form-group">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal" style="margin-top: 15px;">@RsBase.LIMPAR_FILTRO</button>
                    </div>
                </div>
            </div>



    </div>
</div>

<div id="FiltrosUtilizados" class="mt-2 mr-2 ml-2">
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
    <div id="FiltrosUtilizados"></div>

</div>

