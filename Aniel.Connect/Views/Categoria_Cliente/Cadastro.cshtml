@model Aniel.Connect.Models.Categoria_ClienteCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_CATEGORIA_CLIENTE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script>

       AddSelect("iId_Cfop", "@CONSTANTES.URLPortal/api/cfopApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Cfop", "@RsBase.SELECIONE", false);
        $('#iId_Cfop').val(null).trigger("change")

        var clicked = false;
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

    </script>
}


@using (Html.BeginForm("Cadastro", "Categoria_Cliente", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-user"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Categoria_Cliente")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELCATEGORIA_CLIENTE</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        @*<span style="font-size:11px" id="dtLegend"></span>*@
                    </div>
                </div>

                <div class="card div-card-accord">
                    <div class="title-card" id="heading-1">

                    </div>
                    <div class="card-body body-card-accord">

                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iDescricao">@RsCadastros.DESCRICAO:</label>
                                    @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off", @required = true })
                                    @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="iTipo_Prioridade"><span class="text-danger">*</span> @RsCadastros.TIPO_PRIORIDADE</label>
                                    @Html.EnumDropDownListFor(m => m.Tipo_Prioridade, RsBase.SELECIONE, new { @class = "form-control", @id = "iTipo_Prioridade", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Tipo_Prioridade, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group" id="cfop">
                                    <label for="iId_Cfop">@RsConfiguracao.CFOP:</label>
                                    @Html.DropDownListFor(p => p.Id_Cfop, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iId_Cfop", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Id_Cfop, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iIntegracaoTipoCliente">@RsBase.CODIGO_TIPO_CLIENTE_INTEGRACAO</label>
                                    @Html.TextBoxFor(m => m.CodigoTipoClienteIntegracao, new { @class = "form-control", @id = "iIntegracaoTipoCliente", @autocomplete = "off" })
                                </div>
                            </div>
                            @if (Model.Id != 0)
                            {
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iStatus">@RsFinanceiro.STATUS:</label><br />
                                        @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = RsBase.ATIVAR, @data_off = RsBase.INATIVAR, @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Categoria_Cliente")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}