@model Aniel.Connect.Models.Ponto_PartidaCadastroModel

@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models
@using Aniel.Connect.Model.enumerado

@{
    ViewBag.Title = RsCadastros.CADASTRO_PONTO_PARTIDA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles {
    <style>
        #map {
            height: 400px;
            width: 100%;
        }

        #ElementoRede {
            height: 30px;
            width: 60%;
        }

        .paginate_button {
            z-index: 1 !important;
        }
    </style>
}


@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples");
    <script src="https://maps.googleapis.com/maps/api/js?key=@CONSTANTES.TokenGoogleAPI&callback=initMap&libraries=places,geometry" async defer>
    </script>
    <script>
        var marcadorAutoComplete;
        var cep_on_focus;
        reloadData("@(CONSTANTES.URLPortal + "/api/equipeapi/buscaEquipe")", "iIdEquipe", "iEquipe");
        somenteNumerosTraco("iCEP");


        var ufs = @(Html.GetArrayEnum<UF>());

        var handleDataTableButtons = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Equipes));

            var nome_lista = "Equipes";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                paging: false,
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            return '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir="' + row.Id +'"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id_Meio" name="' + nome_lista + '[' + meta.row + '].Id_Equipe" type="hidden" value="' + TrataNulo(row.Id_Equipe) + '">';
                        }
                    },
                    {
                        data: "Descricao",
                        title: "@RsCadastros.EQUIPE",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Descricao" name="' + nome_lista + '[' + meta.row + '].Descricao" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    }
                ]
            });

            function handleExcluir() {
                $(".btnExcluir").unbind('click');
                $(".btnExcluir").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatable.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Equipeapi/ExcluirGrid?value=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatable.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });
            }




            handleExcluir();

            $("#btnAdicionar").on('click', function () {

                var erro = false;
                if (!$("#iIdEquipe").val() || $("#iIdEquipe").val() == 0) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.EQUIPE)", "warning");
                    erro = true;
                }

                for (var i = 0; i < oDatatable.rows().data().length; i++) {

                    if (oDatatable.rows().data()[i].Id_Equipe == $("#Id_Equipe").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.EQUIPE)", "warning");
                        erro = true;
                        i = oDatatable.rows().data().length;
                    }

                }

                if (erro) {
                    return false;
                }

                oDatatable.row.add({
                    Id_Equipe: $("#iIdEquipe").val(),
                    Descricao: $("#iEquipe").val(),
                    Id: 0
                }).draw(false);

                $("#iIdEquipe").val("");
                $("#iEquipe").val("");

                handleExcluir();
            });


        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();


    $(document).ready(function () {


        var objLista = "Endereco";

        var id_cidade_inicial = @( Model.Id_Cidade ?? 0 );
        var id_bairro_inicial = @( Model.Id_Bairro ?? 0 );

        if ($("#iUF").val())
        {
            var enderecoApiCidade = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + $("#iUF" + " option:selected").text();

            $('#iCidade').empty();
            $('#iBairro').empty();

            $.post(enderecoApiCidade, function (data) {
                $('#iCidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                $.each(data, function (key, value) {
                    $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao.toUpperCase()));
                })

                if (id_cidade_inicial) {

                    $("#iCidade").val(id_cidade_inicial);

                    AddSelect("iBairro", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboBairros", @CONSTANTES.PaginacaoRegistros, null, id_cidade_inicial, id_bairro_inicial, "@RsBase.SELECIONE", false);

                }
            });
        }

        if ($("#iBairro").val())
        {
            var enderecoApiCidade = $("#iUF" + " option:selected").text();


        }

    });

    function GetEndereco(tipoEndereco) {

        var endereco = "";

        if ($("#iLogradouro").val())
            endereco += " " + $("#iLogradouro").val();
        else {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LOGRADOURO)", "warning");
            return false;
        }

        if ($("#iNumero").val())
            endereco += " " + $("#iNumero").val();
        if ($("#iBairro").val())
            endereco += " " + $("#iBairro option:selected").text();
        if ($("#iCidade").val())
            endereco += " " + $("#iCidade" + " option:selected").text();
        if ($("#iUF").val())

        return endereco;
    }

    $("#iNumero").focusout(function () {

        /**/
        if ($('#iLogradouro').val()) {
            var link = 'https://maps.googleapis.com/maps/api/geocode/json?key=@CONSTANTES.TokenGoogleAPI&address=';

            link = link.concat(GetEndereco());
            /**/

            $.ajax({
                url: link,
                type: 'GET',
                dataType: 'json'
            })
                .done(function (data) {
                    $("#iLatitude").val(data.results[0].geometry.location.lat);
                    $("#iLongitude").val(data.results[0].geometry.location.lng);
                })
                .fail(function (e) {
                    console.error(e);
                })
                .always(function () {

                });
        }
    });

    $('#iUF').change(function () {

        var estado = $('#iUF' + ' option:selected').text();
        var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

        $('#iCidade').empty();

        $.post(enderecoApi, function (data) {
            $('#iCidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
            $.each(data, function (key, value) {
                $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
            })

        });
    });

    $('#iCidade').change(function () {

        var cidade = $('#iCidade' + ' option:selected').val();
       AddSelect("iBairro", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboBairros", @CONSTANTES.PaginacaoRegistros, null, cidade, null, "@RsBase.SELECIONE", false);

        $('#iDesc_Cidade').val($('#iCidade' + ' option:selected').text());

        $('#iBairro').empty();


    });

    $('#iBairro').change(function () {

        $('#iDesc_Bairro').val($('#iBairro' + ' option:selected').text());
    });


    $("#iCEP").focus(function(){
        cep_on_focus =  $("#iCEP").val();
    });

    $("#iCEP").focusout(function () {

        if ($("#iCEP").val() != cep_on_focus) {
            $('#iReferencia').val("");
            $('#iUF').val("");
            $('#iCidade').val("");
            $('#iBairro').val("");
            $('#iTipo_Imovel').val("");
            $('#iPais').val("");
            $('#iComplemento').val("");
            $('#iBairro').empty();
            $('#iLatitude').val("");
            $('#iLongitude').val("");
            $('#iNumero').val("");
            $('#iLogradouro').val("");
            $('#iLongitude').val("");
            $('#iLongitude').val("");
        }
        var cepcliente = $("#iCEP").val();

        var link = "https://viacep.com.br/ws/";
        link = link.concat(cepcliente);
        link = link.concat("/json/");

        try {
            parent.App.startPageLoading();
        }
        catch (ex) { console.log(ex); }

        $.ajax({
            url: link,
            type: 'GET',
            dataType: 'json'

        })
            .done(function (data) {
                $("#iLogradouro").val(data.logradouro);
                $("#iUF").val(ufs.indexOf(data.uf));
                var cidade = data.localidade;
                var bairro = data.bairro;

                var estado = $('#iUF' + ' option:selected').text();
                var enderecoApiCidade = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

                $('#iCidade').empty();
                $('#iBairro').empty();

                $.post(enderecoApiCidade, function (data) {
                    $('#iCidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                    $.each(data, function (key, value) {
                        $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao.toUpperCase()));
                    })

                    if (cidade) {

                        $("#iCidade").val($("#iCidade option").filter(function () {
                            return $(this).text() === cidade.toUpperCase();
                        }).val());

                        if($('#iCidade').val() === '')
                        $("#iCidade").val($('option:contains("' + cidade.toUpperCase() + '")').val());

                        var enderecoApiBairro = "@CONSTANTES.URLPortal/api/enderecoapi/GetBairroByDesc?idCidade=" + $("#iCidade").val() + "&nomeBairro=" + bairro;

                         function funcaoapi(data) {
                           AddSelect("iBairro", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboBairros", @CONSTANTES.PaginacaoRegistros, null, null, data.objeto, "@RsBase.SELECIONE", false);
                        }

                        $.getJSON(enderecoApiBairro, funcaoapi);






                    }
                });

                $("#iNumero").focus();
            })
            .fail(function () {
                console.log("error");
            })
            .always(function () {
                try {
                    parent.App.stopPageLoading();
                }
                catch (ex) { console.log(ex); }

            });

    });


        function ExibeMapa(tipoEndereco) {

            if (!$("#iLogradouro").val()) {
                Notificar("Atenção!", "@String.Format(RsBase.REQUIRED, RsCadastros.LOGRADOURO)", "warning");
                return false;
            }


            var endereco = GetEndereco();

            ShowDialog(true, true, 'Mapa', '@Url.Action("Endereco", "Mapa")' + '?Endereco=' + endereco, 'mapa', 800, 500, 'iframeMapa');
            return false;
        }

        async function PesquisaMapaEndereco() {
            try {

                let pesquisa = $("#iPesquisaMap").val();
                var service = new google.maps.places.PlacesService(map);

                var request = {
                    query: pesquisa,
                    fields: ['name', 'geometry'],
                };

                service.findPlaceFromQuery(request, function (results, status) {


                    if (marcadorAutoComplete) {
                        marcadorAutoComplete.setMap(null);
                        $('#iConfirmarLocalizacao').hide();
                    }

                    if (status === google.maps.places.PlacesServiceStatus.OK) {

                        if (results.length > 0) {

                            let latlng = {
                                lat: results[0].geometry.location.lat(),
                                lng: results[0].geometry.location.lng()
                            };

                            marcadorAutoComplete = new google.maps.Marker({
                                position: latlng,
                                map: map,
                                draggable: true,
                                title: "Resultado da Busca"
                            });

                            marcadorAutoComplete.addListener('dragend', handleDragEnd);
                            $('#iConfirmarLocalizacao').show();


                            map.setCenter(results[0].geometry.location);
                        }
                    } else if (status === google.maps.places.PlacesServiceStatus.ZERO_RESULTS) {
                        Notificar("@RsBase.ATENCAO_", "Nenhum resultado foi encontrado para a solicitação. Por favor, verifique a localização.", "warning");
                    } else if (status === google.maps.places.PlacesServiceStatus.UNKNOWN_ERROR) {
                        Notificar("@RsBase.ATENCAO_", "Não foi possível processar a solicitação. Tente novamente mais tarde!", "warning");
                    } else if (status === google.maps.places.PlacesServiceStatus.NOT_FOUND) {
                        Notificar("@RsBase.ATENCAO_", "O lugar referenciado não foi encontrado! Por favor, verifique a localização.", "warning");
                    }
                });

            }
            catch (e) { console.log(e) }
        }


    async function PesquisaMapaLatitudeLongitude() {
        try {
            let latlng = {
                lat: parseFloat($('#iLatitudeMap').val().replace(",", ".")),
                lng: parseFloat($('#iLongitudeMap').val().replace(",", "."))
            };

            if (marcadorAutoComplete) {
                marcadorAutoComplete.setMap(null);
                $('#iConfirmarLocalizacao').hide();
            }

            const geocoder = new google.maps.Geocoder();
            geocoder
                .geocode({ location: latlng })
                .then(async (response) => {
                    if (response.results[0]) {
                        map.setZoom(15);

                        marcadorAutoComplete = new google.maps.Marker({
                            position: latlng,
                            map: map,
                            draggable: true,
                            title: "Resultado da Busca"
                        });
                        marcadorAutoComplete.addListener('dragend', handleDragEnd);
                        $('#iConfirmarLocalizacao').show();
                        map.setCenter(latlng);
                    }
                    else {
                        window.alert("No results found");
                    }
                })

        }
        catch (e) { console.log(e) }
    }


        async function initMap() {
            /*Hide transit and poi*/
            var myStyles = [
                {
                    featureType: "poi",
                    elementType: "labels",
                    stylers: [
                        { visibility: "off" }
                    ]
                },
                {
                    featureType: "transit",
                    elementType: "labels",
                    stylers: [
                        { visibility: "off" }
                    ]
                }
            ];

            map = new google.maps.Map(document.getElementById("map"), {
                center: { lat: -22.8690004, lng: -43.4790957 },
                zoom: 15,
                styles: myStyles,
                disableDefaultUI: false,
            });

            $('#iConfirmarLocalizacao').hide();
            $('#iLatitudeMap').val("");
            $('#iLongitudeMap').val("");
            $('#iPesquisaMap').val("");
            getLocation();
        }

        $('input[type=radio][name=buscarEndereco]').change(function () {
            if (this.value == 'endereco') {
                $('#iBuscarEnderecoInput').show();
                $('#iBuscarLatitudeLongitudeInput').hide();
            }
            else if (this.value == 'latitudeLongitude') {
                $('#iBuscarLatitudeLongitudeInput').show();
                $('#iBuscarEnderecoInput').hide();
            }
        });

        function getLocation() {
            if ($('#iLatitude').val() && $('#iLongitude').val()) {
                let latlng = { lat: parseFloat($('#iLatitude').val().replace(",", ".")), lng: parseFloat($('#iLongitude').val().replace(",", ".")) };
                map.setCenter(latlng);

                marcadorAutoComplete = new google.maps.Marker({
                    position: latlng,
                    map: map,
                    draggable: true,
                    title: "Resultado da Busca"
                });

                marcadorAutoComplete.addListener('dragend', handleDragEnd);

            }
            else {
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(showPosition);
                } else {
                    Notificar("@RsBase.ATENCAO_", "A geolocalização não é suportada por este navegador", "warning");
                }
            }
        }

        function handleDragEnd(event) {
            if ($('input[name=buscarEndereco]:checked').val() == "latitudeLongitude") {
                $('#iLatitudeMap').val(marcadorAutoComplete.position.lat())
                $('#iLongitudeMap').val(marcadorAutoComplete.position.lng())
            }
            $('#iConfirmarLocalizacao').show();
        }

        $('#iConfirmarLocalizacao').click(function () {
            $('#iConfirmarLocalizacao').hide(); let latlng = null;
            if ($('input[name=buscarEndereco]:checked').val() == "endereco") {
                $('#iLatitude').val(marcadorAutoComplete.position.lat())
                $('#iLongitude').val(marcadorAutoComplete.position.lng())

                latlng = {
                    lat: marcadorAutoComplete.position.lat(),
                    lng: marcadorAutoComplete.position.lng()
                };
            } else if ($('input[name=buscarEndereco]:checked').val() == "latitudeLongitude") {
                latlng = {
                    lat: parseFloat($('#iLatitudeMap').val().replace(",", ".")),
                    lng: parseFloat($('#iLongitudeMap').val().replace(",", "."))
                };

                $('#iLongitude').val($('#iLongitudeMap').val());
                $('#iLatitude').val($('#iLatitudeMap').val());
            }
            const geocoder = new google.maps.Geocoder(); geocoder
                .geocode({ location: latlng })
                .then(async (response) => {
                    if (response.results[0]) {
                        map.setZoom(11);

                        marcadorAutoComplete = new google.maps.Marker({
                            position: latlng,
                            map: map,
                            draggable: true,
                            title: "Resultado da Busca"
                        });
                        marcadorAutoComplete.addListener('dragend', handleDragEnd);
                        $('#iConfirmarLocalizacao').show();
                        map.setCenter(latlng);

                        $('#iReferencia').val("");
                        $('#iUF').val("");
                        $('#iCidade').val("");
                        $('#iBairro').val("");
                        $('#iPais').val("");
                        $('#iComplemento').val("");
                        $('#iBairro').empty();
                        $('#iNumero').val("");
                        $('#iLogradouro').val("");

                        if (response.results[0].address_components.filter(p => p.types.contains("route")).length > 0) {
                            $('#iLogradouro').val(response.results[0].address_components.filter(p => p.types.contains("route"))[0].long_name);
                        }
                        if (response.results[0].address_components.filter(p => p.types.contains("street_number")).length > 0) {
                            $('#iNumero').val(response.results[0].address_components.filter(p => p.types.contains("street_number"))[0].long_name);
                        }
                        if (response.results[0].address_components.filter(p => p.types.contains("sublocality_level_1")).length > 0) {
                            $('#iBairro').val(response.results[0].address_components.filter(p => p.types.contains("sublocality_level_1"))[0].long_name);
                        }

                        if (response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_1")).length > 0) {
                            let uf = response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_1"))[0].short_name;
                            $("#iUF").val($('option:contains("' + uf + '")').val());
                        }
                        if (response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_2")).length > 0) {
                            let cidade = response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_2"))[0].long_name;
                            let uf = response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_1"))[0].short_name;
                            await AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades",@CONSTANTES.PaginacaoRegistros, null, uf, cidade, "@RsBase.SELECIONE", false);
                        }

                        if (response.results[0].address_components.filter(p => p.types.contains("sublocality_level_1")).length > 0) {
                            let bairro = response.results[0].address_components.filter(p => p.types.contains("sublocality_level_1"))[0].short_name;
                            AddSelect("iBairro", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboBairros", @CONSTANTES.PaginacaoRegistros, bairro, $('#iCidade').val(), bairro, "@RsBase.SELECIONE", false);
                        }

                        if (response.results[0].address_components.filter(p => p.types.contains("postal_code")).length > 0) {
                            $('#iCep').val(response.results[0].address_components.filter(p => p.types.contains("postal_code"))[0].long_name);
                        }

                        if (response.results[0].address_components.filter(p => p.types.contains("country")).length > 0) {
                            let pais = response.results[0].address_components.filter(p => p.types.contains("country"))[0].long_name;
                            await AddSelect("iPais", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboPaisDescricao",@CONSTANTES.PaginacaoRegistros, null, null, pais, "@RsBase.SELECIONE", false);
                        }

                    }
                    else {
                        window.alert("No results found");
                    }
                }),

                $('#modal-localizacao').modal('hide');
        });


        function showPosition(position) {
            let latlng = { lat: position.coords.latitude, lng: position.coords.longitude };
            map.setCenter(latlng);
        }

        const handleUf = function () {
            $("#iUf").on("select2:select select2:unselecting", function (e) {
                const ufSelecionado = e.params.data
                if (ufSelecionado) {
                    AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidadesDesc",@CONSTANTES.PaginacaoRegistros, null, ufSelecionado.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidadesDesc",@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                }
            })
        }



        var clicked = false;
    function ValidaSubmit()
    {
        if (clicked) {
            return false;
        }

        clicked = true;
        erro = false;

        if (!$("#iDescricao").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsCadastros.DESCRICAO)", "warning");
            erro = true;
        }


        if ( (!$("#iLatitude").val() && !$("#iLongitude").val()) && !$("#iLogradouro").val() )
        {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsCadastros.LOGRADOURO)", "warning");
            erro = true;
        }


	    if (erro) {
            clicked = false;
            return false;
        }

        ShowPageLoading();
        $('#form').submit();
	    return true;
    }


    </script>
}


@using (Html.BeginForm("Cadastro", "Ponto_Partida", FormMethod.Post, htmlAttributes: new { enctype = "multipart/form-data", @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    @*@Html.HiddenFor(model => model.Id_Endereco, new { @id = "idEnderecoCliente" })*@

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">

                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="icofont-racing-flag-alt"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Ponto_Partida")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_PONTO_PARTIDA</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>


                </div>





                <div id="divAlterarEndereco"></div>


                <div id="accordion">
                    <div class="card div-card-accord">
                        <div class="card-header title-card" id="heading-1">
                            <h5 class="mb-0">
                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                    <span class="text-bold-card">@RsCadastros.CADASTRO_PONTO_PARTIDA</span>
                                </a>
                            </h5>
                        </div>
                        <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                            <div class="card-body body-card-accord">


                                <div class="row">
                                    <div class="col-sm-3">
                                        <label for="iDescricao">@RsCadastros.DESCRICAO</label>
                                        @*@Html.TextBoxFor(model => model.Cep, new { @class = "form-control busca", @id = "iCEP", @autocomplete = "off", @placeholder = "Pesquisar" })*@
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off" })
                                        @*@Html.ValidationMessageFor(model => model.Cep, "", new { @class = "text-danger" })*@
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-3">
                                        <label for="iCEP">@RsCadastros.CEP</label>
                                        @*@Html.TextBoxFor(model => model.Cep, new { @class = "form-control busca", @id = "iCEP", @autocomplete = "off", @placeholder = "Pesquisar" })*@
                                        @Html.TextBoxFor(model => model.Cep, new { @class = "form-control", @id = "iCEP", @autocomplete = "off", @placeholder = "Pesquisar" })
                                        @*@Html.ValidationMessageFor(model => model.Cep, "", new { @class = "text-danger" })*@
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label for="iLograduro">@RsCadastros.LOGRADOURO:</label>
                                            @Html.TextBoxFor(model => model.Logradouro, new { @class = "form-control", @id = "iLogradouro", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.Logradouro, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-1">
                                        <div class="form-group">
                                            <label for="iNumero">@RsCadastros.NUMERO:</label>
                                            @Html.TextBoxFor(model => model.Numero, new { @class = "form-control", @id = "iNumero", @autocomplete = "off", @maxlength = "10" })
                                            @Html.ValidationMessageFor(model => model.Numero, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-1">
                                        <div class="form-group">
                                            <label for="iUF">@RsCadastros.UF:</label>
                                            @Html.EnumDropDownListFor(m => m.UF, RsBase.SELECIONE, new { @class = "form-control", @id = "iUF", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.UF, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iCidade">@RsCadastros.CIDADE:</label>
                                            @Html.HiddenFor(m => m.Cidade, new { @id = "iDesc_Cidade" })
                                            @Html.DropDownListFor(m => m.Id_Cidade, new SelectList(ViewBag.ComboTmp, "Id", "Descricao"), RsBase.SELECIONE, new { @class = "form-control", @id = "iCidade", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.Id_Cidade, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iBairro">@RsCadastros.BAIRRO:</label>
                                            @Html.HiddenFor(m => m.Bairro, new { @id = "iDesc_Bairro" })
                                            @* @Html.DropDownListFor(m => m.Id_Bairro, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iBairro", @autocomplete = "off" })*@
                                            @Html.DropDownListFor(m => m.Id_Bairro, new SelectList(ViewBag.ComboTmp, "Id", "Descricao"), RsBase.SELECIONE, new { @class = "form-control", @id = "iBairro", @autocomplete = "off" })
                                        </div>
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label for="iComplemento">@RsCadastros.COMPLEMENTO:</label>
                                            @Html.TextBoxFor(model => model.Complemento, new { @class = "form-control", @id = "iComplemento", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.Complemento, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iLatitude">@RsCadastros.LATITUDE:</label>
                                            @Html.TextBoxFor(model => model.Latitude, new { @class = "form-control readonly", @id = "iLatitude", @autocomplete = "off" })

                                            @Html.ValidationMessageFor(model => model.Latitude, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iLongitude">@RsCadastros.LONGITUDE:</label>
                                            @Html.TextBoxFor(model => model.Longitude, new { @class = "form-control readonly", @id = "iLongitude", @autocomplete = "off" })

                                            @Html.ValidationMessageFor(model => model.Longitude, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    
                                    @*<button type="button" class="btn btn-default btn-add mt-3" onclick="initMap();" data-toggle="modal" data-target="#modal-localizacao" title="@RsBase.FILTRO"><i class="fas fa-map-marker-alt" style="color: #999"></i></button>*@
                                    
                                    <div class="col-sm-1">
                                        <button type="button" id="iBtnAlert" class="btn btn-primary" data-toggle="modal" data-placement="top" title="Mapa" style="margin-top: 20px;"  data-target="#modal-localizacao"
                                                onclick="initMap();">
                                            <i class="fas fa-map-marker-alt mr-1"></i>@RsCadastros.BUSCAR_MAPA
                                        </button>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>



                </div>


                <div class="row">
                    <div id="accordion" class="col-sm-6">
                        <div class="card div-card-accord">
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body">



                                    <div class="row">
                                        <div class="col-sm-12">
                                            <label for="iVendedor">@RsCadastros.EQUIPE:</label>
                                            <div class="input-group">
                                                @Html.HiddenFor(model => model.Id_Equipe, new { @class = "form-control", @id = "iIdEquipe" })
                                                @Html.TextBoxFor(model => model.Desc_Equipe, new { @class = "form-control", @id = "iEquipe", @autocomplete = "off", @required = true })


                                                <div class="input-group-append">
                                                    <div class="input-group-text"><i class="fas fa-search"></i></div>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-sm-12 text-right mt-3">
                                            <input type="button" id="btnAdicionar" value="Adicionar" class="btn btn-success" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div id="accordion" class="col-sm-6">
                        <div class="card div-card-accord">
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body">

                                    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>

                                </div>

                            </div>
                        </div>

                    </div>
                </div>



                <!--Button Float-->
                <a href="@Url.Action("Index", "Ponto_Partida")" class="float-cancel" onclick="ShowPageLoading(); return true;">
                    <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                        <i class="fas fa-times fa-2x"></i>
                    </div>
                </a>

                <a href="#" class="float-save" onclick="return ValidaSubmit();">
                    <div id="btnSalvar" class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                        <i class="fas fa-save fa-2x"></i>
                    </div>
                </a>

            </div>

        </div>
    </div>
    <div id="mapa"></div>

}

@{ Html.RenderPartial("~/Views/Acompanhamento_Servico/BuscarGeolocalizacao.cshtml", new Aniel.Connect.Models.BuscarGeolocalizacaoModels()); }
