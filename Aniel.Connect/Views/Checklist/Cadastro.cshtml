        }
        else {
            $("#divRestricao").hide();
            $("#iRestricao").val("");
        }
    });

    let oDatatableAlternativas = null;

    oDatatableAlternativas = $("#datatableAlternativas").length && $("#datatableAlternativas").DataTable({
        dom: "Bfrti",
        language: traducaoDataTableSimples,
        drawCallback: function () {
            handleExcluirAlternativa();
        },
