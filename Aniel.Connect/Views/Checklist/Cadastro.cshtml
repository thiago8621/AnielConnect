        AddSelect("iMeioCaptacao", "@CONSTANTES.URLPortal/api/Meio_CaptacaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdMeioCaptacao", "@RsBase.SELECIONE", false);

        AddSelect("iUf", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUf", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdUf", "@RsBase.SELECIONE", false, handleUf);
        AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades", @CONSTANTES.PaginacaoRegistros, null, "@Model.IdUf", "@Model.IdCidade", "@RsBase.SELECIONE", @Html.Raw(Json.Encode(!Model.IdCidade.HasValue)));

        AddSelect("iCodct", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.CodCt", "@RsBase.SELECIONE", false);

    });

    @* Correção para o checkbox do bootstrap não ficar "achatado" ao trocar de tab no cadastro *@
    $('a[data-toggle="tab"]').on('shown.bs.tab', () => {
        $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle('destroy');
        $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle();
    });

        $("#iTipo").on("change", function () {
            if ($(this).val() == TIPO_CHECKLIST_SERVICO) {
                $("#divDadosServico").show();
                $("#divDadosQuestaoServico").show();

                $("#divDadosComercial").hide();
                $("#divDadosQuestaoComercial").hide();

                $("#divDadosQuestaoComercial input[type='text']").val("").trigger("change");
                $("#divDadosQuestaoComercial input[type='checkbox']").prop("checked", false).trigger("change");
                $("#divDadosQuestaoComercial select").val(null).trigger("change");

            @* Exibindo as colunas exclusivas das questões para checklists do tipo de serviço *@
                oDatatableQuestoes.column(COLUMN_RESTRICAO).visible(false);
                oDatatableQuestoes.column(COLUMN_EXIBIR_RVT).visible(true);

            @* Corrigindo a aparência das checkboxes *@
                $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle('destroy');
                $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle();
            }
            else if ($(this).val() == TIPO_CHECKLIST_COMERCIAL) {
                $("#divDadosServico").hide();
                $("#divDadosQuestaoServico").hide();

                $("#divDadosComercial").show();
                $("#divDadosQuestaoComercial").show();

                $("#divDadosQuestaoServico input[type='text']").val("").trigger("change");
                $("#divDadosQuestaoServico input[type='checkbox']").prop("checked", false).trigger("change");
                $("#divDadosQuestaoServico select").val(null).trigger("change");

            @* Exibindo as colunas exclusivas das questões para checklists do tipo comercial *@
                oDatatableQuestoes.column(COLUMN_RESTRICAO).visible(true);
                oDatatableQuestoes.column(COLUMN_EXIBIR_RVT).visible(false);

            @* Corrigindo a aparência das checkboxes *@
                $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle('destroy');
                $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle();
            }
        });

        var questoes = null;
        let oDatatableQuestoes = null;
        var tabela = null;

        var handleDataTableButtonsQuestoes = function () {
            "use strict";

            questoes = @Html.Raw(Json.Encode(Model.Questoes));
            var nomeRazorListaQuestoes = "Questoes";
            oDatatableQuestoes = $("#datatableQuestao").length && $("#datatableQuestao").DataTable({
