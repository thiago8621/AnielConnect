                            @* TODO: IMPLEMENTAR EDIÇÃO DE QUESTÃO *@
                            @*if (row.id != 0) {
                                    retorno = `${retorno} <a class="editarQuestao" href="#" type="hidden" id="${nomeRazorListaQuestoes}_${meta.row}_editarQuestao" editar="${row.Id}"><i class="fas fa-user-edit pr-1" style="font-size:16px"></i></a>`;
                                }*@

                            return retorno;
                        }
                    },
                    {
                        data: "Id",
                        title: "Id",
                        render: function (data, type, row, meta) {
                            return data + `<input id="${nomeRazorListaQuestoes}_${meta.row}__Id" name="${nomeRazorListaQuestoes}[${meta.row}].Id" type="hidden" value="${TrataNulo(row.Id)}" class="index-manager"/>`;
                        }
                    },
                    {
                        data: "Ordem",
                        title: "Ordem",
                        render: function (data, type, row, meta) {
                            return data + `<input id="${nomeRazorListaQuestoes}_${meta.row}__Ordem" name="${nomeRazorListaQuestoes}[${meta.row}].Ordem" type="hidden" value="${TrataNulo(row.Ordem)}" class="index-manager"/>`;
                        }
                    },
                    {
                        data: "Pergunta",
                        title: "Pergunta",
                        render: function (data, type, row, meta) {
                            return data + `<input id="${nomeRazorListaQuestoes}_${meta.row}__Pergunta" name="${nomeRazorListaQuestoes}[${meta.row}].Pergunta" type="hidden" value="${TrataNulo(row.Pergunta)}" class="index-manager"/>`;
                        }
                    },
                    {
                        data: "TipoQuestaoDescricao",
                        title: "Tipo de Questão",
                        render: function (data, type, row, meta) {
                            return data + `<input id="${nomeRazorListaQuestoes}_${meta.row}__TipoQuestao" name="${nomeRazorListaQuestoes}[${meta.row}].TipoQuestao" type="hidden" value="${TrataNulo(row.TipoQuestao)}" class="index-manager"/>`;
                        }
                    },
                    {
                        data: "RespostaObrigatoriaDescricao",
                        title: "Resposta Obrigatória",
                        render: function (data, type, row, meta) {
                            return data + `<input id="${nomeRazorListaQuestoes}_${meta.row}__RespostaObrigatoria" name="${nomeRazorListaQuestoes}[${meta.row}].RespostaObrigatoria" type="hidden" value="${TrataNulo(row.RespostaObrigatoria)}" class="index-manager"/>`;
                        }
                    },
                    {
                        data: "ExibirRVTDigitalDescricao",
                        title: "Exibir no RVT Digital",
                        render: function (data, type, row, meta) {
                            return data + `<input id="${nomeRazorListaQuestoes}_${meta.row}__ExibirRVTDigital" name="${nomeRazorListaQuestoes}[${meta.row}].ExibirRVTDigital" type="hidden" value="${TrataNulo(row.ExibirRVTDigital)}" class="index-manager"/>`;
                        }
                    },
                    {
                        data: "RestricaoDescricao",
                        title: "Restrição",
                        render: function (data, type, row, meta) {
                            return data + `<input id="${nomeRazorListaQuestoes}_${meta.row}__Restricao" name="${nomeRazorListaQuestoes}[${meta.row}].Restricao" type="hidden" value="${TrataNulo(row.Restricao)}" class="index-manager"/>`
                                + `<input id="${nomeRazorListaQuestoes}_${meta.row}__VinculaRestricao" name="${nomeRazorListaQuestoes}[${meta.row}].VinculaRestricao" type="hidden" value="${TrataNulo(row.VinculaRestricao)}" class="index-manager"/>`;
                        }
                    },
                    {
                        data: "LiberarGaleriaDescricao",
                        title: "Liberar Galeria",
                        render: function (data, type, row, meta) {
                            return data + `<input id="${nomeRazorListaQuestoes}_${meta.row}__LiberarGaleria" name="${nomeRazorListaQuestoes}[${meta.row}].LiberarGaleria" type="hidden" value="${TrataNulo(row.LiberarGaleria)}" class="index-manager"/>`;
                        }
                    },                    
                    {
                        data: "DadosSISOPDescricao", 
                        title: "Dados SISOP",
                        render: function (data, type, row, meta) {
                            
                            return (data ?? "") + `<input id="${nomeRazorListaQuestoes}_${meta.row}__DadosSISOP" name="${nomeRazorListaQuestoes}[${meta.row}].DadosSISOP" type="hidden" value="${TrataNulo(row.DadosSISOP)}" class="index-manager"/>`;
                        }
                    },
                    {
                        title: "Alternativas Possíveis",
                        render: function (data, type, row, meta) {
                            let html = `<a class="exibirAlternativasQuestao" href="#" type="hidden" id="${nomeRazorListaQuestoes}_${meta.row}_exibirAlternativasQuestao" questao="${row.Id}" class="index-manager"><i class="fa fa-list pr-1" style="font-size:16px"></i></a>`

                            for (const alternativa of row.Alternativas) {
                                const idxAlternativa = row.Alternativas.indexOf(alternativa);
                                html = html + `<input id="${nomeRazorListaQuestoes}_${meta.row}_${idxAlternativa}__Id" name="${nomeRazorListaQuestoes}[${meta.row}].Alternativas[${idxAlternativa}].Id" type="hidden" value="${TrataNulo(alternativa.Id)}" class="index-manager"/>` +
                                    `<input id="${nomeRazorListaQuestoes}_${meta.row}_${idxAlternativa}__Resposta" name="${nomeRazorListaQuestoes}[${meta.row}].Alternativas[${idxAlternativa}].Resposta" type="hidden" value="${TrataNulo(alternativa.Resposta)}" class="index-manager"/>`;
                            }

                            return html;
                        }
                    }
                ]
            });

            function reindexarTabela() {
                const api = $("#datatableQuestao").DataTable();

                api.rows().every(function (rowIdx) {
                    let node = this.node();

                    // 1. Ajusta IDs e Names dos inputs da Questão e das Alternativas
                    $(node).find('input[name^="' + nomeRazorListaQuestoes + '"]').each(function () {
                        let oldName = $(this).attr('name');
                        let oldId = $(this).attr('id');

                        // Substitui o primeiro conjunto de colchetes/números pelo novo rowIdx
                        let newName = oldName.replace(/\[\d+\]/, '[' + rowIdx + ']');
                       
                        let newId = oldId.replace(/_\d+__/, '_' + rowIdx + '__')
                            .replace(/_\d+_\d+__/, '_' + rowIdx + '_');

                        $(this).attr('name', newName);
                        $(this).attr('id', newId);
                    });

                    // 2. Ajusta os IDs dos links (excluir/alternativas)
                    $(node).find('a[id^="' + nomeRazorListaQuestoes + '"]').each(function () {
                        let oldId = $(this).attr('id');
                        let newId = oldId.replace(/_\d+_/, '_' + rowIdx + '_');
                        $(this).attr('id', newId);
                    });
                });
            }

            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                if (e.target.id === 'questoes-tab') {
                    if ($.fn.DataTable.isDataTable('#datatableQuestao')) {
                        $('#datatableQuestao').DataTable().columns.adjust();
                    }
                }
            });

            async function handleExcluirQuestao() {
                $(document).off("click", ".excluirQuestao");
                $(document).on("click", ".excluirQuestao", async function () {
                    let idQuestao = Number($(this).attr("excluir"));
                    let trLinkButton = $(this).parents("tr");

                    if (idQuestao == 0) {
                        oDatatableQuestoes.row(trLinkButton).remove().draw(false);
                    }
                    else {
                        const retornoAPI = await $.ajax({
                            url: "@CONSTANTES.URLPortal/api/ChecklistApi/ExcluirQuestao",
                            type: "POST",
                            dataType: "json",
                            data: {
                                IdChecklist: $("#iCodigo").val(),
                                IdQuestao: idQuestao
                            },
                            beforeSend: function () {
                                $("#divProgress").show();
                            },
                            complete: function () {
                                $("#divProgress").hide();
                            }
                        });

                        if (retornoAPI.ok) {
                            oDatatableQuestoes.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "Questão removida com sucesso", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", "Erro ao remover a questão", "warning");
                        }
                    }
                });
            }

            handleExcluirQuestao();

            function handleEditarQuestao() {
                $(".editarQuestao").unbind("click");

                $(".editarQuestao").on("click", function () {
                    const trLinkButton = $(this).parents("tr");
                    const record = oDatatableQuestoes.row(trLinkButton).data();

            @* TODO: IMPLEMENTAR CARREGAMENTO DOS CAMPOS PARA EDIÇÃO APÓS IMPLEMENTAR A GRAVAÇÃO *@
                });
            }

            function handleExibirAlternativas() {
                $(".exibirAlternativasQuestao").unbind("click");

                $(".exibirAlternativasQuestao").on("click", function () {
                    const trLinkButton = $(this).parents("tr");
                    const record = oDatatableQuestoes.row(trLinkButton).data();

                    oDatatableAlternativasQuestao.clear();

                    if (record.Alternativas != null) {
                        for (let alternativa of record.Alternativas) {
                            oDatatableAlternativasQuestao.row.add(alternativa);
                        }
                    }

                    oDatatableAlternativasQuestao.draw();

                    $("#iModalAlternativasQuestao").modal("show");
                });
            }

            $("#iAdicionar").on("click", function () {
                const alternativas = oDatatableAlternativas.data().toArray();

                const respostaObrigatoria = $("#iRespostaObrigatoria").prop("checked");
                const liberarGaleria = $("#iLiberarGaleria").prop("checked");

                const exibirRvt = $("#iExibirRVT").prop("checked");
                const vinculaRestricao = $("#iVinculaRestricao").prop("checked");

                let erro = false;

                if (!$("#iOrdem").val()) {
                    Notificar("@RsBase.ATENCAO_", "Informe a ordem da questão", "warning");
                    erro = true;
                }
                else {
                    const questoes = oDatatableQuestoes.data().toArray();
                    const ordem = Number($("#iOrdem").val());

                    if (questoes.find(q => q.Ordem == ordem) != null) {
                        Notificar("@RsBase.ATENCAO_", "Já existe uma questão na posição de número " + ordem + " no checklist", "warning");
                        erro = true;
                    }
                }

                if (!$("#iTipoQuestao").val()) {
                    Notificar("@RsBase.ATENCAO_", "Informe o tipo de questão", "warning");
                    erro = true;
                }

                if (!$("#iPergunta").val()) {
                    Notificar("@RsBase.ATENCAO_", "Informe a pergunta", "warning");
                    erro = true;
                }

                if ($("#iTipo").val() == TIPO_CHECKLIST_COMERCIAL && vinculaRestricao && !$("#iRestricao").val()) {
                    Notificar("@RsBase.ATENCAO_", "Informe a restrição", "warning");
                    erro = true;
                }

                if (erro) {
                    return;
                }

                var record = {
                    Id: 0,
                    Ordem: Number($("#iOrdem").val()),
                    Pergunta: $("#iPergunta").val(),

                    TipoQuestaoDescricao: $("#iTipoQuestao option:selected").text(),
                    RespostaObrigatoriaDescricao: respostaObrigatoria ? "@RsBase.SIM" : "@RsBase.NAO",
                    LiberarGaleriaDescricao: liberarGaleria ? "@RsBase.SIM" : "@RsBase.NAO",

                    ExibirRVTDigitalDescricao: exibirRvt ? "@RsBase.SIM" : "@RsBase.NAO",

                    VinculaRestricaoDescricao: vinculaRestricao ? "@RsBase.SIM" : "@RsBase.NAO",
                    RestricaoDescricao: vinculaRestricao ? $("#iRestricao option:selected").text() : "",

                    TipoQuestao: $("#iTipoQuestao").val(),
                    RespostaObrigatoria: respostaObrigatoria,
                    LiberarGaleria: liberarGaleria,

                    ExibirRVTDigital: exibirRvt,

                    VinculaRestricao: vinculaRestricao,
                    Restricao: vinculaRestricao ? $("#iRestricao").val() : null,

                    Alternativas: alternativas,
                 
                    DadosSISOP: $("#iDadosSISOP").val() || null,
                    DadosSISOPDescricao: $("#iDadosSISOP").val() ? $("#iDadosSISOP option:selected").text() : "",

                };

                oDatatableQuestoes.row.add(record).draw(false);

                $("#iOrdem").val(Number($("#iOrdem").val()) + 1);
                $("#iPergunta").val("");
                $("#iTipoQuestao").val("");
                $("#iRestricao").val("");

                $("#iRespostaObrigatoria").prop("checked", false).trigger("change");
                $("#iLiberarGaleria").prop("checked", false).trigger("change");

                $("#iExibirRVT").prop("checked", false).trigger("change");
                $("#iVinculaRestricao").prop("checked", false).trigger("change");
                
                $("#iDadosSISOP").val(null).trigger("change");

                @* Limpando o datatable das alternativas para a questão *@
                oDatatableAlternativas.clear().draw();
            });

        },
            TableManageButtonsQuestoes = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtonsQuestoes();
                    }
                }
            }();

        TableManageButtonsQuestoes.init();

    $("#iTipoQuestao").on("change", function () {
        if ($("#iTipoQuestao").val()) {
            const tipoQuestao = Number($("#iTipoQuestao").val());

            if (tipoQuestao == TIPO_QUESTAO_UNICA_ESCOLHA || tipoQuestao == TIPO_QUESTAO_MULTIPLA_ESCOLHA) {
                $("#iAdicionarAlternativas").show();
            }
            else {
                $("#iAdicionarAlternativas").hide();
            }
        }
    });

    $("#iVinculaRestricao").on("change", function () {
        if ($(this).prop("checked")) {
