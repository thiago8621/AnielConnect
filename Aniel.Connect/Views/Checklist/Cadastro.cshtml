@model Aniel.Connect.Repository.Model.ChecklistCadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Aniel.T5.Model.enumerado

@{
    ViewBag.Title = RsCadastros.CADASTRO_CHECKLIST;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@{
    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @*@Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")*@
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />
    <style>
        #datatableQuestao {
            width: 100% !important;
            table-layout: auto !important;
        }
    </style>
}

@section scripts
{
    @*@Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")*@
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>
    <script>
    const TIPO_QUESTAO_TEXTO = @((int)EnumQuizTipo.Texto);
    const TIPO_QUESTAO_VALOR = @((int)EnumQuizTipo.Valor);
    const TIPO_QUESTAO_DATA = @((int)EnumQuizTipo.Data);
    const TIPO_QUESTAO_FOTO = @((int)EnumQuizTipo.Foto);
    const TIPO_QUESTAO_UNICA_ESCOLHA = @((int)EnumQuizTipo.UnicaEscolha);
    const TIPO_QUESTAO_MULTIPLA_ESCOLHA = @((int)EnumQuizTipo.MultiplaEscolha);
    const TIPO_QUESTAO_ASSINATURA = @((int)EnumQuizTipo.Assinatura);
    const TIPO_QUESTAO_CODIGO_BARRA = @((int)EnumQuizTipo.CodigoBarra);

    const TIPO_CHECKLIST_SERVICO = @((int)TipoChecklist.Servico);
    const TIPO_CHECKLIST_COMERCIAL = @((int)TipoChecklist.Comercial);

    @* Índice da coluna da restrição no datatable das questões *@
    const COLUMN_RESTRICAO = 7;

    @* Índice da coluna do exibir no rvt no datatable das questões *@
    const COLUMN_EXIBIR_RVT = 6;


    const handleUf = function () {
        let cidadeCarregada = false;

        $("#iUf").on("select2:select select2:unselecting", function (e) {
            const ufSelecionada = e.params.data;

            if (ufSelecionada) {
                if (!cidadeCarregada) {
                    AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades", @CONSTANTES.PaginacaoRegistros, null, ufSelecionada.id, "@Model.IdCidade", "@RsBase.SELECIONE", false);
                    cidadeCarregada = true;
                }
                else {
                    AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades",@CONSTANTES.PaginacaoRegistros, null, ufSelecionada.id, null, "@RsBase.SELECIONE", false);
                }
            }
            else {
                AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades",@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }
        });
    }

    $(document).ready(function () {
        @* Definindo o valor inicial do campo "Ordem" para o cadastro de novas questões *@
