    function handleExcluirAlternativa() {
        $(".excluirAlternativa").unbind("click");

        $(".excluirAlternativa").on("click", function () {
            let idAlternativa = Number($(this).attr("excluir"));
            let trLinkButton = $(this).parents("tr");

