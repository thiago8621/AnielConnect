                    this.api().columns.adjust();
                },
                paging: false,
                order: [[2, "asc"]],
                data: questoes,
                searching: false,
                ordering: false,
                deferRender: true,
                scrollResize: true,
                scrollY: '35vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                responsive: true, // habilita responsividade
                initComplete: function () {
                    dataTableInitComplete();
                    this.api().columns.adjust();
