        ordering: false,
        columns: [
            {
                title: "",
                render: function (data, type, row, meta) {
                    let retorno = `<a class="excluirAlternativa" href="#" type="hidden" id="${nomeRazorListaQuestoes}_${meta.row}_excluirAlternativa" excluir="${row.Id}"><i class="far fa-trash-alt" style="font-size:16px"></i></a>`;

                    return retorno;
                }
            },
            {
                data: "Resposta",
                title: "Resposta",
                render: function (data, type, row, meta) {
                    return data;
                }
