    @* Datatable para exibir as alternativas inseridas nas questões já adicionadas *@

    let oDatatableAlternativasQuestao = $("#datatableAlternativasQuestao").length && $("#datatableAlternativasQuestao").DataTable({
        dom: "Bfrti",
        language: traducaoDataTableSimples,
        paging: false,
        ordering: false,
        columns: [
            {
                data: "Resposta",
                title: "Resposta",
                render: function (data, type, row, meta) {
                    return data;
                }
            }
        ]
    });

    $("#iModalAlternativasQuestao").on("hidden.bs.modal", function () {
        oDatatableAlternativasQuestao.clear().draw();
    });

    let clicked = false;

        function ValidaSubmit() {
            let erro = false;

            if (clicked) {
                return;
            }

            clicked = true;

            if (!$("#iDescricao").val()) {
                Notificar("@RsBase.ATENCAO_", "Informe a descrição", "warning");
                erro = true;
            }

            if (!$("#iTipo").val()) {
                Notificar("@RsBase.ATENCAO_", "Informe o tipo do checklist", "warning");
                erro = true;
            }

            if (!erro) {
                ShowPageLoading();
                $("#form").submit();
                return;
            }

            clicked = false;
            return;
        }

    </script>
}

