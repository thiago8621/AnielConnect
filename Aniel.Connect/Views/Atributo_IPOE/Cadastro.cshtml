@model Aniel.Connect.Models.Atributo_IPOECadastroModel
@using Microsoft.AspNet.Identity
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado

@{
    ViewBag.Title = RsCadastros.CADASTRO_ATRIBUTO_IPOE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/maskip")
    <script>

        var clicked = false;

        $(document).ready(function () {

           

        });

        function ValidaSubmit() {

           


            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

    </script>
}


@using (Html.BeginForm("Cadastro", "Atributo_IPOE", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-headset"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GERENCIAMENTO_REDE</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Atributo_IPOE")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_ATRUBUTO_IPOE</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        @*<span style="font-size:11px" id="dtLegend"></span>*@
                    </div>
                </div>



                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@RsCadastros.CADASTRO</span>
                            </a>
                        </h5>
                    </div>

                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="row mt-2 mb-2">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iID" class="mr-3">@RsCadastros.ID:</label>
                                        @Html.TextBoxFor(model => model.Id, new { @class = "form-control", @id = "iID", @autocomplete = "off", @readonly = "readonly" })
                                        @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iNome" class="mr-3">@RsCadastros.NOME:</label>
                                        @Html.TextBoxFor(model => model.Nome, new { @class = "form-control", @id = "iNome", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Nome, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>


                            <div class="row mt-2 mb-2">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iLogin" class="mr-3">@RsCadastros.ATRIBUTO_AUTENTICACAO:</label>
                                        @Html.TextBoxFor(model => model.Atributo_Autenticacao, new { @class = "form-control", @id = "iAtributo_Autenticacao", @autocomplete = "off", @required = true })
                                        @Html.ValidationMessageFor(model => model.Atributo_Autenticacao, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iLogin" class="mr-3">@RsCadastros.ATRIBUTO_BLOQUEIO:</label>
                                        @Html.TextBoxFor(model => model.Atributo_Bloqueio, new { @class = "form-control", @id = "iAtributo_Bloqueio", @autocomplete = "off", @required = true })
                                        @Html.ValidationMessageFor(model => model.Atributo_Bloqueio, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iLogin" class="mr-3">@RsCadastros.ATRIBUTO_REDUCAO_VELOCIDADE:</label>
                                        @Html.TextBoxFor(model => model.Atributo_ReducaoVelocidade, new { @class = "form-control", @id = "iAtributo_ReducaoVelocidade", @autocomplete = "off", @required = true })
                                        @Html.ValidationMessageFor(model => model.Atributo_ReducaoVelocidade, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iLogin" class="mr-3">@RsCadastros.ATRIBUTO_RETORNO_VELOCIDADE_NORMAL:</label>
                                        @Html.TextBoxFor(model => model.Atributo_VelocidadeNormal, new { @class = "form-control", @id = "iAtributo_VelocidadeNormal", @autocomplete = "off", @required = true })
                                        @Html.ValidationMessageFor(model => model.Atributo_VelocidadeNormal, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Atributo_IPOE")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}