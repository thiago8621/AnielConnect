@model Aniel.Connect.Models.Atividade_StatusVendaCadastroModels

@using Aniel.Connect.Models
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.nhibernate

@{

    ViewBag.Title = RsCadastros.CADASTRO_STATUS_VENDA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

    @if (Model.Id == 0)
    {
        <text>
            <script>
                $("#iAtividade_StatusVenda").prop("checked", true).change();
                
            </script>
        </text>
    }




<script>
        function ocultarStatus() {
            $('#iStatusPadrao option[value=2]').remove();
            $('#iStatusPadrao option[value=3]').remove();
            $('#iStatusPadrao option[value=5]').remove();
        }

        ocultarStatus();

        function validaSubmit() {

            /*$("#iAtividade_StatusVenda").prop("checked", true).change();*/

            var erro = false;

            if (!$('#iDescricao').val())
            {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DESCRICAO)", "warning");
                erro = true;
            }

            if (!$('#iStatusPadrao').val())
            {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.STATUS_PADRAO)", "warning");
                erro = true;
            }

            if (erro) {

                return;
            }

            $('#form').submit();

        }

/**/</script>
}


@using (Html.BeginForm("Cadastro", "Atividade_StatusVenda", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class=""></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Atividade_StatusVenda")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTA_STATUS_VENDA</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>



                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">



                                <div class="col-sm-2">

                                    <div class="form-group">
                                        <label for="iDescricao">@RsCadastros.DESCRICAO:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off", @Maxlength = "100" })
                                    </div>

                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label for="iStatusPadrao">@RsCadastros.STATUS_PADRAO:</label>
                                        @Html.EnumDropDownListFor(m => m.StatusPadrao, @RsBase.SELECIONE, new { @class = "form-control", @id = "iStatusPadrao", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.StatusPadrao, "", new { @class = "text-danger" })
                                    </div>
                                </div>


                                <div class="col-sm-1 text-left">
                                    <div class="form-group d-none">
                                        <label for="iId">@RsCadastros.ID:</label>

                                        @Html.TextBoxFor(m => m.Id, new { @class = "form-control", @id = "iId", @name = " iId", @disabled = "true" })

                                    </div>
                                </div>
                                <div class="col text-right">
                                    <div class="form-group">
                                        <label for="iAtividade_StatusVenda">@RsCadastros.STATUS:</label><br>
                                        @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iAtividade_StatusVenda", @name = "iAtividade_StatusVenda", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Atividade_StatusVenda")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return validaSubmit();" name="gravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>
    </div>
}
