                            data = ' <input onclick="' + func + '" chave="' + meta.row + '" id="Campos_Cliente_' + meta.row + '__Bloqueado" name="Campos_Cliente[' + meta.row + '].Bloqueado" type="checkbox" ' + (data === true ? 'checked' : '') + ' value="' + data + '" />';
