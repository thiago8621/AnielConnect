                        if (type === 'display') {
                            let func = "return checkBloqueado('Campos_Atendimento_" + meta.row + "__Bloqueado', 'Campos_Atendimento_');";
                            data = ' <input onclick="' + func + '" chave="' + meta.row + '" id="Campos_Atendimento_' + meta.row + '__Bloqueado" name="Campos_Atendimento[' + meta.row + '].Bloqueado" type="checkbox" ' + (data === true ? 'checked' : '') + ' value="' + data + '" />';
