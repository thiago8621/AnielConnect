<script>

    function checkBloqueado(id, descricaoLista) {
        try {
            let checado = Boolean($("#" + id).is(":checked"));

            $("#" + id).val(checado);

            if (checado) {

                let idObrigatorio = `${descricaoLista}${$("#" + id).attr("chave")}__Obrigatorio`;

                if ($("#" + idObrigatorio).is(':checked')) {

                    $("#" + id).prop("checked", false);

                    throw '@RsCadastros.ERRO_DEFINICAO_BLOQUEADO';
                }
            }
        }
        catch (exception) {
            Notificar("@RsBase.ATENCAO_", exception, 'warning');
        }
    }

    function checkValue(id, descricaoLista) {
        try {
            let checado = Boolean($("#" + id).is(":checked"));
            if (checado) {

                let idBloqueado = `${descricaoLista}${$("#" + id).attr("chave")}__Bloqueado`;
                let bloqueadoChecado = Boolean($("#" + idBloqueado).is(":checked"));

                if (bloqueadoChecado) {

                    $("#" + id).prop("checked", false);

                    throw '@RsCadastros.ERRO_DEFINICAO_OBRIGATORIO';
                }
            }

            $("#" + id).val($("#" + id).is(":checked"));

        }
        catch (exception) {
            Notificar("@RsBase.ATENCAO_", exception, 'warning');
        }
    }

