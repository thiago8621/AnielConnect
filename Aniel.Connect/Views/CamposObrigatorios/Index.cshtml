@model Aniel.Connect.Models.CamposObrigatoriosListModel

@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Aniel.Connect.Models
@using Aniel.Connect.ControllersWebApi

@{
    ViewBag.Title = RsCadastros.CAMPOS_OBRIGATORIOS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<Aniel.Connect.Models.T5.AreaModuloModel> _areas = ViewBag.AreasAcesso;
    
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")

    <style>
        tr.even {
            background-color: #eef;
        }
    </style>
}
@section Variaveis{
    <script>
        @* Variáveis do Datatable *@
        let oDatatableCliente = null,
            oDatatableLead = null;

        let oDatatableVenda = null,
            oDatatableAtendimento = null,
            oDatatableDocumentoProducao = null;

        @* Dados carregados da controller *@
        let dados_Cliente = @Html.Raw(Json.Encode(Model.Campos_Cliente)),
            dados_Lead = @Html.Raw(Json.Encode(Model.Campos_Lead));

        let dados_Venda = @Html.Raw(Json.Encode(Model.Campos_Venda)),
            dados_Atendimento = @Html.Raw(Json.Encode(Model.Campos_Atendimento));

        let dados_Doc_Prod = @Html.Raw(Json.Encode(Model.Campos_Documento_Producao));

    </script>
}

@section  scripts
