                            return row.CampoString + ' <input id="Campos_Cliente_' + meta.row + '__id" name="Campos_Cliente[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '"/>' +
                                ' <input id="Campos_Cliente_' + meta.row + '__campo" name="Campos_Cliente[' + meta.row + '].Campo" type="hidden" value="' + TrataNulo(row.Campo) + '"/>';
