@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@using Aniel.Connect.CustomHtmlHelper
@model Aniel.Connect.Models.Bot_CustomizacaoModel
@{
    ViewBag.Title = RsCadastros.CONFIGURAWHATSAPP;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
}

@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

        var rows_selected = [];

        var handleDataTableButtons = function () {
            "use strict";

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[2, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '',
                    type: 'POST',
                    data: function (data) {

                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function (row, data, dataIndex) {
                    // Get row ID
                    var rowId = data.id;

                    // If row ID is in the list of selected row IDs
                    if ($.inArray(rowId, rows_selected) !== -1) {
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                    }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "statusApi", title: "@RsCadastros.STATUS_API" },
                    { data: "statusNumero", title: "@RsCadastros.STATUS_NUMERO" },
                    { data: "numero", title: "@RsCadastros.NUMERO" },
                    { data: "botVinculado", title: "@RsCadastros.BOT_VINCULADO" },
                    {
                        data: "acoes", title: "@RsCadastros.ACOES",
                        render: function (data, type, row, meta) {
                            return '<a href="#"><i class="fas fa-pencil-alt"></i></a>';
                        }
                    },
                    {
                        data: "detalhes", title: "@RsCadastros.DETALHES",
                        render: function (data, type, row, meta) {
                            return '<a href="#"><i class="far fa-file-search"></i></a>';
                        }
                    },

                ]
            });
        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

    </script>
}

@using (Html.BeginForm("Cadastro", "Integracao_Bot", FormMethod.Post, htmlAttributes: new { enctype = "multipart/form-data", @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"> @ViewBag.Title </h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Bot")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELBOT</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao_Bot",new { IdBot = Request.Params["IdBot"]})" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACAO_BOT</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>
                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <span class="text-bold-card pt-0">@ViewBag.Title</span>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">

                        <div class="card-body body-card-accord">

                            <div class="container">
                                <div class="row">
                                        <div class="form-group">
                                            <label for="iStatus" style="padding-right: 37px;" class="mr-3">@RsCadastros.NOME_ATENDENTE:</label><br>
                                            @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                </div>

                                <div class="row">
                                    <div class="form-group col-sm-4">
                                        <label for="iTipo" class="mr-3">@RsCadastros.ESCOLHER_EXIBICAO:</label><br>
                                        <p>Ou</p>
                                    </div>
                                </div>

                                <div id="divTable">
                                    <table class="table table-hover nowrap" id="datatable" style="width:100%">
                                    </table>
                                </div>

                            </div>
                        </div>


                        <!--Button Float-->
                        <a href="@Url.Action("Index", "Bot")" class="float-cancel" onclick="ShowPageLoading(); return true;">
                            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                                <i class="fas fa-times fa-2x"></i>
                            </div>
                        </a>

                        <a href="#" onclick="ValidaSubmit();" class="float-save" id="btnGravar">
                            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                                <i class="fas fa-save fa-2x"></i>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
