@model  Aniel.Connect.Models.CampanhaListaModel
@using Resources
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@{
    ViewBag.Title = RsCadastros.PAINEL_CAMPANHA;
    ViewBag.Sessao = RsCadastros.CAMPANHA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}
@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}

@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script>

  // Função Atua como trigger da procedure de ajuste do Campo E_Plano_Produto da Tabela TB_Campanha_Plano_Produto
  (async function CheckIsPlanoOrProduto() {
        $.get({
            url: `@CONSTANTES.URLPortal/api/Campanhaapi/ProcedureSetType`,
            datatype: 'json',
            type: 'GET'
        }).done(function (data) {
            data.objeto.forEach(function(param) {
                console.log(`registro Atualizado com Sucesso! \r\n Tipo:${param} `);
                return param;
            });

        });
    })();

        var rows_selected = [];

         // Função Atua como trigger da procedure de ajuste do Campo E_Plano_Produto da Tabela TB_Campanha_Plano_Produto
  (async function CheckIsPlanoOrProduto() {
        $.get({
            url: `@CONSTANTES.URLPortal/api/Campanhaapi/ProcedureSetType`,
            datatype: 'json',
            type: 'GET'
        }).done(function (data) {
            data.objeto.forEach(function(param) {
                console.log(`registro Atualizado com Sucesso! \r\n Tipo:${param} `);
                return param;
            });

        });
    })();

        var handleDataTableButtons = function () {
            "use strict";

            function AlterarStatusObj(Status) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/CampanhaApi/alterarstatus")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected,
                        status: Status
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();

                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    });

                rows_selected = [];
            }

            //"Blfrtip"

            //if ($("#datatable").length != null && $("#datatable").length < 1) {
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>"+"Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '73vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/Campanhaapi/GetAll',
                    type: 'POST',
                    data: function (data) {
                        let CampanhaTempoDeterminado = $("#iCampTempoDeterminado").val(),
                            EquipeVendas = $("#iEquipeVenda").val(),
                            Regioes = $("#iRegiao").val(),
                            AreaCobertura = $("#iAreaCobertura").val(),
                            DataInicial = $("#iDataIni").val(),
                            DataFinal = $("#iDataFim").val();

                        data.CampanhaTempoDeterminado = CampanhaTempoDeterminado ? !!Number(CampanhaTempoDeterminado) : null;
                        data.EquipeVendas = EquipeVendas ? !!Number(EquipeVendas) : null;
                        data.Regioes = Regioes ? !!Number(Regioes) : null;
                        data.AreaCobertura = AreaCobertura ? !!Number(AreaCobertura) : null;
                        data.DataInicial = DataInicial;
                        data.DataFinal = DataFinal;

                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "id", title: "@RsCadastros.CODIGO" },
                    { data: "titulo", title: "@RsCadastros.TITULO" },
                    { data: "camp_Tempo_Determinado", title: "@RsCadastros.CAMPANHA_TEMPO_DETERMINADO?" },
                    { data: "definir_Campanha_Regioes", title: "@RsCadastros.DEFINIR_CAMPANHA_REGIOES_ESPECIFICAS" },
                    { data: "definir_Area_Cobertura", title: "@RsCadastros.DEFINIR_CAMP_AREA_COBERTURA_ESPECIFICA?" },
                    { data: "data_Inicio", title: "@RsCadastros.DATAINICIAL" },
                    { data: "data_Final", title: "@RsCadastros.DATAFINAL" },
                    { data: "status", title: "@RsCadastros.STATUS" },

                    ]
                });

           $('#txtSearch').val(oDatatable.search());
           $('#txtSearch').keyup(function () {
               rows_selected = [];
               oDatatable.search($(this).val()).draw();

            });


            $("#btnInativar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);

            });

           $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });

            $("#iPesquisar").on("click", function () {
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
                $("#modal-filter").modal('hide');

                return true;
            });

           $("#btnExcluir").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/CampanhaApi/excluirlista")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();

                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });
            });

             // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function () {
                @if (AcessoHelper.TemAcesso(_areas, "11"))
                {
                    <text>
                    if (oDatatable.row(this).data() != null) {

                        var _id = oDatatable.row(this).data().id;

                        var url = '@Url.Action("Cadastro", "Campanha", new { id = "__id__" })';
                        window.location.href = url.replace('__id__', _id);
                        ShowPageLoading();
                    }
                    </text>
                }
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->
    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page"><i class="fas fa-bullhorn"></i> @ViewBag.Title</h4>
            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Comercial")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.COMERCIAL</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>
            <span style="font-size:11px;margin-left: 15px;" id="dtLegend"></span>
        </div>
        <div class="col-auto">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.TITULO" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
                @if (AcessoHelper.TemAcesso(_areas, "11"))
                {
                    <a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "Campanha")" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>
                }

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                </div>
            </div>
        </div>
    </div>
    <!--./main-->
    <!--MODAL DE FILTRO-->
    <div class="modal" id="modal-filter">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">

                    <div class="row">
                        <div class="col">
                            <div class="form-group">
                                <label for="iDataIni" class="fs-12">
                                    <b>@RsCadastros.DATAINICIAL:</b>
                                </label>
                                @Html.TextBox("DataInicial", null, new { @class = "form-control datepicker", @id = "iDataIni", @autocomplete = "off" })
                                <span class="ml-3 mr-3">até</span>

                                <label for="iDataFim" class="fs-12">
                                    <b>@RsCadastros.DATAFINAL:</b>
                                </label>
                                @Html.TextBox("DataFinal", null, new { @class = "form-control datepicker", @id = "iDataFim", @autocomplete = "off" })
                            </div>

                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label for="iCampTempoDeterminado" class="mr-3" style="font-size: 12px"><b>Tempo Determinado: </b></label><br>
                                <select name="CampanhaTempoDeterminado" id="iCampTempoDeterminado" class="form-control">
                                    <option value="">@RsBase.TODOS</option>
                                    <option value="0">@RsBase.NAO</option>
                                    <option value="1">@RsBase.SIM</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="form-group">
                                <label for="iEquipeVenda" class="mr-3" style="font-size: 12px"><b>Definido Por Equipe de Vendas: </b></label><br>
                                <select name="EquipeVendas" id="iEquipeVenda" class="form-control">
                                    <option value="">@RsBase.TODOS</option>
                                    <option value="0">@RsBase.NAO</option>
                                    <option value="1">@RsBase.SIM</option>
                                </select>
                            </div>
                        </div>
                    </div>


                    <div class="row mt-3">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label for="iRegiao" class="mr-3" style="font-size: 12px"><b>Definido Por Região: </b></label><br>
                                <select name="Regioes" id="iRegiao" class="form-control">
                                    <option value="">@RsBase.TODOS</option>
                                    <option value="0">@RsBase.NAO</option>
                                    <option value="1">@RsBase.SIM</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="form-group">
                                <label for="iAreaCobertura" class="mr-3" style="font-size: 12px"><b>Definido Por Área de Cobertura: </b></label><br>
                                <select name="AreaCobertura" id="iAreaCobertura" class="form-control">
                                    <option value="">@RsBase.TODOS</option>
                                    <option value="0">@RsBase.NAO</option>
                                    <option value="1">@RsBase.SIM</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    @*<div class="form-group">
                            <label for="iGrupoAreaFiltro">@RsCadastros.GRUPO_AREA:</label>
                            <select class="form-control filtro" id="iGrupoAreaFiltro"></select>
                        </div>*@
                </div>
                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal"> Limpar Campo</button>
                        <button type="button" class="btn btn-success" id="iPesquisar"> Filtrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>
