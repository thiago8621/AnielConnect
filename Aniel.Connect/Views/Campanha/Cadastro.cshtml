    /** @@param tabela {string}  @@param novoRegistro {object}
     */
    async function Consulta_dadosTabela(tabela, novoRegistro) {
        let ok = true;
        let dados = tabela.rows().data().toArray();


        for (let dado of dados) {
            //NovoRegistro
            if (dado.Id === 0) {
                if (JSON.stringify(dado) == JSON.stringify(novoRegistro)) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.REGISTRO_DUPLICIDADE", "warning");
                    ok = false;

                }

            }
            //RegistroGravado
            else {
                let cloneRegistro = JSON.parse(JSON.stringify(dado)),
                    cloneRegistroNovo = JSON.parse(JSON.stringify(novoRegistro));
                delete cloneRegistro.Id;
                delete cloneRegistroNovo.Id;

                if (JSON.stringify(cloneRegistro) == JSON.stringify(cloneRegistroNovo)) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.REGISTRO_DUPLICIDADE", "warning");
                    ok = false;
                }

            }

        }

        return ok;
    }

    $('#iPais').change(function () { changeCountry() });
    $('#iEstado').change(function () { mudancaUF() });

    function changeCountry() {
        let countryTxt = $('#iPais').text();
        let countryVal = $('#iPais').val();

        if (countryVal != null) {
            if (countryTxt.toUpperCase() == "BRASIL") {
           AddSelect("iEstado", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUf", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Estado", "@RsBase.TODOS", false);
            } else {
                $('#iEstado').val(null).trigger('change');
                $('#iEstado').text("").trigger('change');
                $('#iEstado').select2('destroy');
            };

        } else {
            $('#iEstado').val(null).trigger('change');
            $('#iEstado').text("").trigger('change');
            $('#iEstado').select2('destroy');
            $('#iEstado').append($('<option></option>').attr('value', "").text('@RsBase.TODOS'));
        };
    };



