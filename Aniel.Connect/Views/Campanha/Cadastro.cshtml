                    <div class="tab-pane fade show active" role="tabpanel" id="iDadosCampanha" aria-labelledby="iDadosCampanha-tab">
                        <div class="card div-card-accord mb-3">
                            <div class="card-header title-card" id="heading-1">
                                <h5 class="mb-0">
                                    <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                        <span class="text-bold-card">@ViewBag.Title</span>
                                    </a>
                                </h5>
                            </div>
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body body-card-accord">

                                    <div class="row">
                                        <div class="col-3">
                                            <div class="form-group">
                                                <label for="iTitulo">@RsCadastros.TITULO<label style="color:red">*</label>:</label>
                                                @Html.TextBoxFor(model => model.Titulo, new { @class = "form-control", @id = "iTitulo", @maxlength = "100", @autocomplete = "off" })
