@using (Html.BeginForm("Cadastro", "Campanha", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <!--main-->
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page">
                            <i class="fas fa-bullhorn"></i> @ViewBag.Title
                        </h4>
                        <nav class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Comercial")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.COMERCIAL</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Campanha")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_CAMPANHA</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <!--Nav Tab-->
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="iDadosCampanha-tab" data-toggle="tab" href="#iDadosCampanha" role="tab" aria-controls="iDadosCampanha" aria-selected="true"><i class="fas fa-bullhorn"></i> @RsCadastros.DADOS_CAMPANHA</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="iEquipeVendas-tab" data-toggle="tab" href="#iEquipeVendas" role="tab" aria-controls="iEquipeVendas" aria-selected="false"><i class="fas fa-users"></i> @RsCadastros.EQUIPE_VENDAS</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="iRegioes-tab" data-toggle="tab" href="#iRegioes" role="tab" aria-controls="iRegioes" aria-selected="false"><i class="far fa-address-card"></i> @RsCadastros.REGIOES</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="iAreaCobertura-tab" data-toggle="tab" href="#iAreaCobertura" role="tab" aria-controls="iAreaCobertura" aria-selected="false"><i class="fas fa-map-marked-alt"></i> @RsCadastros.AREA_COBERTURA</a>
                    </li>
                    <li class="nav-item">
