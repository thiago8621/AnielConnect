    async function adicionaEquipe() {
        let erro = false;
        let setor_departamento = $("#iSetor").val();
        let setor_departamento_Desc = $("#iSetor option:selected").text();
        let supervisor = $("#iSupervisor").val() ?? 0;
        let supervisor_Desc = $("#iSupervisor").prop("nome")?? null;
        let funcionario = $("#iFuncionario").val();
        let funcionario_Desc = $("#iFuncionario").prop("nome");
        let metas = $("#iMetaIndividual").val().replace(".", "");

        if (supervisor == null) {
            Notificar("@RsCadastros.SUPERVISOR", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
            erro = true;
        }
        if (metas == null) {
            Notificar("@RsCadastros.META", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
            erro = true;
        }
        if (!erro) {

            let equipeObj = {
                Id: 0,
                Setor_Departamento: setor_departamento,
                Setor_Departamento_Desc: setor_departamento_Desc,
                Id_Supervisor: supervisor,
                Id_Supervisor_Desc: supervisor_Desc,
                Id_Funcionario: funcionario,
                Id_Funcionario_Desc: funcionario_Desc,
                Meta: metas
            };
            let ok_consulta = await Consulta_dadosTabela(oDatatableEquipe, equipeObj);
            if (ok_consulta) {
                oDatatableEquipe.row.add(equipeObj).draw(false);
            }
        handleExcluirEquipe();
        }

    };

