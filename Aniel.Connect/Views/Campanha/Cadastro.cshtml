    function handleExcluirEquipe() {
        $(".btnExcluirEquipe").unbind('click');
        $(".btnExcluirEquipe").click(function (e) {
            e.preventDefault();

            var idArquivo = $(this).attr("excluir");

            var trLinkButton = $(this).parents('tr');

            if (idArquivo === "0") {
                oDatatableEquipe.row(trLinkButton).remove().draw(false);
                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
            }
            else {

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Campanhaapi/ExcluirGridEquipe?value=")' + idArquivo;

                $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',

                })
                    .done(function (data) {

                        if (data.ok) {
                            oDatatableEquipe.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    })
                    .fail(function () {

                    })
                    .always(function () {

                    });
            }

        });
    }
