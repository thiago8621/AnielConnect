    function FormataStringData(data) {
        var dia = data.split("/")[0];
        var mes = data.split("/")[1];
        var ano = data.split("/")[2];
        return ano + '-' + ("0" + mes).slice(-2) + '-' + ("0" + dia).slice(-2);

    }

    function validarDatas() {
        let execution = true;
        if ($("#iCampTempDeterminado").val()) {
            if (Date.parse(FormataStringData($("#iDataValidade").val())) != null) {

                if (Date.parse(FormataStringData($("#iDataInicio").val())) > Date.parse(FormataStringData($("#iDataFinal").val()))) {

                    Notificar("@RsBase.DATA_INVALIDA", "@RsCadastros.DATA_INICIAL_MAIOR", "warning");
                    execution = false;
                }
                if ($("#iValidadePlanoProduto").val() == 0 && (Date.parse(FormataStringData($("#iDataValidade").val())) < Date.parse(FormataStringData($("#iDataInicio").val())) || Date.parse(FormataStringData($("#iDataValidade").val())) > Date.parse(FormataStringData($("#iDataFinal").val())))) {

                    Notificar("@RsBase.DATA_INVALIDA", "@RsCadastros.DATA_VALIDADE_INVALIDA", "warning");
                    execution = false;
                }
            }
        }
        return execution;
    }

    async function adicionarPlanosProdutos() {


            const objBoolean = {
                DateValidate: validarDatas(),
                CamposPreenchidos: true,
            }

            if (($("#iPlano_Produto").val() == null) || ($("#iParcelasInstalacao").val() == "")) {
                //Notificar("@RsCadastros.PLANO_PRODUTO", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                objBoolean.CamposPreenchidos = false;
            };

            if (objBoolean.DateValidate && objBoolean.CamposPreenchidos) {

                let novo_nome_PP = $("#iNovoNomePlanoProduto").val(),
                    id_plano_produto = $("#iPlano_Produto").val(),
                    id_plano_produto_desc = $("#iPlano_Produto option:selected").text(),
                    valor_plano_produto = $("#iValorPlanoProduto").val(),
                    valor_instalacao = $("#iValorInstalacao").val(),
                    validade_plano_produto = $("#iValidadePlanoProduto").val(),
                    validade_plano_produto_desc = $("#iValidadePlanoProduto option:selected").text(),
                    data_validade = $("#iDataValidade").val(),
                    parcelaInstalacao = $("#iParcelasInstalacao").val();

                let ObjPlanosProdutos = {
                    Novo_Nome_Plano_Produto: novo_nome_PP,
                    Id_Plano_Produto: id_plano_produto,
                    Id_Plano_Produto_Desc: id_plano_produto_desc,
                    Valor_Plano_Produto: valor_plano_produto,
                    Valor_Instalacao: valor_instalacao,
                    Validade_Plano_Produto: validade_plano_produto,
                    Validade_Plano_Produto_Desc: validade_plano_produto_desc,
                    Data_Validade: data_validade,
                    Parcela_Instalacao: parcelaInstalacao,
                    Id: 0,


                };

                let ok_Consulta = await Consulta_dadosTabela(oDatatablePlanosProdutos, ObjPlanosProdutos);

                if (ok_Consulta) {

                    oDatatablePlanosProdutos.row.add(ObjPlanosProdutos).draw(false);
                }

                handleExcluirPlanosProdutos();
            }
            else {

                if (!objBoolean.CamposPreenchidos) { Notificar("@RsBase.ATENCAO_","@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS","warning"); }
            }
    };

