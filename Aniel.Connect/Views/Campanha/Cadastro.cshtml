                                                @Html.CheckBoxFor(m => m.Camp_Tempo_Determinado, new { @class = "form-control", @id = "iCampTempDeterminado", @name = "iCampTempDeterminado", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
