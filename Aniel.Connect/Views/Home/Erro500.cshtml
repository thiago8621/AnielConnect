@{
    ViewBag.Title = "Erro 500 - Erro de Comunicação com Servidor";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles {
    <link href="~/bin/Content/estiloerro.css" rel="stylesheet" />
}

<div id="notfound">
    <div class="notfound">
        <div class="notfound-404"></div>
        <h1>500</h1>
        <b>Ops...</b>
        <h2>Desculpe, mas a página que você tentou acessar apresentou problemas</h2>
        <p>Verifique se todos os dados estão preenchidos corretamente e tente novamente mais tarde.</p>
        <a href="javascript:window.history.back()">Voltar</a>
    </div>
</div>