@{
    ViewBag.Title = "Erro 404 - Página não encontrada";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles {
    <link href="~/bin/Content/estiloerro.css" rel="stylesheet" />
}

<div id="notfound">
    <div class="notfound">
        <div class="notfound-404"></div>
        <h1>404</h1>
        <b>@Request["url"]</b>
        <h2>Desculpe, mas a página que você está tentando acessar não existe</h2>
        <p>Verifique se o endereço que você digitou no navegador está correto.</p>
        <p>Caso seja o sistema quem tentou acessar esta página, por favor entre em contato com a equipe de suporte e informe que a página que ele está tentando mostrar está fora do ar.</p>
        <a href="javascript:window.history.back()">Voltar</a>
    </div>
</div>