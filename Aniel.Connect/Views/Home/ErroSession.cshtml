@{
    ViewBag.Title = "Sessão caiu";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles {
    <link href="~/bin/Content/estiloerro.css" rel="stylesheet" />
}

@Scripts.Render("~/bundles/jslayoutlimpo")

<script>
    $(document).ready(function () {
        try {
            setTimeout(function(){ parent.window.location = "@Url.Action("Login", "Account")"; }, 3000)
        }
        catch{
            setTimeout(function(){ window.location = "@Url.Action("Login", "Account")"; }, 3000)
        }
    });

</script>


<div id="notfound">
    <div class="notfound">
        <div class="notfound-404"></div>
        <h1>Sessão Caiu</h1>
        <h2>Desculpe, mas sua sessão caiu.</h2>
        <p>Faça o login novamente.</p>
    </div>
</div>