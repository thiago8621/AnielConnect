@model Aniel.Connect.Models.InterfaceRadioCadastroModel

@{
    /**/

    ViewBag.Title = RsCadastros.CADASTRO_INTERFACE_RADIO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script>

       


        AddSelect("iId_Ponto_Acesso", "@CONSTANTES.URLPortal/api/PontoAcessoRadioApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Ponto_Acesso_Radio", "@RsBase.SELECIONE", false);
      

        $('#iInterface').attr('readonly', true);

        var clicked = false;
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;

            let erro = false

             if (ValidaCamposObrigatorios(erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();

            parent.dial.dialog('close');
        }

    </script>
}

@using (Html.BeginForm("Cadastro", "InterfaceRadio", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)


    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label for="iId_Ponto_Acesso">Ponto Acesso Rádio</label>
                @Html.DropDownListFor(p => p.Id_Ponto_Acesso_Radio, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iId_Ponto_Acesso", @autocomplete = "off" })
            </div>
        </div>     
    </div>

    <div class="row">
        @if (Model.Id != 0)
        {
            <div class="col-sm-2">
                <div class="form-group">
                    <label for="iId">@RsCadastros.ID:</label>
                    @Html.TextBoxFor(m => m.Id, new { @class = "form-control", id = "iId", disabled = "disabled" })
                </div>
            </div>
        }     
        <div class="col-sm-4">
            <div class="form-group">
                <label for="iDescricao">@RsCadastros.DESCRICAO:</label>
                @Html.TextBoxFor(m => m.Descricao, new { @class = "form-control obrigatorio", @id = "iDescricao", @placeholder = "Informe a Descricao da Interface Rádio", @autocomplete = "off" })
            </div>
        </div>
        <div class="col-sm-4">
            <div class="form-group">
                <label for="iCodigo_Auxiliar" class="mr-3">@RsCadastros.CODIGO_AUXILIAR:</label>
                @Html.TextBoxFor(p => p.Codigo_Auxiliar, new { @class = "form-control obrigatorio", @style = "width:50%", @id = "iCodigo_Auxiliar", @autocomplete = "off", @type = "number" })
            </div>
        </div>
      
    </div>


    <!--Button Float-->
    <a class="float-cancel" onclick="parent.dial.dialog('close')">
        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
            <i class="fas fa-times fa-2x"></i>
        </div>
    </a>

    <a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
            <i class="fas fa-save fa-2x"></i>
        </div>
    </a>
}
