        </div>


        <!--Button Float-->
        <a href="@Url.Action("Index", "SLA_Atendimento")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
