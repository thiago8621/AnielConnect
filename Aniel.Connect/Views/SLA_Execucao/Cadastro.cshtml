                                            <div class="form-group" style="margin-right: -25px; margin-left: 25px;">
                                                @Html.TextBoxFor(m => m.Domingo_Entrada, new { @class = "form-control hora", @id = "iDomingo_Entrada", @placeholder = "00:00", @autocomplete = "off" })
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
