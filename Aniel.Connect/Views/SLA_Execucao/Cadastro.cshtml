@model Aniel.Connect.Models.SLA_ExecucaoCadastroModel

@{


    ViewBag.Title = RsCadastros.SLA_EXECUCAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
<script>
    reloadData("@(CONSTANTES.URLPortal + "/api/Tipo_AtendimentoApi/busca")", "id_Tipo_Atendimento", "iTipo_Atendimento_Desc");
    reloadData("@(CONSTANTES.URLPortal + "/api/Categoria_ClienteApi/busca")", "id_Categoria_Cliente", "iCategoria_Cliente_Desc");



    $("#iCalendario_Padrao").change(function () {

        if ($("#iCalendario_Padrao").is(':checked')) {
            $("#calendarioOpt").hide();
        }
        else {

            $("#calendarioOpt").show();
        }


    });

    $(".hora").mask("00:00");

    var calendario_padrao = false;
    @if (Model.Calendario_Padrao) {
       <text> calendario_padrao = true; </text>
    } else {
        <text> calendario_padrao = false; </text>
    }

    var clicked = false;
    function ValidaSubmit()
    {
        if (clicked) {
            return false;
        }

        clicked = true;
        

        var erro = false;

        var dias = ["Domingo", "Segunda", "Terca", "Quarta", "Quinta", "Sexta", "Sabado"];

        if (calendario_padrao == false) {

            for (var i = 0; i < dias.length; i++) {

                //if (($("#i" + dias[i] + "_Entrada") > 2359)) {
                if (($("#i" + dias[i] + "_Entrada") > 2359 || $("#i" + dias[i] + "_Entrada").val() == "" )) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.HORA_INVALIDA)", "warning");
                    erro = true;
                }

                if ($("#i" + dias[i] + "_Entrada").val()) {
                    if ($("#i" + dias[i] + "_Entrada").val().substr(3) > 59) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.HORA_INVALIDA)", "warning");
                        erro = true;
                    }
                }

                if (($("#i" + dias[i] + "_Saida").val()) > 2359) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.HORA_INVALIDA)", "warning");
                    erro = true;
                }

                if ($("#i" + dias[i] + "_Saida").val()) {
                    if ($("#i" + dias[i] + "_Saida").val().substr(3) > 59) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.HORA_INVALIDA)", "warning");
                        erro = true;
                    }
                }

                if (($("#i" + dias[i] + "_Saida").val() !== "") && ($("#i" + dias[i] + "_Entrada").val())) {
                    if ($("#i" + dias[i] + "_Saida").val() <= $("#i" + dias[i] + "_Entrada").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.HORA_INVALIDA)", "warning");
                        erro = true;
                    }
                }

            }

        }

        if (erro) {
            clicked = false;
            return false;
        }

        ShowPageLoading();
        $('#form').submit();

    }






       

    $(document).ready(function () {
        $("#iCalendario_Padrao").trigger('change');
    });

</script>
}


@using (Html.BeginForm("Cadastro", "SLA_Execucao", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-headset"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "SLA_Execucao" )" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELSLA_EXECUCAO</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>

                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <span class="text-bold-card">@ViewBag.Title</span>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">

                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iTipo_Atendimento_Desc">@RsCadastros.TIPO_ATENDIMENTO:</label>
                                        <div class="input-group">
                                            @Html.HiddenFor(m => m.Id_Tipo_Atendimento, new { @id = "id_Tipo_Atendimento" })
                                            @Html.TextBoxFor(m => m.Tipo_Atendimento_Desc, new { @class = "form-control", @id = "iTipo_Atendimento_Desc", @autocomplete = "off", @required = true, @placeholder = RsCadastros.TIPO_ATENDIMENTO })
                                            @Html.ValidationMessageFor(model => model.Tipo_Atendimento_Desc, "", new { @class = "text-danger" })
                                            <div class="input-group-append">
                                                <div class="input-group-text"><i class="fas fa-search"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iCategoria_Cliente_Desc">@RsCadastros.CATEGORIA_CLIENTE:</label>
                                        <div class="input-group">
                                            @Html.HiddenFor(m => m.Id_Categoria_Cliente, new { @id = "id_Categoria_Cliente" })
                                            @Html.TextBoxFor(m => m.Categoria_Cliente_Desc, new { @class = "form-control", @id = "iCategoria_Cliente_Desc", @autocomplete = "off", @required = true, @placeholder = RsCadastros.CATEGORIA_CLIENTE })
                                            @Html.ValidationMessageFor(model => model.Categoria_Cliente_Desc, "", new { @class = "text-danger" })
                                            <div class="input-group-append">
                                                <div class="input-group-text"><i class="fas fa-search"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iHoras">@RsCadastros.HORAS:</label>
                                        @Html.TextBoxFor(m => m.Horas, new { @class = "form-control", @id = "iHoras" })
                                        @Html.ValidationMessageFor(m => m.Horas, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iCalendario_Padrao">@RsCadastros.CALENDARIO_PADRAO</label>
                                        @Html.CheckBoxFor(m => m.Calendario_Padrao, new { @class = "form-control", @id = "iCalendario_Padrao", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>


        <div class="row m-3" id="calendarioOpt" style="display:none">
            <div id="accordion" class="col-sm-12 pl-1">
                <div class="card div-card-accord">
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body">

                            <div class="row">
                                <div class="" style="display: flex; margin-right: 40px">

                                    <!--Domingo-->
                                    <div class="row col-sm-2">
                                        <div class="col-sm-6">
