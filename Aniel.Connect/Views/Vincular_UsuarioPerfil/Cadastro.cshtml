@using (Html.BeginForm("Cadastro", "Vincular_UsuarioPerfil", FormMethod.Post, htmlAttributes: new { @id = "form", @autocomplete = "off", }))
{
    <div class="row d-flex justify-content-center" style="max-height: 400px; width: 100%; overflow-y: auto">

        <div class="col-10">
            <div class="form-group">
                <label for="iDescricao">@RsCadastros.USUARIO: </label>
                @Html.HiddenFor(model => model.Id, new { @class = "form-control", @id = "iIdUsuario" })
                @Html.DisplayFor(model => model.Usuario, new { @class = "form-control", @id = "iDescricao" })
            </div>

            <div class="form-group">
                <label for="iDepartamento">@RsCadastros.SETOR_DEPARTAMENTO</label>
                @Html.DropDownListFor(m => m.Id_Departamento, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control mb-3", @id = "iDepartamento", @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Id_Departamento, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <label for="iPerfil">@RsCadastros.PERFIL_DASHBOARD:</label>
                @Html.DropDownList("Id_Perfil", new SelectList(new List<object>()), RsBase.SELECIONE, new { @class = "form-control mb-3", @id = "iPerfil", @autocomplete = "off" })
            </div>
            <div class="col-sm">

            </div>
            <div class="form-group">
                <label for="iSecao">@RsCadastros.SECAO_CONNECT</label>
                @Html.DropDownListFor(m => m.SecaoConnect, new SelectList(ViewBag.Secao, "Id", "Descricao", Model.SecaoConnect), RsBase.SELECIONE, new { @class = "form-control mb-3 obrigatorioSecao", @id = "iSecao", @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Perfil, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <label for="iTipoUsuario">@RsCadastros.TIPO_USUARIO</label>
                @Html.DropDownListFor(m => m.TipoUsuario, new SelectList(ViewBag.Tipos, "Id", "Descricao", Model.TipoUsuario), RsBase.SELECIONE, new { @class = "form-control mb-3 obrigatorioTipo_Usuario", @id = "iTipoUsuario", @autocomplete = "off", @disabled = "true" })
                @Html.ValidationMessageFor(model => model.Perfil, "", new { @class = "text-danger" })
            </div>

            @*<div class="form-group perfil-agente" style="@(Model.SecaoConnect == "0" ? "" : "display:none")">*@
            <div class="form-group perfil-agente">
                @*@Html.Label(RsCadastros.PERFIL_AGENTE, new { @class = "perfil-agente", @style = Model.SecaoConnect == "0" ? "" : "display:none", @for = "iPerfilAgente" })*@
                @Html.Label(RsCadastros.PERFIL_AGENTE, new { @for = "iPerfilAgente", @class = "obrigatorioPerfil" })
                @*@Html.DropDownListFor(x => x.PerfilAgente, new SelectList(ViewBag.PerfilAgente, "Id", "Descricao", Model.PerfilAgente), RsBase.SELECIONE, new { @class = "form-control mb-3 ", @id = "iPerfilAgente", @autocomplete = "off" })*@
                @Html.DropDownListFor(model => model.PerfilAgente, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control mb-3", @id = "iPerfilAgente", @autocomplete = "off" })
                <div class='iTextoChat mt-1'><i class='fas fa-info-circle'></i> Defina um perfil para atender no Chat. Caso não seja selecionado o usuário não receberá solicitações de mensagens.</div>
                @Html.ValidationMessageFor(model => model.PerfilAgente, "", new { @class = "text-danger" })
                <div class="form-group">
                    <label for="iPerfilVisualizacaoServico">@RsCadastros.PERFIL_VISUALIZACAO_SERVICO</label>
                    @Html.DropDownListFor(m => m.IdPerfilVisualizacaoServico, new SelectList(new List<object>()), RsBase.SELECIONE, new { @class = "form-control mb-3", @id = "iPerfilVisualizacaoServico", @autocomplete = "off" })
                </div>
                

                @*<div class="row" style=" width: 100%; padding: 12px 20px; margin: 8px 0; box-sizing: border-box; /*border: 1px solid #555;*/ outline: none;">
                    <table class="table table-hover nowrap" id="datatable" ></table>
                </div>*@
            </div>



            <div class="form-group">
                <label for="iPerfilVisualizacaoVenda">@RsCadastros.PERFIL_VISUALIZACAO_VENDA</label>
                @Html.DropDownListFor(m => m.IdPerfilVisualizacaoVenda, new SelectList(new List<object>()), RsBase.SELECIONE, new { @class = "form-control mb-3", @id = "iPerfilVisualizacaoVenda", @autocomplete = "off" })
            </div>
            <div class="form-group">

                @* Checkbox para Bloquear Modelo de Visualização *@
                <div class="form-check">
                    @Html.CheckBoxFor(model => model.Bloqueia_Modelo_Visualizacao, new { @class = "form-check-input", @id = "iBloqueiaModeloVisualizacao" })
                    <label class="form-check-label" for="iBloqueiaModeloVisualizacao">
                        Bloquear Modelo Único de Visualização
                    </label>
                </div>
            </div>

            @* Container do DropDownList - Será manipulado pelo JavaScript *@

            <div class="form-group" id="divModeloUnico" style="display:none;">

                <label for="iModelo_Unico_Permitido_ID">Modelo Único Permitido</label>
                @Html.DropDownListFor(m => m.Modelo_Unico_Permitido_ID, new SelectList(new List<object>()), RsBase.SELECIONE, new { @class = "form-control mb-3", @id = "iModelo_Unico_Permitido_ID", @autocomplete = "off" })

            </div>
        </div>

        <div class="form-group col-sm-12" style="padding: 15px;">
            <div class="text-center">
                <button type="button" onclick="parent.dial.dialog('close'); return false;" class="btn btn-danger" id="iLimparFiltroModal">Cancelar</button>
                <button type="button" onclick="return ValidaSubmit(); return false;" class="btn btn-success" id="iPesquisar">Salvar</button>
            </div>
        </div>
    </div>


}



