@model  Aniel.Connect.Models.Cobranca_ServicoListaModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.LISTAGEM_CONFIGURACAO_ENVIO_MENSAGENS;
    ViewBag.Sessao = RsCadastros.COBRANCA_SERVICO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
    var StorageName = CONSTANTES.SIGLA_MODULO + " - " + ViewBag.Title + " - " + CONSTANTES.Versao;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
            margin-right: 25px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>

}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

    $('#modal-filter').on('show.bs.modal', function (event) {

        $(this).find('input:text').val('');
        $(this).find('input:checkbox').bootstrapToggle('off');
        $(this).find('select').val('').trigger('change');

    })

       $(document).ready(function () {
            AddSelect("iSegmento", "@CONSTANTES.URLPortal/api/ContratoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iTipo_Servico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboDescricao", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iCod_Encerramento", "@CONSTANTES.URLPortal/api/CodigoEncerramentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iPlano_Produto", "@CONSTANTES.URLPortal/api/clienteapi/GetComboClientePlanoProduto", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iSub_Tipo_Servico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        });

    var rows_selected = [];

     var handleDataTableButtons = function(){
    "use strict";

    function AlterarStatusObj(Status) {
        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Cobranca_ServicoApi/alterarstatus")';

        $.ajax({
            url: link,
            type: 'POST',
            dataType: 'json',
            data: {
                ids: rows_selected,
                status: Status
            }
        })
            .done(function (data) {

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    rows_selected = [];
                    oDatatable.draw();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });
    }

    //"Blfrtip"
   var oDatatable = $("#datatable").length && $("#datatable").DataTable({
       dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
        columnDefs: [{
                targets: 0,
                searchable: false,
                orderable: false,
                width: '1%',
                className: 'dt-body-center',
                render: function (data, type, full, meta) {
                    return "<input type='checkbox'></input>";
                }
            }
        ],
        select: 'multi',
        order: [[2, 'asc']],
        serverSide: true,
        searching: true,
        ordering: true,
        paging: true,
        deferRender: true,
        scrollResize: true,
        scrollY: '66vh',
        scroller: {
            loadingIndicator: true,
            rowHeight: 40,
            boundaryScale: 0.5,
            displayBuffer: 3
        },
        scrollX: true,
        fixedHeader: true,
        initComplete: dataTableInitComplete,
        lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
       pageLength: 10,
       stateSave: false,
        ajax: {
            url: baseUrl + '/api/Configuracao_Envio_MensagensApi/GetAll',
            type: 'POST',
            data: function (data) {
                window.localStorage.setItem(
                    "@Html.Raw(StorageName)",
                    JSON.stringify(
                        $('.filtro').toArray().map(p => ({
                            id: $(p).attr('id'),
                            value: $(p).val(),
                            checked: $(p).prop('checked')
                        }))
                    )
                );                
            },
            error: function (e) {
                console.log(e);
            },
            dataSrc: function (d) {
                return d.data;
            }
        },
        infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

            var str = "@RsCadastros.INFODATATABLE";
            if (iTotal == 0) { iEnd = 0; iStart = 0; }
            str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
            $("#dtLegend").html(str);

            return "";
        },
        rowCallback: function(row, data, dataIndex){
             // Get row ID
             var rowId = data.id;

             // If row ID is in the list of selected row IDs
             if($.inArray(rowId, rows_selected) !== -1){
                $(row).find('input[type="checkbox"]').prop('checked', true);
                $(row).addClass('selected');
             }
        },
        language: traducaoDataTable,
        buttons: buttonsDataTable,
        columns: [
            { title: "<input name='select_all' value='1' type='checkbox'>" },
            { data: "descricao", title: "@RsFinanceiro.DESCRICAO" },
            { data: "status", title: "@RsFinanceiro.STATUS" },
        ]
   });

    $('#txtSearch').val(oDatatable.search());
        $('#txtSearch').keyup(function () {
        console.log("Testando a pesquisa")
        rows_selected = [];
        oDatatable.search($(this).val()).draw();
    });

    $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {

        $("#iSegmento").val("").trigger("change");
        $("#iTipo_Servico").val("").trigger("change");
        $("#iCod_Encerramento").val("").trigger("change");
        $("#iPlano_Produto").val("").trigger("change");
        $("#iSub_Tipo_Servico").val("").trigger("change");
        $('#txtSearch').val('');
        rows_selected = [];
        oDatatable.search($('#txtSearch').val()).draw();

    });

     $("#iPesquisar").on("click", function () {
        if (ValidaCamposObrigatorios(false)) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
            return false;
        }
             $("#modal-filter").modal('hide');
             rows_selected = [];
             oDatatable.search($('#txtSearch').val()).draw();
            return true;
     });

    $("#btnInativar").on("click", function () {
        if (rows_selected.length == 0) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
            return;
        }

        //Alterando para Inativo
        AlterarStatusObj(0);

    });

    $("#btnAtivar").on("click", function () {
        if (rows_selected.length == 0) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
            return;
        }

        //Alterando para Inativo
        AlterarStatusObj(1);
    });


    $("#btnExcluir").on("click", function () {

        if (rows_selected.length == 0) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
            return;
        }

        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Cobranca_Servicoapi/excluirlista")';

        $.ajax({
            url: link,
            type: 'POST',
            dataType: 'json',
            data: {
                ids: rows_selected
            }
        })
            .done(function (data) {

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    rows_selected = [];
                    oDatatable.draw();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
        });
    });

    // Handle click on checkbox
    $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
        var $row = $(this).closest('tr');

        // Get row data
        var rowId = oDatatable.row($row).data().id;

        var index = $.inArray(rowId, rows_selected);

        // If checkbox is checked and row ID is not in list of selected row IDs
        if (this.checked && index === -1) {
            rows_selected.push(rowId);

            // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
        } else if (!this.checked && index !== -1) {
            rows_selected.splice(index, 1);
        }

        if (this.checked) {
            $row.addClass('selected');
        } else {
            $row.removeClass('selected');
        }

        // Prevent click event from propagating to parent
        e.stopPropagation();
    });


    $('#datatable tbody').on('click', 'tr', function () {
        if (oDatatable.row(this).data() != null) {

            var _id = oDatatable.row(this).data().id;

            var url = '@Url.Action("Cadastro", "Configuracao_Envio_Mensagens", new { id = "__id__" })';
            window.location.href = url.replace('__id__', _id);
            ShowPageLoading();
        }
    });

    // Handle click on table cells with checkboxes
    $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
        $(this).parent().find('input[type="checkbox"]').trigger('click');
    });

    // Handle click on "Select all" control
    $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
        if (this.checked) {
            $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
        } else {
            $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
        }

        // Prevent click event from propagating to parent
        e.stopPropagation();
    });

    // Handle table draw event
    oDatatable.on('draw', function () {
        // Update state of "Select all" control
        updateDataTableSelectAllCtrl(oDatatable);

    });

},
    TableManageButtons=function()
    {
        "use strict";
        return {init: function () {handleDataTableButtons();}}
    }();

TableManageButtons.init();

    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page"><i class="fas fa-list-ol"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                    </li>

                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>

                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">
                @if (AcessoHelper.TemAcesso(_areas, "230"))
                {
                    <a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "Configuracao_Envio_Mensagens")" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>
                }
                else
                {
                    <a class="btn btn-success btn-add" href="#" title="@RsBase.INCLUIR" onclick="Notificar('@RsBase.ATENCAO_', '@RsBase.NAO_POSSUI_AREA_ACESSO', 'warning'); return true;"><i class="la la-plus" style="color: #fff"></i></a>

                }
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.DESCRICAO" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>

                </div>
            </div>
        </div>

    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>

<!--Modal Filters-->
<div class="modal" id="modal-filter">
    <div class="modal-dialog" style="max-width:60%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTRO_COBRANCA_SERVICO</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">

                    <div class="col-sm-12" style="align-content:center;">

                        <div class="row mt-1">

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iSegmento">@RsCadastros.SEGMENTO:</label>
                                    @Html.DropDownList("Segmento", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iSegmento", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-4">

                                <div class="form-group">
                                    <label for="iTipoServico">@RsCadastros.TIPO_SERVICO:</label>
                                    @Html.DropDownList("Tipo_Servico", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iTipo_Servico", @autocomplete = "off" })
                                </div>

                            </div>

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label> @RsCadastros.SUBTIPO_SERVICO: </label>
                                    @Html.DropDownListFor(m => m.Sub_Tipo_Servico, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iSub_Tipo_Servico", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Sub_Tipo_Servico, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label> @RsCadastros.CODIGO_ENCERRAMENTO: </label>
                                    @Html.DropDownListFor(m => m.Cod_Encerramento, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iCod_Encerramento", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Cod_Encerramento, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label> @RsCadastros.PLANO_PRODUTO: </label>
                                    @Html.DropDownListFor(m => m.Plano_Produto, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iPlano_Produto", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Plano_Produto, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
            <div class="form-group col-sm-12" style="padding: 15px;">
                <div class="text-center">
                    <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                    <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                </div>
            </div>
        </div>
    </div><!-- /.modal-content -->
</div><!-- /.modal-dialog -->
