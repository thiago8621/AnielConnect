        let arquivos = [];

    $("#iSVG").on("change", function (e) {
        arquivos.push($("#iSVG")[0].files[0]);
        var documento = $("#iSVG").val();
        let docname = documento.substr(documento.lastIndexOf("\\") + 1).split('.')[0];
        let doctype = documento.substr(documento.lastIndexOf(".") + 1, documento.length).toUpperCase();

        if ($("#iSVG")[0].files.length > 0 && doctype !== "SVG") {
            Notificar("@RsBase.ATENCAO_", "A extensão do arquivo deve ser .svg!", "warning");
        }
        if (documento == "") {
            return false;
        }
        else {
            datatableIcone.row.add({
                Id: 0,
                Descricao: docname,
                Tipo: doctype
            });
            datatableIcone.draw(false);
        }
    });

