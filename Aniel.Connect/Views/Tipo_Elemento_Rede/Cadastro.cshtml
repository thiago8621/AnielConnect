        //    if (datatableIcone.data().length > 0 && !impo) {
        //        $("#iGravaIcone").trigger("click");
        //    }
        //});
    $("#iGravaIcone").on("click", async function () {
        form = new FormData();
        var path = [];
        var iconearray = [];

        var tamanho = datatableIcone.data().length;
        for (var i = 0; i < tamanho; i++)
            iconearray.push(datatableIcone.data()[i]);

        form.append("File_Json", JSON.stringify(iconearray));
        form.append("Path", JSON.stringify(path));
        for (var file of arquivos) {
            form.append("Posted_Arquivo_JSON", file);

            //text = await file.text();
            //var xml = new DOMParser().parseFromString(text,"image/svg+xml");
            //var caminhos = xml.getElementsByTagName("path");
            //for ( var caminho of caminhos) {
            //     path.push(caminho.getAttribute("d"));
            //}
        }

        $.ajax({
            url: '@Url.Action("Gravar_Icone", "Tipo_Elemento_Icone")',
            type: "POST",
            data: form,
            processData: false,
            contentType: false
        })
            .done(function (data) {

                data = JSON.parse(data);
                        if (data.Ok) {
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROADICIONADO", "info");

                            $("#modal-Icone").modal("hide");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.Mensagem, "warning");
                        }
                    })
    });

    $("#modal-Icone").on("hide.bs.modal", function () {
        datatableIcone.clear();
        datatableIcone.draw(false);
    });

</script>
