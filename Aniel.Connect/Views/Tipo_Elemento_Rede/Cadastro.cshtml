                    return `<a href="#" class="btnExcluirServico" id="btnExcluirServico_${meta.row}" excluir="${row.Id}">
                                <i class="far fa-trash-alt" style="font-size:16px"></i>
                            </a>
                            <input id="${nome_listaServicos}_${meta.row}__Id" name="${nome_listaServicos}[${meta.row}].Id type="hidden" value="${TrataNulo(data)}"
                            <input id="${nome_listaServicos}_${meta.row}__Codigo" name="${nome_listaServicos}[${meta.row}].Codigo type="hidden" value="${TrataNulo(row.Codigo)}"
                            <input id="${nome_listaServicos}_${meta.row}__UnidadeCusto" name="${nome_listaServicos}[${meta.row}].UnidadeCusto type="hidden" value="${TrataNulo(row.UnidadeCusto)}"`;
                }
            },
            {
                data: "UnidadeCusto",
                title: "@RsCadastros.UNIDADE_CUSTO",
                render: function (data, type, row, meta) {
                    return data;
                }

            },
            {
                data: "Codigo",
                title: "@RsCadastros.CODIGO",
                render: function (data, type, row, meta) {
                    return data;
                }

            },
            {
                data: "Descricao",
