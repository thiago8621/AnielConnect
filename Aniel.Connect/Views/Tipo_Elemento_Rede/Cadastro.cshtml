    });


    handleExcluirServico();
    handleExcluirMaterial();

    function ValidaSubmit() {
      if (clicked) {
            return false;
        }

        clicked = true;

        erro = false;

        if (ValidaCamposObrigatorios(erro)) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
            erro = true
        }

        if (erro) {
            clicked = false;
            return false;
        }

        ShowPageLoading();
        $('#form').submit();
        return true;
        }
