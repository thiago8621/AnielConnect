@model Aniel.Connect.Models.T5.Tipo_Elemento_RedeCadastroModel

@using Aniel.T5.Model.enumerado
@using Resources
@using Microsoft.AspNet.Identity;
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.CADASTRO_TIPOS_ELEMENTOS_REDE;

    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;



}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .none {
            display: none;
        }

        .dashed {
            border-bottom-style: dashed;
            border-bottom-width: 5px;
        }

        .dotted {
            border-bottom-style: dotted;
            border-bottom-width: 5px;
        }

        .solid {
            border-bottom-style: solid;
            border-bottom-width: 5px;
        }

        .ridge {
            border-bottom-style: ridge;
            border-bottom-width: 5px;
        }

        .groove {
            border-bottom-style: groove;
            border-bottom-width: 5px;
        }

        .inset {
            border-bottom-style: inset;
            border-bottom-width: 5px;
        }

        .outset {
            border-bottom-style: outset;
            border-bottom-width: 5px;
        }

        .objeto {
            height: 50px;
            fill: blue;
            width: 50px;
        }

        #iElementoIcone svg {
            height: 40px;
            width: 40px;
            margin-top: 1rem;
        }

        #iElementoIcone svg path {
            fill: black;
            fill-rule: evenodd;
        }


        .float-save-modal {
        }
    </style>
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
<script>

    let oDatatableMaterial = null;
    let oDatatableServico = null;

    $('#iAdicionarMaterial').click(async function () {

        if (!$(`#iProduto`).val()) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
            return;
        }

        var jaAdicionado = oDatatableMaterial.rows().data().toArray().some(p => p.CodMat === $("#iProduto").val());
        if (jaAdicionado)
        {
            Notificar("@RsBase.ATENCAO_", `Produto já lançado no sistema`, "warning");
            return;
        }

        $.ajax({
            url: '@String.Concat(CONSTANTES.URLPortal, "/api/Tipo_Elemento_RedeApi/MaterialVinculado")',
            type: `Get`,
            dataType: `json`,
            data: {
                codMat: $(`#iProduto`).val()
            }

        })
            .done(function (data) {
                if (data.ok) {

                    if (data.objeto != null) {
                        Notificar("@RsBase.ATENCAO_", `Produto ${data.objeto.descricao} já lançado em outro Tipo de Elemento`, "warning");
                        return;
                    }

                    oDatatableMaterial.row.add({
                        Id: 0,
                        Descricao: $(`#iProduto option:selected`).text(),
                        CodMat: $(`#iProduto`).val()
                    }).draw(false);

                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }

            });


        handleExcluirServico();
        handleExcluirMaterial();
    });

    $('#iAdicionarServico').click(function () {

        if (!$(`#iServico`).val()) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
            return;
        }

        oDatatableServico.row.add({
            Id: 0,
            Descricao: $(`#iServico option:selected`).text(),
            Codigo: $(`#iServico`).val(),
            UnidadeCusto: $(`#iServico`).attr("unidadeCusto"),
        }).draw(false);

        handleExcluirServico();
        handleExcluirMaterial();
    });


    function handleExcluirMaterial() {
        $(".btnExcluirMaterial").unbind('click');
        $(".btnExcluirMaterial").click(function (e) {
            e.preventDefault();

            var idArquivo = $(this).attr("excluir");

            var trLinkButton = $(this).parents('tr');

            if (idArquivo === "0") {
                oDatatableMaterial.row(trLinkButton).remove().draw(false);
                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
            }
            else {

                var link = `@String.Concat(CONSTANTES.URLPortal, "/api/Tipo_Elemento_MaterialApi/ExcluirGrid?value=")${idArquivo}` ;

                $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',

                })
                    .done(function (data) {

                        if (data.ok) {
                            oDatatableMaterial.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    })
                    .fail(function () {

                    })
                    .always(function () {

                    });
            }

        });
    }

    function handleExcluirServico() {
        $(".btnExcluirServico").unbind('click');
        $(".btnExcluirServico").click(function (e) {
            e.preventDefault();

            var idArquivo = $(this).attr("excluir");

            var trLinkButton = $(this).parents('tr');

            if (idArquivo === "0") {
                oDatatableServico.row(trLinkButton).remove().draw(false);
                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
            }
            else {

                var link = `@String.Concat(CONSTANTES.URLPortal, "/api/Tipo_Elemento_CadernoEncargoApi/ExcluirGrid?value=")${idArquivo}`;

                $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',

                })
                    .done(function (data) {

                        if (data.ok) {
                            oDatatableServico.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    })
                    .fail(function () {

                    })
                    .always(function () {

                    });
            }

        });
    }

    var HandleServico = function () {
        $('#iServico').on('select2:select select2:unselecting', function (e) {
            ServicoSelecionado = e.params.data;

            if (ServicoSelecionado != undefined) {
                $('#iServico').attr("unidadeCusto", ServicoSelecionado.unidade_Custo);
            }
        });
    };

        var HandleUnidadeCusto = function () {
            $("#iUnid_Custo").on('select2:select select2:unselecting', function (e) {
                Unidade_Custo = e.params.data;
                if (Unidade_Custo != undefined)
                    AddSelect("iServico", "@CONSTANTES.URLPortal/api/Caderno_EncargosApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, Unidade_Custo.id, null, "@RsBase.SELECIONE", false);
                else {
                    AddSelect("iServico", "@CONSTANTES.URLPortal/api/Caderno_EncargosApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                }
            });
        }
    var rows_selected = [];
        $(document).ready(function () {
            AddSelect("iIcone", "@CONSTANTES.URLPortal/api/Tipo_Elemento_IconeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Icone", "@RsBase.SELECIONE", false, HandleIcones);

            AddSelect("iModelo", "@CONSTANTES.URLPortal/api/Modelo_Elemento_RedeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Modelo", "@RsBase.SELECIONE", false, HandleModelo);

         @*AddSelect("iTipo_Cabo", "@CONSTANTES.URLPortal/api/Tipo_CaboApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);*@

            AddSelect("iServico", "@CONSTANTES.URLPortal/api/Caderno_EncargosApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

            AddSelect("iUnid_Custo", "@CONSTANTES.URLPortal/api/Unidade_Custoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleUnidadeCusto);

            AddSelect("iProduto", "@CONSTANTES.URLPortal/api/MaterialApi/GetComboMaterial", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleServico);

            $('#iE_Cabo').trigger('change');
            $('#iE_Caixa').trigger('change');

        });

        var HandleIcones = function () {
            $("#iIcone").on("select2:select select2:unselecting", function (e) {
                var icon = e.params.data;
                $("#iPadrao").text("");
                if (icon.padrao_connect) {
                    $("#iPadrao").text("Padrão Connect");
                }
            });
        }
        var HandleModelo = function () {
            $("#iModelo").on("select2:select select2:unselecting", function (evt) {
                let data = evt.params.data,
                    phrase = "";
                try {
                    switch (data.id) {

                        case 4:
                        case 7: phrase = "Modelo de @RsCadastros.CAIXA Selecionado";

                            $("#iE_Caixa").bootstrapToggle('on');
                            $("#iE_Cabo").bootstrapToggle('off');
                            break;

                        case 5:
                            phrase = "Modelo de @RsCadastros.POSTE Selecionado";
                            break;

                        case 6: phrase = "Modelo de @RsCadastros.CABO Selecionado";

                            $("#iE_Cabo").bootstrapToggle('on');
                            $("#iE_Caixa").bootstrapToggle('off');
                            break;

                        default: phrase = "Modelo Customizado";
                            break;
                    }
                }
                catch (Exception) {
                    phrase = "Dados não encontrados";

                    $("#iE_Caixa").bootstrapToggle('off');
                    $("#iE_Cabo").bootstrapToggle('off');
                }

            });
        }

    $("#btnAtivar").on("click", function () {

        if (rows_selected.length == 0) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
            return;
        }

        //Alterando para Inativo
        AlterarStatusObj(1);
    });


    $("#btnExcluir").on("click", function () {

        if (rows_selected.length == 0) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
            return;
        }

        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Modelo_ContratoApi/excluirlista")';

        $.ajax({
            url: link,
            type: 'POST',
            dataType: 'json',
            data: {
                ids: rows_selected
            }
        })
            .done(function (data) {

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    rows_selected = [];
                    oDatatableMaterial.draw();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });
    });
        //#region changestyle
      /**   funcao trocar estilo de linha
       * @@param{string} selectid
       * @@param{string} pId
       */
        //#endregion
        function changestyle(selectId,pId) {
            //$(`#${pId}`).removeClass("dashed groove dotted solid ridge inset outset");
            $(`#${pId}`).removeClass("dashed");
            $(`#${pId}`).removeClass("groove");
            $(`#${pId}`).removeClass("dotted");
            $(`#${pId}`).removeClass("solid");
            $(`#${pId}`).removeClass("ridge");
            $(`#${pId}`).removeClass("inset");
            $(`#${pId}`).removeClass("outset");

            let estilo = $(`#${selectId} option:selected`).text();

            $(`#${pId}`).addClass(estilo);

                return;
        }
        $("#iEstilo_Linha_Ativa").on('change',function () { changestyle("iEstilo_Linha_Ativa", "iEstiloAtivoDemonstracao") });
        $("#iEstilo_Linha_Inativa").on('change',function () { changestyle("iEstilo_Linha_Inativa", "iEstiloInativoDemonstracao") });

        $("#iE_Cabo").change(function () {

            if ($("#iE_Cabo").is(':checked')) {

                $("#DivTipo_Cabo").removeClass('none');
                $("#DivPar_Fibra").removeClass('none');
                $("#Div_PadraoCores").removeClass('none');
                $("#DivPar_Loose").removeClass('none');
                $("#DivTotal_Loose").removeClass('none');
                $("#DivEspessura_Cabo").removeClass('none');
                $("#DivEspessura_Linha").removeClass('none');
                $("#DivCorAtiva").removeClass('none');
                $("#DivCorInativa").removeClass('none');
                $("#DivEstiloAtivo").removeClass('none');
                $("#DivEstiloAtvDemo").removeClass('none');
                $("#DivEstiloInativo").removeClass('none');
                $("#DivEstiloInatvDemo").removeClass('none');
                $("#DivIcone").addClass('none');
                $("#iModalIcone").addClass('none');
                $("#DivCor").addClass('none');
                $("#iDivCapacidade").addClass('none');

                if ($("#iE_Caixa").is(':checked')) {
                    $("#iE_Caixa").bootstrapToggle('off');
                }

            }
            else
            {
                $("#iDivCapacidade").removeClass('none');
                $("#DivTipo_Cabo").addClass('none');
                $("#DivPar_Fibra").addClass('none');
                $("#DivPar_Loose").addClass('none');
                $("#DivTotal_Loose").addClass('none');
                $("#DivEspessura_Cabo").addClass('none');
                $("#DivEspessura_Linha").addClass('none');
                $("#Div_PadraoCores").addClass('none');

                $("#DivCorAtiva").addClass('none');
                $("#DivCorInativa").addClass('none');
                $("#DivEstiloAtivo").addClass('none');
                $("#DivEstiloInativo").addClass('none');
                $("#DivEstiloAtvDemo").addClass('none');
                $("#DivEstiloInatvDemo").addClass('none');
                $("#DivIcone").removeClass('none');
                $("#iModalIcone").removeClass('none');
                $("#DivCor").removeClass('none');

            }

        });

        $("#iE_Caixa").change(function () {

            if ($("#iE_Caixa").is(':checked')) {
                $("#iDivCapacidade").removeClass('d-none');

                if ($("#iE_Cabo").is(':checked')) {
                    $("#iE_Cabo").bootstrapToggle('off');
                }

            }
            else {
                $("#iCapacidade").val("0");

                $("#iDivCapacidade").addClass('d-none');
            }
        });

        function totalLoose() {
            var total = 0;
            par = $("#iNum_Pares_Fibra").val();
            tubo = $("#iNum_Tubo_Loose").val();

            total = (par * 1) * (tubo * 1);

            return $("#iTotal_Tubo_Loose").val(total);
        }

        $("#iNum_Pares_Fibra").on("focusout", function () { totalLoose() });
        $("#iNum_Tubo_Loose").on("focusout", function () { totalLoose() });

            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
    }();

