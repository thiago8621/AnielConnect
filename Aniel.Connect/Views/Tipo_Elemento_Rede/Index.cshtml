@model Aniel.Connect.Models.T5.Tipo_Elemento_RedeListaModel

@using Aniel.T5.Model.enumerado
@using Resources
@using Microsoft.AspNet.Identity;
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Sinapse.Model.enumerados;

@{
    ViewBag.Title = RsCadastros.LISTAGEM_TIPO_ELEMENTO_REDE;

    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;



}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>

}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>
        var rows_selected = [];
        var _url = '@String.Concat(CONSTANTES.URLPortal, "/api/Tipo_Elemento_RedeApi/AlterarStatus")';



        var handleDataTableButtons = function () {
            "use strict";

            function AlterarStatusObj(Status) {
            $.ajax({
            url: _url,
            type: `POST`,
            dataType: `json`,
            data:
            {
                ids: rows_selected,
                status: Status
            }
        }).done(function (data) {
                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    rows_selected = [];
                    oDatatable.draw();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }

            });
                rows_selected = [];
        }


            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: `<'row'<'col-sm-4'l><'col-sm-8'p>> Bfrti`,
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: `${baseUrl}/api/Tipo_Elemento_RedeApi/GetAll`,
                    type: 'POST',
                    data: function (data) {
                        var status = $("#iSituacao option:selected").val();
                        data.situacao = status;

                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function (row, data, dataIndex) {
                    // Get row ID
                    var rowId = data.id;

                    // If row ID is in the list of selected row IDs
                    if ($.inArray(rowId, rows_selected) !== -1) {
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                    }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [

                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "id", title: "@RsCadastros.ID" },
                    { data: "descricao", title: "@RsCadastros.DESCRICAO do Tipo de Elemento de Rede" },
                    { data: "cor", title: "@RsCadastros.COR",
                        render: function (data, type, row, meta) {
                            return `<div style=" padding:5px; Background-color: ${data}"></div>`;
                        }
                    },
                    { data: "situacao", title: "@RsCadastros.SITUACAO" },
                  @*{ data: "fabricante", title: "@RsCadastros.FABRICANTE" },
                    { data: "e_Cabo", title: "@RsCadastros.CABO" },
                    { data: "tipo_Cabo", title: "@RsCadastros.TIPO_CABO" },
                    { data: "espessura", title: "@RsCadastros.ESPESSURA" },
                    { data: "num_Pares_Fibra", title: "@RsCadastros.PAR_FIBRA" },
                    { data: "num_Tubos_Loose", title: "@RsCadastros.TUBO_LOOSE" },
                    { data: "espessura_linha", title: "@RsCadastros.ESPESSURA" },
                    { data: "cor_Linha_Ativa", title: "@RsCadastros.COR_ATIVO" },
                    { data: "cor_Linha_Inativa", title: "@RsCadastros.COR_INATIVO" },
                    { data: "estilo_Linha_Ativa", title: "@RsCadastros.ESTILO_ATIVO" },
                    { data: "estilo_Linha_Inativa", title: "@RsCadastros.ESTILO_INATIVO" }*@
                ]
            });




            $("#btnInativar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);

            });

            $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });
            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search(this.value).draw();
            });

            $("#iPesquisar").on("click", function () {
                $("#modal-filter").modal('hide');

                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();

                return true;
            });

            $("#iLimparFiltros").on("click", function () {
                $('#txtSearch').val('');
                oDatatable.search('').draw();
            });



            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checkeESTILO_INATIVOd and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function () {

                if (oDatatable.row(this).data() != null) {

                    var _id = oDatatable.row(this).data().id;

                    var url = '@Url.Action("Cadastro", "Tipo_Elemento_Rede", new { id = "__id__" })';
                    window.location.href = url.replace('__id__', _id);
                    ShowPageLoading();
                }
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

            $("#iPesquisar").on("click", function () {

                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
                //$("iUf").text("");
                $("#modal-filter").modal('hide');

                return true;
            });

    }

            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();


         var situacao = @(Html.GetArrayEnum<Status_Default>())
        var situacao_values = @(Json.Encode(Enum.GetValues(typeof(Status_Default)).Cast<Status_Default>()));
    $.each(situacao, function (key, value){
            $("#iSituacao").append($(`<option>${value}</option>`).attr("value", situacao_values[key]).text(value));

        });
    $("#iSituacao").select2({width:"resolve"});

    $(document).ready(function ()
    {


    });


        TableManageButtons.init();
    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-server"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Projeto_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.ANIEL_GEOGRAPHY</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

            @*<span style="font-size:11px" id="dtLegend"></span>*@
        </div>

        <div class="col-auto mb-3">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="Tipo de @RsCadastros.ELEMENTO_REDE" autocomplete="off" style="width:200px;">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>


                <a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "Tipo_Elemento_Rede")" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>

                <button type="button" class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltros" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">

                    <a class="dropdown-item" id="btnInativar" onclick="" href="#">@RsBase.INATIVAR</a>
                    <a class="dropdown-item" onclick="" id="btnAtivar" href="#">@RsBase.ATIVAR</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>

                </div>
            </div>
        </div>

    </div>
    <!--./main-->
</div>
<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>


<!--Modal Filters-->
<div class="modal" id="modal-filter">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12" style="align-content:center;">
                        <div class="row" style="align-content:center;">

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="iSituacao">@RsCadastros.SITUACAO</label>
                                    @Html.DropDownList("iSituacao", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { Id = "iSituacao", @class = "form-control", @placeholder = "Todos", @autocomplete = "off" })


                                </div>
                            </div>
                        </div>

                        <div class="form-group col-sm-12" style="padding: 10px;">
                            <div class="text-center">
                                <button type="button" class="btn btn-danger limparFiltro" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                                <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
