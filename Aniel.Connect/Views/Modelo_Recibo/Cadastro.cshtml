@model Aniel.Connect.Models.Modelo_ReciboCadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    /**/

    ViewBag.Title = RsCadastros.CADASTRO_MODELO_RECIBO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    ViewBag.URLArquivo = String.Format("{0}/Arquivos/Modelo_Recibo/", CONSTANTES.URLPortal);

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script>

        $('#iArquivo').on('change', function () {
            //get the file name
            var fileName = $(this).val().replace('C:\\fakepath\\', ' ');
            //replace the "Choose a file" label
            $(this).next('.custom-file-label').html(fileName);
        });

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;


            var erro = false;

            if ($('#iArquivo').next('.custom-file-label').html() == '') {
                Notificar("@Resources.ATENCAO_", "@String.Format(Resources.REQUIRED, RsCadastros.ARQUIVO)", "warning");
                erro = true;
            }

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
        }

        $(document).ready(function () {

            var arquivo = '@Model.Nome_Arquivo';
            try {
                $('#iArquivo').next('.custom-file-label').html(arquivo);
            } catch { }
        });

        $('#iArquivo').on( 'change', function() {
           myfile= $( this ).val();
           var ext = myfile.split('.').pop();
            if (!(ext == "docx" || ext == "doc")) {

                Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_DOC_DOCX", "warning");

           }
        });

/**/</script>

    <script src="~/Scripts/download.js"></script>
}


@using (Html.BeginForm("Cadastro", "Modelo_Recibo", FormMethod.Post, new { enctype = "multipart/form-data", @id = "form", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-receipt"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Modelo_Recibo")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTA_RECIBO</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>


                <div class="card div-card-accord">
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body">

                            <div class="row">

                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iDescricao"><strong>@RsCadastros.DESCRICAO</strong></label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                                <div class="col-sm-4 mt-3">
                                    <div class="form-group">
                                        @if (Model.Id != 0)
                                        {
                                            <label for="iStatus">@RsCadastros.STATUS:</label>

                                            @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                        }

                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label><strong>@RsCadastros.ARQUIVO</strong></label>
                                        <div class="input-group mb-3">
                                            <input type="file" class="custom-file-input" name="Arquivo" id="iArquivo" />
                                            <label for="Arquivo" id="arquivoi" class="custom-file-label"><i class="fas fa-upload"></i> @Resources.ESCOLHAUMARQUIVO</label>
                                        </div>
                                    </div>
                                </div>
                                @if (Model.Id != 0)
                                {
                                    <div class="col-sm-2 mt-4">
                                        <a href="@CONSTANTES.URLPortal/Arquivos/Modelo_Recibo/@Model.Id.@Model.Extensao_Arquivo"><i class="far fa-eye" style="font-size:16px;"></i></a>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>



                </div>


            </div>

            <!--Button Float-->
            <a href="@Url.Action("Index", "Modelo_Recibo")" class="float-cancel" onclick="ShowPageLoading(); return true;">
                <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                    <i class="fas fa-times fa-2x"></i>
                </div>
            </a>

            <a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
                <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                    <i class="fas fa-save fa-2x"></i>
                </div>
            </a>


        </div>
    </div>
}