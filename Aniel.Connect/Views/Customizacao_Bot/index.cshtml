@using Aniel.Connect.CustomHtmlHelper
@model Aniel.Connect.Models.Bot_CustomizacaoModel
@{
    /**/

    ViewBag.Title = RsCadastros.CUSTOMIZAR_BOT;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")


    @if (@Model.Id == 0)
    {
        <text>
            <script>
                $("#iHabilitado").prop("checked", true).change();
            </script>
        </text>
    }

<script>

    $(document).ready(function () {
        function toggleMinutosTransferencia() {
            $("#divMinutosTransferencia").toggle($("#iTransferencia").is(":checked"));
        }

        toggleMinutosTransferencia();

        $("#iTransferencia").on("change", toggleMinutosTransferencia);
    });


        $('a[data-toggle="tab"]').on('shown.bs.tab', () => {
            $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle('destroy');
            $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle();
        });

        var element = document.getElementById("iHabilitado");
        element.classList.remove("container");

    $("#iTransferencia").on("change", function () {
        if ($(this).is(':checked')) {
            $("#divMinutosTransferencia").show();
        } else {
            $("#divMinutosTransferencia").hide();
            $('#iMinutosTransferencia').val("");
        }
    });

        var clicked = false;
        somenteNumeros('iMinutosTransferencia');

        var inp = document.getElementById('iArquivoAvatar');
            inp.addEventListener('change', function (e) {
                var file = this.files[0];
                var reader = new FileReader();
                reader.onload = function () {
                    document.getElementById('iAvatar').src = this.result;
                };
                reader.readAsDataURL(file);
            }, false);


        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;

            var erro = false;

            if ($('#iNome').val() == "") {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsBase.NOMEREQUIRED)", "warning");
                erro = true;
            }

            if ($("#iTransferencia").is(":checked")) {
                var minutos = $("#iMinutosTransferencia").val().trim();
                if (minutos === "" || minutos === "0") {
                    Notificar("@RsBase.ATENCAO_", "O campo Minutos de Transferência deve ser preenchido com um valor maior que 0.", "warning");
                    erro = true;
                }
            }


            if (erro) {
                clicked = false;
                return false;
            }
            ShowPageLoading();
            $('#form').submit();

        }
</script>
}

@using (Html.BeginForm("Cadastro", "Customizacao_Bot", FormMethod.Post, htmlAttributes: new { enctype = "multipart/form-data", @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-cog"></i> @ViewBag.Title </h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Bot")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELBOT</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao_Bot",new { IdBot = Request.Params["IdBot"], DescricaoBot = Request.Params["DescricaoBot"]})" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACAO_BOT</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>

                        @*<span style="font-size:11px" id="dtLegend"></span>*@
                    </div>
                </div>
                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <span class="text-bold-card pt-0">@ViewBag.Title</span>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="form-group" style="position:center">
                                <div class="row">
                                    <div class="form-group col-sm-2">
                                        <label for="iCodigo" class="mr-3" style="text-align:ce">@RsCadastros.AVATAR:</label><br>
                                        <div class="row">
                                            @Html.Image("iAvatar", Model.Avatar, Model.Nome, "100", "120")
                                        </div>
                                    </div>
                                    <div class="form-group col-sm-4">
                                        <label for="iNome" class="mr-3">@RsCadastros.NOME_BOT:</label><br>
                                        @Html.TextBoxFor(m => m.Nome, new { @class = "form-control", id = "iNome" })
                                    </div>

                                        <div class="col-sm-2 form-group">
                                            <label for="iHabilitado">@RsCadastros.HABILITADO?</label><br />
                                            @Html.CheckBoxFor(m => m.Habilitado, new { @class = "form-control", @id = "iHabilitado", @name = " iHabilitado", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                </div>

                                <div class="row">
                                    <input id="iArquivoAvatar" type="file" name="Files[0]" sdata-index=0 />
                                </div>

                                <div class="row">
                                    <div class="form-group ">
                                        <label for="iTexto_Bot" class="mr-3">@RsCadastros.TEXTO_INVALIDO:</label><br>
                                        @Html.TextAreaFor(m => m.TextoInvalido, new { @class = "form-control", id = "iTextoInvalido" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group">
                                        @Html.CheckBoxFor(m => m.Transferencia, new { @class = "", id = "iTransferencia", @name = " iTransferencia" })
                                        <label for="iTransferencia"> @RsCadastros.TRANSFERENCIA  </label>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group divMinutosTransferencia" id="divMinutosTransferencia" style="display: none">

                                        <div style="white-space:nowrap">
                                            <label>Transferir automaticamente para um agente depois de </label>
                                            @Html.TextBoxFor(m => m.Minutos, new { @class = "form-control", @type = "number", id = "iMinutosTransferencia", @style = "width:65px !important" })
                                            <p>Minutos de duração da conversa com o Bot</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>



                    </div>


                    <!--Button Float-->
                    <a href="@Url.Action("Index", "Bot")" class="float-cancel" onclick="ShowPageLoading(); return true;">
                        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                            <i class="fas fa-times fa-2x"></i>
                        </div>
                    </a>

                    <a href="#" onclick="ValidaSubmit();" class="float-save" id="btnGravar">
                        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                            <i class="fas fa-save fa-2x"></i>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
}
