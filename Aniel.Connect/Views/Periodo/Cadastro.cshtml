@model Aniel.Connect.Models.T5.PeriodoCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_PERIODO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script>

        $(".hora").focusout(function () {

            if ($(this).val().length < 5) {
                $(this).val('')
            }
        })

        var clicked = false;
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

/**/</script>
}


@using (Html.BeginForm("Cadastro", "Periodo", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title ">
                        <h4 class="title-page"><i class="fas fa-calendar-minus"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Periodo")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_PERIODO</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>
                    <div class="card div-card-accord">
                        <div class="card-header title-card" id="heading-1">
                            <h5 class="mb-0">
                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                    <span class="text-bold-card">@ViewBag.Title</span>
                                </a>
                            </h5>
                        </div>
                        <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                            <div class="card-body body-card-accord">

                                <div class="row mt-2 mb-2">

                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label for="iDescricao">@RsCadastros.DESCRICAO:</label>
                                            @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off", @required = true })
                                            @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iHora_Ini">@RsCadastros.HORARIO_INICIO:</label>
                                            @Html.TextBoxFor(model => model.Hora_Ini, new { @class = "form-control hora", @placeholder = "00:00", @id = "iHora_Ini", @autocomplete = "off", @required = true })
                                            @Html.ValidationMessageFor(model => model.Hora_Ini, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2 mr-auto">
                                        <div class="form-group">
                                            <label for="iHora_Fim">@RsCadastros.HORARIO_FIM:</label>
                                            @Html.TextBoxFor(model => model.Hora_Fim, new { @class = "form-control hora", @placeholder = "00:00", @id = "iHora_Fim", @autocomplete = "off", @required = true })
                                            @Html.ValidationMessageFor(model => model.Hora_Fim, "", new { @class = "text-danger" })
                                        </div>
                                    </div>


                                    @if (Model.Id != 0)
                                    {
                                        <div class="col-auto">
                                            <div class="form-group">
                                                <label for="iSaldo_Caixa" class="mr-3">@RsFinanceiro.STATUS:</label>
                                                @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                            </div>
                                        </div>
                                    }


                                </div>


                            </div>
                        </div>
                    </div>
                
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Meio_Captacao")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}