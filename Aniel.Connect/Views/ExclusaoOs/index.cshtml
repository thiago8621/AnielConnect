@model  Aniel.Connect.Models.T5.TipoServicoImpVinculoRequest

@{
    ViewBag.Title = "Exclusão de Ordens de Serviços";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section Scripts
{
    <script>

        $(document).ready(function () {



        @if (TempData.ContainsKey("Erros") && ((List<string>)TempData["Erros"]).Count == 0) {


            <text>
                Notificar("Operação Finalizada", "Exclusão concluída com sucesso, verifique os logs para  mais informações.", "info");
            </text>
        }


        });

        function formClick() {
            $('#arquivoInput').click()
        }

        function submitForm() {
            $('#arquivoForm').submit()
        }

    </script>
}

@section Styles
{
    <style>
        .modal-body {
            height: 250px;
            overflow-y: auto;
        }

        @@media (min-height: 500px) {
            .modal-body {
                height: 400px;
            }
        }

        @@media (min-height: 800px) {
            .modal-body {
                height: 600px;
            }
        }
    </style>
}
<div class="row">
    <div class="col-10 mr-auto">
        <h4 class="title-page"><i class="fas fa-file-import"></i> @ViewBag.Title</h4>
        <nav aria-label="breadcrumb" class="mt-25">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Gestao_Equipe")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GESTAO_EQUIPES</a></li>
                <li class="breadcrumb-item">
                    <span>@ViewBag.Title</span>
                </li>
            </ol>

        </nav>
    </div>
    <div class="col mt-4 ml-4">
        <a class="btn btn-info" href="@Url.Action("Log", "ExclusaoOS")"><i class="fas fa-clipboard-list"></i> <span class="pl-2">Log</span></a>
    </div>

</div>

<div class="container-fluid" style="overflow:hidden;padding-bottom:10px" id="divTitle">

    <div class="card p-2 pl-3">
        <h4 class="pt-1">Para Excuir as Ordens de Serviço contidos na Planilha, siga os seguintes passos abaixo:</h4>

        <div class="pt-1">
            <p>1 - Faça upload da planilha padrão com os dados a serem Excluídos</p>
            <p>2 - Aguarde o processo realizado pelo sistema.</p>
            <p>A exclusão não ocorrerá caso:</p>
        </div>
        <div class="pl-2">
            <p>                - Uma ou mais coluna(s) da planilha Excel estiver vazia;</p>
            <p>                - Alguma O.S estiver baixada;</p>
        </div>


        <br>

        <div class="row ml-1">
            <form action="@Url.Action("EnviarPlanilha","ExclusaoOs")" id="arquivoForm" enctype="multipart/form-data" style="display:none" method="post">
                @Html.TextBoxFor(x => x.FileField, new { type = "file", id = "arquivoInput", name = "arquivo", onchange = "$('#divProgress').show();submitForm()" })
                @*<input type="file" id="arquivoInput" name="arquivo" onchange="$('#divProgress').show();submitForm()" />*@
            </form>
            
            <a class="btn btn-success text-white text-center col-3 mr-3" onclick="formClick()"><i class="fas fa-upload"></i> Upload Planilha</a>
            
            <a class="btn btn-success text-white text-center col-3" href="~/Arquivos/ExclusaoOrdemServico/Planilha_Padrao.xlsx">Baixar Planilha Padrão</a>
        </div>
    </div>

    <div class="mt-1">

        <div class="col-6">
            @if (TempData["Erros"] != null)
            {
                foreach (string err in (List<string>)TempData["Erros"])
                {
                    <div class="alert alert-danger" role="alert">
                        @err
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }
            }
        </div>


    </div>

</div>


<div class="overlay" id="divProgress" style="display:none;">
    <div class="preloaderbar show active">
        <span class="bar"></span>
        <span class="text">@RsCadastros.PROCESSANDO ...</span>
    </div>
</div>


