@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Log Exclusão";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />

}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>

    <script>

       

        let colunasDatatable =
            [
                { data: "data_exclusao", title: "Data Exclusão" },
                { data: "hora_exclusao", title: "Hora Exclusão" },
                { data: "usuario_exclusao", title: "Usuário Exclusão" },
                { data: "codct", title: "Contrato" },
                { data: "projeto", title: "Projeto" },
                { data: "num_doc", title: "Número do Cliente" },
                { data: "num_obra", title: "OS" },
                { data: "num_obra_original", title: "OS Original" },
                { data: "data_maxima", title: "Data de Agendamento" },
                { data: "usuario_criacao", title: "Usuário Criação" },
                { data: "data_criacao", title: "Data Criação" },
                { data: "hora_criacao", title: "Hora Criação" },
                { data: "nome_maquina", title: "Nome da Máquina" },
                { data: "ip_maquina", title: "Ip da Máquina" },
                { data: "obs", title: "Resultado da Operação" },
            ];

        var oDatatable;
        oDatatable = $("#datatable").length && $("#datatable").DataTable({
            dom: "Bfrti",
            select: {
                style: 'multi'
            },
            serverSide: true,
            searching: true,
            ordering: false,
            paging: false,
            deferRender: true,
            scrollResize: true,
            scrollY: '66vh',
            stateSave: true,
            scrollX: true,
            fixedHeader: true,
            initComplete: dataTableInitComplete,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
            deferLoading: false,
            ajax: {
                url: baseUrl + '/api/ExclusaoOsApi/Log',
                type: 'POST',
                data: function (data) {
                    data.data = $('#iData').val();
                },
                error: function (e) {
                    console.log(e);
                },
                dataSrc: function (d) {
                    return d.data;
                }
            },
            infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {
            },
            pageLength: 5,
            order: [],
            language: traducaoDataTableSimples,
            columns: colunasDatatable
        });
        $("#datatable tbody").empty();

        function Filtrar() {

            if (!$('#iData').val())
            {
                Notificar("@RsBase.ATENCAO_", "Informe a Data Exclusão", "warning");
                return;
            }

            oDatatable.draw();

        }

    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-8 mt-3">

            <h4 class="title-page"><i class="fas fa-clipboard-list"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "ExclusaoOS")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">Exclusão OS</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>
        </div>
        <div class="col title-page form-group float-right mt-5 p-1">

            <div class="row">
                <span class="text-danger">*</span>
                <span class="pl-1">Data Exclusão :</span>
            </div>
            <div class="row">
                <input class="form-control obrigatorio datepicker-period mb-1" id="iData" type="text" data-enddate="@DateTime.Now.Date" data-startdate="01/01/0001" autocomplete="off" placeholder="00/00/0000" maxlength="10">
                <button class="btn btn-info ml-3" onclick="Filtrar()">Filtrar</button>
                <button class="btn btn-success ml-3" onclick="$('.buttons-excel').click()">Exportar</button>
            </div>
        </div>
    </div>
</div>

<div id="divTable" class="ml-3 mr-3">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>
