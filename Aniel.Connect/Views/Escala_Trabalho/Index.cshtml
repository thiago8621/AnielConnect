@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .custom-select {
            width: 85px !important;
        }

        .table.dataTable thead th {
            text-align: center;
        }

        .popover-block-container .popover-icon {
            background: none;
            color: none;
            border: none;
            padding: 0;
            outline: none;
            cursor: pointer;
        }

