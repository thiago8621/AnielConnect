            $("#iDescSupervisor").val(null).trigger('change');
            $("#iSituacao_Equipe").val(null).trigger('change');
            $('#txtSearch').val(null).trigger('change');
            rows_selected = [];
            //ShowPageLoading();
            oDatatable.search($('#txtSearch').val()).draw();
        });

        $("[data-toggle=popover]").popover({
            html: true,
                  content: function () {
                var content = $(this).attr("data-popover-content");
                return $(content).children(".popover-body").html();
            }
        });

    </script>
