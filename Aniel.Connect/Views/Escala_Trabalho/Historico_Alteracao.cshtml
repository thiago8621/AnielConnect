@*@model Aniel.Connect.Models.LogGenericoParamListModel*@

@using Resources
@using Aniel.Connect.Models.T5
@using Aniel.Connect.Core

@{
    ViewBag.Title = RsCadastros.HISTORICO_ALTERACAO;
    ViewBag.Sessao = RsCadastros.HISTORICO_ALTERACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{

    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>

    <script>

        let oDatatable = null;

        rows_selected = [];

        "use strict";


        function carregaSelect() {
            AddSelect("iTecnico", "@CONSTANTES.URLPortal/api/Escala_Trabalhoapi/GetComboTecnicoLog", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }

        $(document).ready(async () => {
            carregaSelect();
            if (oDatatable = null) {
                $('#datatable').rows_selected = [];
            }

        });

        function CarregaDataTable() {

            if (oDatatable == null) {
                handleDataTableButtons();
            } else {
                oDatatable.draw();
            }
        }


        "use strict";

        function handleDataTableButtons() {

                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "Bfrti",
                    select: {
                        style: 'multi'
                    },
                    serverSide: true,
                    searching: true,
                    ordering: true,
                    paging: true,
                    destroy: true,
                    deferRender: true,
                    scrollResize: true,
                    scrollY: '66vh',
                    scroller: {
                        loadingIndicator: true,
                        rowHeight: 40,
                        boundaryScale: 0.5,
                        displayBuffer: 3
                    },
                    stateSave: true,
                    scrollX: true,
                    fixedHeader: true,
                    initComplete: dataTableInitComplete,
                    drawCallback: () => {

                      //  TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                        ResizeTable('divTable');
                    },
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: baseUrl + '/api/Escala_Trabalhoapi/LogHistoricoEscalaTrabalho',
                        type: 'POST',
                        data: function (data) {

                            data.tecnico = $("#iTecnico").text();
                            data.dataInicio = $('#iDataInicio').val();
                            data.dataFim = $('#iDataFinal').val();
                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
                    },
                    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                        var str = "@RsCadastros.INFODATATABLE";
                        if (iTotal == 0) { iEnd = 0; iStart = 0; }
                        str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                        $("#dtLegend").html(str);

                        return "";
                    },
                    pageLength: 5,
                    order: [],
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTable,
                    columns: [
                        { data: "tecnico", title: "@RsCadastros.TECNICO" },
                        { data: "dataInicio", title: "Data Início" },
                        { data: "dataFim", title: "Data Fim" },
                        { data: "horarioAnterior", title: "Horário Anterior" },
                        { data: "horarioAtual", title: "Horário Atual" },
                        { data: "perfilAnterior", title: "Perfil Anterior" },
                        { data: "perfilAtual", title: "Perfil Atual" },
                        { data: "usuarioAlteracao", title: "Usuário Alteração" },
                        { data: "dataHoraAlteracao", title: "Data e Hora Alteração" }
                    ]
                });

                $('#txtSearch').val(oDatatable.search());
                $('#txtSearch').keyup(function () {
                    oDatatable.search($(this).val()).draw();
                });

                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    rows_selected = [];
                });

                oDatatable.draw();

        }

         $("#iPesquisar").on("click", function () {

            erro = false;

            if ($('#iDataInicio').val() && $('#iDataFinal').val()) {
                const datainicio = moment($('#iDataInicio').val(), "DDMMYYYY")
                const datafim = moment($('#iDataFinal').val(), "DDMMYYYY")

                var result = (datafim.diff(datainicio, "days"))

                if (result > 60) {
                    Notificar("@RsBase.ATENCAO_", "Selecione um período até 60 dias.", "warning");
                    erro = true;

                } else {
                    erro = false;
                }
            }


            if (!erro) {
                handleDataTableButtons();
                return true;
            }
         });


        $("#iLimparFiltro, #iLimparFiltroModal").click(() => {
           
            $('#iTecnico').val(null).trigger('change')
            $("#iDataInicio").val("")
            $("#iDataFinal").val("")

            carregaSelect()

            if (oDatatable != null) {
                oDatatable.draw()
            }
        });

    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page"><i class="fas fa-history"></i> @ViewBag.Title</h4>

            <nav class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Configuracao", new { Id = Request.Params["Id"] })" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Escala_Trabalho")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">Escala de Trabalho</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>

                </ol>
            </nav>

            <span style="font-size:11px" id="dtLegend"></span>
        </div>
        <div class="col-auto">
            <div class="row title-page">
                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                </div>

            </div>
        </div>
    </div>

    <!--./main-->
</div>

<div class="row mt-2 mr-2">

    <div class="mr-4 ml-4 col-4">
        <div class="form-group">
            <label for="iTecnico">@RsCadastros.TECNICO:</label>
            <select class="form-control" id="iTecnico"></select>
        </div>
    </div>
 
    <div class="row mr-2">

        <div class="row">
            <div class="col mr-2">
                <div class="form-group">
                    <label for="iArea">@RsCadastros.PERIODO:</label>
                    <div class="row mr-2">
                        <div class="form-group form-inline align-horizontal" style="height:100%;">

                            <input type="text" class="form-control datepicker" placeholder="00/00/0000" id="iDataInicio" autocomplete="off" />
                            <span class="mr-2 ml-2">@RsBase.A</span>
                            <input type="text" class="form-control datepicker" placeholder="00/00/0000" id="iDataFinal" autocomplete="off" />

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col mr-2">
                <div class="form-group">
                    <button type="button" class="btn btn-success" id="iPesquisar" style="margin-top: 15px;">@RsCadastros.PESQUISAR</button>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col mr-2">
                <div class="form-group">
                    <button type="button" class="btn btn-danger" id="iLimparFiltroModal" style="margin-top: 15px;">@RsBase.LIMPAR_FILTRO</button>
                </div>
            </div>
        </div>



    </div>


</div>



<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>

