@model Aniel.Connect.Models.Escala_TrabalhoCadastroModel
@using Aniel.T5.Model.enumerado

@{
    ViewBag.Title = RsCadastros.ESCALA_TRABALHO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{

    @if (ViewBag.Sucesso == true)
    {

        <script type="text/javascript">
            $(document).ready(function () {

                try {
                    parent.dial.dialog('close');
                }
                catch (ex) {
                    console.log(ex);
                }

            });
        </script>
    }


    <script>
    
        const DATA_ALTERACAO_ESCALA = `${$("#iDia").val()}/${$("#iMes").val()}/${$("#iAno").val()}`;
    
        var HandleHorario = function () {
            $('#iHorario').on('select2:select select2:unselecting', function (e) {
    
                HorarioSelecionado = e.params.data;
                if (HorarioSelecionado) {
                    $('#iJornadaDia').text("@Html.Raw(RsCadastros.HORARIO):" + HorarioSelecionado.jornadaDia);
                }
    
            });
        };

        $(document).ready(function () {
            $("#iApenas_Dia").trigger('change')

            @if(Model.HorarioServicoAtribuido == HorarioAtribuido.AnielPoint)
            {
                <text>
                AddSelect("iHorario", "@CONSTANTES.URLPortal/api/Horarioapi/GetComboJornadaDia", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Horario", "@RsBase.SELECIONE", true, HandleHorario);
                </text>
            }
            else
            {
                <text>
                AddSelect("iHorario", "@CONSTANTES.URLPortal/api/Horarioapi/GetComboJornadaDia", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Horario", "@RsBase.SELECIONE", false, HandleHorario);
                </text>
            }

            AddSelect("iPerfilAgendamento", "@CONSTANTES.URLPortal/api/PerfilAgendamentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_PerfilAgendamento", "@RsBase.SELECIONE", false);
        })

        $("#iIndisponivel").change(function () {

            $("#iData_Final").unbind("focusout");

            if ($("#iIndisponivel").is(':checked')) {

                $('#iHorario').prop("disabled", true);
                $('#iPerfilAgendamento').prop("disabled", true);
                //$('#divDatas').show();

                ValidaPeriodo("iData_Inicial", "iData_Final", "@String.Format(RsBase.PERIODO_INVALIDO)");

            } else {

                $('#iHorario').prop("disabled", false);
                $('#iPerfilAgendamento').prop("disabled", false);
                //$('#divDatas').hide();
            }

            if (HandleHorario.jornadaDia == '') {

                ValidaPeriodo("iData_Inicial", "iData_Final", "@String.Format(RsBase.PERIODO_INVALIDO)");

            }

        });


         $("#iApenas_Dia").change(function () {
             if ($("#iApenas_Dia").is(':checked')) {
                 $("#iData_Inicial").val(DATA_ALTERACAO_ESCALA);
                 $('#divDatas').show();
             }
             else {
                 $('#divDatas').hide();
                 $("#iData_Inicial").val("");
             }
         });

        $(document).ready(function () {
            $('#iIndisponivel').trigger('change');
            //$('#iApenas_Dia').prop("checked", false).change();
        });


        var clicked = false;
        function ValidaSubmit() {

            if (clicked) {
                return false;
            }

            clicked = true;

            erro = false;

            ValidaPeriodo("iData_Inicial", "iData_Final", "@String.Format(RsBase.PERIODO_INVALIDO)");


            if ($("#iIndisponivel").is(':checked') && $("#iApenas_Dia").is(':checked')) {

                if ($("#iData_Inicial").val() == "") {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DATAINICIAL)", "warning");
                    erro = true;
                }

                if ($("#iData_Final").val() == "") {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DATAFINAL)", "warning");
                    erro = true;
                }
            }

            @if (Model.HorarioServicoAtribuido == HorarioAtribuido.AnielConnect)
            {
            <text>
                else if (!$("#iHorario").val() && !$("#iIndisponivel").is(':checked'))
                {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsCadastros.HORARIO_DE_SERVICO)", "warning");
                    erro = true;
                }
            </text>
            }


            if ($("#iPerfilAgendamento").val() == null) {
                Notificar("@RsBase.ATENCAO_", "Escolha um perfil", "warning");
                erro = true;
            }
            if ($("#iIndisponivel").is(':checked') && $('#iPerfilAgendamento').prop("disabled", true)) {

                erro = false;
            }

            if (DataMenorHoje(DATA_ALTERACAO_ESCALA)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.NAO_POSSIVEL_ESCALA_DIAS_ANTERIOES)", "warning");
                erro = true;
            }

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();


            $('#form').submit();
        }
    </script>
}


@section styles
{

}


@using (Html.BeginForm("Cadastro", "Escala_Trabalho", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.Equipe)
    @Html.HiddenFor(model => model.Dia, new { id = "iDia" })
    @Html.HiddenFor(model => model.Mes, new { id = "iMes" })
    @Html.HiddenFor(model => model.Ano, new { id = "iAno" })



    <div style="padding:10px">
        <div class="card" style="border:none;">

            <div class="card div-card-accord" style="box-shadow:none !important">


                <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                    <div class="card-body body-card-accord">
                        <div class="row mt-2 mb-2">

                            @*<div class="col-sm-2">
                                                    <div class="form-group">
                                                        <label for="iCodigo" class="mr-3">@RsFinanceiro.ANO:</label>
                                                        @Html.TextBoxFor(m => m.Ano, new { @readonly = "true", @class = "form-control", @id = "iAno", @autocomplete = "off" })
                                                        @Html.ValidationMessageFor(model => model.Ano, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-3">
                                                    <div class="form-group">
                                                        <label for="iCodigo" class="mr-3">@RsFinanceiro.MES:</label>
                                                        @Html.HiddenFor(model => model.Mes)
                                                        @Html.EnumDropDownListFor(m => m.Mes, RsBase.SELECIONE, new { @disabled = "true", @class = "form-control", @id = "iMes", @autocomplete = "off" })
                                                        @Html.ValidationMessageFor(model => model.Mes, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iCodigo" class="mr-3">@RsCadastros.DIA:</label>
                                        @Html.TextBoxFor(m => m.Dia, new { @readonly = "true", @class = "form-control", @id = "iDia", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Dia, "", new { @class = "text-danger" })
                                    </div>
                                </div>*@


                        </div>



                        <div class="row mt-2 mb-2">


                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iUF">@RsCadastros.HORARIO_DE_SERVICO:</label>
                                    @Html.DropDownListFor(m => m.Id_Horario, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control " + (Model.HorarioServicoAtribuido == HorarioAtribuido.AnielPoint ? "readonly" : ""), @id = "iHorario", @autocomplete = "off" })

                                    @Html.ValidationMessageFor(model => model.Id_Horario, "", new { @class = "text-danger" })

                                    <label id="iJornadaDia" for="iUF"></label>
                                </div>
                            </div>




                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iUF">@RsCadastros.PERFIL_AGENDAMENTO_ROTEIRIZACAO :</label>
                                    @Html.DropDownListFor(m => m.Id_PerfilAgendamento, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iPerfilAgendamento", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Id_PerfilAgendamento, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            @if (Model.HorarioServicoAtribuido == HorarioAtribuido.AnielConnect)
                            {
                                <div class="col-sm-2">
                                    <label for="iCidade">@RsCadastros.INDISPONIVEL:</label>
                                    <div class="form-group">

                                        @Html.CheckBoxFor(m => m.Indisponivel, new { @class = "form-control " + (Model.HorarioServicoAtribuido == HorarioAtribuido.AnielPoint ? "readonly" : ""), @id = "iIndisponivel", @name = "my-checkbox", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                        @Html.ValidationMessageFor(model => model.Indisponivel, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            }
                            else
                            {
                                @Html.HiddenFor(p => p.Indisponivel);
                            }

                        </div>
                        <div class="row mt-2 mb-2">
                            @if (Model.HorarioServicoAtribuido == HorarioAtribuido.AnielConnect)
                            {
                                <div class="col-sm-2" id="divApenasDia">
                                    <label for="iUF">@RsCadastros.REPLICAR_DIAS:</label>
                                    <div class="form-group">

                                        @Html.CheckBoxFor(m => m.Apenas_Dia, new { @class = "form-control " + (Model.HorarioServicoAtribuido == HorarioAtribuido.AnielPoint ? "readonly" : ""), @id = "iApenas_Dia", @name = "my-checkbox", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light", @readonly = "readonly" })
                                        @Html.ValidationMessageFor(model => model.Apenas_Dia, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            }
                            else
                            {
                                @Html.HiddenFor(p => p.Apenas_Dia);
                            }

                            <div class="mt-1">

                                <div class="row pl-3" id="divDatas" style="display:none">
                                    <div class="col">
                                        <label for="iData_Inicial">@RsCadastros.DATAINICIAL</label>
                                        @Html.TextBoxFor(m => m.Data_Inicial, new { @tabindex = "7", @class = "form-control datepicker readonly", @data_provide = "datepicker", @id = "iData_Inicial", @autocomplete = "off" })
                                    </div>
                                    <div class="col">
                                        <label for="iData_Final">@RsCadastros.DATAFINAL</label><br />
                                        @Html.TextBoxFor(m => m.Data_Final, new { @tabindex = "7", @class = "form-control datepicker " + (Model.HorarioServicoAtribuido == HorarioAtribuido.AnielPoint ? "readonly" : ""), @data_provide = "datepicker", @id = "iData_Final", @autocomplete = "off" })
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>
            </div>

        </div>

        <!--Button Float-->

        <div class="form-group col-sm-12" style="padding: 15px;">
            <div class="text-center">
                <button type="button" onclick="parent.dial.dialog('close'); return false;" class="btn btn-danger" id="iLimparFiltroModal">Cancelar</button>
                <button type="button" onclick="return ValidaSubmit();" class="btn btn-success" id="iPesquisar">Salvar</button>
            </div>
        </div>

    </div>
}
