@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5


@{
    ViewBag.Title = RsCadastros.CONFIGURACAO_BOT;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    var descricaoBot = Request.Params["DescricaoBot"];
}

@{
    List<AreaModuloModel> _areas = ViewBag.Areas;

}

@section scripts {

    <script>
        let UltimoEventoTeste = null;
        let atendimento = {
            protocolo: "teste",
            cliente: { nome: "cliente teste" },
            bot:true
        };

        async function AdicionarMensagemTeste(mensagem) {

            $('#iMensagemTeste').val('')
            const html = `<div style="width: 50%" class="row mt-3"><b>Minha Mensagem</b>: ${mensagem}</div>`
            $(`#divMensagensTeste`).append(html);

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentopi/TestarBotRecurso")' + ``;

            let resultado = await $.ajax({
                url: link,
                type: 'POST',
                data: {
                    mensagem: mensagem,
                    IdBot:@Request.Params["IdBot"],
                    UltimoEvento: UltimoEventoTeste,
                    atendimento: {
                        protocolo: "teste",
                        cliente: { nome: "cliente teste" },
                        atendimento: atendimento
                    }
                },
                dataType: 'json'
            });

            UltimoEventoTeste = resultado.eventoAtual;
            atendimento = resultado.atendimento;
            for (let item of resultado.sequenciaMensagens) {
                const htmlItem = `<div class="row mt-3"><div class="col-6"></div><div class="col-6">${item}</div></div>`
                $(`#divMensagensTeste`).append(htmlItem);
            }
        }

        async function ReiniciarTeste() {
            $('#divMensagensTeste div').remove();
            UltimoEventoTeste = null;
            atendimento = {
                protocolo: "teste",
                cliente: { nome: "cliente teste" },
                bot: true
            };
        }
    </script>

}

<div class="container-fluid" id="divTitle">
    <div class="row">

        <div class="col-auto mr-auto pl-0">
            <h4 class="title-page"><i class="fas fa-robot"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mb-20">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Bot")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELBOT</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@RsCadastros.CONFIGURACAO_BOT</span>
                    </li>

                </ol>
            </nav>
        </div>

    </div>


    <div class="row pl-4" style="margin-top: -10px;">

        <div class="col-sm-3">
            <div class="row">
                <p class="pConfig mt-3"><u><i class="fas fa-cog"></i> @RsCadastros.CONFIGURACOES</u></p>
            </div>
            <div class="text-left">
                <ul class="ulConfig">
                    <li class="liConfig"><a href="@Url.Action("Index","Customizacao_Bot",new { DescricaoBot = descricaoBot,IdBot = Request.Params["IdBot"] })" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.CRIAR_PERSONALIDADE_BOT</a></li>
                </ul>
            </div>
        </div>

        <div class="col-sm-3">
            <div class="row">
                <p class="pConfig mt-3"><u><i class="far fa-comment-dots"></i> @RsCadastros.EVENTOS</u></p>
            </div>
            <div class="text-left">
                <ul class="ulConfig">
                    <li class="liConfig"><a href="@Url.Action("Index", "Evento",new { IdBot = Request.Params["IdBot"], DescricaoBot = descricaoBot})" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_EVENTOS_BOT</a></li>
                </ul>
            </div>
        </div>

        <div class="col-sm-3">
            <div class="row">
                <p class="pConfig mt-3"><u><i class="fas fa-align-justify"></i> @RsCadastros.TESTE_BOT_TITULO</u></p>
            </div>
            <div class="text-left">
                <ul class="ulConfig">
                    <li class="liConfig"><a href="#" class="aConfig" onclick="$('#modal-testeBot').modal('show'); return false;">@RsCadastros.TESTE_BOT_DESC</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>


<!--MODAL DE TESTE-->
<div class="modal" id="modal-testeBot">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">Testar Bot</h4>

                <div style="align-content:center">
                    <a class="btn" title="Reiniciar" onclick="ReiniciarTeste()">Reiniciar</a>
                </div>

                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-10">
                        <input type="text" id="iMensagemTeste" class="form-control" placeholder="Digite sua mensagem">
                    </div>
                    <div class="col-2">
                        <a class="btn" onclick="AdicionarMensagemTeste($('#iMensagemTeste').val())"><i class="fa fa-paper-plane" aria-hidden="true"></i></a>
                    </div>
                </div>

                <div id="divMensagensTeste" class="container" style="min-height: 50vh">
                </div>


            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
