@model Aniel.Connect.Models.ConcentradoraCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_CONCENTRADORA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/maskip")
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>
        let ip

        $(document).ready(function () {
            ip = $('#iIP').ipInput()
            ip.setIp('@Model.Ip')

            $('.ip-input-container').addClass('form-control')

            AddSelect("iRadius", "@CONSTANTES.URLPortal/api/RadiusApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdRadius", "@RsBase.SELECIONE", false)
            AddSelect("iPOP", "@CONSTANTES.URLPortal/api/POPapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdPop", "@RsBase.SELECIONE", false)

            @if (Model.Id == 0)
            {
                <text> $("#iId").val("") </text>
            }
        });

        $('#iGrupoArea').change(function () {

            var grupo_area = $('#iGrupoArea option:selected').val();
            var enderecoApi = "@CONSTANTES.URLPortal/api/Areaapi/GetList?grupo_area=" + grupo_area;

            $('#iArea').empty();
            $('#iLocalidade').empty();

            $.ajax({
                url: enderecoApi,
                type: 'GET',
                dataType: 'json'
            })
            .done(function (data) {

                $('#iArea').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));

                $.each(data.objeto, function (key, value) {
                    $('#iArea').append($('<option></option>').attr('value', value.value).text(value.label));
                });

                var grupo_area = $('#iGrupoArea option:selected').val();
                var area = $('#iArea option:selected').val();

                var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

                $('#iLocalidade').empty();

                $.getJSON(enderecoApi, function (data) {
                    $('#iLocalidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));

                    $.each(data.objeto, function (key, value) {
                        $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));
                    });
                });
            })
            .fail(function () {
                console.log("error");
            })
            .always(function () {
                parent.App.stopPageLoading();
            });

        });

        $('#iArea').change(function () {

            var grupo_area = $('#iGrupoArea option:selected').val();
            var area = $('#iArea option:selected').val();

            var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

            $('#iLocalidade').empty();

            $.getJSON(enderecoApi, function (data) {
                $('#iLocalidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                $.each(data.objeto, function (key, value) {
                    $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));
                });
            });
        });

        var oDatatableGrupoArea;
        var array = @Html.Raw(Json.Encode(Model.GruposArea));

        function handleExcluirGrupoArea() {
            $(".btnExcluirGrupoArea").unbind('click');
            $("#datatableGrupoArea").on('click', '.btnExcluirGrupoArea', function (e) {
                e.preventDefault();

                var idArquivo = $(this).attr("excluir");

                var trLinkButton = $(this).parents('tr');

                if (idArquivo == 0) {
                    oDatatableGrupoArea.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
                else {
                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Concentradora_Grupo_AreaApi/ExcluirGrid?usuario=" + HttpContext.Current.User.Identity + "value=")' + idArquivo;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',

                    })
                    .done(function (data) {

                        if (data.ok) {
                            oDatatableGrupoArea.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    })
                }
            });
        }


        //datatable Grupo e Area
        var handleDataTableButtonsGrupoArea = function () {
            "use strict";

            var nome_lista = "GruposArea"; //Nome_utilizado para enganar o razor

            //"Blfrtip"
            oDatatableGrupoArea = $("#datatableGrupoArea").length && $("#datatableGrupoArea").DataTable({
                dom: "Bfrti",
                rowId: 'extn',
                select: true,
                language: traducaoDataTableSimples,
                data: array,
                pageLength: 50,
                columns: [
                    {
                        data: "Id",
                        orderable: false,
                        render: function (data, type, row, meta) {

                            const botaoexcluir = row.Id == 0;

                            return (botaoexcluir ? '<a href="#" class="btnExcluirGrupoArea" id="btnExcluirGrupoArea_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;padding-right:2px;"></i></a>' +

                                ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Area" name="' + nome_lista + '[' + meta.row + '].Cod_Area" type="hidden" value="' + TrataNulo(row.Cod_Area) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Escritorio" name="' + nome_lista + '[' + meta.row + '].Cod_Escritorio" type="hidden" value="' + TrataNulo(row.Cod_Escritorio) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Localidade" name="' + nome_lista + '[' + meta.row + '].Cod_Localidade" type="hidden" value="' + TrataNulo(row.Cod_Localidade) + '">'

                                :  //else

                                ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Area" name="' + nome_lista + '[' + meta.row + '].Cod_Area" type="hidden" value="' + TrataNulo(row.Cod_Area) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Escritorio" name="' + nome_lista + '[' + meta.row + '].Cod_Escritorio" type="hidden" value="' + TrataNulo(row.Cod_Escritorio) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Localidade" name="' + nome_lista + '[' + meta.row + '].Cod_Localidade" type="hidden" value="' + TrataNulo(row.Cod_Localidade) + '">');
                        }
                    },
                    {
                        data: "Desc_Escritorio",
                        title: "@RsCadastros.GRUPO_AREA",
                        orderable: true,
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Desc_Escritorio" name="' + nome_lista + '[' + meta.row + '].Desc_Escritorio" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Desc_Area",
                        title: "@RsCadastros.AREA",
                        orderable: false,
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data  + ' <input id="' + nome_lista + '_' + meta.row + '__Desc_Area" name="' + nome_lista + '[' + meta.row + '].Desc_Area" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Localidade",
                        title: "@RsCadastros.LOCALIDADE",
                        orderable: false,
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Localidade" name="' + nome_lista + '[' + meta.row + '].Localidade" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    }
                ]
            });


            $("#btnAdicionarGrupoArea").unbind('click');
            $("#btnAdicionarGrupoArea").on('click', async function () {

                var erro = false;

                        if (!$("#iGrupoArea option:selected").val()) {
                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.GRUPO_AREA)", "warning");
                            erro = true;
                        }

                        if (!$("#iArea option:selected").val()) {
                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.AREA)", "warning");
                            erro = true;
                        }

                        if (!$("#iLocalidade option:selected").val()) {
                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LOCALIDADE)", "warning");
                            erro = true;
                        }


                        if (erro) {
                            return false;
                        }

                        oDatatableGrupoArea.row.add({
                            Id: 0,
                            Cod_Area: $("#iArea option:selected").val(),
                            Cod_Escritorio: $("#iGrupoArea option:selected").val(),
                            Cod_Localidade: $("#iLocalidade option:selected").val(),
                            Desc_Escritorio: $("#iGrupoArea option:selected").text(),
                            Desc_Area: $("#iArea option:selected").text(),
                            Localidade: $("#iLocalidade option:selected").text()

                        }).draw(false);

                        handleExcluirGrupoArea();

                        $('#iGrupoArea').val("")
                        $('#iArea').val("")
                        $('#iLocalidade').val("");

                        //AddSelect("iPlano", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandlePlano);

            });
        },
            TableManageButtonsGrupoArea = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtonsGrupoArea();
                        handleExcluirGrupoArea();
                    }
                }
            }();

        TableManageButtonsGrupoArea.init();

        let clicked = false
        function ValidaSubmit() {
            let erro = false

            let ip_value = ip.getIp();
            $('#iHiddenIp').val(ip_value);

            if (clicked) {
                return false
            }

            clicked = true
            if (ValidaCamposObrigatorios(erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            if (!$("#iNome").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.NOME)", "warning")
                erro = true
            }

            if (!$("#iTipo").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TIPO)", "warning")
                erro = true
            }

            if (!$("#iPOP").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.POP)", "warning")
                erro = true
            }

            ValidaCampoIP(ip, "iIP")

            if (!$("#iLogin").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LOGIN)", "warning")
                erro = true
            }

            if (!$("#iSenha").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.SENHA)", "warning")
                erro = true
            }

            if (!$("#iRadius").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.RADIUS)", "warning")
                erro = true
            }

            if (erro) {
                clicked = false
                return false
            }

            ShowPageLoading();
            $('#form').submit();

            return true;
        }
</script>
}

@using (Html.BeginForm("Cadastro", "Concentradora", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.HiddenFor(model => model.Id)

    <div class="card" style="border:none;">
        <div class="card-body">

            <div class="sticky-top bg-white">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-server"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GERENCIAMENTO_REDE</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Concentradora")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_CONCENTRADORA</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>

                <div class="sticky-top">
                    <ul class="nav nav-tabs" id="myTab" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="concentradora-tab" data-toggle="tab" href="#iConcentradora" role="tab" aria-selected="true">&nbsp; @RsCadastros.CONCENTRADORA</a>

                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="grupo-area-tab" data-toggle="tab" href="#iGrupoAreaLocalidade" role="tab" aria-selected="false">@RsCadastros.GRUPO_AREA</a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="iConcentradora">

                    <!--Bloco1-->
                    <!--Dados da Concentradora-->
                    <div id="accordion">
                        <div class="card div-card-accord">
                            <div class="card-header title-card" id="heading-1">
                                <h5 class="mb-0">
                                    <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                        <span class="text-bold-card">@RsCadastros.CADASTRO</span>
                                    </a>
                                </h5>
                            </div>
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body body-card-accord">
                                    <div class="row">
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iId">@RsCadastros.ID:</label>
                                                @Html.TextBoxFor(p => p.Id, new { @class = "form-control", id = "iId", disabled = "disabled" })
                                            </div>
                                        </div>

                                        <div class="col-sm-4">
                                            <div class="form-group">
                                                <label for="iNome">@RsCadastros.NOME:</label>
                                                @Html.TextBoxFor(p => p.Nome, new { @class = "form-control obrigatorio", @id = "iNome", @autocomplete = "off" })
                                            </div>
                                        </div>

                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iTipo">@RsCadastros.TIPO</label>
                                                @Html.EnumDropDownListFor(p => p.Tipo, RsBase.SELECIONE, new { id = "iTipo", @class = "form-control obrigatorio" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iPOP">@RsCadastros.POP:</label>
                                                @Html.DropDownListFor(p => p.IdPop, new List<SelectListItem>(), new { id = "iPOP", @class = "form-control obrigatorio" })
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iIP">@RsCadastros.IP:</label>
                                                @Html.HiddenFor(p => p.Ip, new { id = "iHiddenIp" })
                                                <div id="iIP" class="ip-input">
                                                    <div class="ip-input-container form-control">
                                                        <input type="text" class="ip-input-item" value="">
                                                        <i class="ip-input-dot"></i>
                                                        <input type="text" class="ip-input-item" value="">
                                                        <i class="ip-input-dot"></i>
                                                        <input type="text" class="ip-input-item" value="">
                                                        <i class="ip-input-dot"></i>
                                                        <input type="text" class="ip-input-item" value="">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iContrato">@RsCadastros.LOGIN:</label>
                                                @Html.TextBoxFor(p => p.Login, new { id = "iLogin", @class = "form-control obrigatorio" })
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iSenha" class="mr-3">@RsCadastros.SENHA:</label><br>
                                                @Html.TextBoxFor(model => model.Senha, new { @class = "form-control obrigatorio", @id = "iSenha", @type = "password", @autocomplete = "off" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iRadius">@RsCadastros.SERVIDOR_RADIUS:</label>
                                                @Html.DropDownListFor(p => p.IdRadius, new List<SelectListItem>(), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iRadius", @autocomplete = "off" })
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="card div-card-accord mt-2">
                            <div class="card-header title-card" id="heading-2">
                                <h5 class="mb-0">
                                    <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-2" aria-expanded="true" aria-controls="collapse-2">
                                        <span class="text-bold-card">Portas de Acesso</span>
                                    </a>
                                </h5>
                            </div>
                            <div id="collapse-2" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                                <div class="card-body body-card-accord">
                                    <div class="row">
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iPortaTelnet">@RsCadastros.PORTA_TELNET:</label>
                                                @Html.TextBoxFor(p => p.PortaTelnet, new { @class = "form-control", id = "iPortaTelnet" })
                                            </div>
                                        </div>

                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iPortaApi">@RsCadastros.PORTA_API:</label>
                                                @Html.TextBoxFor(p => p.PortaAPI, new { @class = "form-control", @id = "iPortaApi", @autocomplete = "off" })
                                            </div>
                                        </div>

                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iPortaApi">@RsCadastros.PORTA_HTTP:</label>
                                                @Html.TextBoxFor(p => p.PortaHTTP, new { @class = "form-control", @id = "iPortaHttp", @autocomplete = "off" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iPortaApi">@RsCadastros.PORTA_SSH:</label>
                                                @Html.TextBoxFor(p => p.PortaSSH, new { @class = "form-control", @id = "iPortaSSH", @autocomplete = "off" })
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iPortaIncoming">@RsCadastros.PORTA_INCOMING:</label>
                                                @Html.TextBoxFor(p => p.PortaIncoming, new { @class = "form-control", @id = "iPortaIncoming", @autocomplete = "off" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>
                </div>

                <div role="tabpanel" class="tab-pane" id="iGrupoAreaLocalidade">
                    <div class="card div-card-accord mt-2">
                        <div class="card-header title-card" id="heading-2">
                            <h5 class="mb-0">
                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-2" aria-expanded="true" aria-controls="collapse-2">
                                    <span class="text-bold-card">Cadastro</span>
                                </a>
                            </h5>
                        </div>
                        <div id="collapse-2" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                            <div class="card-body body-card-accord">
                                <div class="row mt-2">

                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iGrupoArea">@RsCadastros.GRUPO_AREA:</label>
                                            @Html.DropDownListFor(model => model.Cod_Escritorio, new SelectList(ViewBag.GruposArea, "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iGrupoArea" })

                                        </div>

                                    </div>

                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iArea">@RsCadastros.AREA:</label>
                                            @Html.DropDownListFor(model => model.Cod_Area, new SelectList(ViewBag.Areas), RsBase.SELECIONE, new { @class = "form-control", @id = "iArea" })

                                        </div>
                                    </div>



                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iLocalidade">@RsCadastros.LOCALIDADE:</label>
                                            @Html.DropDownListFor(model => model.Cod_Localidade, new SelectList(ViewBag.Localidades), RsBase.SELECIONE, new { @class = "form-control", @id = "iLocalidade" })

                                        </div>
                                    </div>



                                </div>

                                <div class="text-right mt-2" style="margin-right: 100px;">
                                    <button type="button" id="btnAdicionarGrupoArea" class="btn btn-success"><i class="fas fa-check"></i> @RsCadastros.INSERIR_GRUPO_AREA</button>
                                    <a target="_blank" href="@Url.Action("Login", "Home")" onclick="ShowPageLoading(); return true;"></a>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="card div-card-accord mt-2">
                        <div class="card-header title-card" id="heading-2">
                            <h5 class="mb-0">
                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-2" aria-expanded="true" aria-controls="collapse-2">
                                    <span class="text-bold-card">Listagem de Grupos/Areas vinculados a Concentradora</span>
                                </a>
                            </h5>
                        </div>
                        <div id="collapse-2" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                            <div class="card-body body-card-accord">
                                <table class="table table-hover nowrap text-center" id="datatableGrupoArea" style="width:100%;"></table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!--Button Float-->
    <a href="@Url.Action("Index", "Concentradora")" class="float-cancel" onclick="ShowPageLoading(); return true;">
        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
            <i class="fas fa-times fa-2x"></i>
        </div>
    </a>

    <a href="#" class="float-save" onclick="return ValidaSubmit();">
        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
            <i class="fas fa-save fa-2x"></i>
        </div>
    </a>
}
