@using Sinapse.Model.enumerados
@using Microsoft.AspNet.Identity
@using Aniel.Connect.Model.enumerado
@using Aniel.Connect.Core.Helpers

@model Aniel.Connect.Models.Perfil_DashboardCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_PERFIL_DASHBORAD;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

    <script>

        var [respostasInicial, respostasGerencial] = [[],[]];

        $(document).ready(function() {

            respostasInicial = @Html.Raw(Json.Encode(Model.RespostasInicial));
            respostasGerencial= @Html.Raw(Json.Encode(Model.RespostasGerencial));

            $('#iPerfilDashBoardInicial').trigger('change');

            if (@Model.Id!= 0) {

                $('#iPerfilDashBoardInicial').prop("disabled",true);
            }
        });

        function addCheckboxInicial(i, name, checked=false) {

            var [container, nome_lista] = [$('#checksInicial'),"RespostasInicial"];

           $('<input />', { type: 'checkbox', id: nome_lista + '_' + i + '__Recurso', name: nome_lista + '[' + i + '].Recurso', checked: checked ,value: i }).appendTo(container);
           $('<label />', { 'for': nome_lista + '_' + i + '__Recurso', text: name }).appendTo(container);
           $('<br/>').appendTo(container);
        }

        $('#iPerfilDashBoardInicial').change(function () {
            $('#checksInicial').empty();
            if ($('#iPerfilDashBoardInicial option:selected').val() == 2) {
                @foreach (int i in Enum.GetValues(typeof(Dashboard_Comercial)))
                  {
                      var name = Html.Raw(HtmlEnumExtensions.GetEnumDescription<Dashboard_Comercial>(
                          Enum.Parse(typeof(Dashboard_Comercial),Convert.ToString(i)).ToString()));
                      <text>
                      var checked = respostasInicial != null ? respostasInicial.find(x => x.Recurso === @i) != undefined : "checked";
                      addCheckboxInicial(@i,'@name', checked);
                      </text>
                  }
            }
        
            if ($('#iPerfilDashBoardInicial option:selected').val() == 1) {
                @foreach (int i in Enum.GetValues(typeof(Dashboard_Inicial_Cliente)))
                  {
                      var name = Html.Raw(HtmlEnumExtensions.GetEnumDescription<Dashboard_Inicial_Cliente>(
                          Enum.Parse(typeof(Dashboard_Inicial_Cliente),Convert.ToString(i)).ToString()));
                      <text>
                      var checked = respostasInicial != null ? respostasInicial.find(x => x.Recurso === @i) != undefined : "checked";
                      addCheckboxInicial(@i,'@name', checked);
                      </text>
                  }
            }
        
            if ($('#iPerfilDashBoardInicial option:selected').val() == 3) {
                @foreach (int i in Enum.GetValues(typeof(Dashboard_Servicos)))
                  {
                      var name = Html.Raw(HtmlEnumExtensions.GetEnumDescription<Dashboard_Servicos>(
                          Enum.Parse(typeof(Dashboard_Servicos),Convert.ToString(i)).ToString()));
                      <text>
                      var checked = respostasInicial != null ? respostasInicial.find(x => x.Recurso === @i) != undefined : "checked";
                      addCheckboxInicial(@i,'@name', checked);
                      </text>
                  }
            }
        
            if ($('#iPerfilDashBoardInicial option:selected').val() == 4) {
                @foreach (int i in Enum.GetValues(typeof(Dashboard_Servicos_Modelo2)))
                  {
                      var name = Html.Raw(HtmlEnumExtensions.GetEnumDescription<Dashboard_Servicos_Modelo2>(
                          Enum.Parse(typeof(Dashboard_Servicos_Modelo2),Convert.ToString(i)).ToString()));
                      <text>
                var checked = respostasInicial != null ? respostasInicial.find(x => x.Recurso === @i) != undefined : "checked";
                addCheckboxInicial(@i, '@name', checked);
                      </text>
                  }
            }
        
        });

        var clicked = false;
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;

            var [erro, containerini, contIni] = [false, $('#checksInicial'), 0];
            var inputsini = containerini.find('input');
            for (var i = 0; i < inputsini.length; i++) {
                var nome_lista = "RespostasInicial";
                 if (inputsini[i].checked == false)
                    inputsini[i].name = "";
                else {
                    inputsini[i].name = nome_lista + '[' + contIni + '].Recurso';
                    contIni++;
                 }
            }

            if($('#iPerfilDashBoardInicial option:selected').val()=="0") {

                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PERFIL_INICIAL)", "warning");
                erro = true;
            }

            if($('#iDescricao').val() == "") {

                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DESCRICAO)", "warning");
                erro = true;
            }

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
        }
    </script>
}


@using (Html.BeginForm("Cadastro", "Perfil_Dashboard", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.Id_User, new { @Value = User.Identity.GetUserId() })

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-chart-pie"></i> @ViewBag.Title </h4>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Perfil_Dashboard")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_PERFIS_DASHBOARD</a>
                                </li>
                                <li class="breadcrumb-item"><span>@ViewBag.Title</span></li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <div id="accordion">
                    <div class="card div-card-accord">
                        <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label for="iNome">@RsCadastros.DESCRICAO:</label>
                                            @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off", @required = true, @Maxlength = 100 })
                                            @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-2 offset-4">
                                        @if (Model.Id != 0)
                                        {
                                            <div class="form-group">
                                                <label for="iStatus" class="mr-3">@RsFinanceiro.STATUS:</label><br>
                                                @Html.CheckBoxFor(model => model.Status, new { @class = "form-control", @id = "iStatus", @name = "iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-3">

                                        <div class="form-group">
                                            <label for="iPerfilDashBoardInicial">@RsCadastros.PERFIL_INICIAL:</label>
                                            @if (Model.Id != 0)
                                            {
                                                @Html.HiddenFor(model => model.Dashboard_Inicial)
                                            }
                                            @Html.EnumDropDownListFor(m => m.Dashboard_Inicial, new { @class = "form-control", id = "iPerfilDashBoardInicial" })
                                            @Html.ValidationMessageFor(model => model.Dashboard_Inicial, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-sm-3">

                                        <div id="checksInicial">

                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-2">
                                        <label for="iVisualizacao">Visualização</label>
                                        @{var visualizacaoDash = Enum.GetValues(typeof(Enum_VisualizacaoDashboard))
                                                      .OfType<Enum_VisualizacaoDashboard>()
                                                      .Select((p, i) => new SelectListItem { 
                                                          Text = HtmlEnumExtensions.GetEnumDescription(p), 
                                                          Value = Convert.ToString(Convert.ToInt32(p)), 
                                                          Selected = i == 0 })
                                                      .ToList();
                                        }
                                        @Html.DropDownListFor(p => p.VisualizacaoDashboard, visualizacaoDash, null, new {@class="form-control", @id="iVisualizacao"})
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Perfil_Dashboard")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>

    </div>

}
