@model Aniel.Connect.Models.Atividade_NfCadastroModel

@{
    /**/

    ViewBag.Title = RsCadastros.CADASTROATIVIDADENF;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion,"~/bundles/jsDataTableSimples")
    <script>
        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;
            erro = false;

            if (!$("#iCodigo").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CODIGO)", "warning")
                erro = true
            }

            if (!$("#iDescricao").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DESCRICAO)", "warning")
                erro = true
            }

            if (!$("#iTipoAtividade").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TIPO_ATIVIDADE)", "warning")
                erro = true
            }


	        if (!erro) {

                ShowPageLoading();
                $('#form').submit();
                return true;
            }

            clicked = false
            return false;
        }

    </script>
}


@using (Html.BeginForm("Cadastro", "Atividade_Nf", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                <div class="col main-title">
                    <h4 class="title-page"><i class="far fa-file-alt"></i> @ViewBag.Title</h4>
                    <nav aria-label="breadcrumb" class="mb-20">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index", "Atividade_Nf")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_ATIVIDADE_NF</a>
                            </li>
                            <li class="breadcrumb-item">
                                <span>@ViewBag.Title</span>
                            </li>

                        </ol>
                    </nav>

                    <span style="font-size:11px" id="dtLegend"></span>
                </div>
                </div>



                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iCodigo">@RsCadastros.CODIGO</label>
                                        @Html.TextBoxFor(model => model.Codigo, new { @class = "form-control", @id = "iCodigo", @autocomplete = "off",@Maxlength = 3 })
                                    </div>
                                </div>
                                <div class="col-sm-5">
                                    <div class="form-group">
                                        <label for="iTitulo">@RsCadastros.DESCRICAO:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off",@Maxlength = 40 })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iTipoAtividade">@RsCadastros.TIPO_ATENDIMENTO</label>
                                        @Html.EnumDropDownListFor(model => model.Tipo_Atividade, RsBase.SELECIONE, new { @class = "form-control", @id = "iTipoAtividade", @autocomplete = "off" })
                                    </div>
                                </div>

                                @if (Model.Id != 0)
                                {
                                    <div class="col">
                                        <div class="form-group">
                                            <label for="iStatus" class="mr-3">@RsFinanceiro.STATUS:</label><br>
                                            @Html.CheckBoxFor(model => model.Status, new { @class = "form-control", @id = "iStatus", @name = "iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>
                                }

                            </div>

                        </div>
                    </div>




                </div>



            </div>


        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Atividade_Nf")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();" >
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}