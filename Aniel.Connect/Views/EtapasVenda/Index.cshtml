                        orderable: false,
                        render: function (data, type, row, meta) {
                            var classe = getClasse(data);
                            return '<div class="' + classe + '">' + data + '</div>';
                        }
                    }
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });

            $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {
                // limpa campo de busca
                $('#txtSearch').val('');
                // desmarca checkboxes
                $('input:checkbox').prop("checked", false);

                // limpa datas (com datepicker)
                $('#iDataInicial, #iDataFinal').val('').datepicker('update');

                // percorre todos os selects dentro da modal
                $('#modal-filter select').each(function () {
                    // se for Select2 inicializado
                    if ($(this).data('select2')) {
                        $(this).val(null).trigger('change.select2');
                    } else {
                        // se for select normal
                        $(this).prop('selectedIndex', 0);
                    }
                });


                // limpa array de seleção da tabela
                rows_selected = [];

                // redesenha datatable
                oDatatable.search($('#txtSearch').val()).draw();
            });


            $("#modal-filter").on("shown.bs.modal", function () {
                AddSelect("iEstadosBrasil", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUfDesc",@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

            });

             // Popular lista de cidades

            $('#iEstadosBrasil').change(function () {
                if ($(this).val() != null) {
                    AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades",@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                }
                else {
                    $('#iCidade').select2('destroy');
                    $("#iCidade").empty();
                }

            });

            $('#iCidade').change(
                function () {
                const cidade = $('#iCidade option:selected').val();

                if ($(this).val() != null) {
                        AddSelect("iBairro", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboBairros",@CONSTANTES.PaginacaoRegistros, null, cidade, null, "@RsBase.SELECIONE", false);
                }
                else {
                    $('#iCidade').select2('destroy');
                    $("#iCidade").empty();

                    $('#iBairro').select2('destroy');
                    $("#iBairro").empty();
                }

                var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getbairros?Id_Cidade=" + cidade;

                $("#iBairro").val("");


                $('#iBairro').append($('<option></option>').attr('value', null).text('@RsBase.SELECIONE'));
                $.getJSON(enderecoApi, function (data) {
                    $.each(data, function (key, value) {
                        $('#iBairro').append($('<option></option>').attr('value', value.id).text(value.descricao));
                    })
                });
                });

            $("#iPesquisar").on("click", function () {

                $("#modal-filter").modal('hide');

                $("#iDataInicial").val($("#iDataInicial").val().replace(/\//g, "."));
                $("#iDataFinal").val($("#iDataFinal").val().replace(/\//g, "."));

                var _data_ini = $("#iDataInicial").val().split(".");
                var _data_fim = $("#iDataFinal").val().split(".");

                var data_ini = new Date(_data_ini[2], _data_ini[1] - 1, _data_ini[0]);
                var data_fim = new Date(_data_fim[2], _data_fim[1] - 1, _data_fim[0]);

                if ($('input[name = "iTipoData"]:checked').val() != "3") {
                    if ($("#iDataInicial").val() == "" || $("#iDataFinal").val() == "" ) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.SELECIONE_DATAINICIAL_DATAFINAL)", "warning");
                        return false;
                    }
                }


                if (data_ini > data_fim) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.DATA_INVALIDA)", "warning");
                }
                else {
                    rows_selected = [];
                    oDatatable.search($('#txtSearch').val()).draw();
                }

                return true;
            });

            $("#btnInativar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);

            });

            $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });


            $("#btnExcluir").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/EtapasVendaApi/excluirlista")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function (e) {

                if (oDatatable.row(this).data() != null) {

                    var _id = oDatatable.row(this).data().id;

                    var url = '@Url.Action("ClienteDadosGerais", "Venda")' + "?Id_Venda=" + _id;
                    AddAba(url, 'Cadastro de Venda');
                    e.stopPropagation();
                }

            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

            HidePageLoading();
        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

    function getClasse(status) {

        switch (status) {
            case "Aprovado":
                return "aprovado";
                break;

            case "Reprovado":
                return "reprovado";
                break;

            case "Pendente":
                return "pendente";
                break;

            case "Pendente":
                return "pendente";
                break;

            case "Aprovado Manualmente":
                return "aprovadoManualmente";
                break;

            case "Aguardando Aprovação do Gestor":
                return "aguardandoGestor";
                break;

            default:
                return "";
                break;
        }
    }


</script>
}

