                ajax: {
                    url: baseUrl + '/api/EtapasVendaApi/GetAll',
                    type: 'POST',
                    data: function (data) {

                        // Read values
                        var supervisor = $("#iSupervisor").val();

                        //Status
                        const checkDadosGerais = $("#iStatusDadosGerais").val();
                        const checkPendenciaEndereco = $("#iStatusPendenciaEndereco").val();
                        const checkPendenciaFinanceira = $("#iStatusPendenciaFinanceira").val();
                        const checkConsultaViabilidade = $("#iStatusConsultaViabilidade").val();
                        const checkTermoAdesao = $("#iStatusTermoAdesao").val();
                        const checkChecklist = $("#iStatusChecklist").val();
                        const checkConsultaCredito = $("#iStatusConsultaCredito").val();
                        const checkFinanceiro = $("#iStatusFinanceiro").val();
                        const checkResumo = $("#iStatusResumo").val();
                        const checkPlanoProduto = $("#iStatusPlanoProduto").val();
                        const checkOrdemServico = $("#iStatusOrdemServico").val();

                        let _estado = $("#iEstadosBrasil option:selected").val();
                        let _cidade = $("#iCidade option:selected").text();
                        let _bairro = $("#iBairro option:selected").text();

                        let estado = _estado != "@RsBase.TODOS" ? _estado : null;
                        let cidade = _cidade != "Selecione" ? _cidade : null;
                        let bairro = _bairro != "Selecione" ? _bairro : null;
                        var equipeVenda = $("#iEquipeVendas").val();
                        var vendedor = $("#iVendedor").val();
                        var departamento = $("#iDepartamento").val();
                        var setor_Responsavel = $("#iSetorDepartamento").val();
                        var responsavel = $("#iResponsavel").val();

                        var motivoAprovacao = $("#iAprovacaoVenda").val();


                        var vendedorParm = "@Request.Params["vendedor"]";

                        var etapa_atual = $("#iEtapaAtual").val();

                        var data_inicial = $("#iDataInicial").val();
                        var data_inicialParam = "@Request.Params["dataBusca"]";
                        var data_final = $("#iDataFinal").val();
                        var data_finalParam = "@Request.Params["dataBusca"]";

                        var tipoDataParam = "@Request.Params["dataVenda"]";


                        if ($("#iCidade option:selected").val() == "Selecione")
                            cidade = null;
                        if ($("#iBairro option:selected").val() == "Selecione")
                            bairro = null;

                        //Filtrar por venda do setor do usuario
                        @if (@AcessoHelper.TemAcesso(_areas, "206")) {
                        <text>
                        var usuario_acesso = "@User.Identity.Name";
                        var DepartamentoAcesso_Setor = 1;
                        data.AcessoUsuario = usuario_acesso;
                        data.AcessoDepartamento_Setor = DepartamentoAcesso_Setor;
                        </text>
                        }

                        //Limitar o tempo de visualização da listagem em meses
                        @if (@AcessoHelper.TemAcesso(_areas, "207")) {
                        <text>
                        var acesso_TempoVisualização = 1;
                        data.acessoTempoVisualização = acesso_TempoVisualização;

                        </text>
                        }

                        // Append to data
                        data.Supervisor = supervisor;
                        data.StatusVenda = $("#iStatusVenda option:selected").text();
                        data.MotivoAprovacao = $("#iAprovacaoVenda").val();
                        data.Estado = estado;
                        data.Cidade = cidade;
                        data.Bairro = bairro;
                        data.EquipeVenda = equipeVenda;
                        data.Departamento = departamento;
                        data.Setor_Responsavel = setor_Responsavel;
                        data.Responsavel = responsavel;

                        data.Vendedor = vendedor == null ? vendedorParm : vendedor;
                        data.Etapa_Atual = etapa_atual;
                        data.Data_Inicial = data_inicial == "" ? data_inicialParam : data_inicial;
                        data.Data_Final = data_final == "" ? data_finalParam : data_final;

                        data.StatusDadosGerais = checkDadosGerais;
                        data.StatusPendenciaEndereco = checkPendenciaEndereco;
                        data.StatusPendenciaFinanceira = checkPendenciaFinanceira;
                        data.StatusConsultaViabilidade = checkConsultaViabilidade;
                        data.StatusTermoAdesao = checkTermoAdesao;
                        data.StatusChecklist = checkChecklist;
                        data.StatusConsultaCredito = checkConsultaCredito;
                        data.StatusFinanceiro = checkFinanceiro;
                        data.StatusResumo = checkResumo;
                        data.StatusPlanoProduto = checkPlanoProduto;
                        data.StatusOrdemServico = checkOrdemServico;
                    },
                    error: function (e) {
                        var errorMessage = "Ocorreu um erro.";
                        try {
                            var response = JSON.parse(e.responseText);
                            if (response && response.exceptionMessage) {
                                errorMessage = response.exceptionMessage;
                            }
                        } catch (ex) {
                            console.error("Erro: ", ex);
                        }
                        Notificar("@RsBase.ATENCAO_", errorMessage, "warning");
                        HidePageLoading();
