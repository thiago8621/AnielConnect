@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@model Aniel.Connect.Models.EtapasVenda_ListModel

@{
    ViewBag.Title = RsCadastros.PAINEL_ETAPAS_VENDA;
    ViewBag.Sessao = RsCadastros.COMERCIAL;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;



    //listaEtapas
    List<Aniel.Connect.Core.ObjComboResult<String>> listaEtapas = new List<Aniel.Connect.Core.ObjComboResult<String>>();
    foreach (var valor in Enum.GetValues(typeof(EnumEtapaVenda)))
    {
        string descricao = HtmlEnumExtensions.GetEnumDescription(valor);
        listaEtapas.Add(new Aniel.Connect.Core.ObjComboResult<string>
        {
            Id = Convert.ToInt32(valor).ToString(),
            Text = descricao
        });
    }
    listaEtapas = listaEtapas.OrderBy(x => x.Text).ToList();
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />
    <style>

        .divStatus{
            margin-bottom: 10px !important;
        }

        .pendente {
            background-color: #848284;
            color: white;
            text-align: center;
        }

        .aprovado {
            background-color: #57B96D;
            color: white;
            text-align: center;
        }

        .reprovado {
            background-color: #DB3B3B;
            color: white;
            text-align: center;
        }

        .aprovadoManualmente {
            background-color: #007BFF;
            color: white;
            text-align: center;
        }

        .aguardandoGestor {
            background-color: #FCE405;
            color: black;
            text-align: center;
        }

        .divLegenda {
            border-width: 1px;
            border-style: solid;
            border-color: dimgrey;
            border-radius: 10px;
        }

        .pagination {
            position: relative;
            margin-left: 30px !important;
            margin-right: 25px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }

        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }

        div.dataTables_wrapper {
            width: 100% !important;
            overflow-x: hidden; /* evita scroll extra */
        }

        #datatable_container {
            overflow-x: hidden;
        }

        th[class^="no-sort-"].sorting::before,
        th[class^="no-sort-"].sorting::after,
        th[class^="no-sort-"].sorting_asc::before,
        th[class^="no-sort-"].sorting_asc::after,
        th[class^="no-sort-"].sorting_desc::before,
        th[class^="no-sort-"].sorting_desc::after {
            display: none !important;
        }
    </style>

}


