        var handleDataTableFiltro = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Filtros));

           var nome_lista = "Filtros";//Nome_utilizado para enganar o razor

           //"Blfrtip"
            oDatatable = $("#datatableFiltros").length && $("#datatableFiltros").DataTable({
           dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                paging: false,
                drawCallback: () => {
                    handleExcluir();

                },
                order: [],
                columns: [
                    {
               data: "Id",
                        render: function (data, type, row, meta) {
                       @if(AcessoHelper.TemAcesso(_areas, "169"))
                            {
                                <text>
                                    return '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                           ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                           ' <input id="' + nome_lista + '_' + meta.row + '__Filtro" name="' + nome_lista + '[' + meta.row + '].Filtro" type="hidden" value="' + TrataNulo(row.Filtro) + '">' +
                                           ' <input id="' + nome_lista + '_' + meta.row + '__ValorPai" name="' + nome_lista + '[' + meta.row + '].ValorPai" type="hidden" value="' + TrataNulo(row.ValorPai) + '">' +
                                           ' <input id="' + nome_lista + '_' + meta.row + '__ValorAvo" name="' + nome_lista + '[' + meta.row + '].ValorAvo" type="hidden" value="' + TrataNulo(row.ValorAvo) + '">' +
                                           ' <input id="' + nome_lista + '_' + meta.row + '__Valor" name="' + nome_lista + '[' + meta.row + '].Valor" type="hidden" value="' + TrataNulo(row.Valor) + '">';
                                </text>
                            }
                            else
                       {
                                <text>
                                    return ''
                                </text>
                            }
                   }
               },
                    {
               data: "Filtro_Descricao",
                        title: "Tipo de Filtro",
                        render: function (data, type, row, meta) {
                       if (type === 'display') {
                           data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Filtro_Descricao" name="' + nome_lista + '[' + meta.row + '].Filtro_Descricao" type="hidden" value="' + TrataNulo(data) + '">';
                       }
                       return data;
                   }
               },
                    {
               data: "Descricao",
                        title: "Descricao",
                        render: function (data, type, row, meta) {
                       if (type === 'display') {
                           data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Descricao" name="' + nome_lista + '[' + meta.row + '].Descricao" type="hidden" value="' + TrataNulo(data) + '">';
                       }
                       return data;
                   }
               }
                ]
            });

            function handleExcluir() {
                $(".btnExcluir").unbind('click');
                $(".btnExcluir").click(async function (e) {
                   e.preventDefault();

                   var idFiltro = $(this).attr("excluir");

                   var trLinkButton = $(this).parents('tr');

                   if (idFiltro === "0") {
                       oDatatable.row(trLinkButton).remove().draw(false);
                       Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                   }
                   else {

                       var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Modelo_PainelServicoApi/ExcluirGridFiltro?value=")' + idFiltro;

                      await $.ajax({
                       url: link,
                            type: 'GET',
                            dataType: 'json',

                       })
                            .done(function (data) {

                           if (data.ok) {
                               oDatatable.row(trLinkButton).remove().draw(false);
                               Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                           }
                           else {
                               Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                           }
                       })
                            .fail(function () {

                       })
                            .always(function () {

                       });
                   }

                    let records = oDatatable.rows().data().toArray();
                    reorderRecords(records);
               });
           }

           handleExcluir();

$("#btnAdicionar").on('click', function () {

    var erro = false;
    var tipoFiltro = $("#iTipoFiltro option:selected").val();

    // LÓGICA DE VALIDAÇÃO DE STATUS (Seu código original, mantido)
    var tabledata = $('#datatableFiltros').DataTable().rows().data();
    for (let i = 0; i < tabledata.length; i++) {
        if (tabledata[i].Filtro_Descricao == "Status" && tabledata[i].Descricao === $('#iFiltro option:selected').text()) {
            if (tabledata[i].Filtro_Descricao === $('#iTipoFiltro option:selected').text()) {
                Notificar("@RsBase.ATENCAO_", "O filtro " + $('#iTipoFiltro option:selected').text() + " já foi adicionado, favor verificar.", "warning");
                erro = true;
                break;
            }
        }
    }

    if (!$("#iTipoFiltro").val()) {
        Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
        return false;
    }


    /* *************************************************************** */
    /* BLOCO CENTRAL CONSOLIDADO: VALIDAÇÃO E DEFINIÇÃO DE lista_filtros */
    /* *************************************************************** */
    let lista_filtros = [];
    let ValorPai = $("#iFiltroPai").val();
    let ValorAvo = $("#iFiltroAvo").val();
    let isTextoLivreUsuario = false;

    // 1. Definição da lista_filtros e Validação de Obrigatoriedade
    if (tipoFiltro === "20") {
        // LÓGICA PARA FILTRO DE USUÁRIO (TIPO 20)
        var tipoEntrada = $('input[name="TipoEntradaUsuario"]:checked').val();
        var valorTextoLivre = $("#iFiltroTextoLivre").val().trim();

        if (tipoEntrada == "1") { // Lista de Seleção
            lista_filtros = $("#iFiltro").select2('data');
            if (lista_filtros.length === 0) {
                 Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                 return false;
            }
        } else if (tipoEntrada == "2") { // Texto Livre
            if (valorTextoLivre) {

                lista_filtros = [{ id: valorTextoLivre, text: `${valorTextoLivre}` }];
                isTextoLivreUsuario = true;


            } else {
                // Se for Texto Livre e o campo estiver vazio
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                return false;
            }
        }
    } else {
        // LÓGICA PARA TODOS OS OUTROS FILTROS
        lista_filtros = $("#iFiltro").select2('data');
        if (lista_filtros.length === 0) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS ", "warning");
            return false;
        }
    }

    // 2. VALIDAÇÃO DE DUPLICIDADE (Ajustada para usar a flag 'isTextoLivreUsuario')
    if (isTextoLivreUsuario) {
    // Lógica Específica para Texto Livre: Checar se o texto já está na lista.
    // Como a lista_filtros só tem 1 item (o texto livre), pegamos ele direto.
    var textoAdicionar = lista_filtros[0].id; // Ex: "Joao"

    // Checa todos os itens já adicionados na DataTable
    for (var i = 0; i < oDatatable.rows().data().length; i++) {
        var linha = oDatatable.rows().data()[i];

        // Verifica se o valor (texto) já existe E se é do mesmo tipo de filtro
        if (linha.Valor == textoAdicionar && linha.Filtro == tipoFiltro) {
            Notificar("@RsBase.ATENCAO_", `O valor em texto livre "${textoAdicionar}" já foi adicionado na lista.`, "warning");
            erro = true;
            break;
        }
    }
}
    else{
        for (const filtro of lista_filtros) {
            for (var i = 0; i < oDatatable.rows().data().length; i++) {

                if ((oDatatable.rows().data()[i].Valor == filtro.id && oDatatable.rows().data()[i].Filtro == tipoFiltro &&
                    ValorPai == oDatatable.rows().data()[i].ValorPai && ValorAvo == oDatatable.rows().data()[i].ValorAvo)) {

                    Notificar("@RsBase.ATENCAO_", `Um ou mais valores para o filtro ${$("#iTipoFiltro option:selected").text()} já foram adicionados a lista abaixo, para o modelo. Favor verificar os valores.`, "warning");
                    erro = true;
                    i = oDatatable.rows().data().length;
                    break;
                }
            }
            if (erro) break;
        }
    }
    /* *************************************************************** */
    /* FIM DO BLOCO CENTRAL                                            */
    /* *************************************************************** */


    if (erro) {
        return;
    }

    // 3. INCLUSÃO FINAL NA DATATABLE (Este loop funciona porque lista_filtros está preenchida)
    for (const filtro of lista_filtros) {

        oDatatable.row.add({
            Id: 0,
            Valor: filtro.id,
            ValorPai: ValorPai,
            ValorAvo: ValorAvo,
            Descricao: filtro.text,
            Filtro: $("#iTipoFiltro option:selected").val(),
            Filtro_Descricao: $("#iTipoFiltro option:selected").text()
        }).draw(false);

        handleExcluir();
    }

    $("#iFiltro").val("").trigger('change');
    $("#iTipoFiltro").val("").trigger('change');
    $("#divTextoLivreUsuario").hide;
    let records = oDatatable.rows().data().toArray();
    reorderRecords(records);
});
        },

