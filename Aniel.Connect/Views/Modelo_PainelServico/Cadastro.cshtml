    function reorderRecords(records = []) {
        if (records.length > 0) {
            oDatatable.clear();
            for (let record of records) {

                oDatatable.row.add({
                    Id: record.Id,
                    Valor: record.Valor,
                    ValorPai: record.ValorPai,
                    ValorAvo: record.ValorAvo,
                    Descricao: record.Descricao,
                    Filtro: record.Filtro,
                    Filtro_Descricao: record.Filtro_Descricao

                });
            }
        }
        oDatatable.draw(false);
    }
