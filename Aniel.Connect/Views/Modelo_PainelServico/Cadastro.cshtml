@model Aniel.Connect.Models.Modelo_PainelServicoCadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Aniel.Connect.Models.T5
@using Aniel.T5.Model.enumerado

@{
    ViewBag.Title = RsCadastros.CADASTRO_MODELOS_VIZUALICACAO_PAINEL_SERVICO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@using (Html.BeginForm("Cadastro", "Modelo_PainelServico", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-cogs"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Gestao_Equipe")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GESTAO_EQUIPES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Painel_Servicos")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_SERVICOS</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Modelo_PainelServico")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GERENCIAR_MODELOS_VIZUALICACAO_PAINEL_SERVICO</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>

                        @*<span style="font-size:11px" id="dtLegend"></span>*@
                    </div>
                </div>

                <!--Nav Tab-->
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="sobre-tab" data-toggle="tab" href="#iSobre" role="tab" aria-controls="sobre" aria-selected="true"><i class="fas fa-clipboard"></i> Sobre</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="filtros-tab" data-toggle="tab" href="#iFiltros" role="tab" aria-controls="filtros" aria-selected="false"><i class="fas fa-filter"></i> Filtros</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="colunas-tab" data-toggle="tab" href="#iColunas" role="tab" aria-controls="colunas" aria-selected="false"><i class="fas fa-columns"></i> Colunas</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane active" id="iSobre">
                        <div class="card div-card-accord">
                            <div class="card-header title-card" id="heading-1">
                                <h5 class="mb-0">
                                    <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                        <span class="text-bold-card">Sobre</span>
                                    </a>
                                </h5>
                            </div>

                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body body-card-accord">
                                    <div class="row mt-2 mb-2">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iDescricao" class="mr-3">@RsFinanceiro.DESCRICAO:</label>
                                                @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control obrigatorio", @id = "iDescricao", @autocomplete = "off", @required = true })
                                                @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        @if (Model.Id != 0)
                                        {
                                            if (AcessoHelper.TemAcesso(_areas, "171"))
                                            {
                                                <div class="col-sm-3 pt-3">
                                                    <div class="form-group">
                                                        <label for="iStatus" class="mr-3">@RsFinanceiro.STATUS:</label>
                                                        @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                                    </div>
                                                </div>
                                            }
                                            @*
                                                Se o usuário não possuir a área de acesso 171 ele não poderá alterar o status.
                                                Como checkboxes não possuem suporte ao atributo readonly, para evitar que o status
                                                seja sobrescrito, utilizamos uma checkbox apenas para visualização do usuário e deixamos
                                                o real valor do status em um input hidden
                                            *@
                                            else
                                            {
                                                @Html.CheckBoxFor(m => m.Status, new { style = "display: none" })

                                                <div class="col-sm-3 pt-3">
                                                    <div class="form-group">

                                                        @if (Model.Status)
                                                        {
                                                            <input type="checkbox"
                                                                   class="form-control"
                                                                   data-toggle="toggle"
                                                                   data-on="Ativo"
                                                                   data-off="Inativo"
                                                                   data-onstyle="success"
                                                                   data-offstyle="light"
                                                                   disabled
                                                                   checked />
                                                        }
                                                        else
                                                        {
                                                            <input type="checkbox"
                                                                   class="form-control"
                                                                   data-toggle="toggle"
                                                                   data-on="Ativo"
                                                                   data-off="Inativo"
                                                                   data-onstyle="success"
                                                                   data-offstyle="light"
                                                                   disabled />
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>

                                    <div class="row mt-2 mb-2">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label>@RsCadastros.VISIBILIDADE:</label>
                                                @Html.EnumDropDownListFor(m => m.Visibilidade, RsBase.SELECIONE, new { @class = "form-control", @id = "iVisibilidade" })
                                            </div>
                                        </div>
                                    </div>

                                </div>


                            </div>
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane" id="iFiltros">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="card div-card-accord">
                                    <div class="card-header title-card" id="heading_6">
                                        <h5 class="mb-1">
                                            <a role="button">
                                                <span class="text-bold-card">Adicionar Filtro</span>
                                            </a>
                                        </h5>
                                    </div>
                                    <div class="card-body">


                                        <div class="form-group col-sm-3">
                                            <label for="iTipoFiltro">@RsBase.TIPO_FILTRO:</label>
                                            @Html.EnumDropDownListFor(m => m.TipoFiltro, RsBase.SELECIONE, new { @class = "form-control obrigatorioFiltro", id = "iTipoFiltro" })
                                        </div>

                                        <div class="form-group col-sm-3">
                                            <label id="iFiltroAvoLabel" for="iFiltroAvo" style="display:none">@RsBase.FILTRO:</label>
                                            <select id="iFiltroAvo" style="display:none" class="form-control">
                                                <option value="">@RsBase.SELECIONE</option>
                                            </select>
                                        </div>
                                        @* NOVO BLOCO HTML/RAZOR: OPÇÕES DE FILTRO PARA "USUÁRIO DE ABERTURA DA OS" *@
                                        <div id="divOpcoesUsuarioAberturaOS" style="display: none; ">
                                            <div class="form-check">

                                                @* Valor 1: Lista de Seleção (Comportamento existente) *@
                                                @Html.RadioButton("TipoEntradaUsuario", 1, true, new { @class = "form-check-input", @id = "rbListaSelecao", @onclick = "toggleFiltroUsuarioAberturaOS(1);" })
                                                <label class="form-check-label fs-12" for="rbListaSelecao">Lista de Seleção</label>

                                            </div>

                                            <div class="form-check">
                                                @* Valor 2: Texto Livre (Novo Comportamento) *@
                                                @Html.RadioButton("TipoEntradaUsuario", 2, false, new { @class = "form-check-input", @id = "rbTextoLivre", @onclick = "toggleFiltroUsuarioAberturaOS(2);" })
                                                <label class="form-check-label fs-12" for="rbTextoLivre">Texto Livre</label>
                                            </div>

                                            @* Campo de Texto Livre, visível apenas se "Texto Livre" for selecionado *@
                                            <div id="divTextoLivreUsuario" class="form-group col-sm-3" style="display: none;">
                                                <label for="iFiltroTextoLivre">@RsBase.FILTRO (Texto Livre)</label>
                                                <input type="text" id="iFiltroTextoLivre" class="form-control" placeholder="Digite o nome ou ID do usuário" />
                                            </div>
                                        </div>
                                        @* FIM NOVO BLOCO *@@* NOVO BLOCO HTML/RAZOR: OPÇÕES DE FILTRO PARA "USUÁRIO DE ABERTURA DA OS" *@

                                        <div class="form-group col-sm-3">
                                            <label id="iFiltroPaiLabel" for="iFiltroPai" style="display:none">@RsBase.FILTRO:</label>
                                            <select id="iFiltroPai" style="display:none" class="form-control">
                                                <option value="">@RsBase.SELECIONE</option>
                                            </select>
                                        </div>

                                        <div class="form-group col-sm-3" id="diviFiltro">
                                            <label id="lblFiltro" for="iFiltro">@RsBase.FILTRO:</label>
                                            <select id="iFiltro" class="form-control obrigatorioFiltro">
                                                <option value="">@RsBase.SELECIONE</option>
                                            </select>

                                            <br />

                                        </div>
                                        <div class="text-right mt-3">
                                            <input type="button" id="btnAdicionar" class="btn btn-success" value="Adicionar" />
                                        </div>


                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-sm-12">
                                <div class="card div-card-accord">
                                    <div class="card-header title-card" id="heading_6">
                                        <h5 class="mb-1">
                                            <a role="button">
                                                <span class="text-bold-card">Lista de Filtros</span>
                                            </a>
                                        </h5>
                                    </div>
                                    <div class="card-body">

                                        <table class="table table-hover nowrap" id="datatableFiltros" style="width:100%"></table>

                                    </div>


                                </div>

                            </div>



                        </div>

                    </div>
                    <div role="tabpanel" class="tab-pane" id="iColunas">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="card div-card-accord">
                                    <div class="card-header title-card" id="heading_6">
                                        <h5 class="mb-1">
                                            <a role="button">
                                                <span class="text-bold-card">Colunas Disponíveis</span>
                                            </a>
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-hover nowrap" id="datatableColunasAdicionar" style="width:100%"></table>
                                    </div>


                                </div>

                            </div>
                            <div class="col-sm-6">
                                <div class="card div-card-accord">
                                    <div class="card-header title-card" id="heading_6">
                                        <h5 class="mb-1">
                                            <a role="button">
                                                <span class="text-bold-card">Colunas Adicionadas</span>
                                            </a>
                                        </h5>
                                    </div>
                                    <div class="card-body">

                                        <div class="row mt-2">
                                            <div class="col-sm-7">
                                                <div class="form-group ">
                                                    <label for="iColuna_Ordenar">Ordenar por:</label>
                                                    @Html.EnumDropDownListFor(m => m.Coluna_Ordenar, RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iColuna_Ordenar" })
                                                </div>
                                            </div>
                                        </div>

                                        <table class="table table-hover nowrap" id="datatableColunas" style="width:100%"></table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Modelo_PainelServico")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        @if (AcessoHelper.TemAcesso(_areas, "169"))
        {
            <a href="#" class="float-save" onclick="return ValidaSubmit();">
                <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                    <i class="fas fa-save fa-2x"></i>
                </div>
            </a>
        }

    </div>
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script>
        @* Caso o usuário não possua a área de acesso 169 ele não poderá editar o modelo do painel acessado *@

        @if(!AcessoHelper.TemAcesso(_areas, "169"))
        {
            <text>
                @* Tab Sobre *@
                $("#iDescricao").prop("disabled", true);
                $("#iVisibilidade").prop("disabled", true);
                $("#iStatus").prop("disabled", true);

                @* Tab Filtros *@
                $("#iTipoFiltro").prop("disabled", true);
                $("#iFiltro").prop("disabled", true);

                $("#btnAdicionar").prop("disabled", true);
                $("#btnAdicionar").hide();

                @* Tab Colunas *@
                $("#iColuna_Ordenar").prop("disabled", true)
            </text>
        }

      @if (!AcessoHelper.TemAcesso(_areas, "162"))
       {
        <text>
                $("#iVisibilidade option[value=1]").remove();
        </text>
       }

          var clicked = false;

    function limparSelect2(id) {
        if ($(`#${id}`).data('select2')) {
                $(`#${id}`).select2('destroy');
            }

            $(`#${id}`).empty();
        }

        let HandleTipoServico = function () {
            $('#iFiltroPai').on('select2:select select2:unselecting', function (e) {
                           let TipoServico = e.params.data
                if (TipoServico) {
                    $('#iFiltro').prop("disabled", false);
                               AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, TipoServico.id, null, "@RsBase.SELECIONE", false ,HandleFiltro);
                           }
                           else {
                    $('#iFiltro').prop("disabled", true);
                               AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true ,HandleFiltro);
                           }
                       });
                   };

                   let HandleContratoProjeto = function () {
            $('#iFiltroPai').on('select2:select select2:unselecting', function (e) {
                           let Contrato = e.params.data
                if (Contrato) {
                    $('#iFiltro').prop("disabled", false);
                               AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, Contrato.id, null, "@RsBase.SELECIONE", false ,HandleFiltro);
                           }
                           else {
                    $('#iFiltro').prop("disabled", true);
                               AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true ,HandleFiltro);
                           }
                       });
                   };

                   let HandleContratoEncerramento = function () {
            $('#iFiltroPai').on('select2:select select2:unselecting', function (e) {
                           let Contrato = e.params.data
                if (Contrato) {
                    $('#iFiltro').prop("disabled", false);
                               AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/Documento_Producaoapi/GetComboCodigoEncerramento", @CONSTANTES.PaginacaoRegistros, null, Contrato.id, null, "@RsBase.SELECIONE", false ,HandleFiltro);
                           }
                           else {
                    $('#iFiltro').prop("disabled", true);
                               AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/Documento_Producaoapi/GetComboCodigoEncerramento", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true ,HandleFiltro);
                           }
                       });
                   };

                   let HandleGrupoArea = function () {
            $('#iFiltroPai').on('select2:select select2:unselecting', function (e) {
                           let GrupoArea = e.params.data
                if (GrupoArea) {
                    $('#iFiltro').prop("disabled", false);
                               AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/Areaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, GrupoArea.id, null, "@RsBase.SELECIONE", false ,HandleFiltro);
                           }
                           else {
                    $('#iFiltro').prop("disabled", true);
                               AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/Areaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true ,HandleFiltro);
                           }
                       });
                   };

                   let HandleGrupoArea_Localidade = function () {
            $('#iFiltroAvo').on('select2:select select2:unselecting', function (e) {
                           let GrupoArea = e.params.data
                if (GrupoArea) {
                    $('#iFiltroPai').prop("disabled", false);
                               AddSelect("iFiltroPai", "@CONSTANTES.URLPortal/api/Areaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, GrupoArea.id, null, "@RsBase.SELECIONE", false, HandleArea);
                           }
                           else {
                    $('#iFiltro').prop("disabled", true);
                    $('#iFiltroPai').prop("disabled", true);
                               AddSelect("iFiltroPai", "@CONSTANTES.URLPortal/api/Areaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                           }
                       });
                   };

                   let HandleArea = function () {
            $('#iFiltroPai').on('select2:select select2:unselecting', function (e) {
                           let Area = e.params.data
                if (Area) {
                    $('#iFiltro').prop("disabled", false);
                               AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iFiltroAvo').val(), Area.id, null, "@RsBase.SELECIONE", false ,HandleFiltro);
                           }
                           else {
                    $('#iFiltro').prop("disabled", true);
                               AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false ,HandleFiltro);
                           }
                       });
                   };

                   let HandleEmpresa = function () {
            $('#iFiltroPai').on('select2:select select2:unselecting', function (e) {
                           let Empresa = e.params.data
                if (Empresa) {
                    $('#iFiltro').prop("disabled", false);
                               AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/FilialApi/GetComboFilialAniel", @CONSTANTES.PaginacaoRegistros, null, Empresa.id, null, "@RsBase.SELECIONE", false ,HandleFiltro);
                           }
                           else {
                    $('#iFiltro').prop("disabled", true);
                               AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/FilialApi/GetComboFilialAniel", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true ,HandleFiltro);
                           }
                       });
                   };



                   function handleAdicionar() {
            $(".btnAdicionarColuna").unbind('click');
            $(".btnAdicionarColuna").click(function (e) {
                           e.preventDefault();

                           var Coluna = $(this).attr("adicionar");
                           var Descricao = $(this).attr("descricao");

                           var trLinkButton = $(this).parents('tr');

                           oDatatableColunas.row.add({
                              Descricao: Descricao,
                              Coluna: Coluna,
                              Id: 0
                           }).draw(false);
                   handleExcluirColuna();

                   oDatatableColunasAdicionar.row(trLinkButton).remove().draw(false);
                   Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROADICIONADO", "info");

                let records = oDatatableColunas.rows().data().toArray();
                reorderRecordsColuna(records);
            });

            }

           function HandleFiltro() {
            $('#iFiltro').on('select2:select select2:unselecting', function (e) {
                   let alturaSelect2 = $(".select2-selection--multiple").height();
                //$("#btnAdicionar").css('margin-top',alturaSelect2 + 15);
                $("#diviFiltro").height(alturaSelect2 + 30);
               });
           };

           function handleExcluirColuna() {
                $(".btnExcluirColuna").unbind('click');
                $(".btnExcluirColuna").click(async function (e) {
                   e.preventDefault();

                   var idColuna = $(this).attr("excluir");
                   var Coluna = $(this).attr("coluna");
                   var Descricao = $(this).attr("descricao");

                   var trLinkButton = $(this).parents('tr');

                   if (idColuna === "0") {
                       oDatatableColunas.row(trLinkButton).remove().draw(false);
                       Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                       oDatatableColunasAdicionar.row.add({
                       Descricao: Descricao,
                            Coluna: Coluna
                        }).draw(false);
                       handleAdicionar();
                   }
                   else {

                       var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Modelo_PainelServicoApi/ExcluirGridColuna?value=")' + idColuna;

                       await $.ajax({
                       url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                           if (data.ok) {
                               oDatatableColunas.row(trLinkButton).remove().draw(false);
                               Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");

                               oDatatableColunasAdicionar.row.add({
                               Descricao: Descricao,
                                        Coluna: Coluna
                                    }).draw(false);
                               handleAdicionar()

                                }
                           else {
                               Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                           }
                       })
                            .fail(function () {

                       })
                            .always(function () {

                       });
                   }
                    let records = oDatatableColunas.rows().data().toArray();
                    reorderRecordsColuna(records);
               });
           }

        $('#iTipoFiltro').change(function () {

            var val = $('#iTipoFiltro').val();

            limparSelect2("iFiltroPai");
            limparSelect2("iFiltroAvo");
            $('#iFiltro').show();
            $('#diviFiltro').show(); 
            $('#iFiltroPaiLabel').hide();
            $('#iFiltroPai').hide();
            $('#iFiltroAvoLabel').hide();
            $('#iFiltroAvo').hide();
            $('#iFiltro').prop("disabled", false);

            if (val) {
                $('#iFiltro').attr("multiple", "multiple");
                $('#iFiltro').prop('disabled', false);
            }
            else {
                $('#iFiltro').prop('disabled', true);
                $('#iFiltro').removeAttr("multiple");
                limparSelect2('iFiltro');
            }

            $("#divOpcoesUsuarioAberturaOS").hide();
            switch (val) {
                case "0":
                    AddSelect("iFiltro", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleFiltro);
                    break;
                case "1":
