       TableManageButtonsFiltro.init();
       var oDatatableColunasAdicionar

        var handleDataTableColunasAdicionar = function () {
           "use strict";

           var array = @(Html.GetArrayEnum<Coluna_PainelServicoEnum>());
           var enum_values = @(Json.Encode(Enum.GetValues(typeof (Coluna_PainelServicoEnum)).Cast<Coluna_PainelServicoEnum>()));@*@Html.Raw(Json.Encode(Model.Filtros))*@;
            array = array.map((p, i) => ({ Descricao: p, Coluna: enum_values[i] }));
            var array_adicionadas = @Html.Raw(Json.Encode(Model.Colunas));

            array = array.filter(p => array_adicionadas.map(y => y.Coluna).filter(y => y == p.Coluna).length == 0);

            oDatatableColunasAdicionar = $("#datatableColunasAdicionar").length && $("#datatableColunasAdicionar").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                order: [],
                paging: false,
                columns: [
                    {
                        data: "Descricao",
                        render: function (data, type, row, meta) {
                            @if(AcessoHelper.TemAcesso(_areas, "169"))
                            {
                                <text>
                                    if (type === 'display') {
                                        data = '<a href="#" class="btnAdicionarColuna p-3" descricao="' + data + '" id="btnAdicionarColuna_' + meta.row + '" adicionar="' + row.Coluna + '"><i class="fas fa-plus-circle PR-2" style="font-size:16px;"></i></a>   ' + data ;
                                    }
                                </text>
                            }

                            return data;
                        }
                    }
                ]
            });

            handleAdicionar();

        },
            TableManageColunasAdicionar = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableColunasAdicionar();
                    }
                }
            }();

        TableManageColunasAdicionar.init();

    function reorderRecordsColuna(records = []) {
        if (records.length > 0) {
            oDatatableColunas.clear();
            for (let record of records) {

                oDatatableColunas.row.add({
                    Id: record.Id,
                    Coluna: record.Coluna,
                    Descricao: record.Descricao
                });
            }
        }
        oDatatableColunas.draw(false);
    }

    var oDatatableColunas;

        var handleDataTableColunas = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Colunas));

            var nome_lista = "Colunas";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            oDatatableColunas = $("#datatableColunas").length && $("#datatableColunas").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                paging: false,
                drawCallback: () => {
                    handleExcluirColuna();
                },
                order:[],
                columns: [
                    {
                        data: "Id",
                        orderable:false,
                        render: function (data, type, row, meta) {
                            @if(AcessoHelper.TemAcesso(_areas, "169"))
                            {
                                <text>
                                    return '<a href="#" class="btnExcluirColuna" descricao="' + row.Descricao + '" coluna="' + row.Coluna + '" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                           ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                           ' <input id="' + nome_lista + '_' + meta.row + '__Coluna" name="' + nome_lista + '[' + meta.row + '].Coluna" type="hidden" value="' + TrataNulo(row.Coluna) + '">';
                                </text>
                            }
                            else
                            {
                                <text>
                                    return "";
                                </text>
                            }

                        }
                    },
                    {
                        data: "Descricao",
                        orderable: false,
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Descricao" name="' + nome_lista + '[' + meta.row + '].Descricao" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    }
                ]
            });


            handleExcluirColuna();



        },
            TableManageButtonsColunas = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableColunas();
                    }
                }
            }();

        TableManageButtonsColunas.init();



    function ValidaSubmit() {
        if (clicked) {
            return false;
        }

        clicked = true;

        erro = false;

        if (ValidaCamposObrigatorios(erro)) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
            erro = true
        }

        if ($("#datatableFiltros").DataTable().data().toArray().filter(p => [22, 23, 24, 27].includes(p.Filtro) || ["22", "23", "24", "27"].includes(p.Filtro)).length == 0)
        {
            Notificar("@RsBase.ATENCAO_", "É necessário adicionar no mínimo um filtro de data", "warning");
            erro = true;
        }

            if (oDatatableColunas.data().toArray().length < 2) {
                Notificar("@RsBase.ATENCAO_", "É necessário adicionar no mínimo duas colunas para visualização do painel", "warning");
                erro = true;
            }
            if (oDatatableColunas.data().toArray().map(p => p.Coluna).filter(p => p == $('#iColuna_Ordenar').val()).length == 0) {
                Notificar("@RsBase.ATENCAO_", "A  coluna de ordenação deve ser adicionada nas colunas de visualização do painel", "warning");
                erro = true;
            }

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }


    </script>
}