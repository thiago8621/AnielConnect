@model Aniel.Connect.Models.WebHookCadastroModel
@using Resources
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Sinapse.Model.enumerados


@{
    /**/

    ViewBag.Title = RsCadastros.CADASTRO_WEBHOOK;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;

}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script>


        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

	        if (erro) {
                clicked = false;
                return false;
            }


            if (@Json.Encode(AcessoHelper.TemAcesso(_areas, "185"))) {
                        ShowPageLoading();
                        $('#form').submit();
	                    return true;
                        $("#btnsalvar").prop("href", "@Url.Action("Index", "Webhook")");
                }
            else
            {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.USUARIO_SEMACESSO_185, "185")", "warning");
            }

        }

    </script>
}


@using (Html.BeginForm("Cadastro", "Webhook", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-code-branch"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Webhook")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_WEBHOOK</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>



                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="row">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iType">@RsCadastros.DESCRICAO:</label>
                                        @Html.EnumDropDownListFor(model => model.Type, new { @class = "form-control", @id = "iType", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Type, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iUrl">@RsCadastros.URL:</label>
                                        @Html.TextBoxFor(model => model.Url, new { @class = "form-control", @id = "iUrl", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Url, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                @if (Model.Id != 0)
                                {
                                    <div class="form-group offset-6">
                                        <label for="iStatus" class="mr-3">@RsFinanceiro.STATUS:</label><br>
                                        @Html.CheckBoxFor(model => model.Status, new { @class = "form-control", @id = "iStatus", @name = "iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                    </div>
                                }

                            </div>

                        </div>
                    </div>




                </div>



            </div>


        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Webhook")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar" id="btnsalvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}