@model Aniel.Connect.Models.ProgramacaoRoteirizacaoAutomaticaCadastroModel
@using Resources
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@{
    ViewBag.Title = RsCadastros.CADASTRO_PROGRAMACAO_AUTOMATICA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    //List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    <style>
        .toggle btn btn-success {
            height: 23px !important;
        }
    </style>

}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script>
        ///<reference path="../../../../AnielConnectCore/Aniel.Connect.Core/Scripts/connect.js" />

    $(".hora").mask('00:00', { reverse: true });
    $(document).ready(function () {

        AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupo);
        AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
        AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        AddSelect("iCategoriaCliente", "@CONSTANTES.URLPortal/api/Categoria_ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, @Html.Raw(Json.Encode(Model.Categorias.Select(p => p.IdCategoria))), "@RsBase.SELECIONE", false);
        AddSelect("iNaturezaServico", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, @Html.Raw(Json.Encode(Model.Naturezas.Select(p => p.IdNaturezaProducao))), "@RsBase.SELECIONE", false, HandleNaturezaServico);
        AddSelect("iEquipe", "@CONSTANTES.URLPortal/api/EquipeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, @Html.Raw(Json.Encode(Model.Tecnicos.Select(p => p.Equipe))), "@RsBase.SELECIONE", false);
        AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, @Html.Raw(Json.Encode(Model.Supervisores.Select(p => p.Numfre))), "@RsBase.SELECIONE", false);
        AddSelect("iEmpresa", "@CONSTANTES.URLPortal/api/Empresaapi/GetComboEmpresaAniel", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE",false, handleEmpresa);
        AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetComboFilialAniel", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        AddSelect("iCodCt", "@CONSTANTES.URLPortal/api/ContratoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, handleContrato);
        AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo",@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        $("input[name='NosPrimeiros']").trigger('change');
        $("#iFormatoDisparoAutomaticoRoteirizacao").trigger('change');
        $("#iProgramacaoExpira").trigger('change');
    });


    $("#iFormatoDisparoAutomaticoRoteirizacao").change(function () {
        if ($(this).val() == "2") {
            $(`#iDiasSemana`).show();
            $(`#iMesesAno`).hide();
            $(`#iDiasMes`).hide();
        }
        else if ($(this).val() == "3") {
            $(`#iMesesAno`).show();
            $(`#iDiasMes`).hide();
            $(`#iDiasSemana`).hide();
        }
        else if ($(this).val() == "1") {
            $(`#iDiasMes`).show();
            $(`#iMesesAno`).hide();
            $(`#iDiasSemana`).hide();
        }
        else
        {
            $(`#iDiasMes`).hide();
            $(`#iMesesAno`).hide();
            $(`#iDiasSemana`).hide();
        }
    });

        $("#iProgramacaoExpira").change(function () {
            if ($("#iProgramacaoExpira").is(":checked")) {
                $('#iDivDataExpira').show();
            }
            else
            {
                $('#iDivDataExpira').hide();    
            }
            
        });

    $("input[name='NosPrimeiros']").change(function () {
        if ($(this).val() == 'True') {
            $(`#iNumUltimosDias`).attr("disabled", true);
            $(`#iNumUltimosDias`).val("");
            $(`#iNumPrimeirosDias`).attr("disabled", false);
        }
        else if ($(this).val() == 'False')
        {
            $(`#iNumUltimosDias`).attr("disabled", false);
            $(`#iNumPrimeirosDias`).attr("disabled", true);
            $(`#iNumPrimeirosDias`).val("");
        }
    });


    const handleEmpresa = function () {
        $("#iEmpresa").on("select2:select select2:unselecting", function (e) {
            const empresaSelecionada = e.params.data

            if (!empresaSelecionada) {
                AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetComboFilialAniel", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }
            else {
                AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetComboFilialAniel", @CONSTANTES.PaginacaoRegistros, null, empresaSelecionada.id, null, "@RsBase.SELECIONE", false);
            }
        })
    };

    const handleContrato = function () {
        $("#iCodCt").on("select2:select select2:unselecting", function (e) {
            const contratoSelecionado = e.params.data

            if (!contratoSelecionado) {
                AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/ProjetoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }
            else {
                AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/ProjetoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, contratoSelecionado.id, null, "@RsBase.SELECIONE", false);
            }
        })
    };

    let HandleNaturezaServico = function () {
        $('#iNaturezaServico').on('select2:select select2:unselecting', function (e) {
            let alturaSelect2 = $(".select2-selection--multiple").height();
            $("#iRowMultipleNatureza").height(alturaSelect2 + 30);

        });
    };

    var HandleGrupo = function () {
        $('#iGrupoArea').unbind('select2:select select2:unselecting');
        $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

            GrupoSelecionado = e.params.data
            if (GrupoSelecionado) {
                AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false, HandleArea);
                AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }

            else {
                AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
                AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }

        });
    };

    var HandleArea = function () {
        $('#iArea').on('select2:select select2:unselecting', function (e) {

            AreaSelecionada = e.params.data
            if (AreaSelecionada) {
                AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id), null, "@RsBase.SELECIONE", false);
            }
            else {
                AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }

        });
    };

    var handleDataTableButtonsLocalidade = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Localidades));

            var nome_lista = "Localidades";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            var oDatatableLocalidade = $("#datatableLocalidade").length && $("#datatableLocalidade").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            return '<a href="#" class="btnExcluirLocalidade" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__CodArea" name="' + nome_lista + '[' + meta.row + '].CodArea" type="hidden" value="' + TrataNulo(row.CodArea) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__CodEscritorio" name="' + nome_lista + '[' + meta.row + '].CodEscritorio" type="hidden" value="' + TrataNulo(row.CodEscritorio) + '">';

                        }
                    },
                    {
                        data: "DescricaoEscritorio",
                        title: "@RsCadastros.GRUPO_AREA",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__DescricaoEscritorio" name="' + nome_lista + '[' + meta.row + '].DescricaoEscritorio" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "DescricaoArea",
                        title: "@RsCadastros.AREA",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__DescricaoArea" name="' + nome_lista + '[' + meta.row + '].DescricaoArea" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Localidade",
                        title: "@RsCadastros.LOCALIDADE",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Localidade" name="' + nome_lista + '[' + meta.row + '].Localidade" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    }
                ],
                paging:false
            });

            function handleExcluirLocalidade() {
                $(".btnExcluirLocalidade").unbind('click');
                $(".btnExcluirLocalidade").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatableLocalidade.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/ProgramacaoRoteirizacaoAutomaticaApi/ExcluirGridLocalidade?value=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatableLocalidade.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });
            }



            handleExcluirLocalidade();

            $("#btnAdicionarLocalidade").on('click', function () {

                var erro = false;


                if (ValidaObrigatoriosPorClasse("obrigatorioLocalidade", false)) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                    return false;
                }


                for (var i = 0; i < oDatatableLocalidade.rows().data().length; i++) {
                    if (oDatatableLocalidade.rows().data()[i].Cod_Area == $("#iArea option:selected").val() && oDatatableLocalidade.rows().data()[i].Cod_Escritorio == $("#iGrupoArea option:selected").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.LOCALIDADE)", "warning");
                        erro = true;
                        i = oDatatableLocalidade.rows().data().length;
                    }
                }

                if (erro) {
                    return false;
                }


                oDatatableLocalidade.row.add({
                    CodEscritorio: $("#iGrupoArea option:selected").val(),
                    CodArea: $("#iArea option:selected").val(),
                    DescricaoEscritorio: $("#iGrupoArea option:selected").text(),
                    DescricaoArea: $("#iArea option:selected").text(),
                    Localidade: $("#iLocalidade option:selected").text(),
                    Id: 0
                }).draw(false);

                $("#iGrupoArea").val(null).trigger('change');
                $("#iArea").val(null).trigger('change');
                $("#iLocalidade").val(null).trigger('change');

                handleExcluirLocalidade();
            });


        },
            TableManageButtonsLocalidade = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtonsLocalidade();
                    }
                }
            }();

    TableManageButtonsLocalidade.init();

