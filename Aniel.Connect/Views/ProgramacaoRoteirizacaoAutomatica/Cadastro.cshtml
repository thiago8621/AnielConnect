                $("#iEmpresa").val(null).trigger('change');
                $("#iFilial").val(null).trigger('change');

                handleExcluirEmpresaFilial();
            });


        },
        TableManageButtonsEmpresaFilial = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtonsEmpresaFilial();
                    }
                }
            }();

    TableManageButtonsEmpresaFilial.init();

    var clicked = false;
    function ValidaSubmit()
    {
        if (clicked) {
            return false;
        }

        clicked = true;


        erro = false;

	    if (erro) {
            clicked = false;
            return false;
        }

        ShowPageLoading();
        $('#form').submit();
        return true;
    }

    </script>
}


