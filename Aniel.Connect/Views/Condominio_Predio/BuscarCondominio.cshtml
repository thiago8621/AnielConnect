    <div class="modal" id="modal-condominio">
        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <input type="hidden" id="iTipoModalEnderecoCondominio">

                <div class="modal-header">
                    <h4 align="center" class="modal-title text-muted">Buscar Condomínio</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="form-group row">

                        <div class="col-sm-10">
                            <input type="radio" checked name="buscarCondominio" value="cep" class="mr-1"><strong class="mr-1">CEP</strong>
                            <input type="radio" name="buscarCondominio" value="nomeCondominio" class="mr-1"><strong class="mr-1">Nome do Condomínio</strong>
                            <input type="radio" name="buscarCondominio" value="uf" class="mr-1"><strong class="mr-1">UF</strong>
                            <input type="radio" name="buscarCondominio" value="cidade" class="mr-1"><strong class="mr-1">Cidade</strong>
                            <input type="radio" name="buscarCondominio" value="bairro" class="mr-1"><strong class="mr-1">Bairro</strong>
                            <input type="radio" name="buscarCondominio" value="logradouro" class="mr-1"><strong class="mr-1">Logradouro</strong>
                        </div>
                    </div>

                    <div class="row" id="iBuscarCondominioCepInput">
                        <div class="col-sm-8">
                            <div class="form-group">
                                <label for="iPesquisaCondominio">@RsCadastros.CEP:</label>
                                <input type="text" value="" class="form-control" id="iPesquisaCondominioCep" autocomplete="off">
                            </div>
                        </div>
                        <div class="col mt-4 form-group">
                            <button id="iPesquisar" type="button" class="btn btn-success" onclick="PesquisaCondominio()">@RsCadastros.PESQUISAR</button>
                        </div>
                    </div>

                    <div class="row" id="iBuscarCondominioNomeInput" style="display:none">
                        <div class="col-sm-8">
                            <div class="form-group">
                                <label for="iPesquisaCondominio">@RsCadastros.DESCRICAO_CONDOMINIO:</label>
                                <input type="text" value="" class="form-control" id="iPesquisaCondominioNome" autocomplete="off">
                            </div>
                        </div>
                        <div class="col mt-4 form-group">
                            <button id="iPesquisar" type="button" class="btn btn-success" onclick="PesquisaCondominio()">@RsCadastros.PESQUISAR</button>
                        </div>
                    </div>

                    <div class="row" id="iBuscarCondominioUfInput" style="display:none">
                        <div class="col-sm-8">
                            <div class="form-group">
                                <label for="iPesquisaCondominio">@RsCadastros.UF:</label>
                                @Html.DropDownList("iPesquisaCondominioUf", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { @class = "form-control", @id = "iPesquisaCondominioUf", @autocomplete = "off" })
                            </div>
                        </div>
                        <div class="col mt-4 form-group">
                            <button id="iPesquisar" type="button" class="btn btn-success" onclick="PesquisaCondominio()">@RsCadastros.PESQUISAR</button>
                        </div>
                    </div>

                    <div id="iBuscarCondominioCidadeInput" style="display:none">
                        <div class="row form-group">
                            <div class="col mt-6 form-group">
                                <label for="iPesquisaCondominio">@RsCadastros.UF:</label>
                                @Html.DropDownList("iPesquisaCondominioCidadeUf", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { @class = "form-control", @id = "iPesquisaCondominioCidadeUf", @autocomplete = "off" })
                            </div>
                            <div class="col mt-6 form-group">
                                <label for="iPesquisaCondominio">@RsCadastros.CIDADE:</label>
                                @Html.DropDownList("iPesquisaCondominioCidade", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { @class = "form-control", @id = "iPesquisaCondominioCidade", @autocomplete = "off" })
                            </div>
                            <div class="col mt-2 form-group">
                                <button id="iPesquisar" type="button" class="btn btn-success" onclick="PesquisaCondominio()">@RsCadastros.PESQUISAR</button>
                            </div>
                        </div>
                    </div>

                    <div id="iBuscarCondominioBairroInput" style="display:none">
                        <div class="row form-group">
                            <div class="col mt-4 form-group">
                                <label for="iPesquisaCondominio">@RsCadastros.UF:</label>
                                @Html.DropDownList("iPesquisaCondominioBairroUf", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { @class = "form-control", @id = "iPesquisaCondominioBairroUf", @autocomplete = "off" })
                            </div>
                            <div class="col mt-4 form-group">
                                <label for="iPesquisaCondominio">@RsCadastros.CIDADE:</label>
                                @Html.DropDownList("iPesquisaCondominioBairroCidade", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { @class = "form-control", @id = "iPesquisaCondominioBairroCidade", @autocomplete = "off" })
                            </div>
                            <div class="col mt-4 form-group">
                                <label for="iPesquisaCondominio">@RsCadastros.BAIRRO:</label>
                                @Html.DropDownList("iPesquisaCondominioBairro", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { @class = "form-control", @id = "iPesquisaCondominioBairro", @autocomplete = "off" })
                            </div>
                            <div class="col mt-4 form-group">
                                <button id="iPesquisar" type="button" class="btn btn-success" onclick="PesquisaCondominio()">@RsCadastros.PESQUISAR</button>
                            </div>
                        </div>
                    </div>


                    <div class="row" id="iBuscarCondominioLogradouroInput" style="display:none">
                        <div class="col-sm-8">
                            <div class="form-group">
                                <label for="iPesquisaCondominio">@RsCadastros.LOGRADOURO:</label>
                                <input type="text" value="" class="form-control" id="iPesquisaCondominioLogradouro" autocomplete="off">
                            </div>
                        </div>
                        <div class="col mt-4 form-group">
                            <button id="iPesquisar" type="button" class="btn btn-success" onclick="PesquisaCondominio()">@RsCadastros.PESQUISAR</button>
                        </div>
                    </div>


                    <div id="divTable">
                        <table class="table table-hover nowrap" id="datatableCondominio" style="width:100%">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>