<script>

    function atribuiValor(tipo) {
        $("#iTipoModalEnderecoCondominio").val(tipo);
    }


    $('input[type=radio][name=buscarCondominio]').change(function () {

        if (this.value == 'cep') {
            $('#iBuscarCondominioCepInput').show();
            $('#iBuscarCondominioNomeInput, #iBuscarCondominioCidadeInput, #iBuscarCondominioUfInput, #iBuscarCondominioBairroInput, #iBuscarCondominioLogradouroInput').hide();
        }
        else if (this.value == 'nomeCondominio') {
            $('#iBuscarCondominioNomeInput').show();
            $('#iBuscarCondominioCepInput, #iBuscarCondominioCidadeInput, #iBuscarCondominioUfInput, #iBuscarCondominioBairroInput, #iBuscarCondominioLogradouroInput').hide();

        } else if (this.value == 'cidade') {
            $('#iBuscarCondominioCidadeInput').show();
            $('#iBuscarCondominioNomeInput, #iBuscarCondominioCepInput, #iBuscarCondominioUfInput, #iBuscarCondominioBairroInput, #iBuscarCondominioLogradouroInput').hide();

        } else if (this.value == 'uf') {
            $('#iBuscarCondominioUfInput').show();
            $('#iBuscarCondominioNomeInput, #iBuscarCondominioCidadeInput, #iBuscarCondominioCepInput, #iBuscarCondominioBairroInput, #iBuscarCondominioLogradouroInput').hide();

        } else if (this.value == 'bairro') {
            $('#iBuscarCondominioBairroInput').show();
            $('#iBuscarCondominioNomeInput, #iBuscarCondominioCidadeInput, #iBuscarCondominioUfInput, #iBuscarCondominioCepInput, #iBuscarCondominioLogradouroInput').hide();

        } else {
            $('#iBuscarCondominioLogradouroInput').show();
            $('#iBuscarCondominioNomeInput, #iBuscarCondominioCidadeInput, #iBuscarCondominioUfInput, #iBuscarCondominioBairroInput, #iBuscarCondominioCepInput').hide();
        }

        $('#iPesquisaCondominioNome, #iPesquisaCondominioCep, #iPesquisaCondominioUf,#iPesquisaCondominioBairroUf, #iPesquisaCondominioBairroCidade, #iPesquisaCondominioBairro, #iPesquisaCondominioLogradouro,#iPesquisaCondominioCidadeUf,#iPesquisaCondominioCidade').val("").trigger("change");

    });


    var UfSelecionadoBairro = null;
    var HandleUfBairro = function () {
        $('#iPesquisaCondominioBairroUf').on('select2:select select2:unselecting', function (e) {
            UfSelecionadoBairro = e.params.data;

            if (UfSelecionadoBairro === undefined) {
                AddSelect("iPesquisaCondominioBairroUf", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.TODOS", false, HandleUfBairro);
            } else {
                AddSelect("iPesquisaCondominioBairroCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, UfSelecionadoBairro.id, null, "@RsBase.TODOS", false, HandleCidadeBairro);
            }
        });
    }

    var CidadeSelecionadoBairro = null;
    var HandleCidadeBairro = function () {
        $('#iPesquisaCondominioBairroCidade').on('select2:select select2:unselecting', function (e) {
            CidadeSelecionadoBairro = e.params.data;

            if (UfSelecionadoBairro === null) {
                AddSelect("iPesquisaCondominioBairro", "@CONSTANTES.URLPortal/api/Bairroapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            }

            if (CidadeSelecionadoBairro === undefined) {
                AddSelect("iPesquisaCondominioBairro", "@CONSTANTES.URLPortal/api/Bairroapi/GetCombo", @CONSTANTES.PaginacaoRegistros, UfSelecionadoBairro.id, null, null, "@RsBase.SELECIONE", false);
            }
            else {
                AddSelect("iPesquisaCondominioBairro", "@CONSTANTES.URLPortal/api/Bairroapi/GetCombo", @CONSTANTES.PaginacaoRegistros, UfSelecionadoBairro.id, CidadeSelecionadoBairro.id, null, "@RsBase.SELECIONE", false);
            }
        });
    }

var UfSelecionado = null;
    var HandleUf = function () {
        $('#iPesquisaCondominioCidadeUf').on('select2:select select2:unselecting', function (e) {
            UfSelecionado = e.params.data;

            if (UfSelecionado === undefined) {
                AddSelect("iPesquisaCondominioCidadeUf", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.TODOS", false, HandleUf);
            } else {
                AddSelect("iPesquisaCondominioCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, UfSelecionado.id, null, "@RsBase.TODOS", false);
            }
        });
    }


    AddSelect("iPesquisaCondominioUf", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.TODOS", false);

    AddSelect("iPesquisaCondominioCidadeUf", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.TODOS", false, HandleUf);
    AddSelect("iPesquisaCondominioCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.TODOS", false);

    AddSelect("iPesquisaCondominioBairroUf", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.TODOS", false, HandleUfBairro);
    AddSelect("iPesquisaCondominioBairroCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.TODOS", false, HandleCidadeBairro);
    AddSelect("iPesquisaCondominioBairro", "@CONSTANTES.URLPortal/api/Bairroapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);





        let oDatatableCondominio = null;
        async function PesquisaCondominio() {

        let rows_selected = [];
            if (oDatatableCondominio != null) {
                oDatatableCondominio.draw();
                return;
            }

        var handleDataTableButtons = function () {
            "use strict";
            oDatatableCondominio = $("#datatableCondominio").length && $("#datatableCondominio").DataTable({
                dom: "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                    }
                ],
                ordering:false,
                serverSide: true,
                searching: true,
                paging: false,
                deferRender: true,
                scrollResize: true,
                scrollY: '79vh',
                /*stateSave: true,*/
                scrollX: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, 250, 750, 1000], [10, 25, 50, 100, 250, 750, 1000]],
                ajax: {
                    url: baseUrl + "/api/CondominioPredioapi/GetAll",
                    type: 'POST',
                    data: function (data) {

                        var uf = "";
                        var cidade = "";

                        var valor = $('input[name="buscarCondominio"]:checked').val();
                        switch (valor) {
                            case "uf":
                                uf = $('#iPesquisaCondominioUf option:selected').text();
                                break;

                            case "cidade":
                                uf = $('#iPesquisaCondominioCidadeUf option:selected').text();
                                cidade = $("#iPesquisaCondominioCidade option:selected").text();
                                break;

                            case "bairro":
                                uf = $('#iPesquisaCondominioBairroUf option:selected').text();
                                cidade = $("#iPesquisaCondominioBairroCidade option:selected").text();
                                break;
                        }

                        var nomeCond = $('#iPesquisaCondominioNome').val();
                        var bairro = $('#iPesquisaCondominioBairro option:selected').text();
                        var cep = $("#iPesquisaCondominioCep").val();
                        var endereco_logradouro = $("#iPesquisaCondominioLogradouro").val();

                        data.search.value = nomeCond;
                        data.UF = uf;
                        data.Cidade = cidade;
                        data.Bairro = bairro;
                        data.Cep = cep;
                        data.Endereco_Logradouro_Desc = endereco_logradouro;
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                preDrawCallback: function () {

                    ShowPageLoading($('#modal-condominio'));
                },
                drawCallback: function () {

                    HidePageLoading();
                },
                rowCallback: function (row, data, dataIndex) {
                    // Get row ID
                    var rowId = data.id;

                    // If row ID is in the list of selected row IDs
                    if ($.inArray(rowId, rows_selected) !== -1) {
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                    }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    { data: "id", title: "@RsCadastros.CODIGO", orderable: false },
                    { data: "descricao", title: "@RsCadastros.DESCRICAO_CONDOMINIO", orderable: false },
                    { data: "cep", title: "@RsCadastros.CEP", orderable: false },
                    { data: "tipo_Endereco_Logradouro", title: "@RsCadastros.TIPO", orderable: false },
                    { data: "endereco_Logradouro", title: "@RsCadastros.ENDERECO_LOGRADOURO", orderable: false },
                    { data: "numero", title: "N°", orderable: false },
                    { data: "bairro", title: "@RsCadastros.BAIRRO", orderable: false },
                    { data: "cidade", title: "@RsCadastros.CIDADE", orderable: false },
                    { data: "uf", title: "@RsCadastros.UF", orderable: false },
                    { data: "pais", title: "@RsCadastros.PAIS", orderable: false },
                    {
                        data: "selecione",
                        orderable: false,
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                return `<button id="iSelecionarCondominio" type="button" class="btn btn-success" style="font-size: small;" onclick="selecionarCondominio(${row.id})">@RsBase.SELECIONE</button>`;
                            }
                            return '';
                        }
                    }
                ]
            });



            $("#iLimparFiltros").on("click", function () {
                $('#txtSearch').val('');
                oDatatableCondominio.search('').draw();
            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();
        }




    async function selecionarCondominio(idCondominio) {

        var tipoEndereco = $("#iTipoModalEnderecoCondominio").val();

        let afterBlocoSelect = function () {
            $("#iBlocoSelect" + tipoEndereco).on('select2:select select2:unselecting', async function (e) {
                let BlocoSelecionado = e?.params?.data;
                if (e?.params?._type == "select")
                {
                    await AddSelect("iApartamentoSelect" + tipoEndereco, "@CONSTANTES.URLPortal/api/CondominioPredioapi/GetComboApartamento", @CONSTANTES.PaginacaoRegistros, idCondominio, BlocoSelecionado.id, null, "@RsBase.SELECIONE", false, afterApartamentoSelect);
                    $("#iBloco" + tipoEndereco).val(BlocoSelecionado.id);
                }
            });
        }

        let afterApartamentoSelect = function () {
            $("#iApartamentoSelect" + tipoEndereco).on('select2:select select2:unselecting', function (e) {
                let ApartamentoSelecionado = e?.params?.data;
                if (e?.params?._type == "select") {
                    $("#iApartamento" + tipoEndereco).val(ApartamentoSelecionado.id);
                    $("#iTipoImovel").val()
                }
            });
        }

        await AddSelect("iId_Condominio_Predio" + tipoEndereco, "@CONSTANTES.URLPortal/api/CondominioPredioapi/GetComboEndereco", @CONSTANTES.PaginacaoRegistros, null, null, `${idCondominio}`, "@RsBase.SELECIONE", false, x = function () {
            $("#iId_Condominio_Predio" + tipoEndereco).on('select2:select select2:unselecting',async function (e) {
                CondominioPredioSelecionado = e.params.data;
                $("#iCidadeText" + tipoEndereco).html(CondominioPredioSelecionado.cidade);
                $("#iCidadeTextModel" + tipoEndereco).html(CondominioPredioSelecionado.cidade);
                $("#iBairroText" + tipoEndereco).html(CondominioPredioSelecionado.bairro);
                $("#iUFText" + tipoEndereco).html(CondominioPredioSelecionado.uf);
                $("#iPaisText" + tipoEndereco).html(CondominioPredioSelecionado.pais);
                $("#iCEPText" + tipoEndereco).html(CondominioPredioSelecionado.cep);
                $("#iLogradouro" + tipoEndereco).html(CondominioPredioSelecionado.endereco_Logradouro);
                $("#iTipo" + tipoEndereco).html(CondominioPredioSelecionado.tipo_Endereco_Logradouro);
                $("#iCondominioPredio" + tipoEndereco).html(CondominioPredioSelecionado.descricao);

                $("#iCidade" + tipoEndereco).val(CondominioPredioSelecionado.id_Cidade);
                $("#iBairro" + tipoEndereco).val(CondominioPredioSelecionado.bairro);
                $("#iUF" + tipoEndereco).val(CondominioPredioSelecionado.uf);
                $("#iPais" + tipoEndereco).val(CondominioPredioSelecionado.id_Pais);
                $("#iCEP" + tipoEndereco).val(CondominioPredioSelecionado.cep);
                $("#iLogradouro" + tipoEndereco).val(CondominioPredioSelecionado.endereco_Logradouro);
                $("#iTipo" + tipoEndereco).val(CondominioPredioSelecionado.tipo_Endereco_Logradouro);
                $("#iCondominioPredio" + tipoEndereco).val(CondominioPredioSelecionado.descricao);
                $("#iNumero" + tipoEndereco).val(CondominioPredioSelecionado.numero);

                await AddSelect("iBlocoSelect" + tipoEndereco, "@CONSTANTES.URLPortal/api/CondominioPredioapi/GetComboBloco", "@CONSTANTES.PaginacaoRegistros", null, idCondominio, null, "@RsBase.SELECIONE", false, afterBlocoSelect);
            });
        });

        $('#modal-condominio').modal('hide')
    }


</script>

