@model  Sinapse.Util.ExcelServiceLog<Aniel.Connect.Models.Condominio_PredioImportacao>

@{
    ViewBag.Title = RsCadastros.IMPORTAR_CONDOMINIO_PREDIO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    // Alterado para atender ao retrabalho da DS 2587 - Não foi criado as separações de planilhas será a mesma para ambos os casos.
    if (ViewBag.Utiliza_Cadastro_Endereco)
    {
        ViewBag.Modelo = CONSTANTES.URLPortal + @"//Arquivos/Condominio_Predio/Modelo_Padrao_Importacao_Condominio_Predio.xlsx";
        ViewBag.ModeloAtualizar = CONSTANTES.URLPortal + @"/Arquivos/Condominio_Predio/Modelo_Padrao_Atualizacao_Condominio_Predio.xlsx";
    }
    else
    {
        ViewBag.Modelo = CONSTANTES.URLPortal + @"//Arquivos/Condominio_Predio/Modelo_Padrao_Importacao_Condominio_Predio.xlsx";
        ViewBag.ModeloAtualizar = CONSTANTES.URLPortal + @"/Arquivos/Condominio_Predio/Modelo_Padrao_Atualizacao_Condominio_Predio.xlsx";
    }

    ViewBag.ModeloEstadosMunicipios = CONSTANTES.URLPortal + @"/Arquivos/Condominio_Predio/Tabela_Estados_Municipios.xlsx";

}

@section styles
{
    @Styles.Render("~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />

    <style>
        .popover {
            max-width: 45%; /* Max Width of the popover (depending on the container!) */
        }

        .Passos_Importacao {
            font-size: 12px;
        }
    </style>
}


@section  scripts
{
    @Scripts.Render("~/bundles/jsDataTable")
    <script src="~/bin/Scripts/download.js"></script>

    <script>


        $('#iArquivo').on('change', function () {

            var myfile = $(this).val();
            var ext = myfile.split('.').pop();
            if (!(ext == "xls" || ext == "xlsx")) {

                Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                $(this).val("");
            }
            else {

                var arquivo = $(this)[0].files[0];

                var fileName = arquivo.name;
                $(this).next('.custom-file-label').html(fileName);
            }
        });

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;
            var erro = false;

            myfile= $("#iArquivo").val();
            if (!myfile) {

                if ($('#iArquivo').next('.custom-file-label').html() == '') {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ARQUIVO)", "warning");
                    erro = true;
                }
                else {

                    var ext = $('#iArquivo').next('.custom-file-label').html().split('.').pop();
                    if (!(ext == "xlsx" || ext == "xls")) {

                        Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                        erro = true;
                    }
                }
            }
            else {

                var ext = myfile.split('.').pop();
                if (!(ext == "xlsx" || ext == "xls")) {

                    Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                    erro = true;
                }
            }

            if (erro) {

                clicked = false;
                return false;
            }

            $("#divProgress").show();

            $('#form').submit();
        }

        $(document).ready(function () {
              $('[data-toggle="popover"]').popover()

            var sucesso = "@Html.Raw(ViewBag.Sucesso)";
            if (sucesso == "S") {
                Notificar("@RsCadastros.INFORMACAO", " Importação de Condomínio/Prédio concluída com sucesso", "info");
            }

        });

    </script>


    @if (Model.Log.Count() > 0)
    {
        <text>
            <script>

           var array = @Html.Raw(Json.Encode(Model.Log));
           var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                scrollX: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '30vh',
                paging:false,
                drawCallback: function (settings) {
                    $('.switchToggle').bootstrapToggle('state', true);
                },
                columns: [
                    {
                        data: "Chave",
                        title: "@Html.Raw(RsCadastros.DESCRICAO_CONDOMINIO_PREDIO)",
                    },
                    {
                        data: "Erro",
                        title: "Mensagem"
                    }
                ]
            });
            </script>
        </text>
    }
}

