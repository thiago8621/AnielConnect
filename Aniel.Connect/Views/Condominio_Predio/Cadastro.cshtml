                let [cidade, bairro, estado] = [data.localidade, data.bairro.toUpperCase(), $('#iUF option:selected').text()];
                let enderecoApiCidade = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

                $('#iBairro').val(bairro);

                $.getJSON(enderecoApiCidade, function (data) { preenchimentoComboCidade(data, null, cidade); });
            });
        parent.App.stopPageLoading();
    });

    let preenchimentoComboCidade = function (data, id = null, cidade = "") {
        // Limpa o campo de cidade
        $('#iCidade').empty();

        // Adiciona a opção "Selecione"
        $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));

        // Preenche o combobox com as cidades
        $.each(data, function (key, value) {
            $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
        });

        // Seleciona a cidade com base no nome (caso seja fornecido)
        if (cidade) {
            $('#iCidade option').each(function () {
                if ($(this).text().toUpperCase() === cidade.toUpperCase()) {
                    $(this).prop('selected', true);
                    return false; // Sai do loop
                }
            });
        }
        // Seleciona a cidade com base no ID (caso seja fornecido)
        else if (id) {
            $(`#iCidade option[value=${id}]`).prop("selected", true);
        }
    };

    $("#iUF").change(function () {
        let estado = $(this).val(); // Obtém a UF selecionada
        if (estado) {
            let enderecoApiCidade = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;
            $.getJSON(enderecoApiCidade, function (data) {
                preenchimentoComboCidade(data); // Carrega as cidades da nova UF
            });
        } else {
            $('#iCidade').empty(); // Limpa o campo de cidade se não houver UF selecionada
        }
    });
</script>
}


