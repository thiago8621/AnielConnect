    function checkApartamentos(apartamentos = [], recordsDt = []) {
        apartamentos.filter(function (apartamento) {
            return !recordsDt.some(p => p.Descricao == apartamento.Descricao);
        });
        return apartamentos;
    }

    async function gerarApartamentos(strBloco = "", strApartamento = "", recordsDt = [], inicial, final) {
        let [array, aps, error, numInicial, numFinal] = [[], [], false, inicial.match(/\d+/), final.match(/\d+/)];

        if (numInicial && numFinal) {
            strApartamento = "intervalo";
        } else {
            strApartamento = "unico";
        }

        try {

            let upperCase = strBloco.split("-").some(p => p == p.toUpperCase());
            if (strBloco && strApartamento) {
                if (strApartamento == "unico") {
                    if (inicial) {
                        let repetido = recordsDt.find(({ Descricao, Bloco }) => Descricao == `${inicial}` && Bloco == strBloco) != undefined;
                        if (repetido) {
                            Notificar("@RsBase.ATENCAO_", `Apartamento ${inicial} já se encontra no bloco: ${strBloco}.`, "warning");
                        } else {

                            let [record, idBloco, apartamento] = [recordsDt.some(p => p.Bloco == strBloco) ? recordsDt.find(p => p.Bloco == strBloco) : null, record != null ? Number(record.Id_Bloco) : 0,
                                                                  { Id: 0, Descricao: `${inicial}`, Id_Bloco: idBloco, Bloco: strBloco }];
                            aps.push(apartamento);
                        }
                    }
                    if (final) {
                        let repetido = recordsDt.find(({ Descricao, Bloco }) => Descricao == `${final}` && Bloco == strBloco) != undefined;
                        if (repetido) {
                            Notificar("@RsBase.ATENCAO_", `Apartamento ${final} já se encontra no bloco: ${strBloco}.`, "warning");
                        } else {

                            let [record, idBloco, apartamento] = [recordsDt.some(p => p.Bloco == strBloco) ? recordsDt.find(p => p.Bloco == strBloco) : null, record != null ? Number(record.Id_Bloco) : 0,
                                                                  { Id: 0, Descricao: `${final}`, Id_Bloco: idBloco, Bloco: strBloco }];
                            aps.push(apartamento);
                        }
                    }
                }
                else {
                    let values = gerarArrayEntreNumeros(numInicial, numFinal);

                    for (let item of values) {
                        item = inicial.replace(numInicial, item);
                        let repetido = recordsDt.find(({ Descricao, Bloco }) => Descricao == `${item}` && Bloco == strBloco) != undefined;
                        if (repetido) {
                            Notificar("@RsBase.ATENCAO_", `Apartamento ${item} já se encontra no bloco: ${strBloco}.`, "warning");
                        } else {

                            let record = recordsDt.find(p => p.Bloco == strBloco) || null;
                            let idBloco = record != null ? Number(record.Id_Bloco) : 0;
                            let apartamento = {
                                Id: 0,
                                Descricao: `${item}`,
                                Id_Bloco: idBloco,
                                Bloco: strBloco
                            };

                            aps.push(apartamento);
                        }
                    }
                }
            }

            @* daqui vamos preencher o apartamento *@
            @*array.forEach(function (parametro) {
                //let values = strApartamento.split("-").map(function (p) { return Number(p); }).sort();
                let values = gerarArrayEntreNumeros(inicial, final);
                let limit = values[values.length - 1];

                for (let iterator = values[0]; iterator <= limit; iterator++) {
                    let repetido = recordsDt.find(({Descricao, Bloco}) => Descricao == `${iterator}` && Bloco == parametro) != undefined;
                    if (repetido) {
                        Notificar("@RsBase.ATENCAO_",`Apartamento ${iterator} já se encontra no bloco: ${parametro}.`,"warning");
                    }
                    else {
                        record = recordsDt.some(p => p.Bloco == parametro) ? recordsDt.find(p => p.Bloco == parametro) : null;
                        idBloco = record != null ? Number(record.Id_Bloco) : 0,
                            apartamento = { Id: 0, Descricao: `${iterator}`, Id_Bloco: idBloco, Bloco: parametro };
                        aps.push(apartamento);
                    }

                }
            });*@
        }
        catch (exception) {
            error = true;
        }
        return { error, aps };
    }
    function geraAgrupamento(nomeColuna) {
        let [placeholderDescricao, groupDescricao] = [nomeColuna, "Bloco Vinculado"];
        let appender = {
            emptyDataGroup: `Valor da Coluna ${placeholderDescricao} inexistente`,
            dataSrc: [nomeColuna],
            startRender: function (rows, group, level) {
                //Bloco
                if (nomeColuna == "Bloco") {
                    if (group == "" || group == null) {
                        group = nomeColuna.includes("Bloco") ? "Apartamento não gerado" : "Bloco não gerado";
                    }
                }
                groupDescricao = group.includes("não gerado") ? "Valor inexistente" : group;

                return $('<tr>').append(`<td class="text-left" colspan="12">${placeholderDescricao}: ${groupDescricao}</td>`);
            }
        };
        return appender;
    }

    function NotificaBlocos(apartamentos = [], recordsDt = [])
    {
        let [mensagem, blocos]= ["", []];
        apartamentos.forEach(function (parametro) {
            if (!blocos.some(p => p == parametro.Bloco)) {
                blocos.push(parametro.Bloco);
            }
        });
        for (let bloco of blocos) {
            let [blocoAdicionado, count] = [recordsDt.filter(p => p.Bloco == bloco).length == 0, apartamentos.filter(p => p.Bloco == bloco).length];
            mensagem = blocoAdicionado && count > 1 ? `Bloco ${bloco} adicionado e ${count} apartamentos adicionados ` :
                       blocoAdicionado ? `Bloco ${bloco} adicionado e ${count} apartamento adicionado` :
                       `${count} Apartamento(s) adicionado(s) ao bloco ${bloco}`;
            mensagem = `${mensagem} com sucesso`;

            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", mensagem, "info");
        }
    }
    function reorderRecordsBloco(records = []) {
        if (records.length > 0) {
            oDatatableBloco.clear();
            let resultados = Object.groupBy(records, function ({ Bloco }) { return Bloco; });
            for (let bloco in resultados) {
                for (let registro of resultados[bloco]) {
                    oDatatableBloco.row.add({
                        Id_Bloco: registro.Id_Bloco,
                        Bloco: registro.Bloco,
                        Descricao: registro.Descricao,
                        Id: registro.Id
                    });
                }
            }
        }
        oDatatableBloco.draw(false);
    }

