@model Aniel.Connect.Models.RadiusCadastroModel

@{
    ViewBag.Title = RsCadastros.RADIUS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    <style>
        .ip-input-container {
            width: 105%;
        }
    </style>
}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/maskip")

<script>

        let ip = undefined;
        var clicked = false;

        $(document).ready(function () {
            ip = $('#iIP').ipInput();
            $('.ip-input-container').addClass('form-control')

            ip.setIp('@Model.Ip');
             AddSelect("iPOP", "@CONSTANTES.URLPortal/api/POPapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdPop", "@RsBase.SELECIONE", false)
        })

        function ValidaSubmit() {

            if (clicked) {
                return false;
            }

            clicked = true;


            let erro = false

            let ip_value = ip.getIp();
            $('#iHiddenIp').val(ip_value);

            if (ValidaCamposObrigatorios(erro)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                erro = true
            }

            ValidaCampoIP(ip, "iIP")

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

</script>
}


@using (Html.BeginForm("Cadastro", "Radius", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">

                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-digital-tachograph"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GERENCIAMENTO_REDE</a></li>
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Radius")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_RADIUS</a></li>
                                <li class="breadcrumb-item"><span>@ViewBag.Title</span></li>
                            </ol>
                        </nav>
                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>

                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label for="iDescricao">@RsCadastros.DESCRICAO:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control obrigatorio", @id = "iDescricao", @autocomplete = "off", @required = true })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                @if (Model.Id != 0)
                                {
                                    <div class="col-sm-2 offset-6">
                                        <div class="form-group">
                                            <label for="iStatus">@RsFinanceiro.STATUS:</label><br />
                                            @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = RsBase.ATIVAR, @data_off = RsBase.INATIVAR, @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>

                                }

                            </div>


                            <div class="row">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iIP">@RsCadastros.IP:</label>
                                        @Html.HiddenFor(model => model.Ip, new { id = "iHiddenIp" })
                                        <div id="iIP" class="ip-input">
                                            <div class="ip-input-container form-control">
                                                <input type="text" class="ip-input-item" value="">
                                                <i class="ip-input-dot"></i>
                                                <input type="text" class="ip-input-item" value="">
                                                <i class="ip-input-dot"></i>
                                                <input type="text" class="ip-input-item" value="">
                                                <i class="ip-input-dot"></i>
                                                <input type="text" class="ip-input-item" value="">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iPortaSsh">@RsCadastros.PORTA:</label><br />
                                        @Html.TextBoxFor(m => m.Porta_Ssh, new { @class = "form-control obrigatorio", @id = "iPortaSsh" })
                                        @Html.ValidationMessageFor(model => model.Porta_Ssh, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iTimeout">@RsCadastros.TIMEOUT:</label><br />
                                        @Html.TextBoxFor(p => p.Timeout, new { id = "iTimeout", @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iSenha">@RsCadastros.SENHA:</label><br />
                                        @Html.TextBoxFor(m => m.Senha, new { @type = "password", @class = "form-control obrigatorio", @id = "iSenha", @name = " iStatus", @data_toggle = "toggle", @data_on = RsBase.ATIVAR, @data_off = RsBase.INATIVAR, @data_onstyle = "success", @data_offstyle = "light" })
                                        @Html.ValidationMessageFor(model => model.Senha, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iDominio">@RsCadastros.DOMINIO:</label>
                                        @Html.TextBoxFor(p => p.Dominio, new { id = "iDominio", @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iPOP">@RsCadastros.POP:</label>
                                        @Html.DropDownListFor(p => p.IdPop, new List<SelectListItem>(), new { id = "iPOP", @class = "form-control obrigatorio" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label>@RsCadastros.NOME_GRUPO_RADIUS:</label>
                                        @Html.TextBoxFor(p => p.GrupoRadius, new { id = "iGrupoRadius", @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Radius")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}