@model Aniel.Connect.Models.Horario_CadastroModel

@{
    /**/

    ViewBag.Title = RsCadastros.CADASTROHORARIO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{

    <style>
        .popover-body {
            background-color: #357ca5;
            color: white;
            font-style: normal;
        }


    </style>

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script>

        $("#iOpcao_Trabalha_Feriado").change(function () {

            if ($("#iOpcao_Trabalha_Feriado").is(':checked')) {
                $("#feriado").show();
                $("#feriado2").show();
            }
            else {
                $("#feriado").hide();
                $("#feriado2").hide();
            }


        });

    $('#iTipo').change(function () {

        if ($(this).val() == "0") {
            $('.agendamento').hide();
            $('.agendamento').val('');
        }
        else {
            $('.agendamento').show();
        }

        if ($(this).val() == "2") {
            $(".QtdHE").show();
        } else {
            $(".QtdHE").each(function () {
                $(this).attr("id", null);
            });
            $(".QtdHE").hide();
        }


    });

        function verificaRepetido(array) {
            let temp = []

            for (let i = 0; i < array.length; i++) {
                let value = array[i]
                if (temp.indexOf(value) !== -1) {
                    return true
                }
                temp.push(value)
            }
            return false
        }

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;


            var erro = false;
            var campospreenchidos = false;

            if ($('#iDescricao').val() == "") {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsBase.DESCRICAO)", "warning");
                erro = true;
            }

            var dias = ["Domingo", "Segunda", "Terca", "Quarta", "Quinta", "Sexta", "Sabado"];

            //validacoes caso checkbox feriado esteja marcada
            if ($('#iOpcao_Trabalha_Feriado').is(':checked')) {


                camposhorasferiado = [$("#iInicio_Feriado").val(),$("#iInicio_Intervalo_Feriado").val(),$("#iTermino_Feriado").val(),$("#iTermino_Intervalo_Feriado").val()];
                for (var j = 0; j < camposhorasferiado.length; j++){
                    var regexp = /([01][0-9]|[02][0-3]):[0-5][0-9]/;
                    var correct = (camposhorasferiado[j].search(regexp) >= 0) ? true : false;

                    if (camposhorasferiado[j] != "") {
                        if (!correct) {
                            Notificar("@RsBase.ATENCAO_", "@RsCadastros.PREENCHA_HORA_CORRETAMENTE", 'warning');
                            erro = true;
                            clicked = false;
                            return false;
                        }
                    }


                };


                if (($("#iInicio_Feriado").val() == "" && $("#iInicio_Intervalo_Feriado").val() == "" && $("#iTermino_Feriado").val() == "" && $("#iTermino_Intervalo_Feriado").val() == "")) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.PELO_MENOS_UM_HORARIO_FERIADO)", "warning");
                    erro = true;
                    clicked = false;
                    return false;
                }

                if (($("#iInicio_Feriado").val() !== "") && ($("#iInicio_Intervalo_Feriado").val() == "")) {

                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DIAS_SEMANA_HORARIOS_INCOMPLETOS)", "warning");
                        erro = true;
                        clicked = false;
                        return false;

                }

                /*COMENTADO PARA PERMITIR HORARIOS NOTURNOS (DE VIRADA DE DIA)*/
                @*else if ($("#iInicio_Feriado").val() >= $("#iInicio_Intervalo_Feriado").val() &&
                    $("#iInicio_Feriado").val() != "" && $("#iInicio_Intervalo_Feriado").val() != "") {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.HORARIO_FAIXA_INVALIDO)", "warning");
                    erro = true;
                    clicked = false;
                    return false;
                }*@

                if (($("#iTermino_Feriado").val() !== "") && ($("#iTermino_Intervalo_Feriado").val() == "")) {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DIAS_SEMANA_HORARIOS_INCOMPLETOS)", "warning");
                    erro = true;
                    clicked = false;
                    return false;

                }
                /*COMENTADO PARA PERMITIR HORARIOS NOTURNOS (DE VIRADA DE DIA)*/
                @*else if ($("#iTermino_Feriado").val() <= $("#iTermino_Intervalo_Feriado").val() &&
                    $("#iTermino_Feriado").val()!= "" && $("#iTermino_Intervalo_Feriado").val() != "") {
                     Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.HORARIO_FAIXA_INVALIDO)", "warning");
                    erro = true;
                    clicked = false;
                     return false;
                }*@

                if (($("#iTermino_Intervalo_Feriado").val() !== "") && ($("#iTermino_Feriado").val() == "")) {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DIAS_SEMANA_HORARIOS_INCOMPLETOS)", "warning");
                    erro = true;
                    clicked = false;
                     return false;

                }


                if (($("#iInicio_Intervalo_Feriado").val() !== "") && ($("#iInicio_Feriado").val() == "")) {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DIAS_SEMANA_HORARIOS_INCOMPLETOS)", "warning");
                    erro = true;
                    clicked = false;
                    return false;

                }


            }

            for (var i = 0; i < dias.length; i++) {

                // valida se a hora informada nos dias da semana são validas
                camposhoras = [$("#iInicio_" + dias[i]).val(),$("#iInicio_Intervalo_" + dias[i]).val(),$("#iTermino_" + dias[i]).val(),$("#iTermino_Intervalo_" + dias[i]).val()];
                for (var j = 0; j < camposhoras.length; j++){
                    var regexp = /([01][0-9]|[02][0-3]):[0-5][0-9]/;
                    var arrayTemp = [];

                    if (camposhoras[j] != "") {

                        if (verificaRepetido(camposhoras.filter(p => p != ""))) {
                            Notificar("@RsBase.ATENCAO_", "@RsCadastros.AVISO_HORAS_IGUAIS", 'warning');
                            erro = true;
                            clicked = false;
                            return false;
                        }

                        var correct = (camposhoras[j].search(regexp) >= 0) ? true : false;

                        if (!correct) {
                            Notificar("@RsBase.ATENCAO_", "@RsCadastros.PREENCHA_HORA_CORRETAMENTE", 'warning');
                            erro = true;
                            clicked = false;
                            return false;
                        }
                    }
                };


                //valida se posui algum dia da semana com horario preenchido
                if (($("#iInicio_" + dias[i]).val() != "") || ($("#iInicio_Intervalo_" + dias[i]).val() != "") ||
                    ($("#iTermino_Intervalo_" + dias[i]).val() != "") || ($("#iTermino_" + dias[i]).val() != "")) {
                    campospreenchidos = true;
                }

                //validacoes de preenchimento e lógica de hora inicio fim
                if (($("#iTermino_" + dias[i]).val() !== "") && ($("#iTermino_Intervalo_" + dias[i]).val() == "")) {

                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DIAS_SEMANA_HORARIOS_INCOMPLETOS)", "warning");
                        erro = true;
                        clicked = false;
                        return false;

                }
                /*COMENTADO PARA PERMITIR HORARIOS NOTURNOS (DE VIRADA DE DIA)*/
                @*else if ($("#iTermino_" + dias[i]).val() <= $("#iTermino_Intervalo_" + dias[i]).val() &&
                    $("#iTermino_"+ dias[i]).val() != "" && $("#iTermino_Intervalo_" + dias[i]).val() != "") {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.HORARIO_FAIXA_INVALIDO)", "warning");
                    erro = true;
                    clicked = false;
                    return false;
                }*@

                if (($("#iInicio_" + dias[i]).val() !== "") && ($("#iInicio_Intervalo_" + dias[i]).val() == "")) {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DIAS_SEMANA_HORARIOS_INCOMPLETOS)", "warning");
                    erro = true;
                    clicked = false;
                    return false;

                }

                /*COMENTADO PARA PERMITIR HORARIOS NOTURNOS (DE VIRADA DE DIA)*/
                @*else if ($("#iInicio_Intervalo_" + dias[i]).val() <= $("#iInicio_" + dias[i]).val() &&
                    $("#iInicio_Intervalo_" + dias[i]).val()!= "" && $("#iInicio_" + dias[i]).val() != "") {
                     Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.HORARIO_FAIXA_INVALIDO)", "warning");
                    erro = true;
                    clicked = false;
                     return false;
                }*@

                if (($("#iTermino_Intervalo_" + dias[i]).val() !== "") && ($("#iTermino_" + dias[i]).val() == "")) {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DIAS_SEMANA_HORARIOS_INCOMPLETOS)", "warning");
                    erro = true;
                    clicked = false;
                     return false;

                }

                /*COMENTADO PARA PERMITIR HORARIOS NOTURNOS (DE VIRADA DE DIA)*/
                @*else if ($("#iTermino_Intervalo_" + dias[i]).val() >= $("#iTermino_" + dias[i]).val() &&
                $("#iTermino_Intervalo_" + dias[i]).val() != "" && $("#iTermino_" + dias[i]).val() != "") {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.HORARIO_FAIXA_INVALIDO)", "warning");
                    erro = true;
                    clicked = false;
                    return false;
                }*@

                if (($("#iInicio_Intervalo_" + dias[i]).val() !== "") && ($("#iInicio_" + dias[i]).val() == "")) {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DIAS_SEMANA_HORARIOS_INCOMPLETOS)", "warning");
                    erro = true;
                    clicked = false;
                    return false;

                }

                /*COMENTADO PARA PERMITIR HORARIOS NOTURNOS (DE VIRADA DE DIA)*/
                @*else if ($("#iInicio_" + dias[i]).val() >= $("#iInicio_Intervalo_" + dias[i]).val() &&
                    $("#iInicio_Intervalo_" + dias[i]).val() != "" && $("#iInicio_" + dias[i]).val() != "") {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.HORARIO_FAIXA_INVALIDO)", "warning");
                    erro = true;
                    clicked = false;
                    return false;
                }*@

            }

            if (!campospreenchidos) {

                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.PELO_MENOS_UM_HORARIO)", "warning");
                clicked = false;
                erro = true;
                return false;
            }

            if (erro) {
                clicked = false;
                return false;
            }
            ShowPageLoading();
            $('#form').submit();

        }

    $(document).ready(function () {
        $("#iOpcao_Trabalha_Feriado").trigger('change');
        $('#iTipo').trigger('change')
    });

    </script>
}


@using (Html.BeginForm("Cadastro", "Horario", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page">
                            <i class="far fa-clock"></i> @ViewBag.Title
                        </h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Horario")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTA_HORARIOS</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>

                        @*<span style="font-size:11px" id="dtLegend"></span>*@
                    </div>
                </div>
                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <span class="text-bold-card pt-0">@ViewBag.Title</span>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="row">
                                @if (Model.Id != 0)
                                {
                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iStatus" class="mr-3">@RsFinanceiro.STATUS:</label><br>
                                            @Html.CheckBoxFor(model => model.Status, new { @class = "form-control", @id = "iStatus", @name = "iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>
                                }

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iPadrao" class="mr-3">@RsFinanceiro.PADRAO:</label><br>
                                        @*@Html.CheckBoxFor(model => model.Padrao, new { @class = "form-control", @id = "iPadrao", @name = "iPadrao", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })*@
                                        @Html.CheckBoxFor(m => m.Padrao, new { @class = "form-control", @id = "iPadrao", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })

                                    </div>
                                </div>

                            </div>

                            <div class="row">
                                <div class="form-group col-sm-2">
                                    <label for="iCodigo" class="mr-3">@RsCadastros.CODIGO:</label><br>
                                    @Html.TextBoxFor(model => model.Codigo, new { @maxlength = 4, @class = "form-control", @id = "iCodigo" })
                                    @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group col-sm-4">
                                    <label for="iDescricao" class="mr-3">@RsCadastros.DESCRICAO:</label><br>
                                    @Html.TextBoxFor(model => model.Descricao, new { @maxlength = 50, @class = "form-control", @id = "iDescricao" })
                                    @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group col-sm-4">
                                    <label for="iTipo" class="mr-3">@RsCadastros.TIPO:</label><br>
                                    @Html.EnumDropDownListFor(model => model.Tipo, new { @class = "form-control", @id = "iTipo" })
                                    @Html.ValidationMessageFor(model => model.Tipo, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            @*<h4>@RsCadastros.HORARIOS</h4>*@
                            <div class="row mt-5">
                                <div class="" style="display: contents; margin-right: 40px">

                                    <!--Domingo-->
                                    <div class="col-xs-12 col-sm-4 col-md-3 col-lg-2">
                                        <div for="iInicio_Domingo" class="text-center">Dom</div>
                                        <div class="row">
                                            <div class="col-6">
                                                <div class="form-group">
                                                    @Html.TextBoxFor(m => m.Inicio_Domingo, new { @class = "form-control hora", @id = "iInicio_Domingo", @placeholder = "00:00", @autocomplete = "on", @tabindex = 10 })
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="form-group">
                                                    @Html.TextBoxFor(m => m.Inicio_Intervalo_Domingo, new { @class = "form-control hora", @id = "iInicio_Intervalo_Domingo", @placeholder = "00:00", @autocomplete = "on", @tabindex = 11 })
                                                </div>
                                            </div>

                                            <div class="col-6">
                                                @*<label for="iInicio_Domingo" style="margin-left: 75px;">Dom</label>*@
                                                <div class="form-group">
                                                    @Html.TextBoxFor(m => m.Termino_Intervalo_Domingo, new { @class = "form-control agendamento hora", @id = "iTermino_Intervalo_Domingo", @placeholder = "00:00", @autocomplete = "off", @tabindex = 12 })
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                @*<label for="iTermino_Domingo">&nbsp;</label>*@
