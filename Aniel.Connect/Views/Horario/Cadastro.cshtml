                                                    @Html.TextBoxFor(m => m.Termino_Domingo, new { @class = "form-control agendamento hora", @id = "iTermino_Domingo", @placeholder = "00:00", @autocomplete = "off", @tabindex = 13 })
                                                </div>
                                            </div>
