@model  Aniel.Connect.Models.Equipe_MapaLogItemModel
@using Resources
@using Aniel.T5.Model.enumerado

@{
    ViewBag.Title = @Request.Params["pagina"] == "Acompanhamento" ? RsCadastros.ACOMPANHAMENTO_EQUIPE_MAPA : RsCadastros.VISUALIZAR_ROTA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

<script src="~/bin/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/leaflet.js"></script>
<script src="~/Scripts/leaflet.markercluster-src.js"></script>
<script src="~/Scripts/leaflet_awesome_number_markers.js"></script>
<script src="~/Scripts/L.Polyline.SnakeAnim.js"></script>

<link rel="stylesheet" href="~/Content/MarkerCluster.css" />
<link rel="stylesheet" href="~/Content/MarkerCluster.Default.css" />
<link href="~/Content/leaflet.css" rel="stylesheet" />
<link href="~/Content/map.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/leaflet_awesome_number_markers.css">
<link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />



<!--<script src="~/bin/Scripts/connect.js"></script>-->



@section styles{
    <style>
        .overlay {
            z-index: 9999 !important
        }
    </style>
}


@section scripts {

    <script>



        var decodeHtmlEntity = function (str) {
            return str.replace(/&#(\d+);/g, function (match, dec) {
                return String.fromCharCode(dec);
            });
        };

        function Traduzir(Texto) {

            if (Texto.indexOf("The value") !== -1 && Texto.indexOf("is not valid for") !== -1) {
                return Texto.replace("The value", "O valor").replace("is not valid for", "é inválido para");
            }
            else {
                return Texto;
            }
        }

        function erroLatLong() {
            Notificar("@RsBase.ATENCAO_","Erro ao montar a rota devido a latitude e longitude configuradas de forma errada.","warning");
        }

        function NotificacaoMapa(atencao, Texto,tipo){
            try {
                parent.Swal.fire({
                    html: Texto,
                    type: tipo,
                    confirmButtonColor: "#3085d6",
                    confirmButtonText: "OK"
                });
            } catch (ex) {
                Swal.fire({
                    html: Texto,
                    type: tipo,
                    confirmButtonColor: "#3085d6",
                    confirmButtonText: "OK"
                });
            }
        }

        $(document).ready(function () {

            AddSelect("iMatricula_Id", "@CONSTANTES.URLPortal/api/Equipeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Request.Params["equipe"]", "@RsBase.SELECIONE", false);

            



            escondeExibeDivPorURL();
        });

        function recarregaFiltro() {


            if (!$('#iMatricula_Id').val() || !$('#iData_Busca').val()) {
                Notificar("@RsBase.ATENCAO_","@String.Format(RsBase.REQUIRED, RsCadastros.DATA_EQUIPE)","warning");
                return false;
            }

            var tempdate = new $('#iData_Busca').val();
            var partesData = tempdate.split("/");
            var tempdate = partesData[1] + '/' + partesData[0]  + "/" + partesData[2];

            var url = "@Url.Action("Mapa_Equipes", "Painel_Roteirizacao")" + "?Equipe=" + $('#iMatricula_Id').val() + '&IdLog=@Request.Params["IdLog"]'
                      + "&Data=" + tempdate + "&nome_equipe=" + $('#iMatricula_Nome').val() + "&Pagina=@Request.Params["pagina"]";
            window.location.href = url;
            ShowPageLoading();

        }

        //Esconder e Exibir Divs de acordo com a URL
        function escondeExibeDivPorURL() {

            var pagina = "@Request.Params["Pagina"]";

            if (pagina == "Acompanhamento") {
                //$("#iDivData").hide();
                //$("#iDivEquipe").hide();
                //$("#iBtnAtualizar").hide();
                $("#iCircleStatusEquipe").show();
                $("#iNavPainelRotas").hide();
                $("#iNavAcompanhamento").show();
                $("#iBtnVoltar").attr("href", "@Url.Action("Acompanhamento_Equipes", "Gestao_Equipe")");

            } else if (pagina == "Rotas"){
                $("#iDivData").show();
                $("#iDivEquipe").show();
                $("#iBtnAtualizar").show();
                $("#iCircleStatusEquipe").hide();
                $("#iNavAcompanhamento").hide();
                $("#iNavPainelRotas").show();
                $("#iBtnVoltar").attr("href","@Url.Action("Index","Painel_Roteirizacao")");
            }

        }

        var fotoAjaxUrl = '@String.Concat(CONSTANTES.URLPortal, "/api/Acompanhamento_Servicoapi/FotoAjax")' + '?num_fre=@Model.Num_Fre';
                $.ajax({
                    url: fotoAjaxUrl,
                    type: "GET",
                    dataType: "json"
                })
                    .done(function (data) {
                        $("#iFotoLoading").hide();
                        if (data.objeto) {
                            $("#idImg").html('<img id="iFoto" width="80%" height="100%" style="height: 80% !important;" src="data:image/jpeg;base64,' + data.objeto + '" class="rounded-circle img-fluid" alt="@RsCadastros.FUNCIONARIO" />');
                        }
                        else {
                            $("#idImg").html('<i id="iFoto" class="fas fa-user-circle fa-3x"></i>');
                        }
                    });

        //Documentação: http://project-osrm.org/docs/v5.22.0/api/#general-options
        /*ARequestivar e Desativar Rotas Planejadas e Realizadas */
        $('#iTooglePlanejada').change(function () {
            if ($(this).is(":checked")) {
                polylinePlanejada.removeFrom(map);

                var polylinePlanejadaOptions = {
                    color: 'blue',
                    weight: 6,
                    snakingSpeed: 250,
                    opacity: 0.9,
                    smoothFactor: 1
                };

                polylinePlanejada = new L.Polyline(polylinePlanejadaPoints, polylinePlanejadaOptions)
                polylinePlanejada.addTo(map).snakeIn();

            }
            else {
                polylinePlanejada.removeFrom(map);
            }
        })

        $('#iToogleRealizada').change(function () {
            if ($(this).is(":checked")) {

                polylineRealizada.removeFrom(map);

                var polylineOptions = {
                    color: 'red',
                    weight: 6,
                    snakingSpeed: 250,
                    opacity: 0.9,
                    smoothFactor: 1
                };

                polylineRealizada = new L.Polyline(polylineRealizadaPoints, polylineOptions);
                polylineRealizada.addTo(map).snakeIn();

                $(".iLbRealizada").show();

            }
            else {

                polylineRealizada.removeFrom(map);
                $(".iLbRealizada").hide();
            }
        })

    </script>


}

<div class="overlay" id="divProgress" style="display:none;">
    <div class="preloaderbar show active">
        <span class="bar"></span>
        <span class="text">@RsCadastros.PROCESSANDO_ROTA ...</span>
    </div>
</div>


<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">

        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-users"></i> @ViewBag.Title - Log: @Model.Log</h4>

            <nav id="iNavPainelRotas" aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item" style="margin-top:-18px">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

            @*<span style="font-size:11px" id="dtLegend"></span>*@
        </div>

        <div class="col-auto">
            <div class="row" style="float: right;padding-right: 8px;">

                <div class="pr-2 pl-2" id="iDivData">
                    <label style="font-size:12px">@RsCadastros.DATA:</label>
                    <div class="input-group mb-1">
                        @Html.TextBoxFor(m => m.Data_Busca, new { @class = "form-control datepicker readonly", @id = "iData_Busca", @autocomplete = "off" })
                    </div>
                </div>


                <div class="pr-2 pl-2" id="iDivEquipe">
                    <label for="iMatricula_Id" style="font-size:12px">@RsCadastros.EQUIPE:</label>

                    @Html.DropDownListFor(model => model.Equipe_Busca, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), new { @class = "form-control", @id = "iMatricula_Id" })
                </div>

                <div class="" id="iBtnAtualizar">
                    <div class="mt-4 text-right">
                        <a class="btn btn-success btn-add-2" href="#" title="Atualizar" onclick="recarregaFiltro(); return true;"><i class="fas fa-sync-alt" style="color: #fff"></i></a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="row">
        <!-- Div Mapa -->
        <div id="map-rotas" class="col">
            <img src="~/Images/map-leafletjs.png" class="img-fluid" style="height: 100%; width: 100%;">
        </div>

        <!-- Div Filtros -->
        <!-- Informações Side Menu-->
        <div class='sidebar col-sm-4' style="@(String.IsNullOrEmpty(Request.Params["equipe"]) ? "display:none;" : "" )">




            <div class='heading form-inline mt-1 pb-2'>
                <!-- <img src="..." alt="..." class="rounded-circle"> -->
                <div class="row">
                    <div class="col-sm-6 col-md-6 col-lg-6 col-xl-3">
                        <div id="idImg" class="text-center" style="height: 140%;">
                            <img id="iFotoLoading" src="~/Images/loading-spinner-grey.gif" />
                        </div>
                    </div>
                    <div class="col align-vertical">
                        @Html.DisplayFor(m => m.Equipe_Nome)<br>
                        <span id="iCircleStatusEquipe" class="" style="font-size:12px">
                            <i class="fas fa-circle mr-2 mt-2" style="color: @Model.Cor_StatusEquipe_Mapa"></i>
                            @Model.Tipo
                        </span>
                    </div>
                </div>
            </div>

            <div class='listings fs-12'>
                <div class="div-contact">
                    <span> <i class="fas fa-phone mr-2"></i>@Model.Telefone </span><br>
                    <span> <i class="fas fa-envelope mr-2"></i>@Model.Email </span><br>
                    <span> <i class="fas fa-battery-full mr-2"></i>@Model.Bateria</span><br>
                    <span>@Model.Logado @Model.DataHora_Login</span><br>
                    <span> <i class="fas fa-walking mr-2"></i>Localização Atual: @Model.Atualizado_Em </span><br>
                    <span class="font-weight-normal">Endereço: @Model.Endereco</span>
                </div>

                <div class="div-btn-rota mt-2 mb-2 input-group fs-12">
                    <div class="input-group mb-2">
                        <input id="iTooglePlanejada" style="width: 5rem !important; height: 25px;" type="checkbox" data-toggle="toggle" data-on="" data-off="" checked>
                        <span class="mb-2 ml-2 mt-1"> Ver Rota Planejada</span>
                        <div class="bg-primary ml-4 mt-2" style="width: 15%;height: 30%;"></div>
                    </div>
                    <div class="input-group">
                        <input id="iToogleRealizada" type="checkbox" data-toggle="toggle" data-on="" data-off="" checked>
                        <span class="mb-2 ml-2 mt-1"> Ver Rota Realizada</span>
                        <div class="bg-danger ml-4 mt-2" style="width: 15%;height: 30%;"></div>
                    </div>
                </div>

                <div class="div-btn-rota mt-2 mb-2 input-group fs-12">
                    <div class="input-group">

                        <span class="">Distancia Rota Planejada: </span>
                        <span class="" id="iDistanciaPlanejada"></span>

                    </div>


                    <div class="input-group">
                        <span class="">Distancia Rota Realizada: </span>
                        <span class="" id="iDistanciaRealizada"></span>

                    </div>
                </div>


                <div class="div-legend" style="border: 1px solid rgb(199, 199, 199);padding: 10px;">
                    <div class="row">
                        <div class="col-1 text-right"><i class="mr-0 icofont-home mr-3" style="color:#0000FF;font-size:14px"></i></div>
                        <div class="col">Ponto Partida</div>
                    </div>
                    <div class="row">
                        <div class="col-1"><i class="mr-0 fas fa-flag ico-flag-start-sbg"></i></div>
                        <div class="col">Ponto Inicial</div>
                    </div>
                    <div class="row">
                        <div class="col-1"><i class="mr-0 fas fa-flag-checkered ico-flag-end-sbg"></i></div>
                        <div class="col">Ponto Final</div>
                    </div>
                    <div class="row">
                        <div class="col-1"><i class="mr-0 fas fa-map-marker  text-success"></i></div>
                        <div class="col">Serviço Executado</div>
                    </div>
                    <div class="row">
                        <div class="col-1"><i class="mr-0 fas fa-map-marker text-warning"></i></div>
                        <div class="col">Serviço sendo Executado</div>
                    </div>
                    <div class="row">
                        <div class="col-1"><i class="mr-0 fas fa-map-marker  text-primary"></i></div>
                        <div class="col">Serviço a Executar</div>
                    </div>
                    <div class="row">
                        <div class="col-1"><i class="mr-0 las la-map-marker" style="font-size: 14px;color: black; -webkit-text-stroke: 1px; "></i></div>
                        <div class="col">Serviço Utilizando a Lat/Long da Caixa</div>
                    </div>
                    <div class="row">
                        <div class="col-1"><i class="mr-0 las la-map-marker" style="font-size: 14px; color: red; -webkit-text-stroke: 1px; "></i></div>
                        <div class="col">Serviço Utilizando a Lat/Long da Localidade</div>
                    </div>

                </div>
            </div>
        </div>

    </div>

    @if (!String.IsNullOrEmpty(Request.Params["equipe"]))
    {
        if (Model.Rotas_Planejadas != null)
        {

            if ((Model.Rotas_Planejadas.Count() == 0) && (Model.Rotas_Realizada.Count() == 0))
            {
                <text>
                    <script>
                        $(document).ready(function () {
                            alert("Nenhuma rota definida");
                        });
                    </script>
                </text>
            }




            <script>

                function ShowPageLoading() {
                    try {
                        parent.App.startPageLoading();
                    } catch {
                        try {
                            parent.parent.App.startPageLoading();
                        } catch (e) {
                            console.log(e);
                        }
                    }
                }

                function HidePageLoading() {
                    try {
                        parent.App.stopPageLoading();
                    } catch {
                        try {
                            parent.parent.App.stopPageLoading();
                        } catch (e) {
                            console.log(e);
                        }
                    }
                }


                $('#iDistanciaPlanejada').text("0.00KM");
                $('#iDistanciaRealizada').text("0.00KM");
                polylinePlanejada = undefined;
                polylineRealizada = undefined;
                var polylinePlanejadaPoints = [];
                var polylineRealizadaPoints = [];

                async function PolyLinePlanejada(polylinePlanejadaPoints, lista) {

                    for (data of lista) {


                        try {

                            if ($('#iDistanciaPlanejada').text() == "") $('#iDistanciaPlanejada').text(0);

                            distanciaPlanejada = $('#iDistanciaPlanejada').text();
                            distanciaPlanejada = distanciaPlanejada.replace("KM", "");
                            distanciaPlanejada = parseFloat(distanciaPlanejada);
                            distanciaPlanejada = Number(distanciaPlanejada + (data.routes[0].distance / 1000)).toFixed(2);

                            $('#iDistanciaPlanejada').text(distanciaPlanejada + "KM");



                            for (var y = 0; y < data.routes[0].legs.length; y++) {

                                for (var z = 0; z < data.routes[0].legs[y].steps.length; z++) {

                                    for (var i = 0; i < data.routes[0].legs[y].steps[z].geometry.coordinates.length; i++) {
                                        //new L.LatLng(-22.884809, -43.499205),
                                        polylinePlanejadaPoints.push(new L.LatLng(data.routes[0].legs[y].steps[z].geometry.coordinates[i][1], data.routes[0].legs[y].steps[z].geometry.coordinates[i][0]));
                                    }

                                }
                            }
                        }

                        catch (ex) {
                            var mensagem = '@RsCadastros.NAO_FOI_POSSIVEL_ESTABELCER_ROTA_PLANEJADA';
                        window.NotificacaoMapa("@RsBase.ATENCAO_", mensagem, "warning");
                            console.log(e.responseText)
                        }
                    }

                }

                async function PolyLineRealizada(polylineRealizadaPoints, lista) {

                    for (data of lista) {
                        try {

                            if ($('#iDistanciaRealizada').text() == "") $('#iDistanciaRealizada').text(0);
                            distanciaRealizada = $('#iDistanciaRealizada').text().replace("KM", "");
                            distanciaRealizada = Number((parseFloat(distanciaRealizada)).toFixed(2));
                            $('#iDistanciaRealizada').text(((distanciaRealizada + (data.routes[0].distance / 1000)).toFixed(2)) + "KM");

                            for (var y = 0; y < data.routes[0].legs.length; y++) {

                                for (var z = 0; z < data.routes[0].legs[y].steps.length; z++) {

                                    for (var i = 0; i < data.routes[0].legs[y].steps[z].geometry.coordinates.length; i++) {
                                        //new L.LatLng(-22.884809, -43.499205),
                                        polylineRealizadaPoints.push(new L.LatLng(data.routes[0].legs[y].steps[z].geometry.coordinates[i][1], data.routes[0].legs[y].steps[z].geometry.coordinates[i][0]));
                                        if (latInicial == null) {
                                            latInicial = data.routes[0].legs[y].steps[z].geometry.coordinates[i][1];
                                            lonInicial = data.routes[0].legs[y].steps[z].geometry.coordinates[i][0];
                                        }
                                        latFinal = data.routes[0].legs[y].steps[z].geometry.coordinates[i][1];
                                        lonFinal = data.routes[0].legs[y].steps[z].geometry.coordinates[i][0];
                                    }
                                }

                            };
                        }
                        catch (ex) {
                            var mensagem = '@RsCadastros.NAO_FOI_POSSIVEL_ESTABELCER_ROTA_PLANEJADA';
                        Notificar("@RsBase.ATENCAO_", mensagem, "warning");
                            console.log(e.responseText)
                        }
                    }

                }

                var map = new L.Map('map-rotas', { maxZoom: 18 });


                        /******************
                        tratando bug zoom
                        ******************/
                        var mapZoomLevel = localStorage.theZoom;
                        if (isNaN(mapZoomLevel)) {
                            mapZoomLevel = 15;  //default
                        }
                        map.on('load', function (e) {
                            map.setZoom(mapZoomLevel);
                        },
                            //store
                            map.on('moveend', function (e) {
                                localStorage.theZoom = map.getZoom();
                            }));
                        /**fim bug zoom**/

                        L.tileLayer('http://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                            attribution: '&copy; <a href="http://openstreetmap.org">OpenStreetMap</a> contributors',
                            maxZoom: 20
                        }).addTo(map);

                        map.attributionControl.setPrefix(''); // Don't show the 'Powered by Leaflet' text.

                        @{

                            String latlongPlanejada = null;
                            List<String> latlongPlanejadaLista = new List<String>();
                            if (Model.Rotas_Planejadas.Count() >= 1)
                            {
                                latlongPlanejadaLista = (from o in Model.Rotas_Planejadas
                                                         where o.Latitude.HasValue && o.Latitude != 0
                                                         orderby o.DataHora
                                                         select String.Format("{0}|{1}", o.Longitude, o.Latitude)).ToList();
                            }
                            else
                            {
                                <text>


                            $(document).ready(function () {
                                window.NotificacaoMapa("@RsBase.INFORMACAO", "Nenhuma OS foi planejada", "info");
                               //alert("Nenhuma OS foi planejada");
                            });

                                </text>

                            }


                            String latlongRealizada = null;
                            List<String> latlongRealizadaLista = new List<String>();
                            if (Model.Rotas_Realizada.Count() >= 1)
                            {
                                latlongRealizadaLista = (from o in Model.Rotas_Realizada
                                                         where o.Latitude.HasValue && o.Latitude != 0
                                                         orderby o.DataHora
                                                         select String.Format("{0}|{1}", o.Longitude, o.Latitude)).ToList();

                            }
                            else
                            {
                                <text>

                                @*$(document).ready(function () {
                                    window.NotificacaoMapa("@RsBase.INFORMACAO", "Técnico não possui rota realizada.", "info");
                                    //alert("Nenhuma OS foi realizada");
                                });*@

                                </text>

                            }
                        }


                        var erroGeoConsulta = false;
                        var distanciaPlanejada = 0;
                        async function RotaPlanejada() {


                            let GeoPromises = []
                            @for (int i = 1; i < latlongPlanejadaLista.Count(); i++)
                            {
                                var latlngAnterior = (latlongPlanejadaLista[i - 1]).Replace(",", ".").Replace("|", ",");
                                var latlngAtual = (latlongPlanejadaLista[i]).Replace(",", ".").Replace("|", ",");

                                //caso a latitude/longitude nao esteja com formato correto para ser mostrada no mapa
                                if (latlngAnterior.Count(p => p == '.') < 2  || latlngAtual.Count(p => p == '.') < 2)
                                {
                                    <text>
                                    $(document).ready(function () {
                                        erroLatLong();
                                    });
                                    </text>
                                    continue;
                                }

                                latlongPlanejada = String.Concat(latlngAnterior, ";", latlngAtual);



                                if (!String.IsNullOrEmpty(latlongPlanejada))
                                {
                                    <text>
                                    // Preenche rota planejada
                                    @*var link = "http://router.project-osrm.org/route/v1/driving/@latlongPlanejada?geometries=geojson";*@

                                    var geo = {
                                        ordem: "@i",
                                        url: "@CONSTANTES.URLROUTE@latlongPlanejada?geometries=geojson&steps=true",
                                        url2: "https://router.project-osrm.org/route/v1/driving/@latlongPlanejada?geometries=geojson&steps=true"
                                    }

                                    GeoPromises.push(geo)
                                    </text>
                                }
                            }


                                if (GeoPromises.length > 0) {

                                    const GeoResultado = await Promise.all(GeoPromises.map(async (p, index) => {
                                        console.time("RotaPlanejada" + index);


                                        var resultado = null;

                                        for (var i = 0; i < 10; i++) {

                                            if (i > 0)
                                                console.log("tentativa " + (i + 1));

                                            try {
                                                 resultado = await $.ajax({
                                                    url: i % 2 == 0 ? p.url : p.url2,
                                                    type: 'GET',
                                                    dataType: 'json',
                                                    tryCount: 0,
                                                    retryLimit: 4,
                                                    error: function (xhr, textStatus, errorThrown) {
                                                        return null;
                                                    },
                                                    timeout: 10000
                                                })
                                            }
                                            catch (ex) {
                                                console.log(`RotaPlanejada${index} - ${ex.statusText}`);
                                            }

                                            if (resultado == null)
                                                continue;
                                            else
                                                break;
                                        }

                                        if (resultado == null)
                                            erroGeoConsulta = true;

                                        console.timeEnd("RotaPlanejada" + index);
                                        console.log(i % 2 == 0 ? p.url : p.url2);
                                        return resultado;

                                    }));

                                    await PolyLinePlanejada(polylinePlanejadaPoints, GeoResultado.filter(p => p != null));
                                }

                            var polylinePlanejadaOptions = {
                                color: 'blue',
                                weight: 6,
                                snakingSpeed: 250,
                                opacity: 0.9,
                                smoothFactor: 1
                            };

                            polylinePlanejada = new L.Polyline(polylinePlanejadaPoints, polylinePlanejadaOptions);

                            if (polylinePlanejadaPoints.length > 0)
                                polylinePlanejada.addTo(map).snakeIn();
                        };


                        $("#divProgress").show();

                        @*{
                            // Debug das rotas feitas
                            var realizadas = from o in Model.Rotas_Realizada
                                             where o.Latitude.HasValue && o.Latitude != 0
                                             orderby o.DataHora
                                             select o;
                            var vi = 0;
                            foreach (var realizada in realizadas)
                            {
                                    <text>

                                        L.marker([@realizada.Latitude.ToString().Replace(",", "."), @realizada.Longitude.ToString().Replace(",", ".")], {
                                                icon: L.divIcon({
