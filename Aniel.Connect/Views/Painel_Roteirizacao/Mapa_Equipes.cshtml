                        var lonFinal = null;



                        async function RotaRealizada() {

                            let GeoPromises = []
                            @for (int i = 1; i < latlongRealizadaLista.Count(); i++)
                            {
                                 var latlngAnterior = (latlongRealizadaLista[i - 1]).Replace(",", ".").Replace("|", ",");
                                 var latlngAtual = (latlongRealizadaLista[i]).Replace(",", ".").Replace("|", ",");

                                 latlongRealizada = String.Concat(latlngAnterior, ";", latlngAtual);

                                 if (!String.IsNullOrEmpty(latlongRealizada))
                                 {
                                    <text>
                                        // Preenche rota planejada

                                    var geo = {
                                        ordem: "@i",
                                        url: "@CONSTANTES.URLROUTE@latlongRealizada?geometries=geojson&steps=true",
                                        url2: "https://router.project-osrm.org/route/v1/driving/@latlongRealizada?geometries=geojson&steps=true"
                                    }

                                    GeoPromises.push(geo)

                                        //. Preenche rota planejada
                                    </text>
                                 }


                            }


                                if (GeoPromises.length > 0) {
                                    const GeoResultado = await Promise.all(GeoPromises.map(async (p, index) => {
                                        console.time("RotaRealizada" + index);


                                        var resultado = null

                                        for (var i = 0; i < 10; i++) {

                                            try {
                                                resultado = await $.ajax({
                                                    url: i % 2 == 0 ? p.url : p.url2,
                                                    type: 'GET',
                                                    dataType: 'json',
                                                    tryCount: 0,
                                                    retryLimit: 4,
                                                    error: function (xhr, textStatus, errorThrown) {
                                                        return null;
                                                    },
                                                    timeout: 10000
                                                });
                                            }
                                            catch (ex) {
                                                console.log(`RotaRealizada${index} - ${ex.statusText}`);
                                            }

                                            if (resultado == null)
                                                continue;
                                            else
                                                break;

                                        }

                                        if (resultado == null)
                                            erroGeoConsulta = true;

                                        console.timeEnd("RotaRealizada" + index);
                                        console.log(i % 2 == 0 ? p.url : p.url2);
                                        return resultado;
                                    }));
                                    await PolyLineRealizada(polylineRealizadaPoints, GeoResultado.filter(p => p != null));
                                }





                            var polylineOptions = {
                                color: 'red',
                                weight: 6,
                                snakingSpeed: 250,
                                opacity: 0.9,
                                smoothFactor: 1
                            };

                            polylineRealizada = new L.Polyline(polylineRealizadaPoints, polylineOptions);

                            if (polylineRealizadaPoints.length > 0)
                                polylineRealizada.addTo(map).snakeIn();

                            if (latInicial && lonInicial) {
                                L.marker([latInicial, lonInicial], {
                                    icon: L.divIcon({
                                        //html: '<i class="fas fa-flag iLbRealizada" style="color: #7A6600; font-size: 23px;"></i>',
                                        html: '<i class="fas fa-flag ico-flag-start iLbRealizada"></i>',
                                        iconSize: [20, 20],
                                        className: 'myDivIcon'
                                    })
                                }).addTo(map);
                            }

                            if (latFinal && lonFinal) {

                                L.marker([latFinal, lonFinal], {
                                    icon: L.divIcon({
                                        //html: '<i class="fas fa-flag iLbRealizada" style="color: #007749; font-size: 23px;"></i>',
                                        html: '<i class="fas fa-flag-checkered ico-flag-end iLbRealizada"></i>',
                                        iconSize: [20, 20],
                                        className: 'myDivIcon'
                                    })

                                }).addTo(map);
                            }
                        }



                        Promise.all([RotaPlanejada(), RotaRealizada()]).then((values) => {
                            $("#divProgress").hide();
                            if (erroGeoConsulta) {
                                Swal.fire(
