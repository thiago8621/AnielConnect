@model  Aniel.Connect.Models.Log_RoteirizacaoListaModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@{
    ViewBag.Title = RsCadastros.LOG_ROTEIRIZACAO;
    ViewBag.Sessao = RsCadastros.LOG;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion,"~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />
}

@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion,"~/bundles/jsDataTable")
    <script>

        var rows_selected = [];

        var handleDataTableButtons = function () {
            "use strict";

            var oDatatableLog = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollY: '73vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/Log_RoteirizacaoApi/GetAll',
                    type: 'POST',
                    data: function (data) {

                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    },
                    beforeSend: function () {
                        $("#divProgress").show();
                    },
                    complete: function () {
                        $("#divProgress").hide();
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                orderable: false,
                columns: [
                        { data: "data_Log", title: "@RsCadastros.DATA_LOG", orderable: false },
                        { data: "status", title: "@RsCadastros.STATUS", orderable: false },
                        { data: "usuario", title: "@RsCadastros.USUARIO", orderable: false }
                    ]
                });
        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

            TableManageButtons.init();

    </script>
}
<div style="padding:10px;">
    <div class="card" style="box-shadow: 0 8px 17px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.1); border:none;">
        <div class="card-body" style="padding-top: 0">
            <!--main-->
            <div class="row" style="padding-top: 10px;">
                <div class="col" style="margin-top: -10px;">
                    <h4 class="title-page"><i class="fas fa-users"></i> @ViewBag.Title</h4>
                    <nav aria-label="breadcrumb" style="font-size:12px">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item" style="margin-left:22px; margin-top:-18px">
                                <a href="@Url.Action("Index", "Painel_Servicos")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_SERVICOS</a>
                            </li>
                            <li class="breadcrumb-item" style="margin-top:-18px">
                                <span>@ViewBag.Title</span>
                            </li>
                        </ol>
                    </nav>
                    <span style="font-size:11px;margin-left: 15px;" id="dtLegend"></span>
                </div>

            </div>
            <table class="table table-hover nowrap" id="datatable" style="width:100%">
                <thead class="tb-head">
                </thead>
            </table>

            <!--./main-->
        </div>
    </div>
</div>
<div class="overlay" id="divProgress" style="display:none;">
    <div class="preloaderbar show active">
        <span class="bar"></span>
        <span class="text">@RsCadastros.PROCESSANDO...</span>
    </div>
</div>