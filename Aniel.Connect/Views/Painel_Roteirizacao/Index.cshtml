@model  Aniel.Connect.Models.Painel_RoteirizacaoModel
@using Resources
@using Microsoft.AspNet.Identity
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers

@{
    ViewBag.Title = RsCadastros.PAINEL_ROTEIRIZACAO;
    ViewBag.Sessao = RsCadastros.ROTEIRIZACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />

    <style>
        .swal2-overflow {
            overflow-x: visible;
            overflow-y: visible;
        }
    </style>

}

@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

        let [rows_selected, rowsSelectedTecnicos] = [[],[]];        
        let global_iTotal = 0;
        var [oDatatable, oDatatableEquipe, oDatatableLog] = [null, null, null];        

        $("#iNumeroMaximoServicos").keyup(function () {
            var NumeroMaximo = $("#iNumeroMaximoServicos").val()
            if (NumeroMaximo) {
                if (NumeroMaximo[0] == "0")
                    $("#iNumeroMaximoServicos").val("");
            }
        });

        let HandleNaturezaServico = function () {
            $('#iNaturezaServico').on('select2:select select2:unselecting', function (e) {
                let alturaSelect2 = $("#iNaturezaServico + .select2-container .select2-selection__rendered").height();
                $("#iRowMultipleNatureza").height(alturaSelect2 + 30);

            });
        };

        function rowsSelectedMessage() {
            if (rows_selected.length === global_iTotal) {
                $("#dtLegendRecordsTotal").html("Todos os <strong> " + global_iTotal + " </strong> registros selecionados.");
            }
            else {
                $("#dtLegendRecordsTotal").html(`<a href='#' onclick ='rowsSelectedAddAll()'style='font-size: 14px;' ><strong>${rows_selected.length}</strong> registros selecionados <i class='fas fa-hand-point-right'></i><strong style='font-size: 13px;' > Clique aqui para selecionar todos os ${global_iTotal} registros </strong></a>`);
            }

            //Confirma a seleção de todos os registros
            $("#dtLegendRecordsTotal").click(function () {
                $("#dtLegendRecordsTotal").html("<span style='font-size: 14px;'>Todos os <strong> " + global_iTotal + " </strong> registros selecionados.</span>");
            });
        }

        function rowsSelectedAddAll() {
            oDatatable.page.len(-1);

            $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');

            oDatatable.draw();
        }


        function vizualizarMapa() {

            url = "@Url.Action("Mapa_Equipes","Gestao_Equipe")" +  "?Pagina=Rotas";
            window.location = url;
            return false;

        }

        function programacaoRoteirizacaoAutomatica() {
            url = "@Url.Action("Index", "ProgramacaoRoteirizacaoAutomatica")";
            window.location = url;
            return false;
        }

        function SalvarTecnicosRoteirizacao() {

            let link = baseUrl + '/api/Painel_RoteirizacaoApi/SalvarUsuarioTecnicoRoteirizacao';
            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    Equipes: rowsSelectedTecnicos,
                    Usuario: "@User.Identity.GetUserId()"
                }
            })
                .done(function (data) {

                    if (data.ok) {
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                        rowsSelectedTecnicos = [];
                        oDatatableEquipe.draw();
                        $('#modal-equipe').modal('hide');
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                });

        }

        $('#modal-equipe').on('shown.bs.modal', function () {
            var table = $('#datatableEquipe').DataTable();
            table.columns.adjust();
        });

        function ExibirEquipes() {

            if (oDatatableEquipe == null) {
                oDatatableEquipe = $("#datatableEquipe").length && $("#datatableEquipe").DataTable({
                    dom: "frti",
                    columnDefs: [
                        {
                            targets: 0,
                            searchable: false,
                            orderable: false,
                            width: '1%',
                            className: 'dt-body-center',
                            render: function (data, type, full, meta) {
                                return "<input type='checkbox'></input>";
                            }
                        },
                        {
                            targets: "_all",
                            width: '1%',
                        },
                    ],
                    order: [[0, 'asc']],
                    serverSide: true,
                    deferRender: true,
                    scrollResize: true,
                    stateSave: true,
                    fixedHeader: true,
                    scrollY: '50vh',
                    scrollX: true,
                    initComplete: dataTableInitComplete,
                    ordering: false,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: baseUrl + '/api/Equipeapi/GetAllSimple',
                        type: 'POST',
                        data: function (data) {
                            data.Filtro = false;
                            data.Supervisor = $('#iSupervisorFiltroTecnico').val();
                            data.Monitor = $('#iMonitorFiltroTecnico').val();
                            data.IdPerfilAgendamentoRoteirizacao = $('#iPerfilAgendamentoFiltroTecnico').val();
                            data.Departamento = $('#iDepartamentoFiltroTecnico').val();
                            data.Empresa = $('#iEmpresaFiltroTecnico').val();
                            data.Filial = $('#iFilialFiltroTecnico').val();
                            data.TipoPrioridade = $('#iTipo_Prioridade').val();
                            data.Usuario = "@User.Identity.GetUserId()";
                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
                    },
                    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                        var str = "@RsCadastros.INFODATATABLE";
                        if (iTotal == 0) { iEnd = 0; iStart = 0; }
                        str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);

                        return "";
                    },
                    drawCallback: function () {
                        rowsSelectedTecnicos = oDatatableEquipe.data().toArray().filter(p => p.configuradoRoteirizacao).map(p => p.equipe);
                    },
                    rowCallback: function (row, data, dataIndex) {
                        if (data.configuradoRoteirizacao)
                        {
                            $(row).find('input[type="checkbox"]').prop('checked', true);
                            $(row).addClass('selected');
                        }
                    },
                    pageLength: 5,
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTable,
                    columns: [
                        { title: "<input name='select_all' value='1' type='checkbox'>" },
                        { data: "equipe", title: "@RsCadastros.CODIGO", ordering: false },
                        { data: "nome", title: "@RsCadastros.EQUIPE", ordering: false },
                    ]
                });

                // Handle click on checkbox
                $('#datatableEquipe tbody').on('click', 'input[type="checkbox"]', function (e) {
                    var $row = $(this).closest('tr');

                    // Get row data
                    var rowId = oDatatableEquipe.row($row).data().equipe;

                    var index = $.inArray(rowId, rowsSelectedTecnicos);

                    // If checkbox is checked and row ID is not in list of selected row IDs
                    if (this.checked && index === -1) {
                        rowsSelectedTecnicos.push(rowId);

                        // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                    } else if (!this.checked && index !== -1) {
                        rowsSelectedTecnicos.splice(index, 1);
                    }

                    if (this.checked) {
                        $row.addClass('selected');
                    } else {
                        $row.removeClass('selected');
                    }

                    if ($("input[name='select_all']").prop("checked")) {

                        //Exibe quantidade de linhas selecionadas
                        rowsSelectedMessage()
                        $("#dtLegendRecordsTotal").show();

                    } else {

                        //Esconde quantidade de linhas selecionadas
                        rowsSelectedMessage()
                        $("#dtLegendRecordsTotal").hide();
                    }

                    // Prevent click event from propagating to parent
                    e.stopPropagation();
                });

                // Handle click on table cells with checkboxes
                $('#datatableEquipe').on('click', 'tbody td, thead th:first-child', function (e) {
                    $(this).parent().find('input[type="checkbox"]').trigger('click');
                });

                // Handle click on "Select all" control
                $('thead input[name="select_all"]', oDatatableEquipe.table().container()).on('click', function (e) {
                    if (this.checked) {
                        $('#datatableEquipe tbody input[type="checkbox"]:not(:checked)').trigger('click');

                        //Exibe quantidade de linhas selecionadas
                        rowsSelectedMessage();
                        $("#dtLegendRecordsTotal").show();

                    } else {
                        $('#datatableEquipe tbody input[type="checkbox"]:checked').trigger('click');

                        rowsSelectedMessage();
                        $("#dtLegendRecordsTotal").hide();
                    }

                    // Prevent click event from propagating to parent
                    e.stopPropagation();
                });
            }
            else {
                oDatatableEquipe.draw();
                oDatatableEquipe.columns.adjust();
            }
        }

        $('#iServ_Agendados').change(function () {
            if ($("#iServ_Agendados").is(":checked")) {
                $('#idataAgendados').removeClass("readonly");
            }
            else {
                $('#idataAgendados').addClass("readonly");
                $("#idataAgendados").val("");
            }
            $(".readonly").attr("tabindex", "-1");
        });

        $("#iServ_SemAgendamento").change(function () {
            if ($("#iServ_SemAgendamento").is(":checked")) {
                $('#idataNaoAgendadosIni').removeClass("readonly");
                $('#idataNaoAgendadosFim').removeClass("readonly");
            }
            else {
                $('#idataNaoAgendadosIni').addClass("readonly");
                $("#idataNaoAgendadosIni").val("");
                $('#idataNaoAgendadosFim').addClass("readonly");
                $("#idataNaoAgendadosFim").val("");
            }
            $(".readonly").attr("tabindex", "-1");
        });

        $('#iServ_SemRoteirizacao').change(function () {
            if ($("#iServ_SemRoteirizacao").is(":checked")) {
                $('#idataNaoRoteirizados').removeClass("readonly");
            }
            else {
                $('#idataNaoRoteirizados').addClass("readonly");
                $("#idataNaoRoteirizados").val("");
            }
            $(".readonly").attr("tabindex", "-1");
        });

        $('#iServ_Paralisados').change(function () {
            if ($("#iServ_Paralisados").is(":checked")) {
                $("#idata_ParalisadoIni").removeClass("readonly");
                $("#idata_ParalisadoFim").removeClass("readonly");
            }
            else {
                $("#idata_ParalisadoIni").val("");
                $("#idata_ParalisadoFim").val("");
                $("#idata_ParalisadoIni").addClass("readonly");
                $("#idata_ParalisadoFim").addClass("readonly");
            }
            $(".readonly").attr("tabindex", "-1");
        });
        $('#iServ_Nao_Executado').change(function () {
            if ($("#iServ_Nao_Executado").is(":checked")) {
                $("#idata_Nao_ExecutadoIni").removeClass("readonly");
                $("#idata_Nao_ExecutadoFim").removeClass("readonly");
            }
            else {
                $("#idata_Nao_ExecutadoIni").val("");
                $("#idata_Nao_ExecutadoFim").val("");
                $("#idata_Nao_ExecutadoIni").addClass("readonly");
                $("#idata_Nao_ExecutadoFim").addClass("readonly");
            }
            $(".readonly").attr("tabindex", "-1");
        });
        $('#iServ_Roteirizados').change(function () {
            if ($("#iServ_Roteirizados").is(":checked")) {
                $("#iData_RoteirizadosIni").removeClass("readonly");
                $("#iData_RoteirizadosFim").removeClass("readonly");
            }
            else {
                $("#iData_RoteirizadosIni").val("");
                $("#iData_RoteirizadosFim").val("");
                $("#iData_RoteirizadosIni").addClass("readonly");
                $("#iData_RoteirizadosFim").addClass("readonly");
            }
            $(".readonly").attr("tabindex", "-1");
        });
        $('#idataAgendados').focusout(ValidaData);
        $('#idata_ParalisadoIni').focusout(ValidaData);
        $('#idata_ParalisadoFim').focusout(ValidaData);
        ValidaPeriodo("idata_ParalisadoIni", "idata_ParalisadoFim", "Período Serviços Paralisados Inválido");
        $('#idata_Nao_ExecutadoIni').focusout(ValidaData);
        $('#idata_Nao_ExecutadoFim').focusout(ValidaData);
        ValidaPeriodo("idata_Nao_ExecutadoIni", "idata_Nao_ExecutadoFim", "Período Serviços não Executados Inválido");
        $('#iData_RoteirizadosIni').focusout(ValidaData);
        $('#iData_RoteirizadosFim').focusout(ValidaData);
        ValidaPeriodo("iData_RoteirizadosIni", "iData_RoteirizadosFim", "Período Serviços Roteirizados Inválido");

        $("#idataAgendados").on("focusout", function () {
            if (DataMenorHoje($("#idataAgendados").val())) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DATA_MENOR_DATAATUAL, RsCadastros.DATA_AGENDAMENTO)", "warning");
                $("#idataAgendados").val(null);
            }
        });

        $("#idata_ParalisadoFim").on("focusout", function () {
            if (DataMaiorHoje($("#idata_ParalisadoFim").val())) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DATA_MAIOR_DATAATUAL, RsCadastros.PERIODO_PARALISADOS)", "warning");
                $("#idata_ParalisadoFim").val(null);
            }
        });

        $("#idata_Nao_ExecutadoFim").on("focusout", function () {
            if (DataMaiorHoje($("#idata_Nao_ExecutadoFim").val())) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DATA_MAIOR_DATAATUAL, RsCadastros.PERIODO_NAO_EXECUTADOS)", "warning");
                $("#idata_Nao_ExecutadoFim").val(null);
            }
        });

        $("#iData_RoteirizadosIni").on("focusout", function () {
            if (DataMenorHoje($("#iData_RoteirizadosIni").val())) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DATA_MENOR_DATAATUAL, RsCadastros.PERIODO_ROTEIRIZADOS)", "warning");
                $("#iData_RoteirizadosIni").val(null);
            }
        });

        var clicked = false;
        $("#iPesquisar").on("click", function () {

            if (clicked) {
                return false;
            }

            clicked = true;

            var erro = false;

            if ($("#iServ_Agendados").is(":checked")) {
                if (!$("#idataAgendados").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DATA_AGENDAMENTO)", "warning");
                    erro = true;
                }
            }

            if ($("#iServ_Paralisados").is(":checked") && (!$("#idata_ParalisadoIni").val() || !$("#idata_ParalisadoFim").val())) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PERIODO_PARALISADOS)", "warning");
                erro = true;
            }

            if ($("#iServ_Nao_Executado").is(":checked") && (!$("#idata_Nao_ExecutadoIni").val() || !$("#idata_Nao_ExecutadoFim").val())) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PERIODO_NAO_EXECUTADOS)", "warning");
                erro = true;
            }

            if ($("#iServ_Roteirizados").is(":checked") && (!$("#iData_RoteirizadosIni").val() || !$("#iData_RoteirizadosFim").val())) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PERIODO_ROTEIRIZADOS)", "warning");
                erro = true;
            }



            if (!$("#iNumero_Ordem_Servico").val() && !$("#idataAgendados").val() && !$("#iServ_SemRoteirizacao").is(":checked") && !$("#iServ_SemAgendamento").is(":checked") && !$("#iServ_Agendados").is(":checked") && !$("#iServ_Paralisados").is(":checked") &&
                !$("#iServ_Nao_Executado").is(":checked") && !$("#iServ_Roteirizados").is(":checked")) { //!$("#iCodCt").val() && !$("#iGrupoArea").val() && !$("#idFilial").val() && !$("#idSupervisor").val() && !$("#iMatricula_Id").val() && !$("#iCategoriaCliente").val() && !$("#iNaturezaServico").val() {
                Notificar("@RsBase.ATENCAO_", "@RsBase.INFORME_FILTRO de data ou numero da ordem de serviço", "warning");
                erro = true;
            }

            if (erro) {
                clicked = false;
                return false;
            }

            $("#modal-filter").modal('hide');
            rows_selected = [];

            if (oDatatable) {
                oDatatable.search($('#txtSearch').val()).draw();
            }
            else {
                TableManageButtons.init();
            }

            clicked = false;

            return true;
        });

        $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {
            $("#iNumero_Ordem_Servico").val("");
            $("#iServ_SemAgendamento").prop("checked", false).change();
            $("#iServ_Nao_Paralisados").prop("checked", false).change();
            $("#iServ_SemRoteirizacao").prop("checked", false).change();
            $("#iServ_Agendados").prop("checked", false).change();
            $("#idataAgendados").val("");

            $("#iServ_Paralisados").prop("checked", false).change();
            $("#idata_ParalisadoIni").val("");
            $("#idata_ParalisadoFim").val("");

            $("#iServ_Nao_Executado").prop("checked", false).change();
            $("#idata_Nao_ExecutadoIni").val("");
            $("#idata_Nao_ExecutadoFim").val("");

            $("#iServico_Roteirizados").prop("checked", false).change();
            $("#iData_RoteirizadosIni").val("");
            $("#iData_RoteirizadosFim").val("");

            $("#iFilial").val(null).trigger('change');
            $("#iSupervisor").val(null).trigger('change');
            $("#iEquipe").val(null).trigger('change');


            $("#iCodCt").val(null).trigger('change');
            $("#iProjeto").val(null).trigger('change');
            $("#iGrupoArea").val(null).trigger('change');
            $("#iArea").val(null).trigger('change');
            $("#iLocalidade").val(null);
            $("#iCategoriaCliente").val(null).trigger('change');
            $("#iNaturezaServico").val(null).trigger('change');
            $("#iTipo_Prioridade").val(null).trigger('change');

            $('#txtSearch').val('');
            rows_selected = [];
            oDatatable.search($('#txtSearch').val()).draw();
        });

        $("#iRoteirizar,#iSimularRoteirizacao,#iEncaixeRoteirizacao").on("click", function () {


            let idElement = $(this).attr("id");

            if (DataMenorHoje($('#idataRoteirizar').val())) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.DATA_MAIOR_DATAATUAL, RsCadastros.DATA_A_ROTEIRIZAR)", "warning");
                Swal.close();
                return false;
            }

            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                $('input[name="select_all"]').prop('checked', false);
                return;
            }

            if ($('#idataRoteirizar').val()) {

                $("#divProgress").show();

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Painel_RoteirizacaoApi/Roteirizar")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        usuario: "@User.Identity.GetUserId()",
                        objeto: {
                            ids: rows_selected,
                            data: $('#idataRoteirizar').val(),
                            numero_max_atendimento: $('#iNumeroMaximoServicos').val(),
                            alterar_DataHora_SemAgendamentoAniel: $('#iAlterarAgendamentoDataMaxima').is(':checked'),
                            simulacao: idElement == "iSimularRoteirizacao" ? true : false,
                            encaixe: idElement == "iEncaixeRoteirizacao" ? true : false,
                            equipesConfiguradas: true
                        }
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Swal.fire(
                                'Sucesso!',
                                'Roteirização bem sucedida!',
                                'success'
                            );

                            rows_selected = [];
                            oDatatable.draw();
                            $('input[name="select_all"]').prop('checked', false);
                        }
                        else {
                            Swal.fire(
                                '@Html.Raw(RsBase.ATENCAO_)',
                                data.mensagem,
                                'warning'
                            );
                            rows_selected = [];
                            oDatatable.draw();
                            $('input[name="select_all"]').prop('checked', false);
                        }
                    }).always(function () {

                        $("#divProgress").hide();

                    });
            }
            else {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DATA_A_ROTEIRIZAR)", "warning");
            }
        });

        const HandleEmpresa = function () {
            $('#iEmpresaFiltroTecnico').on('select2:select select2:unselecting', function (e) {
                let Empresa = e.params.data
                if (Empresa) {
                    AddSelect("iFilialFiltroTecnico", "@CONSTANTES.URLPortal/api/FilialApi/GetComboFilialAniel", @CONSTANTES.PaginacaoRegistros, null, Empresa.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iFilialFiltroTecnico", "@CONSTANTES.URLPortal/api/FilialApi/GetComboFilialAniel", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
            });
        };

        const HandleCodct = function () {
            $('#iCodCt').unbind('select2:select select2:unselecting');
            $('#iCodCt').on('select2:select select2:unselecting', function (e) {
                const ContratoSelecionado = e.params.data;

                if (ContratoSelecionado) {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, ContratoSelecionado.id, null, "@RsBase.SELECIONE", false, null, null, null, { UsaPerfilVisualizacaoServico: true });
                }
                else {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, null, null, null, { UsaPerfilVisualizacaoServico: true });
                }
            });
        };

        const HandleGrupoArea = function () {
            $('#iGrupoArea').unbind('select2:select select2:unselecting');
            $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

                GrupoSelecionado = e.params.data
                if (GrupoSelecionado) {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false, HandleArea, null, null, { UsaPerfilVisualizacaoServico: true });
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, null, null, null, { UsaPerfilVisualizacaoServico: true });
                }

                else {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea, null, null, { UsaPerfilVisualizacaoServico: true });
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, null, null, null, { UsaPerfilVisualizacaoServico: true });
                }

            });
        };

        const HandleArea = function () {
            $('#iArea').unbind('select2:select select2:unselecting');
            $('#iArea').on('select2:select select2:unselecting', function (e) {
                const AreaSelecionada = e.params.data;

                if (AreaSelecionada) {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id), null, "@RsBase.SELECIONE", false, null, null, null, { UsaPerfilVisualizacaoServico: true });
                }
                else {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, null, null, null, { UsaPerfilVisualizacaoServico: true });
                }
            });
        };

        $(document).ready(async function () {
            $("#modal-filter").modal('show');

            await AddSelect("iCategoriaCliente", "@CONSTANTES.URLPortal/api/Categoria_ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            await AddSelect("iNaturezaServico", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleNaturezaServico);
            await AddSelect("iEquipe", "@CONSTANTES.URLPortal/api/EquipeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            await AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            await AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            await AddSelect("iCodCt", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleCodct, null, null, { UsaPerfilVisualizacaoServico: true });
            await AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, null, null, null, { UsaPerfilVisualizacaoServico: true });
            await AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupoArea, null, null, { UsaPerfilVisualizacaoServico: true });
            await AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea, null, null, { UsaPerfilVisualizacaoServico: true });
            await AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, null, null, null, { UsaPerfilVisualizacaoServico: true });

            AddSelect("iSupervisorFiltroTecnico", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iMonitorFiltroTecnico", "@CONSTANTES.URLPortal/api/IdentityUserApi/GetComboUsuarioMonitorEquipe", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iEmpresaFiltroTecnico", "@CONSTANTES.URLPortal/api/Empresaapi/GetComboEmpresaAniel", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleEmpresa);
            AddSelect("iFilialFiltroTecnico", "@CONSTANTES.URLPortal/api/FilialApi/GetComboFilialAniel", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iPerfilAgendamentoFiltroTecnico", "@CONSTANTES.URLPortal/api/PerfilAgendamentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iDepartamentoFiltroTecnico", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetComboAniel", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            ExibirEquipes();

            @if (String.IsNullOrEmpty(Request.Params["Servicos"]) == false)
            {
                <text>
                let servicos = "@Request.Params["Servicos"]";
                servicos = servicos.replaceAll(",", "\n");
                $(`#iNumero_Ordem_Servico`).val(servicos)
                </text>
            }


            var handleDataTableButtons = function () {
                "use strict";

                //"Blfrtip"
                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "Bfrti",
                    columnDefs: [
                        {
                            targets: 0,
                            searchable: false,
                            orderable: false,
                            width: '1%',
                            className: 'dt-body-center',
                            render: function (data, type, full, meta) {
                                return "<input type='checkbox'></input>";
                            }
                        },
                        {
                            targets: "_all",
                            width: '1%',
                        },
                    ],
                    select: {
                        style: 'multi'
                    },
                    order: [[1, 'asc']],
                    stateSave: true,
                    serverSide: true,
                    searching: true,
                    ordering: true,
                    paging: true,
                    deferRender: true,
                    scrollResize: true,
                    scrollY: '54vh',
                    scroller: {
                        loadingIndicator: true
                    },
                    stateSave: true,
                    scrollX: true,
                    fixedHeader: true,
                    initComplete: dataTableInitComplete,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: baseUrl + '/api/Painel_RoteirizacaoApi/GetAll',
                        type: 'POST',
                        data: function (data) {
                            @*Parametros dos filtros*@
                            var numero_Ordem_Servico = $("#iNumero_Ordem_Servico").val();
                            var [servico_agendado, servico_paralisado, servico_Nao_Paralisados, servico_sem_agendamento, servico_sem_roteirizacao, servico_nao_executado,
                                servico_Roteirizados] = [$("#iServ_Agendados").is(":checked"), $("#iServ_Paralisados").is(":checked"),
                                                         $("#iServ_Nao_Paralisados").is(":checked"), $("#iServ_SemAgendamento").is(":checked"),
                                                         $("#iServ_SemRoteirizacao").is(":checked"),$("#iServ_Nao_Executado").is(":checked"), 
                                                         $("#iServ_Roteirizados").is(":checked")];
                                    
                            var [dataAgendados, dataNaoAgendadosIni, dataNaoAgendadosFim, dataNaoRoteirizados] = [$("#idataAgendados").val(), $("#idataNaoAgendadosIni").val(),
                                $("#idataNaoAgendadosFim").val(), $("#idataNaoRoteirizados").val()];
                            
                            var [data_ParalisadoIni, data_ParalisadoFim] = [$("#idata_ParalisadoIni").val(), $("#idata_ParalisadoFim").val()];

                            var [data_Nao_ExecutadoIni, data_Nao_ExecutadoFim] = [$("#idata_Nao_ExecutadoIni").val(), $("#idata_Nao_ExecutadoFim").val()];

                            var [data_RoteirizadosIni, data_RoteirizadosFim] = [$("#iData_RoteirizadosIni").val(), $("#iData_RoteirizadosFim").val()];
                            
                            var [idFilial, idSupervisor, Matricula_Id] = [$("#iFilial").val(), $("#iSupervisor").val(), $("#iEquipe").val()];

                            var [GrupoArea, Area, Localidade] = [$("#iGrupoArea option:selected").val(), $("#iArea option:selected").val(),
                                                                 $("#iLocalidade option:selected").val()];

                            var [CodCt, Projeto, TipoPrioridade] = [$("#iCodCt option:selected").val(), $("#iProjeto option:selected").val(),
                                                                    $("#iTipo_Prioridade option:selected").val()];

                            const [natureza, categoria] = [$("#iNaturezaServico").val(), $("#iCategoriaCliente option:selected").val()];
                            
                            if (Area == undefined)
                                Area = null;

                            if (Localidade == undefined)
                                Localidade = null;

                            data.Numero_Ordem_Servico = numero_Ordem_Servico;
                            data.Servico_Agendado = servico_agendado;
                            data.Servico_Paralisado = servico_paralisado;
                            data.Servico_Nao_Paralisado = servico_Nao_Paralisados;
                            data.Servico_Sem_Agendamento = servico_sem_agendamento;
                            data.Servico_Sem_Roteirizacao = servico_sem_roteirizacao;
                            data.Servico_Nao_Executado = servico_nao_executado;
                            data.Servico_Roteirizados = servico_Roteirizados;

                            data.DataAgendados = dataAgendados;
                            data.NaoAgendadosIni = dataNaoAgendadosIni;
                            data.NaoAgendadosFim = dataNaoAgendadosFim;
                            data.DataNaoRoteirizados = dataNaoRoteirizados;
                            data.Data_ParalisadoIni = data_ParalisadoIni;
                            data.Data_ParalisadoFim = data_ParalisadoFim;
                            data.Data_Nao_ExecutadoIni = data_Nao_ExecutadoIni;
                            data.Data_Nao_ExecutadoFim = data_Nao_ExecutadoFim;
                            data.Data_RoteirizadosIni = data_RoteirizadosIni;
                            data.Data_RoteirizadosFim = data_RoteirizadosFim;

                            data.IdFilial = (idFilial == 0 || idFilial == "0") ? "" : idFilial;
                            data.IdSupervisor = idSupervisor;

                            data.Matricula_Id = Matricula_Id;
                            data.GrupoArea = GrupoArea;
                            data.Area = Area;
                            data.Localidade = Localidade;
                            data.CodCt = CodCt;
                            data.Projeto = Projeto;
                            data.Id_NaturezaServico = natureza;
                            data.Id_CategoriaCliente = categoria;
                            data.TipoPrioridade = TipoPrioridade;

                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        },
                        beforeSend: function () {
                            $("#divProgress").show();
                        },
                        complete: function () {
                            $("#divProgress").hide();
                        },
                    },
                    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                        global_iTotal = iTotal;

                        var str = "@RsCadastros.INFODATATABLE";
                        if (iTotal == 0) { iEnd = 0; iStart = 0; }
                        str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                        $("#dtLegend").html(str);

                        return "";
                    },
                    drawCallback: function () {

                        var api = this.api();
                        var len = api.page.len();

                        if ($("input[name='select_all']").prop('checked') == true) {
                            rowsSelectedMessage();
                        }

                        if (len === -1) {
                            rows_selected = oDatatable.data().toArray().map(p => {
                                return p.codCt + "|" + p.projeto + "|" + p.num_Obra + "|" + p.num_Doc;
                            });

                            $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');

                        }
                    },
                    rowCallback: function(row, data, dataIndex){
                         // Get row ID
                        var rowId = data.codCt + "|" + data.projeto + "|" + data.num_Obra + "|" + data.num_Doc;

                         // If row ID is in the list of selected row IDs
                         if($.inArray(rowId, rows_selected) !== -1){
                            $(row).find('input[type="checkbox"]').prop('checked', true);
                            $(row).addClass('selected');
                         }
                    },
                    pageLength: 10,
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTable,
                    columns: [

                        { title: "<input name='select_all' value='1' type='checkbox'>" },
                        { data: "num_Obra_Original", title: "@RsCadastros.ORDEM_SERVICO" },
                        { data: "cnpj", title: "@RsCadastros.CPF" },
                        { data: "razao_Social", title: "@RsCadastros.CLIENTE" },
                        { data: "grupo_Area", title: "@RsCadastros.GRUPO_AREA" },
                        { data: "area", title: "@RsCadastros.AREA" },
                        { data: "localidade", title: "@RsCadastros.LOCALIDADE" },
                        { data: "tipo_Servico", title: "@RsCadastros.TIPO_SERVICO" },
                        { data: "data_Criacao", title: "@RsCadastros.CRIACAO" },
                        { data: "sla", title: "@RsCadastros.SLA" },
                        { data: "data_Agendamento", title: "@RsCadastros.DATA_AGENDAMENTO" },
                        { data: "hora_Agendamento", title: "@RsCadastros.HORARIO_AGENDAMENTO" },
                        { data: "cliente", title: "@RsCadastros.CLIENTE" },
                        { data: "categoria_Cliente", title: "@RsCadastros.CATEGORIA_CLIENTE" },
                        { data: "tipo_Imovel", title: "@RsCadastros.TIPO_IMOVEL" },
                        { data: "nome_Equipe", title: "@RsCadastros.EQUIPE" },
                        { data: "status", title: "@RsCadastros.STATUS" },
                    ]
                });

                $('#txtSearch').val(oDatatable.search());
                $('#txtSearch').keyup(function () {
                    rows_selected = [];
                    oDatatable.search($(this).val()).draw();
                });

                $("#btnInativar").on("click", function () {

                    if (rows_selected.length == 0) {
                        Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                        return;
                    }

                    //Alterando para Inativo
                    AlterarStatusObj(0);

                });

                $("#btnAtivar").on("click", function () {

                    if (rows_selected.length == 0) {
                        Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                        return;
                    }

                    //Alterando para Inativo
                    AlterarStatusObj(1);
                });


                $("#btnExcluir").on("click", function () {

                    if (rows_selected.length == 0) {
                        Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                        return;
                    }

                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Painel_roteirizacaoApi/excluirlista")';

                    $.ajax({
                        url: link,
                        type: 'POST',
                        dataType: 'json',
                        data: {
                            ids: rows_selected
                        }
                    })
                        .done(function (data) {

                            if (data.ok) {
                                Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                                rows_selected = [];
                                oDatatable.draw();
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        });
                });

                // Handle click on checkbox
                $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                    var $row = $(this).closest('tr');

                    // Get row data
                    var rowId = oDatatable.row($row).data().codCt + "|" +
                        oDatatable.row($row).data().projeto + "|" +
                        oDatatable.row($row).data().num_Obra + "|" +
                        oDatatable.row($row).data().num_Doc;

                    var index = $.inArray(rowId, rows_selected);

                    // If checkbox is checked and row ID is not in list of selected row IDs
                    if (this.checked && index === -1) {
                        rows_selected.push(rowId);

                        // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                    } else if (!this.checked && index !== -1) {
                        rows_selected.splice(index, 1);
                    }

                    if (this.checked) {
                        $row.addClass('selected');
                    } else {
                        $row.removeClass('selected');
                    }

                    if ($("input[name='select_all']").prop("checked")) {

                        //Exibe quantidade de linhas selecionadas
                        rowsSelectedMessage()
                        $("#dtLegendRecordsTotal").show();

                    } else {

                        //Esconde quantidade de linhas selecionadas
                        rowsSelectedMessage()
                        $("#dtLegendRecordsTotal").hide();
                    }

                    // Prevent click event from propagating to parent
                    e.stopPropagation();
                });

                // Handle click on table cells with checkboxes
                $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                    $(this).parent().find('input[type="checkbox"]').trigger('click');
                });

                // Handle click on "Select all" control
                $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');

                    //Exibe quantidade de linhas selecionadas
                    rowsSelectedMessage();
                    $("#dtLegendRecordsTotal").show();

                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');

                    rowsSelectedMessage();
                    $("#dtLegendRecordsTotal").hide();
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    updateDataTableSelectAllCtrl(oDatatable);

                });

            };

            //Pesquisa Log
            $("#iPesquisarLog").on("click", function () {
                erro = false;

                if ($('#iData_Log').val() == "") {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsBase.DATA)", "warning");
                    erro = true;
                }

                if (!erro) {
                    oDatatableLog.search("").draw();
                }
            });

            //Datatable Log_Roteirizacao
            var oDatatableLog = $("#datatableLog").length && $("#datatableLog").DataTable({
                dom: "frti",
                serverSide: true,
                searching: true,
                paging: false,
                //scroller: {
                //        loadingIndicator: true,
                //        rowHeight: 40,
                //        boundaryScale: 0.5,
                //        displayBuffer: 3
                //},
                deferRender: true,
                deferLoading: true,
                autoWidth: false,
                stateSave: true,
                fixedHeader: true,
                scrollY: '22vh',
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/Log_RoteirizacaoApi/GetAll',
                    type: 'POST',
                    data: function (data) {
                        data.DataHoraCriacao = $("#iData_Log").val();
                        data.Usuario = $("#iUsuarioLog option:selected").val();
                        data.Filtro = true;
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                /*pageLength: 5,*/
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                orderable: false,
                columns: [
                    { data: "data_Log", title: "@RsCadastros.DATA_LOG", orderable: false },
                    { data: "usuario", title: "@RsCadastros.USUARIO", orderable: false },
                    { data: "simulacao", title: "@RsCadastros.SIMULACAO", orderable: false },
                    {
                        render: function (data, type, row, meta) {
                            _id = row.id;
                            var _url = '@Url.Action("Log_RoteirizacaoItem", "Painel_Roteirizacao")' + "?id=" + _id;
                            return `<a id='modal-RoteirizacaoItemLog${row.id}' href='#' onclick='parent.AddAba("${_url}","@RsCadastros.DETALHE_LOG_ROTEIRIZACAO")'><i class='icofont-search-document icofont-1dot5x'></i></a>`;
                        },
                        orderable: false
                    }
                ]
            });

            //Fim DataTable Log_Roteirizacao

            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();
        });


        $(".popover-dismiss").popover({
            trigger: "focus"
        });

</script>
}

