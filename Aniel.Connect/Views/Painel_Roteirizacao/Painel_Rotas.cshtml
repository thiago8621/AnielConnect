                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">

                    <div class="col-sm-12 " style="align-content:center;">

                        <div class="row">

                            <div class="col-sm-6">

                                <div class="form-group mb-1">
                                    <label style="font-size:12px">@RsCadastros.EQUIPE</label>
                                    <div class="input-group">
                                        <input type="hidden" id="iMatricula_Id">
                                        <input type="text" class="form-control" id="iMatricula_Nome">

                                        <div class="input-group-append">
                                            <div class="input-group-text" style="max-height:24px">
                                                <i class="fas fa-search"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @*<div class="col-sm-6">
                <label style="font-size:12px">@RsCadastros.EQUIPE</label>
                <div class="input-group mb-1">
                    <input type="hidden" id="iMatricula_Id">
                    <input type="text" class="form-control" id="iMatricula_Nome">
                    <div class="input-group-append">
                        <div class="input-group-text"><i class="fas fa-search"></i></div>
                    </div>
                </div>
            </div>*@

                        </div>


                        <div class="row">

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>@RsCadastros.TIPO_SERVICO</label>
                                    @Html.DropDownList("TipoServico", new SelectList(ViewBag.TipoServico, "Id", "Descricao"), RsBase.SELECIONE, new { @class = "form-control", @id = "iTipoServico" })
                                </div>

                            </div>


                        </div>

                        <div class="row">

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>@RsCadastros.SUPERVISOR</label>
                                    @Html.DropDownList("Supervisor", new SelectList(ViewBag.Supervisor, "Num_Fre", "Nome"), RsBase.SELECIONE, new { @class = "form-control", @id = "iSupervisor" })
                                </div>

                            </div>


                        </div>


                        <div class="row">

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>@RsCadastros.DATA_AGENDAMENTO</label>
                                    @Html.TextBoxFor(m => m.Filtro_Agendamento, new { @class = "form-control datepicker", @data_provide = "datepicker", @id = "iFiltroAgendamento", @autocomplete = "off" })
                                </div>

                            </div>


                        </div>


                        <div class="row mt-2">


                            <div class="col">
                                <div class="form-group">
                                    <label for="iAno">@RsCadastros.GRUPO_AREA:</label>
                                    @Html.DropDownListFor(model => model.Cod_Escritorio, new SelectList(ViewBag.GruposArea, "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iGrupoArea" })


                                </div>

                            </div>


                            <div class="col">
                                <div class="form-group">
                                    <label for="iAno">@RsCadastros.AREA:</label>
                                    @Html.DropDownListFor(model => model.Cod_Area, new SelectList(ViewBag.Areas), RsBase.SELECIONE, new { @class = "form-control", @id = "iArea" })


                                </div>
                            </div>

                            <div class="col">
                                <div class="form-group">
                                    <label for="iAno">@RsCadastros.LOCALIDADE:</label>
                                    @Html.DropDownListFor(model => model.Cod_Localidade, new SelectList(ViewBag.Localidades), RsBase.SELECIONE, new { @class = "form-control", @id = "iLocalidade" })


                                </div>
                            </div>



                        </div>


                    </div>

                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" id="iPesquisar">PESQUISAR</button>
