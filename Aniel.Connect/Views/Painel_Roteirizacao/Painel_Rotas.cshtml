        var oDatatableEquipe = null;
        var oDatatableLog = null;

       function vizualizarMapa() {

            url = "@Url.Action("Mapa_Equipes","Gestao_Equipe")" +  "?Pagina=Rotas";
            window.location = url;
            return false;


        }

        $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {

                $("#iMatricula_Nome").val("");
                $("#iMatricula_Id").val("");
                $("#iTipoServico").val("");
                $("#iSupervisor").val("");
                $("#iGrupoArea").val("")
                $("#iArea").val("")
                $("#iLocalidade").val("");

                oDatatable.draw();
                //oDatatable.search($('#txtSearch').val()).draw();
            });




    $("#iPesquisar").on("click", function () {

                $("#modal-filter").modal('hide');
                oDatatable.draw();

                return true;
            });

    $('#iGrupoArea').change(function () {

       var grupo_area = $('#iGrupoArea option:selected').val();
       var enderecoApi = "@CONSTANTES.URLPortal/api/Areaapi/GetList?grupo_area=" + grupo_area;

            $('#iArea').empty();
            $('#iLocalidade').empty();

            $.ajax({
                url: enderecoApi,
            type: 'GET',
            dataType: 'json'

        })
                .done(function (data) {

                    var option = $('<option></option>').attr('value', "");
                    option.text('@RsBase.SELECIONE');

                    $('#iArea').append(option);
                    $.each(data.objeto, function (key, value) {
                        $('#iArea').append($('<option></option>').attr('value', value.value).text(value.label));
                    });

                    var grupo_area = $('#iGrupoArea option:selected').val();
                    var area = $('#iArea option:selected').val();

                    var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

                    $('#iLocalidade').empty();

                    $.getJSON(enderecoApi, function (data) {
                        $('#iLocalidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                        $.each(data.objeto, function (key, value) {
                            $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));
                        });

                    });
            })
            .fail(function () {
                console.log("error");
            })
            .always(function () {
                try {
                    parent.App.stopPageLoading();
                }
                catch (ex) { console.log(ex); }

            });

        });


        $('#iArea').change(function () {

            var grupo_area = $('#iGrupoArea option:selected').val();
            var area = $('#iArea option:selected').val();

            var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

            $('#iLocalidade').empty();

            $.getJSON(enderecoApi, function (data) {
                $('#iLocalidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                $.each(data.objeto, function (key, value) {
                    $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));
                });

            });


        });

