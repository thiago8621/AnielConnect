                        data.Equipe = equipe;
                        data.Tipo_Servico = tipo_servico;
                        data.Supervisor = supervisor;
                        data.Grupo_Area = grupo;
                        data.Area = area;
                        data.Localidade = localidade;
                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
