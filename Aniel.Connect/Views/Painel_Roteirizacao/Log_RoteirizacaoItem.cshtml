@model  Aniel.Connect.Models.Log_RoteirizacaoItemListaModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@{
    ViewBag.Title = RsCadastros.DETALHE_LOG_ROTEIRIZACAO;
    ViewBag.Sessao = RsCadastros.LOG;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    var StorageName = CONSTANTES.SIGLA_MODULO + " - " + ViewBag.Title + " - " + CONSTANTES.Versao;
}
@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />
}

@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
<script>

        var rows_selected = [];
        var oDatatableDetalheLog;
    //filtro
    $('#iProjeto').val(null).trigger('change');
    $('#iSegmento').val(null).trigger('change');
    $('#iArea').val(null).trigger('change');
    $('#iLocalidade').val(null).trigger('change');
    $('#iGrupoArea').val(null).trigger('change');
    $('#iId_Monitor').val(null).trigger('change');
    $('#iId_Supervisor').val(null).trigger('change');



        function findStoragedProperty(id) {
            const storageItem = window.localStorage.getItem("@Html.Raw(StorageName)")
            let filtros = storageItem ? JSON.parse(storageItem) : [];
            let filtro = filtros.filter(p => p.id == id);

            if (filtro.length > 0)
                return filtro[0].value;
            else
                return null;
        }

        //Handle

        var HandleGrupo = function () {
            $('#iGrupoArea').unbind('select2:select select2:unselecting');
            $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

                GrupoSelecionado  = e.params.data
                if (GrupoSelecionado) {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false, HandleArea);
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

                else {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };

        var HandleArea = function () {
            $('#iArea').unbind('select2:select select2:unselecting');
            $('#iArea').on('select2:select select2:unselecting', function (e) {

                AreaSelecionada = e.params.data
                if (AreaSelecionada) {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id) , null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };

        var HandleSegmento = function () {

            $('#iSegmento').unbind('select2:select select2:unselecting');
            $('#iSegmento').on('select2:select select2:unselecting', function (e) {

                SegmentoSelecionado = e.params.data
                if (SegmentoSelecionado) {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, SegmentoSelecionado.id, null, "@RsBase.SELECIONE", false);
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, SegmentoSelecionado.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                    AddSelect("iSubTipoServico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
    };

    function Fix_Filtro() {

         $("input[name='iTipoData']:radio").click(function () {

             if ($('input[name="iTipoData"]:checked').val() == "1") {
                 $('#iDataInicial').prop("disabled", true);
                 $('#iDataFinal').prop("disabled", true);
             }
             else {
                 $('#iDataFinal').prop("disabled", false);
                 $('#iDataInicial').prop("disabled", false);
             };
         });

    $(document).ready(async function () {

         $('#iDataInicial').prop("disabled", true);
         $('#iDataFinal').prop("disabled", true);

            const storageItem = window.localStorage.getItem("@Html.Raw(StorageName)")
            let filtros = storageItem ? JSON.parse(storageItem) : [];
            for (const filtro of filtros) {
                if ($(`#${filtro.id}`).attr('type') == 'checkbox' || $(`#${filtro.id}`).attr('type') == 'radio') {
                    $(`#${filtro.id}`).prop('checked', filtro.checked)
                }
                else {
                    $(`#${filtro.id}`).val(filtro.value)
                }
            }

            await AddSelect("iSegmento", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, findStoragedProperty('iSegmento'), "@RsBase.SELECIONE",false,HandleSegmento);
            await AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, findStoragedProperty('iProjeto'), "@RsBase.SELECIONE",true);
            await AddSelect("iId_Supervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, findStoragedProperty('iId_Supervisor'), "@RsBase.SELECIONE", false);
            await AddSelect("iId_Monitor", "@CONSTANTES.URLPortal/api/IdentityUserApi/GetComboMonitor", @CONSTANTES.PaginacaoRegistros, null, null, findStoragedProperty('iId_Monitor'), "@RsBase.SELECIONE", false);
            await AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, findStoragedProperty('iGrupoArea'), "@RsBase.SELECIONE", false, HandleGrupo);
            await AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, findStoragedProperty('iGrupoArea'), findStoragedProperty('iArea'), "@RsBase.SELECIONE", findStoragedProperty('iGrupoArea') != null ? false : true, HandleArea);
            await AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, findStoragedProperty('iGrupoArea'), findStoragedProperty('iArea'), findStoragedProperty('iLocalidade'), "@RsBase.SELECIONE", findStoragedProperty('iArea') != null ? false : true);

     });
  }

    Fix_Filtro();

    $("#iPesquisar").on("click", function () {


                if (ValidaCamposObrigatorios(false)) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                    return false;
                }


               if ($("#iDataInicial").val()) {
                    $("#iDataInicial").val($("#iDataInicial").val().replace(/\//g, "."));
                    $("#iDataFinal").val($("#iDataFinal").val().replace(/\//g, "."));

                    var _data_ini = $("#iDataInicial").val().split(".");
                    var _data_fim = $("#iDataFinal").val().split(".");

                    var data_ini = new Date(_data_ini[2], _data_ini[1] - 1, _data_ini[0]);
                    var data_fim = new Date(_data_fim[2], _data_fim[1] - 1, _data_fim[0]);

                    if (data_ini > data_fim) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.DATA_INVALIDA)", "warning");
                        return false;
                    }
        }

        rows_selected = [];
        oDatatableDetalheLog.search($('#txtSearchPrincipal').val()).draw();

        $("#modal-filter").modal('hide');
        return true;

    });

    $("#iLimparFiltroModal, #iLimparFiltros").on("click", function () {

        Fix_Filtro();

        $('#iDataInicial').val('');
        $('#iDataFinal').val('');
        $("#istatussla").val(null).trigger('change');


        $($('input:radio[name="iTipoData"]')[0]).prop('checked', true);


        $($('input:radio[name="somente"]')[0]).prop('checked', true);

                window.localStorage.removeItem("@Html.Raw(StorageName)");

                rows_selected = [];
        oDatatableDetalheLog.search($('#txtSearchPrincipal').val()).draw();

    });

    $($('input:radio[name="iTipoData"]')[0]).prop('checked', true);

        var handleDataTableButtons = function () {
            "use strict";

            oDatatableDetalheLog = $("#datatableDetalheLog").length && $("#datatableDetalheLog").DataTable({
                dom: "Bfrti",
                columnDefs: [
                    //{
                    //    targets: 0,
                    //    searchable: false,
                    //    orderable: false,
                    //    width: '1%',
                    //    className: 'dt-body-center',
                    //    render: function (data, type, full, meta) {
                    //        return "<input type='checkbox'></input>";
                    //    }
                    //}
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollY: '79vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 10,
                    boundaryScale: 0.2,
                    displayBuffer: 100
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/Log_RoteirizacaoItemApi/GetAll',
                    type: 'POST',
                    data: function (data) {

                        var segmento = $("#iSegmento option:selected").val();
                        var projeto = $("#iProjeto option:selected").val();
                        var supervisor = $("#iId_Supervisor").val();
                        var monitor = $("#iId_Monitor").val();
                        var grupo_area = $("#iGrupoArea option:selected").val();
                        var area = $("#iArea option:selected").val();
                        var localidade = $("#iLocalidade").val() ? $("#iLocalidade option:selected").text() : null;
                        var dataini = $("#iDataInicial").val();
                        var datafim = $("#iDataFinal ").val();
                        var vencimento = $("#iDataVencimentoAte").val();
                        var sla = $("#istatussla").val() ? $("#istatussla option:selected").text() : null;



                        data.Contrato_filtro = segmento;
                        data.Projeto_filtro = projeto;
                        data.Numfre_Supervisor = supervisor;
                        data.Usuario_Monitor = monitor;
                        data.Grupo_area_filtro = grupo_area;
                        data.Area_filtro = area;
                        data.Localidade_filtro = localidade;
                        data.DataInicial = dataini;
                        data.DataFinal = datafim;
                        data.Vencimentoate_filtro = vencimento;
                        data.Sla_filtro = sla;


                        data.id = @Request.Params["Id"];
                        data.somente_LogRoteirizacao = $('input[name="somente"]:checked').val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        console.log(d.data);
                        return d.data;
                    },
                    beforeSend: function () {
                        $("#divProgress").show();
                    },
                    complete: function () {
                        $("#divProgress").hide();
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function (row, data, dataIndex) {
                    // Get row ID
                    var rowId = data.id;

                    // If row ID is in the list of selected row IDs
                    if ($.inArray(rowId, rows_selected) !== -1) {
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                    }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    //{ title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "codct", title: "@RsCadastros.CONTRATO" },
                    { data: "projeto", title: "@RsCadastros.PROJETO" },
                    {
                        data: "num_Obra", title: "@RsCadastros.NUMERO_OS", "render": function (data, type, row, meta) {

                            var link = "@Url.Action("Index", "Acompanhamento_Servico")" + "?CodCt=" + row.codct + '&Pagina=acompanhamento' + '&Projeto=' + row.projeto + '&Num_Obra=' + data + '&Num_Doc=' + row.num_Doc;
                            return `<a href="#" onclick='AddAba("${link}")' title="">${data}</a>`

                        }
                    },
                    { data: "num_Doc", title: "@RsCadastros.NUM_DOC" },
                    { data: "motivo", title: "@RsCadastros.JUSTIFICATIVA_LOG" },
                    { data: "desc_tipo_serv", title: "@RsCadastros.TIPO_SERVICO" },
                    { data: "descNatureza", title: "@RsCadastros.NATUREZA" },
                    { data: "cliente", title: "@RsCadastros.CLIENTE" },
                    { data: "nome_equipe", title: "@RsCadastros.EQUIPE" },
                    { data: "fornecedorAtual", title: "@RsCadastros.FORNECEDOR", defaultContent: "-" },
                    { data: "posicaoFila", title: "Posição do Técnico na fila" },
                    { data: "utilizaOsReincidencia", title: "OS de @RsCadastros.REINCIDENCIA", defaultContent: "-", render: function (data) { if (data) return `SIM`; else return `NÃO`} },
                    { data: "tecnicoAnterior", title: "@RsCadastros.TECNICO Anterior", defaultContent: "-" },
                    { data: "fornecedorAnterior", title: "@RsCadastros.FORNECEDOR Anterior", defaultContent: "-" },
                    { data: "data_hora_ini_agendamento", title: "@RsCadastros.DATA_HORA_AGENDAMENTO" },
                    { data: "desc_escritorio", title: "@RsCadastros.GRUPO_AREA" },
                    { data: "desc_area", title: "@RsCadastros.AREA" },
                    { data: "localidade", title: "@RsCadastros.LOCALIDADE" },
                    { data: "numfre_Supervisor", title: "@RsCadastros.SUPERVISOR" },
                    { data: "usuario_Monitor", title: "@RsCadastros.MONITOR" },
                    { data: "possuiLatLong", title: "Possui Lat/Long" },
                    { data: "latitudeOS", title: "Latitude OS" },
                    { data: "longitudeOS", title: "Longitude OS" },
                    { data: "latitudeCaixa", title: "Latitude Caixa" },
                    { data: "longitudeCaixa", title: "Longitude Caixa" },
                    { data: "latitudeLocalidade", title: "Latitude Localidade" },
                    { data: "longitudeLocalidade", title: "Longitude Localidade" },
                    { data: "pontoPartida", title: "Ponto de Partida" },
                    { data: "latitudePontoPartida", title: "Latitude Ponto de Partida" },
                    { data: "longitudePontoPartida", title: "Longitude Ponto de Partida" },
                    {
                        data: "sla",
                        title: "@RsCadastros.SLA",
                        render: function (data,type) {

                            if (type === "export") {
                                return data;
                            }


                            switch (data) {
                                case "Dentro do Prazo":
                                    return "<div data-toggle='tooltip' data-placement='top' class='text-center' title='" + data + "'>" + "<i class='fas fa-flag mr-1' style='color: dodgerblue'></i></div>";
                                    break;
                                case "Atenção":
                                    return "<div data-toggle='tooltip' data-placement='top' class='text-center' title='" + data + "'>" + "<i class='fas fa-flag mr-1' style='color: #ffd700'></i></div>";
                                    break;
                                case "Próximo do Vencimento":
                                    return "<div data-toggle='tooltip' data-placement='top' class='text-center' title='" + data + "'>" + "<i class='fas fa-flag mr-1' style='color: #FFA500'></i></div>";
                                    break;
                                case "Risco de Perda do Prazo":
                                    return "<div data-toggle='tooltip' data-placement='top' class='text-center' title='" + data + "'>" + "<i class='fas fa-flag mr-1' style='color: hotpink'></i></div>";
                                    break;
                                case "Prazo Vencido":
                                    return "<div data-toggle='tooltip' data-placement='top' class='text-center' title='" + data + "'>" + "<i class='fas fa-flag mr-1' style='color: #B22222'></i></div>";
                                    break;
                                case "Prazo Cumprido":
                                    return "<div data-toggle='tooltip' data-placement='top' class='text-center' title='" + data + "'>" + "<i class='fas fa-flag mr-1' style='color: limegreen'></i></div>";
                                    break;
                                default:
                                    return "<div data-toggle='tooltip' data-placement='top' class='text-center' title='" + data + "'>" + "<i class='fas fa-flag mr-1' style='color: gray'></i></div>";
                            }

                        }

                    },
                    { data: "data_Hora_Vencimento_OS", title: "@RsCadastros.DATA_HORA_VENCIMENTO_OS" },
                    { data: "origemAgendamento", title: "@RsCadastros.ORIGEM_AGENDAMENTO" },
                    { data: "nivelRodadaRoteirizada", title: "Rodada Nivel Localidade" },
                    { data: "agrupamentoRodadaRoteirizada", title: "Rodada Agrupamento" },
                    { data: "ordemDistribuida", title: "Ordem Distribuida" },
                ]
            });

                $('#txtSearchPrincipal').val(oDatatableDetalheLog.search());
                $('#txtSearchPrincipal').keyup(function () {
                    rows_selected = [];
                    oDatatableDetalheLog.search($(this).val()).draw();
                });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

    TableManageButtons.init();

</script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->
    <div class="row" style="padding-top: 10px;">
        <div class="col-auto mr-auto" style="margin-top: -10px;">
            <h4 class="title-page"><i class="fas fa-users"></i> @ViewBag.Title</h4>
            <nav aria-label="breadcrumb" style="font-size:12px">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item" style="margin-left:22px; margin-top:-18px">
                        <a href="@Url.Action("Index", "Painel_Roteirizacao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_ROTEIRIZACAO</a>
                    </li>
                    <li class="breadcrumb-item" style="margin-top:-18px">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>
            <span style="font-size:11px;margin-left: 15px;" id="dtLegend"></span>
        </div>

        <div class="col-auto">
            <div class="row title-page">



                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearchPrincipal" placeholder="@RsCadastros.ORDEM_SERVICO" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>

                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO">
                    <i class="la la-filter la-2x" style="color: #999"></i>
                </button>
                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>


                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="AddAba('@Url.Action("Mapa_Equipes","Painel_Roteirizacao")?IdLog=@Request.Params["id"]')">@RsCadastros.VISUALIZAR_ROTA</a>
                </div>
            </div>
        </div>

    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatableDetalheLog" style="width:100%">
    </table>
</div>

<!--./main-->

<div class="modal" id="modal-filter">
    <div class="modal-dialog modal-lg" style="width:50%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">


                <!--Modal Filters-->

                <div class="row">
                    <div class="col">
                        <div class="form-group mt-2">
                            <input id="iTodos" type="radio" checked name="somente" value=""><label for="iTodos">&nbsp;@RsBase.TODOS</label>&emsp;
                            <input id="iRoterizados" type="radio" name="somente" value="1"><label for="iRoterizados">&nbsp;@RsCadastros.SOMENTE_ROTERIZADOS</label>&emsp;
                            <input id="iNaoRoterizados" type="radio" name="somente" value="0"><label for="iNaoRoterizados">&nbsp;@RsCadastros.SOMENTE_NAO_ROTERIZADOS</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iSegmento">@RsCadastros.CONTRATO:</label>
                            @Html.DropDownList("Segmento", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iSegmento", @autocomplete = "off" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iProjeto">@RsCadastros.PROJETO:</label>
                            <select class="form-control" id="iProjeto"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.SUPERVISOR:</label>
                            @Html.DropDownListFor(model => model.Id_Supervisor, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iId_Supervisor", @autocomplete = "off" })
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.MONITOR:</label>
                            @Html.DropDownListFor(model => model.Id_Monitor, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iId_Monitor", @autocomplete = "off" })
                        </div>
                    </div>
                </div>
                <div class="row border_radius">
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label for="iGrupoArea">@RsCadastros.GRUPO_AREA:</label>
                            @Html.DropDownList("Grupo_Area", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iGrupoArea", @autocomplete = "off" })
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label for="iArea">@RsCadastros.AREA:</label>
                            @Html.DropDownList("Area", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iArea", @autocomplete = "off" })
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label for="iLocalidade">@RsCadastros.LOCALIDADE:</label>
                            @Html.DropDownList("Localidade", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iLocalidade", @autocomplete = "off" })
                        </div>
                    </div>
                </div>
                <div class="row border_radius">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-group">
                                <label for="istatussla">@RsCadastros.SLA:</label>
                                @Html.EnumDropDownListFor(model => model.statussla, RsBase.SELECIONE, new { @class = "form-control filtro", @id = "istatussla", @autocomplete = "off" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row border_radius">
                    <div class="col-sm-5">
                        <div class="form-group">
                            <label>Período:</label>
                            <div class="custom-control custom-radio">
                                <input type="radio" class="filtro" id="iNenhum" name="iTipoData" value="1" /><label for="iNenhum">@RsBase.TODOS</label>
                            </div>

                            <div class="custom-control custom-radio">
                                <input type="radio" class="filtro" id="iDataVencimentoAte" name="iTipoData" value="2" /><label for="iDataVencimentoAte">@RsCadastros.DATA_VENCIMENTO</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-7">

                        <div class="form-group form-inline" style="height:100%; vertical-align:middle;">

                            <label for="iDataInicial">@RsCadastros.PERIODO:</label>
                            @Html.TextBoxFor(model => model.DataInicial, new { @tabindex = "1", @class = "form-control filtro col-sm-3 ml-2 mr-2 datepicker", @id = "iDataInicial", @autocomplete = "off" })

                            &nbsp;&ensp;<span>@RsBase.A</span>&ensp;

                            @Html.TextBoxFor(model => model.DataFinal, new { @tabindex = "2", @class = "form-control filtro col-sm-3 ml-2 mr-2 datepicker", @id = "iDataFinal", @autocomplete = "off" })
                        </div>
                    </div>
                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                    </div>
                </div>

            </div>


        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div>
<div class="overlay" id="divProgress" style="display:none;">
    <div class="preloaderbar show active">
        <span class="bar"></span>
        <span class="text">@RsCadastros.PROCESSANDO...</span>
    </div>
</div>