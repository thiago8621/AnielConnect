@model Aniel.Connect.Models.FranquiaCadastroModel

@{

    ViewBag.Title = RsCadastros.CADASTRO_FRANQUIA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
    {
    <style>
        .popover-body {
            background-color: #357CA5;
            color: white;
        }
    </style>
}

@section scripts
{

    <script>
    let clicked = false
        let erro = false

        $("#iMinutos").on("keydown keyup", function () {
            let regex = /[A-Za-z]/g;
            let data = '' + $(this).val();
            data = data.replace(regex, "");
           $("#iMinutos").val(data);            

        });

    function validaSubmit() {

        if (clicked) {
            return false
        }

        clicked = true
        erro = false

        if (!$('#iDescricao').val()) {

            Notificar("@RsBase.ATENCAO_", '@RsCadastros.DESCRICAO não informada', "warning");
            erro = true;
        }

        if (!$('#iMinutos').val()) {

            Notificar("@RsBase.ATENCAO_", '@RsCadastros.MINUTOS_FRANQUIA não informada', "warning");
            erro = true;
        }


        if (erro) {
            clicked = false;
            return;
        }
        $('#form').submit();

    }

    </script>
}

@using (Html.BeginForm("Cadastro", "Franquia", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-tachometer-alt"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GESTAO_CONEXOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Franquia")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_FRANQUIAS</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>



                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">


                            <div class="row">
                                <div class="col-sm-4 mr-auto">

                                    <div class="form-group">
                                        <label for="iDescricao">@RsCadastros.DESCRICAO:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off", @Maxlength = 50 })
                                    </div>

                                </div>

                                <div class="col-sm-2">
                                    @if (Model.Id != 0)
                                    {
                                        <div class="form-group">
                                            <label class="mr-3">@RsFinanceiro.STATUS:</label><br>
                                            @Html.CheckBoxFor(model => model.Status, new { @class = "form-control", @id = "iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    }
                                </div>

                            </div>

                            <div class="row">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iMinutos">@RsCadastros.DIGITE_MINUTOS_FRANQUIA:</label>
                                        @Html.TextBoxFor(model => model.Minutos, new { @class = "form-control", @id = "iMinutos", @maxlength = "20", @placeholder = "1000", @autocomplete = "off" })
                                    </div>

                                </div>
                            </div>


                            <div class="row">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iVc1" class="mr-3">@RsCadastros.VC1:</label><br>
                                        @Html.CheckBoxFor(model => model.Vc1, new { @class = "form-control", @id = "iVc1", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        <i class=" ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="@RsCadastros.MENSAGEM_VC1"></i>
                                    </div>
                                </div>

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iVc2" class="mr-3">@RsCadastros.VC2:</label><br>
                                        @Html.CheckBoxFor(model => model.Vc2, new { @class = "form-control", @id = "iVc2", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        <i class=" ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="@RsCadastros.MENSAGEM_VC2"></i>
                                    </div>
                                </div>

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iVc3" class="mr-3">@RsCadastros.VC3:</label><br>
                                        @Html.CheckBoxFor(model => model.Vc3, new { @class = "form-control", @id = "iVc3", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        <i class=" ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="@RsCadastros.MENSAGEM_VC3"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iLc" class="mr-3">@RsCadastros.LC:</label><br>
                                        @Html.CheckBoxFor(model => model.Lc, new { @class = "form-control", @id = "iLc", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        <i class=" ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="@RsCadastros.MENSAGEM_LC"></i>
                                    </div>
                                </div>

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iVc" class="mr-3">@RsCadastros.LDN:</label><br>
                                        @Html.CheckBoxFor(model => model.Ldn, new { @class = "form-control", @id = "iLdn", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        <i class=" ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="@RsCadastros.MENSAGEM_LDN"></i>
                                    </div>
                                </div>

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iVc" class="mr-3">@RsCadastros.LDI:</label><br>
                                        @Html.CheckBoxFor(model => model.Ldi, new { @class = "form-control", @id = "iLdi", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                        <i class=" ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="@RsCadastros.MENSAGEM_LDI"></i>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Franquia")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return validaSubmit();" name="gravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>
    </div>
}