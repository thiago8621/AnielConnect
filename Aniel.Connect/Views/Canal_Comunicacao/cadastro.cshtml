@using Aniel.Connect.CustomHtmlHelper
@model Aniel.Connect.Models.Canal_Comunicacao_CadastroModel
@{
    /**/

    ViewBag.Title = RsCadastros.DETALHES_CANAL;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles{
    <style>
        .status-div {
        }

        .approved {
            color: green;
        }

        .rejected {
            color: red;
        }

        .paused {
            color: orange;
        }

        .pending {
            color: blue;
        }

        .unavailable {
            color: gray;
        }
    </style>
}

@section scripts
{

    @if (Model.Id == 0)
    {
        <text>
            <script>
                $("#iNomeAtendente").prop("checked", true).change();;
                $("#iNomeAtendenteTelegram").prop("checked", true).change();;
                $("#iNomeAtendenteMessenger").prop("checked", true).change();;
                $("#iNomeAtendenteInstagram").prop("checked", true).change();;
            </script>
        </text>
    }

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script>
    AddSelect("iModeloPadrao", "@CONSTANTES.URLPortal/api/ModeloMensagemApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdModeloPadraoWhatsApp", "@RsBase.SELECIONE", false);

    if (@Request.Params["IdCanal"] != "") {
            var tipoCanal = @Request.Params["IdCanal"];
            document.getElementById('iTipoCanal').value = tipoCanal;
    }

    $(document).ready(async () => {

        //var statusModeloWhatsApp = "@Model.StatusModeloPadraoWhatsApp";
        //verificaStatusModelo(statusModeloWhatsApp);

        var idCanal = "@Model.Id";
        @*@if(Model.Id!= 0 )
        {
         <text>
         verificaStatusModelo(idCanal);
         </text>
        }*@
        $("#iTipoCanal").trigger("change");
    });

function verificaStatusModelo(idCanal) {
    var url = "@CONSTANTES.URLPortal" + "/api/ModeloMensagemApi/AtualizarStatusModeloMensagem?idCanalComunicacao=" + idCanal;
    $.ajax({
        url: url,
        type: "POST",
        dataType: "json"
    })
        .done(function (data) {
            if (data && data.ok) {
                //var statusModeloWhatsApp = data.mensagem;
                //exibirStatusModelo(statusModeloWhatsApp);
            } else {
                Notificar("@RsBase.ATENCAO_", "Ocorreu um erro ao obter o status do modelo.", "warning");
            }
        })
        .fail(function (jqXHR, textStatus, errorThrown) {
            Notificar("@RsBase.ATENCAO_", "Ocorreu um erro ao obter o status do modelo.", "warning");
        });
    }



function exibirStatusModelo(status) {
    var statusText;
    var statusClass;

    switch (status) {
        case "APPROVED":
            statusText = "Aprovado";
            statusClass = "approved";
            break;

        case "REJECTED":
            statusText = "Rejeitado";
            statusClass = "rejected";
            break;

        case "PAUSED":
            statusText = "Pausado";
            statusClass = "paused";
            break;

        case "PENDING":
            statusText = "Pendente";
            statusClass = "pending";
            break;

        default:
            statusText = "Indisponível";
            statusClass = "unavailable";
            break;
    }

    $("#divStatusModeloWhatsApp").text(statusText).addClass(statusClass);
}
    $("#iModeloPadrao").on("change", function () {
        if ($('#iModeloPadrao').val()) {
            $("#divConsulta").show();
        } else {
            $("#divConsulta").hide();
        }
    });

    $("#iTipoCanal").on("change", function () {
            //WhatsApp
            if ($('#iTipoCanal').val() == 0) {
                $("#divWhatsApp").show();
                $("#divTelegram").hide();
                $("#divMessenger").hide();
                $("#divInstagram").hide();
            }


            //Telegram
            else if ($('#iTipoCanal').val() == 1) {
                $("#divTelegram").show();
                $("#divWhatsApp").hide();
                $("#divMessenger").hide();
                $("#divInstagram").hide();
            }
            //Facebook Messenger
            else if ($('#iTipoCanal').val() == 2) {
                $("#divMessenger").show();
                $("#divWhatsApp").hide();
                $("#divTelegram").hide();
                $("#divInstagram").hide();
            }
            //Instagram Direct
            else if ($('#iTipoCanal').val() == 3) {
                $("#divMessenger").hide();
                $("#divWhatsApp").hide();
                $("#divTelegram").hide();
                $("#divInstagram").show();
            }
            else {
                $("#divTelegram").hide();
                $("#divWhatsApp").hide();
                $("#divMessenger").hide();
                $("#divInstagram").hide();
            }
        });


    var clicked = false;

    AddSelect("iBot", "@CONSTANTES.URLPortal/api/Botapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdBot", "@RsBase.SELECIONE", false);


        var inp = document.getElementById('iImagemInput');
        inp.addEventListener('change', function (e) {
            var file = this.files[0];
            var reader = new FileReader();
            reader.onload = function () {
                document.getElementById('iImagem').src = this.result;
            };
            reader.readAsDataURL(file);
        }, false);

        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;

            var erro = false;

            somenteNumeros("iNumero");

            if ($('#iNome').val() == "") {
                Notificar("@RsBase.ATENCAO_", "Informe Nome do Canal", "warning");
                erro = true;
            }

            if (erro) {
                clicked = false;
                return false;
            }
            ShowPageLoading();
            $('#form').submit();

        }
    </script>
}

@using (Html.BeginForm("Cadastro", "Canal_Comunicacao", FormMethod.Post, htmlAttributes: new { enctype = "multipart/form-data", @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"> @ViewBag.Title </h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Canal_Comunicacao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURAWHATSAPP</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>

                        @*<span style="font-size:11px" id="dtLegend"></span>*@
                    </div>
                </div>

                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <span class="text-bold-card pt-0">@ViewBag.Title</span>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="container mt-5 mb-5">
                                <div class="row">

                                    <div class="col">
                                        @Html.Image("iImagem", Model.Imagem, Model.Nome, "100", "120")
                                        <input class="m-3" id="iImagemInput" type="file" name="Files[0]" sdata-index=0 />
                                    </div>
                                    <div class="col">
                                        <div class="row">
                                            <div class="form-group col-sm-12">
                                                <label for="iNome" class="mr-3">@RsCadastros.NOME_CANAL:</label><br>
                                                @Html.TextBoxFor(m => m.Nome, new { @class = "form-control", id = "iNome" })
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="form-group col-sm-12">
                                                <label for="iDescCanal" class="mr-3">@RsCadastros.DESCRICAO_CANAL:</label><br>
                                                @Html.TextBoxFor(m => m.Descricao, new { @class = "form-control", id = "iDescCanal" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="iTipoCanal">Tipo Canal:</label>
                                            @Html.EnumDropDownListFor(m => m.TipoCanalComunicacao, RsBase.SELECIONE, new { @class = "form-control obrigatorio", @name = "iTipoCanal", @id = "iTipoCanal", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(model => model.TipoCanalComunicacao, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-2">
                                    <div class="form-group ">
                                        <label for="iEmail" class="mr-3">@RsCadastros.EMAIL:</label><br>
                                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", id = "iEmail" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group ">
                                        <label for="iSite" class="mr-3">@RsCadastros.SITE:</label><br>
                                        @Html.TextBoxFor(m => m.Site, new { @class = "form-control", id = "iSite" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group ">
                                        <label for="iBot" class="mr-3">@RsCadastros.BOT_VINCULADO:</label><br>
                                        @Html.DropDownListFor(m => m.IdBot, new List<SelectListItem>(), RsBase.SELECIONE, new { @class = "form-control", id = "iBot" })
                                    </div>
                                </div>

                                <div id="divWhatsApp" style="display: none">
                                    <div class="row">
                                        <div class="form-group ">
                                            <label for="iNumero" class="mr-3">@RsCadastros.NUMERO:</label><br>
                                            @Html.TextBoxFor(m => m.Numero, new { @class = "form-control", id = "iNumero" })
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="form-group ">
                                            <label for="iTokenWhatsApp" class="mr-3">@RsCadastros.TOKEN_WHATSAPP_BUS:</label><br>
                                            @Html.TextBoxFor(m => m.TokenWhatsAppBusiness, new { @class = "form-control", id = "iTokenWhatsApp" })
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="form-group ">
                                            <label for="iNumeroIdWhatsApp" class="mr-3">@RsCadastros.NUMERO_ID_WHATSAPP_BUSINESS:</label><br>
                                            @Html.TextBoxFor(m => m.IdNumeroWhatsAppBusiness, new { @class = "form-control", id = "iNumeroIdWhatsApp" })
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="form-group ">
                                            <label for="iIdWhatsApp" class="mr-3">@RsCadastros.ID_WHATSAPP_BUSINESS:</label><br>
                                            @Html.TextBoxFor(m => m.WhatsAppBusinessAccount, new { @class = "form-control", id = "iIdWhatsApp" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group">
                                        <label for="iModeloPadrao">
                                            @RsCadastros.MODELO_PADRAO:

                                            <i class="fas fa-question-circle fa-1x" style="color: #2092EC" data-toggle="popover" data-html="true" title="Modelo Padrão de Mensagem do WhatsApp Business"
                                               data-content="<div style='font-size: 10px'>
                                                          <span class='p-3'>•	É possível editar somente os modelos com status APROVADO, REJEITADO ou PAUSADO.</span><br />
                                                          <span class='p-3'>•	Os modelos aprovados podem ser editados até 10 vezes dentro de 30 dias ou uma vez dentro de 24 horas. Não há restrição para o número de edições de modelos rejeitados ou pausados.</span><br />
                                                          <span class='p-3'>•	Depois de editar um modelo aprovado ou pausado, ele será aprovado automaticamente, a não ser que seja reprovado na análise do modelo.</span><br />
                                                          <span class='p-3'>•	Este modelo será enviado para o usuário todas as vezes que o atendente assumir a conversa fora do ciclo de 24 horas.</span><br />
                                                          </div>">
                                                          </i>
                                        </label><br>
                                        @Html.DropDownListFor(p => p.IdModeloPadraoWhatsApp, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iModeloPadrao", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.IdModeloPadraoWhatsApp, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div id="divConsulta" style="display: none">
                                    <div class="row mt-2 mb-2">
                                        <div class="form-group col-sm-12" style="padding: 15px;">
                                            <div class="text-left">
                                                <button type="button" class="btn btn-success" data-toggle="modal" onclick="verificaStatusModelo(@Model.Id);  return true;" id="iConsulta">Consulta Integração</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div id="divTelegram" style="display: none">
                            <div class="row">
                                <div class="form-group ">
                                    <label for="iTokenTelegram" class="mr-3">@RsCadastros.TOKEN_TELEGRAM:</label><br>
                                    @Html.TextBoxFor(m => m.TokenTelegram, new { @class = "form-control", id = "iTokenTelegram" })
                                </div>
                            </div>
                        </div>

                        <div id="divMessenger" style="display: none">
                            <div class="row">
                                <div class="form-group ">
                                    <label for="iTokenMessenger" class="mr-3">@RsCadastros.TOKEN_MESSENGER:</label><br>
                                    @Html.TextBoxFor(m => m.TokenMessenger, new { @class = "form-control", id = "iTokenMessenger" })
                                </div>
                            </div>
                        </div>

                        <div id="divInstagram" style="display: none">
                            <div class="row">
                                <div class="form-group ">
                                    <label for="iTokenInstagram" class="mr-3">@RsCadastros.TOKEN_INSTAGRAM:</label><br>
                                    @Html.TextBoxFor(m => m.TokenInstagram, new { @class = "form-control", id = "iTokenInstagram" })
                                </div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Canal_Comunicacao")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" onclick="ValidaSubmit();" class="float-save" id="btnGravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>
    </div>


}
