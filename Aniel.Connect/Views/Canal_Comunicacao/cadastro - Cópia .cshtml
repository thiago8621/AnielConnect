@using Aniel.Connect.CustomHtmlHelper
@model Aniel.Connect.Models.Canal_Comunicacao_CadastroModel
@{
    /**/

    ViewBag.Title = RsCadastros.DETALHES_CANAL;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script>
    var clicked = false;

        AddSelect("iBot", "@CONSTANTES.URLPortal/api/Botapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdBot", "@RsBase.SELECIONE", false);
        var inp = document.getElementById('iImagemInput');
        inp.addEventListener('change', function (e) {
            var file = this.files[0];
            var reader = new FileReader();
            reader.onload = function () {
                document.getElementById('iImagem').src = this.result;
            };
            reader.readAsDataURL(file);
        }, false);

        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;

            var erro = false;

            somenteNumeros("iNumero");

            if ($('#iNome').val() == "") {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsBase.NOMEREQUIRED)", "warning");
                erro = true;
            }

            if (erro) {
                clicked = false;
                return false;
            }
            ShowPageLoading();
            $('#form').submit();

        }
    </script>
}

@using (Html.BeginForm("Cadastro", "Canal_Comunicacao", FormMethod.Post, htmlAttributes: new { enctype = "multipart/form-data", @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"> @ViewBag.Title </h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Canal_Comunicacao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURAWHATSAPP</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>

                        @*<span style="font-size:11px" id="dtLegend"></span>*@
                    </div>
                </div>
                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <span class="text-bold-card pt-0">@ViewBag.Title</span>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="container mt-5 mb-5">
                                <div class="row">

                                    <div class="col">
                                        @Html.Image("iImagem", String.IsNullOrEmpty(Model.Imagem) ? "http://localhost/Aniel.Connect/Arquivos/Bot/Default.jpg" : Model.Imagem, Model.Nome, "100", "120")
                                        <input class="m-3" id="iImagemInput" type="file" name="Files[0]" sdata-index=0 />
                                    </div>
                                    <div class="col">
                                        <div class="row">
                                            <div class="form-group col-sm-12">
                                                <label for="iNome" class="mr-3">@RsCadastros.NOME_CANAL:</label><br>
                                                @Html.TextBoxFor(m => m.Nome, new { @class = "form-control", id = "iNome" })
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="form-group col-sm-12">
                                                <label for="iDescCanal" class="mr-3">@RsCadastros.DESCRICAO_CANAL:</label><br>
                                                @Html.TextBoxFor(m => m.Descricao, new { @class = "form-control", id = "iDescCanal" })
                                            </div>
                                        </div>
                                    </div>

                                </div>





                                <div class="row mt-2">
                                    <div class="form-group ">
                                        <label for="iEmail" class="mr-3">@RsCadastros.EMAIL:</label><br>
                                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", id = "iEmail" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group ">
                                        <label for="iSite" class="mr-3">@RsCadastros.SITE:</label><br>
                                        @Html.TextBoxFor(m => m.Site, new { @class = "form-control", id = "iSite" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group ">
                                        <label for="iNumero" class="mr-3">@RsCadastros.NUMERO:</label><br>
                                        @Html.TextBoxFor(m => m.Numero, new { @class = "form-control", id = "iNumero" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group ">
                                        <label for="iBot" class="mr-3">@RsCadastros.BOT_VINCULADO:</label><br>
                                        @Html.DropDownListFor(m => m.IdBot, new List<SelectListItem>(), RsBase.SELECIONE, new { @class = "form-control", id = "iBot" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group ">
                                        <label for="iTwillioAccountId" class="mr-3">@RsCadastros.TWILLIO_ACCOUNT_ID:</label><br>
                                        @Html.TextBoxFor(m => m.TwillioAccountId, new { @class = "form-control", id = "iTwillioAccountId" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group ">
                                        <label for="iTwilioAuthToken" class="mr-3">@RsCadastros.TWILLIO_AUTH_TOKEN:</label><br>
                                        @Html.TextBoxFor(m => m.TwilioAuthToken, new { @class = "form-control", id = "iTwilioAuthToken" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group ">
                                        <label for="iTokenTelegram" class="mr-3">@RsCadastros.TOKEN_TELEGRAM:</label><br>
                                        @Html.TextBoxFor(m => m.TokenTelegram, new { @class = "form-control", id = "iTokenTelegram" })
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!--Button Float-->
                <a href="@Url.Action("Index", "Canal_Comunicacao")" class="float-cancel" onclick="ShowPageLoading(); return true;">
                    <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                        <i class="fas fa-times fa-2x"></i>
                    </div>
                </a>

                <a href="#" onclick="ValidaSubmit();" class="float-save" id="btnGravar">
                    <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                        <i class="fas fa-save fa-2x"></i>
                    </div>
                </a>
            </div>
        </div>
    </div>
}
