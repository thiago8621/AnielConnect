        $("#btnAdicionarFluxo").off("click").on("click", async function () {
            try {
                // Dados do formulário (exemplo — ajuste os IDs conforme seu modal)
                let erro = false
                   if (!$("#iNome").val()) {
                     Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.NOME_CANAL)", "warning");
                    erro = true;
                    return;
                }

