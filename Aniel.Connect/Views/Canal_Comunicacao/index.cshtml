                    if (!$("#iNumero").val()) {
                         Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.NUMERO)", "warning");
                        erro = true;
                        return;
                    }

                    if (!$("#iTokenWhatsApp").val()) {
                         Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TOKEN_WHATSAPP_BUS)", "warning");
                        erro = true;
                        return;
                    }

                    if (!$("#iNumeroIdWhatsApp").val()) {
                         Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.NUMERO_ID_WHATSAPP_BUSINESS)", "warning");
                         erro = true;
                        return;
                    }

                    if (!$("#iNumeroIdWhatsApp").val()) {
                         Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ID_WHATSAPP_BUSINESS)", "warning");
                         erro = true;
                        return;
                    }
                }

                if ($("#iTipoCanal").val() == 1) {
                    if (!$("#iTokenTelegram").val()) {
                         Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TOKEN_TELEGRAM)", "warning");
                         erro = true;
                        return;
                    }
                }

                if ($("#iTipoCanal").val() == 2) {
                    if (!$("#iTokenMessenger").val()) {
                         Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TOKEN_MESSENGER)", "warning");
                        erro = true;
                        return;
                    }
                }

                if ($("#iTipoCanal").val() == 2) {
                    if (!$("#iTokenMessenger").val()) {
                         Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TOKEN_MESSENGER)", "warning");
                         erro = true;
                    }
                }

                if ($("#iTipoCanal").val() == 3) {
                    if (!$("#iTokenInstagram").val()) {
                         Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TOKEN_INSTAGRAM)", "warning");
                        erro = true;
                        return;
                    }
                }
                if (erro) { return; }
                const formData = {
                    Id: 0,
                    Nome: $("#iNome").val(),
                    Descricao: $("#iDescCanal").val(),
                    Email: $("#iEmail").val(),
                    Site: $("#iSite").val(),
                    IdBot: $("#iBot option:selected").val(),
                    Numero: $("#iNumero").val(),
                    TokenWhatsAppBusiness: $("#iTokenWhatsApp").val(),
                    IdNumeroWhatsAppBusiness: $("#iNumeroIdWhatsApp").val(),
                    WhatsAppBusinessAccount: $("#iIdWhatsApp").val(),
                    ModeloPadraoWhatsApp: $("#iModeloPadrao option:selected").val(),
                    TokenTelegram: $("#iTokenTelegram").val(),
                    TokenMessenger: $("#iTokenMessenger").val(),
                    TokenInstagram: $("#iTokenInstagram").val(),
                    TokenSkype: $("#iTokenSkype").val(),
                    Image: $("#iImagemInput").val(),
                    TipoCanalComunicacao: $("#iTipoCanal").val()

                };

                // Objeto no formato esperado pela API
                const payload = {
                    Usuario: "admin", // ou pegue dinamicamente via variável global
                    Objeto: formData
                };

                // Envio à API
                const response = await $.ajax({
                    url: baseUrl + "/api/Canal_ComunicacaoApi/Gravar",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    success: function (response) {
                        console.log("Sucesso:", response);
                    },
                    error: function (xhr, status, error) {
                        console.error("Erro:", error);
                    }
                });

                if ($('#iImagemInput').val()) {
                    let obj = $('#iImagemInput')[0];

                    if (obj.files.length > 0) {

                        let fileid = response.idObjeto;
                        var data = new FormData();
                        data.append("UploadedImage", obj.files[0]);
                        data.append("id", fileid);
                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Canal_ComunicacaoApi/AdicionarArquivo")' + "?Id=" + response.idObjeto;

                        let resultUploadArquivo = await $.ajax({
                            url: link,
                            type: 'POST',
                            contentType: false,
                            processData: false,
                            data: data
                        });

                        if (!resultUploadArquivo.ok) {
                            Notificar("@RsBase.ATENCAO_", resultUploadArquivo.mensagem, "warning");
                            return false;
                        }
                    }
                }

                    // Fecha o modal
                    $("#modal-filter").modal("hide");

                    // Recarrega a página após 1 segundo
                    setTimeout(() => location.reload(), 1000);

                if (erro == false) {
                    Notificar("@RsBase.INFORMACAO", "@RsCadastros.CANAL_ADICIONADO", "info");
                }

                if (erro) {
                    return false;
                }

            } catch (error) {
                console.error("Erro ao gravar canal:", error);
                Notificar("Erro", "Falha ao salvar canal.", "danger");
            }
        });


