@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        /* Define o tamanho e a borda do quadrado da imagem */
        /* Define o tamanho fixo e aparência da imagem */
        .border img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 6px;
        }

        /* Remove margens duplicadas e centraliza verticalmente */
        .d-flex.align-items-center {
            gap: 15px; /* espaço entre a imagem e o botão */
        }

        /* Estilo mais limpo para o container da imagem */
        border {
            border: 2px solid #000; /* borda preta */
            padding: 4px;
            border-radius: 6px;
            background-color: #fff; /* fundo branco pra destacar a imagem */
            display: flex;
            align-items: center;
            justify-content: center;
        }
        /* Ajuste do input file para não ocupar toda a largura */
        .form-control-file {
            width: auto;
        }
        #nomeArquivo {
            display: block;
            font-size: 0.9rem;
        }

    </style>
}


<script>


    var clicked = false;
    function ValidaSubmit() {
        if (clicked) {
            return false;
        }

        clicked = true;

        var erro = false;

        if (erro) {
            clicked = false;
            return false;
        }
        ShowPageLoading();
        $('#form').submit();

    }

</script>

