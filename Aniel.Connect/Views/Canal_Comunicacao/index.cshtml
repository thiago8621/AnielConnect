                 $('#iTipoCanalEditar').val(data_row.idTipoCanalComunicacao).change();
                 $('#iNomeEditar').val(data_row.nome);

                 if (data_row.statusNumero === 'Ativo' || data_row.statusNumero === true) {
                     $('#iStatus').prop('checked', true).change();
                 } else {
                     $('#iStatus').prop('checked', false).change();
                 }

                 $('#iDescCanalEditar').val(data_row.descricao);
                 $('#iEmailEditar').val(data_row.email);
                 $('#iSiteEditar').val(data_row.site);
                 $('#iNumeroEditar').val(data_row.numero);
