   }

    function AlterarStatusObj(Status)
    {

      var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Canal_ComunicacaoApi/alterarstatus")';
      $("body").addClass("loading");
      $.ajax({
          url: link,
          type: 'POST',
          contentType: 'application/json; charset=utf-8',
          dataType: 'json',
          data: JSON.stringify({
              ids: rows_selected,
              status: Status
          })
      })
          .done(function (data) {
              if (data.ok) {
                  Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");

                  // aguarda 1,5 segundos para o usuário ver a notificação e recarrega
                  setTimeout(function () {
                      location.reload();
                  }, 1500);
              } else {
                  Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
              }
          })
          .fail(function (xhr, status, error) {
              Notificar("@RsBase.ERRO", "Erro ao alterar status: " + (xhr.responseText || error), "error");
          })
          .always(function () {
              $("body").removeClass("loading");
              rows_selected = [];
          });
    }

     $("#btnAdicionarEditar").off("click").on("click", async function () {
    try {
        let erro = false;

        // === VALIDAÇÕES ===
        if (!$("#iNomeEditar").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.NOME_CANAL)", "warning");
            erro = true;
        }

        if ($("#iTipoCanalEditar").val() == 0) {
            if (!$("#iNumeroEditar").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.NUMERO)", "warning");
                erro = true;
            }

            if (!$("#iTokenWhatsAppEditar").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TOKEN_WHATSAPP_BUS)", "warning");
                erro = true;
            }

            if (!$("#iNumeroIdWhatsAppEditar").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ID_WHATSAPP_BUSINESS)", "warning");
                erro = true;
            }
        }

        if ($("#iTipoCanalEditar").val() == 1 && !$("#iTokenTelegramEditar").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TOKEN_TELEGRAM)", "warning");
            erro = true;
        }

        if ($("#iTipoCanalEditar").val() == 2 && !$("#iTokenMessengerEditar").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TOKEN_MESSENGER)", "warning");
            erro = true;
        }

        if ($("#iTipoCanalEditar").val() == 3 && !$("#iTokenInstagramEditar").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TOKEN_INSTAGRAM)", "warning");
            erro = true;
        }

        if (erro) return false;

        // === MONTA O OBJETO ===
        const formData = {
            Id: idat,
            Nome: $("#iNomeEditar").val(),
            Descricao: $("#iDescCanalEditar").val(),
            Email: $("#iEmailEditar").val(),
            Site: $("#iSiteEditar").val(),
            IdBot: $("#iBotEditar option:selected").val(),
            Numero: $("#iNumeroEditar").val(),
            TokenWhatsAppBusiness: $("#iTokenWhatsAppEditar").val(),
            IdNumeroWhatsAppBusiness: $("#iNumeroIdWhatsAppEditar").val(),
            WhatsAppBusinessAccount: $("#iIdWhatsAppEditar").val(),
            ModeloPadraoWhatsApp: $("#iModeloPadraoEditar option:selected").val(),
            TokenTelegram: $("#iTokenTelegramEditar").val(),
            TokenMessenger: $("#iTokenMessengerEditar").val(),
            TokenInstagram: $("#iTokenInstagramEditar").val(),
            TokenSkype: $("#iTokenSkypeEditar").val(),
            Image: $("#iImagemInputEditar").val(),
            TipoCanalComunicacao: $("#iTipoCanalEditar").val(),
            Status: $("#iStatus").is(":checked"),

        };

        const payload = {
            Usuario: "admin",
            Objeto: formData
        };

        // === CHAMA A API ===
        const response = await fetch(baseUrl + "/api/Canal_ComunicacaoApi/Gravar", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });

        if ($('#iImagemInputEdt').val()) {
            let obj = $('#iImagemInputEdt')[0];

            if (obj.files.length > 0) {

                let fileid = idat;
                var data = new FormData();
                data.append("UploadedImage", obj.files[0]);
                data.append("id", fileid);
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Canal_ComunicacaoApi/AdicionarArquivo")' + "?Id=" + idat;

                let resultUploadArquivo = await $.ajax({
                    url: link,
                    type: 'POST',
                    contentType: false,
                    processData: false,
                    data: data
                });

                if (!resultUploadArquivo.ok) {
                    Notificar("@RsBase.ATENCAO_", resultUploadArquivo.mensagem, "warning");
                    return false;
                }
            }
        }

        $("#modal-filter").modal("hide");

        // Atualiza página após 1,5s
        setTimeout(() => {
            location.reload();
        }, 1500);

        if (erro == false) {
        Notificar("@RsBase.INFORMACAO", "@RsCadastros.CANAL_ALTERADO", "info");
        }

        if (erro) {
            return false;
        }

    } catch (error) {
        console.error("Erro ao gravar canal:", error);
        Notificar("Erro", "Falha ao salvar canal.", "danger");
    }
});


    function mostrarCamposPorTipo(tipo) {
        $('#divWhatsApp, #divMessenger, #divTelegram, #divInstagram, #divSkype').hide();

        switch (tipo) {
            case 'WhatsApp':
                $('#divWhatsApp').show();
                break;
            case 'Messenger':
                $('#divMessenger').show();
                break;
            case 'Telegram':
                $('#divTelegram').show();
                break;
            case 'Instagram':
                $('#divInstagram').show();
                break;
            case 'Skype':
                $('#divSkype').show();
                break;
        }
        }

        $('#modal-editar').on('shown.bs.modal', function () {
            // Destroi o toggle atual (caso já tenha sido inicializado)
            if ($('#iStatus').data('bs.toggle')) {
                $('#iStatus').bootstrapToggle('destroy');
            }

            // Recria o toggle corretamente
            $('#iStatus').bootstrapToggle({
                on: 'Ativo',
                off: 'Inativo',
                onstyle: 'success',
                offstyle: 'light',
                width: 90,
                height: 35
            });
        });


</script>
