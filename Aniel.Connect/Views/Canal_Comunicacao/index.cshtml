   })
       .done(function (data) {
           if (data && data.ok) {
           } else {
               Notificar("@RsBase.ATENCAO_", "Ocorreu um erro ao obter o status do modelo.", "warning");
           }
       })
       .fail(function (jqXHR, textStatus, errorThrown) {
