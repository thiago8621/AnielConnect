@model  List<Aniel.Connect.Models.Faturamento_Modal_Detalhes>
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Aniel.Connect

@{
    ViewBag.Title = "Detalhes Faturamento";

    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{

    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")

}

@section  scripts
{

    @Scripts.RenderFormat(Aniel.Connect.SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

        ///<reference path="../../../Aniel.Connect.Core/Scripts/connect.js" />

        var array = @Html.Raw(Json.Encode(Model));

        $("#datatable").DataTable({
            dom: "",
            language: traducaoDataTableSimples,
            data: array,
            paging: false,
            columns: [
                {
                    data: "Descricao",
                    title: "@RsFinanceiro.DESCRICAO",
                    orderable: false
                },
                {
                    data: "NumeroContrato",
                    title: "@RsCadastros.NUMERO_CONTRATO",
                    orderable: false,
                    render: function (data) {
                        if (data === null || data === "" || data === undefined)
                            return "-";
                        else
                            return data;
                    },
                },
                {
                    data: "PeriodoMedicao",
                    title: "Período Medição:"
                },
                {
                    data: "QuantidadeDiasFaturar",
                    title: "Qtd Dias a Faturar: ",
                    orderable: false
                },
                {
                    data: "Recorrencia",
                    title: "Recorrencia "
                },
                {
                    data: "Valor",
                    title: "Valor",
                    orderable: false
                }

            ]
        });

    </script>
}


<div style="padding:10px;">

    <div class="card-body" style="padding-top: 0">

        <div class="row" style="padding-top:10px;">

            <div class="col" style="margin-top: -10px">

                <span style="font-size:11px" id="dtLegend"></span>

            </div>

            <div class="row pr-4">

            </div>

        </div>
        <div class="form-group text-right">
            @*<div> Desconto por antecipação: @ViewBag.DescontoAntecipacao</div>*@
            <div> Descontos: @ViewBag.Descontos </div>
            <div> Instalação: @ViewBag.InstalacaoTotal </div>
            <div> Negociações: @ViewBag.ValorNegociacao </div>
            <div> Multa: @ViewBag.ValorMulta </div>
        </div>

        <table class="table table-hover nowrap" id="datatable" style="width:100%">
            <thead class="tb-head">

            </thead>
        </table>

    </div>

</div>

