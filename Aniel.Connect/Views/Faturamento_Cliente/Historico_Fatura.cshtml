}

@section scripts{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Scripts/download.js"></script>
    <script>
        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/clienteapi/GetAllFaturasAberto")';

        var oDatatable = null;
        var oDatatableArquivos = null;
        var rows_selected = [];

        $('#btnImprimir').on("click", function () {
            let tipoImprimir = $("input[name='tipoImprimir']:checked").val();

            if (tipoImprimir == "carne")
                DownloadPdf(true)
            else
                DownloadPdf(false)

        })

        async function DownloadPdf(carne) {
            if (rows_selected.length < 1) {
                Notificar("@RsBase.ATENCAO_", 'Nenhum registro selecionado.', "warning");

                return;
            }

            if (!carne) {
                for (let item of rows_selected) {
                    var link = "@String.Concat(@CONSTANTES.URLFinanceiro + "/api/Faturamentoapi/DownloadFaturasFaturamentoPdf")";
                    var urlFatura = "@String.Concat(@CONSTANTES.URLFinanceiro + "/pt-BR/Faturamento/FaturaExportar?Ids_Faturamento_Cliente=")" + item;
                    var faturas = null;

                    var obj = {
                        url: urlFatura,
                        idFaturamento: item,

                    }

                    ShowPageLoading();

                    await $.ajax({
                        url: link,
                        type: 'POST',
                        data: obj
                    })
                        .done(function (data) {
                            faturas = data;

                            var filename = "fatura.pdf"
                            var aTag = document.createElement('a');
                            aTag.setAttribute('download', 'fatura.pdf');
                            aTag.setAttribute('href', '@Url.Action("Download","File")' + "?Path=" + faturas + `&FileName=${filename}` + `&ispdf=s`);
                            aTag.click();

                            HidePageLoading();

                        }).fail(function () {
                            Notificar("@RsBase.ATENCAO_", "Ocorreu um erro durante a emissão da fatura", "warning");
                            HidePageLoading();
                        });
                }
            }
            else
            {
                var link = "@String.Concat(@CONSTANTES.URLFinanceiro + "/api/Faturamentoapi/GetPdfBoletos")";


                var obj = {
                    Ids_boleto_faturamento: rows_selected,
                    FormatoCarne: true
                }

                ShowPageLoading();

                await $.ajax({
                    url: link,
                    type: 'POST',
                    data: obj
                })
                    .done(function (retorno) {
                        if (!retorno.ok) {
                            Notificar("@RsBase.ATENCAO_", retorno.mensagem, "warning")
                        }

                        let data = retorno.objeto;

                        faturas = data[0];
                        var filename = "carne.pdf"
                        var aTag = document.createElement('a');
                        aTag.setAttribute('download', 'carne.pdf');
                        aTag.setAttribute('href', '@Url.Action("Download","File")' + "?Path=" + faturas + `&FileName=${filename}` + `&ispdf=s`);
                        aTag.click();

                        HidePageLoading();

                    }).fail(function () {
                        Notificar("@RsBase.ATENCAO_", "Ocorreu um erro durante a emissão da fatura", "warning");
                        HidePageLoading();
                    });
            }
        }

        function switchTabInIframe() {
            if (oDatatable != null) {
                TableManageButtons.init();
            }
        };

        function formatarData(data) {
            return data.split("/");;
        }

        function MostrarDetalhes(Id_Faturamento_Cliente) {
            var url = '@Url.Action("ModalDetalhesFaturamento", "Faturamento_Cliente")' + '?Id_Faturamento_Cliente=' + Id_Faturamento_Cliente;
            ShowDialog(true, true, 'Detalhes Faturamento', url, 'divLog', 900, 600, 'iframeLog');
        }

        function VisualisarLog(Id_Protocolo, IdFaturamentoCliente, Id_Cliente) {

            var url = '@Url.Action("VisualizarLog", "Faturamento_Cliente")' + '?Id_Protocolo=' + Id_Protocolo;

            if (Id_Cliente)
                url = url + '&Id_Cliente=' + Id_Cliente;
            if (IdFaturamentoCliente)
                url = url + '&IdFaturamentoCliente=' + IdFaturamentoCliente;

            ShowDialog(true, true, 'Visualização do Log', url, 'divLog', 900, 600, 'iframeLog');
        }

        function FiltrarDataTable() {

            var date1 = new Date(parseInt($("#iDtInicialFiltro").val().substring(6, 10)), parseInt($("#iDtInicialFiltro").val().substring(3, 5)) - 1, parseInt($("#iDtInicialFiltro").val().substring(0, 2)));
            var date2 = new Date(parseInt($("#iDtFinalFiltro").val().substring(6, 10)), parseInt($("#iDtFinalFiltro").val().substring(3, 5)) - 1, parseInt($("#iDtFinalFiltro").val().substring(0, 2)));

            const diffTime = Math.abs(date2 - date1);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays > 366) {
                Notificar("@RsBase.ATENCAO_", "O período filtrado é maior que 12 meses", "warning");
                return false;
            }

            if ($("#iDtInicialFiltro").val() == "" || $("#iDtFinalFiltro").val() == "") {
                Notificar("@RsBase.ATENCAO_", "Período Inválido", "warning");
                return false;
            }

            var sDateStart = formatarData($("#iDtInicialFiltro").val());
            var sDateEnd = formatarData($("#iDtFinalFiltro").val());

            var dateStart = new Date(sDateStart[2], sDateStart[1], sDateStart[0]);
            var dateEnd = new Date(sDateEnd[2], sDateEnd[1], sDateEnd[0]);

            if (dateStart > dateEnd) {
                Notificar("@RsBase.ATENCAO_", "Data Inicial, é MAIOR que Data Final!", "warning");
                return false;
            }

            oDatatable.draw();
            return true;
        }


