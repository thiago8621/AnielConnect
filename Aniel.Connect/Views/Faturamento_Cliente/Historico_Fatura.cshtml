        $(document).ready(function () {
            AddSelect("iContrato", "@CONSTANTES.URLPortal/api/clienteapi/GetComboContratoCliente", @CONSTANTES.PaginacaoRegistros, null, @Model.Id_Cliente, null, "@RsBase.SELECIONE", false, null, null, null, null, false);
            AddSelect("iEndereco", "@CONSTANTES.URLPortal/api/clienteapi/GetComboEnderecosCliente", @CONSTANTES.PaginacaoRegistros, null, @Model.Id_Cliente, null, "@RsBase.SELECIONE", false, null, null, null, null, false);
        });

    </script>

