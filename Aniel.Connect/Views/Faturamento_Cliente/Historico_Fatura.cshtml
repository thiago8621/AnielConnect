                    Notificar("ATENÇÃO!", "Fatura seleciona não possui NF atreladas!", "warning")
                    return false;
                }

                downloads.forEach((item) => {
                    var aTag = document.createElement('a');
                    aTag.setAttribute('target', '_blank');
