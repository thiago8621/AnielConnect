@model IEnumerable<Aniel.Connect.Models.Faturamento_Log>
@using Aniel.Connect.Core.Helpers

@{
    ViewBag.Title = "AlterarEndereco";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
}

@section scripts {

    @Scripts.RenderFormat(Aniel.Connect.SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

        var array = @Html.Raw(Json.Encode(Model));

        $("#datatable").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: array,
            paging: false,
            scrollY: '80vh',
            columns: [
                        {
                            data: "Usuario",
                            title: "@RsCadastros.USUARIO"
                        },
                        {
                            data: "DataHoraCriacao",
                            title: "@RsCadastros.DATAHORA",
                        },
                        {
                            data: "NomeFantasia",
                            title: "@RsCadastros.NOME",
                        },
                        {
                            data: "Observacao",
                            title: "@RsCadastros.LOG",
                        },

                    ]
        });

        function addTabs(obj) {
            parent.parent.addTabs(obj);
        }


    </script>
}

<table class="table table-hove nowrapr" id="datatable" style="width:100%"></table>