@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

    <script>
    $('#modal-filter').on('show.bs.modal', function (event) {

        $(this).find('input:text').val('');
        $(this).find('input:checkbox').bootstrapToggle('off');
        $(this).find('select').val('').trigger('change');
        $("#datatableCodigoEncerramento").DataTable().clear().draw();

    })
    /**
     *
     * @@param value
     * @@param index num_sequencia
     * @@param self array_Objeto?
     */
    const onlyUnique = (value, index, self) => {
        let array = [];

        self = self.find(p => { return p.status === true });
        array.push(self.sequencia);

        return array;
    }

    function preencheSelecaoProximaEtapa(idCampo, valor = null) {
        const tableData = oDatatableFluxo.data().toArray();

        // Filtra os registros com status ativo e não deixa trazer sequências repetidas
        let arrSequencia = tableData.filter((data, idx, arr) => data.StatusFluxoAtendimento && (arr.findIndex(p => p.Sequencia == data.Sequencia) == idx));

        if (valor != null)
            $('#' + idCampo).val(valor);

        $("#" + idCampo).select2({
            data: arrSequencia.map(p =>
                ({
                    id: p.Sequencia,
                    text: p.Sequencia
                })
            )
        })

        if (valor != null)
            $('#' + idCampo).val(valor).trigger("change");
    }

    $(".hora99").focusout(function () {

        if ($(this).val().length < 6) {
            $(this).val('')
        }
    })

    $("#btnAdicionarFluxoEditar").on('click', function () {
            let erro = false;
            if ($("#iEtapa_DecisoriaEditar").is(":checked") == false) {
                let proximaSequencia = $("#iProxima_EtapaEditar").val();
                if (oDatatableFluxo.data().toArray().map(p => p.Sequencia).filter(p => p == proximaSequencia).length > 1) {
                    Notificar("@RsBase.ATENCAO_", "Sequencia escolhida possui duas etapas, seria necessario marcar Etapa Decisoria com Sim", "warning");
                    erro = true;
                }
            }

        if ($('#iAlterarSetorResponsavelEditar').is(':checked') == true) {
                if (!$("#iSetorEditar").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.SETOR_DEPARTAMENTO)", "warning");
                    erro = true;
                }
            }

            if ($("#iEncerra_AtendimentoEditar").is(":checked") == true) {
                if (!$("#iStatusAtendimentoEditar").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.STATUS_ATEDIMENTO)", "warning");
                    erro = true;
                }
                if (!$("#iStatusMotivosEditar").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MOTIVOS_STATUS_ATENDIMENTO)", "warning");
                    erro = true;
                }
        } else {
            if (!$("#iTempo_ExcEditar").val()) {
                Notificar("@RsBase.ATENCAO_", "Informe Tempo de Exec.(Em Horas)", "warning");
                erro = true;
            }
        }

            if (!$("#iDescricaoEditar").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DESCRICAO)", "warning");
                erro = true;
            }

            if (!$("#iCategoriaAtendimento").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CATEGORIA_ATENDIMENTO)", "warning");
                erro = true;
            }


            if (!$("#iSequenciaEditar").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.SEQUENCIA)", "warning");
                erro = true;
            }

            if (erro == false) {
                Notificar("@RsBase.INFORMACAO", "@RsCadastros.ETAPA_ALTERADA", "info");
            }

            if (erro)
                return false;

            let indice = $("#iCodigoEditar").val();
            let dados = oDatatableFluxo.row(indice).data();
            dados.Sequencia = $("#iSequenciaEditar").val()
            dados.Descricao = $("#iDescricaoEditar").val()
            dados.Setor = $("#iSetorEditar").val()
            dados.Setor_Desc = $("#iSetorEditar option:selected").text();
            dados.Tempo_Exc = $("#iTempo_ExcEditar").val();
            dados.Etapa_Decisoria = $("#iEtapa_DecisoriaEditar").val();
            dados.Encerra_Atendimento_Desc = $("#iEncerra_AtendimentoEditar").is(":checked") ? "@RsCadastros.SIM" : "@RsCadastros.NAO";
            dados.Etapa_Decisoria_Desc = $("#iEtapa_DecisoriaEditar").is(":checked") ? "@RsCadastros.SIM" : "@RsCadastros.NAO";
            dados.StatusFluxoAtendimento = $("#iStatusEditar").is(":checked");
            dados.Status_Desc = $("#iStatusEditar").is(":checked") ? "@RsCadastros.ATIVO" : "@RsCadastros.INATIVO";
            dados.Encerra_Atendimento = $("#iEncerra_AtendimentoEditar").is(":checked");
            dados.Etapa_Decisoria = $("#iEtapa_DecisoriaEditar").is(":checked");
            dados.Proxima_Etapa = $("#iProxima_EtapaEditar").val();
            dados.Contrato = $("#Editar").val();
            dados.Contrato_Desc = $("#iContratoEditar option:selected").text();
            dados.Cod_Encerramento = $("#iCod_EncerramentoEditar").val();
            dados.Cod_Encerramento_Desc = $("#iCod_EncerramentoEditar option:selected").text();
            dados.StatusAtendimento = $("#iStatusAtendimentoEditar").val();
            dados.StatusAtendimentoDesc = $("#iStatusAtendimentoEditar option:selected").text();
            dados.Motivo_Status_Atendimento = $("#iStatusMotivosEditar").val();
            dados.Motivo_Status_AtendimentoDesc = $("#iStatusMotivosEditar option:selected").text();
            dados.Encerramentos = oDatatableCodigoEncerramentoEditar.data().toArray();
            dados.AlterarSetor_Responsavel = $("#iAlterarSetorResponsavelEditar").is(":checked");
            dados.Desc_AlterarSetor_Responsavel = $("#iAlterarSetorResponsavelEditar").is(":checked") ? "Sim" : "Não";
            dados.Responsavel = $("#iResponsavelEditar").val();
            dados.Etapa_CriaOS = $("#iEtapa_CriaOSEditar").is(":checked");
            dados.Desc_Etapa_CriaOS = $("#iEtapa_CriaOSEditar").is(":checked") ? "Sim" : "Não";
            dados.Baixar_OS = $("#iBaixa_OSEditar").is(":checked");
            dados.Desc_Baixar_OS = $("#iBaixa_OSEditar").is(":checked") ? "Sim" : "Não";
            preencheSelecaoProximaEtapa("iProxima_Etapa");
            preencheSelecaoProximaEtapa("iProxima_EtapaEditar");
            oDatatableFluxo.row(indice).data(dados).draw(false);

        });

    $('#iSenhaIcon').on('mousedown touchstart', function (e) {
