    $("#iStatusAtendimentoEditar").on("change", function () {
        let valor = $("#iStatusAtendimentoEditar").val()
        if (valor) {
            AddSelect("iStatusMotivosEditar", "@CONSTANTES.URLPortal/api/motivo_status_atendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, valor, null, "@RsBase.SELECIONE", false);
        }
        else {
            AddSelect("iStatusMotivosEditar", "@CONSTANTES.URLPortal/api/motivo_status_atendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        }
    });

    $("#iContrato").on("change", function(){
        var codigoContrato = $("#iContrato option:selected").val();
        var codigoEncerramento = "@Model.Cod_Encerramento";

        AddSelect("iCod_Encerramento", "@CONSTANTES.URLPortal/api/CodigoEncerramentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, codigoContrato, codigoEncerramento, "@RsBase.SELECIONE", false);
    });


    $("#iMotivoStatusAtendimento").on("change", function () {
        AddSelect("iMotivoStatusAtendimento", "@CONSTANTES.URLPortal/api/Tipo_Atendimentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
    });

    $("#iTipoMotivoStatus").on("change", function () {
        AddSelect("iMotivoStatus", "@CONSTANTES.URLPortal/api/motivo_status_atendimentoApi/GetComboMotivoAlteracao", @CONSTANTES.PaginacaoRegistros, null, $("#iTipoMotivoStatus").val(), null, "@RsBase.SELECIONE", false);
    });

    $('a[data-toggle="tab"]').on('shown.bs.tab', () => {
        $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle('destroy');
        $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle();

        if ($("#datatableFluxo").is(":visible")) {
            $($.fn.dataTable.tables(true)).DataTable()
                .columns.adjust()
                .responsive.recalc()
        }
    });


        var Handle_CodCt_Change = function () {

            $("#iCodCt").change(function () {
                var codct = $("#iCodCt option:selected").val();
                if (codct) {
                AddSelect("iTipoServico","@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboDescricao", @CONSTANTES.PaginacaoRegistros, null, codct, null, "@RsBase.SELECIONE", false);
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, codct, null, "@RsBase.SELECIONE", false);
                } else {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboDescricao", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
                $("#iTipoServico").val(null).trigger('change');
            });
        };

    $(document).ready(async function () {

        $("#iVincularMotivoStatus").trigger("change");

        $("#iContrato").trigger("change");

        $("#iMotivoStatusAtendimento").trigger("change");

        $('#iExibirOla').trigger('change');

        // Construir Botão
        $('#iPossui_Etapa').trigger('change');

        $('#iTrava_Atendimento_OS').change();

        AddSelect("iCodCt", "@CONSTANTES.URLPortal/api/ContratoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.CodCt", "@RsBase.SELECIONE", false, Handle_CodCt_Change);

        AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboDescricao", @CONSTANTES.PaginacaoRegistros, null, "@Model.CodCt", "@Model.Desc_Tipo_Servico", "@RsBase.SELECIONE", false);

        AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, "@Model.CodCt", "@Model.Projeto", "@RsBase.SELECIONE", false);

        AddSelect("iCategoriaAtendimento", "@CONSTANTES.URLPortal/api/Categoria_AtendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Categoria_Atendimento", "@RsBase.SELECIONE", false);

        AddSelect("iScriptAtendimento", "@CONSTANTES.URLPortal/api/Script_AtendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Script", "@RsBase.SELECIONE", false);

        AddSelect("iSuporteTecnico", "@CONSTANTES.URLPortal/api/Script_SuporteTecnicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Script_SuporteTecnico", "@RsBase.SELECIONE", false);

        //AddSelect("iSetor", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null,null, "@RsBase.SELECIONE", false);

        AddSelect("iContrato", "@CONSTANTES.URLPortal/api/ContratoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        AddSelect("iStatusMotivos", "@CONSTANTES.URLPortal/api/motivo_status_atendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        AddSelect("iStatusMotivos", "@CONSTANTES.URLPortal/api/motivo_status_atendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);

        preencheSelecaoProximaEtapa("iProxima_Etapa");
        preencheSelecaoProximaEtapa("iProxima_EtapaEditar");

        $('#iEncerra_Atendimento').trigger('change');
        $('#iEncerra_AtendimentoEditar').trigger('change');
        $('#iUtilizar_Criacao_Dominio_Email_Atendimento').trigger('change');
        $('#iUtilizaCriacaoEmailAtendimento').trigger('change');
        $("#iTipoMotivoStatus").trigger('change');

    });

    var onready = false;

    $("#iAlterarSetorResponsavel").off("click").on("change", async function (e) {
        await handleAlterarSetorResponsavelChange();
    });

    $("#iVincularMotivoStatus").change(function () {
        if ($('#iVincularMotivoStatus').is(':checked')) {
            $("#MotivoAlteracao-tab").removeClass("disabled");
        }
        if (!$('#iVincularMotivoStatus').is(':checked')) {
            $("#MotivoAlteracao-tab").addClass("disabled");
        }
    });

    $("#iSetor").off("click").on("change", async function (e) {
        await handleSetorResponsavelChange();
    });

    $("#iAlterarSetorResponsavelEditar").off("click").on("change", async function (e) {
        await handleAlterarSetorResponsavelChange_EDITAR();
    });

    $("#iSetorEditar").off("click").on("change", async function (e) {
        var setor = e.target.value;
        await handleSetorResponsavelChange_EDITAR(null, setor, $("#iAlterarSetorResponsavelEditar").is(":checked"));
    });

    $("#iEncerrar_Atendimento_Junto_OS").off("change").on("change", async function (e) {
        e.preventDefault();
        e.stopPropagation();
        var checked = e.target.checked;
        await handleEncerrar_Atendimento_Junto_OS(checked);
    });

    $('#iEncerra_Atendimento').off("change").change(async function (e) {
        e.preventDefault();
        e.stopPropagation();
        await handleEncerra_Atendimento();
    });

    $('#iBaixa_OS').off("change").change(async function (e) {
        e.preventDefault();
        e.stopPropagation();
        await handleBaixa_OS();
    });

    /*******NOVO********/
    async function handleAlterarSetorResponsavelChange() {
        if ($(`#iAlterarSetorResponsavel`).is(":checked")) {
            $("#iDivSetorDepartamento").removeClass("d-none");
            $("#iDivResponsavel").removeClass("d-none");
        } else {
            $("#iDivSetorDepartamento").addClass("d-none");
            $("#iDivResponsavel").addClass("d-none");

            $(`#iResponsavel`).empty();
            $(`#iResponsavel`).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
            await AddSelect(`iSetor`, "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }
    }

    async function handleSetorResponsavelChange() {
        $(`#iResponsavel`).empty();
        $(`#iResponsavel`).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
        if ($(`#iSetor`).val() > 0 && $(`#iAlterarSetorResponsavel`).is(":checked")) {
            const resultado = await $.ajax({
                url: "@CONSTANTES.URLPortal/api/Identity_UserApi/GetComboUserId",
                type: 'POST',
                dataType: 'json',
                data: {
                    idpai: $(`#iSetor`).val(),
                    id: null,
                    q: null,
                    page: 1,
                    soativos: true,
                    id_usuario: null,
                    cod_area: null,
                    tipoMovimento: null
                },
                beforeSend: function () {
                    ShowPageLoading();
                },
                complete: function () {
                    HidePageLoading();
                }
            });

            if (resultado.total_count > 0) {
                $.each(resultado.results, function (key, value) {
                    $(`#iResponsavel`).append($('<option>', {
                        value: value.id,
                        text: value.text
                    }));
                });
            }
        }
    }
    /*******************/

    /*******EDITAR********/
    async function handleSetorResponsavelChange_EDITAR(responsavel, setor, alterarSetor_Responsavel) {
        $(`#iResponsavelEditar`).empty();
        $(`#iResponsavelEditar`).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
        if (setor > 0 && alterarSetor_Responsavel) {
            const resultado = await $.ajax({
                url: "@CONSTANTES.URLPortal/api/Identity_UserApi/GetComboUserId",
                type: 'POST',
                dataType: 'json',
                data: {
                    idpai: setor,
                    id: null,
                    q: null,
                    page: 1,
                    soativos: true,
                    id_usuario: null,
                    cod_area: null,
                    tipoMovimento: null
                },
                beforeSend: function () {
                    ShowPageLoading();
                },
                complete: function () {
                    HidePageLoading();
                }
            });
            if (resultado.total_count > 0) {
                $.each(resultado.results, function (key, value) {
                    $(`#iResponsavelEditar`).append($('<option>', {
                        value: value.id,
                        text: value.text,
                        selected: value.id == responsavel ? true : false
                    }));
                });
            }

        }
    }

    async function handleAlterarSetorResponsavelChange_EDITAR() {
        if ($(`#iAlterarSetorResponsavelEditar`).is(":checked")) {
            $("#iDivSetorDepartamento_Editar").removeClass("d-none");
            $("#iDivResponsavel_Editar").removeClass("d-none");
        } else {
            $("#iDivSetorDepartamento_Editar").addClass("d-none");
            $("#iDivResponsavel_Editar").addClass("d-none");

            $(`#iResponsavelEditar`).empty();
            $(`#iResponsavelEditar`).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
            await AddSelect(`iSetorEditar`, "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }
    }
    /*********************/

        //O botão "Encerrar Atendimento junto a Ordem de Serviço" deve habilitar somente se o botão "Travar Atendimento estiver SIM"
        $("#iTrava_Atendimento_OS").change(function () {

            if ($('#iTrava_Atendimento_OS').is(':checked')) {
                $('#divEncerrar').show()
                $('#iEncerrar_Atendimento_Junto_OS').attr('disabled', false).change();
            }
            if (!$('#iTrava_Atendimento_OS').is(':checked')) {
                $('#divEncerrar').hide()
                $('#iEncerrar_Atendimento_Junto_OS').prop('checked', false).change();
                $("#iEncerrar_Atendimento_Junto_OS").attr("disabled", true).change();
            }
        });

    async function handleEncerrar_Atendimento_Junto_OS(checked) {
            if (checked) {
                var lista_fluxo = oDatatableFluxo.data().toArray();
                if (lista_fluxo.length > 0) {
                    oDatatableFluxo.rows().every(function () {
                        let rowData = this.data();

                        if (rowData.Baixar_OS == true) {
                            rowData.Baixar_OS = false;
                            rowData.Desc_Baixar_OS = "Não";
                            this.data(rowData);
                        }
                    });

                    oDatatableFluxo.draw();
                }

                $("#iDivBaixarOSEditar").hide();
                $("#iBaixa_OSEditar").prop("checked", false);
                $("#iBaixa_OSEditar").bootstrapToggle('off');

                $("#iDivBaixarOS").hide();
                $("#iBaixa_OS").prop("checked", false);
                $("#iBaixa_OS").bootstrapToggle('off');
            }/* else {
                $('#iDivBaixarOS').show();
                $('#iDivBaixarOSEditar').show();
            }*/
        }

    async function handleEncerra_Atendimento() {
        if ($("#iEncerra_Atendimento").is(':checked')) {
            $('#divProxima_Etapa').hide()

            $('#divStatusAtendimento').show()
            $('#divStatusMotoivos').show()

            $("#iDivBaixarOS").hide();
            $("#iBaixa_OS").prop("checked", false);
            $("#iBaixa_OS").bootstrapToggle('off');
        }
        else {
            $('#divProxima_Etapa').show()

            $('#divStatusAtendimento').hide()
            $('#divStatusMotoivos').hide()

            if (!$("#iEncerrar_Atendimento_Junto_OS").is(":checked")) {
                $("#iDivBaixarOS").show();
        	}

            $("#iStatusAtendimento").val(null);
            AddSelect("iStatusMotivos", "@CONSTANTES.URLPortal/api/motivo_status_atendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        }
    }

    async function handleBaixa_OS() {
        if ($("#iBaixa_OS").is(':checked')) {
            $("#iDivBaixarOS").show();

            $("#iDivEncerrar").hide();
            $("#iEncerra_Atendimento").prop("checked", false);

            $("#iEncerra_Atendimento").bootstrapToggle('off');

            $("#iStatusAtendimento").val(null);
            AddSelect("iStatusMotivos", "@CONSTANTES.URLPortal/api/motivo_status_atendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        } else {
            $("#iDivEncerrar").show();
        }
    }

    //Botao Proximo do Modal Editar

    $('#iEncerra_AtendimentoEditar').change(function () {
        if ($("#iEncerra_AtendimentoEditar").is(':checked')) {
            $('#divProxima_EtapaEditar').hide()

            $('#divStatusAtendimentoEditar').show()
            $('#divStatusMotoivosEditar').show()

            $("#iDivBaixarOSEditar").hide();
            $("#iBaixa_OSEditar").prop("checked", false);
