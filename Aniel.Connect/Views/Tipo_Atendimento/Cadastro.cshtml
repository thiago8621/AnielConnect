    $("#iTempo_Exc, #iTempo_ExcEditar").on("blur", function () {
        let val = $(this).val().replace(/\D/g, ''); // remove não dígitos

        if (val.length === 0) return;

        // Mantém os primeiros 5 dígitos
        if (val.length > 5) val = val.slice(0, 5);

        // Preenche com zeros à esquerda
        val = val.padStart(5, '0');

        // Separa horas e minutos
        let horas = parseInt(val.slice(0, 3));
        let minutos = parseInt(val.slice(3));

        // Aplica limites
        if (horas > 999) horas = 999;
        if (minutos > 59) minutos = 59;

        // Formata com zeros
        let horasStr = horas.toString().padStart(3, '0');
        let minutosStr = minutos.toString().padStart(2, '0');

        // Atualiza o campo com valor formatado
        $(this).val(`${horasStr}:${minutosStr}`);
    });


