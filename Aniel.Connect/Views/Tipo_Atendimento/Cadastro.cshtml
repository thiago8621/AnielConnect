            arrayEncerramentosEditar = data_row.Encerramentos;

            let tempo = data_row.Tempo_Exc.replace(/\D/g, '').padStart(5, '0');
            let horas = tempo.slice(0, 3);
            let minutos = tempo.slice(3);
            let tempoFormatado = `${horas}:${minutos}`;

            $('#iTempo_ExcEditar')
                .addClass("hora99")
                .mask("000:00", { clearIfNotMatch: false })
                .val(tempoFormatado);

            AddSelect("iContratoEditar", "@CONSTANTES.URLPortal/api/ContratoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

            $("#iContratoEditar").on("change", function () {
                var codigoContratoEditar = $("#iContratoEditar option:selected").val();
                var codigoEncerramentoEditar = "@Model.Cod_Encerramento";

                AddSelect("iCod_EncerramentoEditar", "@CONSTANTES.URLPortal/api/CodigoEncerramentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, codigoContratoEditar, codigoEncerramentoEditar, "@RsBase.SELECIONE", false);
             });

            if (data_row.Etapa_CriaOS == true)
                $("#iEtapa_CriaOSEditar").bootstrapToggle('on');
            else
                $("#iEtapa_CriaOSEditar").bootstrapToggle('off');

            if (data_row.StatusFluxoAtendimento == true)
                $("#iStatusEditar").bootstrapToggle('on');
            else
                $("#iStatusEditar").bootstrapToggle('off');

            if (data_row.Etapa_Decisoria == true)
                $("#iEtapa_DecisoriaEditar").bootstrapToggle('on');
            else
                $("#iEtapa_DecisoriaEditar").bootstrapToggle('off');


            if (data_row.Baixar_OS == true) {
                $("#iBaixa_OSEditar").bootstrapToggle('on');
                $("#iDivBaixarOSEditar").show();

                $("#iEncerra_AtendimentoEditar").bootstrapToggle('off');

                $("#iDivEncerrarEditar").hide();
            } else {
                $("#iBaixa_OSEditar").bootstrapToggle('off');
                if ($("#iEncerrar_Atendimento_Junto_OS").is(":checked")) {
                    $("#iDivBaixarOSEditar").hide();
                } else {
                    if (data_row.Encerra_Atendimento == false) {
                        $("#iDivBaixarOSEditar").show();
                    }
                }

                if (data_row.Encerra_Atendimento == true) {
                $("#iEncerra_AtendimentoEditar").bootstrapToggle('on');
                    $("#iDivEncerrarEditar").removeClass("d-none");
                } else {
                $("#iEncerra_AtendimentoEditar").bootstrapToggle('off');
                }
            }

            preencheSelecaoProximaEtapa("iProxima_EtapaEditar", data_row.Proxima_Etapa);
            if (data_row.AlterarSetor_Responsavel == true) {
                $("#iAlterarSetorResponsavelEditar").bootstrapToggle('on');
                await AddSelect(`iSetorEditar`, "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, data_row.Setor, "@RsBase.SELECIONE", false);
                await handleAlterarSetorResponsavelChange_EDITAR(data_row.Setor);
                await handleSetorResponsavelChange_EDITAR(data_row.Responsavel, data_row.Setor, data_row.AlterarSetor_Responsavel);
            } else {
                $("#iAlterarSetorResponsavelEditar").bootstrapToggle('off');
            }

