    let oDatatableMotivo = null;

    function addLinha() {

        var tipoMotivo = $("#iTipoMotivoStatus").val();
        var motivo = $("#iMotivoStatus").val();

        if (!tipoMotivo || tipoMotivo === "") {

            Notificar("@RsBase.ATENCAO_", 'Informe o Tipo de Motivo de Status.', "warning");
            erro = true;
            return;
        }

        if (!motivo || motivo === "") {

            Notificar("@RsBase.ATENCAO_", 'Informe o Motivo.', "warning");
            erro = true;
            return;
        }

        var existe = false;
        oDatatableMotivo.rows().every(function () {
        var data = this.data();

            if (data.Status_Motivo == tipoMotivo &&
                data.Motivo_Status_Atendimento == motivo) {
                existe = true;
                return false;
            }
        });

        if (existe) {
            Notificar("@RsBase.ATENCAO_", 'Este motivo já foi adicionado.', "warning");
            return;
        }

        oDatatableMotivo.row.add({
            Id: 0,
            Status_Motivo: $("#iTipoMotivoStatus").val(),
            Status_Motivo_Desc: $("#iTipoMotivoStatus option:selected").text(),
            Motivo_Status_Atendimento_Desc: $("#iMotivoStatus option:selected").text(),
            Motivo_Status_Atendimento: $("#iMotivoStatus").val(),
        }).draw(false);
    }


