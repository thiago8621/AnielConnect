                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                        .fail(function () {

                        })
                        .always(function () {

                        });
                }

            });
        }

        handleExcluirMotivo();

    },
    TableManageButtonsMotivo = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtonsMotivo();
                }
            }
        }();
    TableManageButtonsMotivo.init();


    //********** VALIDA SUBMIT **********//
    var clicked = false;
    function ValidaSubmit()
    {
        if (clicked) {
            return false;
        }

        clicked = true;

        erro = false;

        if ($('#iExibirOla').is(':checked') && !$("#iSuporteTecnico option:selected").val())
        {
            Notificar("@RsBase.ATENCAO_", 'Informe um Script de Suporte Técnico', "warning");
            erro = true;
        }

        if ($('#iExibirOla').is(':checked') && !$("#iTipoServico option:selected").val())
        {
            Notificar("@RsBase.ATENCAO_", 'Informe um Tipo de Serviço', "warning");
            erro = true;
        }


        if (!$("#iCategoriaAtendimento").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CATEGORIA_ATENDIMENTO)", "warning");
            erro = true;
        }
        if ($('#iVincularMotivoStatus').is(':checked') && ($("#datatableMotivo").dataTable().fnSettings().fnRecordsTotal() == 0))
        {
            Notificar("@RsBase.ATENCAO_", 'Necessário adicionar motivo para alteração de Status Atendimento', "warning");
            erro = true;
        }

        const verifica_etapa_criar_os = oDatatableFluxo.data().toArray().filter(x => x.Etapa_CriaOS == true);
        if (verifica_etapa_criar_os.length > 0) {
            $("#iSpanContrato").addClass("d-none");
            $("#iSpanProjeto").addClass("d-none");
            $("#iSpanTipoServico").addClass("d-none");

            var flag_erro = false;
        if (!$("#iCategoriaAtendimento").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CATEGORIA_ATENDIMENTO)", "warning");
 	    }
        if (!$("#iCodCt").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CONTRATO)", "warning");
                $("#iSpanContrato").removeClass("d-none");
                flag_erro = true;
            }

            if (!$("#iProjeto").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PROJETO)", "warning");
                $("#iSpanProjeto").removeClass("d-none");
                flag_erro = true;
            }

            if (!$("#iTipoServico").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TIPO_SERVICO)", "warning");
                $("#iSpanTipoServico").removeClass("d-none");
                flag_erro = true;
            }

            if (flag_erro) {
                Notificar("@RsBase.ATENCAO_", "A configuração ETAPA CRIA OS está ativada em alguma(s) etapa(s). Para avançar, é obrigatório preencher os campos informados.", "warning");
            erro = true;
        }
        }

	    if (erro) {
            clicked = false;
            return false;
        }

        ShowPageLoading();
        $('#form').submit();
	    return true;
    }

    $("#iProxima_Etapa").on("change", async function (e) {
        var id = e.target.value;
        $(`#iIdFluxoEtapa`).empty();
        $(`#iIdFluxoEtapa`).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
        if (id != "") {
            var fluxo_atendimento = oDatatableFluxo.data().toArray().filter(x => x.Sequencia == id);
            if (fluxo_atendimento.length > 0) {
                $.each(fluxo_atendimento, function (key, value) {
                    $(`#iIdFluxoEtapa`).append($('<option>', {
                        value: value.Id,
                        text: value.Descricao
                    }));
                });
            }
        }
    });

    $("#iProxima_EtapaEditar").on("change", async function (e) {
        var id = e.target.value;
        $(`#iIdFluxoEtapaEditar`).empty();
        $(`#iIdFluxoEtapaEditar`).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
        if (id != "") {
            var fluxo_atendimento = oDatatableFluxo.data().toArray().filter(x => x.Sequencia == id);

            if (fluxo_atendimento.length > 0) {
                $.each(fluxo_atendimento, function (key, value) {
                    $(`#iIdFluxoEtapaEditar`).append($('<option>', {
                        value: value.Id,
                        text: value.Descricao
                    }));
                });
            }
        }
    });
    </script>

}


