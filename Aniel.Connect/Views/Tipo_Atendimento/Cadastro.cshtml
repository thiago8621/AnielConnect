@model Aniel.Connect.Models.Tipo_AtendimentoCadastroModel
@using Aniel.Connect.Models
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Microsoft.AspNet.Identity
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.CADASTRO_TIPO_ATENDIMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    IList<SelectListItem> listaStatusAtendimento = EnumHelper.GetSelectList(typeof(Status_Atendimento));


    List<AreaModuloModel> _areas = ViewBag.Areas;
}
@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")



    <style>
        .nonClickable {
            pointer-events: none
        }

        .custom-form-group {
            display: block;
            width: 100%;
            font-size: 12px;
        }

            .custom-form-group label {
                display: block;
