@model Aniel.Connect.Models.Script_AtendimentoCadastroModel

@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado

@{
    ViewBag.Title = RsCadastros.CADASTRO_SCRIPT_ATENDIMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    <style>
        .tagChips{
            background-color: lightblue;
        }
    </style>

}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion,"~/bundles/jsDataTableSimples")

    @if (Model.Id == 0)
    {
        <script>
            $("#iStatus").prop("checked", true).change();;
        </script>
    }

    <script>
        var handleDataTableButtons = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Perguntas));
            var qtderegistros = array.length;

            var nome_lista = "Perguntas";//Nome_utilizado para enganar o razor

            var tipos_resposta = @(Html.GetArrayEnum<Script_Tipo_Resposta>());

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                paging: false,
                columnDefs: [{
                    targets: 0,
                    searchable: false,
                    orderable: false,
                    width: '80px'
                }],
                columns: [
                    {
                        data: "Id",
                        orderable: false,
                        render: function (data, type, row, meta) {
                            var retorno = '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                          ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                            if (meta.row != 0) {
                                retorno = retorno + '<a href="#" class="btnUp" id="btnUp_' + meta.row + '" valor="' + row.Pergunta + '"><i class="fas fa-arrow-up" style="font-size:16px;;padding-right:2px;"></i></a>';
                            }

                            if (meta.row != qtderegistros - 1) {
                                retorno = retorno + '<a href="#" class="btnDown" id="btnDown_' + meta.row + '" valor="' + row.Pergunta + '"><i class="fas fa-arrow-down" style="font-size:16px;;padding-right:2px;"></i></a>';
                            }

                            return retorno;
                        }
                    },
                    {
                        data: "Ordem",
                        orderable: false,
                        title: "@RsCadastros.ORDEM",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + 'º <input id="' + nome_lista + '_' + meta.row + '__Ordem" name="' + nome_lista + '[' + meta.row + '].Ordem" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Pergunta",
                        orderable: false,
                        title: "@RsCadastros.PERGUNTA",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = TrataNulo(data) + ' <input id="' + nome_lista + '_' + meta.row + '__Pergunta" name="' + nome_lista + '[' + meta.row + '].Pergunta" type="hidden" value="' + TrataNulo(data) + '">';

                            }
                            return data;
                            AtualizarOrdem();
                        }
                    },
                    {
                        data: "Explicacao_Operador",
                        orderable: false,
                        title: "@RsCadastros.EXPLICACAO_OPERADOR",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = TrataNulo(data) + ' <input id="' + nome_lista + '_' + meta.row + '__Explicacao_Operador" name="' + nome_lista + '[' + meta.row + '].Explicacao_Operador" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                             AtualizarOrdem();
                        }                        
                    },
                    {
                        data: "Explicacao_Cliente",
                        orderable: false,
                        title: "@RsCadastros.EXPLICACAO_CLIENTE",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = TrataNulo(data) + ' <input id="' + nome_lista + '_' + meta.row + '__Explicacao_Cliente" name="' + nome_lista + '[' + meta.row + '].Explicacao_Cliente" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                             AtualizarOrdem();
                        }
                        
                    },
                    {
                        data: "Tipo_Resposta",
                        orderable: false,
                        title: "@RsCadastros.TIPO_RESPOSTA",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = tipos_resposta[data] + ' <input id="' + nome_lista + '_' + meta.row + '__Tipo_Resposta" name="' + nome_lista + '[' + meta.row + '].Tipo_Resposta" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                             AtualizarOrdem();
                        }
                    },
                    {
                        data: "Respostas_Possiveis",
                        orderable: false,
                        title: "@RsCadastros.RESPOSTAS_POSSIVEIS",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = TrataNulo(data) + ' <input id="' + nome_lista + '_' + meta.row + '__Respostas_Possiveis" name="' + nome_lista + '[' + meta.row + '].Respostas_Possiveis" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                             AtualizarOrdem();
                        }
                    }
                ]
            });

            function handleExcluir() {
                $(".btnExcluir").unbind('click');
                $(".btnExcluir").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatable.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Script_AtendimentoApi/ExcluirGrid?value=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatable.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                    qtderegistros -= 1;
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });

                $(".btnUp").unbind('click');
                $(".btnUp").click(function (e) {
                    e.preventDefault();

                    var trLinkButton = $(this).parents('tr');
                    moveRow(oDatatable, trLinkButton, 'up');

                    handleExcluir();

                    AtualizarOrdem();
                });

                $(".btnDown").unbind('click');
                $(".btnDown").click(function (e) {
                    e.preventDefault();

                    var trLinkButton = $(this).parents('tr');
                    moveRow(oDatatable, trLinkButton, 'down');

                    handleExcluir();

                    AtualizarOrdem();
                });
            }

            handleExcluir();

            $("#btnAdicionar").on('click', function () {

                var erro = false;
                
                if (!$("#iTipo_Resposta option:selected").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TIPO_RESPOSTA)", "warning");
                    erro = true;
                }
                if ((($("#iTipo_Resposta option:selected").val() == "3") || ($("#iTipo_Resposta option:selected").val() == "4")) &&
                    (!$("#iRespostas_Possiveis").val())){
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.RESPOSTAS_POSSIVEIS)", "warning");
                    erro = true;
                }

                if (!$('#iPergunta').val() && !$('#iExplicacao_Operador').val() && !$('#iExplicacao_Cliente').val())
                {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.INFORME_AOMENOSUM_SCRIPT_ATENDIMENTO)", "warning");
                    erro = true;
                }

                if (erro) {
                    return false;
                }

                qtderegistros += 1;

                oDatatable.row.add({
                    Id: 0,
                    Ordem: 0,
                    Pergunta: $("#iPergunta").val().replaceAll('"', "''"),
                    Explicacao_Cliente: $("#iExplicacao_Cliente").val().replaceAll('"', "''"),
                    Explicacao_Operador: $("#iExplicacao_Operador").val().replaceAll('"', "''"),
                    Tipo_Resposta: $("#iTipo_Resposta option:selected").val(),
                    Respostas_Possiveis: $('#iRespostas_Possiveis').tagsinput('items').join(";")
                }).draw(false);

                oDatatable.column(0).cells().invalidate().render();
                AtualizarOrdem();

                $("#iPergunta").val("");
                $("#iExplicacao_Cliente").val("");
                $("#iExplicacao_Operador").val("");
                $("#iTipo_Resposta").val("0").trigger("change");
                $('#iRespostas_Possiveis').tagsinput('removeAll');

                handleExcluir();
            });


        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

          function AtualizarOrdem() {
            $.each($('#datatable tr td:nth-child(2)'), function (index, val) {
                    var ordem = index + 1;
                    $(this).html(ordem + "º"+ '<input id="Perguntas_' + index + '__Ordem" name="Perguntas[' + index + '].Ordem" type="hidden" value="' + ordem + '">');
                });
        }

        $(document).ready(function () {

            if ($("#iStatus").parent().hasClass("toggle btn btn-light off")) {
                $("#iStatus").parent().toggleClass("toggle btn btn-light off toggle btn btn-success");
            }
            else if ($("#iStatus").parent().hasClass("toggle btn btn-light off")) {
            }

            $("#iTipo_Resposta").on("change", function () {

                if (($(this).val() == "3") || ($(this).val() == "4")) {
                    $("#divRespostas_Possiveis").show();
                    $('#txtrespostas').show();
                }
                else {
                    $("#iRespostas_Possiveis").tagsinput('removeAll');
                    $("#divRespostas_Possiveis").hide();
                    $('#txtrespostas').hide();
                }
            });

            // Respostas Possíveis old
            $('#iRespostas_Possiveis').tagsinput({
                tagClass: 'tagChips',
                confirmKeys: [13],
                delimiter: ';'
            });
        });

        var ultimaDivReposta = 0;

        $(document).on("click", ".addBotao",function () {

            if ($("#iRespostas_Possiveis").val() == "") {

                $("#iRespostas_Possiveis").val($(".inputRespostas" + ultimaDivReposta + "").val());
            }
            else {
                var oldVal = $("#iRespostas_Possiveis").val();
                $("#iRespostas_Possiveis").val(oldVal + "," + $(".inputRespostas" + ultimaDivReposta + "").val());
            }

            ultimaDivReposta++;

            var html = '<div class="input-group mt-2">' +
                           '<input type="text" class="form-control inputRespostas' + ultimaDivReposta + '" autocomplete="off" required="true">' +
                           '<div class="input-group-append">' +
                               '<i class="fas fa-plus addBotao" style="margin-left:50%; height:100%"></i>' +
                           '</div>' +
                       '</div>';

            $(".inputsRepostas").append(html);

        });

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;

            @*var erro = false;
            if (!$("#iTitulo").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TITULO)", "warning");
                erro = true;
            }
            if (iArquivo.files.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ARQUIVO)", "warning");
                erro = true;
            }
            if (erro) {
                return false;
            }*@
            ShowPageLoading();
            $('#form').submit();
        }



    </script>
}


@using (Html.BeginForm("Cadastro", "Script_Atendimento", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-code"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a></li>
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Script_Atendimento")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELSCRIPT_ATENDIMENTO</a></li>
                                <li class="breadcrumb-item"><span>@ViewBag.Title</span></li>
                            </ol>
                        </nav>
                        @*<span style="font-size:11px" id="dtLegend"></span>*@
                    </div>
                </div>

                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>

                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="row">
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label for="iNome">@RsCadastros.NOME:</label>
                                        @Html.DisplayFor(model => model.Nome)
                                        @Html.TextBoxFor(model => model.Nome, new { @class = "form-control", @id = "iNome", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Nome, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                @if (Model.Id != 0)
                                {
                                    <div class="col-sm-4">
                                        <div class="form-group">

                                            <label for="iStatus" class="mr-3">@RsCadastros.STATUS:</label>
                                            <div class="form-group">
                                                @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                            </div>

                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>


                <div class="row mt-2 mb-2">
                    <div id="accordion" class="col-sm-5">
                        <div class="card div-card-accord">
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <div class="form-group">
                                                <label for="iPergunta">@RsCadastros.PERGUNTA:</label>
                                                @Html.TextAreaFor(model => model.Pergunta, new { @class = "form-control", @id = "iPergunta", @autocomplete = "off", @required = true, @rows = "4" })
                                                @Html.ValidationMessageFor(model => model.Pergunta, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="col-sm-12">
                                            <div class="form-group">
                                                <label for="iExplicacao_Operador">@RsCadastros.EXPLICACAO_OPERADOR:</label>
                                                @Html.TextAreaFor(model => model.Explicacao_Operador, new { @class = "form-control", @id = "iExplicacao_Operador", @autocomplete = "off", @required = true, @rows = "4" })
                                                @Html.ValidationMessageFor(model => model.Explicacao_Operador, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="col-sm-12">
                                            <div class="form-group">
                                                <label for="iExplicacao_Cliente">@RsCadastros.EXPLICACAO_CLIENTE:</label>
                                                @Html.TextAreaFor(model => model.Explicacao_Cliente, new { @class = "form-control", @id = "iExplicacao_Cliente", @autocomplete = "off", @required = true, @rows = "4" })
                                                @Html.ValidationMessageFor(model => model.Explicacao_Cliente, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <br />

                                        <div class="col-sm-12">
                                            <div class="form-group">
                                                <label for="iTipo_Resposta">@RsCadastros.TIPO_RESPOSTA:</label>
                                                @Html.EnumDropDownListFor(m => m.Tipo_Resposta, RsBase.SELECIONE, new { @class = "form-control", @id = "iTipo_Resposta", @autocomplete = "off" })
                                                @Html.ValidationMessageFor(model => model.Tipo_Resposta, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-sm-12" id="divRespostas_Possiveis" style="display:none;">
                                            <div class="form-group">
                                                <label for="iExplicacao_Operador">@RsCadastros.RESPOSTAS_POSSIVEIS:</label>
                                                <div class="row">
                                                    <div class="col-12 inputsRepostas">

                                                        <div class="input-group">
                                                            @Html.HiddenFor(model => model.Respostas_Possiveis, new { @id = "iRespostas_Possiveis" })
                                                            <label id="txtrespostas"> <strong> @RsCadastros.TEXTO_RESPOSTAS_SCRIPT_ATENDIMENTO </strong> </label>
                                                            @Html.ValidationMessageFor(model => model.Respostas_Possiveis, "", new { @class = "text-danger" })

                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12 text-right mt-3">
                                            <input type="button" id="btnAdicionar" value="Adicionar" class="btn btn-success" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div id="accordion" class="col-sm-7">
                        <div class="card div-card-accord">
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body">
                                    <table class="table table-hover nowrap" id="datatable" style="width: 100%">
                                    </table>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Script_Atendimento")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>

    </div>

}