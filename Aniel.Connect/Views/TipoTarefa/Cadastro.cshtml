@model Aniel.Connect.Models.TipoTarefaCadastroModel

@{
    ViewBag.Title = "Tipo de Tarefa";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script>


        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;
            erro = false;

            if (!$("#iCodigo").val()) {
                Notificar("@RsBase.ATENCAO_", "Preencha os campos", "warning");
                clicked = false;
                return false;
            }

            if (!$("#iDescricao").val()) {
                Notificar("@RsBase.ATENCAO_", "Preencha os campos", "warning");
                clicked = false;
                return false;
            }

	        if (erro) {
                clicked = false;
                return false;
            }

            $("#form").submit()

        }

    </script>
}

@using (Html.BeginForm("Cadastro", "TipoTarefa", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-clipboard-list"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>Cadastro do Tipo de Tarefas</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>



                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iDescricao">@RsCadastros.CODIGO:</label>
                                        @Html.TextBoxFor(model => model.Id, new { @class = "form-control readonly", @id = "iCodigo", @autocomplete = "off", @required = true })
                                        @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iDescricao">@RsCadastros.DESCRICAO:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off", @required = true })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Configuracao")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="ValidaSubmit()">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar" id="btnsalvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>
    </div>
}