@section scripts{

    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyACnVjpiRnap58taXa7eEQJIVmD8TkoL2g&callback=initMap&libraries=places,geometry"
            async defer></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    @if (Model != null && Model.Objetos != null && Model.Objetos.Count() == 0)
    {
        <text>
            <script type="text/javascript">
                $(document).ready(function () {
                    Notificar("Atenção", "Não existem datas disponíveis para os próximos 7 dias", "warning");

                    @if (Request.Params["pagina"] == "Criacao_OS")
                    {
                        <text>
                        Notificar("@RsBase.INFORMACAO", "OS criada com sucesso", "info");
                        </text>
                    }
                });
            </script>
        </text>
    }



    <script type="text/javascript">

    let tmpHora;
    let tmpData;
    let tmpFlexivel;

    var lista = @Html.Raw(JsonConvert.SerializeObject(Model.Objetos));
        function findData(data) {

            return $.grep(lista, function (item) {
                return item.Data == data;
            });
    };

    function VoltarTempo()
    {
        let momento = moment($(`#iDataInicial`).val(), "DD-MM-YYYY").add(-14, 'days');

        momentoAtual = moment();

        if (momento.isBefore(momentoAtual)) {
            momento = momentoAtual;
        }

        $(`#iDataInicial`).val(momento.format('DD/MM/YYYY'));
        $(`#iDataInicial`).trigger('change');
    }
    function AvancarTempo()
    {
        let momento = moment($(`#iDataInicial`).val(), "DD-MM-YYYY").add(14, 'days');
        momentoAtual = moment();

        if (momento.isBefore(momentoAtual)) {
            momento = momentoAtual;
        }

        $(`#iDataInicial`).val(momento.format('DD/MM/YYYY'));
        $(`#iDataInicial`).trigger('change');
    }

        function update_query_parameters(key, val) {

          
                uri = window.location.href
                    .replace(RegExp("([?&]" + key + "(?=[=&#]|$)[^#&]*|(?=#|$))"), "&" + key + "=" + encodeURIComponent(val))
                    .replace(/^([^?&]+)&/, "$1?");
                return uri;
            
        }

        $(document).ready(function () {
            $(`#iDataInicial`).change(function () {
                var FormatoData = /^\d{2}\/\d{2}\/\d{4}$/;

                if (FormatoData.test($(`#iDataInicial`).val())) {
                    if (window.location.href != update_query_parameters('DataInicial', $(`#iDataInicial`).val())) {
                        window.location.href = update_query_parameters('DataInicial', $(`#iDataInicial`).val());
                    }
                    else {
                        window.location.reload();
                    }

                    ShowPageLoading();
                }
            });
        });

        function findHora(Horas, hora) {

            return $.grep(Horas, function (item) {
                return item.Display == hora;
            });
        };

        $('.AgendamentoOption').click(function () {
            // codigo comentado apos a implantação na MAXTELECOM, renato pediu para tirar essa parte de esconder o botao de agendamento no dia atual
            //const moment_agendamento = moment($(this).attr('data-dia'),'DD/MM/YYYY');
            //const moment_dia_atual = moment(moment().format('DD/MM/YYYY'),'DD/MM/YYYY');

            //const diff = moment_agendamento.diff(moment_dia_atual, 'days');

            //if (diff > 0)
            //    $('#iAgendar_Div').show();
            //else
            //    $('#iAgendar_Div').hide();
        })

    var clicked = false;

        function ValidaSubmitArea(roteirizar = false) {
            if ($("input[name='hora']:checked").length == 0) {
                Notificar("Atenção", "Informe Horário", "warning");
                return;
            }
            $('#iRoteirizar').val(roteirizar);

            var data_hora = $("input[name='hora']:checked")[0].id;
            var data = data_hora.substring(0, 10);
            var hora = data_hora.replace(data, "");

            let pergunta_instalação = "@Model.Documento.Exige_Pagamento_Instalacao" == "1" ? "Cliente ainda não efetuou o pagamento da instalação." : "";
            let pergunta_roteirizar = '' + pergunta_instalação + 'Deseja realmente agendar e roteirizar o serviço <b>@Model.Documento.Numero_OS</b> para dia <b>' + data + '</b> às <b>' + hora + '</b>  ?';
            @if(ViewBag.Considerar_Agendamento_Periodo) { <text> pergunta_roteirizar = pergunta_roteirizar.replace('às', 'no período da'); </text> }

            if (clicked) {
                return false;
            }
            Swal.fire({
                title: '',
                html: (roteirizar ? pergunta_roteirizar : pergunta_roteirizar.replace('e roteirizar', '')),
                type: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                cancelButtonText: 'Nao',
                confirmButtonText: 'Sim'
            }).then((result) => {
                if (result.value) {
                    if (@Model.ConfirmaEndereco.ToString().ToLower()) {
                        confirmaEndereco();
                    }
                    else {
                        Envia();
                    }
                }
                clicked = true;

                tmpData = data;
                tmpHora = hora;
                tmpFlexivel = false;

                var sNumObra = "@Html.Raw(Model.Documento.Num_Obra)";
                var sNumDoc = "@Html.Raw(Model.Documento.Num_Doc)";
                var sProjeto = "@Html.Raw(Model.Documento.Projeto)";
                var sCodCt = "@Html.Raw(Model.Documento.CodCt)";

                const link = '@String.Concat(CONSTANTES.URLPortal, "/api/Agendamento_Equipeapi/GetVerificaAgendamento")' + `?num_obra=${sNumObra}&codCt=${sCodCt}&projeto=${sProjeto}&num_Doc=${sNumDoc}`;

                $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',
                    beforeSend: function () {
                        ShowPageLoading();
                    }
                }).done(function (data) {
                    if (data.ok) {
                        HidePageLoading();
                        abrirModalMotivo();
                        clicked = false;
                    }
                    else {
                        SubmitIncluirAgenda();
                    }
                });

            });
        }

        function ValidaSubmit(roteirizar = false)
        {
            if ($("input[name='hora']:checked").length == 0) {
                Notificar("Atenção", "Informe Horário", "warning");
                return;
            }

            if ("@Model.Documento.Exige_Pagamento_Instalacao" == "1" ) {
                Notificar("@RsBase.ATENCAO_", "Não é possível agendar este serviço, pois o cliente ainda não realizou o pagamento da instalação", "warning");
                return;
            }

            $('#iRoteirizar').val(roteirizar);

            var data_hora = $("input[name='hora']:checked")[0].id;
            var data = data_hora.substring(0, 10);
            var hora = data_hora.replace(data, "");

            @*if ("@Model.Exige_Pagamento_Instalacao" == "1" ||"@Model.Exige_Pagamento_Instalacao" == 1) {
                Notificar("@RsBase.ATENCAO_", "Não é possível agendar este serviço, pois o cliente ainda não realizou o pagamento da instalação", "warning");
                return false;
             }*@


            if (clicked) {
                return false;
            }

            var pergunta_roteirizar = 'Deseja realmente agendar e roteirizar o serviço <b>@Model.Documento.Numero_OS</b> para dia <b>' + data + '</b> às <b>' + hora + '</b>  ?';
            @if(ViewBag.Considerar_Agendamento_Periodo) { <text> pergunta_roteirizar = pergunta_roteirizar.replace('às', 'no período da'); </text> }

            Swal.fire({
                title: '',
                html: (roteirizar ? pergunta_roteirizar : pergunta_roteirizar.replace('e roteirizar','')),
                type: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                cancelButtonText: 'Nao',
                confirmButtonText: 'Sim'
            }).then((result) => {
                if (result.value) {
                    if (@Model.ConfirmaEndereco.ToString().ToLower()) {
                        confirmaEndereco();
                    }
                    else {
                        Envia();
                    }
                }

            });

        }

    </script>

    <script>

        var mapConfirmacao;
        var iniciando = true;
        var marcadorAutoCompleteConfirmacao;

        function showPosition(position) {
            let latlng = { lat: position.coords.latitude, lng: position.coords.longitude };
            map.setCenter(latlng);
        }

        function abrirModalMotivo() {
            var permitirMotivoReagendamento = @ViewBag.PermitirMotivoReagendamento.ToString().ToLower();
            if (permitirMotivoReagendamento) {
                $('#modal-motivo-reagendamento').modal("show");
                AddSelect("iMotivo_ReagendamentoM", "@CONSTANTES.URLPortal/api/MotivosReagendamentosapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, null, null, null);
            } else {
                SubmitIncluirAgenda();
            }
        }

        async function initMap() {
            var myStyles = [
                {
                    featureType: "poi",
                    elementType: "labels",
                    stylers: [
                        { visibility: "off" }
                    ]
                },
                {
                    featureType: "transit",
                    elementType: "labels",
                    stylers: [
                        { visibility: "off" }
                    ]
                }
            ];

            mapConfirmacao = new google.maps.Map(document.getElementById("mapConfirmacao"), {
                center: { lat: -22.8690004, lng: -43.4790957 },
                zoom: 15,
                styles: myStyles,
                disableDefaultUI: false,
            });

            if (iniciando) {
                getLocation();
                iniciando = false;
            }
        }

        var latAntigo;
        var longAntigo;

        function getLocation() {
            if ($('#iLatitudeConfirmacao').val() && $('#iLongitudeConfirmacao').val())
            {
                let latlng = { lat: Number($('#iLatitudeConfirmacao').val()), lng: Number($('#iLongitudeConfirmacao').val()) };

                mapConfirmacao.setCenter(latlng);
                marcadorAutoCompleteConfirmacao = new google.maps.Marker({
                    position: latlng,
                    map: mapConfirmacao,
                    draggable: true,
                    title: "Resultado da Busca"
                });

                latAntigo = latlng.lat;
                longAntigo = latlng.lng;

                marcadorAutoCompleteConfirmacao.addListener('dragend', handleDragEndConfirmacao);
            }
            else {
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(showPosition);
                } else {
                    Notificar("@RsBase.ATENCAO_", "Geolocation is not supported by this browser", "warning");
                }
            }
        }

        function handleDragEndConfirmacao(event) {
            Swal.fire({
                title: 'Deseja alterar o endereço de acordo com o mapa?',
                showDenyButton: false,
                showCancelButton: true,
                confirmButtonText: 'Confirmar',
                cancelButtonText: `Cancelar`,
                icon: 'question',
                reverseButtons: true,
            }).then((result) => {
                if (result.isConfirmed) {
                    //pega info do novo endereço selecionado
                    fetch(`https://maps.googleapis.com/maps/api/geocode/json?latlng=${event.latLng.lat()},${event.latLng.lng()}&key=AIzaSyACnVjpiRnap58taXa7eEQJIVmD8TkoL2g`)
                        .then((response) => {
                            return response.json();
                        })
                        .then((data) => {
                            atualizaCamposConfirmacao(getAddressObject(data.results[0].address_components))
                            var latlng = new google.maps.LatLng(parseFloat(event.latLng.lat()), parseFloat(event.latLng.lng()));
                            mapConfirmacao.setCenter(latlng)
                        })

                } else {
                    var latlng = new google.maps.LatLng(parseFloat(latAntigo), parseFloat(longAntigo));
                    mapConfirmacao.setCenter(latlng)
                    marcadorAutoCompleteConfirmacao.setPosition(latlng);
                }
            })
        }

        function Envia() {
            clicked = true;

            var data_hora = $("input[name='hora']:checked")[0].id;
            var data = data_hora.substring(0, 10);
            var hora = data_hora.replace(data, "");

            var sNumObra = "@Html.Raw(Model.Documento.Num_Obra)";
            var sNumDoc = "@Html.Raw(Model.Documento.Num_Doc)";
            var sProjeto = "@Html.Raw(Model.Documento.Projeto)";
            var sCodCt = "@Html.Raw(Model.Documento.CodCt)";

            tmpData = data;
            tmpHora = hora;
            tmpFlexivel = true;

            const link = '@String.Concat(CONSTANTES.URLPortal, "/api/Agendamento_Equipeapi/GetVerificaAgendamento")' + `?num_obra=${sNumObra}&codCt=${sCodCt}&projeto=${sProjeto}&num_Doc=${sNumDoc}`;

            $.ajax({
                url: link,
                type: 'GET',
                dataType: 'json',
                beforeSend: function () {
                    ShowPageLoading();
                },
                complete: function () {
                    HidePageLoading();
                }
            }).done(function (data) {
                if (data.ok) {
                    abrirModalMotivo();
                } else {
                    SubmitIncluirAgenda();
                }
            });
        }

    function SubmitIncluirAgenda() {
        var data = tmpData;
        var hora = tmpHora;
        var flexivel = tmpFlexivel;

        var objData = findData(data);
        var objHora = findHora(objData[0].HorasTurno.length > 0 ? objData[0].HorasTurno : objData[0].Horas, hora);

        $("#iData").val(data);
        $("#iHora").val(hora);

        if (flexivel) {
            $("#iFlexivel").val($("#iFlexivelCheck").is(":checked"));
        }

        $("#iHora_Inicio").val(objHora[0].Hora_InicioStr);
        $("#iHora_Final").val(objHora[0].Hora_FinalStr);
        $("#iTurno").val(objHora[0].Turno);
        $("#iDeslocamento").val(objHora[0].Deslocamento);
        $("#iEquipe_Tmp").val(objHora[0].Equipe_Tmp);
        $("#iEquipeTmpComLimite").val(objHora[0].EquipeTmpComLimite);
        $("#iLimiteAgendamentoUltrapassado").val(objHora[0].LimiteAgendamentoUltrapassado);
        $("#iLista_Forca_Trabalho").val(objHora[0].Lista_Forca_Trabalho);
        $("#iLista_Ja_Agendados").val(objHora[0].Lista_Ja_Agendados);

        ShowPageLoading();

        $('#form').submit();

    }

        function confirmaEndereco() {
            $('#confirmacaoEndereco').modal('show')

            var center = mapConfirmacao.getCenter();
            google.maps.event.trigger(mapConfirmacao, 'resize');
            mapConfirmacao.setCenter(center);
        }

        async function PesquisaMapaConfirmacao() {
            try {

                let pesquisa = `${$("#iLogradouroConfirmacao").val()} ${$("#iNumeroConfirmacao").val()} ${$("#iCidadeConfirmacao").val()} ${$("#iUFConfirmacao").val()} ${$("#iPaisConfirmacao").val()}`;
                var service = new google.maps.places.PlacesService(mapConfirmacao);

                var request = {
                    query: pesquisa,
                    fields: ['name', 'geometry'],
                };

                service.findPlaceFromQuery(request, function (results, status) {

                    if (status === google.maps.places.PlacesServiceStatus.OK) {

                        if (results.length > 0) {

                            let latlng = {
                                lat: results[0].geometry.location.lat(),
                                lng: results[0].geometry.location.lng()
                            };

                            marcadorAutoCompleteConfirmacao = new google.maps.Marker({
                                position: latlng,
                                map: mapConfirmacao,
                                draggable: true,
                                title: "Resultado da Busca"
                            });

                            latAntigo = results[0].geometry.location.lat();
                            longAntigo = results[0].geometry.location.lng();

                            marcadorAutoCompleteConfirmacao.addListener('dragend', handleDragEndConfirmacao);

                            mapConfirmacao.setCenter(results[0].geometry.location);

                            fetch(`https://maps.googleapis.com/maps/api/geocode/json?latlng=${results[0].geometry.location.lat()},${results[0].geometry.location.lng()}&key=AIzaSyACnVjpiRnap58taXa7eEQJIVmD8TkoL2g`)
                                .then((response) => {
                                    return response.json();
                                })
                                .then((data) => {
                                    atualizaCamposConfirmacao(getAddressObject(data.results[0].address_components))
                                })


                        } else {
                            Notificar("@RsBase.ATENCAO_", "Não foi possível localizar endereço", "warning");
                        }
                    }
                });
            }
            catch (e) { console.log(e) }
        }

    function FecharModalReagendamento() {
        var verificaMotivo = false;
        if ($("#iMotivo_ReagendamentoM").val()) {
            verificaMotivo = true;
        }

        if (verificaMotivo) {
            $('#modal-motivo-reagendamento').modal("hide");
            SubmitIncluirAgenda();
        }
        else {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MOTIVO_REAGENDAMENTO)", "warning");
        }
    }

    $('#iMotivo_ReagendamentoM').change(function (e) {
        var id = e.target.value;
        if (id == "0") {
            $('#iMotivoReagendamentoOutros').removeClass('d-none');
        } else {
            $('#iMotivoReagendamentoOutros').addClass('d-none');
        }
    });

        function getAddressObject(address_components) {
            var ShouldBeComponent = {
                home: ["street_number"],
                postal_code: ["postal_code"],
                street: ["street_address", "route"],
                region: [
                    "administrative_area_level_1",
                ],
                city: [
                    "administrative_area_level_2",
                ],
                country: ["country"]
            };

            var address = {
                home: "",
                postal_code: "",
                street: "",
                region: "",
                city: "",
                country: ""
            };
            address_components.forEach(component => {
                for (var shouldBe in ShouldBeComponent) {
                    if (ShouldBeComponent[shouldBe].indexOf(component.types[0]) !== -1) {
                        if (shouldBe === "region") {
                            address[shouldBe] = component.short_name;
                        } else {
                            address[shouldBe] = component.long_name;
                        }
                    }
                }
            });
            return address;
        }

        function atualizaCamposConfirmacao(endereco) {
            $("#iCidadeConfirmacao").val(endereco.city);
            $("#iPaisConfirmacao").val(endereco.country);
            $("#iNumeroConfirmacao").val(endereco.home);
            $("#iCEPConfirmacao").val(endereco.postal_code);
            $("#iUFConfirmacao").val(endereco.region);
            $("#iLogradouroConfirmacao").val(endereco.street);

            $("#iLatitudeConfirmacao").val(marcadorAutoCompleteConfirmacao.position.lat());
            $("#iLongitudeConfirmacao").val(marcadorAutoCompleteConfirmacao.position.lng());
        }

        var HandleGrupoConfirmacao = function () {
            $('#iGrupoAreaConfirmacao').on('select2:select select2:unselecting', function (e) {

                GrupoSelecionado = e.params.data
                if (GrupoSelecionado) {
                    AddSelect("iAreaConfirmacao", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, $('#iGrupoAreaConfirmacao').val(), null, "@RsBase.SELECIONE", false, HandleAreaConfirmacao);
                    AddSelect("iLocalidadeConfirmacao", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
                else {
                    AddSelect("iAreaConfirmacao", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleAreaConfirmacao);
                    AddSelect("iLocalidadeConfirmacao", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };

        var HandleAreaConfirmacao = function () {
            $('#iAreaConfirmacao').on('select2:select select2:unselecting', function (e) {

                AreaSelecionada = e.params.data
                if (AreaSelecionada) {
                    AddSelect("iLocalidadeConfirmacao", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoAreaConfirmacao').val(), String(AreaSelecionada.id) , null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iLocalidadeConfirmacao", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };

        $(document).ready(async function () {

            await AddSelect("iTipoImovelConfirmacao", "@CONSTANTES.URLPortal/api/Tipo_ImovelAnielapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Documento.Id_Tipo_Imovel", "@RsBase.SELECIONE", false);
            await AddSelect("iGrupoAreaConfirmacao", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Documento.Cod_Grupo_Area", "@RsBase.SELECIONE", false, HandleGrupoConfirmacao);

            async function initMap() {
                var myStyles = [
                    {
                        featureType: "poi",
                        elementType: "labels",
                        stylers: [
                            { visibility: "off" }
                        ]
                    },
                    {
                        featureType: "transit",
                        elementType: "labels",
                        stylers: [
                            { visibility: "off" }
                        ]
                    }
                ];

                mapConfirmacao = new google.maps.Map(document.getElementById("mapConfirmacao"), {
                    center: { lat: -22.8690004, lng: -43.4790957 },
                    zoom: 15,
                    styles: myStyles,
                    disableDefaultUI: false,
                });

                if (iniciando) {
                    getLocation();
                    iniciando = false;
                }
            }

        })

    </script>
}

@section styles {

    <style>
        .btn-outline-secondary:not(:disabled):not(.disabled).active {
