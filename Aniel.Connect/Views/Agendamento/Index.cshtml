@using (Html.BeginForm("Index", "Agendamento", FormMethod.Post, htmlAttributes: new { @id = "form", @autocomplete = "off" }))
{
    @Html.AntiForgeryToken()

    if (Request.Params["pagina"] == "acompanhamento")
    {
        <text>
            @Html.HiddenFor(m => m.Pagina)
        </text>
    }


    @Html.HiddenFor(p => p.CodCt)
    @Html.HiddenFor(p => p.Projeto)
    @Html.HiddenFor(p => p.Num_Obra)
    @Html.HiddenFor(p => p.Num_Doc)

    @Html.HiddenFor(m => m.Roteirizar, new { @id = "iRoteirizar" })
    @Html.HiddenFor(m => m.Data, new { @id = "iData" })
    @Html.HiddenFor(m => m.Hora, new { @id = "iHora" })

    @Html.HiddenFor(p => p.Hora_Inicio, new { @id = "iHora_Inicio" })
    @Html.HiddenFor(p => p.Hora_Final, new { @id = "iHora_Final" })
    @Html.HiddenFor(p => p.Turno, new { @id = "iTurno" })
    @Html.HiddenFor(p => p.Deslocamento, new { @id = "iDeslocamento" })
    @Html.HiddenFor(p => p.Equipe_Tmp, new { @id = "iEquipe_Tmp" })
    @Html.HiddenFor(p => p.EquipeTmpComLimite, new { @id = "iEquipeTmpComLimite" })
    @Html.HiddenFor(p => p.LimiteAgendamentoUltrapassado, new { @id = "iLimiteAgendamentoUltrapassado" })
    @Html.HiddenFor(p => p.Lista_Forca_Trabalho, new { @id = "iLista_Forca_Trabalho" })
    @Html.HiddenFor(p => p.Lista_Ja_Agendados, new { @id = "iLista_Ja_Agendados" })
    @Html.HiddenFor(p => p.Flexivel, new { @id = "iFlexivel" })


    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page">
                            <i class="fas fa-tasks"></i> @ViewBag.Title
                        </h4>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Gestao_Equipe")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GESTAO_EQUIPES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Painel_Servicos")" style="color:#367fa9" onclick="ShowPageLoading(true); return true;">@RsCadastros.PAINEL_SERVICOS</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Acompanhamento_Servico", new { CodCt = Model.CodCt,Projeto = Html.Raw(Model.Projeto),Num_Obra = Model.Num_Obra,Num_Doc = Model.Num_Doc})" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.ACOMPANHAMENTO_SERVICO</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>Agendamento</span>
                                </li>

                            </ol>
                        </nav>

                    </div>
                </div>
                @if (Model != null && Model.Documento != null)
                {
                    <div id="accordion">
                        <div class="card div-card-accord">
                            <div class="card-header title-card" id="heading-1">
                                <h5 class="mb-0">
                                    <span class="text-bold-card">Dados do Serviço:</span>
                                </h5>
                            </div>
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body body-card-accord">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <label for="inputState">@RsCadastros.ORDEM_SERVICO:</label>
                                            <span>@Model.Documento.Numero_OS</span>
                                        </div>
                                        <div class="col-sm-8">
                                            <label for="inputState">@RsCadastros.CLIENTE:</label>
                                            <span>@Model.Documento.Nome_Cliente</span>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <label for="inputState">@RsCadastros.STATUS_OS:</label>
                                            <span>@Model.Documento.Status_OS</span>
                                        </div>
                                        <div class="col-sm-4">
                                            <label for="inputState">@RsCadastros.TELEFONEFIXO:</label>
                                            <span>@Model.Documento.Telefone_Principal_Cliente</span>
                                        </div>
                                        <div class="col-sm-4">
                                            <label for="inputState">@RsCadastros.TIPO_SERVICO:</label>
                                            <span>@Model.Documento.Tipo_Servico</span>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <label for="inputState">@RsCadastros.GRUPO_AREA:</label>
                                            <span>@Model.Documento.Grupo_Area</span>
                                        </div>
                                        <div class="col-sm-4">
                                            <label for="inputState">@RsCadastros.AREA:</label>
                                            <span>@Model.Documento.Area</span>
                                        </div>
                                        <div class="col-sm-4">
                                            <label for="inputState">@RsCadastros.LOCALIDADE:</label>
                                            <span>@Model.Documento.Localidade</span>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <label for="inputState">@RsCadastros.ENDERECO:</label>
                                            <span>@Model.Documento.GetEndereco()</span>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if (Model != null && Model.Objetos != null && Model.Objetos.Count() > 0)
                {


                    <div id="accordion2">
                        <div class="card div-card-accord">
                            <div class="card-header title-card" id="heading-2">
                                <div class="container-fluid">
                                    <div class="row">
                                        <div class="col-auto mr-auto" style="padding-top: 5px;margin-left: -5px;">
                                            <h5>
                                                <span class="text-bold-card">Criar Agendamento:</span>
                                            </h5>
                                        </div>
                                        @if (AcessoHelper.TemAcesso(_areas, "281"))
                                        {
                                            <div class="col-auto" id="iAgendar_Div">
                                                <button type="button" name="cadastrar" class="btn btn-success" onclick="return ValidaSubmitArea();">@RsCadastros.AGENDAR</button>
                                            </div>
                                        }
                                        else
                                        {

                                            <div class="col-auto" id="iAgendar_Div">
                                                <button type="button" name="cadastrar" class="btn btn-success" onclick="return ValidaSubmit();">@RsCadastros.AGENDAR</button>
                                            </div>
                                        }


                                        @if (ViewBag.UtilizaRoteirizacao)
                                        {
                                            if (AcessoHelper.TemAcesso(_areas, "305"))
                                            {
                                                if (AcessoHelper.TemAcesso(_areas, "281"))
                                                {
                                                    <div class="col-auto" id="iAgendar_RoteirizarDiv">
                                                        <button type="button" name="cadastrar" class="btn btn-success" onclick="return ValidaSubmitArea(true);">@RsCadastros.AGENDAR_E_ROTERIZAR</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="col-auto" id="iAgendar_RoteirizarDiv">
                                                        <button type="button" name="cadastrar" class="btn btn-success" onclick="return ValidaSubmit(true);">@RsCadastros.AGENDAR_E_ROTERIZAR</button>
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                            <div id="collapse-2" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                                <div class="card-body body-card-accord">
                                    <input type="checkbox" id="iFlexivelCheck"> Flexivel
                                    <div class="container">
                                        <div class="row mb-3 justify-content-center">
                                            @if (Model.Data != DateTime.Today.ToString("dd/MM/yyyy"))
                                            {
                                                <i title="Anterior" id="iIconVoltarTempo" onclick="VoltarTempo()" class="fas fa-arrow-left fa-2x mr-5 ml-2"></i>
                                            }
                                            <label class="mr-1 ml-1" for="iDataInicial">Data Inicial:</label><br />
                                            @Html.TextBoxFor(m => m.Data, new { @class = "form-control datepicker-period", @data_startdate = DateTime.Today.ToString("dd/MM/yyyy"), @data_provide = "datepicker", @id = "iDataInicial", @autocomplete = "off" })
                                            <i title="@RsCadastros.PROXIMO" onclick="AvancarTempo()" class="fas fa-arrow-right fa-2x mr-2 ml-5"></i>

                                        </div>
                                        <div class="row mb-2" data-toggle="buttons">
                                            @foreach (AgendamentoDiaModel dia in Model.Objetos)
                                            {
                                                TimeSpan Tempo = TimeSpan.Parse(ViewBag.Tempo_Min ?? "0");
                                                Boolean IncluiDia = false;

                                                foreach (AgendamentoHorasDisponiveis hora in (dia.HorasTurno.Count > 0 ? dia.HorasTurno : dia.Horas))
                                                {
                                                    DateTime HoraAgendamento = hora.Hora_Inicio;
                                                    if (HoraAgendamento >= DateTime.Now.Add(Tempo))
                                                    {
                                                        IncluiDia = true;
                                                    }
                                                }

                                                DateTime DiaAgendamento = DateTime.ParseExact(dia.Data, "dd/MM/yyyy", CultureInfo.GetCultureInfo("pt-BR"));
                                                if (DiaAgendamento >= DateTime.Now.Add(Tempo).Date && IncluiDia)
                                                {
                                                    <text>
                                                        <div class="card col-lg-2 col-md-3 col-sm-1">
                                                            <div class="card-header" style="background-color: inherit;">
                                                                <h5 class="m-0">
                                                                    <span class="text-bold-card"><i class="far fa-calendar-alt"></i> @dia.Data</span>
                                                                </h5>
                                                            </div>
                                                            <div class="card-body btn-group-toggle m-0">

                                                                @foreach (AgendamentoHorasDisponiveis hora in (dia.HorasTurno.Count > 0 ? dia.HorasTurno : dia.Horas))
                                                                {
                                                                    DateTime HoraAgendamento = hora.Hora_Inicio;

                                                                    if (HoraAgendamento >= DateTime.Now.Add(Tempo))
                                                                    {
                                                                        if (hora.LimiteAgendamentoUltrapassado && hora.AptosPorLimite <= 0)
                                                                        {
                                                                            <text>
                                                                                <label data-dia="@dia.Data" class="btn AgendamentoOption btn-outline-secondary disabled mb-2" title="Aptos: @hora.Aptos">
                                                                                    <input type="radio" name="hora" id="@dia.Data@hora.Display" autocomplete="off" disabled><i class="far fa-clock"></i> @hora.Display
                                                                                </label>
                                                                            </text>
                                                                        }
                                                                        else
                                                                        {
                                                                            <text>
                                                                                <label data-dia="@dia.Data" class="btn AgendamentoOption btn-outline-secondary mb-2" title="Aptos: @hora.Aptos">
                                                                                    <input type="radio" name="hora" id="@dia.Data@hora.Display" autocomplete="off"><i class="far fa-clock"></i> @hora.Display
                                                                                </label>
                                                                            </text>
                                                                        }
                                                                    }
                                                                }
                                                            </div>
                                                        </div>
                                                    </text>
                                                }
                                            }

                                        </div>
                                    </div>


                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div id="confirmacaoEndereco" class="modal text-center" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header text-center">
                    <h4 align="center" class="modal-title text-muted">Confirmar endereço</h4>
                </div>

                <div class="modal-body">
                    <div class="ml-3">
                        <div class="row">
                            <div class="col-4 text-left">
                                <span>Cidade:</span>
                                @Html.TextBoxFor(x => x.Documento.Endereco_Cidade, new { @class = "form-control", @id = "iCidadeConfirmacao" })
                            </div>
                            <div class="col-3 text-left">
                                <span>Bairro:</span>
                                @Html.TextBoxFor(x => x.Documento.Endereco_Bairro, new { @class = "form-control", @id = "iBairroConfirmacao" })
                            </div>
                            <div class="col-2 text-left">
                                <span>UF:</span>
                                @Html.TextBoxFor(x => x.Documento.Endereco_UF, new { @class = "form-control", @id = "iUFConfirmacao" })
                            </div>
                            <div class="col-2 text-left">
                                <span>País:</span>
                                @Html.TextBoxFor(x => x.Documento.Endereco_Pais, new { @class = "form-control", @id = "iPaisConfirmacao" })
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-4 text-left">
                                <label>@RsCadastros.LOGRADOURO: </label>
                                @Html.TextBoxFor(x => x.Documento.Endereco_Logradouro, new { @class = "form-control", @id = "iLogradouroConfirmacao" })
                            </div>

                            <div class="col-3 text-left">
                                <label>@RsCadastros.NUMERO: </label>
                                @Html.TextBoxFor(x => x.Documento.Endereco_Numero, new { @class = "form-control", @id = "iNumeroConfirmacao" })
                            </div>

                            <div class="col-4 text-left">
                                <label>Tipo imóvel: </label>
                                @Html.DropDownListFor(model => model.Documento.Id_Tipo_Imovel, new SelectList(new List<ObjBusca<string>>(), "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control ", @id = "iTipoImovelConfirmacao" })
                            </div>

                        </div>

                        <div class="row mt-2">
                            <div class="col-4 text-left">
                                <label>@RsCadastros.CEP: </label>
                                @Html.TextBoxFor(x => x.Documento.Endereco_CEP, new { @class = "form-control", @id = "iCEPConfirmacao" })
                            </div>

                            <div class="col-4 text-left">
                                <label>@RsCadastros.COMPLEMENTO: </label>
                                @Html.TextBoxFor(x => x.Documento.Endereco_Complemento, new { @class = "form-control" })
                            </div>
                            <div class="col-3 text-left">
                                <label>@RsCadastros.PONTOREFERENCIA: </label>
                                @Html.TextBoxFor(x => x.Documento.Endereco_PontoReferencia, new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-4 text-left">
                                <label>@RsCadastros.GRUPO_AREA: </label>
                                @Html.DropDownListFor(model => model.Documento.Cod_Grupo_Area, new SelectList(new List<ObjBusca<string>>(), "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iGrupoAreaConfirmacao" })
                            </div>

                            <div class="col-4 text-left">
                                <label>@RsCadastros.AREA: </label>
                                @Html.DropDownListFor(model => model.Documento.Cod_Area, new SelectList(new List<ObjBusca<string>>(), "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iAreaConfirmacao" })
                            </div>
                            <div class="col-3 text-left">
                                <label>@RsCadastros.LOCALIDADE: </label>
                                @Html.DropDownListFor(model => model.Documento.Cod_Localidade, new SelectList(new List<ObjBusca<string>>(), "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iLocalidadeConfirmacao" })
                            </div>
                            <a href="#" onclick="PesquisaMapaConfirmacao();" class="mt-4"><i class="la la-search la-2x" style="color: #999"></i></a>
                        </div>

                        <div class="row mt-2">
                            <div class="col-2 text-left">
                                <label>@RsCadastros.LATITUDE: </label>
                                @Html.TextBoxFor(x => x.Documento.Endereco_Latitude, new { @class = "form-control", @id = "iLatitudeConfirmacao" })
                            </div>

                            <div class="col-2 text-left">
                                <label>@RsCadastros.LONGITUDE: </label>
                                @Html.TextBoxFor(x => x.Documento.Endereco_Longitude, new { @class = "form-control", @id = "iLongitudeConfirmacao" })
                            </div>
                        </div>

                        <input type="text" class="form-control ml-2 mr-1 d-none" id="iPesquisaMapConfirmacao" autocomplete="off">
                    </div>
                    <div id="mapConfirmacao" class="mt-4" style="height: 25rem">map</div>
                </div>

                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="button" onclick="Envia()" class="btn btn-primary ">Confirmar</button>
                </div>
            </div>
        </div>
    </div>



    <div class="modal fade" id="modal-motivo-reagendamento">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title text-muted">Informe o motivo de reagendamento</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-sm-12" style="align-content:center;">
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group" id="exibirMotivoReagendamento">
                                        <label for="iMotivo_Desistencia_VendaM" class="mr-3">@RsCadastros.MOTIVO_REAGENDAMENTO:</label><br>
                                        @Html.DropDownListFor(model => model.CodMotivoReagendamento, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iMotivo_ReagendamentoM", @autocomplete = "off", required = "required" })
                                    </div>
                                    <div class="form-group d-none" id="iMotivoReagendamentoOutros">
                                        <div><label>Informe o Motivo:</label></div>
                                        @Html.TextAreaFor(model => model.ObsMotivoReagendamento, new { @class = "form-control", @id = "iMotivo_Reagendamento_Outros", @autocomplete = "off", required = "required" })
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="form-group col-sm-12" style="padding: 15px;">
                        <div class="text-center">
                            <button type="button" class="btn btn-success" onclick="FecharModalReagendamento();" id="iEditarAtividades">OK</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
