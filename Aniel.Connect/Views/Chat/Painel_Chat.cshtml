        async function carregaHistorico(codCt,projeto,numDoc,numOs)
        {
            ShowPageLoading();
            $("#chatFrame").attr("data-pageid", `chatback${numOs}`);

            //Apaga as mensagens anteriores do frame
            $('#messages', $('#chatFrame').contents()).empty();

            $('#id_numOs').val(numOs);
            $('#num_fre').val("@User.Identity.GetUserName()");

            datetime = moment().format("DD/MM/YYYY HH:mm:ss");
            listaPromisesReady = [];
            usuarios = [];

            $(window).resize(function () {
                $("#Chat").css({
                    height: $(window).height() - $(window).height() / 6
                });
            });
            $('#divProgressChat').show();

            //Monta Objeto de servicoChat
            const servicoChat = {
                num_os: numOs,
                dataAbertura: datetime,
                usuarios: usuarios,
            };


            servicoChat.usuarios.push({
                num_fre: "@User.Identity.GetUserId()",
                nome: "@ViewBag.Nome_Func",
            });

            try {
                await parent.chatback.server.iniciarChat(servicoChat);
                console.log("iniciou");
                var mensagensString = await parent.getChatMessagesBackOffice(numOs, "@User.Identity.GetUserId()");
                /*console.log(mensagensString);*/
                var mensagens = "";
                mensagens = Boolean(mensagensString) ? JSON.parse(mensagensString) : [];

                ShowPageLoading();
                $('#chatFrame').on('load', function () {

                    $('#messages', $('#chatFrame').contents()).empty();
                    $('#divProgressChat').fadeOut();
                    for (message of mensagens) {

                        var tipoBalao = 'recebido';

                        if (message.statusEnvio == "3") {
                            tipoBalao = 'separador';
                        } else if (message.usuario.num_fre == "@User.Identity.GetUserId()") {
                            tipoBalao = 'enviado';
                        }

                        renderMessage(message.mensagem, message.dataHora, message.usuario, tipoBalao, null, message.anexo, message);
                    }
                    animateMessageScroll();
                    HidePageLoading();
                });


                $("#chatFrame").attr("src", "@Url.Action("Chat_iFrame", "Chat")" + `?Num_Obra=${numOs}&Cod_Ct=${codCt}&Projeto=${projeto}&Num_Doc=${numDoc}`);


                $("#Chat").css({
                    height: $(window).height() - $(window).height() / 6
                });


            }
            catch (error)
            {
                Notificar("@RsBase.ATENCAO_", error.message, "warning");
            }

        }



        function renderMessage(message, datetime, usuario, tipoBalao, dadosSeparador, arquivos, objetoMensagem) {

            var tipo_usuario = retornaUsuario(usuario.tipo_usuario);

            if (datetime != null) {
                datetime = moment(datetime).format("DD/MM/YYYY HH:mm:ss");
            } else {
                datetime = moment().format("DD/MM/YYYY HH:mm:ss");
            }
            $('#divSeparador', $('#chatFrame').contents()).html("");

            let divArquivo = "";
            var vazio = "";
            let IdArquivo = create_UUID();

            if (arquivos != null) {
                if (arquivos.isUrl == true) {
                    divArquivo += (`<div id="${IdArquivo}" style="margin-top: 5px;"><a class="tag  mr-1 ml-1 text-truncate" href="${arquivos.url} "target="_blank"><i class="fas fa-paperclip"></i> ${arquivos.name}.${arquivos.fileExtension}</a></div>`);
                } else if (arquivos.isUrl == false) {
                    divArquivo += (`<div id="${IdArquivo}" style="margin-top: 5px;"><a id="arquivosMensagem" class="tag  mr-1 ml-1 text-truncate" onClick="downloadImagem('${objetoMensagem.num_os}', '${objetoMensagem.id}', '${arquivos.name}', '${arquivos.fileExtension}')"><i class="fas fa-paperclip"></i> ${arquivos.name}.${arquivos.fileExtension}</a></div>`);
                }
            }

            if (tipoBalao == 'enviado') {
                $('#messages', $('#chatFrame').contents()).html($('#messages', $('#chatFrame').contents()).html() +

                    `<div class="row justify-content-end">
                    <div class="card mb-3 mt-3" style="width:50%; border-radius: 1rem;">
                        <div style="border-radius: 1rem;" class="card-body alert-info text-left">
                           <div class="row" style="font-size: 14px;">
                              <div class="col text-capitalize text-truncate">
                                <i class='icofont-ui-head-phone'></i><small> ${tipo_usuario} </small><strong style='text-transform: capitalize !important;'> ${usuario.num_fre} - ${usuario.nome} </strong>
                              </div>
                            <div class="col text-right">
                                <span class="ml-5"><small>${datetime}</small></span>
                            </div>
                          </div>
                          <hr style="margin-top: 5px;margin-bottom: 5px; background-color: #000;">
                          <div class="row" style="font-size: 14px;">
                              <div class="col" style="white-space:pre-line">
                                   ${message == null ? '' : message}
                              </div>
                          </div>
                    </div>
                       ${divArquivo}
                </div>
                `);

            } else if (tipoBalao == 'recebido') {

                $('#messages', $('#chatFrame').contents()).html($('#messages', $('#chatFrame').contents()).html() +

                    `<div class="row justify-content-start">
                    <div class="card mb-3 mt-3" style="width:50%; border-radius: 1rem;">
                        <div style="border-radius: 1rem;" class="card-body alert-secondary text-left">
                           <div class="row" style="font-size: 14px;">
                              <div class="col text-capitalize text-truncate">
                                <i class='icofont-ui-head-phone'></i><small> ${tipo_usuario} </small><strong style='text-transform: capitalize !important;'> ${usuario.num_fre} - ${usuario.nome} </strong>
                              </div>
                            <div class="col text-right">
                                <span class="ml-5"><small>${datetime}</small></span>
                            </div>
                          </div>
                          <hr style="margin-top: 5px;margin-bottom: 5px; background-color: #d7e1f7;">
                          <div class="row" style="font-size: 14px;">
                              <div class="col" style="white-space:pre-line">
                                   ${message == null ? '' : message}
                              </div>
                          </div>
                    </div>
                        ${divArquivo}
                </div>
                `);
            } else if (tipoBalao == 'separador') {
                $('#messages', $('#chatFrame').contents()).html($('#messages', $('#chatFrame').contents()).html() +
                    `<div id="divSeparador" class="center" style="text-align: center;
                        border-radius: 10px;
                        align-items: center;
                        font-size: x-small;
                        background-color: #0000008f;
                        color: white;
                        border: white;
                        border-style: solid;
                        border-width: thin;">
                        ${message == null ? '' : message}
                    </div>
                `);
            }
        }



    async function limparAnexo() {

        $('#anexosSelecionados').hide();
        $('#nameAnexo').val("");
        $('#iArquivoChat').val("");
        $('#preview').attr("src","");

        var oldInput = document.getElementById('iArquivoChat');
        var newInput = document.createElement('input');
        newInput.id = oldInput.id;
        newInput.type = oldInput.type;
        newInput.name = oldInput.name;
        newInput.size = oldInput.size;
        newInput.class = oldInput.class;
        oldInput.parentNode.replaceChild(newInput, oldInput);
        $(newInput).hide();
        document.getElementById("iArquivoChat").addEventListener("change", readImage, false);
    }

        function create_UUID() {
            var dt = new Date().getTime();
            var uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                var r = (dt + Math.random() * 16) % 16 | 0;
                dt = Math.floor(dt / 16);
                return (c == 'x' ? r : (r & 0x3 | 0x8)).toString(16);
            });
            return uuid;
        }


        function animateMessageScroll() {
            var log = $('#messages', $('#chatFrame').contents());
            log.animate({ scrollTop: log.prop('scrollHeight') }, 500);
        }

        function readImage() {

        var extensoesPermitidasImagem = /(.jpeg|.jpg|.gif|.png|.bmp|.tiff)$/i;
        var extensoesPermitidasVideo = /(.mpeg|.mp4|.quicktime|.webm|.3gpp|.3gpp2|.3gpp-tt|.H261|.H263-1998|.H263-2000|.H264)$/i;
        var extensoesPermitidasAudio = /(.L24|.mp3|.mpeg|.ogg|.vnd.rn-realaudio|.vnd.wave|.3gpp|.3gpp2|.ac3|.webm|.amr-nb|.amr|.snd|.au)$/i;
        var extensoesPermitidasArquivo = /(.vcard|.pdf|.directory|.calendar|.richtext|.rtf|.x-vcard|.doc|.docx|.xls|.xlx)$/i;

        if (this.files && this.files[0]) {
            var file = new FileReader();

            var patch = this.files[0].name;
            if (extensoesPermitidasImagem.exec(patch)) {
                file.onload = function (e) {
                    document.getElementById("preview").src = e.target.result;
                };
            } else if (extensoesPermitidasVideo.exec(patch)) {
                document.getElementById("preview").src = `@{@CONSTANTES.URLPortal}/Content/images/video.svg`;
            } else if (extensoesPermitidasAudio.exec(patch)) {
                document.getElementById("preview").src = `@{@CONSTANTES.URLPortal}/Content/images/audio.svg`;
            } else {
                document.getElementById("preview").src = `@{@CONSTANTES.URLPortal}/Content/images/file.svg`;
            }

            file.readAsDataURL(this.files[0]);
        }
        document.getElementById("anexosSelecionados").style.display = 'block';
        document.getElementById("nameAnexo").value = this.files[0].name;
    }

    //document.getElementById("iArquivoChat").addEventListener("change", readImage, false);

    $.ajax({
        type: 'GET',
        url: `@CONSTANTES.URLPortal/api/IdentityUserapi/FindById?Id=${"@User.Identity.GetUserId()"}`,
        dataType: 'json'
    }).
        done(function (data) {
            Id_Responsavel_nome = data.objeto.desc_User;
        });

        function retornaUsuario(tipo_usuario) {
            var tipo = tipo_usuario;
            if (typeof tipo_usuario === "undefined" || tipo_usuario == 3) {
                tipo = "";
            } else {
                switch (tipo_usuario) {
                    case 0:
                        tipo = "TÉCNICO"
                        break;

                    case 1:
                        tipo = "SUPERVISOR"
                        break;

                    case 2:
                        tipo = "MONITOR"
                        break;
                }
            }
            return tipo;
        }

        function CreateGuid(datetime) {
            function _p8(s) {
                //substituir pela data/hora da mensagem
                var p = (Math.random().toString(16) + datetime).substr(2, 8);
                return s ? "-" + p.substr(0, 4) + "-" + p.substr(4, 4) : p;
            }
            return _p8() + _p8(true) + _p8(true) + _p8();
        }

        $('#inlineFormInputGroupUsername2').keyup(function (event) {
            if (event.keyCode === 13) {
                event.preventDefault();
                sendMessage()
            }
        })



    </script>


}


