@section scripts
{
    <!--TyneMCE-->
    <script src="https://cdn.tiny.cloud/1/5cd306b14gcnqz5xzm9ekr2ekz3far2tsel7sfe91nytmkt8/tinymce/5/tinymce.min.js" referrerpolicy="origin"></script>
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    @*@Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")*@

    <script type="module">


        import { EmojiButton } from 'https://cdn.jsdelivr.net/npm/@("@")joeattardi/emoji-button@4.0.1/dist/index.min.js';

        var picker = new EmojiButton();
        picker.on('emoji', selection => {
            $('#inlineFormInputGroupUsername2').val($('#inlineFormInputGroupUsername2').val() + selection.emoji);
        });

        $("#iEmoji").click(function () {
            picker.togglePicker(this);
        });


    </script>

    <script>
        $('#iDataInicial').val("@DateTime.Now.AddDays(-30).ToString("dd/MM/yyyy")");
        $('#iDataFinal').val("@DateTime.Now.ToString("dd/MM/yyyy")");
        function EventMatricula()
        {
            $("#iMatricula_Id").on('change', function () {
                if ($("#iMatricula_Id").val() == null) {
                    document.getElementById('AlterarCampo').innerHTML = 'Definir ' + '@RsCadastros.RESPONSAVEL';
                }
            });
        }

        function alteraCampo() {

            if (document.getElementById('AlterarCampo').innerHTML.includes(`@Html.Raw(RsCadastros.TROCAR_RESPONSAVEL_OS)`))
            {
                $('#iMatricula_Id').val(null).trigger('change');
            }
            else {
                document.getElementById('AlterarCampo').innerHTML = `<i class='mr-2 icofont-refresh'></i>@Html.Raw(RsCadastros.TROCAR_RESPONSAVEL_OS)`;
                trocarResponsavel();
            }
        }

        function filtrarDatatable() {
            $('#datatable').DataTable().ajax.reload();
        }

        //<!--ENVIA AS MENSAGENS DO CHAT-->
        async function sendMessage() {
            const datetime = moment().format("DD/MM/YYYY HH:mm:ss");
            var numOs = $('#id_numOs').val();
            let id_mensagem = create_UUID();

            //MONTA A ESTRUTURA DE USUÁRIO
            const usuario = ({
                nome: "@ViewBag.Nome_Func",
                num_fre: "@User.Identity.GetUserId()",
                ativo: true,
                tipo_usuario: $('#tipoUsuario').val(),
            });

            //MONSTA A ESTRUTURA DE ANEXO
            let anexo = null;
            let obj = $('#iArquivoChat')[0];

            if (obj.files.length > 0) {

                let fileid = create_UUID();

                //valida o tipo
                var nomeFiles = obj.files[0].name;
                var tipo = 0;
                var extensoesPermitidasImagem = /(.jpeg|.jpg|.gif|.png|.bmp|.tiff)$/i;
                var extensoesPermitidasVideo = /(.mpeg|.mp4|.quicktime|.webm|.3gpp|.3gpp2|.3gpp-tt|.H261|.H263-1998|.H263-2000|.H264)$/i;
                var extensoesPermitidasAudio = /(.L24|.mp3|.mpeg|.ogg|.vnd.rn-realaudio|.vnd.wave|.3gpp|.3gpp2|.ac3|.webm|.amr-nb|.amr|.snd|.au)$/i;
                var extensoesPermitidasArquivo = /(.vcard|.pdf|.directory|.calendar|.richtext|.rtf|.x-vcard|.doc|.docx)$/i;

                if (extensoesPermitidasImagem.exec(nomeFiles)) {
                    tipo = 0;
                } else if (extensoesPermitidasVideo.exec(nomeFiles)) {
                    tipo = 1;
                } else if (extensoesPermitidasAudio.exec(nomeFiles)) {
                    tipo = 2;
                } else if (extensoesPermitidasArquivo.exec(nomeFiles)) {
                    tipo = 3;
                }

                //Busca o MimeType do aquivo
                var nome = nomeFiles.split(".");
                anexo = ({
                    name: id_mensagem,
                    url: null,
                    MimeType: obj.files[0].type,
                    fileExtension: nomeFiles.substring(nomeFiles.indexOf(".") + 1),
                    arquivoBytes: null,
                    tipo: tipo,
                });
            }

            //MONTA O OBJETO MENSAGEM
            const message = {
                id: id_mensagem,
                mensagem: $('#inlineFormInputGroupUsername2').val(),
                /*dataHora: datetime,*/ // campo datetime no backend , da erro de conversao
                dataHoraString: datetime,
                num_os: numOs,
                statusEnvio: 1,
                usuario: usuario,
                anexo: anexo
            };


            ////Caso exista anexo, envia mensagem pelo enviar Mensagem Anexo
            if (anexo != null) {

                var data = new FormData();
                data.append("UploadedImage", obj.files[0]);
                data.append("id", id_mensagem);

                var link = `@CONSTANTES.URLPortal/api/ChatApi/AdicionarAnexoChatConnect?m=${JSON.stringify(message)}`;

                //Envia para o servidor
                $.ajax({
                    url: link,
                    type: 'POST',
                    contentType: false,
                    processData: false,
                    data: data

                }).done(function (data) {
                    if (data.valor.anexo.url != null) {
                        message.anexo.url = data.valor.anexo.url;
                    }
                    message.anexo.isUrl = data.valor.anexo.isUrl;

                    let sucesso = parent.chatback.server.enviarMensagemAnexo(numOs, id_mensagem);
                    renderMessage(message.mensagem, message.dataHora, message.usuario, 'enviado', null, message.anexo, message);
                });
            } else {
                let sucesso = parent.chatback.server.enviarMensagem(numOs, JSON.stringify(message))
                renderMessage(message.mensagem, message.dataHora, message.usuario, 'enviado', null, message.anexo, message);
            }

            $('#inlineFormInputGroupUsername2').val("")
            animateMessageScroll();

            //limpa os anexos
            limparAnexo();
            filtrarDatatable(); //atualiza o datatable ao enviar ou chegar uma nova mensagem
        }

        $(document).ready(async function () {

            $('#tipoUsuario').val('@Html.Raw(ViewBag.tipoUsuario)');
            //filtrarDatatable(); //atualiza o datatable ao enviar ou chegar uma nova mensagem

            //Monta a iDatainicial e iDataFinal padrão de 30 dias
            parent.chatback.client.mensagemResposta = (mensagem) => {
                filtrarDatatable(); //atualiza o datatable ao enviar ou chegar uma nova mensagem
                if (mensagem.usuario.num_fre != "@User.Identity.GetUserId()") {
                    $('#chatFrame').contentWindow.renderMessage(mensagem.mensagem, mensagem.dataHora, mensagem.usuario, 'enviado', null, mensagem.anexo, mensagem)
                }
            }

            const link = '@String.Concat(CONSTANTES.URLPortal, "/api/Acompanhamento_ServicoApi/FotoAjax")' + `?num_fre='@User.Identity.GetUserId()'`;
            await $.ajax({
                url: link,
                type: "GET",
                dataType: "json"
            })
                .done(function (data) {
                    $("#iFotoLoading").hide();
                    if (data.objeto) {
                        $("#idImg").html('<img id="iFoto" width="80%" height="100%" style="height: 80% !important;" src="data:image/jpeg;base64,' + data.objeto + '" class="rounded-circle img-fluid" alt="@RsCadastros.FUNCIONARIO" />');
                    }
                    else {
                        $("#idImg").html('<i id="iFoto" class="fas fa-user-circle fa-3x"></i>');
                    }
                });
        });


        function trocarResponsavel() {
            var grupo = $('#iMatricula_Id').val();
            var numObra = $('#id_numOs').val();

            $.ajax({
                url: `@CONSTANTES.URLPortal/api/ChatApi/GravarEquipe?grupo=${grupo}&numObra='${numObra}'`,
                type: 'POST'


            }).done(function (data) {
                if (data.ok) {
                    DisableSelect('iMatricula_Id');
                    Notificar("@RsBase.ATENCAO_", "Técnico alterado com sucesso!", "warning");
                } else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });
        }


        function Reagendar(codct, projeto, num_obra, num_doc) {
            var url = '@Url.Action("Index","Agendamento")' + '?CodCt=' + codct + '&Projeto=' + projeto + '&Num_Obra=' + num_obra + '&Num_Doc=' + num_doc;
            AddAba(url, '@RsCadastros.AGENDAMENTO_REAGENDAMENTO_SERVICOS');
            HidePageLoading();
        }

        function Salvar(codct, projeto, num_obra, num_doc) {

            $.ajax({
                url: `@CONSTANTES.URLPortal/api/ChatApi/GravarDadosAgendamento`,
                type: 'POST',
                dataType: 'json',
                data: {
                    CodCt: codct,
                    num_obra: num_obra,
                    num_doc: num_doc,
                    projeto: projeto,
                    data: $("#idataAgendamento").val(),
                    hora: $("#ihoraAgendamento").val(),
                    turno: $("#iPeriodo").val()
                }
            }).done(function (data) {
                if (data.ok) {
                    Notificar("@RsBase.ATENCAO_", "Agendamento alterado com sucesso!", "warning");
                } else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }

                HidePageLoading();
                carregaDivDadosOS(codct, projeto, num_obra, num_doc)
            });
        }

        function carregaDivDadosOS(codct, projeto, num_obra, num_doc) {
            //Verifica se OS possui equipe vinculada
            $.ajax({                

                url: `@CONSTANTES.URLPortal/api/Gestao_Equipeapi/GetParticipantes?codct=${codct}&proj=${projeto}&Num_OS=${num_obra}&numDoc=${num_doc}`,
                type: "POST",
            })
                .done(function (data) {
                    if (data.length == 0) {
                        Notificar("@RsBase.ATENCAO_", `Não há monitores, técnicos ou supervisores vinculados a OS/Obra nº ${num_obra}`, "warning");
                    } else {

                        $.ajax({

                            url: `@CONSTANTES.URLPortal/api/ChatApi/GetDadosOS?numOS=${num_obra}`,
                            type: "POST",
                        })
                            .done(function (retorno) {

                                if (retorno.ok) {

                                    let data = retorno.objeto;
                                    //Caso o usuario esteja inativo, bloqueia o envio de mensagens
                                    if (data[0].usuario_ativo == false && @ViewBag.temAcesso == "False") {
                                        @ViewBag.bloqueiaMensagem = true;
                                    }

                                    $('#tipoUsuario').val(data[0].tipo_usuario);

                                    $("#envio_mensagem").show();

                                    $("#divDadosOS").html("");

                                    $('#divDadosOS').append(
                                        `<h4><i class="fa fa-regular fa-wrench fa-1x" id='numOs'></i> OS: ${data[0].numOS}</h4>

                            <div>
                            <hr size="5" width="auto">
                            </div>

                <div class="container">
                <div class="row">
                        <div class="col-sm">
                        <label for="iLabelAgendamento" class="mr-2"><small><b>@RsCadastros.DATA_AGENDAMENTO: </b></small></label><br>
                        ${data[0].status_execucao != 1 && data[0].status_execucao != 0 ? `<input type='text' class='form-control col-sm-4 datepicker' name='idataAgendamento' id='idataAgendamento' data-provide='datepicker' maxlength='10' value='${data[0].dataAgendamento}'><label for="idataAgendamento"> </label>` : `<label class="mr-2">${data[0].dataAgendamento}</label>`}
                        </div>

                        <div class="col-sm">
                        <label for="iLabelHoraAgendamento" class="mr-2"><small><b>@RsCadastros.HORA_AGENDAMENTO: </b></small></label><br>
                        ${data[0].status_execucao != 1 && data[0].status_execucao != 0 ? `<input type='text' class='form-control hora col-sm-4 ' style='max-width: 102px;font-size: 12px;display: inline;'  id='ihoraAgendamento' placeholder='00:00' value="${data[0].horaInicio == null ? "" : data[0].horaInicio}"><label for="ihoraAgendamento"> <i class="fa fa-clock fs-15 color-icon-date text-primary"></i></label>` : `<label class="mr-2"></label>`}
                        </div>

                        <div class="col-sm">
                        <label for="iLabelPeriodo" class="mr-2"><small><b>@RsCadastros.PERIODO: </b></small></label><br>
                        <select autocomplete="off" class="form-control readonly" data-val="true" id="iPeriodo" name="iPeriodo" tabindex="-1" data-select2-id="iPeriodo" aria-hidden="true"></select>
                        </div>

                        <div class="col-sm">
                        </br>
                        <a class="btn btn-primary" id="btnSalvar" style="color:white" name="Salvar" onclick="Salvar('${data[0].codct}', '${data[0].projeto}', '${data[0].numOS}', '${data[0].num_doc}');ShowPageLoading();"><i class="mr-1 icofont-diskette"></i>Salvar</a>
                        </div>

                        <div class="col-sm">
                        </br>
                        <a class="btn btn-primary" id="btnReagendar" style="color:white" name="agendar" onclick="Reagendar('${data[0].codct}', '${data[0].projeto}', '${data[0].numOS}', '${data[0].num_doc}');ShowPageLoading();"><i class="mr-1 icofont-ui-calendar"></i>Reagendar</a>
                        </div>
                </div>

                <div class="row" id="">
                        <div class="col-sm">
                        <label for="iMatricula_Nome"><small><b>@RsCadastros.TECNICO:<b> </small></label><br>
                        <select id="iMatricula_Id"></select>
                        </div>

                        <div class="col-sm">
                        </br>
                        <a id ='AlterarCampo' style='color:#fff;' val='definir' onclick="alteraCampo();EnableSelect('iMatricula_Id')" class='mt-1 btn btn-primary'><i class='mr-2 icofont-refresh'></i>@RsCadastros.TROCAR_RESPONSAVEL_OS</a>
                        </div>

                </div>

                            <div>
                            <hr size="5" width="auto">
                            </div>
                            `);

                                    EventMatricula()
                                    AddSelect('iMatricula_Id', '@CONSTANTES.URLPortal/api/EquipeApi/GetComboNumFre', @CONSTANTES.PaginacaoRegistros, null, null, data[0].tecnico, '@RsBase.SELECIONE', true, null);
                                    AddSelect("iPeriodo", "@CONSTANTES.URLPortal/api/PeriodoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, data[0].turno, "@RsBase.SELECIONE", null, null);
                                    //DATEPICKER
                                    $("#idataAgendamento").mask("00/00/0000");
                                    $("#idataAgendamento")
                                        .datepicker({
                                            format: "dd/mm/yyyy",
                                            language: "pt-BR",
                                            todayHighlight: "true",
                                            autoclose: true
                                        })
                                        .on("changeDate", function (e) {
                                            if ($(this).val().length === 10) return $(this).trigger("focusout");
                                            else return true;
                                        })
                                        .after(function () {
                                            var nameLink = `${$(this)[0].id}_dp`;

                                            return $(this).is(".readonly") || $(this).prop("readonly")
                                                ? $(
                                                    `<i id='${nameLink}' class='far fa-calendar-alt fs-15 color-icon-date pl-1 pr-1'></i>`
                                                )
                                                : $(
                                                    `<a id='${nameLink}' href='javascript: void(0);' class='pl-1 pr-1'><i class='far fa-calendar-alt fs-15 color-icon-date'></i></a>`
                                                ).click(function () {
                                                    $(this)
                                                        .prev()
                                                        .datepicker("show");
                                                });
                                        });

                                    var maskHora = function (val) {
                                        val = val.split(":");
                                        return parseInt(val[0]) > 19 ? "HZ:M0" : "H0:M0";
                                    };

                                    pattern = {
                                        onKeyPress: function (val, e, field, options) {
                                            field.mask(maskHora.apply({}, arguments), options);
                                        },
                                        translation: {
                                            H: { pattern: /[0-2]/, optional: false },
                                            Z: { pattern: /[0-3]/, optional: false },
                                            M: { pattern: /[0-5]/, optional: false }
                                        }
                                    };

                                    $("#ihoraAgendamento").mask(maskHora, pattern);
                                    HidePageLoading();
                                }
                                else
                                {
                                    Notificar("@RsBase.ATENCAO_", retorno.mensagem, "warning");
                                }
                            });

                    }
                });
        }


