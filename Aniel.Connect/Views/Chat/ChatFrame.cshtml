    <script>

        //<!--ENVIA AS MENSAGENS DO CHAT-->
        async function sendMessage() {
            const datetime = moment().format("DD/MM/YYYY HH:mm:ss");
            var numOs = $('#id_numOs').val();
            let id_mensagem = create_UUID();

            //MONTA A ESTRUTURA DE USUÁRIO
            const usuario = ({
                nome: "@Model.Usuario",
                num_fre: "@User.Identity.GetUserId()",
                ativo: true,
                tipo_usuario: $('#tipoUsuario').val(),
            });

            //MONSTA A ESTRUTURA DE ANEXO
            let anexo = null;
            let obj = $('#iArquivoChat')[0];

            if (obj.files.length > 0) {

                let fileid = create_UUID();

                //valida o tipo
                var nomeFiles = obj.files[0].name;
                var tipo = 0;
                var extensoesPermitidasImagem = /(.jpeg|.jpg|.gif|.png|.bmp|.tiff)$/i;
                var extensoesPermitidasVideo = /(.mpeg|.mp4|.quicktime|.webm|.3gpp|.3gpp2|.3gpp-tt|.H261|.H263-1998|.H263-2000|.H264)$/i;
                var extensoesPermitidasAudio = /(.L24|.mp3|.mpeg|.ogg|.vnd.rn-realaudio|.vnd.wave|.3gpp|.3gpp2|.ac3|.webm|.amr-nb|.amr|.snd|.au)$/i;
                var extensoesPermitidasArquivo = /(.vcard|.pdf|.directory|.calendar|.richtext|.rtf|.x-vcard|.doc|.docx)$/i;

                if (extensoesPermitidasImagem.exec(nomeFiles)) {
                    tipo = 0;
                } else if (extensoesPermitidasVideo.exec(nomeFiles)) {
                    tipo = 1;
                } else if (extensoesPermitidasAudio.exec(nomeFiles)) {
                    tipo = 2;
                } else if (extensoesPermitidasArquivo.exec(nomeFiles)) {
                    tipo = 3;
                }

                //Busca o MimeType do aquivo
                var nome = nomeFiles.split(".");
                anexo = ({
                    name: id_mensagem,
                    url: null,
                    MimeType: obj.files[0].type,
                    fileExtension: nomeFiles.substring(nomeFiles.indexOf(".") + 1),
                    arquivoBytes: null,
                    tipo: tipo,
                });
            }

            //MONTA O OBJETO MENSAGEM
            const message = {
                id: id_mensagem,
                mensagem: $('#inlineFormInputGroupUsername2').val(),
                /*dataHora: datetime,*/ // campo datetime no backend , da erro de conversao
                dataHoraString: datetime,
                num_os: numOs,
                statusEnvio: 1,
                usuario: usuario,
                anexo: anexo
            };


            ////Caso exista anexo, envia mensagem pelo enviar Mensagem Anexo
            if (anexo != null) {

                var data = new FormData();
                data.append("UploadedImage", obj.files[0]);
                data.append("id", id_mensagem);

                var link = `@CONSTANTES.URLPortal/api/ChatApi/AdicionarAnexoChatConnect?m=${JSON.stringify(message)}`;

                //Envia para o servidor
                $.ajax({
                    url: link,
                    type: 'POST',
                    contentType: false,
                    processData: false,
                    data: data

                }).done(function (data) {
                    if (data.valor.anexo.url != null) {
                        message.anexo.url = data.valor.anexo.url;
                    }
                    message.anexo.isUrl = data.valor.anexo.isUrl;
                    let sucesso = parent.parent.chatback.server.enviarMensagemAnexo(numOs, id_mensagem);
                    renderMessage(message.mensagem, message.dataHora, message.usuario, 'enviado', null, message.anexo, message);
                });
            } else {
                let sucesso = parent.parent.chatback.server.enviarMensagem(numOs, JSON.stringify(message))
                renderMessage(message.mensagem, message.dataHora, message.usuario, 'enviado', null, message.anexo, message);
            }

            $('#inlineFormInputGroupUsername2').val("")
            animateMessageScroll();

            //limpa os anexos
            limparAnexo();
        }

        $(document).ready(async function () {
            $('#tipoUsuario').val('@Html.Raw(ViewBag.tipoUsuario)');
            carregaDivDadosOS('@Html.Raw(Model.Cod_ct)', '@Html.Raw(Model.Projeto)','@Html.Raw(Model.Num_Obra)', '@Html.Raw(Model.Num_doc)');
            carregaHistorico('@Html.Raw(Model.Num_Obra)');

            @*parent.parent.chatback.client.mensagemResposta = (mensagem) => {
                if (mensagem.usuario.num_fre != "@User.Identity.GetUserId()") {
                    $('#chatFrame').contentWindow.renderMessage(mensagem.mensagem, mensagem.dataHora, mensagem.usuario, 'enviado', null, mensagem.anexo, mensagem)
                }
            }*@
        });

        function carregaDivDadosOS(codct, projeto, numOs, num_doc) {
            //Verifica se OS possui equipe vinculada
            $.ajax({

                url: `@CONSTANTES.URLPortal/api/Gestao_Equipeapi/GetParticipantes?codct=${codct}&proj=${projeto}&Num_OS=${numOs}&numDoc=${num_doc}`,
                type: "POST",
            })
                .done(function (data) {
                    if (data.length == 0) {
                        Notificar("@RsBase.ATENCAO_", `Não há monitores, técnicos ou supervisores vinculados a OS/Obra nº ${numOs}`, "warning");
                    } else {

                        $.ajax({

                            url: `@CONSTANTES.URLPortal/api/ChatApi/GetDadosOS?numOS=${numOs}`,
                            type: "POST",
                        })
                            .done(function (retorno) {

                                if (retorno.ok) {
                                    let data = retorno.objeto;
                                    //Caso o usuario esteja inativo, bloqueia o envio de mensagens
                                    if (data[0].usuario_ativo == false) {
                                        $('#bloqueiaMensagem').val(true);
                                    }

                                    $('#tipoUsuario').val(data[0].tipo_usuario);
                                    $('#Nome_Func').val("@Model.Usuario");

                                    $("#envio_mensagem").show();
                                }
                                else
                                {
                                    Notificar("@RsBase.ATENCAO_", retorno.mensagem, "warning");
                                }

                            });
                    }
                });
        }


        async function carregaHistorico(numOs) {
            $("#chatFrame").attr("data-pageid", `chatback${numOs}`);

            //Apaga as mensagens anteriores do frame
            $('#messages', $('#chatFrame').contents()).empty();

            $('#id_numOs').val(numOs);
            $('#num_fre').val("@User.Identity.GetUserId()");

            datetime = moment().format("DD/MM/YYYY HH:mm:ss");
            listaPromisesReady = [];
            usuarios = [];

            $(window).resize(function () {
                $("#Chat").css({
                    height: $(window).height() - $(window).height() / 6
                });
            });
            $('#divProgressChat').show();


            //Monta Objeto de servicoChat
            const servicoChat = {
                num_os: numOs,
                dataAbertura: datetime,
                usuarios: usuarios,
            };


            servicoChat.usuarios.push({
                num_fre: "@User.Identity.GetUserId()",
                nome: "@Model.Usuario",
            });

            let sucess = parent.parent.chatback.server.iniciarChat(servicoChat);

            var mensagens_string = parent.parent.getChatMessagesBackOffice(numOs, "@User.Identity.GetUserId()");

            listaPromisesReady.push(mensagens_string);

            mensagens_string.then(function (mensagensString) {

                //$('#messages', $('#chatFrame').contents()).empty();
                var mensagens = "";
                mensagens = Boolean(mensagensString) ? JSON.parse(mensagensString) : [];

                $('#chatFrame').on('load', function () {

                    $('#messages', $('#chatFrame').contents()).empty();
                    $('#divProgressChat').fadeOut();
                    for (message of mensagens) {

                        var tipoBalao = 'recebido';

                        if (message.statusEnvio == "3") {
                            tipoBalao = 'separador';
                        } else if (message.usuario.num_fre == "@User.Identity.GetUserId()") {
                            tipoBalao = 'enviado';
                        }

                        renderMessage(message.mensagem, message.dataHora, message.usuario, tipoBalao, null, message.anexo, message);
                    }
                    animateMessageScroll();
                });


                $("#chatFrame").attr("src", "@Url.Action("Chat_iFrame", "Chat")");


                $("#Chat").css({
                    height: $(window).height() - $(window).height() / 6
                });

            });
        }

        function renderMessage(message, datetime, usuario, tipoBalao, dadosSeparador, arquivos, objetoMensagem) {

            var tipo_usuario = retornaUsuario(usuario.tipo_usuario);

            if (datetime != null) {
                datetime = moment(datetime).format("DD/MM/YYYY HH:mm:ss");
            } else {
                datetime = moment().format("DD/MM/YYYY HH:mm:ss");
            }
            $('#divSeparador', $('#chatFrame').contents()).html("");

            let divArquivo = "";
            var vazio = "";
            let IdArquivo = create_UUID();

            if (arquivos != null) {
                if (arquivos.isUrl == true) {
                    divArquivo += (`<div id="${IdArquivo}" style="margin-top: 5px;"><a class="tag  mr-1 ml-1 text-truncate" href="${arquivos.url} "target="_blank"><i class="fas fa-paperclip"></i> ${arquivos.name}.${arquivos.fileExtension}</a></div>`);
                } else {
                    divArquivo += (`<div id="${IdArquivo}" style="margin-top: 5px;"><a id="arquivosMensagem" class="tag  mr-1 ml-1 text-truncate" onClick="downloadImagem('${objetoMensagem.num_os}', '${objetoMensagem.id}', '${arquivos.name}', '${arquivos.fileExtension}')"><i class="fas fa-paperclip"></i> ${arquivos.name}.${arquivos.fileExtension}</a></div>`);
                }
            }

            if (tipoBalao == 'enviado') {
                $('#messages', $('#chatFrame').contents()).html($('#messages', $('#chatFrame').contents()).html() +

                    `<div class="row justify-content-end">
                    <div class="card mb-3 mt-3" style="width:50%; border-radius: 1rem;">
                        <div style="border-radius: 1rem;" class="card-body alert-info text-left">
                           <div class="row" style="font-size: 14px;">
                              <div class="col text-capitalize text-truncate">
                                <i class='icofont-ui-head-phone'></i><small> ${tipo_usuario} </small><strong style='text-transform: capitalize !important;'> ${usuario.num_fre} - ${usuario.nome} </strong>
                              </div>
                            <div class="col text-right">
                                <span class="ml-5"><small>${datetime}</small></span>
                            </div>
                          </div>
                          <hr style="margin-top: 5px;margin-bottom: 5px; background-color: #000;">
                          <div class="row" style="font-size: 14px;">
                              <div class="col" style="white-space:pre-line">
                                   ${message == null ? '' : message}
                              </div>
                          </div>
                    </div>
                       ${divArquivo}
                </div>
                `);

            } else if (tipoBalao == 'recebido') {

                $('#messages', $('#chatFrame').contents()).html($('#messages', $('#chatFrame').contents()).html() +

                    `<div class="row justify-content-start">
                    <div class="card mb-3 mt-3" style="width:50%; border-radius: 1rem;">
                        <div style="border-radius: 1rem;" class="card-body alert-secondary text-left">
                           <div class="row" style="font-size: 14px;">
                              <div class="col text-capitalize text-truncate">
                                <i class='icofont-ui-head-phone'></i><small> ${tipo_usuario}</small><strong style='text-transform: capitalize !important;'> ${usuario.num_fre} - ${usuario.nome} </strong>
                              </div>
                            <div class="col text-right">
                                <span class="ml-5"><small>${datetime}</small></span>
                            </div>
                          </div>
                          <hr style="margin-top: 5px;margin-bottom: 5px; background-color: #d7e1f7;">
                          <div class="row" style="font-size: 14px;">
                              <div class="col" style="white-space:pre-line">
                                   ${message == null ? '' : message}
                              </div>
                          </div>
                    </div>
                        ${divArquivo}
                </div>
                `);
            } else if (tipoBalao == 'separador') {
                $('#messages', $('#chatFrame').contents()).html($('#messages', $('#chatFrame').contents()).html() +
                    `<div id="divSeparador" class="center separador" style="text-align: center;
                        border-radius: 10px;
                        align-items: center;
                        font-size: x-small;
                        background-color: #0000008f;
                        color: white;
                        border: white;
                        border-style: solid;
                        border-width: thin;">
                        ${message == null ? '' : message}
                    </div>
                `);
            }
        }



    async function limparAnexo() {

        $('#anexosSelecionados').hide();
        $('#nameAnexo').val("");
        $('#iArquivoChat').val("");
        $('#preview').attr("src","");

        var oldInput = document.getElementById('iArquivoChat');
        var newInput = document.createElement('input');
        newInput.id = oldInput.id;
        newInput.type = oldInput.type;
        newInput.name = oldInput.name;
        newInput.size = oldInput.size;
        newInput.class = oldInput.class;
        oldInput.parentNode.replaceChild(newInput, oldInput);
        $(newInput).hide();
        document.getElementById("iArquivoChat").addEventListener("change", readImage, false);
    }

        function create_UUID() {
            var dt = new Date().getTime();
            var uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                var r = (dt + Math.random() * 16) % 16 | 0;
                dt = Math.floor(dt / 16);
                return (c == 'x' ? r : (r & 0x3 | 0x8)).toString(16);
            });
            return uuid;
        }


        function animateMessageScroll() {
            var log = $('#messages', $('#chatFrame').contents());
            log.animate({ scrollTop: log.prop('scrollHeight') }, 500);
        }

        function readImage() {

        var extensoesPermitidasImagem = /(.jpeg|.jpg|.gif|.png|.bmp|.tiff)$/i;
        var extensoesPermitidasVideo = /(.mpeg|.mp4|.quicktime|.webm|.3gpp|.3gpp2|.3gpp-tt|.H261|.H263-1998|.H263-2000|.H264)$/i;
        var extensoesPermitidasAudio = /(.L24|.mp3|.mpeg|.ogg|.vnd.rn-realaudio|.vnd.wave|.3gpp|.3gpp2|.ac3|.webm|.amr-nb|.amr|.snd|.au)$/i;
        var extensoesPermitidasArquivo = /(.vcard|.pdf|.directory|.calendar|.richtext|.rtf|.x-vcard|.doc|.docx|.xls|.xlx)$/i;

        if (this.files && this.files[0]) {
            var file = new FileReader();

            var patch = this.files[0].name;
            if (extensoesPermitidasImagem.exec(patch)) {
                file.onload = function (e) {
                    document.getElementById("preview").src = e.target.result;
                };
            } else if (extensoesPermitidasVideo.exec(patch)) {
                document.getElementById("preview").src = `@{@CONSTANTES.URLPortal}/Content/images/video.svg`;
            } else if (extensoesPermitidasAudio.exec(patch)) {
                document.getElementById("preview").src = `@{@CONSTANTES.URLPortal}/Content/images/audio.svg`;
            } else {
                document.getElementById("preview").src = `@{@CONSTANTES.URLPortal}/Content/images/file.svg`;
            }

            file.readAsDataURL(this.files[0]);
        }
        document.getElementById("anexosSelecionados").style.display = 'block';
        document.getElementById("nameAnexo").value = this.files[0].name;
    }

    document.getElementById("iArquivoChat").addEventListener("change", readImage, false);

    $.ajax({
        type: 'GET',
        url: `@CONSTANTES.URLPortal/api/IdentityUserapi/FindById?Id=${"@User.Identity.GetUserId()"}`,
        dataType: 'json'
    }).
        done(function (data) {
            Id_Responsavel_nome = data.objeto.desc_User;
        });

        function retornaUsuario(tipo_usuario) {
            var tipo = tipo_usuario;
            if (typeof tipo_usuario === "undefined" || tipo_usuario == 3) {
                tipo = "";
            } else {
                switch (tipo_usuario) {
                    case 0:
                        tipo = "TÉCNICO"
                        break;

                    case 1:
                        tipo = "SUPERVISOR"
                        break;

                    case 2:
                        tipo = "MONITOR"
                        break;
                }
            }
            return tipo;
        }

        function CreateGuid(datetime) {
            function _p8(s) {
                //substituir pela data/hora da mensagem
                var p = (Math.random().toString(16) + datetime).substr(2, 8);
                return s ? "-" + p.substr(0, 4) + "-" + p.substr(4, 4) : p;
            }
            return _p8() + _p8(true) + _p8(true) + _p8();
        }

        $('#inlineFormInputGroupUsername2').keyup(function (event) {
            if (event.keyCode === 13) {
                event.preventDefault();
                sendMessage()
            }
        })

    </script>

}

@using (Html.BeginForm("ChatFrame", "Chat", FormMethod.Post, htmlAttributes: new { enctype = "multipart/form-data", @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Num_Obra, new { @id = "id_numOs" })

    @Html.HiddenFor(model => model.Tipo_Usuario, new { @id = "tipoUsuario" })
    @Html.HiddenFor(model => model.bloqueiaMensagem, new { @id = "bloqueiaMensagem" })
    @Html.HiddenFor(model => model.Usuario, new { @id = "Nome_Func" })

    <div class="container-fluid">

        <!-- Tab Content Master-->
        <!--CHAT-->
        <div role="tabpanel" class="tab-pane active" id="iTabChat">

