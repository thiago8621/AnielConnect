@model IEnumerable<Aniel.Connect.Models.MotivoParalizacaoResponse>

@using Resources
@{
    ViewBag.Title = RsCadastros.MOTIVO_PARALIZACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>
    <!--Usando link para imprimir a página atual-->
    <script>

        var array = JSON.parse('@Html.Raw(Json.Encode(Model))');

        var oDatatable = $("#datatable").length && $("#datatable").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: array,
            paging: false,
            ordering: false,
            drawCallback: () => {
                ResizeTable('divTable');
            },
            columns: [
                {
                    data: "Hora",
                    title: "@RsCadastros.HORA"
                },
                {
                    data: "Data",
                    title: "@RsCadastros.DATA",
                },
                {
                    data: "MotivoParalizacao",
                    title: "@RsCadastros.MOTIVO_PARALIZACAO"
                },
                {
                    data: "Tecnico",
                    title: "@RsCadastros.FUNCIONARIO",
                }
            ]
        });
    </script>
}

<div id="divTitle" class="container-fluid pl-0">

    <div class="col-auto mr-auto pl-0">
        <h5 class="title-page"><i class="far fa-pause-circle"></i> @ViewBag.Title - @Request.Params["tecnico"]</h5>
    </div>

</div>
<div class="row ml-3 mt-2" style="font-size: 11px">
    Ordem de Serviço: @Request.Params["numObra"]
</div>
<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>



