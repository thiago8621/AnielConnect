@model Aniel.Connect.Models.Motivo_Suspensao_ContratualCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_MOTIVO_SUSPENSAO_CONTRATUAL;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    <link href="~/bin/Content/preloaderbar.css" media="none" onload="if(media!='all')media='all'" rel="stylesheet" />
}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script>
        function validaSubmit() {
            $("#divProgress").show();
            var erro = false;
            if (!$('#iMotivo').val()) {
                Notificar("@RsBase.ATENCAO_", '@RsCadastros.DESCRICAO_MOTIVO não informado!!', "warning");
                erro = true;
            }
            
            if ($('#iMotivoPara').val() == 0 || $('#iMotivoPara').val() == "" || $('#iMotivoPara').val() == null || $('#iMotivoPara').val() == undefined) {
                Notificar("@RsBase.ATENCAO_", '@RsCadastros.MOTIVO_PARA não informado!!', "warning");
                erro = true;
            }

            if (erro) {
                $("#divProgress").hide();
                return false;
            }

            $('#form').submit();
        }
    </script>
}

@using (Html.BeginForm("Cadastro", "Motivo_Suspensao_Contratual", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.Id)

<div style="padding:10px">
    <div class="card" style="border:none;">
        <div class="card-body">
            <div class="row">
                <div class="col main-title">
                    <h4 class="title-page"><i class="fas fa-window-close"></i> @ViewBag.Title</h4>
                    <nav aria-label="breadcrumb" class="mb-20">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index", "Motivo_Suspensao_Contratual")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAMOTIVO_SUSPENSAO_CONTRATUAL</a>
                            </li>
                            <li class="breadcrumb-item">
                                <span>@ViewBag.Title</span>
                            </li>
                        </ol>
                    </nav>
                    <span style="font-size:11px" id="dtLegend"></span>
                </div>
            </div>

            <div class="card div-card-accord">
                <div class="card-header title-card" id="heading-1">
                    <h5 class="mb-0">
                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                            <span class="text-bold-card">@ViewBag.Title</span>
                        </a>
                    </h5>
                </div>
                <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                    <div class="card-body body-card-accord">

                        <div class="row">
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="iCodigo">@RsCadastros.CODIGO:</label>
                                    @Html.TextBoxFor(model => model.Id, new { @class = "form-control", @id = "iCodigo", @autocomplete = "off", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="col-sm-5">
                                <div class="form-group">
                                    <label for="iMotivo"><span class="text-danger">*</span>@RsCadastros.DESCRICAO_MOTIVO:</label>
                                    @Html.TextBoxFor(model => model.Motivo, new { @class = "form-control", @id = "iMotivo", @autocomplete = "off", @Maxlength = 300 })
                                    @Html.ValidationMessageFor(model => model.Motivo, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label for="iMotivo"><span class="text-danger">*</span>@RsCadastros.MOTIVO_PARA:</label>
                                    @Html.EnumDropDownListFor(model => model.Motivo_Para, RsBase.SELECIONE, new { @class = "form-control ", @id = "iMotivoPara" })
                                    @Html.ValidationMessageFor(model => model.Motivo_Para, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-sm-2">
                                @if (Model.Id != 0)
                                    {
                                <div class="form-group">
                                    <label class="mr-3">@RsFinanceiro.STATUS:</label><br>
                                    @Html.CheckBoxFor(model => model.Status, new { @class = "form-control", @id = "iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light", @readonly = "readonly" })
                                </div>
                                    }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Button Float-->
    <a href="@Url.Action("Index", "Motivo_Suspensao_Contratual")" class="float-cancel" onclick="ShowPageLoading(); return true;">
        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
            <i class="fas fa-times fa-2x"></i>
        </div>
    </a>

    <a href="#" class="float-save" onclick="return validaSubmit();" name="gravar">
        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
            <i class="fas fa-save fa-2x"></i>
        </div>
    </a>
</div>
}

<div class="overlay" id="divProgress" style="display:none;">
    <div class="preloaderbar show active">
        <span class="bar"></span>
        <span class="text">@RsCadastros.PROCESSANDO ...</span>
    </div>
</div>