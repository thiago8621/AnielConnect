@model Aniel.Connect.Models.Script_SuporteTecnicoCadastroModel

@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado

@{
    ViewBag.Title = RsCadastros.CADASTRO_SCRIPT_SUPORTETECNICO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{

}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion,"~/bundles/jsDataTableSimples")

    @if (Model.Id == 0)
    {
        <script>
            $("#iStatus").prop("checked", true).change();;
        </script>
    }

    <script>
        var handleDataTableButtons = function () {
            "use strict";            

            var array = @Html.Raw(Json.Encode(Model.Perguntas));

            var nome_lista = "Perguntas";//Nome_utilizado para enganar o razor

            var tipos_resposta = @(Html.GetArrayEnum<Script_Tipo_Resposta>());

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                paging: false,
                columns: [
                    {
                        data: "Id",
                        orderable: false,
                        render: function (data, type, row, meta) {
                            var retorno = '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                          ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                            if (meta.row != 0) {
                                retorno = retorno + '<a href="#" class="btnUp" id="btnUp_' + meta.row + '" valor="' + row.Informacao + '"><i class="fas fa-arrow-up" style="font-size:16px;;padding-right:2px;"></i></a>';
                            }

                            if (meta.row != (array.length - 1)) {
                                retorno = retorno + '<a href="#" class="btnDown" id="btnDown_' + meta.row + '" valor="' + row.Informacao + '"><i class="fas fa-arrow-down" style="font-size:16px;;padding-right:2px;"></i></a>';
                            }

                            return retorno;
                        }
                    },
                    {
                        data: "Informacao",
                        orderable: false,
                        title: "@RsCadastros.PERGUNTA_INFORMACAO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Informacao" name="' + nome_lista + '[' + meta.row + '].Informacao" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                            AtualizarOrdem();
                        }
                    },
                    {
                        data: "Ordem",
                        orderable: false,
                        title: "@RsCadastros.ORDEM",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + 'º <input id="' + nome_lista + '_' + meta.row + '__Ordem" name="' + nome_lista + '[' + meta.row + '].Ordem" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                            AtualizarOrdem();
                        }
                    }
                ]
            });

             function handleExcluir() {
                $(".btnExcluir").unbind('click');
                $(".btnExcluir").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatable.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Script_SuporteTecnicoApi/ExcluirGrid?value=")' + idArquivo;

                         $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatable.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });

                $(".btnUp").unbind('click');
                $(".btnUp").click(function (e) {
                    e.preventDefault();

                    var trLinkButton = $(this).parents('tr');
                    moveRow(oDatatable, trLinkButton, 'up');

                    handleExcluir();

                    AtualizarOrdem();
                });

                $(".btnDown").unbind('click');
                $(".btnDown").click(function (e) {
                    e.preventDefault();

                    var trLinkButton = $(this).parents('tr');
                    moveRow(oDatatable, trLinkButton, 'down');

                    handleExcluir();

                    AtualizarOrdem();
                });
            }

            handleExcluir();

            $("#btnAdicionar").on('click', function () {

                var erro = false;
                if (!$("#iInformacao").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.INFORMACAO)", "warning");
                    erro = true;
                }

                if (erro) {
                    return false;
                }

                oDatatable.row.add({
                    Id: 0,
                    Ordem: 0,
                    Informacao: $("#iInformacao").val()
                }).draw(false);

                AtualizarOrdem();

                $("#iInformacao").val("");
                $("#iInformacao").focus();

                handleExcluir();
            });


        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

        function AtualizarOrdem() {
            $.each($('#datatable tr td:nth-child(3)'), function (index, val) {
                    var ordem = index + 1;
                    $(this).html(ordem + "º"+ '<input id="Perguntas_' + index + '__Ordem" name="Perguntas[' + index + '].Ordem" type="hidden" value="' + ordem + '">');
                });
        }

        $(document).ready(function () {

            if ($("#iStatus").parent().hasClass("toggle btn btn-light off")) {
                $("#iStatus").parent().toggleClass("toggle btn btn-light off toggle btn btn-success");
            }
            else if ($("#iStatus").parent().hasClass("toggle btn btn-light off")) {
            }

        });

        var ultimaDivReposta = 0;

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;

            @*var erro = false;
            if (!$("#iTitulo").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TITULO)", "warning");
                erro = true;
            }
            if (iArquivo.files.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ARQUIVO)", "warning");
                erro = true;
            }
            if (erro) {
                return false;
            }*@
            ShowPageLoading();
            $('#form').submit();
        }



    </script>
}


@using (Html.BeginForm("Cadastro", "Script_SuporteTecnico", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-code"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a></li>
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Script_SuporteTecnico")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELSCRIPT_SUPORTETECNICO</a></li>
                                <li class="breadcrumb-item"><span>@ViewBag.Title</span></li>
                            </ol>
                        </nav>
                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>
                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@ViewBag.Title</span>
                            </a>
                        </h5>
                    </div>

                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="row">
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label for="iNome">@RsCadastros.PERGUNTA_INFORMACAO:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iNome", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                @if (Model.Id != 0)
                                {
                                    <div class="col-sm-4">
                                        <div class="form-group">

                                            <label for="iStatus" class="mr-3">@RsCadastros.STATUS:</label>
                                            <div class="form-group">
                                                @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                            </div>

                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>


                <div class="row mt-2 mb-2">
                    <div id="accordion" class="col-sm-6">
                        <div class="card div-card-accord">
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <div class="form-group">
                                                <label for="iPergunta">@RsCadastros.INFORMACAO:</label>
                                                @Html.TextAreaFor(model => model.Informacao, new { @class = "form-control", @id = "iInformacao", @autocomplete = "off", @required = true, @rows = "4" })
                                                @Html.ValidationMessageFor(model => model.Informacao, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-sm-12 text-right mt-3">
                                            <input type="button" id="btnAdicionar" value="Adicionar" class="btn btn-success" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div id="accordion" class="col-sm-6">
                        <div class="card div-card-accord">
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body">

                                    <table class="table table-hover nowrap" id="datatable" style="width:100%">
                                        <thead class="tb-head">

                                        </thead>
                                    </table>

                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Script_SuporteTecnico")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>

    </div>

}