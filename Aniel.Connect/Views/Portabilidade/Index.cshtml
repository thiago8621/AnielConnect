@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

        const ufs = @(Html.GetArrayEnum<UF>());
        const status_Portabilidade_val = @(Html.GetArrayEnum<Status_Portabilidade>());

        var rows_selected = [];
        var handleDataTableButtons = function () {

            "use strict";

    $(document).ready(function () {
    @*AddSelect("iDid", "@CONSTANTES.URLPortal/api", "@CONSTANTES.PaginacaoRegistros", null, null, null,@RsBase.SELECIONE, false);
        AddSelect("iSituacao", "@CONSTANTES.URLPortal/api", "@CONSTANTES.PaginacaoRegistros", null, null, null,@RsBase.SELECIONE, false);*@

        AddSelect("iCliente", "@CONSTANTES.URLPortal/api/clienteapi/GetCombo", "@CONSTANTES.PaginacaoRegistros", null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iNumeroCircuito", "@CONSTANTES.URLPortal/api/CircuitoTelefoniaApi/GetComboSIP", "@CONSTANTES.PaginacaoRegistros", null, null, null, "@RsBase.SELECIONE", false);
    });
    const urlApi = "@CONSTANTES.URLPortal/api/PortabilidadeApi/GetAll";
    var oDatatable = $("#datatable").length && $("#datatable").DataTable({
        dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
        columnDefs: [
            {
                targets: 0,
                searchable: false,
                orderable: false,
                width: '1%',
                className: 'dt-body-center',
                render: function (data, type, full, meta) {
                    return "<input type='checkbox'></input>";
                }
            }
        ],
        select: {
            style: 'multi'
        },
    order: [[1, 'asc']],
    serverSide: true,
    searching: true,
    ordering: true,
    paging: true,
    deferRender: true,
    scrollY: '73vh',
    scroller: {
    loadingIndicator: true,
    rowHeight: 40,
    boundaryScale: 0.5,
    displayBuffer: 3
    },
    stateSave: true,
    scrollX: true,
    fixedHeader: true,
    initComplete: dataTableInitComplete,
    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
    ajax: {
    url: urlApi,
    type: 'POST',
    data: function (data) {
    //var status = $("#iSituacao option:selected").val();
    //data.situacao = status;

    },
    error: function (e) {
    console.log(e);
    },
    dataSrc: function (d) {
    return d.data;
    }
    },
    rowId : "id",
    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

    var str = "@RsCadastros.INFODATATABLE";
    if (iTotal == 0) { iEnd = 0; iStart = 0; }
    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
    $("#dtLegend").html(str);

    return "";
    },
    pageLength: 10,
    language: traducaoDataTableSimples,
    buttons: buttonsDataTable,
    columns:
    [
    { title: "<input name='select_all' value='1' type='checkbox'>"},
    { data: "codigo", title: "@RsCadastros.CODIGO", orderable: false },
    { data: "did", title: "@RsCadastros.DID", orderable: false},
    { data: "uf", title: "@RsCadastros.UF", orderable: false},
    { data: "cidade", title: "@RsCadastros.CIDADE", orderable: false},
    { data: "cliente", title: "@RsCadastros.CLIENTE", orderable: false},
    { data: "numero_Circuito", title: "@RsCadastros.CIRCUITO.Replace("Circuito", "Numero do Circuito")", orderable: false},
    { data: "dia_Previsto_Portabilidade", title: "@RsCadastros.CADASTRO_PORTABILIDADE.Replace("Cadastro", "Dia Previsto")", orderable: false}
    /*{ title: "", render: function (data, type, row, meta) { return "<a href=''><i class='fas fa-trash'></i></a>"; }, orderable: false }*/
    ]

    });

    $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
    oDatatable.search($(this).val()).draw();
    });


    @*$("#btnInativar").on("click", function () {

            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            //Alterando para Inativo
            AlterarStatusObj(0);

        });

        $("#btnAtivar").on("click", function () {

             if (rows_selected.length == 0) {
                 Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                 return;
             }

             //Alterando para Inativo
             AlterarStatusObj(1);
        });*@

    // Handle table draw event




    oDatatable.on('draw', function () {
    rows_selected = [];
    });

    },

    TableManageButtons = function () {
    "use strict";
    return {
    init: function () {
    handleDataTableButtons();
    }
    }

    }();

    TableManageButtons.init();


        //status_Portabilidade;
        var status_portabilidade = status_Portabilidade_val.forEach(
            (value, index) => {
                $("#iSituacao").append($("<option></option>").attr("value", index).text(`${value}`));
            });


   $('#datatable tbody').on('click', 'tr', function () {
                @if (AcessoHelper.TemAcesso(_areas, "210"))
                {
                    <text>
                    if (oDatatable.row(this).data() != null) {

                        var _id = oDatatable.row(this).data().id;

                        var url = '@Url.Action("Cadastro", "Agente", new { id = "__id__" })';
                        window.location.href = url.replace('__id__', _id);
                        ShowPageLoading();
                    }
                    </text>
                }
   });
        $("#ExcluirPortabilidade").on("click", async function () {
              @if (AcessoHelper.TemAcesso(_areas, "211"))
              {<text>
            if (rows_selected == 0) {
                Notificar("@RsBase.ATENCAO_","@RsBase.NENHUMREGISTROSELECIONADO","warning")
                return false;
            }
            await excluir_Portabilidade(rows_selected);
            oDatatable.draw(false);

              </text>
                  }
              else
              {
                  <text> Notificar("@RsBase.ATENCAO_", "Sem Acesso", "warning");</text>
              }

        });

        async function excluir_Portabilidade(value) {
            var url = `${baseUrl}/api/PortabilidadeApiController/Excluir `
            $.post({
                url: url,
                data: value
            }).done(function (data) {
                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "Excluído Com Sucesso!", "info");
            }).fail(function (data) {
                Notificar("@RsBase.ATENCAO_", `${data.Mensagem}.`, "warning");
                });
    };

    function acessoCadastro() {
            @if (AcessoHelper.TemAcesso(_areas,"210"))
        {
            <text>
        ShowPageLoading();

        var url = "@Url.Action("Cadastro", "Portabilidade")";
        window.location.href = url;
        </text>

    } else { <text>Notificar("@RsBase.ATENCAO_", "Sem Acesso", "warning");</text> }

    }

    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-server"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Comercial")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.COMERCIAL</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

            @*<span style="font-size:11px" id="dtLegend"></span>*@
        </div>

        <div class="col-auto mb-3">
            <div class="row title-page">

                @*<div class="pl-4 pr-2 form-group">
                        <label for="iModelo">Modelo de Elemento de Rede:</label>
                        @Html.DropDownList("iModelo", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(),"Id","Descricao"),RsBase.SELECIONE, new {id="iModelo",@class="form-group",@autocomplete="off"});
                    </div>*@

                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="Procurar por Cliente/N. Circuito" autocomplete="off" style="width:200px;">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>

                <a class="btn btn-success btn-add" @*href="@Url.Action("Cadastro", "Portabilidade")"*@ title="@RsBase.INCLUIR" onclick="acessoCadastro(); return true;"><i class="la la-plus" style="color: #fff"></i></a>

                <button type="button" class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltros" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">


                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.LOG_ALTERACOES</a>
                    <a class="dropdown-item" href="#" onclick=" return false;" id="ExcluirPortabilidade">@RsBase.EXCLUIR.Insert(RsBase.EXCLUIR.Length, " Portabilidade")</a>

                </div>
            </div>
        </div>

    </div>
    <!--./main-->
</div>
<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>


<!--Modal Filters-->
<div class="modal" id="modal-filter">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12" style="align-content:center;">
                        <div class="row" style="align-content:center;">

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="iSituacao">@RsCadastros.CLIENTE</label>
                                    @Html.DropDownList("iCliente", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { Id = "iCliente", @class = "form-control", @placeholder = "Todos", @autocomplete = "off" })


                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="iSituacao">@RsCadastros.CIRCUITO.Replace("C", "Número do C")</label>
                                    @Html.DropDownList("iNumeroCircuito", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { Id = "iNumeroCircuito", @class = "form-control", @placeholder = "Todos", @autocomplete = "off" })


                                </div>
                            </div>
                        </div>
                        <div class="row" style="align-content:center;">

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="iSituacao">@RsCadastros.DID</label>
                                    @Html.DropDownList("iDid", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { Id = "iDid", @class = "form-control", @placeholder = "Todos", @autocomplete = "off" })


                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="iSituacao">@RsCadastros.STATUS</label>
                                    @Html.DropDownList("iSituacao", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.TODOS, new { Id = "iSituacao", @class = "form-control", @placeholder = "Todos", @autocomplete = "off" })


                                </div>
                            </div>

                        </div>

                        <div class="form-group col-sm-12" style="padding: 10px;">
                            <div class="text-center">
                                <button type="button" class="btn btn-danger limparFiltro" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                                <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    }
