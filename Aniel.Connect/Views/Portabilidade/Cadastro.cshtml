@{
    ViewBag.Title = RsCadastros.CADASTRO_PORTABILIDADE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

}


@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")

}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    <script src="~/bin/Scripts/connect.js"></script>

    <script>
        $("#iDid").mask("(00)00000-0000");
        async function mudancaUF(estado)  {


            var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + estado;

            $('#iCidade').empty();

            await $.getJSON(enderecoApi, function (data) {
                $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
                $.each(data, function (key, value) {
                    $('#iCidade').append($('<option></option>').attr('value', value.id).text(value.descricao));
                })

            });
        };


    function changeCountry() {
        var countryTxt = $('#iPais').text();
        var countryVal = $('#iPais').val();

        if (countryVal != null) {
            if (countryTxt.toUpperCase() == "BRASIL") {
                AddSelect("iUF", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUf", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.UF", "@RsBase.TODOS", false);
            } else {
                $('#iUF').val(null).trigger('change');
                $('#iUF').text("").trigger('change');
                $('#iUF').select2('destroy');
            };

        }
        else {
            $('#iUF').val(null).trigger('change');
            $('#iUF').text("").trigger('change');
            $('#iUF').select2('destroy');
            $('#iCidade').empty();
            $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
        };
    };

        $("#iUF").on("select2:select select2:unselecting", function (e) {
            if (e.params.data != undefined) {

                let UfSelecionado = e.params.data;
                mudancaUF(UfSelecionado.sigla);
            }
            else {
                $('#iCidade').empty();
                $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
            }

        });

        $("#iNumeroCircuito").on("select2:select select2:unselecting", function (e) {
            if (e.params.data != undefined) {

                let Circuito = e.params.data;

                $("#iNumeroSip").val(Circuito.text);
                AddSelect("iDidSub", "@CONSTANTES.URLPortal/api/CircuitoTelefoniaApi/GetComboDidVinculado", @CONSTANTES.PaginacaoRegistros, null, Circuito.id, null, "@RsBase.SELECIONE", false);
            }
            else {
                AddSelect("iDidSub", "@CONSTANTES.URLPortal/api/CircuitoTelefoniaApi/GetComboDidVinculado", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            }
        });


    $('#iPais').change(function () { changeCountry() });

        $(document).ready(function () {

            AddSelect("iTipo_Servico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null,"@RsBase.SELECIONE",false);
            AddSelect("iPais", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboPais",   @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            @*AddSelect("iUF", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUf",     @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);*@
            @*AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);*@
            AddSelect("iCliente", "@CONSTANTES.URLPortal/api/clienteapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iNumeroCircuito", "@CONSTANTES.URLPortal/api/CircuitoTelefoniaApi/GetComboSIP", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iDidSubstituido", "@CONSTANTES.URLPortal/api/CircuitoTelefoniaApi/GetComboDidVinculado", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        });

        @*$("#iUF").on("select2:select select2: unselecting", function (e) {
            let obj = e.params.data;

            AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades", @CONSTANTES.PaginacaoRegistros, null, obj.text, null, "@RsBase.SELECIONE", false);
        });*@


        function ValidaSubmit()
        {
            @*let erro = false;
            let clicked = false;
            let Did = $("#iDid").val();
            let numCircuit = $("#iNumeroCircuito").val();
            let diaPortabilidade = $("#iDiaPrevistoPortabilidade").val();

            if (clicked) {
                return false;
            }

            clicked = true;
            erro = false;


            if (Did == null) {
                Notificar("@RsBase.ERRO", "@RsCadastros.DID_INVALIDO", "warning");
                erro = true;
            }

            if (numCircuit == null) {
                Notificar("@RsBase.ERRO", "@RsCadastros.NUMERO_CIRCUITO @RsBase.INVALIDO", "warning");
                erro = true;
            }
            if (diaPortabilidade == null) {
                Notificar("@RsBase.ERRO", "@RsBase.DATA_INVALIDA", "warning");
                erro = true;
            }




	        if (erro) {
                clicked = false;
                return false;
            }*@

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

    </script>
}

