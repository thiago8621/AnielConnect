@model Aniel.Connect.Models.ProdutosComp_CadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_PRODUTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script>

        var HandleNCM = function () {
            $('#iCodigoNCM').unbind('select2:select select2:unselecting');
            $('#iCodigoNCM').on('select2:select select2:unselecting', function (e) {

                NCMSelecionado = e.params.data
                if (NCMSelecionado) {
                    $("#iCodigoCEST").val(NCMSelecionado.codigo_CEST)
                }
                else {
                    $("#iCodigoCEST").val(null)
                }
            });
        };

        $(document).ready(function () {
            $('[data-toggle="tooltip"]').tooltip();
            AddSelect("iCodigoNCM", "@CONSTANTES.URLPortal/api/ProdutosCompApi/GetComboNCM", @CONSTANTES.PaginacaoRegistros, null, "@Model.Codigo_CEST", "@Model.Codigo_NCM", "@RsBase.SELECIONE", false, HandleNCM);
        });

        var clicked = false;

        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            erro = false;
            clicked = true;

            if ($("#iDescricao").val() == "" || $("#iDescricao").val() == null || $("#iDescricao").val() == undefined) {
                Notificar("@RsBase.ATENCAO_", "Descrição do produto é obrigatório!!", "warning");
                erro = true;
            }

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }
    </script>
}

@using (Html.BeginForm("Cadastro", "ProdutosComp", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-globe-americas"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "ProdutosComp")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_PRODUTOS</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>
                    </div>
                </div>

                <div class="accordion" id="accordion_4">
                    <div class="card div-card-accord mb-3">
                        <div class="card-header title-card" id="heading_4">
                            <h5 class="mb-0">
                                <a role="button" data-toggle="collapse" data-target="#collapse_4" aria-expanded="true" aria-controls="collapse_4">
                                    <span class="text-bold-card">@RsCadastros.CADASTRO_PRODUTO</span>
                                </a>
                            </h5>
                        </div>

                        <div class="card-body body-card-accord">
                            <div class="row align-items-end">
                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iCodigo">@RsCadastros.CODIGO:</label>
                                        @Html.TextBoxFor(model => model.Id, new { @class = "form-control", @id = "iCodigo", @autocomplete = "off", @required = true, @readonly = "readonly" })
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iCodigo_NCM">@RsCadastros.DESCRICAO:<span class="text-danger font-weight-bold"> *</span></label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off", @required = true })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Id))
                                {
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label for="iCodigoNCM">
                                                @RsCadastros.CODIGO_NCM:
                                                <i class="fas fa-info-circle text-primary" data-toggle="tooltip" data-placement="top"
                                                   title="NCM: Nomenclatura Comum do Mercosul.<br>CEST: Código Especificado da Substituição Tributária.<br>Esse campo é de preenchimento obrigatório se o produto for utilizado na emissão de Nota Fiscal modelo 55."
                                                   data-html="true"></i>
                                            </label>
                                            @Html.DropDownListFor(model => model.Codigo_NCM, new List<SelectListItem>(), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iCodigoNCM", @autocomplete = "off" })
                                            @Html.HiddenFor(model => model.Codigo_CEST, new { @class = "form-control", @id = "iCodigoCEST" })
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iStatus">@RsFinanceiro.STATUS:</label><br />
                                            @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = RsCadastros.ATIVO, @data_off = RsCadastros.INATIVO, @data_onstyle = "success", @data_offstyle = "light", @disabled = "disabled" })
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!--Button Float-->
        <a href="@Url.Action("Index", "ProdutosComp")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}