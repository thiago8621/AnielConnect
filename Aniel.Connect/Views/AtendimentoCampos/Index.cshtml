@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@model Aniel.Connect.Models.Categoria_ClienteCadastroModel

@{
    ViewBag.Title = RsCadastros.LISTAGEM_CAMPOS_PERS_ATT;
    ViewBag.Sessao = RsCadastros.LISTAGEM_CAMPOS_PERS_ATT;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <script>
        var rows_selected = [];
        const acessoAlt = Boolean(@Convert.ToInt32(AcessoHelper.TemAcesso(_areas,"417")));
        $(document).ready(async () => {
            await AddSelectMulti("iTipoAtendimento", "@CONSTANTES.URLPortal/api/Tipo_Atendimentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, null,null,null,null,null, 4);
        });

        var handleDataTableButtons = function () {
            "use strict";

            function AlterarStatusObj(Status) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/AtendimentoCamposApi/AlterarStatus")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected,
                        status: Status
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });

                rows_selected = [];
            }


            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + "/api/AtendimentoCamposApi/GetAll",
                    type: 'POST',
                    data: function (data) {
                        data.TipoCampo = $("#iTipoCampo option:selected").val();
                        data.CampoObrigatorio = $("#iCampoObrigatorio option:selected").val();
                        data.Status = $("#iStatus option:selected").val();
                        data.IdsTipoAtendimento = $("#iTipoAtendimento").val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iTotal).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                destroy: true,
                columns: [
                    {   title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "id", title: "@RsCadastros.CODIGO" },
                    { data: "titulo", title: "@RsCadastros.TITULO" },
                    { data: "tipoCampoGravarString", title: "Tipo de Campo" },
                    {
                        data: "campoObrigatorio", title: "Campo Obrigatório?", render: function (data) {
                            if (data == true) {
                                return "Sim";
                            }
                            else {
                                return "Não"
                            }
                        }
                    },
                    {
                        data: "status", title: "@RsCadastros.STATUS", render: function (data) {
                            if (data == true) {
                                return "Ativo";
                            }
                            else {
                                return "Inativo"
                            }
                        }
                    }
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });


            $("#btnInativar").on("click", function () {                                                
                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);

            });

            $("#btnAtivar").on("click", function () {               
                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });


            $("#btnExcluir").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Categoria_Clienteapi/excluirlista")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    });

                rows_selected = [];

            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function () {

                if (!acessoAlt) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NAO_POSSUI_AREA_ACESSO", "warning")
                    return;
                }
                if (oDatatable.row(this).data() != null) {

                    var _id = oDatatable.row(this).data().id;

                    var url = '@Url.Action("Cadastro", "AtendimentoCampos", new { id = "__id__" })';
                    window.location.href = url.replace('__id__', _id);
                    ShowPageLoading();
                }
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

        $("#iCriarNovosCampos").on("click", function () {
             AddAba('@Url.Action("Cadastro", "AtendimentoCampos")?Id=0', '@Html.Raw("Cadastro de Campo Personalizado ")');
        });

        $("#iLimparFiltroModal").unbind("click");
        $("#iLimparFiltroModal").on("click", function () {
            LimparFiltros();

            if ($.fn.DataTable.isDataTable("#datatable")) {
                $("#datatable").DataTable().clear().destroy();
                TableManageButtons.init();
            }
            else {
                TableManageButtons.init();
            }
        });

        $("#iLimparFiltros").unbind("click");
        $("#iLimparFiltros").on("click", function () {
            LimparFiltros();

            if ($.fn.DataTable.isDataTable("#datatable")) {
                $("#datatable").DataTable().clear().destroy();
                TableManageButtons.init();
            }
            else {
                TableManageButtons.init();
            }
        });

        function LimparFiltros() {
            $("#iTipoAtendimento").val("").trigger('change');
            $("#iStatus").val("").trigger('change');
            $("#iTipoCampo").val("99").trigger('change');
            $("#iCampoObrigatorio").val("").trigger('change');
        }

        function PesquisarTrocas() {

            $("#iModalFiltros").modal('hide');

            if ($.fn.DataTable.isDataTable("#datatable")) {
                $("#datatable").DataTable().clear().destroy();
                TableManageButtons.init();
            }
            else {
                TableManageButtons.init();
            }
        }

        $("#btnLogAlteracoes").on("click", function () {
            AddAba(`@Url.Action("HistoricoAlteracoesCampos", "AtendimentoCampos")`, '@Html.Raw("Cadastro de Campo Personalizado ")');
        });
    </script>
}



<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-sliders-h"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>

                </ol>
            </nav>

            @*<span style="font-size:11px" id="dtLegend"></span>*@
        </div>


        <div class="col-auto">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.DESCRICAO" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>

                @if (AcessoHelper.TemAcesso(_areas, "416"))
                {
                    <text>
                        <div>
                            <button class="btn btn-success btn-add" type="button" title="Incluir" id="iCriarNovosCampos" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="la la-plus"></i>
                            </button>
                        </div>
                    </text>
                }


                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#iModalFiltros" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltros" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;">@RsBase.EXPORTARPDF</a>

                    @if (AcessoHelper.TemAcesso(_areas, "418"))
                    {
                        <a class="dropdown-item" id="btnInativar" href="#" onclick="return false;">@RsBase.INATIVAR</a>
                        <a class="dropdown-item" id="btnAtivar" href="#" onclick="return false;">@RsBase.ATIVAR</a>
                    }

                    <a class="dropdown-item" id="btnLogAlteracoes" href="#" onclick="return false;">Log de Alterações</a>
                </div>
            </div>
        </div>

    </div>
    <!--./main-->
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
        <thead class="tb-head">
        </thead>
    </table>
</div>

<div class="modal fade" id="iModalFiltros" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle"><b>Filtros</b></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row form-group">
                    <div class="col-sm-6">
                        <label><b>Tipo de Atendimento:</b></label>
                        <select id="iTipoAtendimento" multiple="multiple" class="form-control">
                            <option value="">@RsBase.SELECIONE</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label><b>Status:</b></label>
                        <select id="iStatus" class="form-control">
                            <option value="">@RsBase.TODOS</option>
                            <option value="1">Ativo</option>
                            <option value="0">Inativo</option>
                        </select>
                    </div>
                </div>
                <div class="row form-group pt-4 mt-4">
                    <div class="col-6">
                        <label><b>Tipo de Campo:</b></label>
                        <select id="iTipoCampo" class="form-control">                            
                            <option value="99">@RsBase.TODOS</option>
                            <option value="0">Texto</option>
                            <option value="1">Inteiro</option>
                            <option value="2">Numerico</option>
                            <option value="3">Única Escolha</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label><b>Campo Obrigatório?</b></label>
                        <select id="iCampoObrigatorio" class="form-control">                            
                            <option value="">@RsBase.TODOS</option>                            
                            <option value="1">Sim</option>
                            <option value="0">Não</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="justify-content:center">
                <button type="button" class="btn btn-danger" id="iLimparFiltroModal">Limpar Filtro</button>
                <button type="button" class="btn btn-success" id="iPesquisar" onclick="PesquisarTrocas();">Pesquisar</button>
            </div>
        </div>
    </div>
</div>