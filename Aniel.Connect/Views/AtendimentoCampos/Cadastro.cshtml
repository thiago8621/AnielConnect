@model Aniel.Connect.Models.AtendimentoCamposCadastroModels
@using Aniel.Connect.Models.T5
@using Aniel.Connect.Core.Helpers
@{
    ViewBag.Title = "Cadastro de Campo Personalizado";
    ViewBag.Session = "Cadastro de Campo Personalizado";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;

    string campoBloqueado = Model.Id != 0 ? "readonly" : "";
    string bloquearCampoEdicao = !AcessoHelper.TemAcesso(_areas, "417") ? "readonly" : "";
    int? tipoCampoGravar = (int?)Model.TipoCampoGravar;
    bool sucessoGravacao = Convert.ToBoolean(ViewBag.Sucesso);
}

@section scripts
{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
<script>
    var clicked = false;
    var rows_selected = [];
    var oDatatable;
    var oDatatableResposta;
    $(document).ready(async function () {

        await AddSelect("iTipoAtendimento", "@CONSTANTES.URLPortal/api/Tipo_Atendimentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        @if(Model.Id != 0)
        {
            <text>
                $("#iTipoCampo").val("@tipoCampoGravar");
            </text>
        }

        if ($("#iTipoCampo option:selected").val() != "3") {
            $(".divRespostaPersonalizada").hide();
            $("#divAdicionarResposta").hide();
        }
        else {
            $(".divRespostaPersonalizada").show();
            $("#divAdicionarResposta").show();
        }
        @if (sucessoGravacao) 
        {
        <text>
        Notificar("@RsBase.ATENCAO_", "Gravação realizada com sucesso", "info");
        </text>
        }
    });

    function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;

            if (!$("#iTitulo").val()) {
                Notificar("ATENÇÃO", "Informe o Titulo do Campo", "warning")
                clicked = false;
                return false;
            }

            let tipoCampo = $("#iTipoCampo option:selected").val();

            if (tipoCampo == "" || tipoCampo == null || tipoCampo == undefined) {
                Notificar("ATENÇÃO", "Informe o tipo de Campo", "warning")
                clicked = false;
                return false;
            }

            erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

    var handleDataTableButtons = function () {
            "use strict";
            var nome_lista = "AtendimentoCamposTiposModels";
            var arrayTipoAtendimento = @Html.Raw(Json.Encode(Model.AtendimentoCamposTiposModels));
             oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: arrayTipoAtendimento,
                paging: false,
                columnDefs: [{
                    targets: 0,
                    searchable: false,
                    orderable: false,
                    width: '80px'
               }],
               columns: [
                   {
                       data: "Id",
                       render: function (data, type, row, meta) {
                           return `<a href="#" class="btnExcluirTipo" id="btnExcluirTipo_${meta.row}" excluirTipo="${row.Id}"><i class="far fa-trash-alt" style="font-size:16px;padding-right:2px;"></i></a>` +
                                    ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                       },
                       orderable: false
                   },
                   {
                       data: "DescricaoTipo", title: "Tipo de Atendimento", orderable: false,
                       render: function (data, type, row, meta) {
                           if (type === 'display') {
                               data = TrataNulo(data) + ' <input id="' + nome_lista + '_' + meta.row + '__DescricaoTipo" name="' + nome_lista + '[' + meta.row + '].DescricaoTipo" type="hidden" value="' + TrataNulo(data) + '">';
                           }
                           return data;
                       }
                   },
                   {
                       data: "Id_Tipo_Atendimento", orderable: false, title: "Id - Tipo de Atendimento",
                       render: function (data, type, row, meta) {
                            return TrataNulo(data) + ' <input id="' + nome_lista + '_' + meta.row + '__Id_Tipo_Atendimento" name="' + nome_lista + '[' + meta.row + '].Id_Tipo_Atendimento" type="hidden" value="' + TrataNulo(data) + '">';
                       }
                   },
               ]
           });

            function handleExcluirTipo() {
                $('#datatable').on('click', '.btnExcluirTipo', function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluirTipo");
                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatable.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/AtendimentoCamposApi/ExcluirGridTipos?value=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                        .done(function (data) {

                                if (data.ok) {
                                    oDatatable.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                       }).fail(function () {}).always(function () {});}

                });
            }

            handleExcluirTipo();

    },
    TableManageButtons = function () {
        "use strict";
        return {
            init: function () {
                handleDataTableButtons();
            }
        }
    }();

    TableManageButtons.init();

    var handleDataTableButtonsResposta = function () {
            "use strict";

        var arrayRespostas = @Html.Raw(Json.Encode(Model.AtendimentoCamposRespostaPerso));
        var nome_lista = "AtendimentoCamposRespostaPerso";
        oDatatableResposta = $("#datatableRespostas").length && $("#datatableRespostas").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: arrayRespostas,
            paging: false,
            columnDefs: [{
                targets: 0,
                searchable: false,
                orderable: false,
                width: '80px'
            }],
            columns: [
                {
                    data: "Id",
                    render: function (data, type, row, meta) {

                        let link = data == "0" ?
                            `<a href="#" class="btnExcluir" id="btnExcluir_${meta.row}" excluirResp="${row.Id}"><i class="far fa-trash-alt" style="font-size:16px;padding-right:2px;"></i></a>` :
                            `<a href="#" class="btnEditar" id="btnEditar_${meta.row}" editarResp="${row.Id}"><i class="far fa-edit" style="font-size:16px;padding-right:2px;"></i></a>`;

                        return `${link} <input id="${nome_lista}_${meta.row}__Id" name="${nome_lista}[${meta.row}].Id" type="hidden" value="${TrataNulo(data)}">`;
                    },
                    orderable: false
                },
                {
                    data: "RespostaPersonalizada", title: "Respostas", orderable: false,
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = TrataNulo(data) + ' <input id="' + nome_lista + '_' + meta.row + '__RespostaPersonalizada" name="' + nome_lista + '[' + meta.row + '].RespostaPersonalizada" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                        return data;
                    }
                },
            ]
        });

        $(".btnEditar").unbind('click');
        $(".btnEditar").on('click', function () {
            let id = Number($(this).attr("editarResp"));
            let registroTabela = (oDatatableResposta.data().toArray().filter(function (param) { return param.Id == id}))[0];

            $("#iIdRespostaModal").val(registroTabela.Id);
            $("#iRespostaModal").val(registroTabela.RespostaPersonalizada);
            $("#modal-Editar").modal("show");
        });
        function handleExcluir() {
            $('#datatableRespostas').on('click', '.btnExcluir', function (e) {
                e.preventDefault();

                var idArquivo = $(this).attr("excluirResp");

                var trLinkButton = $(this).parents('tr');

                if (idArquivo === "0") {
                    oDatatableResposta.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
                else {

                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/AtendimentoCamposApi/ExcluirGridRespostas?value=")' + idArquivo;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',

                    })
                        .done(function (data) {

                            if (data.ok) {
                                oDatatableResposta.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                        .fail(function () {

                        })
                        .always(function () {

                        });
                }

            });
        }

        handleExcluir();

        },
            TableManageButtonsResposta = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtonsResposta();
                    }
                }
            }();

    TableManageButtonsResposta.init();

    $("#iExibirTodosAtt").on("change", function () {
        var exibirTodos = $("#iExibirTodosAtt").is(":checked");

        if (exibirTodos == true)
            $(".divSelecionarCampos").hide();
        else
            $(".divSelecionarCampos").show();
    });

    $("#iTipoCampo").on("change", function () {

        var tipoCampoSelecionado = $("#iTipoCampo option:selected").val();


        if (tipoCampoSelecionado == "0") {
            $(".divRespostaPersonalizada").hide();
            $("#iLegenda").empty();
            $("#iLegenda").text("O sistema aceita até 255 caracteres.");
        }
        else if (tipoCampoSelecionado == "1") {
            $(".divRespostaPersonalizada").hide();
            $("#iLegenda").empty();
            $("#iLegenda").text("O sistema permitirá até 10 números inteiros.");
        }
        else if (tipoCampoSelecionado == "2") {
            $(".divRespostaPersonalizada").hide();
            $("#iLegenda").empty();
            $("#iLegenda").text("O sistema aceitará números com casas decimais e não terá restrições de limite.");
        }
        else if (tipoCampoSelecionado == "3") {
            $("#iLegenda").empty();
            $(".divRespostaPersonalizada").show();
        }
    });

    $("#iAdicionarTipoAtendimento").on("click", function () {
        let [tipoSelecionado, textoTipo] = [$("#iTipoAtendimento option:selected").val(), $("#iTipoAtendimento option:selected").text()];

        if (tipoSelecionado == null ||
            tipoSelecionado == undefined ||
            tipoSelecionado == "") {
            Notificar("ATENÇÃO", "Selecione o Tipo de Atendimento", "warning")
            return false;
        }

        var novaLinha = {
            Id: 0,
            Id_Tipo_Atendimento: Number(tipoSelecionado),
            DescricaoTipo: textoTipo,
        };

        oDatatable.row.add(novaLinha).draw(false);
    });

    $("#iButtonAdcResposta").on("click", function () {

        var texto = $("#iRespostaPersonalizada").val();

        if (texto == null ||
            texto == undefined ||
            texto == "") {
            Notificar("ATENÇÃO", "Informe o texto a ser inserido", "warning")
            return false;
        }

        let erro = false;

        for (var i = 0; i < oDatatableResposta.rows().data().length; i++) {
            let resposta = `${oDatatableResposta.rows().data()[i].RespostaPersonalizada}`;
            if (resposta.toLowerCase() == texto.toLowerCase())
            {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, "Resposta Adicional")", "warning");
                erro = true;
                i = oDatatableResposta.rows().data().length;
            }
        }

        if (!erro)
        {
            var novaLinha = {
                Id: 0,
                RespostaPersonalizada: texto,
            };

            oDatatableResposta.row.add(novaLinha).draw(false);
        }
    });
    $("#iCancelarResposta").on("click", function () {
        $("#modal-Editar").modal("hide");
    })
    $("#iGravarResposta").on("click", async function () {
        if (!$("#iRespostaModal").val()) {
            Notificar("@RsBase.ATENCAO_", "Preencha a Opção de Resposta", "warning");
            return false;
        }

        let [id, resposta, link] = [$("#iIdRespostaModal").val(), $("#iRespostaModal").val(), "@CONSTANTES.URLPortal/api/AtendimentoCamposApi/GravarResposta"];
        let retorno = await $.ajax({
            url: link,
            data: { IdResposta: id, Descricao: resposta, IdAtendimentoCampo: @Model.Id},
            type: 'POST',
            dataType: 'json'

        });
        if (!retorno.ok) {
            Notificar("@RsBase.ATENCAO_", retorno.mensagem, "warning");
            return false;
        }
        Notificar("@RsBase.ATENCAO_", "Opção de Resposta Atualizada", "info");
        ShowPageLoading();
        setTimeout(() => { window.location.reload(); }, 3000);
    });
</script>
}


@using (Html.BeginForm("Cadastro", "AtendimentoCampos", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-user"></i> @ViewBag.Title</h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "AtendimentoCampos")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_CAMPOS_PERS_ATT</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>
                    </div>
                </div>

                <div class="container-fluid">
                    <div class="card" style="border:none;">
                        <div class="card-body">
                            <!--Nav Tab-->
                            <ul class="nav nav-tabs" id="myTab" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" id="dadosgerais-tab" data-toggle="tab" href="#iTabDadosGerais" role="tab" aria-controls="dadosgerais" aria-selected="true"><i class="fa-solid fa-file-pen"></i>Dados do Campo Personalizado</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="planos-tab" data-toggle="tab" href="#iTabPlanos" role="tab" aria-controls="planos" aria-selected="false"><i class="fas fa-wifi"></i>Controle de Exibição</a>
                                </li>

                            </ul>
                            <div class="tab-content">

                                <!--Content Dados do Campo Personalizado-->
                                <div role="tabpanel" class="tab-pane active" id="iTabDadosGerais">
                                    <div class="accordion" id="accordion_5">
                                        <div class="card div-card-accord mb-3">
                                            <div class="card-header title-card" id="heading_5">
                                                <h5 class="mb-0">
                                                    <a role="button" data-toggle="collapse" data-target="#collapse_5" aria-expanded="true" aria-controls="collapse_5">
                                                        <span class="text-bold-card">Dados do Campo Personalizado</span>
                                                    </a>
                                                </h5>
                                            </div>
                                            <div id="collapse_5" class="collapse show" aria-labelledby="heading_5" data-parent="#accordion_5">
                                                <div class="card-body body-card-accord">
                                                    <div class="row d-flex">
                                                        <div class="col-sm-2">
                                                            <label for="iCodigo">Código:</label>
                                                            @Html.TextBoxFor(model => model.Id, new { @class = "form-control readonly", @id = "iCodigo", @name = "iCodigo" })
                                                        </div>
                                                        <div class="col-sm-4">
                                                            <label for="iTitulo">Título: <span style="color:red">*</span></label>
                                                            @Html.TextBoxFor(model => model.Titulo, new { @class = "form-control" + bloquearCampoEdicao, @id = "iTitulo", @name = "iTitulo", @maxlength = "100" })
                                                        </div>
                                                        <div class="col-sm-3">
                                                            <label for="iCampoObrigatorio">Campo Obrigatório?</label> <br />
                                                            @Html.CheckBoxFor(model => model.CampoObrigatorio, new { @class = "form-control" + bloquearCampoEdicao, @id = "iCampoObrigatorio", @name = "iCampoObrigatorio", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                                        </div>
                                                        @if (Model.Id != 0)
                                                        {
                                                            <div class="col-sm-3">
                                                                <label for="iStatus">Status</label> <br />
                                                                @Html.CheckBoxFor(model => model.Status, new { @class = "form-control" + bloquearCampoEdicao, @id = "iStatus", @name = "Status", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" });
                                                            </div>
                                                        }

                                                    </div>
                                                    <div class="row d-flex">
                                                        <div class="col-sm-3">
                                                            <label for="iTipoCampo">Tipo de Campo: <span style="color:red">*</span></label>
                                                            <select class="form-control @campoBloqueado" id="iTipoCampo" name="TipoCampoGravar">
                                                                <option value="0">Texto</option>
                                                                <option value="1">Inteiro</option>
                                                                <option value="2">Numerico</option>
                                                                <option value="3">Única Escolha</option>
                                                            </select>
                                                            <span class="mt-0" style="color:red" id="iLegenda"></span>
                                                        </div>
                                                        <div class="col-sm-6 divRespostaPersonalizada" style="display:none;">
                                                            <label for="iTitulo">Digite a resposta para adicionar alternativas: <span style="color:red">*</span></label>
                                                            <input type="text" class="form-control @bloquearCampoEdicao" id="iRespostaPersonalizada" name="iRespostaPersonalizada" maxlength="100" />
                                                        </div>
                                                        <div id="divAdicionarResposta" class="col-sm-3 divRespostaPersonalizada mt-3" style="display:none;">
                                                            <button type="button" class="btn btn-success" id="iButtonAdcResposta">Adicionar</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="accordion2">
                                        <div class="card div-card-accord mb-3">
                                            <div>
                                                <div class="card-header title-card">
                                                    <h5 class="mb-0">
                                                        <a role="button" data-toggle="collapse" data-target="#collapse-2" aria-expanded="true" aria-controls="collapse-2">
                                                            <span class="text-bold-card">Lista de Respostas Adicionadas</span>
                                                        </a>
                                                    </h5>
                                                </div>
                                                <div id="collapse-2" class="collapse show card-body" data-parent="#accordion2" aria-labelledby="heading-2">
                                                    <table class="table table-hover nowrap" id="datatableRespostas" style="width: 100%">
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!--Content Controle de Exibição-->
                                <div role="tabpanel" class="tab-pane" id="iTabPlanos">
                                    <div class="row d-flex" style="justify-content: space-between;">

                                        <div id="accordion" class="col-sm-7">
                                            <div class="card div-card-accord mb-3">
                                                <div class="card-header title-card" id="heading_6">
                                                    <h5 class="mb-0">
                                                        <a id="iCollapse_6" role="button" data-toggle="collapse" data-target="#collapse_6" aria-expanded="true" aria-controls="collapse_6">
                                                            <span class="text-bold-card">Defina a condição de Visibilidade do Campo</span>
                                                        </a>
                                                    </h5>
                                                </div>
                                                <div id="collapse_6" class="collapse show" aria-labelledby="heading_6" data-parent="#accordion_6">
                                                    <div class="card-body" style="padding-top: 0px;">
                                                        <div class="row d-flex">
                                                            <div class="col">
                                                                <label>Exibir este campo para todos os tipos de atendimento?</label> <br />
                                                                @Html.CheckBoxFor(model => model.ExibirTodosAtendimentos, new { @class = "form-control", @id = "iExibirTodosAtt", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light", @data_height = "30" })
                                                            </div>
                                                        </div>
                                                        <div class="row d-flex mt-1">
                                                            <div class="col-sm-6 divSelecionarCampos">
                                                                <label for="iTipoAtendimento">Selecione os tipos de atendimento nos quais o campo será exibido</label>
                                                                @Html.DropDownListFor(m => m.Id_Tipo_Atendimento, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control ml-input", @id = "iTipoAtendimento", @autocomplete = "off" })
                                                            </div>
                                                            <div class="col-sm-6 divSelecionarCampos">
                                                                <button type="button" class="btn btn-success mt-3" id="iAdicionarTipoAtendimento">Adicionar</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div id="accordion" class="col-sm-5">
                                            <div class="card div-card-accord">
                                                <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                                    <div class="card-header title-card">
                                                        <h5 class="mb-0">
                                                            <a>
                                                                <span class="text-bold-card">Tipos de Atendimentos Adicionados</span>
                                                            </a>
                                                        </h5>
                                                    </div>
                                                    <div class="card-body">
                                                        <table class="table table-hover nowrap" id="datatable" style="width: 100%">
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <!--./main-->
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal" id="modal-Editar">
                <div class="modal-dialog modal-dialog-centered modal-xs">
                    <div class="modal-content">
                        <div class="modal-header">

                            <h4 class="modal-title text-muted">Editar Resposta </h4>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>

                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-sm-12" sytle="align-content:center">
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <div class="form-group">
                                                <label for="iResposta">Resposta:</label>
                                                @Html.Hidden("Id", null,new { Id = "iIdRespostaModal", @class = "form-control", @autocomplete = "off" })
                                                @Html.TextBox("Resposta", null,new { Id = "iRespostaModal", @class = "form-control", @autocomplete = "off" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group col-sm-12" style="padding: 10px;">
                                        <div class="text-center">
                                            <button type="button" class="btn btn-success" id="iGravarResposta">Gravar</button>
                                            <button type="button" class="btn btn-danger" id="iCancelarResposta">@RsBase.CANCELAR</button>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "AtendimentoCampos")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>
    </div>

}