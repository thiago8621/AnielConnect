@model Aniel.Connect.Models.PerfilAtivacaoCadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Microsoft.AspNet.Identity;

@{
    ViewBag.Title = RsCadastros.CADASTRO_PERFIL_ATIVACAO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    <style>
        #listVariaveisOLT, #listVariaveisOLTVoz, #listVariaveisONU {
            overflow-y: auto;
            padding-left: 15px;
            margin: 0
        }

            #listVariaveisOLT li, #listVariaveisOLTVoz li, #listVariaveisONU li {
                list-style: none;
                cursor: pointer
            }

                #listVariaveisOLT li:hover, #listVariaveisOLTVoz li:hover, #listVariaveisONU li:hover {
                    font-weight: bold;
                    color: dodgerblue;
                }

        .bold {
            font-weight: bold;
        }
    </style>

    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/maskip")
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>
        let clicked = false;
        let ip;

        const scriptVars = $("#listVariaveisONU li").toArray().map(elem => $(elem).text())

        $("#listVariaveisOLT li").on("click", function () {
            const scriptOLT = $("#iScriptOLT").val()
            const variavel = $(this).text()

            $("#iScriptOLT").val(scriptOLT + " " + variavel)

            $(this).addClass("bold")
        })

        $("#listVariaveisOLTVoz li").on("click", function () {
            const scriptOLTVoz = $("#iScriptOLTVoz").val()
            const variavel = $(this).text()

            $("#iScriptOLTVoz").val(scriptOLTVoz + " " + variavel)

            $(this).addClass("bold")
        })

        $("#listVariaveisONU li").on("click", function () {
            const scriptONU = $("#iScriptONU").val()
            const variavel = $(this).text()

            $("#iScriptONU").val(scriptONU + " " + variavel)

            $(this).addClass("bold")
        })

        $("#iScriptOLT").on("input", function (event) {
            const scriptOLT = $(this).val()

            for (var variavel of scriptVars) {
                if (!scriptOLT.includes(variavel)) {
                    const elemVar = $("#listVariaveisOLT li").toArray().filter(p => $(p).text() === variavel)[0]
                    $(elemVar).removeClass("bold")
                }
            }

            // Update do campoo em base64
            $("#iScriptOLTBase64").val(btoa((scriptOLT)))
        })

        $("#iScriptOLTVoz").on("input", function (event) {
            const scriptOLTVoz = $(this).val()

            for (var variavel of scriptVars) {
                if (!scriptOLTVoz.includes(variavel)) {
                    const elemVar = $("#listVariaveisOLTVoz li").toArray().filter(p => $(p).text() === variavel)[0]
                    $(elemVar).removeClass("bold")
                }
            }

            // Update do campoo em base64
            $("#iScriptOLTVozBase64").val(btoa((scriptOLTVoz)))
        })

        $("#iScriptONU").on("input", function () {
            const scriptONU = $(this).val()

            for (var variavel of scriptVars) {
                if (!scriptONU.includes(variavel)) {
                    const elemVar = $("#listVariaveisONU li").toArray().filter(p => $(p).text() === variavel)[0]
                    $(elemVar).removeClass("bold")
                }
            }

            // Update do campo em base64
            $("#iScriptONUBase64").val(btoa((scriptONU)))
        })

        //#region Tamanho da lista de variáveis

        $("#iScriptOLT").on("mouseup", function () {
            const scriptHeight = Number($("#iScriptOLT").css("height").replace("px", ""))
            $("#listVariaveisOLT").css("height", scriptHeight + "px")
        })

        $("#iScriptOLTVoz").on("mouseup", function () {
            const scriptHeight = Number($("#iScriptOLTVoz").css("height").replace("px", ""))
            $("#listVariaveisOLTVoz").css("height", scriptHeight + "px")
        })

        $("#iScriptONU").on("mouseup", function () {
            const scriptHeight = Number($("#iScriptONU").css("height").replace("px", ""))
            $("#listVariaveisONU").css("height", scriptHeight + "px")
        })

        //#endregion

          $('#iGrupoArea').change(function () {

          var grupo_area = $('#iGrupoArea option:selected').val();
          var enderecoApi = "@CONSTANTES.URLPortal/api/Areaapi/GetList?grupo_area=" + grupo_area;

          $('#iArea').empty();
          $('#iLocalidade').empty();

          $.ajax({
              url: enderecoApi,
              type: 'GET',
              dataType: 'json'
          })
          .done(function (data) {

              $('#iArea').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));

              $.each(data.objeto, function (key, value) {
                  $('#iArea').append($('<option></option>').attr('value', value.value).text(value.label));
              });

              var grupo_area = $('#iGrupoArea option:selected').val();
              var area = $('#iArea option:selected').val();

              var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

              $('#iLocalidade').empty();

              $.getJSON(enderecoApi, function (data) {
                  $('#iLocalidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));

                  $.each(data.objeto, function (key, value) {
                      $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));
                  });
              });
          })
          .fail(function () {
              console.log("error");
          })
          .always(function () {
              parent.App.stopPageLoading();
          });

      });

  var oDatatableGrupoArea;
      var array = @Html.Raw(Json.Encode(Model.GruposArea));

      function handleExcluirGrupoArea() {
          $("#datatableGrupoArea").off('click', '.btnExcluirGrupoArea');
          $("#datatableGrupoArea").on('click', '.btnExcluirGrupoArea', function (e) {
              e.preventDefault();

              var idArquivo = $(this).attr("excluir");

              var trLinkButton = $(this).parents('tr');

              if (idArquivo == 0) {
                  oDatatableGrupoArea.row(trLinkButton).remove().draw(false);
                  Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
              }
              else {
                  var link = '@(CONSTANTES.URLPortal)/api/Perfil_Ativacao_Grupo_AreaApi/ExcluirGrid?usuario=@User.Identity.GetUserId()&value=' + idArquivo;


                  $.ajax({
                      url: link,
                      type: 'GET',
                      dataType: 'json',

                  })
                  .done(function (data) {

                      if (data.ok) {
                          oDatatableGrupoArea.row(trLinkButton).remove().draw(false);
                          Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                      }
                      else {
                          Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                      }
                  })
              }
          });
      }


      //datatable Grupo e Area
      var handleDataTableButtonsGrupoArea = function () {
          "use strict";

          var nome_lista = "GruposArea"; //Nome_utilizado para enganar o razor

          //"Blfrtip"
          oDatatableGrupoArea = $("#datatableGrupoArea").length && $("#datatableGrupoArea").DataTable({
              dom: "Bfrti",
              rowId: 'extn',
              select: true,
              language: traducaoDataTableSimples,
              data: array,
              pageLength: 50,
              columns: [
                  {
                      data: "Id",
                      orderable: false,
                      render: function (data, type, row, meta) {

                          const botaoexcluir = row.Id == 0;

                          /*return (botaoexcluir ? '<a href="#" class="btnExcluirGrupoArea" id="btnExcluirGrupoArea_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;padding-right:2px;"></i></a>' +

                              ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                              ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Area" name="' + nome_lista + '[' + meta.row + '].Cod_Area" type="hidden" value="' + TrataNulo(row.Cod_Area) + '">' +
                              ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Escritorio" name="' + nome_lista + '[' + meta.row + '].Cod_Escritorio" type="hidden" value="' + TrataNulo(row.Cod_Escritorio) + '">'

                              :  //else

                              ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                              ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Area" name="' + nome_lista + '[' + meta.row + '].Cod_Area" type="hidden" value="' + TrataNulo(row.Cod_Area) + '">' +
                              ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Escritorio" name="' + nome_lista + '[' + meta.row + '].Cod_Escritorio" type="hidden" value="' + TrataNulo(row.Cod_Escritorio) + '">'); */

                          return '<a href="#" class="btnExcluirGrupoArea" id="btnExcluirGrupoArea_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;padding-right:2px;"></i></a>' +

                              ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                              ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Area" name="' + nome_lista + '[' + meta.row + '].Cod_Area" type="hidden" value="' + TrataNulo(row.Cod_Area) + '">' +
                              ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Escritorio" name="' + nome_lista + '[' + meta.row + '].Cod_Escritorio" type="hidden" value="' + TrataNulo(row.Cod_Escritorio) + '">'
                      }
                  },
                  {
                      data: "Desc_Escritorio",
                      title: "@RsCadastros.GRUPO_AREA",
                      orderable: true,
                      render: function (data, type, row, meta) {
                          if (type === 'display') {
                              data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Desc_Escritorio" name="' + nome_lista + '[' + meta.row + '].Desc_Escritorio" type="hidden" value="' + TrataNulo(data) + '">';
                          }
                          return data;
                      }
                  },
                  {
                      data: "Desc_Area",
                      title: "@RsCadastros.AREA",
                      orderable: false,
                      render: function (data, type, row, meta) {
                          if (type === 'display') {
                              data = data  + ' <input id="' + nome_lista + '_' + meta.row + '__Desc_Area" name="' + nome_lista + '[' + meta.row + '].Desc_Area" type="hidden" value="' + TrataNulo(data) + '">';
                          }
                          return data;
                      }
                  },
              ]
          });


          $("#btnAdicionarGrupoArea").unbind('click');
          $("#btnAdicionarGrupoArea").on('click', async function () {

              var erro = false;

                      if (!$("#iGrupoArea option:selected").val()) {
                          Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.GRUPO_AREA)", "warning");
                          erro = true;
                      }

                      if (!$("#iArea option:selected").val()) {
                          Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.AREA)", "warning");
                          erro = true;
                      }

                      if (erro) {
                          return false;
                      }

                      oDatatableGrupoArea.row.add({
                          Id: 0,
                          Cod_Area: $("#iArea option:selected").val(),
                          Cod_Escritorio: $("#iGrupoArea option:selected").val(),
                          Desc_Escritorio: $("#iGrupoArea option:selected").text(),
                          Desc_Area: $("#iArea option:selected").text(),

                      }).draw(false);

                      handleExcluirGrupoArea();

                      $('#iGrupoArea').val("")
                      $('#iArea').val("")

          });
      },
          TableManageButtonsGrupoArea = function () {
              "use strict";
              return {
                  init: function () {
                      handleDataTableButtonsGrupoArea();
                      handleExcluirGrupoArea();
                  }
              }
          }();

      TableManageButtonsGrupoArea.init();

      $('#iArea').change(function () {

          var grupo_area = $('#iGrupoArea option:selected').val();
          var area = $('#iArea option:selected').val();

          var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

          $('#iLocalidade').empty();

          $.getJSON(enderecoApi, function (data) {
              $('#iLocalidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
              $.each(data.objeto, function (key, value) {
                  $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));
              });
          });
      });

        $(document).ready(function () {
            ip = $('#iIp').ipInput();

            @if (!String.IsNullOrEmpty(Model.IpGerencia))
            {
                <text>ip.setIp('@Model.IpGerencia');</text>
            }

            if ($("#iScriptONUBase64").val() != "") {
                let scriptONU = atob($("#iScriptONUBase64").val())
                $("#iScriptONU").val(scriptONU);
            }

            if ($("#iScriptOLTBase64").val() != "") {
                let scriptOLT = atob($("#iScriptOLTBase64").val())
                $("#iScriptOLT").val(scriptOLT);
            }

            if ($("#iScriptOLTVozBase64").val() != "") {
                let scriptOLTVoz = atob($("#iScriptOLTVozBase64").val())
                $("#iScriptOLTVoz").val(scriptOLTVoz);
            }

             if ($("#iGrupoArea option:selected").val() && !$("#iArea option:selected").val()) {
     Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.AREA)", "warning");
     erro = true;
 }

            $("#iScriptOLTVoz").trigger("mouseup");
            $("#iScriptONU").trigger("mouseup");
            $("#iScriptOLT").trigger("mouseup");
        });

        function ValidaSubmit() {
            $("#iScriptAtivacao").trigger("mouseup").trigger("keyup")
            $("#iScriptAtivacaoVoz").trigger("mouseup").trigger("keyup")
            $("#iScriptONU").trigger("mouseup").trigger("keyup")

            let ip_value = ip.getIp();
            $('#iIpGerencia').val(ip_value);

            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }
    </script>
}


@using (Html.BeginForm("Cadastro", "PerfilAtivacao", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <div style="padding: 10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-headset"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Gerenciamento_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.GERENCIAMENTO_REDE</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "PerfilAtivacao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_PERFIL_ATIVACAO</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>



                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@RsCadastros.CADASTRO</span>
                            </a>
                        </h5>
                    </div>

                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="row mt-2 mb-2">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iID" class="mr-3">@RsCadastros.ID:</label>
                                        @Html.TextBoxFor(model => model.Id, new { @class = "form-control", @id = "iID", @autocomplete = "off", @readonly = "readonly" })
                                        @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iNome" class="mr-3">@RsCadastros.NOME:</label>
                                        @Html.TextBoxFor(model => model.Nome, new { @class = "form-control", @id = "iNome", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Nome, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iLineProfile" class="mr-3">@RsCadastros.LINEPROFILE:</label>
                                        @Html.TextBoxFor(model => model.LineProfile, new { @class = "form-control", @id = "iLineProfile", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.LineProfile, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <div class="outerDivFull mb-2">
                                            <label for="iObrigaWifi" style="display:block">@RsConfiguracao.OBRIGA_WIFI?</label>
                                            @Html.CheckBoxFor(model => model.ObrigaWifi, new { @class = "form-control", @id = "iObrigaWifi", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                            <i class="ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="Marcado como SIM, será obrigatório fornecer SSID do WiFi e Senha WiFi na tela de Autorização de ONU, durante o vínculo do cliente ao equipamento."></i>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-sm-10">
                                    <div class="form-group">
                                        <label for="iScriptAtivacao">@RsCadastros.SCRIPT_OLT_INTERNET</label>
                                        <textarea id="iScriptOLT" class="form-control" rows="6" spellcheck="false"></textarea>
                                        @Html.HiddenFor(m => m.ScriptOLTBase64, new { id = "iScriptOLTBase64" })
                                    </div>


                                </div>

                                <div class="col-sm-2">
                                    <label for="listVariaveisOLT">Variáveis</label>
                                    <ul id="listVariaveisOLT">
                                        @foreach (var variavel in Enum.GetValues(typeof(VariaveisScriptOLT)))
                                        {
                                            <li>&lt;@(HtmlEnumExtensions.GetEnumDescription(variavel))&gt;</li>
                                        }
                                    </ul>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-10">
                                    <div class="form-group">
                                        <label for="iScriptAtivacaoVoz">@RsCadastros.SCRIPT_OLT_VOZ</label>
                                        <textarea id="iScriptOLTVoz" class="form-control" rows="6" spellcheck="false"></textarea>
                                        @Html.HiddenFor(m => m.ScriptOLTVozBase64, new { id = "iScriptOLTVozBase64" })
                                    </div>


                                </div>

                                <div class="col-sm-2">
                                    <label for="listVariaveisOLTVoz">Variáveis</label>
                                    <ul id="listVariaveisOLTVoz">
                                        @foreach (var variavel in Enum.GetValues(typeof(VariaveisScriptOLT)))
                                        {
                                            <li>&lt;@(HtmlEnumExtensions.GetEnumDescription(variavel))&gt;</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card div-card-accord mt-3">
                    <div class="card-header title-card" id="heading-3">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-3" aria-expanded="true" aria-controls="collapse-3">
                                <span class="text-bold-card">Parâmetros ONU Cliente</span>
                            </a>
                        </h5>
                    </div>

                    <div id="collapse-3" class="collapse show" data-parent="#accordion" aria-labelledby="heading-3">
                        <div class="card-body body-card-accord">
                            <div class="row mt-2 mb-2">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iIpGerencia">@RsCadastros.IP_GERENCIA:</label>
                                        <div id="iIp" class="ip-input">
                                            <div class="ip-input-container form-control">
                                                <input type="text" class="ip-input-item" value="">
                                                <i class="ip-input-dot"></i>
                                                <input type="text" class="ip-input-item" value="">
                                                <i class="ip-input-dot"></i>
                                                <input type="text" class="ip-input-item" value="">
                                                <i class="ip-input-dot"></i>
                                                <input type="text" class="ip-input-item" value="">
                                            </div>
                                        </div>
                                        @Html.HiddenFor(p => p.IpGerencia, new { @class = "form-control", @id = "iIpGerencia", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.IpGerencia, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iLogin" class="mr-3">@RsCadastros.LOGIN:</label>
                                        @Html.TextBoxFor(p => p.Login, new { @class = "form-control", @id = "iLogin", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Login, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iSenha" class="mr-3">@RsCadastros.SENHA:</label>
                                        @Html.TextBoxFor(model => model.Senha, new { @class = "form-control", @id = "iSenha", @autocomplete = "off", @type = "password" })
                                        @Html.ValidationMessageFor(model => model.Senha, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iPortaTelnet" class="mr-3">@RsCadastros.PORTA_TELNET:</label>
                                        @Html.TextBoxFor(model => model.PortaTelnet, new { @class = "form-control", @id = "iPortaTelnet", @autocomplete = "off", @type = "number" })
                                        @Html.ValidationMessageFor(model => model.PortaTelnet, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iPortaHttp" class="mr-3">@RsCadastros.PORTA_HTTP:</label>
                                        @Html.TextBoxFor(model => model.PortaHttp, new { @class = "form-control", @id = "iPortaHttp", @autocomplete = "off", @type = "number" })
                                        @Html.ValidationMessageFor(model => model.PortaHttp, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iSenorId">@RsCadastros.SENOR_ID:</label>
                                        @Html.TextBoxFor(model => model.SenorId, new { @class = "form-control", @id = "iSenorId", @autocomplete = "off", @type = "number" })
                                        @Html.ValidationMessageFor(model => model.SenorId, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iGemPort" class="mr-3">@RsCadastros.GEM_PORT:</label>
                                        @Html.TextBoxFor(model => model.GemPort, new { @class = "form-control", @id = "iGemPort", @autocomplete = "off", @type = "number" })
                                        @Html.ValidationMessageFor(model => model.GemPort, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iServicePort">@RsCadastros.SERVICE_PORT:</label>
                                        @Html.TextBoxFor(model => model.ServicePort, new { @class = "form-control", @id = "iServicePort", @autocomplete = "off", @type = "number" })
                                        @Html.ValidationMessageFor(model => model.ServicePort, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-10">
                                    <div class="form-group">
                                        <label for="iScriptONU">@RsCadastros.SCRIPT_ONU</label>
                                        <textarea id="iScriptONU" class="form-control" rows="6" spellcheck="false"></textarea>
                                        @Html.HiddenFor(m => m.ScriptONUBase64, new { id = "iScriptONUBase64" })
                                    </div>
                                </div>

                                <div class="col-sm-2">
                                    <label for="listVariaveisONU">Variáveis</label>
                                    <ul id="listVariaveisONU">
                                        @foreach (var variavel in Enum.GetValues(typeof(VariaveisScriptOLT)))
                                        {
                                            <li>&lt;@(HtmlEnumExtensions.GetEnumDescription(variavel))&gt;</li>
                                        }
                                    </ul>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
                <div class="card div-card-accord mt-3">
                    <div class="card-header title-card" id="heading-3">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-2" aria-expanded="true" aria-controls="collapse-2">
                                <span class="text-bold-card">Cadastro/Listagem de Grupos e Áreas vinculados ao Perfil de Ativação</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-2" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                        <div class="card-body body-card-accord">
                            <div class="row mt-2">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iGrupoArea">@RsCadastros.GRUPO_AREA:</label>
                                        @Html.DropDownListFor(model => model.Cod_Escritorio, new SelectList(ViewBag.GruposArea, "Value", "Label"), RsBase.SELECIONE, new { @class = "form-control", @id = "iGrupoArea" })

                                    </div>

                                </div>

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iArea">@RsCadastros.AREA:</label>
                                        @Html.DropDownListFor(model => model.Cod_Area, new SelectList(ViewBag.Areas), RsBase.SELECIONE, new { @class = "form-control", @id = "iArea" })

                                    </div>
                                </div>

                                <div class="col-sm-2" style="margin-left: auto;margin-right: 0;">
                                    <div class="form-group">
                                        <div class="text-right mt-2" style="margin-right: 100px;">
                                            <button type="button" id="btnAdicionarGrupoArea" class="btn btn-success"><i class="fas fa-check"></i> @RsCadastros.INSERIR_GRUPO_AREA</button>
                                            <a target="_blank" href="@Url.Action("Login", "Home")" onclick="ShowPageLoading(); return true;"></a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <table class="table table-hover nowrap text-left" id="datatableGrupoArea" style="width:100%;"></table>
                        </div>
                    </div>
                </div>


            </div>

        </div>




        <!--Button Float-->
        <a href="@Url.Action("Index", "PerfilAtivacao")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}