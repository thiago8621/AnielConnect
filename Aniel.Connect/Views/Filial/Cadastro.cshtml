@model Aniel.Connect.Models.FilialCadastroModel

@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado

@{
    ViewBag.Title = RsCadastros.FILIAL;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script>

        reloadData("@(CONSTANTES.URLPortal + "/api/Faixa_ComissionamentoApi/busca")", "iIdFaixaComissionamento", "iFaixaComissionamento");

    $(document).ready(function () {

        

    });


    </script>
}


@using (Html.BeginForm("Cadastro", "Filial", FormMethod.Post, htmlAttributes: new { enctype = "multipart/form-data", @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    
    <div style="padding:10px">
        <div class="card" style="border:none;">


            <div class="col-sm-12" style="margin-bottom: -22px;">


                <h4 class="title-page">
                    <i class="fas fa-headset"></i> @ViewBag.Title

                    <!--Button Menu-->
                    <span class="   offset-sm-9 pl-4">
                        <button class="btn btn-default btn-add" type="button" title="@Resources.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                        </button>

                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                            @*<a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@Resources.EXPORTAREXCEL</a>*@
                            @*<a class="dropdown-item" id="btnInativar" href="#" onclick="return false;">@Resources.INATIVAR</a>
                        <a class="dropdown-item" id="btnAtivar" href="#" onclick="return false;">@Resources.ATIVAR</a>*@
                            <a class="dropdown-item" id="btnTrocarEnderecoInstalacao" href="#" onclick="AbrirHistorio();"><i class="far fa-clock"></i> @RsCadastros.HISTORICO_ATENDIMENTO</a>
                            <a class="dropdown-item" id="btnTrocarEnderecoInstalacao" href="#" onclick="ExibirLogin($('#iEndereco_Instalacao').val())"><i class="fas fa-map-marker-alt"></i> @RsCadastros.TROCAR_ENDERECO_INSTALACAO</a>
                        </div>
                    </span>

                </h4>


                <nav aria-label="breadcrumb" style="font-size:12px" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item" style="margin-left:22px; margin-top:-18px">
                            <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9">@RsCadastros.CONFIGURACOES</a>
                        </li>
                        <li class="breadcrumb-item" style="margin-top:-18px">
                            <a href="@Url.Action("Index", "Filial")" style="color:#367fa9">@RsCadastros.PAINEL_FILIAL</a>
                        </li>
                        <li class="breadcrumb-item" style="margin-top:-18px">
                            <span>@ViewBag.Title</span>
                        </li>

                    </ol>
                </nav>

            </div>

            <div class="row">
                <br />                
            </div>

            <table class="table table-hover" id="datatable">
                <thead class="tb-head">

                </thead>
            </table>

            <div id="accordion">
                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@RsCadastros.FILIAL</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">
                                <div class="col-sm-3">
                                    <label for="iVendedor">@RsCadastros.NOME:</label>

                                    @Html.TextBoxFor(model => model.Nome, new { @class = "form-control", @id = "iNome", @autocomplete = "off", @required = true, @readonly = true })
                                </div>

                                <div class="col-sm-3">
                                    <label for="iEmpresa">@RsCadastros.EMPRESA</label>

                                    @Html.HiddenFor(model => model.Id_Empresa, new { @class = "form-control", @id = "iIdEmpresa" })
                                    @Html.TextBoxFor(model => model.Empresa, new { @class = "form-control", @id = "iEmpresa", @autocomplete = "off", @required = true, @readonly = true })

                                </div>

                            </div>

                            <br />
                            <div class="row">
                                <div class="col-sm-3">
                                    <label for="iFaixa_Comissionamento">@RsCadastros.FAIXA_COMISSIONAMENTO</label>
                                    <div class="input-group">
                                        @Html.HiddenFor(model => model.Id_Faixa_Comissionamento, new { @class = "form-control", @id = "iIdFaixaComissionamento" })
                                        @Html.TextBoxFor(model => model.Faixa_Comissionamento, new { @class = "form-control", @id = "iFaixaComissionamento", @autocomplete = "off", @required = true, @placeholder=RsCadastros.FAIXA_COMISSIONAMENTO })
                                        @Html.ValidationMessageFor(model => model.Faixa_Comissionamento, "", new { @class = "text-danger" })

                                        @*@Html.TextBoxFor(model => model.Faixa_Comissionamento, new { @class = "form-control", @id = "iFaixa_Comissionamento", @autocomplete = "off" })*@

                                        <div class="input-group-append">
                                            <div class="input-group-text"><i class="fas fa-search"></i></div>
                                        </div>
                                    </div>

                                    </div>

                                    <div class="col-sm-3">

                                    </div>
                                </div>

                        </div>

                    </div>
                </div>



            </div>



            <!--Button Float-->
            <a href="@Url.Action("Index", "Filial")" class="float-cancel">
                <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                    <i class="fas fa-times fa-2x"></i>
                </div>
            </a>

            <a href="#" class="float-save" onclick="$('#form').submit(); return false;">
                <div id="btnSalvar" class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                    <i class="fas fa-save fa-2x"></i>
                </div>
            </a>
            <div id="mapa"></div>
        </div>

        @*</div>*@
    </div>
    
}