    var reservaApi = "@CONSTANTES.URLPortal/api/Elemento_Rede_PortaApi/Reserva_Porta";
    var reativarApi = "@CONSTANTES.URLPortal/api/Elemento_Rede_PortaApi/Ativar_Porta";
    var atribuirApi = "@CONSTANTES.URLPortal/api/Elemento_Rede_PortaApi/Atribuir_Porta";

    //#region ações_reserva
    /**@@param cliente   @@param cliente_plano   @@param porta
     * @@returns {boolean}
     */
     @* Id do Cliente | Id Cliente_PlanoProduto | Id_Porta *@
    async function registrar_porta(cliente,cliente_plano,porta) {


        const portaLivre = await ConsultaPlanoPortaLivre(cliente_plano);
        if (portaLivre == false) {
            var result = await Swal.fire({
                title: 'O plano do cliente já possui porta vinculada, Deseja continuar?',
                showCancelButton: true,
                cancelButtonText: 'Não',
                confirmButtonText: 'Sim',
                type: 'question',
                allowOutsideClick: false
            });

            if (!result.value) {
                return false;
            }
        }
        let ok = false;
        $("#divProgress").show();
        await $.post(reservaApi, {
            cod_Cliente: cliente,
            cliente_PlanoProduto: cliente_plano,
            id_Porta: porta
        }).done(function (data) {
            if (data.ok)
                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "Ok", "info");
            else
                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");

             $("#divProgress").hide();
            ok = data.ok;

        }).fail(function (data) {
             $("#divProgress").hide();
            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
        });
        return ok;
    };

    async function atribuir_porta(cliente,cliente_plano,porta) {


        const portaLivre = await ConsultaPlanoPortaLivre(cliente_plano);
        if (portaLivre == false) {
            var result = await Swal.fire({
                title: 'O plano do cliente já possui porta vinculada, Deseja continuar?',
                showCancelButton: true,
                cancelButtonText: 'Não',
                confirmButtonText: 'Sim',
                type: 'question',
                allowOutsideClick: false
            });

            if (!result.value) {
                return false;
            }
        }

        let ok = false;

        $("#divProgress").show();
        await $.post(atribuirApi, {
            cod_Cliente: cliente,
            cliente_PlanoProduto: cliente_plano,
            id_Porta: porta
        }).done(function (data) {
            if (data.ok)
                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "Ok", "info");
            else
                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");

            HidePageLoading()
            ok = data.ok;

        }).fail(function (data) {
            HidePageLoading()
            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
        });
        return ok;
    };

    async function ConsultaPlanoPortaLivre(cliente_plano) {

        const ConsultaPortaLivreApi = "@CONSTANTES.URLPortal/api/Elemento_Rede_PortaApi/ConsultaPlanoPortaLivre";
        const resultado = await $.ajax({
            url: ConsultaPortaLivreApi,
            type: `POST`,
            dataType: `json`,
            beforeSend: function () {
                $("#divProgress").show();

            },
            complete: function () {
                 $("#divProgress").hide();
            },
            data: {
                cod_Cliente: null,
                cliente_PlanoProduto: cliente_plano,
                id_Porta: null
            }

        });


        if (!resultado.ok) {
            Notificar("@RsBase.ATENCAO_", resultado.mensagem, "warning");
            return false;
        }
        else {
            return resultado.idObjeto
        }

    }

    async function remover_login(portas) {
        try {
            const response = await fetch(reativarApi, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    reset: true,
                    Ids_Porta: portas
                })
            });

            const data = await response.json();

            if (!response.ok) {
                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                return;
            }

            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
            rows_selected = [];
            oDatatable.draw(false);

        } catch (err) {
            Notificar("@RsBase.ATENCAO_", err.message, "warning");
        }
    }
