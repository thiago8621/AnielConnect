                                    @Html.DropDownList("iSituacao", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { Id = "iSituacao", @multiple = "multiple", @class = "form-control", @placeholder = "Todos", @autocomplete = "off" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group col-sm-12" style="padding: 10px;">
                            <div class="text-center">
                                <button type="button" class="btn btn-danger limparFiltro" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                                <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="overlay" id="divProgress" style="display:none;">
    <div class="preloaderbar show active">
        <span class="bar"></span>
        <span class="text">Processando Consulta ...</span>
    </div>
</div>
