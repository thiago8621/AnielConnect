<script>

    /**  @@param {number} tipo_Requisicao 1:AdicionarReserva, 2: AdicionarConexãoGeosite, 3: Remover_Conexao 4: Update_Reserva*/
    function getUrlRequisicoesGeosite(tipo_Requisicao) {
        const url = "@CONSTANTES.URLPortal";
        switch (tipo_Requisicao) {
            case 1:
                //AdicionarReserva
                return `${url}/api/Elemento_Rede_PortaApi/Ligacao_ReservaPorta_Geosite`;
                break;
            case 2:
                //Adicionar Conexão Cliente
                return `${url}/api/Elemento_Rede_PortaApi/Ligacao_AdicionarConexao_Geosite`;
                break;
            case 3:
                //Remover Conexão Cliente
                return `${url}/api/Elemento_Rede_PortaApi/Ligacao_RemoverConexao_Geosite`;
                break;
            case 4:
                //Update da Reserva de Porta
                return `${url}/api/Elemento_Rede_PortaApi/Ligacao_UpdateReserva_Geosite`;
                break;
        }
    }
         /**@@param porta
          *@@param integracoes*/
    async function Handle_Update_Reserva(porta, integracoes) {
        let array = integracoes;


        array.forEach(async param => {
            let integracaoDesc = `${param.integracaoDesc}`.toUpperCase();
            let statusOperation = await ajaxHandle_Update_Reserva(porta, integracaoDesc);

            if (statusOperation) {

                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", `Atualização de Reserva na porta: ${porta} na integracao: ${integracaoDesc}`, "info");

            }
            else {
                Notificar("@RsBase.ERRO", `Erro ao atualizar reserva na porta: ${porta} na integração:${integracaoDesc}`, "warning");
            }

        });
    }
       async function ajaxHandle_Update_Reserva(porta, tipoIntegracao) {

            let execucao = false,
                message = "";
            let url = "";
        switch (tipoIntegracao) {

            case "@IntegracaoExterna.GEOSITE":
                url = getUrlRequisicoesGeosite(4);
                break;

            case "@IntegracaoExterna.SAPERX":
                //url += "api/Elemento_Rede_PortaApi/Ligacao_Porta_Geosite";
                break;

        }
        await $.ajax({
            url: url,
            type: "POST",
            dataType: 'json',
            data: { "porta": porta, cliente_PlanoProduto: $("#iplano_produtoReservar option:selected").val() }
        }).done(function (data) { execucao = data.ok; message = data.mensagem });
        //await $.post({ url: url, data: { porta: porta } }).done(function (data) { execucao = data.ok});
            if (execucao) {
                return { execucao: execucao };
            }
            else {
                return { execucao: execucao, message: message };
            }
    }
      /**@@param porta
      *@@param integracoes*/
    async function Handle_Reserva(porta, integracoes) {
        let array = integracoes;


        array.forEach(async param => {
            let integracaoDesc = `${param.integracaoDesc}`.toUpperCase();
            let statusOperation = await ajaxHandle_Reserva(porta, integracaoDesc);

            if (statusOperation.execucao) {

                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", `Porta reservada também na integracao: ${integracaoDesc}`, "info");

            }
            else {
                Notificar("@RsBase.ERRO", `Erro ao vincular porta na integração:${integracaoDesc}\r\n Motivo:${statusOperation.message}`, "warning");
            }

        });
    }

