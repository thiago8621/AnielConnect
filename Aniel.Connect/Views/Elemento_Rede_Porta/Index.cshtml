                    beforeSend: function () {
                        $("#divProgress").show();
                    },
                    complete: function () {
                        $("#divProgress").hide();
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function (row, data, dataIndex) {
                    // Get row ID
                    var rowId = data.id;

                    // If row ID is in the list of selected row IDs
                    if ($.inArray(rowId, rows_selected) !== -1) {
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                    }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [

                    { title: "<input name='select_all' value='1' type='checkbox'>" },

                    { data: "caixa", title: "@RsCadastros.CAIXA" },
                    { data: "porta", title: "Num. @RsCadastros.PORTA"},
                    {
                        data: "status",
                        title: "@RsCadastros.SITUACAO",
                        render: function (data, type, row, meta) {
                            let Data = "";
                            if (data == 'Disponível' || data == 'Ocupado') {
                                Data = `<p class='@RsCadastros.SITUACAO' style="font-size: 14px; color:${data == 'Disponível' ? 'green' : 'red'}" >${data}</p>`;
                            }
                            else {
                                Data = `<p class='@RsCadastros.SITUACAO' style="font-size: 14px; color:black" >${data}</p>`;
                            }
                            return Data;
                        }
                    },
                    { data: "login", title: "@RsCadastros.LOGIN" },
                    { data: "contrato", title: "@RsCadastros.CONTRATO "},
                    { data: "projeto", title: "@RsCadastros.PROJETO "},
                    { data: "pop", title: "@RsCadastros.POP "},
                    { data: "olt", title: "@RsCadastros.OLT "},
                    { data: "cidade", title: "@RsCadastros.CIDADE "},
                    { data: "bairro", title: "@RsCadastros.BAIRRO "}

                ]
            });

            $("#btnOcupado").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(5);
            });


            $("#iGravarReservar").on("click",async function () {
                 if (rows_selected.length == 0|| rows_selected.length > 1) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }
                let porta = rows_selected[0];
                const registroResult = await registrar_porta($("#iClienteReservar option:selected").val(), $("#iplano_produtoReservar option:selected").val(), porta);
                if (registroResult) {
                    //let geositeClass = new IntegracaoExternaHandlerJSApi();
                    let config = await Handle_Need();
                    if (config.usaIntegracao) {

                        let ok = await validateCaixaIntegracao(porta);

                        if (ok) {
                            let result = await Swal.fire({
                                title: 'Esta porta apresenta vínculo com as integrações disponíveis.Deseja atualizar também na integração? ',
                                showCancelButton: true,
                                cancelButtonText: 'Não',
                                confirmButtonText: 'Sim',
                                type: 'question',
                                allowOutsideClick: false
                            });

                            if (!result.value) {
                                Notificar("@RsBase.ATENCAO_", "Registro não integrado de forma voluntária.", "info");
                                return false;
                            }

                            await Handle_Reserva(porta, config.listaIntegracao);
                        }
                    }


                }

                oDatatable.draw(false);

                //AlterarStatusObj(4);
            });


            $("#iGravarAtribuir").on("click",async function () {
                 if (rows_selected.length == 0|| rows_selected.length > 1) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }
                let porta = rows_selected[0];
                const resultAtribuirPorta = await atribuir_porta($("#iClienteAtribuir option:selected").val(), $("#iplano_produtoAtribuir option:selected").val(), porta);
                if (resultAtribuirPorta) {
                    //let geositeClass = new IntegracaoExternaHandlerJSApi();
                    let obj = Handle_Need();
                    if (obj.usaIntegracao) {
                        let ok = await validateCaixaIntegracao(porta);

                        if (ok) {
                               let result = await Swal.fire({
                                title: 'Esta porta apresenta vínculo com as integrações disponíveis.Deseja atualizar também na integração? ',
                                showCancelButton: true,
                                cancelButtonText: 'Não',
                                confirmButtonText: 'Sim',
                                type: 'question',
                                allowOutsideClick: false
                            });

                            if (!result.value) {
                                Notificar("@RsBase.ATENCAO_", "Registro não integrado de forma voluntária.", "info");
                                return false;
                            }


                            await Handle_AtribuirPorta(porta, obj.listaIntegracao);
                        }
                    }
                }


                oDatatable.draw(false);

                //AlterarStatusObj(4);
            });

            $("#btnConstruir").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(3);
            });

             $("#btnPrevisto").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(2);
             });

                $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
                });

            async function getClientePortaReservada(portas) {
                try {
                    let response = await $.ajax({
                        url: `@CONSTANTES.URLPortal/api/Elemento_Rede_PortaApi/GetClientePortaReservada`,
                        type: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(portas)
                    });
                    return response.objeto;
                } catch (error) {
                    console.error("Erro ao buscar clientes das portas:", error);
                    return [];
                }
            }

            $("#iLimparReserva").on("click", async function () {

                let portas = rows_selected,
                cpp = await getClientePortaReservada(portas);

                $("#divProgress").show();
                let porta = rows_selected[0];

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                     $("#divProgress").hide();
                    return;
                }
                AlterarStatusObj(1);

                 let obj = await Handle_Need();
                if (obj.usaIntegracao) {
                    let ok = await validateCaixaIntegracao(porta);

                    if (ok) {
                           let result = await Swal.fire({
                                title: 'Esta porta apresenta vínculo com as integrações disponíveis. Deseja atualizar também na integração? ',
                                showCancelButton: true,
                                cancelButtonText: 'Não',
                                confirmButtonText: 'Sim',
                                type: 'question',
                                allowOutsideClick: false
                           });

                            if (!result.value) {
                                Notificar("@RsBase.ATENCAO_", "Registro não integrado de forma voluntária.", "info");
                                $("#divProgress").hide();
                        }



                        await Handle_RetirarReserva(porta, obj.listaIntegracao, cpp);
                    }

                }

                remover_login(portas);

                oDatatable.draw(false);
                });

                $("#btnInativar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            $('#txtSearch').val(oDatatable.search());

            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });

            $("#iPesquisar").on("click", function () {

                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
                $("iUf").text("");
                $("#modal-filter").modal('hide');

                return true;
            });

            $('#iLimparFiltros').on('click', function () {

                $('#txtSearch').val('');
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
            });
            $("#iLimparFiltroModalCliente").click(function () {
              $("#iplano_produto").val("");
                $("#iCliente").val("");
                $("#modal-ClientePlanoProd").modal('hide');
            })



            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });
        }

            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

    $("#iplano_produto").on("select2:selected select2:selecting", function (e) {
        var Plano_produto = e.params.args.data;
        console.log(Plano_produto.tipo);
    });

    TableManageButtons.init();



</script>
}

