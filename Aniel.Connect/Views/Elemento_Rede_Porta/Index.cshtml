       async function Handle_Need() {
        let needIntegration = false,
            array = [];

        await $.get({
            url: "@CONSTANTES.URLPortal/api/Configuracoes_Geraisapi/FindById?Id=1"
        })
            .done(data => {
                needIntegration = data?.objeto?.utilizar_Integracao_Externa;
                array = data?.objeto?.integracoes;
            });

        return { usaIntegracao: needIntegration, listaIntegracao: array };
        }

    async function validateCaixaIntegracao(porta) {
        let integrado = false;
        await $.post({
            url: "@CONSTANTES.URLPortal/api/Elemento_Rede_PortaApi/ValidatePorta",
            type: 'POST',
            dataType: 'json',
            data: { '': JSON.stringify(porta) }
        })
            .done(function (data) {

                integrado = data;
            });
        return integrado;
    }

