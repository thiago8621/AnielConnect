@model Aniel.Connect.Models.T5.Area_CoberturaCadastroModel

@using Aniel.T5.Model.enumerado
@using Resources
@using Microsoft.AspNet.Identity;
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.CADASTRO_AREA_COBERTURA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";



}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")

}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

<script>
    $(document).ready(function () {
        AddSelect("iTipo", "@CONSTANTES.URLPortal/api/Tipo_Elemento_RedeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iProduto", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboPlanoProdutoAniel", @CONSTANTES.PaginacaoRegistros, null, null,null, "@RsBase.SELECIONE", false);

    });

        var rows_selected = [];

        let odatatable_planoprod = null;



        function Mapa(id)
        {
            var _id = "@Html.Raw(Model.Id)";
            var url = '@Url.Action("MapaCobertura", "Area_Cobertura",new {id="__id__" })';
            window.location.href= url.replace('__id__', _id);
        }


        var clicked = false;
      function ValidaSubmit() {
        if (clicked) {
            return false;
        }

        clicked = true;

        erro = false;

        if (ValidaCamposObrigatorios(erro)) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
            erro = true
        }

        if (erro) {
            clicked = false;
            return false;
        }

        ShowPageLoading();
        $('#form').submit();
        return true;
        }


    function HandleExcluirPlanos() {

        $(".excluiplanoproduto").unbind('click');
        $(".excluiplanoproduto").click(function (e) {
            e.preventDefault();
            var excluir = $(this).attr('excluir');
            var trLinkButton = $(this).parents('tr');


            if (excluir == 0) {
                odatatable_planoprod.row(trLinkButton).remove().draw(false);
                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");

            }
            else {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Area_CoberturaApi/DeletePlano?Idplano=")' + excluir;


                $.ajax({
                    url: link,
                    type: "GET",
                    dataType: "json",

                })
                    .done(function (data) {
                        if (data.ok) {
                            odatatable_planoprod.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    })
                    .fail(function () { })
                    .always(function () { });
            }
        });
    }



        let array_planoprodutos = @Html.Raw(Json.Encode(Model.Produtos));
        var nomePlanoproduto = "Produtos";
        odatatable_planoprod = $("#datatablePlanoProd").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: array_planoprodutos,
            drawCallback: function () {
                HandleExcluirPlanos();
            },
            paging: false,
            order: [],
            columns: [
                //Primeira Coluna
                {
                    data: "Id",
                    title: "",
                    render: function (data, type, row, meta )
                    {
                        return '<a href = "#" id="excluiplanoproduto_' + meta.row + '__Id" class="excluiplanoproduto"  excluir="' + row.Id + '">' +
                               '<i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                               '<input id = "' + nomePlanoproduto + '_' + meta.row + '__Id" name = "' + nomePlanoproduto + '[' + meta.row + '].Id" type = "hidden" value="'+TrataNulo(data) + '">';
                    }
                },
                //Segunda Coluna
                {
                    data: "Descricao",
                    title: "Descricao do Plano/Produto",
                    render: function (data, type, row, meta)
                    {
                        var Data = data + '<input id="' + nomePlanoproduto + '_' + meta.row + '__Descricao" name="' + nomePlanoproduto + '[' + meta.row + '].Descricao" type="hidden" value="' + TrataNulo(data) + '" >'+
                                   '</input> ';
                        return Data;
                    }
                },
                //Terceira Coluna
                {
                    data:"Plano_produto",
                    title:"Cód. Plano/Produto",
                    render: function (data, type, row, meta)
                    {
                        var Data = data + '<input id="' + nomePlanoproduto + '_' + meta.row + '_planoproduto" name="' + nomePlanoproduto + '[' + meta.row +'].Plano_produto" type="hidden" value="'+TrataNulo(data)+'">';
                        return Data;
                    }
                },
            ]
        });



        $("#IAdicionarProduto").click(function () {
            if (!$("#iProduto").val()) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            odatatable_planoprod.row.add({
                    Id: 0,
                    Descricao: $("#iProduto option:selected").text(),
                Plano_produto: $("#iproduto").prop("plano_produto"),

            }).draw(false);

        });

        //function handleExclusao() {

        //    var exclusao = $(".excluiplanoproduto").val();
        //    var tr = $(".excluiplanoproduto").parents("tr");
        //    odatatable_planoprod.row.remove({})
        //}


</script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-cogs"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Projeto_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.ANIEL_GEOGRAPHY</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Area_Cobertura")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_AREA_COBERTURA</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

            @*<span style="font-size:11px" id="dtLegend"></span>*@
        </div>

    </div>

    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" id="cadastro-tab" data-toggle="tab" href="#iTabCadastro" role="tab" aria-controls="dadosgerais" aria-selected="true"><i class="fas fa-pencil-alt"></i> @RsCadastros.CADASTRO</a>
        </li>
        <li class="nav-item">
            <a class="nav-link " id="planoproduto-tab" data-toggle="tab" href="#iTabPlanoProduto" role="tab" aria-controls="financeiro" aria-selected="false"><i class="fas fa-dollar-sign"></i> @RsCadastros.PLANOS_E_PRODUTOS </a>
        </li>
    </ul>

</div>
<!--./main-->
