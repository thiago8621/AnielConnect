    <div style="padding:10px">
        @*Criação das Tabs*@
        <div class="tab-content">
            @*Tab de Cadastro*@
            <div role="tabpanel" class="tab-pane active" id="iTabCadastro">
                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">@RsCadastros.CADASTRO</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">


                            <div class="row">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iId">@RsCadastros.ID</label>
                                        @Html.TextBoxFor(model => model.Id, new { @class = "form-control", id = "iId", disabled = "disabled" })
                                    </div>
                                </div>


                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label for="iDescricao">@RsCadastros.DESCRICAO da Área de Cobertura </label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", id = "iDescricao", autocomplete = "off" })
                                    </div>
                                </div>


                                @*<div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iStatus">@RsCadastros.STATUS</label>
                                        @Html.EnumDropDownListFor(model => model.Status, RsBase.SELECIONE, new { @class = "form-control", id = "iStatus", autocomplete = "off" })
                                    </div>
                                </div>*@


                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iCor">@RsCadastros.COR da Área de Cobertura:</label>
                                        @Html.TextBoxFor(Model => Model.Cor, new { @type = "color", id = "iCor", @class = "form-control", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Cor, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2">
                                    <button type="button" class="btn btn-primary" onclick="Mapa()">
                                        <i class="fas fa-map"></i><span>&ensp;</span>
                                        <span>Desenhar Area</span>
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane " id="iTabPlanoProduto">
                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-2">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-2" aria-expanded="true" aria-controls="collapse-2">
                                <span class="text-bold-card">@RsCadastros.PLANOS_E_PRODUTOS Ofertados</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-2" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                        <div class="card-body body-card-accord">

                            <div class="row">

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iProduto">@RsCadastros.PLANO_PRODUTO:</label>
                                        @Html.DropDownList("iProduto", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @id = "iProduto", @class = "form-control", @autocomplete = "off" })
                                    </div>
                                </div>

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <a class="btn btn-success btn-add" id="IAdicionarProduto" href="#" title="@RsBase.INCLUIR" onclick=" return true;"><i class="la la-plus" style="color: #fff"></i></a>
                                    </div>
                                </div>
                            </div>

                            <table class="table table-hover nowrap" id="datatablePlanoProd" style="width:100%"></table>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>






