    function AlterarResponsabilidade(responsabilidade) {
        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Painel_ServicosApi/AlterarResponsabilidade")';

        $.ajax({
            url: link,
            type: 'POST',
            dataType: 'json',
            data: {
                ids: rows_selected,
                responsabilidade: responsabilidade
            }
        })
            .done(function (data) {

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    oDatatable.draw();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });

    }

