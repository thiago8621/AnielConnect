            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().codCt + "|" +
                    oDatatable.row($row).data().projeto + "|" +
                    oDatatable.row($row).data().numero_Obra + "|" +
                    oDatatable.row($row).data().num_Doc;

                var rowManuCheck = oDatatable.row($row).data().numero_Obra;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);
                    rowsOsManutencaoCheck.push(rowManuCheck);

                    getcombo_tecnico_criterios.push({
                        ['Grupo_Area']: oDatatable.row($row).data().cod_Grupo_Area,
                        ['Area']: oDatatable.row($row).data().cod_Area,
                        ['Cod_Localidade']: oDatatable.row($row).data().cod_Localidade,
                        ['Tipo_serv']: oDatatable.row($row).data().cod_Tipo_Servico
                    });

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                    rowsOsManutencaoCheck.splice(index, 1);
                    getcombo_tecnico_criterios.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function (e) {

                if (oDatatable.row(this).data() != null) {

                    var _codCt = oDatatable.row(this).data().codCt;
                    var _projeto = oDatatable.row(this).data().projeto;
                    var _num_Obra = oDatatable.row(this).data().numero_Obra_Original;
