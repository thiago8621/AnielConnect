    function findStoragedProperty(id) {

        const valorCampo = $("#" + id).attr("value");

        if (valorCampo) {
            return valorCampo;
        }
        else {
            const storageItem = window.localStorage.getItem("@Html.Raw(StorageName)")
            let filtros = storageItem ? JSON.parse(storageItem) : [];
            let filtro = filtros.filter(p => p.id == id);

            if (filtro.length > 0)
                return filtro[0].value;
            else
                return null;
        }
    }

