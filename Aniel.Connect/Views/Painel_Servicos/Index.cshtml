    function Fix_Filtro() {
        $(document).ready(async function () {


            @if(Request.Params["ConfigDemanda"] == "S")
            {
                <text>
            window.localStorage.removeItem("@Html.Raw(StorageName)");
                </text>
            }
            else if(Request.Params["ConfigRoteirizados"] == "S")
            {
                <text>
            window.localStorage.removeItem("@Html.Raw(StorageName)");
                </text>
            }

            const storageItem = window.localStorage.getItem("@Html.Raw(StorageName)")
            let filtros = storageItem ? JSON.parse(storageItem) : [];
            for (const filtro of filtros) {
                if ($(`#${filtro.id}`).attr('type') == 'checkbox' || $(`#${filtro.id}`).attr('type') == 'radio') {
                    $(`#${filtro.id}`).prop('checked', filtro.checked)
                }
                else {
                    $(`#${filtro.id}`).val(filtro.value)
                }
            }

            @if (String.IsNullOrEmpty(Request.Params["DataInicial"]) == false)
            {
                <text>
            $('#iDataInicial').attr("value", "@Request.Params["DataInicial"]")
                </text>
            }
            @if (String.IsNullOrEmpty(Request.Params["DataFinal"]) == false)
            {
                <text>
            $('#iDataFinal').attr("value", "@Request.Params["DataFinal"]")
                </text>
            }
            @if (String.IsNullOrEmpty(Request.Params["GrupoArea"]) == false)
            {
                <text>
            $('#iGrupoArea').attr("value", "@Request.Params["GrupoArea"]")
                </text>
            }
            @if (String.IsNullOrEmpty(Request.Params["Area"]) == false)
            {
                <text>
            $('#iArea').attr("value", "@Request.Params["Area"]")
                </text>
            }
            @if (String.IsNullOrEmpty(Request.Params["Localidade"]) == false)
            {
                <text>
            $('#iLocalidade').attr("value", "@Request.Params["Localidade"]")
                </text>
            }
            @if (String.IsNullOrEmpty(Request.Params["Supervisor"]) == false)
            {
                <text>
            $('#iId_Supervisor').attr("value", "@Request.Params["Supervisor"]")
                </text>
            }
            @if (String.IsNullOrEmpty(Request.Params["Monitor"]) == false)
            {
                <text>
            $('#iId_Monitor').attr("value", "@Request.Params["Monitor"]")
