                    customize: function (xlsx) {
                        // Convertendo as células para tipo texto
                        var sheet = xlsx.xl.worksheets['sheet1.xml'];
                        var styles = xlsx.xl['styles.xml'];

                        // Insere novo estilo no excel e encontra a posição do estilo inserido
                        var textStyleId = '<xf numFmtId="49" fontId="0" fillId="0" borderId="0" xfId="0" applyNumberFormat="1"/>';
                        var lastXfIndex = styles.getElementsByTagName('cellXfs')[0].childElementCount;
                        styles.getElementsByTagName('cellXfs')[0].insertAdjacentHTML('beforeend', textStyleId);

                        styles.getElementsByTagName('cellXfs')[0].setAttribute('count', lastXfIndex + 1);

                        // Aplica o estilo em todas as linhas
                        $('row c', sheet).each(function () {
                            var cell = $(this);
                            var cellValue = cell.text();

                            // Função para escapar caracteres especiais no XML
                            function escapeXml(unsafe) {
                                return unsafe.replace(/[<>&'"]/g, function (c) {
                                    switch (c) {
                                        case '<': return '&lt;';
                                        case '>': return '&gt;';
                                        case '&': return '&amp;';
                                        case '\'': return '&apos;';
                                        case '"': return '&quot;';
                                    }
                                });
                            }

                            cell.attr('s', lastXfIndex);
                            cell.attr('t', 'inlineStr');
                            var textValue = '<is><t>' + escapeXml(cellValue) + '</t></is>';
                            cell.html(textValue);
                        });
                    },
