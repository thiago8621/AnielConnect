        async function VerificaPagamentoInstalacao(idPlanoProduto) {
            //Evita que, acaso não possua plano, bloqueie a criação da OS
            if (idPlanoProduto) {
                const link = "@CONSTANTES.URLPortal" + "/api/Cobranca_Servicoapi/VerificaPagamentoInstalacao?idPlanoProduto=" + idPlanoProduto;
                try {
                    const data = await $.ajax({
                        url: link,
                        type: "GET",
                        dataType: "json"
                    });

                    if (!data) {
                        return false;
                    }

                    return true;
                } catch (error) {
                    Notificar("Atenção!", "Erro ao verificar pagamento de instalação: ", "warning");
                    return false;
                }
            }
            return false;
        }

        async function VerificaTipoServico(idTipoServico) {

            if (idTipoServico) {
                const link = "@CONSTANTES.URLPortal" + "/api/Cobranca_Servicoapi/VerificaTipoServico?idTipoServico=" + idTipoServico;
                try {
                    const data = await $.ajax({
                    url: link,
                    type: "GET",
                    dataType: "json"
                    });

                    if (!data) {
                        Notificar("Atenção!", "O tipo de serviço selecionado está configurado para não exigir pagamento de instalação.", "info");
                        return false;
                    }
                    return true;
                } catch (error) {
                    Notificar("Atenção!", "Erro ao verificar o tipo de serviço: " + error, "warning");
                    return false;
                }
            }
            return true;
        }

