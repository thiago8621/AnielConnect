            async defer></script>
    <script>
        var disabled = false;
        var desabilitarEdit = false;

        let marcadorAutoComplete;
        let autocomplete;
        let tipoServicoPreCarregado = false;
        let tipoServicoPreenchido = () => $("#iTipo_Servico").val() ? `${$("#iTipo_Servico").val()}` : "";

