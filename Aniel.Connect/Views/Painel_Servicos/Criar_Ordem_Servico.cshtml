        async function VerificarArea() {
            let retorno_submit = await ValidaSubmit();
            if (retorno_submit == false) {
                return false;
            }
            const date = Date.now();
            let plano_Produto = $('#Id_Cliente_Plano_Produto').val();

            let dados = {
                Data: date,
                ClientePlanoId: plano_Produto
            };

            const data = await $.ajax({
                url: baseUrl + "/api/Area_ManutencaoApi/ValidarAreaManutencaoCliConnect",
                type: 'POST',
                data: dados,
                beforeSend: function () {
                    $("#divProgress").show();
                }
            });

            if (data == false) {
                $('#form').submit();
            }
            else {
                Swal.fire({
                    type: 'warning',
                    title: 'A área referente a esse cliente está sob manutenção, deseja criar a OS?',
                    showCancelButton: true,
                    cancelButtonText: 'Não',
                    confirmButtonText: 'Sim'
                }).then((result) => {
                    if (result.value) {
                        $("#divProgress").show();
                        $('#form').submit();
                        console.log('Usuario clicou em sim');
                    }
                    else if (result.dismiss === Swal.DismissReason.cancel) {
                        console.log('Usuario clicou em não');
                        $("#divProgress").hide();
                        return false;
                    }
                });
            }
        }


