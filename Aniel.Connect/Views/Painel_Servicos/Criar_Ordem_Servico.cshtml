                                                    </div>
                                                }
                                                @if (!String.IsNullOrEmpty(tituloAdic_9))
                                                {
                                                    <div class="col-sm-3">
                                                        <div class="form-group">
                                                            <label for="iAdcional_9">@tituloAdic_9:</label>
                                                            @Html.TextBoxFor(m => m.Adcional_9, new { @class = "form-control " + (camposBloqueados.ContainsKey(RsCadastros.ADCIONAL_9) ? "readonly" : ""), @id = "iAdcional_9", @autocomplete = "off" })
                                                        </div>
                                                    </div>
                                                }
                                                @if (!String.IsNullOrEmpty(tituloAdic_10))
                                                {
                                                    <div class="col-sm-3">
                                                        <div class="form-group">
                                                            <label for="iAdcional_10">@tituloAdic_10:</label>
                                                            @Html.TextBoxFor(m => m.Adcional_10, new { @class = "form-control " + (camposBloqueados.ContainsKey(RsCadastros.ADCIONAL_10) ? "readonly" : ""), @id = "iAdcional_10", @autocomplete = "off" })
                                                        </div>
                                                    </div>
                                                }
                                            </div>


                                            <div class="row ml-2">

                                                @if (ViewBag.RealizaAgendamento)
                                                {
                                                    <div class="col-sm-3">
                                                        <button class="mb-2 mt-3 btn btn-primary" onclick="$('#HiddenAgendar').val('S'); return VerificarArea();" name="agendar" type="button"><i class="mr-1 icofont-ui-calendar"></i>@RsCadastros.AGENDAR</button>
                                                        <input type="hidden" name="agendar" id="HiddenAgendar">
                                                    </div>
                                                }

                                            </div>



                                            <div class="col-sm-6 mt-3 ml-2">
                                                <div class="form-group">
                                                    <label for="iObs_OS">@RsCadastros.OBS_CRIACAO_SERVICO</label>
                                                    @Html.TextAreaFor(m => m.Observacao_OS, new { @class = "form-control " + (camposBloqueados.ContainsKey(RsCadastros.OBSERVACAO) ? "readonly" : ""), @id = "iObs_OS", @rows = "5", @Maxlength = 890 })
                                                    @Html.ValidationMessageFor(model => model.Observacao_OS, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>

                            <!--Button Float-->
                            <a href="#" onclick="BotaoCancelar('@Url.Action("Index", "Painel_Servicos")');" class="float-cancel">
                                <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                                    <i class="fas fa-times fa-2x"></i>
                                </div>
                            </a>

                            <a href="#" onclick="$('#HiddenAgendar').val(''); VerificarArea();" class="float-save" id="btnGravar">
                                <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                                    <i class="fas fa-save fa-2x"></i>
                                </div>
                            </a>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- .modal ElementoRede-->
    <div class="modal" id="modal-ElementoRede">
        <div class="modal-dialog modal-lg modal-dialog-centered ">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title text-muted">@RsCadastros.ELEMENTO_REDE</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div style="text-align:right;" class=" pl-4 pr-2">
                        <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.ELEMENTO_REDE" autocomplete="off" style="width:200px;">
                        <a href="#" id="iPesquisar"><i class="la la-search la-2x" style="color: #999; margin-left: 5px;"></i></a>
                    </div>


                    <div id="divTable">
                        <table class="table table-hover nowrap" id="datatable" style="width:100%">
                            <thead class="tb-head">
                            </thead>
                        </table>
                    </div>


                    <div class="container" style="align-content:center;">


                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal-->

    { Html.RenderPartial("~/Views/Acompanhamento_Servico/BuscarGeolocalizacao.cshtml", new BuscarGeolocalizacaoModels()); }
}


<div class="overlay" id="divProgress" style="display:none;">
    <div class="preloaderbar show active">
        <span class="bar"></span>
        <span class="text">@RsCadastros.PROCESSANDO ...</span>
    </div>
</div>


