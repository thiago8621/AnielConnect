        var ModalPergunta = false;

        function NotificarCloseTab() {
            $('form').on('change paste', 'input, select, textarea', function () {
                ModalPergunta = true;
                parent.document.getElementsByClassName('menu_tab active')[0].children[1].setAttribute("onclick", "AvisoSemSalvar();")
            });
        }

        async function AvisoSemSalvar(link) {

            if (ModalPergunta == true) {
                let result = await Swal.fire({
                     title: 'Tem Certeza que deseja sair sem salvar?',
                     text: "Os dados ainda não foram salvos. Ao sair as informações serão perdidas. Deseja sair sem antes gravar?",
                     showCancelButton: true,
                     cancelButtonText: 'Não',
                     confirmButtonText: 'Sim',
                     type: 'question',
                     allowOutsideClick: () => !Swal.isLoading(),
                });

                if (!result.value)
                    return true;

            };

            try {
                parent.document.getElementsByClassName('menu_tab active')[0].children[1].setAttribute("onclick", "closeTab(this);");
            }
            catch { }

            window.location = link;
            ShowPageLoading();
            return true;

        };
