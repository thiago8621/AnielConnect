        async function getGoogleLatLongCli() {
            let link = 'https://maps.googleapis.com/maps/api/geocode/json?key=AIzaSyACnVjpiRnap58taXa7eEQJIVmD8TkoL2g&address=';

            if ($('#iNumeroLogradouro').val()) {

                link = link.concat(GetEnderecoCli());

                try {
                    return await $.getJSON(link, async function (data) {

                        if (data.results[0]) {
                            if (!data.results[0].geometry.location.lat || !data.results[0].geometry.location.lng) {
                                Notificar("@RsBase.ATENCAO_", "@RsPontoEletronico.NAO_FOI_POSSIVEL_LOCALIZAR_LATITUDE", "warning");
                                $("#iLogradouroLongitude").val(null);
                                $("#iLogradouroLatitude").val(null);

                            }
                        }

                        let latitude = data.results[0].geometry.location.lat.toString().replace(".", ",");
                        let longitude = data.results[0].geometry.location.lng.toString().replace(".", ",");

                        $("#iLogradouroLatitude").val(latitude);
                        $("#iLogradouroLongitude").val(longitude);

                    })
                }
                catch (e) {
                    Notificar("@RsPontoEletronico.NAO_FOI_POSSIVEL_LOCALIZAR_LATITUDE", e, "warning");
                }
            }
        }

        function GetEnderecoCli() {

            let endereco = "";

            if ($("#iNumeroLogradouro").val()) {
                endereco += " " + $("#iNumeroLogradouro").val();
            }
            else {
                return false;
            }

            if ($("#iLogradouroBairro").val() != "")
                endereco += " " + $("#iLogradouroBairro").val();
            if ($("#iLogradouroCidade").val() != "")
                endereco += " " + $("#iLogradouroCidade option:selected").text();
            if ($("#iLogradouroUf").val() != "")
                endereco += " " + $("#iLogradouroUf option:selected").text();
            if ($("#iLogradouro").val() != "")
                endereco += " " + $("#iLogradouro").val();
            return endereco;
        }

        $('#iLinkMudarCliente').on('click', function () {

            if ($('#iCadastrarNovoCliente').val().toLowerCase() != 'true') {
                $('#iCadastrarNovoCliente').val(true);
            }

            else {
                $('#iCadastrarNovoCliente').val(false);
                if ($('#iLatitudeMap').val() && $('#iLongitudeMap').val()) {
                    let latlng = {
                        lat: parseFloat($('#iLatitudeMap').val().replace(",", ".")),
                        lng: parseFloat($('#iLongitudeMap').val().replace(",", "."))
                    };

                    const geocoder = new google.maps.Geocoder();
                    geocoder.geocode({ location: latlng }).then(async (response) => {
                            if (response.results[0]) {
                                map.setZoom(11);

                                marcadorAutoComplete = new google.maps.Marker({
                                    position: latlng,
                                    map: map,
                                    draggable: true,
                                    title: "Resultado da Busca"
                                });
                                marcadorAutoComplete.addListener('dragend', handleDragEnd);
                                $('#iConfirmarLocalizacao').show();
                                map.setCenter(latlng);

                                if (response.results[0].address_components.filter(p => p.types.contains("route")).length > 0) {
                                    $('#iLogradouro').val(response.results[0].address_components.filter(p => p.types.contains("route"))[0].long_name);
                                }
                                if (response.results[0].address_components.filter(p => p.types.contains("street_number")).length > 0) {
                                    $('#iNumeroLogradouro').val(response.results[0].address_components.filter(p => p.types.contains("street_number"))[0].long_name);
                                }
                                if (response.results[0].address_components.filter(p => p.types.contains("sublocality_level_1")).length > 0) {
                                    $('#iLogradouroBairro').val(response.results[0].address_components.filter(p => p.types.contains("sublocality_level_1"))[0].long_name);
                                }
                                if (response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_2")).length > 0) {

                                    let cidade = response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_2"))[0].long_name;
                                    let uf = response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_1"))[0].long_name;
                                    await AddSelect("iLogradouroCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidadesDesc",@CONSTANTES.PaginacaoRegistros, null, uf, cidade, "@RsBase.SELECIONE", false);
                                }
                                if (response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_1")).length > 0) {
                                    let uf = response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_1"))[0].long_name;
                                    await AddSelect("iLogradouroUf", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUfDesc",@CONSTANTES.PaginacaoRegistros, null, null, uf, "@RsBase.SELECIONE", false, handleUfCli);
                                }
                                if (response.results[0].address_components.filter(p => p.types.contains("postal_code")).length > 0) {
                                    $('#iCEP').val(response.results[0].address_components.filter(p => p.types.contains("postal_code"))[0].long_name);
                                }

                                $('#iLogradouroLatitude').val($('#iLongitudeMap').val());
                                $('#iLogradouroLongitude').val($('#iLatitudeMap').val());

                            }
                            else {
                                window.alert("No results found");
                            }
                    });
                }
            }
            validandoLinkMudarCliente(this, $('#iCadastrarNovoCliente').val())
        });

        $('#iBuscarEnderecoRede').on('click',async function () {

            const urlGetEnderecoByRede = "@CONSTANTES.URLPortal" + "/api/enderecoapi/GetEnderecoByRede";

            if (!$('#iPop').val() && !$('#iElemento_Rede').val())
            {
                Notificar("@RsBase.ATENCAO_", "Por favor, selecionar o POP ou o Elemento de Rede", "warning");
                $('#iPop').next().find('.select2-selection').addClass('borda-erro');
                $('#iElemento_Rede').next().find('.select2-selection').addClass('borda-erro');
                return;
            }

            let resultado = await $.ajax({
                url: urlGetEnderecoByRede,
                type: "POST",
                data: { IdElementoRede: $('#iElemento_Rede').val(), IdPop: $('#iPop').val() },
                dataType: "json"
            });

            if (resultado.ok)
            {
                let { pais, uf, cidade, bairro, logradouro, complemento, cep, numero, latitude, longitude, cod_Escritorio, cod_Area, cod_Localidade } = resultado.idObjeto;

                $('#iLogradouroLongitude').val(longitude);
                $('#iLogradouroLatitude').val(latitude);
                $('#iLogradouroPais').val(pais);
                $('#iPontoReferencia').val();
                $('#iLogradouroComplemento').val(complemento);
                $('#iLogradouroBairro').val(bairro);
                $('#iNumeroLogradouro').val(numero);
                $('#iLogradouro').val(logradouro);
                $('#iCEP').val(cep);
                await AddSelect("iLogradouroUf", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUfDesc",@CONSTANTES.PaginacaoRegistros, null, null, uf, "@RsBase.SELECIONE", false, handleUfCli);
                await AddSelect("iLogradouroCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidadesDesc",@CONSTANTES.PaginacaoRegistros, null, uf, cidade, "@RsBase.SELECIONE", false);
                if (pais) {
                    await AddSelect("iLogradouroPais", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboPais",@CONSTANTES.PaginacaoRegistros, null, null, pais, "@RsBase.SELECIONE", false);
                }
                await AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, cod_Escritorio, "@RsBase.SELECIONE", grupoAreaBloq, HandleGrupo);
                await AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, cod_Escritorio, cod_Area, "@RsBase.SELECIONE", false, HandleArea);
                await AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, cod_Escritorio, cod_Area, cod_Localidade, "@RsBase.SELECIONE", false);
            }
            else
            {
                Notificar("@RsBase.ATENCAO_", resultado.mensagem, "warning");
                erro = true;
                clicked = false;
            }
        });

        function validandoLinkMudarCliente(element,valor)
        {
            if (valor != 'true') {
                $('#iCadastroNovoCliente').hide();
                $('#iClienteJaExistente').show();
                $(element).html('Cadastrar novo Cliente')
            }
            else {
                $('#iCadastroNovoCliente').show();
                $('#iClienteJaExistente').hide();
                $(element).html('Cliente já Cadastrado');
            }
        }


        function isValidDouble(value) {
            return !isNaN(parseFloat(value)) && isFinite(value);
        }

