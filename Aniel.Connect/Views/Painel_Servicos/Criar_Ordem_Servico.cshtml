        function setAutoComplete() {

            if (!autocomplete) {

                let elementPesquisa = document.getElementById("iPesquisaMap");
                autocomplete = new google.maps.places.Autocomplete(elementPesquisa);
            }
        }
        @*Params abranage os 3 parametros, IdAvo, IdPai e Id*@
        async function carregaComboTipoServico(documentReady, ...ids) {

            if (documentReady) {
                return false;
            }
            else {
                await AddSelect("iTipo_Servico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, `${ids[0]}`, `${ids[1]}`, `${ids[2]}`, "@RsBase.SELECIONE", false, HandleTipo_Servico);
                return true;
            }

        }

        $('input[type=radio][name=buscarEndereco]').change(function () {
            if (this.value == 'endereco') {
                $('#iBuscarEnderecoInput').show();
                $('#iBuscarLatitudeLongitudeInput').hide();
            }
            else if (this.value == 'latitudeLongitude') {
                $('#iBuscarLatitudeLongitudeInput').show();
                $('#iBuscarEnderecoInput').hide();
            }
        });

        async function PesquisaMapaEndereco() {
            try {

                let pesquisa = $("#iPesquisaMap").val();
                var service = new google.maps.places.PlacesService(map);

                var request = {
                    query: pesquisa,
                    fields: ['name', 'geometry'],
                };

                service.findPlaceFromQuery(request, function (results, status) {


                    if (marcadorAutoComplete) {
                        marcadorAutoComplete.setMap(null);
                        $('#iConfirmarLocalizacao').hide();
                    }

                    if (status === google.maps.places.PlacesServiceStatus.OK) {

                        if (results.length > 0) {

                            let latlng = {
                                lat: results[0].geometry.location.lat(),
                                lng: results[0].geometry.location.lng()
                            };

                            marcadorAutoComplete = new google.maps.Marker({
                                position: latlng,
                                map: map,
                                draggable: true,
                                title: "Resultado da Busca"
                            });

                            marcadorAutoComplete.addListener('dragend', handleDragEnd);
                            $('#iConfirmarLocalizacao').show();


                            map.setCenter(results[0].geometry.location);
                        }
                    } else if (status === google.maps.places.PlacesServiceStatus.ZERO_RESULTS) {
                        Notificar("@RsBase.ATENCAO_", "Nenhum resultado foi encontrado para a solicitação. Por favor, verifique a localização.", "warning");
                    } else if (status === google.maps.places.PlacesServiceStatus.UNKNOWN_ERROR) {
                        Notificar("@RsBase.ATENCAO_", "Não foi possível processar a solicitação. Tente novamente mais tarde!", "warning");
                    } else if (status === google.maps.places.PlacesServiceStatus.NOT_FOUND) {
                        Notificar("@RsBase.ATENCAO_", "O lugar referenciado não foi encontrado! Por favor, verifique a localização.", "warning");
                    }
                });

            }
            catch (e) { console.log(e) }
        }

        async function PesquisaMapaLatitudeLongitude() {
            try
            {
                let latlng = {
                    lat: parseFloat($('#iLatitudeMap').val().replace(",", ".")),
                    lng: parseFloat($('#iLongitudeMap').val().replace(",", "."))
                };

                if (marcadorAutoComplete)
                {
                    marcadorAutoComplete.setMap(null);
                    $('#iConfirmarLocalizacao').hide();
                }

                const geocoder = new google.maps.Geocoder();
                geocoder
                    .geocode({ location: latlng })
                    .then(async (response) => {
                        if (response.results[0]) {
                            map.setZoom(11);

                            marcadorAutoComplete = new google.maps.Marker({
                                position: latlng,
                                map: map,
                                draggable: true,
                                title: "Resultado da Busca"
                            });
                            marcadorAutoComplete.addListener('dragend', handleDragEnd);
                            $('#iConfirmarLocalizacao').show();
                            map.setCenter(latlng);
                        }
                        else {
                            window.alert("No results found");
                        }
                    })

            }
            catch (e) { console.log(e) }
        }

        function showPosition(position) {
            let latlng = { lat: position.coords.latitude, lng: position.coords.longitude };
            map.setCenter(latlng);
        }

        function getLocation() {
            if ($('#iLogradouroLatitude').val() && $('#iLogradouroLongitude').val())
            {
                let latlng = { lat: parseFloat($('#iLogradouroLatitude').val().replace(",", ".")), lng: parseFloat($('#iLogradouroLongitude').val().replace(",", ".")) };
                map.setCenter(latlng);

                marcadorAutoComplete = new google.maps.Marker({
                    position: latlng,
                    map: map,
                    draggable: true,
                    title: "Resultado da Busca"
                });

                marcadorAutoComplete.addListener('dragend', handleDragEnd);

            }
            else {
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(showPosition);
                } else {
                    Notificar("@RsBase.ATENCAO_", "A geolocalização não é suportada por este navegador", "warning");
                }
            }
        }

        function handleDragEnd(event) {

            if ($('input[name=buscarEndereco]:checked').val() == "latitudeLongitude") {
                $('#iLatitudeMap').val(marcadorAutoComplete.position.lat())
                $('#iLongitudeMap').val(marcadorAutoComplete.position.lng())
            }

            $('#iConfirmarLocalizacao').show();
        }

        $('#iConfirmarLocalizacao').click(function () {
            $('#iConfirmarLocalizacao').hide();
            let latlng = null;

            if ($('input[name=buscarEndereco]:checked').val() == "endereco") {
                $('#iLogradouroLatitude').val(marcadorAutoComplete.position.lat())
                $('#iLogradouroLongitude').val(marcadorAutoComplete.position.lng())

                latlng = {
                     lat: marcadorAutoComplete.position.lat(),
                     lng:  marcadorAutoComplete.position.lng()
                };
            }
            else if ($('input[name=buscarEndereco]:checked').val() == "latitudeLongitude") {
                latlng = {
                    lat: parseFloat($('#iLatitudeMap').val().replace(",", ".")),
                    lng: parseFloat($('#iLongitudeMap').val().replace(",", "."))
                };

                $('#iLogradouroLongitude').val($('#iLongitudeMap').val());
                $('#iLogradouroLatitude').val($('#iLatitudeMap').val());

            }

            const geocoder = new google.maps.Geocoder();
            geocoder
                .geocode({ location: latlng })
                .then(async (response) => {
                    if (response.results[0]) {
                        map.setZoom(11);

                        marcadorAutoComplete = new google.maps.Marker({
                            position: latlng,
                            map: map,
                            draggable: true,
                            title: "Resultado da Busca"
                        });
                        marcadorAutoComplete.addListener('dragend', handleDragEnd);
                        $('#iConfirmarLocalizacao').show();
                        map.setCenter(latlng);

                        if (response.results[0].address_components.filter(p => p.types.contains("route")).length > 0) {
                            $('#iLogradouro').val(response.results[0].address_components.filter(p => p.types.contains("route"))[0].long_name);
                        }
                        if (response.results[0].address_components.filter(p => p.types.contains("street_number")).length > 0) {
                            $('#iNumeroLogradouro').val(response.results[0].address_components.filter(p => p.types.contains("street_number"))[0].long_name);
                        }
                        if (response.results[0].address_components.filter(p => p.types.contains("sublocality_level_1")).length > 0) {
                            $('#iLogradouroBairro').val(response.results[0].address_components.filter(p => p.types.contains("sublocality_level_1"))[0].long_name);
                        }

                        if (response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_1")).length > 0) {
                            let uf = response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_1"))[0].short_name;
                            await AddSelect("iLogradouroUf", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUfDesc",@CONSTANTES.PaginacaoRegistros, null, null, uf, "@RsBase.SELECIONE", false, handleUfCli);
                        }
                        if (response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_2")).length > 0) {

                            let cidade = response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_2"))[0].long_name;
                            let uf = response.results[0].address_components.filter(p => p.types.contains("administrative_area_level_1"))[0].short_name;
                            await AddSelect("iLogradouroCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidadesDesc",@CONSTANTES.PaginacaoRegistros, null,uf,cidade, "@RsBase.SELECIONE", false);
                        }

                        if (response.results[0].address_components.filter(p => p.types.contains("postal_code")).length > 0) {
                            $('#iCEP').val(response.results[0].address_components.filter(p => p.types.contains("postal_code"))[0].long_name);
                        }

                        if (response.results[0].address_components.filter(p => p.types.contains("country")).length > 0) {
                            let pais = response.results[0].address_components.filter(p => p.types.contains("country"))[0].long_name;
                            await AddSelect("iLogradouroPais", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboPaisDescricao",@CONSTANTES.PaginacaoRegistros, null, null, pais, "@RsBase.SELECIONE", false);
                        }

                    }
                    else {
                        window.alert("No results found");
                    }
                }
            )

            $('#modal-filter').modal('hide');
        });

