        async function ValidaSubmit() {
            $("#divProgress").show();
            if (clicked) {
                $("#divProgress").hide();
                return false;
            }

            clicked = true;
            erro = false;

            let tipoCliente = $("#iRdTipoC").is(':checked');

            if ("@Model.Exige_Pagamento_Instalacao" == "@Resources.RsBase.SIM") {
                Notificar("@RsBase.ATENCAO_", "Não é possível agendar este serviço, pois o cliente ainda não realizou o pagamento da instalação", "warning");
                erro = true;
                clicked = false;
            }

            if (tipoCliente && $('#iPlano_Produto').val() == "" && criarOsSemPlanoProduto == false && $("#iClienteProspecto").val() == false && permiteOsLead == false) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, @RsCadastros.PLANO_PRODUTO)", 'warning');
                erro = true;
                clicked = false;
            }

            if (!$('#iTipo_Servico').val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, @RsCadastros.TIPO_SERVICO)", 'warning');
                $('#iTipo_Servico').next().find('.select2-selection').addClass('borda-erro');
                erro = true;
                clicked = false;
            }

            const tipoServExigePagInstalacao = await VerificaTipoServico($('#iTipo_Servico').val());

            if (tipoServExigePagInstalacao) {
                const possuiPagamentoAberto = await VerificaPagamentoInstalacao($("#iPlano_Produto option:selected").attr("twovalue")); //o select esta colocando dinamicamente em um prop o valor do clientePlano

                if (possuiPagamentoAberto) {
                    Notificar("@RsBase.ATENCAO_", "Não foi possível criar uma Ordem de Serviço", 'warning');
                    Notificar("@RsBase.ATENCAO_", "Cliente possuí uma fatura de instalação pendente de pagamento.", 'warning');
                    erro = true;
                    clicked = false;
                }
            }

            let logradouroLatitude = $('#iLogradouroLatitude').val().replace(",", ".");
            let LagradouroLongitude = $('#iLogradouroLongitude').val().replace(",", ".");

            if (!isValidDouble(logradouroLatitude) && logradouroLatitude)
