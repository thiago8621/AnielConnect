@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = RsCadastros.RELATORIO_MATERIAIS_APLICADOS_RETIRADOS_ANALITICO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>

}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>
    <script>
        var oDatatable = null;
        let HandleContrato = function () {
            $('#iContrato').unbind('select2:select select2:unselecting');
            $('#iContrato').on('select2:select select2:unselecting', function (e) {

                Contrato = e.params.data
                if (Contrato) {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, Contrato.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
            });
        };

        function carregaSelect2() {
            AddSelect("iContrato", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleContrato);
            AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iMaterial", "@CONSTANTES.URLPortal/api/Material_TarefaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iFamiliaMaterial", "@CONSTANTES.URLPortal/api/Material_TarefaApi/GetComboFamiliaMaterial", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iGrupoMaterial", "@CONSTANTES.URLPortal/api/Material_TarefaApi/GetComboGrupoMaterial", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iEquipe", "@CONSTANTES.URLPortal/api/EquipeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iNaturezaProducao", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }

        var filter_state = {
            periodo: {
                label: "@RsFinanceiro.PERIODO", getDisplay: () => {

                    var tipo_data = "";
                    switch ($('input[name="tipodata"]:checked').val()) {

                        case "criacao": { tipo_data = "(@RsCadastros.CRIACAO) "; break; }
                        case "agendamento": { tipo_data = "(@RsCadastros.AGENDAMENTO) "; break; }
                        case "baixa" :{ tipo_data = "(@RsCadastros.DIGITACAO) "; break; }
                    }

                    return Boolean($('#iDataInicio').val()) ? tipo_data + ($('#iDataInicio').val() + " a " + $('#iDataFim').val()) : ""

                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            contrato: {
                label: "@RsCadastros.CONTRATO",
                getDisplay: () => { return Boolean($('#iContrato').val()) ? $('#iContrato option:selected').text() : "" },
                onclick: () => {
                    $('#iContrato').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            projeto: {
                label: "@RsCadastros.PROJETO",
                getDisplay: () => { return Boolean($('#iProjeto').val()) ? $('#iProjeto option:selected').text() : "" },
                onclick: () => {
                    $('#iProjeto').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            equipe: {
                label: "@RsCadastros.TECNICO",
                getDisplay: () => { return Boolean($('#iEquipe').val()) ? $('#iEquipe option:selected').text() : "" },
                onclick: () => {
                    $('#iEquipe').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            material: {
                label: "@RsCadastros.MATERIAL",
                getDisplay: () => { return Boolean($('#iMaterial').val()) ? $('#iMaterial option:selected').text() : "" },
                onclick: () => {
                    $('#iMaterial').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            classificacaoMaterial : {
                label: "@RsCadastros.CLASSIFICAO_MATERIAL",
                getDisplay: () => { return Boolean($('#iClassificacaoMaterial').val()) ? $('#iClassificacaoMaterial option:selected').text() : "" },
                onclick: () => {
                    $('#iClassificacaoMaterial').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            naturezaProducao : {
                label: "@RsCadastros.NATUREZA",
                getDisplay: () => { return Boolean($('#iNaturezaProducao').val()) ? $('#iNaturezaProducao option:selected').text() : "" },
                onclick: () => {
                    $('#iNaturezaProducao').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            tipo_servico : {
                label: "@RsCadastros.TIPO_SERVICO",
                getDisplay: () => { return Boolean($('#iTipoServico').val()) ? $('#iTipoServico option:selected').text() : "" },
                onclick: () => {
                    $('#iTipoServico').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            familia : {
                label: "@RsCadastros.FAMILIA_MATERIAL",
                getDisplay: () => { return Boolean($('#iFamiliaMaterial').val()) ? $('#iFamiliaMaterial option:selected').text() : "" },
                onclick: () => {
                    $('#iFamiliaMaterial').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            grupo_familia : {
                label: "@RsCadastros.GRUPO_MATERIAL",
                getDisplay: () => { return Boolean($('#iGrupoMaterial').val()) ? $('#iGrupoMaterial option:selected').text() : "" },
                onclick: () => {
                    $('#iGrupoMaterial').val(null).trigger("change")
                    oDatatable.draw();
                }
            }
        }

        function RenderQuantidadeRelatorio(data, type, row, meta) {
            if (data === null || data === undefined) return "0,00";
            else {
                if (type === "export")
                    return data
                        .replace(".", "")
                        .replace(",", ".");
                else {

                    return data;
                }
            }
        }

        const datatable_columns = [
            { data: "contrato_aniel", className: "text-center", title: "@RsCadastros.CONTRATO", orderable: false, visible: true },
            { data: "projeto", className: "text-center", title: "@RsCadastros.PROJETO", orderable: false },
            { data: "contrato_cliente", className: "text-center", title: "Contrato Cliente", orderable: false },
            { data: "cod_equipe", className: "text-center", title: "@RsCadastros.EQUIPE", orderable: false },
            { data: "nome_equipe", className: "text-center", title: "Nome Técnico", orderable: false },
            { data: "cpf_cnpj_cliente", className: "text-center", title: "@RsCadastros.CPFCNPJ", orderable: false },
            { data: "nome_cliente", className: "text-center", title: "@RsCadastros.CLIENTE", orderable: false },
            { data: "id_cliente", className: "text-center", title: "@RsCadastros.IDENTIFICACAO_CLIENTE", orederable: false },
            {
                data: "os", className: "text-center", title: "@RsCadastros.NUMERO_OS", orderable: false,
                render: function (data, type) {
                    return type === 'export' ? '\u200C' + data : data;
                }
            },
            { data: "status_os", className: "text-center", title: "@RsCadastros.STATUS_OS", orderable: false },
            { data: "cod_encerramento", className: "text-center", title: "@RsCadastros.CODIGO_ENCERRAMENTO", orderable: false },
            { data: "descricao_encerramento", className: "text-center", title: "@RsCadastros.DESCRICAO_ENCERRAMENTO", orderable: false },
            { data: "data_servico", className: "text-center", title: "@RsCadastros.DATA_HORA_AGENDAMENTO", orderable: false },
            { data: "cod_tipo_serv", className: "text-center", title: "@RsCadastros.TIPO_SERVICO", orderable: false },
            { data: "desc_tipo_serv", className: "text-center", title: "Descrição Tipo de Serviço", orderable: false },
            { data: "cod_sub_tipo_serv", className: "text-center", title: "@RsCadastros.SUBTIPO_SERVICO", orderable: false },
            { data: "desc_sub_tipo_serv", className: "text-center", title: "Descrição Subtipo de Serviço", orderable: false },
            { data: "segmento", className: "text-center", title: "@RsCadastros.SEGMENTO", orderable: false },
            { data: "cod_material", className: "text-center", title: "@RsCadastros.CODIGO_MATERIAL", orderable: false },
            { data: "nome_material", className: "text-center", title: "@RsCadastros.NOME_MATERIAL", orderable: false },
            { data: "unidade", className: "text-center", title: "@RsCadastros.UNIDADE", orderable: false },
            { data: "num_serie", className: "text-center", title: "@RsCadastros.CODIGO_COMPLEMENTAR", orderable: false },
            { data: "qtde_aplicada", className: "text-center", title: "@RsCadastros.QUANTIDADE_APLICADA", orderable: false, render: RenderQuantidadeRelatorio },
            { data: "qtde_removida", className: "text-center", title: "@RsCadastros.QUANTIDADE_REMOVIDA", orderable: false, render: RenderQuantidadeRelatorio },
            { data: "valor_unitario", className: "text-center", title: "@RsCadastros.VALOR_UNITARIO", orderable: false, render: RenderValorRelatorio },
            { data: "total_aplicado", className: "text-center", title: "@RsCadastros.TOTAL_APLICADO", orderable: false, render: RenderValorRelatorio },
            { data: "total_removido", className: "text-center", title: "@RsCadastros.TOTAL_REMOVIDO", orderable: false, render: RenderValorRelatorio },
            { data: "hora", className: "text-center", title: "@RsCadastros.HORA", orderable: false },
            { data: "data", className: "text-center", title: "@RsCadastros.DATA", orderable: false },
            { data: "usuario", className: "text-center", title: "@RsCadastros.USUARIO", orderable: false }
        ];


        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {

            $('#iNaturezaProducao').val(null).trigger('change');
            $('#iSupervisor').val(null).trigger('change');
            $('#iTipoServico').val(null).trigger('change');
            $('#iEquipe').val(null).trigger('change');
            $('#iGrupoMaterial').val(null).trigger('change');
            $('#iFamiliaMaterial').val(null).trigger('change');
            $('#iMaterial').val('').trigger('change');
            $('#iProjeto').val(null).trigger('change');
            $('#iContrato').val(null).trigger('change');
            $('#iClassificacaoMaterial').val(null).trigger('change');

            carregaSelect2()
            if (oDatatable != null) {
                oDatatable.draw()
            }
        })

        $(document).ready(async () => {
            $('#modal-filter').modal('show')
            carregaSelect2()
        })

        "use strict";

        var handleDataTableButtons = function () {

                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                    //columnDefs: [{
                    //    targets: "0",
                    //    searchable: false,
                    //    orderable: false,
                    //    width: '1%',
                    //    className: 'dt-body-center',
                    //    render: function (data, type, full, meta) {
                    //        return "<input type='checkbox'></input>";
                    //    }
                    //},
                    //{
                    //    targets: 1,
                    //    searchable: false,
                    //    orderable: false,
                    //    width: '1%',
                    //    className: 'dt-body-center'
                        //}
                    //],
                    select: 'multi',
                    order: [[4, 'asc']],
                    serverSide: true,
                    searching: true,
                    ordering: true,
                    paging: true,
                    deferRender: true,
                    scrollResize: true,
                    scrollY: '79vh',
                    stateSave: true,
                    scrollX: true,
                    initComplete: dataTableInitComplete,
                    lengthMenu: [[10, 25, 50, 100, 250, 750, 1000], [10, 25, 50, 100, 250, 750, 1000]],
                    ajax: {
                        url: baseUrl + '/api/Material_TarefaApi/RelatorioMateriaisAplicadosRetiradosAnalitico',
                        type: 'POST',
                        async: true,
                        data: function (data) {
                            data.Data_Inicio = $('#iDataInicio').val();
                            data.Data_Fim = $("#iDataFim").val();
                            data.Tipo_Data = $('input[name="tipodata"]:checked').val();
                            data.Equipe = $('#iEquipe').val();
                            data.Supervisor = $('#iSupervisor').val();
                            data.Cod_Tipo_Serv = $('#iTipoServico').val();
                            data.Contrato = $('#iContrato').val();
                            data.Projeto = $('#iProjeto').val();
                            data.CodMat = $('#iMaterial').val();
                            data.ClassificacaoMaterial = $('#iClassificacaoMaterial').val();
                            data.FamiliaMaterial = $('#iFamiliaMaterial').val();
                            data.GrupoMaterial = $('#iGrupoMaterial').val();
                            data.Id_NaturezaProducao = $('#iNaturezaProducao').val();
                        },
                        error: function (e) {
                            console.log(e);
                            if (e.error !== "") {
                                Notificar("@RsBase.ATENCAO_", "Ocorreu um erro ao gerar o relatório.", "warning");
                                console.log(e)
                            }
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
                    },
                    preDrawCallback: function () {
                        ShowPageLoading();
                    },
                    drawCallback: function () {
                        HidePageLoading();
                    },
                    pageLength: 10,
                    order: [],
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTableRelatorioPaginado({
                        title: "@Html.Raw(ViewBag.Title)",
                        pageSize: GetPageSizePDF(datatable_columns)
                    }),
                    columns: datatable_columns
                });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });


                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    rows_selected = [];
                });
            },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days') + 1) > 31) {
                    Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 31 dias", "warning");
                    return false
                }
            }

            if (oDatatable == null) {
                TableManageButtons.init();
            }
            else {
                oDatatable.draw()
            }

            $('#modal-filter').modal('hide')


        }

    </script>
}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-cogs"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">


                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>
                </div>

            </div>
        </div>

    </div>
    <div id="divSubTitle">
        <div id="FiltrosUtilizados" class="mr-2 ml-2 form-inline"></div>
        <div class="mr-2 ml-2 form-inline mt-1 fs-12">@(String.Format(RsFinanceiro.EMITIDO_POR_EM_AS, User.Identity.GetUserName(), DateTime.Now.ToString("dd/MM/yyyy"), DateTime.Now.ToString("HH:mm")))</div>
    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="form-group border_radius">
                    <div class="" style="display: grid;place-items:center">
                        <div class="">
                            <input type="radio" value="agendamento" id="iDataAgendamento" name="tipodata" checked /> <label for="iDataAgendamento">@RsCadastros.DATA_AGENDAMENTO</label>
                            <input type="radio" value="digitacao" class="ml-2" id="iDataDigitacao" name="tipodata" /> <label for="iDataDigitacao">@RsCadastros.DATA_DIGITACAO</label>
                            <input type="radio" value="movimentacao" class="ml-2" id="iDataMovimentacao" name="tipodata" /> <label for="iDataMovimentacao">@RsCadastros.DATA_MOVIMENTACAO</label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col form-inline text-center mt-1" style="display:block">
                            <input class="form-control obrigatorio datepicker-period mb-1"
                                   id="iDataInicio"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />

                            <span class="pl-3 pr-3">@RsBase.A</span>

                            <input class="form-control obrigatorio datepicker-period  mb-1"
                                   id="iDataFim"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iContrato">@RsCadastros.CONTRATO:</label>
                            <select class="form-control" id="iContrato"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iProjeto">@RsCadastros.PROJETO:</label>
                            <select class="form-control" id="iProjeto"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.SUPERVISOR:</label>
                            <select class="form-control" id="iSupervisor"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iEquipe">@RsCadastros.TECNICO:</label>
                            <select class="form-control" id="iEquipe"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iMaterial">@RsCadastros.MATERIAL:</label>
                            <select class="form-control" id="iMaterial"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iClassificacaoMaterial">@RsCadastros.CLASSIFICAO_MATERIAL:</label>
                            <select class="form-control" id="iClassificacaoMaterial">
                                <option value="">@RsBase.SELECIONE</option>
                                <option value="1">@RsCadastros.INSTALACAO</option>
                                <option value="2">@RsCadastros.DEFEITO</option>
                                <option value="3">@RsCadastros.DEF_ESTOQUE</option>
                                <option value="4">@RsCadastros.RETIRADA</option>
                                <option value="5">@RsCadastros.REAPROVEITADO</option>
                                <option value="6">@RsCadastros.SUCATA</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iFamiliaMaterial">@RsCadastros.FAMILIA_MATERIAL:</label>
                            <select class="form-control" id="iFamiliaMaterial"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iGrupoMaterial">@RsCadastros.GRUPO_MATERIAL:</label>
                            <select class="form-control" id="iGrupoMaterial"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iNaturezaProducao">@RsCadastros.NATUREZA_PRODUCAO:</label>
                            <select class="form-control" id="iNaturezaProducao"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iTipoServico">@RsCadastros.TIPO_SERVICO:</label>
                            <select class="form-control" id="iTipoServico"></select>
                        </div>
                    </div>
                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
