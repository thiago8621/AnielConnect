            { data: "desconto", className: "text-center", title: "@RsCadastros.VALOR_DESCONTO", orderable: false },
            { data: "acressimo", className: "text-center", title: "@RsCadastros.VALOR_ACRESSIMO", orderable: false },
            { data: "valorTotal", className: "text-center", title: "@RsCadastros.VALOR_APL_CONTRATO", orderable: false },
            { data: "bairro", className: "text-center", title: "@RsCadastros.BAIRRO", orderable: false },
            { data: "cidade", className: "text-center", title: "@RsCadastros.CIDADE", orderable: false }

        ];

        function CalculaTotalColunaDataTable(
            rows,
            colunas,
            group,
            columns_length,
            level,
            calculoPorcentagem = false
        ) {
            //settings, api, colunas,coluna_grupo

            if (!group) group = "Sem Grupo";

            var retorno = {
                string_append: "",
                array_colunas_calculadas: []
            };

            var valores = [];

            colunas.forEach(function (item, index) {
                var sum = item.porcentagem == false ? rows
                        .data()
                        .pluck(item.nome)
                        .reduce(function (a, b) {
                            return item.funcao_principal(a, b);
                        }, 0) : Math.round(rows
                            .data()
                            .pluck(item.nome)
                            .reduce(function (a, b) {
                                return item.funcao_principal(a, b);
                            }, 0) / rows.data().toArray().length,2) + '%';

                var obj = {
                    valor: sum,
                    index_coluna: item.index_coluna,
                    cor: item.funcao_cor,
                    lista_coluna_alteracao: item.lista_coluna_alteracao,
                    classNameList: item.classNameList
                };

                valores.push(obj);
            });

            var valores_ordenados_coluna = valores.sort(
                (a, b) => a.index_coluna - b.index_coluna
            );
            retorno.array_colunas_calculadas = valores_ordenados_coluna;

            retorno.string_append = tituloRowGroup(group, level);

            if (retorno.string_append) {
                for (let j = 0; j < valores_ordenados_coluna.length; j++) {
                    var classes_css = "";

                    valores_ordenados_coluna[j].classNameList.forEach(function (item) {
                        classes_css += item;
                    });

                    var obj_coluna = valores_ordenados_coluna[j];
                    let cor = obj_coluna.cor ? obj_coluna.cor(obj_coluna.valor) : "#5f5f5f";

                    retorno.string_append += preencheColunasAnteriores(valores, j);
                    retorno.string_append += `<td data_column=${
                        obj_coluna.index_coluna
                        } style="color:${cor};" class="${classes_css}" colspan="1"><label class="${classes_css}">${
                        obj_coluna.valor
                        }</label></td>`;
                }

                if (valores_ordenados_coluna.length !== 0) {
                    retorno.string_append += preencheColunasRestantes(
                        valores,
                        columns_length
                    );
                } else {
                    for (let i = 1; i < columns_length; i++) {
                        retorno.string_append += "<td></td>";
                    }
                }
            }

            return retorno;
        };

        var handleDataTableButtons = function () {

                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                    lengthMenu: [[10, 25, 50, 100, 250, 750, 1000], [10, 25, 50, 100, 250, 750, 1000]],
                    pageLength: 10,
                    scrollResize: true,
                    scrollY: '79vh',
                    stateSave: true,
                    scrollX: true,
                    serverSide: true,
                    searching: true,
                    ordering: true,
                    paging: true,
                    deferRender: true,
                    language: traducaoDataTable,
                    ajax: {
                        url: baseUrl + '/api/relatorioapi/RelatorioContratoCliente',
                        type: 'POST',
                        async: true,
                        data: function (data) {

                            var aguardandoAssinatura = $("#iAguardandoAssinatura").is(":checked") ? $("#iAguardandoAssinatura").val() : null;
                            var ativo = $("#iAtivo").is(":checked") ? $("#iAtivo").val() : null;
                            var suspenso = $("#iSuspenso").is(":checked") ? $("#iSuspenso").val() : null;
                            var cancelado = $("#iCancelado").is(":checked") ? $("#iCancelado").val() : null;
                            var data_inicial = $("#iDataInicial").val();
                            var data_final = $("#iDataFinal").val();
                            var tipoData = $('input[name = "iTipoData"]:checked').val();

                            var statusQuery = "";
                            var statusFlitro = [aguardandoAssinatura, ativo, suspenso, cancelado];
                            // adiciona os status selecionados a uma string no formato "0,1,2,3,..."
                            $.each(statusFlitro, function (key, value) {

                                if (value) {

                                    if (!statusQuery)
                                        statusQuery += value
                                    else
                                        statusQuery += "," + value
                                }
                            });

                            data.CodCliente = $('#iCliente').val();
                            data.Contrato = $('#iContrato').val();
                            data.Bairro = $('#iBairro option:selected').text();
                            data.Cidade = $('#iCidade option:selected').text();
                            data.Agrupamento = $('#iAgrupamento').val();
                            data.Data_Inicial = data_inicial;
                            data.Data_Final = data_final;
                            data.TipoData = tipoData;
                            data.Status = statusQuery;

                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
                    },
                    preDrawCallback: function () {
                        ShowPageLoading();
                    },
                    drawCallback: function () {
                        HidePageLoading();
                        TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                        ResizeTable('divTable');
                    },
                    order: [],
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTableRelatorioPaginado({
                        title: "@Html.Raw(ViewBag.Title)",
                        pageSize: GetPageSizePDF(colunasDatatable)
                    }),
                    columns: colunasDatatable
                });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });

            $('#datatable tbody').on('click', 'tr.dtrg-level-0', function () {

                var rowsCollapse = $(this).nextUntil('.dtrg-level-0');

                if (!$(this).hasClass("collapsed") && !$(this).hasClass("not-collapsed")) {
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                else if ($(this).hasClass("collapsed")) {
                    $(this).removeClass("collapsed");
                    $(this).addClass("not-collapsed");
                    rowsCollapse.removeClass("d-none");
                }

                else if ($(this).hasClass("not-collapsed")) {
                    $(this).removeClass("not-collapsed");
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                oDatatable.columns.adjust();
            });
                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    rows_selected = [];
                });
            },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                    Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 30 dias", "warning");
                    return false
                }
            }

            if (oDatatable == null) {
                TableManageButtons.init();
            }
            else {
                oDatatable.draw()
            }

            $('#modal-filter').modal('hide')
        }

    </script>
}
