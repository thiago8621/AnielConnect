                                <div class="col-sm-6">
                                    @Html.CheckBox("Cancelado", false, new { @class = "form-check-input", @id = "iCancelado", @autocomplete = "off", @value = "4" })
                                    <label for="iCancelado">@RsCadastros.CANCELADO</label>
                                </div>
                                <div class="col-sm-6">
                                    @Html.CheckBox("Todas", false, new { @class = "form-check-input", @id = "iTodas", @autocomplete = "off", @value = "0" })
                                    <label for="iTodas">@RsCadastros.TODAS</label>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="row border_radius">
                    <div class="col-sm-7">
                        <div class="form-group">
                            <label>Período:</label>
                            <div class="custom-control custom-radio">
                                <input type="radio" id="iDataCriacao" name="iTipoData" value="0" /><label for="iDataCriacao">@RsCadastros.DATA_CRIACAO</label>
                            </div>
                            <div class="custom-control custom-radio">
                                <input type="radio" id="iDataAssinatura" name="iTipoData" value="1" /><label for="iDataAssinatura">@RsCadastros.DATA_TERMO_ASSINADO</label>
                            </div>
                            <div class="custom-control custom-radio">
                                <input type="radio" id="iDataVencimento" name="iTipoData" value="2" /><label for="iDataVencimento">@RsCadastros.DATA_VENCIMENTO</label>
                            </div>
                            <div class="custom-control custom-radio">
                                <input type="radio" id="iDataCancelamento" name="iTipoData" value="3" /><label for="iDataCancelamento">@RsCadastros.DATA_CANCELAMENTO</label>
                            </div>
                            <div class="custom-control custom-radio">
                                <input type="radio" id="iDataSuspensao" name="iTipoData" value="4" /><label for="iDataSuspensao">@RsCadastros.DATA_SUSPENSAO</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-5">
                        <div class="form-group form-inline" style="height:100%; vertical-align:middle;">

                            <label for="iDataInicial">@RsCadastros.PERIODOABERTURA:</label>
                            @*@Html.TextBoxFor(model => model.DataInicial, new { @tabindex = "1", @class = "form-control col-sm-3 ml-2 mr-2 datepicker", @data_provide = "datepicker", @id = "iDataInicial" })*@
                            <input type="text" class="form-control datepicker" placeholder="00/00/0000" id="iDataInicial" />

                            <span>@RsBase.A</span>

                            @*@Html.TextBoxFor(model => model.DataFinal, new { @tabindex = "2", @class = "form-control col-sm-3 ml-2 mr-2 datepicker", @data_provide = "datepicker", @id = "iDataFinal" })*@
                            <input type="text" class="form-control datepicker" placeholder="00/00/0000" id="iDataFinal" />
                        </div>
                    </div>
                </div>
                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatableFunction(); $('#modal-filter').modal('hide');" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
