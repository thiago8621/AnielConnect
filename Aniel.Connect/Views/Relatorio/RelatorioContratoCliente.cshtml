            { data: "dtFinal", className: "text-center", title: "@RsCadastros.VIGENCIA_CONTRATO", orderable: false },
            { data: "status", className: "text-center", title: "@RsCadastros.STATUS_CONTRATO", orderable: false },
            { data: "dtSuspensao", className: "text-center", title: "@RsCadastros.DATA_CANCELAMENTO", orderable: false },
            { data: "dtCancelado", className: "text-center", title: "@RsCadastros.DATA_CANCELAMENTO", orderable: false },
