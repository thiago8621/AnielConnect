@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = RsCadastros.RELATORIO_CUSTOS_SERVICO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />

    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
            margin-right: 25px !important;
        }


        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }

        .swal-wide {
            width: 450px !important;
        }
        .toggle.btn {
            min-width: 3.7rem;
            min-height: 0.15rem;
            border-radius: 1rem;
            width: 6rem !important;
            height: 23px !important;
        }
    </style>

}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>
    <script>
        var oDatatable = null;

         var HandleContrato = function () {

            $('#iContrato').unbind('select2:select select2:unselecting');
            $('#iContrato').on('select2:select select2:unselecting', function (e) {

                Contrato = e.params.data
                if (Contrato) {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, Contrato.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
            });
        };

         var HandleEmpresa = function () {

            $('#iEmpresa').unbind('select2:select select2:unselecting');
             $('#iEmpresa').on('select2:select select2:unselecting', function (e) {

                Empresa = e.params.data
                 if (Empresa) {
                     AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, Empresa.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                     AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
            });
        };

        function RenderValorRelatorio(data, type, row, meta) {
            if (data === null || data === undefined) return "0,00";
            else {
                if (type === "export")
                    return data
                        .replace("R$ ", "")
                        .replace("R$", "")
                        .replace(".", "")
                        .replace(",", ".");
                else {

                    return data;
                }
            }
        }

        var HandleNatureza = function () {

            $('#iNaturezaServico').unbind('select2:select select2:unselecting');
            $('#iNaturezaServico').on('select2:select select2:unselecting', function (e) {

                Natureza = e.params.data
                if (Natureza) {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboTipoServicoNatureza", @CONSTANTES.PaginacaoRegistros, null, Natureza.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboTipoServicoNatureza", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                }
            });
        };

        function carregaSelect2(){
            AddSelect("iContrato", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE",false,HandleContrato);
            AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE",true);
            AddSelect("iEquipe", "@CONSTANTES.URLPortal/api/EquipeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iEmpresa", "@CONSTANTES.URLPortal/api/Empresaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false,HandleEmpresa);
            AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iCentroCusto", "@CONSTANTES.URLPortal/api/CentroCustoApi/CentroCusto", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iNaturezaServico", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        }
     
        var filter_state = {
            periodo: {
                label: "@RsFinanceiro.PERIODO", getDisplay: () => {

                  var tipo_data = "";
                  switch ($('input[name="tipodata"]:checked').val()) {
                        case "servico": { tipo_data = "(@RsCadastros.SERVICO) "; break; }
                  }

                    return Boolean($('#iDataInicio').val()) ? tipo_data + ($('#iDataInicio').val() + " a " + $('#iDataFim').val()) : ""
                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            equipe: {
                label: "@RsCadastros.TECNICO",
                getDisplay: () => { return Boolean($('#iEquipe').val()) ? $('#iEquipe option:selected').text() : "" },
                onclick: () => {
                    $('#iEquipe').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            contrato: {
                label: "@RsCadastros.CONTRATO",
                getDisplay: () => { return Boolean($('#iContrato').val()) ? $('#iContrato option:selected').text() : "" },
                onclick: () => {
                },
                removable: false
            },
            projeto: {
                label: "@RsCadastros.PROJETO",
                getDisplay: () => { return Boolean($('#iProjeto').val()) ? $('#iProjeto option:selected').text() : "" },
                onclick: () => {

                },
                removable: false
            },
            empresa: {
                label: "@RsCadastros.EMPRESA",
                getDisplay: () => { return Boolean($('#iEmpresa').val()) ? $('#iEmpresa option:selected').text() : "" },
                onclick: () => {

                },
                removable: false
            },
            filial: {
                label: "@RsCadastros.FILIAL",
                getDisplay: () => { return Boolean($('#iFilial').val()) ? $('#iFilial option:selected').text() : "" },
                onclick: () => {

                },
                removable: false
            },
            centroCusto: {
                label: "@RsCadastros.CENTROCUSTO",
                getDisplay: () => { return Boolean($('#iCentroCusto').val()) ? $('#iCentroCusto option:selected').text() : "" },
                onclick: () => {

                },
                removable: false
            },
            naturezaServico: {
                label: "@RsCadastros.NATUREZA_SERVICO",
                getDisplay: () => { return Boolean($('#iNaturezaServico').val()) ? $('#iNaturezaServico option:selected').text() : "" },
                onclick: () => {
                $('#iNaturezaServico').val(null).trigger("change")
                oDatatable.draw()
                }
             },

            tipoServico: {
                label: "@RsCadastros.TIPO_SERVICO",
                getDisplay: () => { return Boolean($('#iTipoServico').val()) ? $('#iTipoServico option:selected').text() : "" },
                onclick: () => {
                    $('#iTipoServico').val(null).trigger("change")
                    oDatatable.draw()
                }
            },

        }

        const datatable_columns = [
            { data: "nos", className: "text-center", title: "@RsCadastros.NUMERO_OS", orderable: false },
            { data: "dataAgendamento", className: "text-center", title: "@RsCadastros.DATA_AGENDAMENTO", orderable: false },
            { data: "dataBaixa", className: "text-center", title: "@RsCadastros.DATA_HORA_BAIXA", orderable: false, render: RenderValorRelatorio },
            { data: "naturezaServico", className: "text-center", title: "@RsCadastros.NATUREZA_SERVICO", orderable: false, render: RenderValorRelatorio },
            { data: "contrato", className: "text-center", title: "@RsCadastros.NUMERO_CONTRATO", orderable: false },
            { data: "tecnico", className: "text-center", title: "@RsCadastros.TECNICO", orderable: false, render: RenderValorRelatorio },
            { data: "supervisor", className: "text-center", title: "@RsCadastros.SUPERVISOR", orderable: false, render: RenderValorRelatorio },
            { data: "categoriaCliente", className: "text-center", title: "@RsCadastros.CATEGORIA_CLIENTE", orderable: false },
            { data: "statusEncerramento", className: "text-center", title: "@RsCadastros.ENCERRAMENTO", orderable: false, render: RenderValorRelatorio },
            { data: "descricaoEncerramento", className: "text-center", title: "@RsCadastros.ENCERRAMENTO", orderable: false, render: RenderValorRelatorio },
            { data: "custoMaoObra", className: "text-center", title: "@RsCadastros.CUSTO_MAO_OBRA", orderable: false, render: RenderValorRelatorio },
            { data: "custoMaterial", className: "text-center", title: "@RsCadastros.CUSTO_MATERIAL", orderable: false, render: RenderValorRelatorio },
            { data: "custoProducao", className: "text-center", title: "@RsCadastros.CUSTO_PRODUCAO", orderable: false, render: RenderValorRelatorio }
            
        ];

        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {

            $("#iDataInicio").val(null).trigger('change');
            $("#iDataFim").val(null).trigger('change');
            $('#iEquipe').val(null).trigger('change');
            $('#iEmpresa').val(null).trigger('change');
            $('#iFilial').val(null).trigger('change');
            $('#iCentroCusto').val(null).trigger('change');
            $('#iProducaoPrevista').prop('checked', false).trigger('change')
            $('#iServicoBaixadoMobile').prop('checked', false).trigger('change')
            $('#iServicoDocFisicoDevolvido').prop('checked', false).trigger('change')
            carregaSelect2()
            if (oDatatable != null) {
                oDatatable.draw()
            }
        })

        $(document).ready(async () => {
            $('#modal-filter').modal('show')
            carregaSelect2()
        })

        "use strict";

        var handleDataTableButtons = function () {

            if (oDatatable != null) {
                oDatatable.destroy();
                $("#datatable").empty();
            }
                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                    
                    select: {
                        style: 'multi'
                    },
                    serverSide: true,
                    searching: true,
                    ordering: true,
                    paging: true,
                    deferRender: true,
                    scrollResize: true,
                    scrollY: '66vh',
                    stateSave: true,
                    scrollX: true,
                    fixedHeader: true,
                    initComplete: dataTableInitComplete,
                    drawCallback: () => {

                        HidePageLoading();

                        var agrupamento = ''
                        switch ($('#iAgrupamento').val()) {

                            case "naturezaServico": {
                                agrupamento = '@Html.Raw(RsCadastros.TIPO_SERVICO)'
                                break;
                            }

                        };

                        $("#lbAgrupadoPor").html(`Agrupado por: ${agrupamento}`);

                        TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                        ResizeTable('divTable');
                        if (oDatatable)
                            oDatatable.columns.adjust();
                    },
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: baseUrl + '/api/relatorioapi/RelatorioCustoImpServico',
                        type: 'POST',
                        data: function (data) {
                            data.Data_Inicio = $('#iDataInicio').val();
                            data.Data_Fim = $("#iDataFim").val();
                            data.Tipo_Filtro = $('input[name=tipodata]:checked').val();
                            data.Tipo_Prod = $('input[name=tipoprod]:checked').val();
                            data.Contrato = $('#iContrato').val();
                            data.Projeto = $('#iProjeto').val();
                            data.Empresa = $('#iEmpresa').val();
                            data.Filial = $('#iFilial').val();
                            data.CentroCusto = $('#iCentroCusto').val();
                            data.Tecnico = $('#iEquipe').val();
                            data.Supervisor = $('#iSupervisor').val();
                            data.NaturezaServico = $('#iNaturezaServico').val();
                            data.Tipo_Servico = $('#iTipoServico').val();
                            data.Agrupamento = $('#iAgrupamento').val();
                        },
                 
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            //Mostrar o Total de Ordens de Serviços encontradas
                            if ($('#Count_listing').length === 0)
                                $('.dataTables_length').append($('<label id="Count_listing"></label>'));

                            $("#Count_listing").html(`<div class="form-group col-sm-push-1 ml-2 mt-1">
                              Total de Registros encontrados: <span style="font-weight:bold; margin-right:0px;" id="Total_OS">  &nbsp; `+ d.recordsFiltered + ` </span>
                           </div> `);
                            return d.data;
                        }
                    },
                    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                        var str = "@RsCadastros.INFODATATABLE";
                        if (iTotal == 0) { iEnd = 0; iStart = 0; }
                        str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                        $("#dtLegend").html(str);

                        return "";
                    },
                    pageLength: 10,
                    order: [],
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTableRelatorio({
                        title: "@Html.Raw(ViewBag.Title)",
                        pageSize: GetPageSizePDF(datatable_columns)
                    }),
                    preDrawCallback: function () {
                        ShowPageLoading();
                    },
                    drawCallback: function () {
                        HidePageLoading();
                    },
                    rowGroup: {
                        emptyDataGroup: 'Sem Grupo',
                        dataSrc: [$('#iAgrupamento').val()],
                        startRender: function (rows, group, level) {

                            let colunasGroup = [];

                            datatable_columns.filter(p => p.groupFunc).forEach((col, index) => {
                                colunasGroup.push(ColunaRowGroup(col.data, 7, col.title, 0, col.groupFunc, () => "black", [], ["text-center"]));
                            });

                            var retorno = CalculaTotalColunaDataTable(rows, [], group, $("#datatable").DataTable().columns().visible().filter(p => p == true).length, level);
                            return $('<tr>').append(retorno.string_append);
                        },
                        endRender: function (rows, group) {
                            //if (oDatatable)
                            //    oDatatable.columns.adjust();
                            //else
                            //    $("#datatable").DataTable().columns.adjust();

                            //ResizeTable('divTable');
                        }
                    },
                    columns: datatable_columns
                });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });

            $('#datatable tbody').on('click', 'tr.dtrg-level-0', function () {

                var rowsCollapse = $(this).nextUntil('.dtrg-level-0');

                if (!$(this).hasClass("collapsed") && !$(this).hasClass("not-collapsed")) {
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                else if ($(this).hasClass("collapsed")) {
                    $(this).removeClass("collapsed");
                    $(this).addClass("not-collapsed");
                    rowsCollapse.removeClass("d-none");
                }

                else if ($(this).hasClass("not-collapsed")) {
                    $(this).removeClass("not-collapsed");
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                oDatatable.columns.adjust();
            });

                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    rows_selected = [];
                });
            },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ($("#iDataInicio").val() == null && $("#iDataFim").val() == null) {
                    if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                        Notificar("@RsBase.ATENCAO_", "Para um período maior que 30 dias selecione um contrato", "warning");
                        return false
                    }
                }
            }
            TableManageButtons.init();

            $('#modal-filter').modal('hide')


        }

    </script>
}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="far fa-clock"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">

                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>
                </div>

            </div>
        </div>
    </div>

    <div id="divSubTitle">
        <div id="FiltrosUtilizados" class="mr-2 ml-2 form-inline"></div>
        <div id="lbAgrupadoPor" class="fs-12 mr-2 ml-2 form-inline"></div>
        <div class="mr-2 ml-2 form-inline mt-1 fs-12">@(String.Format(RsFinanceiro.EMITIDO_POR_EM_AS, User.Identity.GetUserName(), DateTime.Now.ToString("dd/MM/yyyy"), DateTime.Now.ToString("HH:mm")))</div>
    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="form-group border_radius">
                    <div class="row container">

                        <div class="col">
                            <input type="radio" value="AGENDAMENTO" id="iDataAgendamento" name="tipodata" checked /> <label for="iDataAgendamento">@RsCadastros.DATA_AGENDAMENTO</label>
                        </div>
                        <div class="col">
                            <input type="radio" value="EXECUCAO" id="iDataExecucao" name="tipodata" /> <label for="iDataExecucao">@RsCadastros.DATA_EXECUCAO</label>
                        </div>
                        <div class="col">
                            <input type="radio" value="CRIACAO" id="iDataCriacao" name="tipodata" /> <label for="iDataCriacao">@RsCadastros.DATA_CRIACAO</label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col form-inline text-center mt-1" style="display:block">
                            <input class="form-control obrigatorio datepicker-period mb-1"
                                   id="iDataInicio"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />

                            <span class="pl-3 pr-3">@RsBase.A</span>

                            <input class="form-control obrigatorio datepicker-period  mb-1"
                                   id="iDataFim"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iEquipe">@RsCadastros.TECNICO:</label>
                            <select class="form-control" id="iEquipe"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.SUPERVISOR:</label>
                            <select class="form-control" id="iSupervisor"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iContrato">@RsCadastros.CONTRATO:</label>
                            <select class="form-control" id="iContrato"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iProjeto">@RsCadastros.PROJETO:</label>
                            <select class="form-control" id="iProjeto"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iProjeto">@RsCadastros.EMPRESA:</label>
                            <select class="form-control" id="iEmpresa"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iProjeto">@RsCadastros.FILIAL:</label>
                            <select class="form-control" id="iFilial"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iProjeto">@RsCadastros.CENTROCUSTO:</label>
                            <select class="form-control" id="iCentroCusto"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
