@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = RsCadastros.RELATORIO_CHECKLIST;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />
    <meta charset="utf-8" />


    <style>
        .toggle.btn {
            min-width: 3.7rem;
            min-height: 0.15rem;
            border-radius: 1rem;
            width: 6rem !important;
            height: 23px !important;
        }
    </style>

}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>
    <script>

        var oDatatable = null;
        let HandleContrato = function () {
            $('#iEmpresa').unbind('select2:select select2:unselecting');

        };
        function carregaSelect2() {
            AddSelect("iContrato", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iTecnico", "@CONSTANTES.URLPortal/api/Equipeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iQuestionario", "@CONSTANTES.URLPortal/api/Quizapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

            AddSelect("iNos", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iTipo_servico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        }

        $('#iContrato').change(function () {
            if ($('#iContrato').val())
            {
                $("#iFilial").prop("disabled", false);
                AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, $('#iContrato').val(), null, "@RsBase.SELECIONE", false);
            }
        });
        $('#modal-filter').on('show.bs.modal', function (event) {
            //$(this).find('input[name=tipodata]').prop('checked', false);
        })

        var filter_state = {

            contrato: {
                label: "@RsCadastros.CONTRATO",
                getDisplay: () => { return Boolean($('#iContrato').val()) ? $('#iContrato option:selected').text() : "" },
                onclick: () => {
                    $('#iContrato').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            projeto: {
                label: "@RsCadastros.PROJETO",
                getDisplay: () => { return Boolean($('#iProjeto').val()) ? $('#iProjeto option:selected').text() : "" },
                onclick: () => {
                    $('#iProjeto').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            tecnico: {
                label: "@RsCadastros.TECNICO",
                getDisplay: () => { return Boolean($('#iTecnico').val()) ? $('#iTecnico option:selected').text() : "" },
                onclick: () => {
                    $('#iTecnico').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            questionario: {
                label: "@RsCadastros.QUESTIONARIO",
                getDisplay: () => { return Boolean($('#iQuestionario').val()) ? $('#iQuestionario option:selected').text() : "" },
                onclick: () => {
                    $('#iQuestionario').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            nos: {
                label: "@RsCadastros.NUMERO_OS",
                getDisplay: () => { return Boolean($('#iNos').val()) ? $('#iNos option:selected').text() : "" },
                onclick: () => {
                    $('#iNos').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            tipo_Servico: {
                label: "@RsCadastros.TIPO_SERVICO",
                getDisplay: () => { return Boolean($('#iTipo_servico').val()) ? $('#iTipo_servico option:selected').text() : "" },
                onclick: () => {
                    $('#iTipo_servico').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
        }

        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {

            $('#iFilial').val(null).trigger('change');
            $('#iNumeroFistel').val('').trigger('change');

            $('#iTipo_servico').val(null).trigger('change');
            $('#iNumeroFistel').val('').trigger('change');
            $('#iEmpresa').val(null).trigger('change');
            $('#iProjeto').val(null).trigger('change');
            $('#iNos').val(null).trigger('change');
            $('#iNos').text('');
            $('#iAnos').val(null).trigger('change');
            $('#iMeses').val(null).trigger('change');
            /*$('input[name=tipodata]').prop('checked', false);*/

            carregaSelect2()
            if ($.fn.DataTable.isDataTable("#datatable")) {
                $("#datatable").DataTable().clear().destroy();
                $('#datatable').empty();
                TableManageButtons.init();
            }
            else {
                TableManageButtons.init();
            }
        })

        $(document).ready(async () => {
            $('#modal-filter').modal('show');
            $('input[type="radio"][value="scm"]').prop('checked', true);
            carregaSelect2();

            $('input[name=tipodata]').on('change', function () {
                if ($(this).val() === 'smp') {
                    $('#iQuestionario').addClass('obrigatorio');
                    $('#obrigatorioModelo02').show();
                } else {
                    $('#iQuestionario').removeClass('obrigatorio');
                    $('#obrigatorioModelo02').hide();
                }
            });

        });

        "use strict";

        var url = "";
        var datatable_columns = [];

        var dynamicColumns = [];
        var datatable_columns1 = [];
        var datatable_columns2 = [];

        async function GetDados() {

            let dados = null;
            let data = {};
            var tipodata = $('input[name = "tipodata"]:checked').val();
            data.dataInicio = $('#iDataInicio').val();
            data.dataFim = $("#iDataFim").val();
            data.contrato = $('#iContrato').val();
            data.projeto = $('#iProjeto').val();
            data.tecnico = $('#iTecnico').val();
            data.questionario = $('#iQuestionario').val();
            data.nos = $('#iNos').val();
            data.Tipo_Servico = $('#iTipo_servico').val();
            data.smp = $('#iModelo01').is(':checked');
            data.scm = $('#iModelo02').is(':checked');
            data.Tipodata = tipodata;

            await $.ajax({
                url: url, 
                type: 'POST',
                dataType: 'json',
                data: data,
                beforeSend: function () {
                    ShowPageLoading();
                },
                complete: function () {
                    HidePageLoading();
                }
            }).done(function (data) {

                if (tipodata == "scm") {
                    datatable_columns = [

                        { data: "codCt", className: "text-center", title: "@RsCadastros.CONTRATO", orderable: false },
                        { data: "projeto", className: "text-center", title: "@RsCadastros.PROJETO", orderable: false },
                        { data: "num_Doc", className: "text-center", title: "@RsCadastros.CONTRATO_CLIENTE", orderable: false },
                        { data: "num_Obra", className: "text-center", title: "@RsCadastros.NUMERO_OS", orderable: false },
                        { data: "data", className: "text-center", title: "@RsCadastros.DATA", orderable: false },
                        { data: "tecnico", className: "text-center", title: "@RsCadastros.TECNICO", orderable: false },
                        { data: "tipo_Servico", className: "text-center", title: "@RsCadastros.TIPO_SERVICO", orderable: false },
                        { data: "sub_Tipo_Servico", className: "text-center", title: "SubTipo de Serviço", orderable: false },
                        { data: "cliente", className: "text-center", title: "@RsCadastros.CLIENTE", orderable: false },
                        { data: "titulo", className: "text-center", title: "@RsCadastros.NOME_QUESTIONARIO", orderable: false },
                        { data: "ordem", className: "text-center", title: "@RsCadastros.ORDEM", orderable: false },
                        { data: "pergunta", className: "text-center", title: "@RsCadastros.PERGUNTA", orderable: false },
                        { data: "resposta", className: "text-center", title: "@RsCadastros.RESPOSTA", orderable: false },

                    ];
                } else {

                    const perguntasUnicas = new Set();

                    data.data.forEach(entry => {
                        entry.listaRespostas.forEach(resposta => {
                            perguntasUnicas.add(resposta.pergunta);
                        });
                    });

                    dynamicColumns = Array.from(perguntasUnicas).map(pergunta => ({
                        data: function (row) {
                            const respostaEncontrada = row.listaRespostas.find(r => r.pergunta === pergunta);
                            return respostaEncontrada ? respostaEncontrada.resposta : '';
                        },
                        className: "text-center",
                        title: pergunta,
                        orderable: false
                    }));

                    datatable_columns = [
                        { data: "carimboDtHr", className: "text-center", title: "@RsCadastros.CARIMBO_DT_HR", orderable: false },
                        { data: "num_Os", className: "text-center", title: "@RsCadastros.CODIGO_OCORRENCIA", orderable: false },
                        { data: "sgci", className: "text-center", title: "@RsCadastros.SGCI", orderable: false },
                        { data: "data", className: "text-center", title: "@RsCadastros.DATA_OCORRENCIA", orderable: false },
                        { data: "tecnico", className: "text-center", title: "@RsCadastros.TECNICO", orderable: false },
                        { data: "codEncerramento", className: "text-center", title: "@RsCadastros.CODIGO_ENCERRAMENTO", orderable: false },
                        { data: "materiais", className: "text-center", title: "@RsCadastros.MATERIAIS_APLICADOS", orderable: false },
                        { data: "localidade", className: "text-center", title: "@RsCadastros.LOCALIDADE", orderable: false }
                    ].concat(dynamicColumns);
                }

                dados = data.data;
            });

            return dados;
        }


        var handleDataTableButtons = async function () {

            // Modelo1 Selecionado
            if ($('input[name = "tipodata"]:checked').val() == "scm") {
                url = baseUrl + '/api/CheckListApi/Modelo01';

            // Modelo2 Selecionado
            } else {
                url = baseUrl + '/api/CheckListApi/Modelo02';
            }

            let dados = await GetDados();


            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                select: {
                    style: 'multi'
                },
                serverSide: false,
                searching: true,
                ordering: false,
                paging: false,
                destroy: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                stateSave: false,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                drawCallback: () => {
                    TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                    ResizeTable('divTable');
                },
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                data: dados,
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                pageLength: 5,
                order: [],
                language: traducaoDataTableSimples,
                buttons: buttonsDataTableRelatorio({
                    title: "@Html.Raw(ViewBag.Title)",
                    pageSize: GetPageSizePDF(datatable_columns)
                }),
                columns: datatable_columns
            });

            //$('#txtSearch').val(oDatatable.search());
            //$('#txtSearch').keyup(function () {
            //    oDatatable.search($(this).val()).draw();
            //});
            //    // Handle table draw event
            //    oDatatable.on('draw', function () {
            //        // Update state of "Select all" control
            //        rows_selected = [];
            //    });
            },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();




        function oDatatableFunction() {
            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(), "DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                    Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 30 dias", "warning");
                    return false
                }
            }

            if ($.fn.DataTable.isDataTable("#datatable")) {
                $("#datatable").DataTable().clear().destroy();
                $('#datatable').empty();
                TableManageButtons.init();
            }
            else {
                TableManageButtons.init();
            }

            $('#modal-filter').modal('hide')
        }

        function filtrarDatatable() {
            $('#datatable').DataTable().ajax.reload();
        }


    </script>
}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-cogs"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">


                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    @*<a class="dropdown-item" href="#" onclick="$('.buttons-csv').click(); return false;"><i class="fas fa-file-csv"></i> @RsCadastros.EXPORTA_CSV</a>
            <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>*@

                </div>

            </div>
        </div>

    </div>
    <div id="divSubTitle">
        <div id="FiltrosUtilizados" class="mr-2 ml-2 form-inline"></div>
        <div class="mr-2 ml-2 form-inline mt-1 fs-12">@(String.Format(RsFinanceiro.EMITIDO_POR_EM_AS, User.Identity.GetUserName(), DateTime.Now.ToString("dd/MM/yyyy"), DateTime.Now.ToString("HH:mm")))</div>
    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="form-group border_radius">
                    <div class="" style="display: grid;place-items:left">
                        <div class="row">
                            <div class="col">
                                <div class="form-group">
                                    <label for="iDataInicio">@RsCadastros.PERIODO:<small style="color: red;"> * </small></label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col">
                                <div class="form-group">
                                    <input class="form-control obrigatorio datepicker-period mb-1"
                                           id="iDataInicio"
                                           type="text"
                                           autocomplete="off"
                                           placeholder="00/00/0000" />

                                    <span class="pl-3 pr-3">@RsBase.A</span>

                                    <input class="form-control obrigatorio datepicker-period  mb-1"
                                           id="iDataFim"
                                           type="text"
                                           autocomplete="off"
                                           placeholder="00/00/0000" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group border_radius">
                    <div class="row">
                        <div class="col">
                            <div class="form-group">
                                <label>Modelo de Visualização:</label>
                            </div>
                        </div>
                    </div>
                    <div class="" style="display: grid;place-items:left">
                        <div class="row">
                            <div class="col-3">
                                <div class="form-group">
                                    <input type="radio" class="ml-2" value="scm" id="iModelo01" name="tipodata" checked /> <label for="iModelo01">@RsCadastros.MODELO01</label>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="form-group">

                                    <input type="radio" value="smp" class="ml-2" id="iModelo02" name="tipodata" /> <label for="iModelo02">@RsCadastros.MODELO02</label>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iContrato">@RsCadastros.CONTRATO:</label>
                            <select class="form-control" id="iContrato"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iProjeto">@RsCadastros.PROJETO:</label>
                            <select class="form-control" id="iProjeto"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iTecnico">@RsCadastros.TECNICO:</label>
                            <select class="form-control" id="iTecnico"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iQuestionario">@RsCadastros.QUESTIONARIO:<small id="obrigatorioModelo02" style="color: red; display: none"> * </small></label>
                            <select class="form-control" id="iQuestionario"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iNos">@RsCadastros.NUMERO_OS:</label>
                            <select class="form-control" id="iNos"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iTipo_servico">@RsCadastros.TIPO_SERVICO:</label>
                            <select class="form-control" id="iTipo_servico"></select>
                        </div>
                    </div>
                </div>


                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatableFunction(); $('#modal-filter').modal('hide');" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
