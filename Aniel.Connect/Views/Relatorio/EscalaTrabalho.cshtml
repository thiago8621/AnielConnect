@model IEnumerable<Aniel.Connect.Models.ClienteListViewModel>
@using Microsoft.AspNet.Identity
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.RELATORIO_ESCALA_TRABALHO;
    ViewBag.Sessao = RsCadastros.RELATORIO_ESCALA_TRABALHO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }


        [data-tooltip] {
            position: relative;
        }

            [data-tooltip]:after {
                display: none;
                position: absolute;
                top: -5px;
                padding: 5px;
                border-radius: 3px;
                left: calc(100% + 2px);
                content: attr(data-tooltip);
                white-space: nowrap;
                background-color: #0095ff;
                color: White;
            }

            [data-tooltip]:hover:after {
                display: block;
            }
    </style>
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")


<script>
        let rows_selected = [];
        let oDatatable;

        var HandleGrupo = function () {
            $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

                GrupoSelecionado  = e.params.data
                if (GrupoSelecionado) {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false);

                }

                else {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };



        $(document).ready(function() {
            AddSelect("iEquipe", "@CONSTANTES.URLPortal/api/EquipeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iMonitor", "@CONSTANTES.URLPortal/api/IdentityUserApi/GetComboUsuarioMonitorEquipe", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupo);
            AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            $('#modal-filter').modal('show');
        });



        $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {
            $("#iSupervisor").val("").trigger('change');
            $("#iEquipe").val("").trigger('change');
            $('#iMonitor').val("").trigger('change');
            $('#iGrupoArea').val("").trigger('change');
            $('#iArea').val("").trigger('change');

            if (oDatatable != null) {
                oDatatable.draw()
            }
        });

       function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                    Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 30 dias!", "warning");
                    return false
                }

                if (momentFinal < momentInicio) {
                    Notificar("@RsBase.ATENCAO_", "A data final não pode ser menor do que a data inicial!", "warning");
                    return false
                }
            }

            ShowPageLoading();
            TableManageButtons.init();
            $('#modal-filter').modal('hide')


    }

        var filter_state = {
            equipe: {
                label: "@RsCadastros.EQUIPE",
                getDisplay: () => { return Boolean($('#iEquipe').val()) ? $('#iEquipe option:selected').text() : "" },
                onclick: () => {
                    $('#iEquipe').val(null).trigger("change")
                    oDatatable.draw()
                }

            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }

            },
            monitor: {
                label: "@RsCadastros.MONITOR",
                getDisplay: () => { return Boolean($('#iMonitor').val()) ? $('#iMonitor option:selected').text() : "" },
                onclick: () => {
                    $('#iMonitor').val(null).trigger("change")
                    oDatatable.draw()
                }

            },
            equipe: {
                label: "@RsCadastros.EQUIPE",
                getDisplay: () => { return Boolean($('#iEquipe').val()) ? $('#iEquipe option:selected').text() : "" },
                onclick: () => {
                    $('#iEquipe').val(null).trigger("change")
                    oDatatable.draw()
                }

            },
            grupo_area: {
                label: "@RsCadastros.GRUPO_AREA",
                getDisplay: () => { return Boolean($('#iGrupoArea').val()) ? $('#iGrupoArea option:selected').text() : "" },
                onclick: () => {
                    $('#iGrupoArea').val(null).trigger("change")
                    $('#iArea').val(null).trigger("change")
                    $('#iLocalidade').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            area: {
                label: "@RsCadastros.AREA",
                getDisplay: () => { return Boolean($('#iArea').val()) ? $('#iArea option:selected').text() : "" },
                onclick: () => {
                    $('#iArea').val(null).trigger("change")
                    $('#iLocalidade').val(null).trigger("change")
                    oDatatable.draw()
                }

            },
            periodo: {
                label: "@RsFinanceiro.PERIODO", getDisplay: () => {

                    return Boolean($('#iDataInicio').val()) ? ($('#iDataInicio').val() + " a " + $('#iDataFim').val()) : ""

                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            situacao: {
                label: "@RsCadastros.SITUACAO",
                getDisplay: () => { return Boolean($('#iSituacao').val()) ? $('#iSituacao option:selected').text() : "" },
                onclick: () => {
                    $('#iSituacao').val(null).trigger("change")
                    oDatatable.draw()
                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },

        }

        var handleDataTableButtons = function () {

            $.fn.dataTable.ext.errMode = 'none';
            "use strict";

            if (oDatatable != null) {
                oDatatable.destroy();
                $("#datatable").empty();
            }
            //"Blfrtip"
            oDatatable = new DataTable("#datatable",{
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti" ,
                columnDefs: [],
                select: 'multi',
                serverSide: true,
                searching: true,
                ordering: false,
                paging: true,
                deferRender: true,
                scrollResize: true,
                info: false,
                scrollY: '79vh',
                /*stateSave: true,*/
                scrollX: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, 250, 750, 1000], [10, 25, 50, 100, 250, 750, 1000]],
                ajax: {
                    url: baseUrl + '/api/Escala_Trabalhoapi/RelatorioEscalaTrabalho',
                    type: 'POST',
                    data: function (data) {
                        data.DataInicioPeriodo = $('#iDataInicio').val();
                        data.DataFimPeriodo = $('#iDataFim').val();
                        data.IdTecnico = $('#iEquipe').val();
                        data.IdSupervisor = $('#iSupervisor').val();
                        data.IdMonitor = $('#iMonitor').val();
                        data.CodEscritorio = $('#iGrupoArea').val();
                        data.CodArea = $('#iArea').val();
                        data.Situacao = $('#iSituacao').val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {

                            if (d.error) {
                                Notificar("@RsBase.ATENCAO_", d.error, "warning");
                            } else {
                                return d.data;
                            }
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                preDrawCallback: function () {

                    //if (ajustePageLength) {
                    //    divPageLength = $('#datatable_length');
                    //}

                    ShowPageLoading();
                },
                drawCallback: function () {

                    TagFilter("FiltrosUtilizados", filter_state)

                    HidePageLoading();
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                    if ($.inArray(rowId, rows_selected) !== -1)
                    {
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 100,
                language: traducaoDataTable,
                buttons: buttonsDataTable,
                columns: [
                    { data: "matricula", className: "text-center", title: "@RsCadastros.MATRICULA", orderable: false},
                    { data: "tecnico", className: "text-center", title: "@RsCadastros.TECNICO", orderable: false},
                    { data: "supervisor", className: "text-center", title: "@RsCadastros.SUPERVISOR", orderable: false },
                    { data: "indisponivel", className: "text-center", title: "@RsCadastros.SITUACAO", orderable: false },
                    { data: "data", className: "text-center", title: "@RsCadastros.DATA", orderable: false },
                    //{ data: "horario", className: "text-center", title: "@RsCadastros.HORARIO", orderable: false },
                    {
                        render: function (data, type, row, meta) {

                            var value = `<div><span data-tooltip="${row.expediente}">${row.horario}</span></div>`;
                            return value;
                        },
                        className: "text-center",
                        title: "@RsCadastros.HORARIO" + ` <span data-tooltip=" Para obter detalhes, desloque o cursor sobre a linha."><i class="fas fa-question-circle fa-1x" style="color: white"></i></span>`,
                        orderable: false
                    },
                    { data: "perfilRoteirizacao", className: "text-center", title: "@RsCadastros.PERFIL_AGENDAMENTO_ROTEIRIZACAO", orderable: false },
                    { data: "pontoPartida", className: "text-center", title: "@RsCadastros.PONTO_PARTIDA", orderable: false },
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });







        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        /*TableManageButtons.init();*/
</script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="icofont-company"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">


                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>
                </div>

            </div>
        </div>

    </div>
    <div id="divSubTitle">
        <div id="FiltrosUtilizados" class="mr-2 ml-2 form-inline"></div>
        <div id="lbAgrupadoPor" class="fs-12 mr-2 ml-2 form-inline"></div>
        <div class="mr-2 ml-2 form-inline mt-1 fs-12">@(String.Format(RsFinanceiro.EMITIDO_POR_EM_AS, User.Identity.GetUserName(), DateTime.Now.ToString("dd/MM/yyyy"), DateTime.Now.ToString("HH:mm")))</div>
    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="form-group border_radius">
                    <div class="row">
                        <div class="col form-inline text-center mt-1" style="display:block">
                            <label for="iDataInicio">@RsCadastros.PERIODO:</label>
                            <input class="form-control obrigatorio datepicker-period mb-1"
                                   id="iDataInicio"
                                   type="text"
                                   @*data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"*@
                                   autocomplete="off"
                                   placeholder="00/00/0000" />

                            <span class="pl-3 pr-3">@RsBase.A</span>

                            <input class="form-control obrigatorio datepicker-period  mb-1"
                                   id="iDataFim"
                                   type="text"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.SUPERVISOR:</label>
                            <select class="form-control" id="iSupervisor"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iEquipe">@RsCadastros.TECNICO:</label>
                            <select class="form-control" id="iEquipe"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iGrupoArea">@RsCadastros.GRUPO_AREA:</label>
                            <select class="form-control" id="iGrupoArea"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iArea">@RsCadastros.AREA:</label>
                            <select class="form-control" id="iArea"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.MONITOR:</label>
                            <select class="form-control" id="iMonitor"></select>
                        </div>
                    </div>
                </div>


                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSituacao">@RsCadastros.SITUACAO:</label>
                            <select class="form-control" id="iSituacao">
                                <option value=""> Selecione</option>
                                <option value="Disponível"> Disponível</option>
                                <option value="Indisponível"> Indisponível</option>
                            </select>
                        </div>
                    </div>
                </div>



                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatableFunction(); $('#modal-filter').modal('hide');" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
