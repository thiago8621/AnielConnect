        "use strict";



        var somar_func = function Somar(valor1, valor2, precision = 2) {
            return Number(valor1) + Number(valor2);
        };



        colunasDatatable = [
            { data: "tecnico", className: "text-center", title: "@RsCadastros.NOME", visible: false },
            { data: "data", className: "text-center", title: "@RsCadastros.DATA", orderable: false },
            {
                data: "produtivas", className: "text-center", title: "Produtivas", orderable: false, groupFunc: somar_func,
                porcentagem: false,
                colunasAlteracao: [ColunaAlteracao("percentualProdutivas", 4, (a,b) => Number(a/b))],
            },
            {
                data: "improdutivas", className: "text-center", title: "Improdutivas", orderable: false, groupFunc: somar_func,
                porcentagem: false,
                colunasAlteracao: [ColunaAlteracao("percentualProdutivas", 4, (a, b) => Number(a / b))],
            },
            {
                data: "percentualProdutivas", className: "text-center", title: "Percentual Produtivas", /*, groupFunc: somar_func, */
                orderable: false,
                colunasAlteracao: [],
                porcentagem : true,
                render: function (data, type, full, meta) {
                    return data + '%';
                }
            },
            {
                data: "percentualImprodutivas", className: "text-center", title: "Percentual Improdutivas", orderable: false, /* groupFunc: somar_func, */
                colunasAlteracao: [],
                porcentagem: true,
                render: function (data, type, full, meta) {
                    return data + '%';
                }
            }
        ];

        function CalculaTotalColunaDataTable(
            rows,
            colunas,
            group,
            columns_length,
            level,
            calculoPorcentagem = false
        ) {
            //settings, api, colunas,coluna_grupo

            if (!group) group = "Sem Grupo";

            var retorno = {
                string_append: "",
                array_colunas_calculadas: []
            };

            var valores = [];

            colunas.forEach(function (item, index) {
                var sum = item.porcentagem == false ? rows
                        .data()
                        .pluck(item.nome)
                        .reduce(function (a, b) {
                            return item.funcao_principal(a, b);
                        }, 0) : Math.round(rows
                            .data()
                            .pluck(item.nome)
                            .reduce(function (a, b) {
                                return item.funcao_principal(a, b);
                            }, 0) / rows.data().toArray().length,2) + '%';

                var obj = {
                    valor: sum,
                    index_coluna: item.index_coluna,
                    cor: item.funcao_cor,
                    lista_coluna_alteracao: item.lista_coluna_alteracao,
                    classNameList: item.classNameList
                };

                valores.push(obj);
            });

            var valores_ordenados_coluna = valores.sort(
                (a, b) => a.index_coluna - b.index_coluna
            );
            retorno.array_colunas_calculadas = valores_ordenados_coluna;

            retorno.string_append = tituloRowGroup(group, level);

            if (retorno.string_append) {
                for (let j = 0; j < valores_ordenados_coluna.length; j++) {
                    var classes_css = "";

                    valores_ordenados_coluna[j].classNameList.forEach(function (item) {
                        classes_css += item;
                    });

                    var obj_coluna = valores_ordenados_coluna[j];
                    let cor = obj_coluna.cor ? obj_coluna.cor(obj_coluna.valor) : "#5f5f5f";

                    retorno.string_append += preencheColunasAnteriores(valores, j);
                    retorno.string_append += `<td data_column=${
                        obj_coluna.index_coluna
                        } style="color:${cor};" class="${classes_css}" colspan="1"><label class="${classes_css}">${
                        obj_coluna.valor
                        }</label></td>`;
                }

                if (valores_ordenados_coluna.length !== 0) {
                    retorno.string_append += preencheColunasRestantes(
                        valores,
                        columns_length
                    );
                } else {
                    for (let i = 1; i < columns_length; i++) {
                        retorno.string_append += "<td></td>";
                    }
                }
            }

            return retorno;
        };

        var handleDataTableButtons = function () {

                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "Bfrti",
                    select: {
                        style: 'multi'
                    },
                    serverSide: true,
                    searching: true,
                    ordering: false,
                    paging: false,
                    deferRender: true,
                    scrollResize: true,
                    scrollY: '66vh',
                    stateSave: true,
                    scrollX: true,
                    fixedHeader: true,
                    initComplete: dataTableInitComplete,
                    drawCallback: () => {

                        TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                        $("#lbAgrupadoPor").html('Agrupado por: @Html.Raw(RsCadastros.TECNICO)');
                        ResizeTable('divTable');
                        if (oDatatable)
                            oDatatable.columns.adjust();

                    },
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: baseUrl + '/api/Equipeapi/ServicosExecutadosPorTecnico',
                        type: 'POST',
                        async: false,
                        data: function (data) {
                            data.Data_Inicio = $('#iDataInicio').val();
                            data.Data_Fim = $("#iDataFim").val();
                            data.Tipo_Data = $("#iDataAgendamento").is(':checked') ? "agendamento" : "encerramento";
                            data.Equipe = $('#iEquipe').val();
                            data.Supervisor = $('#iSupervisor').val();
                            data.Cod_Tipo_Serv = $('#iTipoServico').val();
                            data.Id_Categoria_Cliente = $('#iCategoriaCliente').val();
                            data.CodCt_Encerramento = $('#iEncerramentoCodCt').val();
                            data.Codigo_Encerramento = $('#iEncerramento').val();
                            data.UF = $('#iEstadosBrasil').val();
                            data.Cidade = $('#iCidade').text();
                            data.empresa = $('#iEmpresa').val();
                            data.filial = $('#iFilial').val();
                            data.planoProduto = $('#iPlano').val();
                            data.grupoArea = $('#iGrupoArea').val();
                            data.area = $('#iArea').val();
                            data.localidade = $('#iLocalidade').val();
                            data.centro = $('#iCentro').val();
                            data.habilidade = $('#iHabilidade').val();
                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
                    },
                    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                        var str = "@RsCadastros.INFODATATABLE";
                        if (iTotal == 0) { iEnd = 0; iStart = 0; }
                        str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                        $("#dtLegend").html(str);

                        return "";
                    },
                    pageLength: 5,
                    order: [],
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTableRelatorio({
                        title: "@Html.Raw(ViewBag.Title)",
                        pdfCustomize: function (doc) {

                            var agrupamento = [0];
                            doc.content[0].table.body = agruparDados(
                                agrupamento,
                                doc.content[0].table.body
                            );
                            const table = doc.content[0].table.body;
                            doc.content[0].table.body = table.map(p => {
                                if (!p[0].agrupamento) {
                                    return p.filter((y, index) => !agrupamento.includes(index));
                                } else {
                                    agrupamento.forEach(() => {
                                        p.pop();
                                    })
                                    return p;
                                }
                            });
                        },

                    }),
                    rowGroup: {
                        emptyDataGroup: 'Sem Grupo',
                        dataSrc: ['tecnico'],
                        startRender: function (rows, group, level) {

                            let colunasGroup = [];

                            colunasDatatable.filter(p => p.groupFunc).forEach((col, index) => {
                                colunasGroup.push(ColunaRowGroup(col.data, index, col.title, 0, col.groupFunc, () => "black", col.colunasAlteracao, ["text-center"], col.porcentagem));
                            });

                            var retorno = CalculaTotalColunaDataTable(rows, colunasGroup, group, rows.data().columns()[0].length-1, level);
                            return $('<tr>').append(retorno.string_append);
                        },
                        endRender: function (rows, group) {
                            if (oDatatable)
                                oDatatable.columns.adjust();
                            else
                                $("#datatable").DataTable().columns.adjust();

                            ResizeTable('divTable');
                        }
                    },
                    columns: colunasDatatable
                });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });

            $('#datatable tbody').on('click', 'tr.dtrg-level-0', function () {

                var rowsCollapse = $(this).nextUntil('.dtrg-level-0');

                if (!$(this).hasClass("collapsed") && !$(this).hasClass("not-collapsed")) {
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                else if ($(this).hasClass("collapsed")) {
                    $(this).removeClass("collapsed");
                    $(this).addClass("not-collapsed");
                    rowsCollapse.removeClass("d-none");
                }

                else if ($(this).hasClass("not-collapsed")) {
                    $(this).removeClass("not-collapsed");
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                oDatatable.columns.adjust();
            });
                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    rows_selected = [];
                });
            },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                    Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 30 dias", "warning");
                    return false
                }
            }

            if (oDatatable == null) {
                TableManageButtons.init();
            }
            else {
                oDatatable.draw()
            }

            $('#modal-filter').modal('hide')


        }

    </script>
}
