@using Aniel.Connect.Model.enumerado
@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = RsCadastros.LISTAGEM_PLANOS_CLIENTES;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/bin/Content/connect.css")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />
    <style>

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #divTable {
            margin-right: 20px;
            padding-top: 13px;
        }

        #datatable_length {
            margin-right: auto !important;
            margin-top: 12px;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>

}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>
    <script>
        var oDatatable = null;
        var rows_selected;

        let HandleGrupo = function () {
            $('#iEncerramento').on('select2:select select2:unselecting', function (e) {

                Encerramento = e.params.data
                if (Encerramento) {
                    $('#iEncerramentoCodCt').val(Encerramento.codCt);
                }
                else {
                    $('#iEncerramentoCodCt').val(null);
                }
            });
        };

        function ColunaRowGroup(
            nome,
            index_coluna,
            titulo,
            valor_total,
            funcao_principal,
            funcao_cor,
            lista_coluna_alteracao,
            classNameList,
            porcentagem
        ) {
            let obj_colunaRowGroup = {
                nome: nome,
                index_coluna: index_coluna,
                titulo: titulo,
                funcao_principal: funcao_principal,
                funcao_cor: funcao_cor,
                valor_total: valor_total ? valor_total : 0,
                lista_coluna_alteracao: lista_coluna_alteracao
                    ? lista_coluna_alteracao
                    : [],
                classNameList: classNameList ? classNameList : [],
                porcentagem: porcentagem
            };
            return obj_colunaRowGroup;
        }

        function carregaSelect2() {
            AddSelect("iCliente", "@CONSTANTES.URLPortal/api/clienteapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iContrato", "@CONSTANTES.URLPortal/api/clienteapi/GetComboContratoCliEndereco", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iPlano", "@CONSTANTES.URLPortal/api/PlanoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iBairro", "@CONSTANTES.URLPortal/api/Bairroapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iLogins", "@CONSTANTES.URLPortal/api/LoginRadiusapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }

        var filter_state = {
            periodo: {
                label: "@RsFinanceiro.PERIODO", getDisplay: () => {

                    return Boolean($('#iDataInicio').val()) ? ($('#iDataInicio').val() + " a " + $('#iDataFim').val()) : ""

                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            equipe: {
                label: "@RsCadastros.TECNICO",
                getDisplay: () => { return Boolean($('#iEquipe').val()) ? $('#iEquipe option:selected').text() : "" },
                onclick: () => {
                    $('#iEquipe').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },empresa: {
                label: "@RsCadastros.EMPRESA",
                getDisplay: () => { return Boolean($('#iEmpresa').val()) ? $('#iEmpresa option:selected').text() : "" },
                onclick: () => {
                    $('#iEmpresa').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            filial: {
                label: "@RsCadastros.FILIAL",
                getDisplay: () => { return Boolean($('#iFilial').val()) ? $('#iFilial option:selected').text() : "" },
                onclick: () => {
                    $('#iFilial').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            monitor: {
                label: "@RsCadastros.MONITOR",
                getDisplay: () => { return Boolean($('#iMonitor').val()) ? $('#iMonitor option:selected').text() : "" },
                onclick: () => {
                    $('#iMonitor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            centroCusto: {
                label: "Centro de custo",
                getDisplay: () => { return Boolean($('#iCentro').val()) ? $('#iCentro option:selected').text() : "" },
                onclick: () => {
                    $('#iCentro').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            grupoArea: {
                label: "@RsCadastros.GRUPO_AREA",
                getDisplay: () => { return Boolean($('#iGrupoArea').val()) ? $('#iGrupoArea option:selected').text() : "" },
                onclick: () => {
                    $('#iGrupoArea').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            categoriaCliente: {
                label: "Categoria do Cliente",
                getDisplay: () => { return Boolean($('#iCategoria_Cliente').val()) ? $('#iCategoria_Cliente option:selected').text() : "" },
                onclick: () => {
                    $('#iCategoria_Cliente').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            area: {
                label: "@RsCadastros.AREA",
                getDisplay: () => { return Boolean($('#iArea').val()) ? $('#iArea option:selected').text() : "" },
                onclick: () => {
                    $('#iArea').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            localidade: {
                label: "@RsCadastros.LOCALIDADE",
                getDisplay: () => { return Boolean($('#iLocalidade').val()) ? $('#iLocalidade option:selected').text() : "" },
                onclick: () => {
                    $('#iLocalidade').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            naturezaServico: {
                label: "@RsCadastros.NATUREZA",
                getDisplay: () => { return Boolean($('#iNatureza').val()) ? $('#iNatureza option:selected').text() : "" },
                onclick: () => {
                    $('#iNatureza').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            habilidadeTecnica: {
                label: "@RsCadastros.HABILIDADE_TECNICA",
                getDisplay: () => { return Boolean($('#iHabilidade').val()) ? $('#iHabilidade option:selected').text() : "" },
                onclick: () => {
                    $('#iHabilidade').val(null).trigger("change")
                    oDatatable.draw()
                }
            },


        }


        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {

            $("#iCliente").val(null);
            $("#iCliente").text("");
            $("#iContrato").val(null);
            $("#iContrato").text("");
            $("#iExibeClienteInativos").prop("checked", false);
            $("#iExibeContratoInativos").prop("checked", false);
            $('#iTipoPlano').val("");
            $("#iPlano").text("");
            $("#iPlano").val(null);
            $("#iExibeCombos").prop("checked", false);
            $("#iLogins").val(null);
            $("#iLogins").text("");
            $("#iCidade").val(null);
            $("#iCidade").text("");
            $("#iBairro").val(null);
            $("#iBairro").text("");
            $("#iDataInicio").val(null);
            $("#iDataInicio").text("");
            $("#iDataFim").val(null);
            $("#iDataFim").text("");

            $('input[name="iStatus[]"]:checked').map(function () {
                return $(this).prop("checked", false);
            }).get();

            $('input[name="periodo"]:checked').map(function () {
                return $(this).prop("checked", false);
            }).get();


            $('#iDataInicio').removeClass('obrigatorio');
            $('#iDataFim').removeClass('obrigatorio');
            tipoData = '';

            carregaSelect2();
            oDatatable.draw();

        })

        $(document).ready(async () => {
            carregaSelect2()
            TableManageButtons.init()
        })



        var somar_func = function Somar(valor1, valor2, precision = 2) {
            return Number(valor1) + Number(valor2);
        };

        colunasDatatable = [
            { data: "codCliente", className: "text-center", title: "@RsCadastros.CODIGO_CLIENTE", orderable: false },
            { data: "codContrato", className: "text-center", title: "@RsCadastros.CODIGO_CONTRATO", orderable: false },
            { data: "codPlanoProduto", className: "text-center", title: "@RsCadastros.CODIGO @RsCadastros.PLANO_PRODUTO", orderable: false },
            { data: "venda", className: "text-center", title: "@RsCadastros.VENDA", orderable: false },
            { data: "cliente", className: "text-center", title: "@RsCadastros.CLIENTE", orderable: false },
            { data: "dataAprovacaoVenda", className: "text-center", title: "Data Aprovação venda", orderable: false },
            { data: "dataAtivacao", className: "text-center", title: "Data Ativação", orderable: false },
            { data: "dataFimCarencia", className: "text-center", title: "Data Fim Carencia", orderable: false },
            { data: "dataCancelamento", className: "text-center", title: "@RsCadastros.DATA_CANCELAMENTO", orderable: false },
            { data: "dataSuspensao", className: "text-center", title: "Data Suspensão", orderable: false },
            { data: "statusPlano", className: "text-center", title: "@RsCadastros.STATUS_PLANO_PRODUTO", orderable: false },
            { data: "valorPlano", className: "text-center", title: "Valor Aplicado no Plano", orderable: false },
            { data: "nomePlano", className: "text-center", title: "@RsCadastros.PLANO_PRODUTO", orderable: false },
            { data: "tipoPlano", className: "text-center", title: "@RsCadastros.TIPO_PLANO", orderable: false },
            { data: "cidade", className: "text-center", title: "@RsCadastros.CIDADE", orderable: false },
            { data: "bairro", className: "text-center", title: "@RsCadastros.BAIRRO", orderable: false },
            { data: "vendedor", className: "text-center", title: "@RsCadastros.VENDEDOR", orderable: false },

        ];

        var handleDataTableButtons = function () {
                "use strict";

            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: 'plBfrti',
                    select: {
                        style: 'multi'
                    },
                    order: [[1, 'asc']],
                    serverSide: true,
                    searching: true,
                    processing: true,
                    ordering: true,
                    destroy: true,
                    paging: true,
                    deferRender: true,
                    scrollResize: true,
                    autoWidth: false,
                    scrollY: '79vh',
                    scrollX: true,
                    layout: {
                        bottomEnd: {
                            paging: {
                                firstLast: false
                            }
                        }
                    },
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: baseUrl + '/api/PlanoProdutoApi/RelatorioPlanosClientes',
                        type: 'POST',
                        async: true,
                        data: function (data) {
                            data.idCliente = $('#iCliente').val();
                            data.contrato = $('#iContrato').val();
                            data.tipoPlano = $('#iTipoPlano').val();
                            data.idPlano = $('#iPlano').val();
                            data.idBairro = $('#iBairro').val();
                            data.idCidade = $('#iCidade').val();
                            data.idLogin = $('#iLogins').val();

                            var statusSelecionados = $('input[name="iStatus[]"]:checked').map(function () {
                                return $(this).val();
                            }).get();

                            data.StatusSelecionados = statusSelecionados;

                            data.tipoData = tipoData;
                            data.inicio = $('#iDataInicio').val();
                            data.fim = $('#iDataFim').val();
                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            //Mostrar o Total de Ordens de Serviços encontradas
                            if ($('#Count_listing').length === 0)
                                $('.dataTables_length').append($('<label id="Count_listing"></label>'));

                            $("#Count_listing").html(`<div class="form-group col-sm-push-1 ml-2 mt-1">
                                                 Total de Registros encontrados : <span style="font-weight:bold; margin-right:0px;" id="Total_OS">  &nbsp; `+ d.recordsFiltered + ` </span>
                                                 </div> `
                            );

                            return d.data;
                        }
                    },
                    preDrawCallback: function () {
                        ShowPageLoading();
                    },
                    drawCallback: function () {
                        HidePageLoading();
                    },
                    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {
                        var str = "@RsCadastros.INFODATATABLE";
                        if (iTotal == 0) { iEnd = 0; iStart = 0; }
                        str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                        $("#dtLegend").html(str);

                        return "";
                    },
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTableRelatorioPaginado({
                        title: "@Html.Raw(ViewBag.Title)",
                        pageSize: GetPageSizePDF(colunasDatatable)
                    }),
                    layout: {
                        bottomEnd: {
                            paging: {
                                firstLast: false
                            }
                        }
                    },               
                    pageLength: 10,
                    initComplete: dataTableInitComplete,
                    columns: colunasDatatable
                });

                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    rows_selected = [];
                });
            },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                    Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 30 dias", "warning");
                    return false
                }
            }

            if (oDatatable == null) {
                TableManageButtons.init();
            }
            else {
                oDatatable.draw()
            }

            $('#modal-filter').modal('hide')


        }

        $('#iStatusTodos').on('change', function () {
            $('input[name="iStatus[]"]').prop('checked', this.checked);
        });

        $('input[name="iStatus[]"]').on('click', function () {
            var valor = $(this).val();

            if (valor != "10") {
                $('#iStatusTodos').prop('checked', false);
            }
        });

        $("#iExibeClienteInativos").change(function () {
            AddSelect("iCliente", "@CONSTANTES.URLPortal/api/clienteapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, null, null, null, null, !$('#iExibeClienteInativos').prop('checked'));
        });

        $("#iExibeContratoInativos").change(function () {
            AddSelect("iContrato", "@CONSTANTES.URLPortal/api/clienteapi/GetComboContratoCliEndereco", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, null, null, null, null, !$('#iExibeContratoInativos').prop('checked'));
        });

        $("#iExibeCombos").change(function () {
            AddSelect("iPlano", "@CONSTANTES.URLPortal/api/PlanoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, null, null, null, null, !$('#iExibeCombos').prop('checked'));
        });

        var tipoData = "";

        $('input[name="periodo"]').on('change', function () {
            if ($(this).is(':checked')) {
                tipoData = $(this).val();
                $('#iDataInicio').addClass('obrigatorio');
                $('#iDataFim').addClass('obrigatorio');
            }
        });
    </script>

}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-user-check"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">


                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>
                </div>

            </div>
        </div>

    </div>
    <div id="divSubTitle">
        <div id="FiltrosUtilizados" class="mr-2 ml-2 form-inline"></div>
        <div class="mr-2 ml-2 form-inline mt-1 fs-12">@(String.Format(RsFinanceiro.EMITIDO_POR_EM_AS, User.Identity.GetUserName(), DateTime.Now.ToString("dd/MM/yyyy"), DateTime.Now.ToString("HH:mm")))</div>
    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iCliente">@RsCadastros.CLIENTE:</label>
                            <select class="form-control" id="iCliente"></select>
                            <input type="checkbox" class="form-group mt-1" id="iExibeClienteInativos" /> Exibir Clientes Inativos
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iContrato">@RsCadastros.CONTRATO:</label>
                            <select class="form-control" id="iContrato"></select>
                            <input type="checkbox" class="form-group mt-1" id="iExibeContratoInativos" /> Exibir Contratos Cancelados
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iTipoPlano">Tipo Plano:</label>
                            <select for="iTipoPlano" name="MyType" id="iTipoPlano" class="form-control">
                                <option value="">Selecione</option>
                                <option value="1">Telefonia Móvel</option>
                                <option value="2">Internet</option>
                                <option value="3">TV</option>
                                <option value="4">Telefonia Fixo</option>
                                <option value="5">Serviços Adicionais</option>
                            </select>
                            @*@Html.DropDownList("MyType", EnumHelper.GetSelectList(typeof(Tipo_Tecnologia)), RsBase.SELECIONE, new { @class = "form-control", @id = "iTipoPlano" })*@
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iContrato">@RsCadastros.PLANO:</label>
                            <select class="form-control" id="iPlano"></select>
                            <input type="checkbox" class="form-group mt-1" id="iExibeCombos" /> Exibir Combos
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iLogin">Login:</label>
                            <select class="form-control" id="iLogins"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iCidade">@RsCadastros.CIDADE:</label>
                            <select class="form-control" id="iCidade"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iBairro">@RsCadastros.BAIRRO:</label>
                            <select class="form-control" id="iBairro"></select>
                        </div>
                    </div>
                </div>

                <text style="font-size: small">@RsCadastros.STATUS:</text>
                <div class="row justify-content-center" style="font-size: smaller">
                    <div>
                        <input type="checkbox" class="form-group mt-1" name="iStatus[]" value="1" /> Aguardando Instalação
                    </div>
                    <div>
                        <input type="checkbox" class="form-group mt-1 ml-2" name="iStatus[]"  value="2" /> Habilitado
                    </div>
                    <div>
                        <input type="checkbox" class="form-group mt-1 ml-2" name="iStatus[]"  value="3,4" /> Suspenso
                    </div>
                    <div>
                        <input type="checkbox" class="form-group mt-1 ml-2" name="iStatus[]"  value="5,7,8" /> Cancelado
                    </div>
                    <div>
                        <input type="checkbox" class="form-group mt-1 ml-2" name="iStatus[]" id="iStatusTodos" value="10" /> Todos
                    </div>
                </div>

                <text style="font-size: small" class="mt-2">@RsCadastros.PERIODO:</text>
                <div class="row border mx-0" style="font-size: smaller">
                    <div class="col-5 my-2 p-0">
                        <input type="radio" class="form-group mt-1 ml-2" id="iDataAprov" name="periodo" value="0" /> Data de Aprovação<br />
                        <input type="radio" class="form-group mt-1 ml-2" id="iDataAtivacao" name="periodo" value="1" /> Data de Ativação<br />
                        <input type="radio" class="form-group mt-1 ml-2" id="iDataCancel" name="periodo" value="3" /> Data de Cancelamento<br />
                        <input type="radio" class="form-group mt-1 ml-2" id="iDataSuspen" name="periodo" value="4" /> Data de Suspensão<br />
                    </div>
                    <div class="col p-0 justify-content-center align-items-center">
                        <div class="col form-inline text-center mt-5" style="display:block">
                            <input class="form-control datepicker-period mb-1"
                                   id="iDataInicio"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />

                            <span class="">@RsBase.A</span>

                            <input class="form-control datepicker-period  mb-1"
                                   id="iDataFim"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />
                        </div>
                    </div>
                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatableFunction(); $('#modal-filter').modal('hide');" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
