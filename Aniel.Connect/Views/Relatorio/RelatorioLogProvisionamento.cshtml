@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = RsCadastros.LOGS_PROVISIONAMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />

    <style>
        .popover {
            max-width: 45%; /* Max Width of the popover (depending on the container!) */
        }

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }

        div.dataTables_processing { 
            z-index: 1; 

        }
    </style>
}

@section scripts
{
    @Scripts.RenderFormat(Aniel.Connect.SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">

    <script type="text/javascript" src="https://cdn.datatables.net/plug-ins/1.10.20/sorting/date-eu.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/plug-ins/1.13.7/api/sum().js"></script>

    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>

        $(document).ready(async function () {
            AddSelect("iUsuario", "@CONSTANTES.URLPortal/api/EquipeApi/GetComboMobile", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iDescricao_OLT", "@CONSTANTES.URLPortal/api/OLTApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);


            $('#modal-filter').modal('show');
            if ($('#flexRadioOS').is(':checked')) {
                $('#iFiltro_data').hide();
                $('#iFiltro_os').show();

            } else {
                $('#iFiltro_data').show();
                $('#iFiltro_os').hide();

            }

            $('input[name="flexRadioDefault"]').change(function () {
                if ($('#flexRadioOS').is(':checked')) {
                    $('#iFiltro_data').hide();
                    $('#iFiltro_os').show();
                    $('#iUsuario').val('').trigger('change');
                    $('#iData_Inicio').val('');
                    $('#iDescricao_OLT').val('').trigger('change');
                    $('#iSerial').val('');
                } else {
                    $('#iFiltro_data').show();
                    $('#iFiltro_os').hide();
                    $('#iNum_OS').val('');
                }
            });
        });

        $("#iCheck").change(function (e) {
            if (e.target.checked) {
                $("#iData").prop("disabled", false);
            }
            else {
                $("#iData").prop("disabled", true);
                $("#iData").val(null);
            }
        });



        var oDatatable;

        function exibirModalXML(id, request, response) {
            $("#iRequest_Modal").val(atob(request));
            $("#iResponse_Modal").val(atob(response));
            $("#modal-request-response").modal('show');

            console.log("Teste");
        }

        let colunasDatatable = [];
        var rows_selected = [];

        function CarregaDataTable(agrupamento) {

            if (oDatatable != null) {
                oDatatable.destroy();
                $("#datatable").empty()
                //ShowPageLoading();
            }

            colunasDatatable = [
                 { data : "id", title : '@RsCadastros.ID', className : "text-center", visible : true, orderable : false },
                 { data : "servico", title : '@RsCadastros.SERVICO', className : "text-center", visible : true, orderable : false },
                 { data : "detalhe", title : '@RsCadastros.OS', className : "text-center", visible : true, orderable : false },
                 { data : "data_Hora_Str", title : '@RsCadastros.DATAHORA', className : "text-center", visible : true, orderable : false },
                 { data : "usuario", title : '@RsCadastros.EQUIPE', className : "text-center", visible : true, orderable : false },
                 { data : "etapa", title : '@RsCadastros.ETAPA', className : "text-center", visible : true, orderable : false },
                 { data : "xml_Request_Response", title : "Requisição/Resposta", className : "text-center", visible : true, orderable : false },
                 { data : "xml_Request", title : "Requisição", className : "text-left", visible : false, orderable : false },
                 { data : "xml_Response", title : "Resposta", className : "text-left", visible : false, orderable : false },
            ];

            //Carrega os Headers Complexos
            CarregaHeaderComplexaDataTable("datatable", colunasDatatable);

            let datatableConf = {
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                buttons: [
                    {
                        extend: 'pdfHtml5',
                        title: "@Html.Raw(ViewBag.Title)",
                        footer: true,
                        orientation: 'landscape',
                        pageSize: 'TABLOID',//GetPageSizePDF(colunasDatatable),
                        exportOptions: {
                            //Oculta a coluna 5 (Etapa) e a 6 (Requisição/Reposta)
                            //Exibe as colunas ocultas 7 (Requisição) e 8 (Resposta)
                            columns: ['0','1','2','3','4','7','8']
                        },
                        customize: function (doc) {
                            doc.content[1].table.widths = ['auto','auto','auto','auto','auto',250,420]
                        },
                    }
                ],
                //data: tableData,
                ajax: {
                   url: '@String.Concat(CONSTANTES.URLPortal, "/api/RelatorioLogProvisionamentoapi/GetAll")',
                    type: 'POST',
                    data: function (data) {
                        data.data_Inicio = $('#iData_Inicio').val();
                        //data.data_Fim = $('#iData_Fim').val();
                        data.num_OS = $('#iNum_OS').val();
                        data.usuario = $('#iUsuario').val();
                        data.id_OLT = $('#iDescricao_OLT').val();
                        data.serial = $('#iSerial').val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        if (d.data) {
                            HidePageLoading();
                        }
                        else if (d.error) {
                            Notificar('@RsBase.INFORMACAO', value.mensagem, 'info')
                        }
                        return d.data;
                    }
                },
                scrollResize: true,
                stateSave: false,
                fixedHeader: true,
                scrollY: '50vh',
                scrollX: true,
                serverSide: true,
                processing: true,
                paging: false,
                initComplete: dataTableInitComplete,
                ordering: false,
                paging: true,
                pageLength: 25,
                deferRender: true,
                //order: [],
                lengthMenu: [[10, 25, 50, 100, 200], [10, 25, 50, 100, 200]],
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function (row, data, dataIndex) {
                    // Get row ID
                    var rowId = data.id;

                    // If row ID is in the list of selected row IDs
                    if ($.inArray(rowId, rows_selected) !== -1) {
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                    }
                },
                language: traducaoDataTableSimples,
                //language: {
                //    "decimal": ","
                //},
                scrollResize: true,
                columns: colunasDatatable,
                columnDefs: [
                    {
                        targets: [6],
                        render: function (data, type, row, meta) {
                        var request = $('<div>').html(row.xml_Request).text();
                        var response = $('<div>').html(row.xml_Response).text();
                        //var input = `<a onclick="exibirModalXML('${row.id}','${row.xml_Request.replace(/"/g, '').replace(/'/g, '').replace(/;/g, '').replace(/<[^>]*>/g, "").replace(/\n/g, "").replace(/\r/g, "").replace(/\t/g, "").replace(/&#13/g, "")}','${response.replace(/"/g, '').replace(/'/g, '').replace(/;/g, '').replace(/<[^>]*>/g, "").replace(/\n/g, "").replace(/\r/g, "").replace(/\t/g, "")}')"><i class='far fa-eye'></i></a>`;
                        var input2 = `<a onclick="exibirModalXML('${row.id}','${btoa(request)}','${btoa(response)}')"><i class='far fa-eye'></i></a>`;
                        return input2;
                        }
                    }
                ],
                drawCallback: function () {
                    //ordenouData = false;
                    //HidePageLoading();
                    //TagFilter("FiltrosUtilizados", filter_state);
                    ResizeTable("divTable");
                    if (oDatatable) {
                        oDatatable.columns.adjust();
                    }

                },
                footerCallback: function (row, data, start, end, display) {

                    var api = this.api(), data;

                    colunasDatatable.forEach((col, index) => {
                        if (col.className && col.className.includes("somaFooter")) {
                            const soma = api
                                .column(index)
                                .data()
                                .reduce(function (a, b) {
                                    return funcao_soma_dinero(a, b);
                                }, 0);

                            $(api.column(index).footer()).html(soma);
                        }
                    });
                }
            }


            let colunasGroup = [];
            let colDif = 0;

            datatableConf["rowGroup"] = {
                dataSrc: agrupamento,
                startRender: function (rows, group, level) {

                    const retorno = CalculaTotalColunaDataTable(rows, colunasGroup, group, colunasDatatable.filter(p => p.visible).length, level);

                    if (rows.data()[0].erro_Provisionamento == true) {
                        var color = 'style="color:red"';
                        var msgErro = rows.data()[0].msg_Erro ?? 'Erro no Provisionamento';
                        return $('<tr ' + color + '/>').append(retorno.string_append.replace(`${group}</td>`, `${group} - ${msgErro}</td>`));
                    }
                    else {
                        return $('<tr>').append(retorno.string_append);
                    }
                },

                endRender: function (rows, group) {
                    if (oDatatable)
                        oDatatable.columns.adjust();
                    else
                        $("#datatable").DataTable().columns.adjust();
                },

            }


            oDatatable = $("#datatable").length && $("#datatable").DataTable(datatableConf);

            $('#datatable tbody').on('click', 'tr.dtrg-level-0', function () {

                var rowsCollapse = $(this).nextUntil('.dtrg-level-0');

                if (!$(this).hasClass("collapsed") && !$(this).hasClass("not-collapsed")) {
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                else if ($(this).hasClass("collapsed")) {
                    $(this).removeClass("collapsed");
                    $(this).addClass("not-collapsed");
                    rowsCollapse.removeClass("d-none");
                }

                else if ($(this).hasClass("not-collapsed")) {
                    $(this).removeClass("not-collapsed");
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                oDatatable.columns.adjust();
            });

            $('#datatable tbody').on('click', 'tr.dtrg-level-1', function () {

                var rowsCollapse = $(this).nextUntil('.dtrg-level-1').not('.dtrg-level-0');

                if (!$(this).hasClass("collapsed") && !$(this).hasClass("not-collapsed")) {
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                else if ($(this).hasClass("collapsed")) {
                    $(this).removeClass("collapsed");
                    $(this).addClass("not-collapsed");
                    rowsCollapse.removeClass("d-none");
                }

                else if ($(this).hasClass("not-collapsed")) {
                    $(this).removeClass("not-collapsed");
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                oDatatable.columns.adjust();
            });


            $('#datatable tbody').on('click', 'tr.dtrg-level-2', function () {

                var rowsCollapse = $(this).nextUntil('.dtrg-level-2').not('.dtrg-level-0,.dtrg-level-1');

                if (!$(this).hasClass("collapsed") && !$(this).hasClass("not-collapsed")) {
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                else if ($(this).hasClass("collapsed")) {
                    $(this).removeClass("collapsed");
                    $(this).addClass("not-collapsed");
                    rowsCollapse.removeClass("d-none");
                }

                else if ($(this).hasClass("not-collapsed")) {
                    $(this).removeClass("not-collapsed");
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                oDatatable.columns.adjust();
            });


            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

            TableManageButtons.init();
        }

        $("#iPesquisar").on("click", function () {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                return false
            }

            @*if (!$('#iData_Inicio').val() && !$('#iData_Fim').val() && !$('#iUsuario').val() && !$('#iNum_OS').val()) {
                Notificar("@RsBase.ATENCAO_", "É necessário informar ao menos um dos campos no filtro.", "warning")
                return false
            }

            if ($('#iUsuario').val() && !$('#iNum_OS').val() && (!$('#iData_Inicio').val() || !$('#iData_Fim').val())) {
                Notificar("@RsBase.ATENCAO_", "É necessário informar ao menos um filtro de data.", "warning")
                return false
            }

            var dataIni = moment($('#iData_Inicio').val(), "DD-MM-YYYY");
            var dataFim = moment($('#iData_Fim').val(), "DD-MM-YYYY");

            if (dataIni > dataFim) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.DATA_INVALIDA)", "warning");
                return false;
            }*@

            if (!$('#iData_Inicio').val() && !$('#iUsuario').val() && !$('#iNum_OS').val() && !$('#iDescricao_OLT').val() && !$('#iSerial').val()) {
                Notificar("@RsBase.ATENCAO_", "É necessário informar ao menos um dos campos no filtro.", "warning")
                return false
            }

             if (!$('#iNum_OS').val() && !$('#iData_Inicio').val()) {
                 Notificar("@RsBase.ATENCAO_", "É necessário informar uma data.", "warning")
                 return false
             }


            //ShowPageLoading();
            CarregaDataTable("detalhe");
            oDatatable.columns.adjust();
            ResizeTable("divTable");
            @*const link = '@String.Concat(CONSTANTES.URLPortal, "/api/RelatorioLogProvisionamentoapi/GetAll")';

            $.ajax({
                url: link,
                type: 'POST',
                data: {
                    Data_Inicio: $('#iData_Inicio').val(),
                    Data_Fim: $('#iData_Fim').val(),
                    Num_OS: $('#iNum_OS').val(),
                    Usuario: $('#iUsuario').val(),
                },
                error: function (e) {
                    console.log(e);
                },
                dataSrc: function (d) {
                    return d.data;
                }
            })
            .done(function (data) {

                if (data.data) {
                    const colunas = data.columns;
                    const tabledata = data.data;

                    CarregaDataTable(JSON.parse(colunas), tabledata, "detalhe");

                    oDatatable.columns.adjust();
                    ResizeTable("divTable");

                    HidePageLoading();
                }
                else if (data.mensagens) {
                    data.mensagens.forEach(function (value) {
                        Notificar('@RsBase.INFORMACAO', value.mensagem, 'info')
                    })
                }
            });*@

            $('#modal-filter').modal('hide');
        });

        function limparFiltro() {
            $('#iNum_OS').val('');
            $('#iUsuario').val('').trigger('change');
            $('#iData_Inicio').val('');
            $('#iDescricao_OLT').val('').trigger('change');
            $('#iSerial').val('');
            @*$('#iData_Fim').val('');*@
        }

        const handleDataTableButtons = function () {
            "use strict";

            oDatatable.on('draw', function () {
                HidePageLoading();
            });
        }

    </script>
}

