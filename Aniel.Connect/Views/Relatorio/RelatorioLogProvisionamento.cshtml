<div id="divTable" class="ml-3 mr-3">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>


<div class="modal fade" id="modal-request-response">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">Log Request / Response</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-sm-12">
                    <div class="row">

                        <div class="col-sm-6">
                            <div class="row">
                                <div class="form-group">
                                    <label>Request:</label>
                                    <div class="form-group" style="height: 100%; vertical-align: middle;">
                                        <textarea id="iRequest_Modal" rows="30" cols="55" disabled>                                                
                                                </textarea>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="row ml-1">
                                <div class="form-group">
                                    <label>Response:</label>
