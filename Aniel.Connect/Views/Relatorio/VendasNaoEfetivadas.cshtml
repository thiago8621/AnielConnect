@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = RsCadastros.RELATORIO_VENDAS_NAO_EFETIVADAS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />

    <style>
        .toggle.btn {
            min-width: 3.7rem;
            min-height: 0.15rem;
            border-radius: 1rem;
            width: 6rem !important;
            height: 23px !important;
        }
    </style>

}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>
    <script>
        var oDatatable = null;

        function carregaSelect2() {

            AddSelect("iEstado", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboUf", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iPlano", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboPlano", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iProduto", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboProduto", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iVendedor", "@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboVendedor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, null, null, null, null, false);
            AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboFuncionarioSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iEmpresa", "@CONSTANTES.URLPortal/api/Empresaapi/GetComboEmpresaAniel", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }

        $('#iEstado').change(function () { mudancaUF() });

        var filter_state = {
            periodo: {
                label: "@RsFinanceiro.PERIODO", getDisplay: () => {

                    var tipo_data = "";
                    switch ($('input[name="tipodata"]:checked').val()) {

                        case "criacao": { tipo_data = "(@RsCadastros.DATA_CRIACAO) "; break; }
                        case "cancelamento": { tipo_data = "(@RsCadastros.DATA_CANCELAMENTO) "; break; }
                    }

                    return Boolean($('#iDataInicio').val()) ? tipo_data + ($('#iDataInicio').val() + " a " + $('#iDataFim').val()) : ""

                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            vendedor: {
                label: "@RsCadastros.VENDEDOR",
                getDisplay: () => { return Boolean($('#iVendedor').val()) ? $('#iVendedor option:selected').text() : "" },
                onclick: () => {
                    $('#iVendedor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            plano: {
                label: "@RsCadastros.PLANO",
                getDisplay: () => { return Boolean($('#iPlano').val()) ? $('#iPlano option:selected').text() : "" },
                onclick: () => {
                    $('#iPlano').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            produto: {
                label: "@RsCadastros.PRODUTO",
                getDisplay: () => { return Boolean($('#iProduto').val()) ? $('#iProduto option:selected').text() : "" },
                onclick: () => {
                    $('#iProduto').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            tipo_cadastro: {
                label: "@RsCadastros.TIPO_CADASTRO",
                getDisplay: () => { return Boolean($('#iTipoCadastro').val()) ? $('#iTipoCadastro option:selected').text() : "" },
                onclick: () => {
                    $('#iTipoCadastro').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            uf: {
                label: "@RsCadastros.UF",
                getDisplay: () => { return Boolean($('#iEstado').val()) ? $('#iEstado option:selected').text() : "" },
                onclick: () => {
                    $('#iEstado').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            cidade: {
                label: "@RsCadastros.CIDADE",
                getDisplay: () => { return Boolean($('#iCidade').val()) ? $('#iCidade option:selected').text() : "" },
                onclick: () => {
                    $('#iCidade').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
        }

        async function mudancaUF() {
            let estadoVal = $('#iEstado' + ' option:selected').val(),
                estadoStr = $('#iEstado' + ' option:selected').text();
            if (!estadoVal) {
                $('#iCidade').select2('destroy');
                $('#iCidade').empty();
                $('#iCidade').append($('<option></option>').attr('value', "").text('@RsBase.TODOS'));
                return false;
            }
            AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades", @CONSTANTES.PaginacaoRegistros, null, estadoVal, null, "@RsBase.TODOS", false);
        };

        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {

            $('#iEstado').val(null).trigger('change');

            carregaSelect2()
            if (oDatatable != null) {
                oDatatable.draw()
            }
        })

        $(document).ready(async () => {
            $('#modal-filter').modal('show')
            carregaSelect2()
        })

        "use strict";

        function RenderValorRelatorio(data, type, row, meta) {
            if (data === null || data === undefined) return "0,00";
            else {
                if (type === "export")
                    return data
                        .replace("R$ ", "")
                        .replace("R$", "")
                        .replace(".", "")
                        .replace(",", ".");
                else {

                    return data;
                }
            }
        }

        var handleDataTableButtons = function () {

                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "Bfrti",
                    select: {
                        style: 'multi'
                    },
                    serverSide: true,
                    searching: true,
                    ordering: false,
                    paging: false,
                    deferRender: true,
                    scrollResize: true,
                    scrollY: '66vh',
                    stateSave: true,
                    scrollX: true,
                    fixedHeader: true,
                    initComplete: dataTableInitComplete,
                    drawCallback: () => {
                        TagFilter("FiltrosUtilizados", filter_state);
                        ResizeTable('divTable');
                    },
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: baseUrl + '/api/relatorioapi/RelatorioVendasNaoEfetivadas',
                        type: 'POST',
                        data: function (data) {
                            data.Data_Inicio = $('#iDataInicio').val();
                            data.Data_Fim = $('#iDataFim').val();
                            data.Tipo_Filtro = $('input[name="tipodata"]:checked').val();
                            data.Id_Vendedor = $('#iVendedor').val();
                            data.Id_Supervisor = $('#iSupervisor').val();
                            data.Plano = $('#iPlano').val();
                            data.Produto = $('#iProduto').val();
                            data.Tipo_Cadastro = $('#iTipoCadastro').val();
                            data.UF = $('#iEstado').val();
                            data.Cidade = $('#iCidade').val();
                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
                    },
                    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                        var str = "@RsCadastros.INFODATATABLE";
                        if (iTotal == 0) { iEnd = 0; iStart = 0; }
                        str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                        $("#dtLegend").html(str);

                        return "";
                    },
                    pageLength: 5,
                    order: [],
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTableRelatorio({
                        title: "@Html.Raw(ViewBag.Title)",
                        pageSize: "A3"
                    }),
                    columns: [
                        { data: "num_venda", className: "text-center", title: "@RsCadastros.NUMERO_VENDA", orderable: false },
                        { data: "tipo_cadastro", className: "text-center", title: "@RsCadastros.TIPO_CADASTRO", orderable: false },
                        { data: "data_criacao", className: "text-center", title: "@RsCadastros.DATA_CRIACAO", orderable: false },
                        { data: "data_cancelamento", className: "text-center", title: "@RsCadastros.DATA_CANCELAMENTO", orderable: false },
                        { data: "motivo_cancelamento", className: "text-center", title: "@RsCadastros.MOTIVO_CANCELAMENTO", orderable: false },
                        { data: "cliente_prospect", className: "text-center", title: "@RsCadastros.CLIENTE_PROSPECTO", orderable: false },
                        { data: "categoria_cliente", className: "text-center", title: "@RsCadastros.CATEGORIA_CLIENTE", orderable: false },
                        { data: "valor_venda", className: "text-center", title: "@RsCadastros.VALOR_VENDA", orderable: false },
                        { data: "uf_cidade", className: "text-center", title: "@RsCadastros.UF" + "/" + "@RsCadastros.CIDADE", orderable: false },
                        { data: "bairro", className: "text-center", title: "@RsCadastros.BAIRRO", orderable: false },
                        { data: "vendedor", className: "text-center", title: "@RsCadastros.VENDEDOR", orderable: false },
                        { data: "contatos_realizados", className: "text-center", title: "@RsCadastros.HISTORICO_CONTATOS", orderable: false },
                        { data: "planos_produtos", className: "text-center", title: "@RsCadastros.QTD_PLANO_PRODUTO", orderable: false }
                     ]
                });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });


                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    rows_selected = [];
                });
            },

            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(), "DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                    Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 30 dias", "warning");
                    return false
                }
            }

            if (oDatatable == null) {
                TableManageButtons.init();
            }
            else {
                oDatatable.draw()
            }

            $('#modal-filter').modal('hide')
        }

    </script>
}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page">
                <i class="fa fa-ban" aria-hidden="true"></i> @ViewBag.Title
            </h4>
           
            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">


                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>
                </div>


            </div>
        </div>

    </div>
    <div id="divSubTitle">
        <div id="FiltrosUtilizados" class="mr-2 ml-2 form-inline"></div>
        <div class="mr-2 ml-2 form-inline mt-1 fs-12">@(String.Format(RsFinanceiro.EMITIDO_POR_EM_AS, User.Identity.GetUserName(), DateTime.Now.ToString("dd/MM/yyyy"), DateTime.Now.ToString("HH:mm")))</div>
    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>


<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="form-group border_radius">
                    <div class="" style="display: grid;">
                        <div class="">
                            <input type="radio" value="criacao" id="iDataCriacao" name="tipodata" checked /> <label for="iDataCriacao">@RsCadastros.DATA_CRIACAO</label>
                            <input type="radio" value="cancelamento" class="ml-2" id="iDataCancelamento" name="tipodata" /> <label for="iDataCancelamento">@RsCadastros.DATA_CANCELAMENTO</label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col form-inline text-center mt-1" style="display:block">
                            <input class="form-control obrigatorio datepicker-period mb-1"
                                   id="iDataInicio"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   value="@(DateTime.Now.ToString("01/MM/yyyy"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />

                            <span class="pl-3 pr-3">@RsBase.A</span>

                            <input class="form-control obrigatorio datepicker-period  mb-1"
                                   id="iDataFim"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   value="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   placeholder="00/00/0000" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iVendedor">@RsCadastros.VENDEDOR:</label>
                            <select class="form-control" id="iVendedor"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.SUPERVISOR @RsCadastros.COMERCIAL:</label>
                            <select class="form-control" id="iSupervisor"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iPlano">@RsCadastros.PLANO:</label>
                            <select class="form-control filtro" id="iPlano"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iProduto">@RsCadastros.PRODUTO:</label>
                            <select class="form-control filtro" id="iProduto"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iTipoCadastro">@RsCadastros.TIPO_CADASTRO:</label>
                            <select class="form-control" id="iTipoCadastro">
                                <option value="" selected>@RsBase.TODOS</option>
                                <option value="0">Prospects</option>
                                <option value="1">Clientes</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-4">
                        <div class="form-group">
                            <label for="iEstado">@RsCadastros.UF:</label>
                            <select class="form-control filtro" id="iEstado"></select>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label for="iCidade">@RsCadastros.CIDADE:</label>
                            <select class="form-control filtro" id="iCidade"></select>
                        </div>
                    </div>
                </div>
                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatableFunction(); $('#modal-filter').modal('hide');" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
