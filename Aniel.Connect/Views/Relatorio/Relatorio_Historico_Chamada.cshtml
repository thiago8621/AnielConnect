@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = RsCadastros.RELATORIO_HISTORICO_CHAMADAS_REALIZADAS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />

}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>
    <script>
        var oDatatable = null;



        function carregaSelect2() {
            AddSelect("iDid", "@CONSTANTES.URLPortal/api/DidApi/GetComboNum_Did", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iDidDestino", "@CONSTANTES.URLPortal/api/DidApi/GetComboNum_Did", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iDidOrigem", "@CONSTANTES.URLPortal/api/DidApi/GetComboNum_Did", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

        }


        var filter_state = {
            @*periodo: {
                label: "@RsFinanceiro.PERIODO", getDisplay: () => {

                    return Boolean($('#iDataInicio').val()) ? ($('#iDataInicio').val() + " a " + $('#iDataFim').val()) : ""

                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            equipe: {
                label: "@RsCadastros.TECNICO",
                getDisplay: () => { return Boolean($('#iEquipe').val()) ? $('#iEquipe option:selected').text() : "" },
                onclick: () => {
                    $('#iEquipe').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },empresa: {
                label: "@RsCadastros.EMPRESA",
                getDisplay: () => { return Boolean($('#iEmpresa').val()) ? $('#iEmpresa option:selected').text() : "" },
                onclick: () => {
                    $('#iEmpresa').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            filial: {
                label: "@RsCadastros.FILIAL",
                getDisplay: () => { return Boolean($('#iFilial').val()) ? $('#iFilial option:selected').text() : "" },
                onclick: () => {
                    $('#iFilial').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            monitor: {
                label: "@RsCadastros.MONITOR",
                getDisplay: () => { return Boolean($('#iMonitor').val()) ? $('#iMonitor option:selected').text() : "" },
                onclick: () => {
                    $('#iMonitor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            centroCusto: {
                label: "Centro de custo",
                getDisplay: () => { return Boolean($('#iCentro').val()) ? $('#iCentro option:selected').text() : "" },
                onclick: () => {
                    $('#iCentro').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            grupoArea: {
                label: "@RsCadastros.GRUPO_AREA",
                getDisplay: () => { return Boolean($('#iGrupoArea').val()) ? $('#iGrupoArea option:selected').text() : "" },
                onclick: () => {
                    $('#iGrupoArea').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            area: {
                label: "@RsCadastros.AREA",
                getDisplay: () => { return Boolean($('#iArea').val()) ? $('#iArea option:selected').text() : "" },
                onclick: () => {
                    $('#iArea').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            localidade: {
                label: "@RsCadastros.LOCALIDADE",
                getDisplay: () => { return Boolean($('#iLocalidade').val()) ? $('#iLocalidade option:selected').text() : "" },
                onclick: () => {
                    $('#iLocalidade').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            naturezaServico: {
                label: "@RsCadastros.NATUREZA",
                getDisplay: () => { return Boolean($('#iNatureza').val()) ? $('#iNatureza option:selected').text() : "" },
                onclick: () => {
                    $('#iNatureza').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            habilidadeTecnica: {
                label: "@RsCadastros.HABILIDADE_TECNICA",
                getDisplay: () => { return Boolean($('#iHabilidade').val()) ? $('#iHabilidade option:selected').text() : "" },
                onclick: () => {
                    $('#iHabilidade').val(null).trigger("change")
                    oDatatable.draw()
                }
            },*@


        }


        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {

            //data.Data_Inicio = $('#iDataInicio').val();
            //data.Data_Fim = $("#iDataFim").val();
            //data.Tipo_Data = $("#iDataAgendamento").is(':checked') ? "agendamento" : "encerramento";
            $('#iEquipe').val(null).trigger('change');
            $('#iSupervisor').val(null).trigger('change');


            carregaSelect2()
            if (oDatatable != null) {
                oDatatable.draw()
            }
        })

        $(document).ready(async () => {
            $('#modal-filter').modal('show')
            carregaSelect2()
        })

        "use strict";






        colunasDatatable = [
            { data: "numeroCircuito", className: "text-center", title: "@RsCadastros.NUMERO_CIRCUITO", orderable: false },
            { data: "data", className: "text-center", title: "@RsCadastros.DATA", orderable: false },
            { data: "didOrigem", className: "text-center", title: "@RsCadastros.DID_ORIGEM", orderable: false },
            { data: "didDestino", className: "text-center", title: "@RsCadastros.DID_DESTINO", orderable: false },
            { data: "sentido", className: "text-center", title: "@RsCadastros.SENTIDO", orderable: false },
            { data: "horaInicio", className: "text-center", title: "@RsCadastros.DATA_HORA_INICIO", orderable: false },
            { data: "horaFim", className: "text-center", title: "@RsCadastros.DATA_HORA_FIM", orderable: false },
            { data: "duracao", className: "text-center", title: "@RsCadastros.DURACAO", orderable: false },
            { data: "custoLigacao", className: "text-center", title: "@RsCadastros.CUSTO_LIGACAO", orderable: false },
            { data: "cidade", className: "text-center", title: "@RsCadastros.CIDADE", orderable: false },

        ];



        var handleDataTableButtons = function () {

            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                select: {
                    style: 'multi'
                },
                serverSide: true,
                searching: true,
                ordering: false,
                paging: false,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                drawCallback: () => {

                    TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                    $("#lbAgrupadoPor").html('Agrupado por: @Html.Raw(RsCadastros.TECNICO)');
                    ResizeTable('divTable');
                    if (oDatatable)
                        oDatatable.columns.adjust();

                },
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/Relatorio_Historico_ChamadaApiController/Relatorio_Historico_Chamada',
                    type: 'POST',
                    data: function (data) {
                        data.dataini = $(`#iDataInicio`).val();
                        data.datafim = $(`#iDataFim`).val();
                        data.id_did = $(`#iDid`).val();
                        data.id_didOrigem = $(`#iDidOrigem option:selected`).text();
                        data.id_didDestino = $(`#iDidDestino option:selected`).text();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                pageLength: 5,
                order: [],
                language: traducaoDataTableSimples,
                buttons: buttonsDataTableRelatorio({
                    title: "@Html.Raw(ViewBag.Title)",
                    pdfCustomize: function (doc) {

                        var agrupamento = [0];
                        doc.content[0].table.body = agruparDados(
                            agrupamento,
                            doc.content[0].table.body
                        );
                        const table = doc.content[0].table.body;
                        doc.content[0].table.body = table.map(p => {
                            if (!p[0].agrupamento) {
                                return p.filter((y, index) => !agrupamento.includes(index));
                            } else {
                                agrupamento.forEach(() => {
                                    p.pop();
                                })
                                return p;
                            }
                        });
                    },

                }),
                columns: colunasDatatable
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });

            $('#datatable tbody').on('click', 'tr.dtrg-level-0', function () {

                var rowsCollapse = $(this).nextUntil('.dtrg-level-0');

                if (!$(this).hasClass("collapsed") && !$(this).hasClass("not-collapsed")) {
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                else if ($(this).hasClass("collapsed")) {
                    $(this).removeClass("collapsed");
                    $(this).addClass("not-collapsed");
                    rowsCollapse.removeClass("d-none");
                }

                else if ($(this).hasClass("not-collapsed")) {
                    $(this).removeClass("not-collapsed");
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                oDatatable.columns.adjust();
            });
                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    rows_selected = [];
                });
            },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'years') + 1) > 1) {
                    Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 1 ano", "warning");
                    return false
                }
            }

            if (oDatatable == null) {
                TableManageButtons.init();
            }
            else {
                oDatatable.draw()
            }

            $('#modal-filter').modal('hide')


        }

    </script>
}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-tags"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">


                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>
                </div>

            </div>
        </div>

    </div>
    <div id="divSubTitle">
        <div id="FiltrosUtilizados" class="mr-2 ml-2 form-inline"></div>
        <div id="lbAgrupadoPor" class="fs-12 mr-2 ml-2 form-inline"></div>
        <div class="mr-2 ml-2 form-inline mt-1 fs-12">@(String.Format(RsFinanceiro.EMITIDO_POR_EM_AS, User.Identity.GetUserName(), DateTime.Now.ToString("dd/MM/yyyy"), DateTime.Now.ToString("HH:mm")))</div>
    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="form-group border_radius">

                    <div class="row">
                        <div class="col form-inline text-center mt-1" style="display:block">
                            <input class="form-control obrigatorio datepicker-period mb-1"
                                   id="iDataInicio"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   value="@(DateTime.Now.ToString("01/MM/yyyy"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />

                            <span class="pl-3 pr-3">@RsBase.A</span>

                            <input class="form-control obrigatorio datepicker-period  mb-1"
                                   id="iDataFim"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   value="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   placeholder="00/00/0000" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iDid">@RsCadastros.DID:</label>
                            <select class="form-control obrigatorio" id="iDid"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iDidOrigem">@RsCadastros.DID_ORIGEM:</label>
                            <select class="form-control" id="iDidOrigem"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iDidDestino">@RsCadastros.DID_DESTINO:</label>
                            <select class="form-control" id="iDidDestino"></select>
                        </div>
                    </div>
                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatableFunction(); $('#modal-filter').modal('hide');" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
