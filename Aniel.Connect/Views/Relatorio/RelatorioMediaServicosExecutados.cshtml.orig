<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col form-inline text-center mt-1" style="display:block">
                        <input class="form-control obrigatorio datepicker-period mb-1"
                               id="iDataInicial"
                               type="text"
                               data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                               data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                               autocomplete="off"
                               value="@(DateTime.Now.ToString("01/MM/yyyy"))"
                               placeholder="00/00/0000" />

                        <span class="">@RsBase.A</span>

                        <input class="form-control obrigatorio datepicker-period  mb-1"
                               id="iDataFim"
                               type="text"
                               data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                               data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                               autocomplete="off"
                               value="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                               placeholder="00/00/0000" />
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iTecnico">@RsCadastros.TECNICO:</label>
                            <select class="form-control filtro" id="iTecnico"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.EMPRESA:</label>
                            <select class="form-control filtro" id="iEmpresa"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.FILIAL:</label>
                            <select class="form-control filtro" id="iFilial" disabled></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.SUPERVISOR:</label>
                            <select class="form-control filtro" id="iSupervisor"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-4">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.GRUPO_AREA:</label>
                            <select class="form-control filtro" id="iGrupoArea"></select>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.AREA:</label>
                            <select class="form-control filtro" id="iArea" disabled></select>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.LOCALIDADE:</label>
                            <select class="form-control filtro" id="iLocalidade" disabled></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.NATUREZA:</label>
                            <select class="form-control filtro" id="iNatureza"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iTipo">@RsCadastros.TIPO_SERVICO:</label>
                            <select class="form-control filtro" id="iTip"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.PLANO_PRODUTO:</label>
                            <select class="form-control filtro" id="iPlano"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.UF:</label>
                            <input class="form-control filtro" id="iUF">
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.CIDADE:</label>
