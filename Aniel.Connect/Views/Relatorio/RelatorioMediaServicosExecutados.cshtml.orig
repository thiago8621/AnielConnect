                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">Agrupar por:</label>
                            <select class="form-control filtroAgru" id="iAgrupo">
                                <option value="nenhum">@RsCadastros.NENHUM</option>
                                <option value="supervisor">@RsCadastros.SUPERVISOREQUIPE</option>
                                <option value="empresa">@RsCadastros.EMPRESA</option>
                                <option value="filial">@RsCadastros.FILIAL</option>
                            </select>
