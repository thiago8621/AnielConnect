@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = @RsCadastros.RELATORIO_MEDIA_SERVICOS_EXECUTADOS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />

}

@section scripts
{

    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>

    <script>

        var oDatatable;

        $('#modal-filter').modal('show');
        AddSelect("iEmpresa", "@CONSTANTES.URLPortal/api/Empresaapi/GetComboEmpresaAniel", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor" , @CONSTANTES.PaginacaoRegistros, null, $('#iEmpresa').val(), null, "@RsBase.SELECIONE", false);
        AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo" , @CONSTANTES.PaginacaoRegistros, null, null , null, "@RsBase.SELECIONE", false);
        AddSelect("iNatureza", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo" , @CONSTANTES.PaginacaoRegistros, null, null , null, "@RsBase.SELECIONE", false);
        AddSelect("iTecnico", "@CONSTANTES.URLPortal/api/EquipeApi/GetComboAtribuirTecnico" , @CONSTANTES.PaginacaoRegistros, null, null , null, "@RsBase.SELECIONE", false);
        AddSelect("iTip", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboTipoServicoNatureza" , @CONSTANTES.PaginacaoRegistros, null, null , null, "@RsBase.SELECIONE", false);
        AddSelect("iPlano", "@CONSTANTES.URLPortal/api/Modelo_PainelVendaApi/GetComboPlanos" , @CONSTANTES.PaginacaoRegistros, null, null , null, "@RsBase.SELECIONE", false);

        $('#iEmpresa').change(function () {
            if ($('#iEmpresa').val())
            {
                $("#iFilial").prop("disabled", false);
                AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetComboFilialAniel", @CONSTANTES.PaginacaoRegistros, null, $('#iEmpresa').val(), null, "@RsBase.SELECIONE", false);
            }
        });

        $('#iGrupoArea').change(function () {
            if ($('#iGrupoArea').val()) {
                $("#iArea").prop("disabled", false);
                AddSelect("iArea", "@CONSTANTES.URLPortal/api/Areaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, $('#iGrupoArea').val(), null, "@RsBase.SELECIONE", false);
            }
            else {
                $('#iArea').val(null).trigger('change');
                $('#iLocalidade').val(null).trigger('change');
                $('#iArea').prop("disabled", true);
                $('#iLocalidade').prop("disabled", true);
            }
        });

        $('#iArea').change(function () {
            if ($('#iArea').val()) {
                $("#iLocalidade").prop("disabled", false);
                AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Areaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, $('#iArea').val(), $('#iGrupoArea').val(), "@RsBase.SELECIONE", false);
            } else {
                $('#iLocalidade').val(null).trigger('change');
                $('#iLocalidade').prop("disabled", true);
            }
        });

        $('#iNatureza').change(function () {

            if ($('#iNatureza').val()) {
                $('#iTip').val(null).trigger('change');
                AddSelect("iTip", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboTipoServicoNatureza", @CONSTANTES.PaginacaoRegistros, null, $('#iNatureza').val(), null, "@RsBase.SELECIONE", false);
            }
            else {
                $('#iTip').val(null).trigger('change');
                AddSelect("iTip", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboTipoServicoNatureza", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            }
        });

        var grupo_state =
        {
