                    oDatatable.draw()
                }
            },
            tecnico: {
                label: "@RsCadastros.TECNICO",
                getDisplay: () => { return Boolean($('#iTecnico').val()) ? $('#iTecnico option:selected').text() : "" },
                onclick: () => {
                    $('#iTecnico').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            planoProduto: {
                label: "@RsCadastros.PLANO_PRODUTO",
                getDisplay: () => { return Boolean($('#iPlano').val()) ? $('#iPlano option:selected').text() : "" },
                onclick: () => {
                    $('#iPlano').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            tipo: {
                label: "@RsCadastros.TIPO_SERVICO",
                getDisplay: () => { return Boolean($('#iTip').val()) ? $('#iTip option:selected').text() : "" },
                onclick: () => {
                    $('#iTip').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            filial: {
                label: "@RsCadastros.FILIAL",
                getDisplay: () => { return Boolean($('#iFilial').val()) ? $('#iFilial option:selected').text() : "" },
                onclick: () => {
                    $('#iFilial').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            filial: {
                label: "@RsCadastros.FILIAL",
                getDisplay: () => { return Boolean($('#iFilial').val()) ? $('#iFilial option:selected').text() : "" },
                onclick: () => {
                    $('#iFilial').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            monitor: {
                label: "@RsCadastros.MONITOR",
                getDisplay: () => { return Boolean($('#iMonitor').val()) ? $('#iMonitor option:selected').text() : "" },
                onclick: () => {
                    $('#iMonitor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            centroCusto: {
                label: "Centro de custo",
                getDisplay: () => { return Boolean($('#iCentroCusto').val()) ? $('#iCentroCusto option:selected').text() : "" },
                onclick: () => {
                    $('#iCentroCusto').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            centroCusto: {
                label: "Centro de custo",
                getDisplay: () => { return Boolean($('#iCentroCusto').val()) ? $('#iCentroCusto option:selected').text() : "" },
                onclick: () => {
                    $('#iCentroCusto').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            grupoArea: {
                label: "@RsCadastros.GRUPO_AREA",
                getDisplay: () => { return Boolean($('#iGrupoArea').val()) ? $('#iGrupoArea option:selected').text() : "" },
                onclick: () => {
                    $('#iGrupoArea').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            area: {
                label: "@RsCadastros.AREA",
                getDisplay: () => { return Boolean($('#iArea').val()) ? $('#iArea option:selected').text() : "" },
                onclick: () => {
                    $('#iArea').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            localidade: {
                label: "@RsCadastros.LOCALIDADE",
                getDisplay: () => { return Boolean($('#iLocalidade').val()) ? $('#iLocalidade option:selected').text() : "" },
                onclick: () => {
                    $('#iLocalidade').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            naturezaServico: {
                label: "@RsCadastros.NATUREZA",
                getDisplay: () => { return Boolean($('#iNatureza').val()) ? $('#iNatureza option:selected').text() : "" },
                onclick: () => {
                    $('#iNatureza').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            naturezaServico: {
                label: "@RsCadastros.NATUREZA",
                getDisplay: () => { return Boolean($('#iNatureza').val()) ? $('#iNatureza option:selected').text() : "" },
                onclick: () => {
                    $('#iNatureza').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            uf: {
                label: "@RsCadastros.UF",
                getDisplay: () => { return Boolean($('#iUF').val()) ? $('#iUF option:selected').text() : "" },
                onclick: () => {
                    $('#iUF').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            cidade: {
                label: "@RsCadastros.CIDADE",
                getDisplay: () => { return Boolean($('#iCidade').val()) ? $('#iCidade option:selected').text() : "" },
                onclick: () => {
                    $('#iCidade').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
        }

        jQuery.fn.dataTable.Api.register( 'average()', function () {
            var data = this.flatten();
            var sum = data.reduce( function ( a, b ) {
                return (a*1) + (b*1); // cast values in-case they are strings
            }, 0 );
 
            return sum / data.length;
        } );

        var somar_func = function Somar(valor1, valor2, precision = 2) {
            return Number(valor1) + Number(valor2);
        };

        var media_func = function media(valor1, valor2, precision = 2) {
            return (valor1 + valor2) / 2;
        };

        function CalculaTotalColunaDataTable(
          rows,
          colunas,
          group,
          columns_length,
          level,
          calculoRateio = false
        ) {
          //settings, api, colunas,coluna_grupo

          if (!group) group = "Sem Grupo";

          var retorno = {
            string_append: "",
            array_colunas_calculadas: []
          };

          var valores = [];

          colunas.forEach(function(item, index) {
            var sum =
              calculoRateio == true
                ? rows.reduce(function(a, b) {
                    return item.funcao_principal(a, b);
                  }, 0)
                : rows
                    .data()
                    .pluck(item.nome)
                    .reduce(function(a, b) {
                      return item.funcao_principal(a, b);
                    }, 0);

              if (item.media) {
                  sum = Dividir(sum,rows.data().length);
              }

            var obj = {
              valor: sum,
              index_coluna: item.index_coluna,
              cor: item.funcao_cor,
              lista_coluna_alteracao: item.lista_coluna_alteracao,
              classNameList: item.classNameList
            };

            valores.push(obj);
          });

          var valores_ordenados_coluna = valores.sort(
            (a, b) => a.index_coluna - b.index_coluna
          );
          retorno.array_colunas_calculadas = valores_ordenados_coluna;

          retorno.string_append = tituloRowGroup(group, level);

          if (retorno.string_append) {
            for (let j = 0; j < valores_ordenados_coluna.length; j++) {
              var classes_css = "";

              valores_ordenados_coluna[j].classNameList.forEach(function(item) {
                classes_css += item;
              });

              var obj_coluna = valores_ordenados_coluna[j];
              let cor = obj_coluna.cor ? obj_coluna.cor(obj_coluna.valor) : "#5f5f5f";

              retorno.string_append += preencheColunasAnteriores(valores, j);
              retorno.string_append += `<td data_column=${
                obj_coluna.index_coluna
              } style="color:${cor};" class="${classes_css}" colspan="1"><label class="${classes_css}">${
                obj_coluna.valor
              }</label></td>`;
            }

            if (valores_ordenados_coluna.length !== 0) {
              retorno.string_append += preencheColunasRestantes(
                valores,
                columns_length
              );
            } else {
              for (let i = 1; i < columns_length; i++) {
                retorno.string_append += "<td></td>";
              }
            }
          }

          return retorno;
        }

        function handleDataTableButtons() {

            let colunasDatatable =
                [
                    { data: "matricula", title: "@RsCadastros.MATRICULA" },
                    { data: "tecnico", title: "@RsCadastros.TECNICO" },
                    { data: "diasTrabalhados", title: "@RsCadastros.DIAS_TRABALHADOS" },
                    { data: "servicosProdutivos", title: "@RsCadastros.PRODUTIVOS", groupFunc: somar_func, indexColuna : 3 },
                    { data: "media", title: "@RsCadastros.MEDIA",groupFunc: funcao_soma_dinero, indexColuna : 4 },
                ];

            if ($('#iAgrupo').val() == "empresa") {
                colunasDatatable.push({ data: "empresa", title: "@RsCadastros.EMPRESA", visible: false })
            }
            if ($('#iAgrupo').val() == "filial") {
                colunasDatatable.push({ data: "filial", title: "@RsCadastros.FILIAL", visible: false })
            }
            if ($('#iAgrupo').val() == "supervisor") {
                colunasDatatable.push({ data: "supervisor", title: "@RsCadastros.SUPERVISOR", visible: false })
            }



            if ($('#iDataInicial').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicial').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                    Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 30 dias", "warning");
                    return false
                }
            }

            if (oDatatable != null) {
                oDatatable.destroy();
                $('#datatable').empty();
            }
            
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                select: {
                    style: 'multi'
                },
                serverSide: true,
                searching: true,
                ordering: false,
                paging: false,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                drawCallback: () => {

                    TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                    TagFilter("AgruUtilizados", grupo_state, "Agrupado por:");

                    ResizeTable('divTable');
                    if (oDatatable)
                        oDatatable.columns.adjust();

                },
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/Dashboard_Servicosapi/RelatorioMediaServicosExecutados',
                    type: 'POST',
                    data: function (data) {
                        data.inicial = $('#iDataInicial').val();
                        data.final = $("#iDataFim").val();
                        data.empresa = $('#iEmpresa').val();
                        data.filial = $('#iFilial').val();
                        data.supervisor = $('#iSupervisor').val();
                        data.planoProduto = $('#iPlano').val();
                        data.grupoArea = $('#iGrupoArea').val();
                        data.tipoServico = $('#iTipo').val();
                        data.area = $('#iArea').val();
                        data.localidade = $('#iLocalidade').val();
                        data.natureza = $('#iNatureza').val();
                        data.uf = $('#iUF').val();
                        data.cidade = $('#iCidade').val();
                        data.agrupamento = $('#iAgrupo').val();
                        data.tecnico = $('#iTecnico').val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                pageLength: 5,
                order: [],
                language: traducaoDataTableSimples,
                buttons: buttonsDataTableRelatorio({
                    title: "@Html.Raw(ViewBag.Title)",
                    pdfCustomize: function (doc) {

                        var agrupamento = [5];

                        if ($("#iAgrupamento").val() != "nenhum") {

                            doc.content[0].table.body = agruparDados(
                                agrupamento,
                                doc.content[0].table.body
                            );
                            const table = doc.content[0].table.body;
                            doc.content[0].table.body = table.map(p => {
                                if (!p[0].agrupamento) {
                                    return p.filter((y, index) => !agrupamento.includes(index));
                                } else {
                                    agrupamento.forEach(() => {
                                        p.pop();
                                    })
                                    return p;
                                }
                            });
                        }
                    },

                }),
                rowGroup: {
                    emptyDataGroup: 'Sem Grupo',
                    dataSrc: [$('#iAgrupo').val()],
                    startRender: function (rows, group, level) {

                        let colunasGroup = [];

                        colunasDatatable.filter(p => p.groupFunc).forEach((col, index) => {
                            let colunaAgrupamento = ColunaRowGroup(col.data, col.indexColuna, col.title, 0, col.groupFunc, () => "black", [], []);
                            if (col.indexColuna == 4)
                                colunaAgrupamento.media = true;

                            colunasGroup.push(colunaAgrupamento);
                        });

                        var retorno = CalculaTotalColunaDataTable(rows, colunasGroup, group, rows.columns().visible().toArray().filter(p => p === true).length, level);
                        return $('<tr>').append(retorno.string_append);
                    },
                    endRender: function (rows, group) {}
                },
                columns: colunasDatatable,
            });

            media_func = function Media() {
                return oDatatable.column(4).data().average();
            }

            $('#datatable tbody').on('click', 'tr.dtrg-level-0', function () {

                var rowsCollapse = $(this).nextUntil('.dtrg-level-0');

                if (!$(this).hasClass("collapsed") && !$(this).hasClass("not-collapsed")) {
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                else if ($(this).hasClass("collapsed")) {
                    $(this).removeClass("collapsed");
                    $(this).addClass("not-collapsed");
                    rowsCollapse.removeClass("d-none");
                }

                else if ($(this).hasClass("not-collapsed")) {
                    $(this).removeClass("not-collapsed");
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                oDatatable.columns.adjust();
            });

            $('#modal-filter').modal('hide');

        }



        function limpaFiltros() {
            $(".filtro").val(null);
            $(".filtro").empty();
            $("#iAgrupo").val($("#iAgrupo option:first").val());
            $('#iLocalidade').prop("disabled", true);
            $('#iArea').prop("disabled", true);
            $('#iFilial').prop("disabled", true);
        }

    </script>

}
