@{
    ViewBag.Title = "Áreas de Atuação e Naturezas Vinculadas ao Técnico";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />

}

<style>
    table.dataTable thead th {
        background-color: #357ca5 !important;
        font-weight: normal !important;
        color: white
    }

    table.dataTable thead th, table.dataTable thead td {
        padding: 5px 10px 0px 5px !important;
    }

    th, table.dataTable tbody td {
        padding: 4px 5px;
    }

    tr {
        background-color: #fff;
    }

        tr.group
        tr.group:hover {
            background-color: #5ca7f8;
        }

        tr.dtrg-level-0 td {
            color: #fff;
            background-color: #5ca7f8 !important;
        }

    td.dtrg-group {
        background-color: #5ca7f8 !important;
    }
</style>



@section scripts{

    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>


    <script>

        var oDatatableArea = null;

        var HandleGrupo = function () {
            $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

                GrupoSelecionado  = e.params.data
                if (GrupoSelecionado) {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false, HandleArea);
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

                else {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
                }

            });
        };

        var HandleArea = function () {
            $('#iArea').on('select2:select select2:unselecting', function (e) {

                AreaSelecionada = e.params.data
                if (AreaSelecionada) {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id) , null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };

        function carregaSelect2(){
            AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupo);
            AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
            AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iEquipe", "@CONSTANTES.URLPortal/api/Equipeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iPerfil", "@CONSTANTES.URLPortal/api/PerfilAgendamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iHabilidades", "@CONSTANTES.URLPortal/api/Localidadeapi/GetComboHabilidadesTecnico", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iNatureza", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iEquipe", "@CONSTANTES.URLPortal/api/Equipeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor" , @CONSTANTES.PaginacaoRegistros, null, $('#iEmpresa').val(), null, "@RsBase.SELECIONE", false);
            AddSelect("iMonitor", "@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboMonitor" , @CONSTANTES.PaginacaoRegistros, null, null , null, "@RsBase.SELECIONE", false);

        }


        var filter_state_area = {
             supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            monitor: {
                label: "@RsCadastros.MONITOR",
                getDisplay: () => { return Boolean($('#iMonitor').val()) ? $('#iMonitor option:selected').text() : "" },
                onclick: () => {
                    $('#iMonitor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            equipe: {
                label: "@RsCadastros.EQUIPE",
                getDisplay: () => { return Boolean($('#iTecnico').val()) ? $('#iEquipe option:selected').text() : "" },
                onclick: () => {
                    $('#iEquipe').val(null).trigger("change")
                    oDatatableArea.draw()
                }

            },
            grupo_area: {
                label: "@RsCadastros.GRUPO_AREA",
                getDisplay: () => { return Boolean($('#iGrupoArea').val()) ? $('#iGrupoArea option:selected').text() : "" },
                onclick: () => {
                    $('#iGrupoArea').val(null).trigger("change")
                    $('#iArea').val(null).trigger("change")
                    $('#iLocalidade').val(null).trigger("change")
                    oDatatableArea.draw()
                }
            },
            area: {
                label: "@RsCadastros.AREA",
                getDisplay: () => { return Boolean($('#iArea').val()) ? $('#iArea option:selected').text() : "" },
                onclick: () => {
                    $('#iArea').val(null).trigger("change")
                    $('#iLocalidade').val(null).trigger("change")
                    oDatatableArea.draw()
                }

            },
            localidade: {
                label: "@RsCadastros.LOCALIDADE",
                getDisplay: () => { return Boolean($('#iLocalidade').val()) ? $('#iLocalidade option:selected').text() : "" },
                onclick: () => {
                    $('#iLocalidade').val(null).trigger("change")
                    oDatatableArea.draw()
                }

          },
               perfil: {
                label: "@RsCadastros.PERFIL",
                getDisplay: () => { return Boolean($('#iPerfil').val()) ? $('#iPerfil option:selected').text() : "" },
                onclick: () => {
                    $('#iPerfil').val(null).trigger("change")
                    oDatatableArea.draw()
                }

          },
                 habilidades: {
                label: "@RsCadastros.LOCALIDADE",
                     getDisplay: () => { return Boolean($('#iHabilidades').val()) ? $('#iHabilidades option:selected').text() : "" },
                onclick: () => {
                    $('#iHabilidades').val(null).trigger("change")
                    oDatatableArea.draw()
                }

          }
        }
          let colunasDatatableAreas =
              [
                { data: "matricula", title: "@RsCadastros.MATRICULA", data:"matricula" },
                { data: "equipe", title: "@RsCadastros.TECNICO" },
                { data: "grupo_Area", title: "@RsCadastros.GRUPO_AREA", orderable: false },
                { data: "area", title: "@RsCadastros.AREA", orderable: false },
                {
                    data: "localidade", title: "@RsCadastros.LOCALIDADE", orderable: false,
                    render: function (data, type, row, meta) {
                        let retorno = "";
                        retorno = data ?? "Todas"
                        return retorno
                    }
                  },
                { data: "habilidades", title: "@RsCadastros.NATUREZA", orderable: false },
                { data: "supervisor", title: "@RsCadastros.SUPERVISOR", orderable: false },
                { data: "monitor", title: "@RsCadastros.MONITOR", orderable: false },
            ];

        function GetColunas()
        {
            const value = document.querySelector('input[name="iFiltros"]:checked').value;
            if (value === 'iAreasAtuacao') {
                return [
                    { data: "matricula", title: "@RsCadastros.MATRICULA", data: "matricula" },
                    { data: "equipe", title: "@RsCadastros.TECNICO" },
                    { data: "grupo_Area", title: "@RsCadastros.GRUPO_AREA", orderable: false },
                    { data: "area", title: "@RsCadastros.AREA", orderable: false },
                    {
                        data: "localidade", title: "@RsCadastros.LOCALIDADE", orderable: false,
                        render: function (data, type, row, meta) {
                            let retorno = "";
                            retorno = data ?? "Todas"
                            return retorno
                        }
                    },
                    { data: "supervisor", title: "@RsCadastros.SUPERVISOR", orderable: false },
                    { data: "monitor", title: "@RsCadastros.MONITOR", orderable: false },
                ];
            }
            if (value === 'iNaturezaAtuacao') {
                return [
                    { data: "matricula", title: "@RsCadastros.MATRICULA", data: "matricula" },
                    { data: "equipe", title: "@RsCadastros.TECNICO" },

                    { data: "habilidades", title: "@RsCadastros.NATUREZA", orderable: false },
                    { data: "supervisor", title: "@RsCadastros.SUPERVISOR", orderable: false },
                    { data: "monitor", title: "@RsCadastros.MONITOR", orderable: false },
                ];

            } else if(!value) {
                Notificar("@RsBase.ATENCAO_", "Selecione uma opção de filtro", "warning");
                return false
            }
        }

        "use strict";
        function oDatatableAreaFunction() {

            if ($.fn.DataTable.isDataTable('#datatable')) {
                $('#datatable').DataTable().destroy();
            }

            $('#datatable tbody').empty();
            $('#datatable thead').empty();
            oDatatableArea = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                select: {
                    style: 'multi'
                },
                serverSide: true,
                searching: true,
                ordering: false,
                paging: false,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                drawCallback: () => {
                    TagFilter("FiltrosUtilizadosArea", filter_state_area)
                    $("#lbAgrupadoPor").html('Agrupado por: @Html.Raw(RsCadastros.TECNICO)');
                    ResizeTable('divTable');
                    if (oDatatableArea)
                        oDatatableArea.columns.adjust();
                },
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/Areaapi/RelatorioAreaVinculadaTecnico',
                    type: 'POST',
                    data: function (data) {

                        const value = document.querySelector('input[name="iFiltros"]:checked').value;
                        if (value === 'iAreasAtuacao') {
                            data.TipoRelatorio = "area";
                        }
                        if (value === 'iNaturezaAtuacao') {
                            data.TipoRelatorio = "habilidade";

                        } else if (!value) {
                            Notificar("@RsBase.ATENCAO_", "Selecione uma opção de filtro", "warning");
                            return false
                        }

                        data.supervisor = $('#iSupervisor').val();
                        data.monitor = $('#iMonitor').val();
                        data.equipe = $('#iEquipe').val();
                        data.grupo_Area = $("#iGrupoArea").val();
                        data.area = $("#iArea").val();
                        data.perfil = $("#iPerfil").val();
                        data.habilidades = $("#iHabilidades").val();
                        data.localidade = $("#iLocalidade option:selected").text();
                        data.agrupamento = $('#iAgrupamentoAreas').val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                pageLength: 5,
                order: [],
                language: traducaoDataTableSimples,
                buttons: buttonsDataTableRelatorio({
                    title: "@Html.Raw(ViewBag.Title)",
                    pdfCustomize: function (doc) {

                        var agrupamento = [0];
                        doc.content[0].table.body = agruparDados(
                            agrupamento,
                            doc.content[0].table.body
                        );
                        const table = doc.content[0].table.body;
                        doc.content[0].table.body = table.map(p => {
                            if (!p[0].agrupamento) {
                                return p.filter((y, index) => !agrupamento.includes(index));
                            } else {
                                agrupamento.forEach(() => {
                                    p.pop();
                                })
                                return p;
                            }
                        });
                    },

                }),
                rowGroup: {
                    emptyDataGroup: 'Sem Grupo',
                    dataSrc: "equipe",
                    startRender: function (rows, group, level) {

                        let colunasGroup = [];

                        colunasDatatableAreas.filter(p => p.groupFunc).forEach((col, index) => {
                            colunasGroup.push(ColunaRowGroup(col.data, 7, col.title, 0, col.groupFunc, () => "black", [], ["text-center"]));
                        });

                        var retorno = CalculaTotalColunaDataTable(rows, colunasGroup, group, rows.data().columns()[0].length, level);
                        return $('<tr>').append(retorno.string_append);
                    },
                    endRender: function (rows, group) {

                    }
                },
                columns: GetColunas()

            });


            oDatatableArea.on('draw', function () {
                // Update state of "Select all" control

                rows_selected = [];
            });


            $('#modal-filter-area').modal('hide');


            $('#datatable tbody').off().on('click', 'tr.dtrg-level-0', function () {

                var rowsCollapse = $(this).nextUntil('.dtrg-level-0');

                if (!$(this).hasClass("collapsed") && !$(this).hasClass("not-collapsed")) {
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                else if ($(this).hasClass("collapsed")) {
                    $(this).removeClass("collapsed");
                    $(this).addClass("not-collapsed");
                    rowsCollapse.removeClass("d-none");
                }

                else if ($(this).hasClass("not-collapsed")) {
                    $(this).removeClass("not-collapsed");
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                oDatatableArea.columns.adjust();
            });

        }


        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    oDatatableAreaFunction();
                }
            }
        }();


        if (oDatatableArea != null) {
            oDatatableArea.destroy();
            $('#datatable').empty();
        }

      //  TableManageButtons.init();

            // selecionando radio button
            document.querySelectorAll('input[name="iFiltros"]').forEach(cur => {
                cur.addEventListener('change', e => {
                    const value = document.querySelector('input[name="iFiltros"]:checked').value;
                    if (value === 'iAreasAtuacao') {
                        document.querySelector('#iPesquisar').setAttribute('data-target', '#modal-filter-area');
                        //$('#iNaturezaAtuacao').prop('disabled', true);
                        //$('#iNaturezaAtuacao').val(null).trigger('change');
                        carregaSelect2()
                    }
                    if (value === 'iNaturezaAtuacao') {
                        document.querySelector('#iPesquisar').setAttribute('data-target', '#modal-filter-area');

                        //$('#iAreasAtuacao').prop('disabled', true);
                        //$('#iAreasAtuacao').val(null).trigger('change');
                       // carregaSelectNatureza()
                        carregaSelect2()

                    } else if(!value) {
                        Notificar("@RsBase.ATENCAO_", "Selecione uma opção de filtro", "warning");
                        return false
                    }
                })

            });
        $('input[name="iFiltros"]').on('change', function () {
            $('select[name="iHabilidades"]').attr('disabled', this.value != "iNaturezaAtuacao")
        });

            $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {
                $('#iGrupoArea').val(null).trigger('change')
                $('#iHabilidades').val(null).trigger('change')
                $('#iEquipe').val(null).trigger('change')
                $('#iSupervisor').val(null).trigger('change')
                $('#iMonitor').val(null).trigger('change')
                $('#iArea').val(null).trigger('change')
                $('#iLocalidade').val(null).trigger('change')
                $('#iEquipe').val(null).trigger('change')
                $('#iNatureza').val(null).trigger('change')
                $('#iAreasAtuacao').prop('disabled', false)
                $('#iNaturezaAtuacao').attr('disabled', false)
                $('#iEquipe').val(null).trigger('change')
                if (oDatatableArea != null) {
                    oDatatableArea.draw()
                }
            })




    </script>
}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="far fa-calendar-check"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">


                @*<button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>*@

                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>
                </div>

            </div>
        </div>

    </div>
    <!--./main-->
    <!--Filtrando -->

    <div class="row col-8 mt-2 mr-2">

        <div class="col-4 mt-4 ml-4">
            <div class="form-group">
                <label for="iTecnico" class="mr-2">Filtrar por:</label>
                <input type="radio" name="iFiltros" value="iAreasAtuacao" id="iAreasAtuacao" /><label>Áreas de Atuação</label>
                <input type="radio" name="iFiltros" value="iNaturezaAtuacao" id="iNaturezaAtuacao" /><label>Natureza</label>

            </div>
        </div>

        <div class="row mr-2">
            <div class="row">
                <div class="col mr-2">
                    <div class="form-group">
                        <button type="button" class="btn btn-success" id="iPesquisar" style="margin-top: 15px; " data-toggle="modal">@RsCadastros.PESQUISAR</button>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col mr-2">
                    <div class="form-group">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal" style="margin-top: 15px;">@RsBase.LIMPAR_FILTRO</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<!--final filtrando-->

<div id="FiltrosUtilizadosArea" class="mt-2 mr-2 ml-2"></div>


<div id="FiltrosUtilizadosNatureza" class="mt-2 mr-2 ml-2"></div>
<div id="lbAgrupadoPor" class="fs-12 mr-2 ml-2 form-inline"></div>
<div class="mr-2 ml-2 form-inline mt-1 fs-12">@(String.Format(RsFinanceiro.EMITIDO_POR_EM_AS, User.Identity.Name, DateTime.Now.ToString("dd/MM/yyyy"), DateTime.Now.ToString("HH:mm")))</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>

</div>

<!--Modal Filters Area-->
<div class="modal" id="modal-filter-area">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.TECNICO:</label>
                            <select class="form-control" id="iEquipe"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.SUPERVISOR:</label>
                            <select class="form-control" id="iSupervisor"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.MONITOR:</label>
                            <select class="form-control" id="iMonitor"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iGrupoArea">@RsCadastros.GRUPO_AREA:</label>
                            <select class="form-control" id="iGrupoArea"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iArea">@RsCadastros.AREA:</label>
                            <select class="form-control" id="iArea"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iLocalidade">@RsCadastros.LOCALIDADE:</label>
                            <select class="form-control" id="iLocalidade"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iHabilidades">@RsCadastros.HABILIDADE_TECNICA:</label>
                            <select class="form-control" id="iHabilidades" name="iHabilidades"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iPerfil">@RsCadastros.PERFIL:</label>
                            <select class="form-control" id="iPerfil"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <input type="text" class="form-control" id="iAgrupamentoAreas" value="equipe" style="display:none;" />
                        </div>
                    </div>
                </div>
                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatableAreaFunction(); $('#modal-filter-area').modal('hide');" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
