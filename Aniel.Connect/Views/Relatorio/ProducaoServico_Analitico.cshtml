@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = RsCadastros.RELATORIO_PRODUCAO_ANALITICO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />

    <style>
        .toggle.btn {
            min-width: 3.7rem;
            min-height: 0.15rem;
            border-radius: 1rem;
            width: 6rem !important;
            height: 23px !important;
        }
    </style>

}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>
    <script>
        var oDatatable = null;

        var HandleContrato = function () {

            $('#iContrato').unbind('select2:select select2:unselecting');
            $('#iContrato').on('select2:select select2:unselecting', function (e) {

                Contrato = e.params.data
                if (Contrato) {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, Contrato.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
            });

        };

        var HandleNatureza = function () {

            $('#iNaturezaServico').unbind('select2:select select2:unselecting');
            $('#iNaturezaServico').on('select2:select select2:unselecting', function (e) {

                Natureza = e.params.data
                if (Natureza) {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboTipoServicoNatureza", @CONSTANTES.PaginacaoRegistros, null, Natureza.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboTipoServicoNatureza", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                }
            });

        };

        function carregaSelect2() {

            AddSelect("iContrato", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleContrato);
            AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iEquipe", "@CONSTANTES.URLPortal/api/EquipeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iPlanoProduto", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iNaturezaServico", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleNatureza);
            AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboTipoServicoNatureza", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }

        var filter_state = {
            periodo: {
                label: "@RsFinanceiro.PERIODO", getDisplay: () => {

                    var tipo_data = "";
                    switch ($('input[name="tipodata"]:checked').val()) {
                        case "servico": { tipo_data = "(@RsCadastros.SERVICO) "; break; }
                    }

                    return Boolean($('#iDataInicio').val()) ? tipo_data + ($('#iDataInicio').val() + " a " + $('#iDataFim').val()) : ""
                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            contrato: {
                label: "@RsCadastros.CONTRATO",
                getDisplay: () => { return Boolean($('#iContrato').val()) ? $('#iContrato option:selected').text() : "" },
                onclick: () => {
                },
                removable: false
            },
            projeto: {
                label: "@RsCadastros.PROJETO",
                getDisplay: () => { return Boolean($('#iProjeto').val()) ? $('#iProjeto option:selected').text() : "" },
                onclick: () => {

                },
                removable: false
            },
            equipe: {
                label: "@RsCadastros.TECNICO",
                getDisplay: () => { return Boolean($('#iEquipe').val()) ? $('#iEquipe option:selected').text() : "" },
                onclick: () => {
                    $('#iEquipe').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            tipoServico: {
                label: "@RsCadastros.TIPO_SERVICO",
                getDisplay: () => { return Boolean($('#iTipoServico').val()) ? $('#iTipoServico option:selected').text() : "" },
                onclick: () => {
                    $('#iTipoServico').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            naturezaServico: {
                label: "@RsCadastros.NATUREZA_SERVICO",
                getDisplay: () => { return Boolean($('#iNaturezaServico').val()) ? $('#iNaturezaServico option:selected').text() : "" },
                onclick: () => {
                    $('#iNaturezaServico').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
        }


        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {

            $("#iDataInicio").val(null).trigger('change');
            $("#iDataFim").val(null).trigger('change');
            $('#iEquipe').val(null).trigger('change');
            $('#iSupervisor').val(null).trigger('change');
            $('#iProducaoPrevista').prop('checked', false).trigger('change')
            $('#iServicoBaixadoMobile').prop('checked', false).trigger('change')
            $('#iServicoDocFisicoDevolvido').prop('checked', false).trigger('change')

            carregaSelect2()
            if (oDatatable != null) {
                oDatatable.draw()
            }
        })

        $(document).ready(async () => {
            $('#modal-filter').modal('show')
            carregaSelect2()
        })

        "use strict";

        function RenderValorRelatorio(data, type, row, meta) {
            if (data === null || data === undefined) return "0,00";
            else {
                if (type === "export")
                    return data
                        .replace("R$ ", "")
                        .replace("R$", "")
                        .replace(".", "")
                        .replace(",", ".");
                else {

                    return data;
                }
            }
        }

        var handleDataTableButtons = function () {

                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "Bfrti",
                    select: {
                        style: 'multi'
                    },
                    serverSide: true,
                    searching: true,
                    ordering: false,
                    paging: false,
                    deferRender: true,
                    scrollResize: true,
                    scrollY: '66vh',
                    stateSave: true,
                    scrollX: true,
                    fixedHeader: true,
                    initComplete: dataTableInitComplete,
                    drawCallback: () => {

                        TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                        ResizeTable('divTable');
                    },
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: baseUrl + '/api/DocumentoProducao/RelatorioProducaoServicoAnalitico',
                        type: 'POST',
                        async: false,
                        data: function (data) {
                            data.Data_Inicio = $('#iDataInicio').val();
                            data.TipoData = $('input[name=tipodata]:checked').val();
                            data.Data_Fim = $("#iDataFim").val();
                            data.Contrato = $('#iContrato').val();
                            data.Projeto = $('#iProjeto').val();
                            data.Equipe = $('#iEquipe').val();
                            data.Supervisor = $('#iSupervisor').val();
                            data.Natureza_Servico = $('#iNaturezaServico').val();
                            data.Tipo_Servico = $('#iTipoServico').val();
                            data.Producao_Prevista = $('#iProducaoPrevista').is(':checked')
                            data.Servico_Baixado_Mobile = $('#iServicoBaixadoMobile').is(':checked')
                            data.Servico_Doc_Fisico_Devolvido = $('#iServicoDocFisicoDevolvido').is(':checked')
                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
                    },
                    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                        var str = "@RsCadastros.INFODATATABLE";
                        if (iTotal == 0) { iEnd = 0; iStart = 0; }
                        str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                        $("#dtLegend").html(str);

                        return "";
                    },
                    pageLength: 5,
                    order: [],
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTableRelatorio({
                        title: "@Html.Raw(ViewBag.Title)",
                        pageSize: "A3"
                    }),
                    columns: [
                        { data: "contrato", className: "text-center", title: "@RsCadastros.CONTRATO", orderable: false },
                        { data: "projeto", className: "text-center", title: "@RsCadastros.PROJETO", orderable: false },
                        { data: "tecnico", className: "text-center", title: "@RsCadastros.TECNICO", orderable: false },
                        { data: "nome", className: "text-center", title: "@RsCadastros.NOME", orderable: false },
                        { data: "data_servico", className: "text-center", title: "@RsCadastros.DATA_SERVICO", orderable: false },
                        { data: "id_cliente", className: "text-center", title: "@RsCadastros.ID_CLIENTE", orderable: false },
                        {
                            data: "os", className: "text-center", title: "@RsCadastros.OS", orderable: false,
                            render: function (data, type) {
                                return type === 'export' ? '\u200C' + data : data;
                            }
                        },
                        { data: "cod_tipo_servico", className: "text-center", title: "@RsCadastros.CODIGO_TIPO_SERVICO", orderable: false },
                        { data: "desc_tipo_servico", className: "text-center", title: "@RsCadastros.DESCRICAO_TIPO_SERVICO", orderable: false },
                        { data: "tipo_imovel", className: "text-center", title: "@RsCadastros.TIPO_IMOVEL", orderable: false },
                        { data: "segmento", className: "text-center", title: "@RsCadastros.SEGMENTO", orderable: false },
                        { data: "cod_encerramento", className: "text-center", title: "@RsCadastros.CODIGO_ENCERRAMENTO", orderable: false },
                        { data: "desc_encerramento", className: "text-center", title: "@RsCadastros.DESCRICAO_ENCERRAMENTO", orderable: false },
                        { data: "doc_devolvido", className: "text-center", title: "@RsCadastros.DOCUMENTO_DEVOLVIDO", orderable: false },
                        { data: "cod_servico", className: "text-center", title: "@RsCadastros.CODIGO_SERVICO", orderable: false },
                        { data: "desc_servico", className: "text-center", title: "@RsCadastros.DESCRICAO_SERVICO", orderable: false },
                        { data: "unidade", className: "text-center", title: "@RsCadastros.UNIDADE", orderable: false },
                        { data: "qtd_produzida", className: "text-center", title: "@RsCadastros.QTD_PRODUZIDA", orderable: false, render: RenderValorRelatorio },
                        { data: "producao_acumulada", className: "text-center", title: "@RsCadastros.PRODUCAO_ACUMULADA", orderable: false, render: RenderValorRelatorio },
                        { data: "cod_preco", className: "text-center", title: "@RsCadastros.CODIGO_PRECO", orderable: false },
                        { data: "valor_classe", className: "text-center", title: "@RsCadastros.VALOR_CLASSE", orderable: false, render: RenderValorRelatorio },
                        { data: "valor_producao", className: "text-center", title: "@RsCadastros.VALOR_PRODUCAO", orderable: false, render: RenderValorRelatorio },
                        { data: "faixa_aplicada", className: "text-center", title: "@RsCadastros.FAIXA_APLICADA", orderable: false,  },
                        { data: "inicio_faixa", className: "text-center", title: "@RsCadastros.INICIO_FAIXA", orderable: false, render: RenderValorRelatorio },
                        { data: "final_faixa", className: "text-center", title: "@RsCadastros.FINAL_FAIXA", orderable: false, render: RenderValorRelatorio },
                        { data: "coeficiente_faixa", className: "text-center", title: "@RsCadastros.COEFICIENTE_FAIXA", orderable: false, render: RenderValorRelatorio },
                        { data: "valor_final_producao", className: "text-center", title: "@RsCadastros.VALOR_FINAL_PRODUCAO", orderable: false, render: RenderValorRelatorio }
                    ]
                });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });


                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    rows_selected = [];
                });
            },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ($("#iContrato").val() == null) {
                    if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                        Notificar("@RsBase.ATENCAO_", "Para um período maior que 30 dias selecione um contrato", "warning");
                        return false
                    }
                }
            }

            if (oDatatable == null) {
                TableManageButtons.init();
            }
            else {
                oDatatable.draw()
            }

            $('#modal-filter').modal('hide')


        }

    </script>
}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="far fa-clock"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">


                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>
                </div>
                

            </div>
        </div>

    </div>
    <div id="divSubTitle">
        <div id="FiltrosUtilizados" class="mr-2 ml-2 form-inline"></div>
        <div class="mr-2 ml-2 form-inline mt-1 fs-12">@(String.Format(RsFinanceiro.EMITIDO_POR_EM_AS, User.Identity.GetUserName(), DateTime.Now.ToString("dd/MM/yyyy"), DateTime.Now.ToString("HH:mm")))</div>
    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="form-group border_radius">
                    <div class="row container">

                        <div class="col">
                            <input type="radio" value="AGENDAMENTO" id="iDataAgendamento" name="tipodata" checked /> <label for="iDataAgendamento">@RsCadastros.DATA_AGENDAMENTO</label>
                        </div>
                        <div class="col">
                            <input type="radio" value="EXECUCAO" id="iDataExecucao" name="tipodata"  /> <label for="iDataExecucao">@RsCadastros.DATA_EXECUCAO</label>
                        </div>
                        <div class="col">
                            <input type="radio" value="CRIACAO" id="iDataCriacao" name="tipodata"  /> <label for="iDataCriacao">@RsCadastros.DATA_CRIACAO</label>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col form-inline text-center mt-1" style="display:block">
                            <input class="form-control obrigatorio datepicker-period mb-1"
                                   id="iDataInicio"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />

                            <span class="pl-3 pr-3">@RsBase.A</span>

                            <input class="form-control obrigatorio datepicker-period  mb-1"
                                   id="iDataFim"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iContrato">@RsCadastros.CONTRATO:</label>
                            <select class="form-control obrigatorio" id="iContrato"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iProjeto">@RsCadastros.PROJETO:</label>
                            <select class="form-control" id="iProjeto"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iEquipe">@RsCadastros.TECNICO:</label>
                            <select class="form-control" id="iEquipe"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.SUPERVISOR:</label>
                            <select class="form-control" id="iSupervisor"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iNaturezaServico">@RsCadastros.NATUREZA_SERVICO:</label>
                            <select class="form-control" id="iNaturezaServico"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iTipoServico">@RsCadastros.TIPO_SERVICO:</label>
                            <select class="form-control" id="iTipoServico"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="iProducaoPrevista" class="btn btn-success" data-toggle="toggle" data-on="Sim" data-off="Não">
                                @RsCadastros.EXIBIR_PRODUCAO_PREVISTA
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                           <label>
                                <input type="checkbox" id="iServicoBaixadoMobile" data-toggle="toggle" data-on="Sim" data-off="Não">
                                @RsCadastros.EXIBIR_SOMENTE_SERVICO_BAIXADO_MOBILE
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="iServicoDocFisicoDevolvido" data-toggle="toggle" data-on="Sim" data-off="Não">
                                @RsCadastros.EXIBIR_SOMENTE_SERVICO_DOC_FISICO_DEVOLVIDO
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatableFunction(); $('#modal-filter').modal('hide');" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

            </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
