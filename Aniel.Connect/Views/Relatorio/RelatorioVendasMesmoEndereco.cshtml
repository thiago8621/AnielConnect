                            <input type="radio" name="iTipoStatus" id="iStatusVendaPadrao" value="0" /> <label for="iStatusVendaPadrao" style="margin-left:3px;">Status Venda Padrão</label>
                            <input type="radio" name="iTipoStatus" id="iStatusVendaWorkflow" value="1" /> <label for="iStatusVendaWorkflow" style="margin-left:3px;">Status Venda Workflow</label>
                        </div>
                    </div>
                </div>
                <div class="row mt-1">
                    <div class="col-sm-12">
                        <div class="form-group divSelect">
