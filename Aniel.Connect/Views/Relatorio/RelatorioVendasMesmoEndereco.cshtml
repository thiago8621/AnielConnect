                                <option value="">Todos</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row d-flex mt-1">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iTipoEndereco">Endereço Por:</label> <br />
                            <select id="iTipoEndereco" class="form-control">
                                <option value="">Todos</option>
                                <option value="0">Endereço/Logradouro</option>
                                <option value="1">Condomínio/Prédio</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iCEP">CEP:</label> <br />
                            <input type="text" id="iCEP" placeholder="00000-000" class="form-control" maxlength="9" />
                        </div>
                    </div>
                </div>
                <div class="row d-flex mt-1">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iPais">País:</label> <br />
                            <select id="iPais" class="form-control">
                                <option value="">Selecione</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iUF">UF:</label> <br />
                            <select id="iUF" class="form-control">
                                <option value="">Selecione</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row d-flex mt-1">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iCidade">Cidade:</label> <br />
                            <select id="iCidade" class="form-control">
                                <option value="">Selecione</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iBairro">Bairro:</label> <br />
                            <select id="iBairro" class="form-control">
                                <option value="">Selecione</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row d-flex mt-1">
                    <div class="col-sm-6 divCondPredio" style="display:none">
                        <div class="form-group">
                            <label for="iCondominioPredio">Nome do Condomínio/Prédio:</label> <br />
                            <select id="iCondominioPredio" class="form-control">
                                <option value="">Selecione</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iCampanha">Campanha:</label> <br />
                            <select id="iCampanha" class="form-control">
                                <option value="">Selecione</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row d-flex mt-1">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iQtdeMesmoEnd">Qtde. Vendas no Mesmo Endereço:</label> <br />
                            <select id="iQtdeMesmoEnd" class="form-control">
                                <option value="">Todos</option>
                                <option value="1">Maior que</option>
                                <option value="2">Menor que</option>
                                <option value="3">Maior e/ou Igual</option>
                                <option value="4">Menor e/ou Igual</option>
                                <option value="5">Igual</option>
                                <option value="6">Entre</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-3 divValor" style="display:none">
                        <div class="form-group">
                            <label id="iValorLabel" for="iValor">Valor:</label> <br />
                            <input type="text" class="form-control" id="iValor" />
                        </div>
                    </div>
                    <div class="col-sm-3 divValorEntre" style="display:none">
                        <div class="form-group">
                            <label for="iValorFinal">Valor Final:</label> <br />
                            <input type="text" class="form-control" id="iValorFinal" />
                        </div>
                    </div>
                </div>
                <div class="row d-flex mt-1">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <label for="iMotivoVenda">Motivo/Justificativa Venda:</label> <br />
                            <select id="iMotivoVenda" class="form-control">
                                <option value="">Selecione</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group col-sm-12" style="padding: 15px; margin-top: 10px;">
                <div class="text-center">
                    <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                    <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                </div>
            </div>
        </div>
    </div>
</div>