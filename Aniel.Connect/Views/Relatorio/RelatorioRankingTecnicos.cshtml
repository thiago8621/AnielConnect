                getDisplay: () => { return Boolean($('#iMonitor').val()) ? $('#iMonitor option:selected').text() : "" },
                onclick: () => {
                    $('#iMonitor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            centroCusto: {
                label: "Centro de custo",
                getDisplay: () => { return Boolean($('#iCentroCusto').val()) ? $('#iCentroCusto option:selected').text() : "" },
                onclick: () => {
                    $('#iCentroCusto').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            centroCusto: {
                label: "Centro de custo",
                getDisplay: () => { return Boolean($('#iCentroCusto').val()) ? $('#iCentroCusto option:selected').text() : "" },
                onclick: () => {
                    $('#iCentroCusto').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            grupoArea: {
                label: "@RsCadastros.GRUPO_AREA",
