@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = RsCadastros.SERVICOSIMPRODUTIVOS_TAGENCERRAMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles{
    @Styles.RenderFormat(Aniel.Connect.SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/DataTables2.0/RowGroup-1.1.1/css/rowGroup.dataTables.css" rel="stylesheet" />
    <link href="~/Content/datatable-group.css" rel="stylesheet" />

}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script src="~/bin/Content/DataTables2.0/RowGroup-1.1.1/js/dataTables.rowGroup.min.js"></script>
    <script>
        var oDatatable = null;


        let HandleGrupo = function () {
            $('#iEncerramento').on('select2:select select2:unselecting', function (e) {

                Encerramento = e.params.data
                if (Encerramento) {
                    $('#iEncerramentoCodCt').val(Encerramento.codCt);
                }
                else {
                    $('#iEncerramentoCodCt').val(null);
                }
            });
        };

        function carregaSelect2(){
            AddSelect("iEquipe", "@CONSTANTES.URLPortal/api/EquipeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iPlanoProduto", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iCategoriaCliente", "@CONSTANTES.URLPortal/api/Categoria_Cliente_ConnectApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iEncerramento", "@CONSTANTES.URLPortal/api/Documento_Producaoapi/GetComboCodigoEncerramento", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupo);
            AddSelect("iCliente", "@CONSTANTES.URLPortal/api/clienteanielapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }

        $('#iEstadosBrasil').change(function () {
            var estado = $('#iEstadosBrasil option:selected').val();
            AddSelect("iCidade", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboCidades", @CONSTANTES.PaginacaoRegistros, null, estado, null, "@RsBase.SELECIONE", false);
        });

        var filter_state = {
            periodo: {
                label: "@RsFinanceiro.PERIODO", getDisplay: () => {

                    var tipo_data = "";
                    switch ($('input[name="tipodata"]:checked').val()) {

                        case "criacao": { tipo_data = "(@RsCadastros.CRIACAO) "; break; }
                        case "agendamento": { tipo_data = "(@RsCadastros.AGENDAMENTO) "; break; }
                        case "baixa" :{ tipo_data = "(@RsCadastros.ENCERRAMENTO) "; break; }
                    }

                    return Boolean($('#iDataInicio').val()) ? tipo_data + ($('#iDataInicio').val() + " a " + $('#iDataFim').val()) : ""

                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            equipe: {
                label: "@RsCadastros.TECNICO",
                getDisplay: () => { return Boolean($('#iEquipe').val()) ? $('#iEquipe option:selected').text() : "" },
                onclick: () => {
                    $('#iEquipe').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            encerramento: {
                label: "@RsCadastros.TAG_ENCERRAMENTO",
                getDisplay: () => { return Boolean($('#iEncerramento').val()) ? $('#iEncerramento option:selected').text() : "" },
                onclick: () => {
                    $('#iEncerramento').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            cliente : {
                label: "@RsCadastros.CLIENTE",
                getDisplay: () => { return Boolean($('#iCliente').val()) ? $('#iCliente option:selected').text() : "" },
                onclick: () => {
                    $('#iCliente').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            categoriaCliente : {
                label: "@RsCadastros.CATEGORIA_CLIENTE",
                getDisplay: () => { return Boolean($('#iCategoriaCliente').val()) ? $('#iCategoriaCliente option:selected').text() : "" },
                onclick: () => {
                    $('#iCategoriaCliente').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            tipo_servico : {
                label: "@RsCadastros.TIPO_SERVICO",
                getDisplay: () => { return Boolean($('#iTipoServico').val()) ? $('#iTipoServico option:selected').text() : "" },
                onclick: () => {
                    $('#iTipoServico').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            plano_produto : {
                label: "@RsCadastros.PLANO_PRODUTO",
                getDisplay: () => { return Boolean($('#iPlanoProduto').val()) ? $('#iPlanoProduto option:selected').text() : "" },
                onclick: () => {
                    $('#iPlanoProduto').val(null).trigger("change")
                    oDatatable.draw();
                }
            },
            uf : {
                label: "@RsCadastros.UF",
                getDisplay: () => { return Boolean($('#iEstadosBrasil').val()) ? $('#iEstadosBrasil option:selected').text() : "" },
                onclick: () => {
                    $('#iEstadosBrasil').val('').trigger("change")
                    oDatatable.draw();
                }
            },
            cidade : {
                label: "@RsCadastros.CIDADE",
                getDisplay: () => { return Boolean($('#iCidade').val()) ? $('#iCidade option:selected').text() : "" },
                onclick: () => {
                    $('#iCidade').val(null).trigger("change")
                    oDatatable.draw();
                }
            }

        }


        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {

            //data.Data_Inicio = $('#iDataInicio').val();
            //data.Data_Fim = $("#iDataFim").val();
            //data.Tipo_Data = $("#iDataAgendamento").is(':checked') ? "agendamento" : "encerramento";
            $('#iEquipe').val(null).trigger('change');
            $('#iSupervisor').val(null).trigger('change');
            $('#iTipoServico').val(null).trigger('change');
            $('#iCliente').val(null).trigger('change');
            $('#iCategoriaCliente').val(null).trigger('change');
            $('#iEncerramentoCodCt').val(null).trigger('change');
            $('#iEncerramento').val(null).trigger('change');
            $('#iEstadosBrasil').val('').trigger('change');
            $('#iCidade').val(null).trigger('change');
            $('#iPlanoProduto').val(null).trigger('change');
            $('#iEstadosBrasil').val('').change();

            carregaSelect2()
            if (oDatatable != null) {
                oDatatable.draw()
            }
        })

        $(document).ready(async () => {
            $('#modal-filter').modal('show')
            carregaSelect2()
        })

        

        "use strict";

        var handleDataTableButtons = function () {

                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "Bfrti",
                    select: {
                        style: 'multi'
                    },
                    serverSide: true,
                    searching: true,
                    ordering: false,
                    paging: false,
                    deferRender: true,
                    scrollResize: true,
                    scrollY: '66vh',
                    stateSave: true,
                    scrollX: true,
                    fixedHeader: true,
                    initComplete: dataTableInitComplete,
                    drawCallback: () => {

                        TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                        $("#lbAgrupadoPor").html('Agrupado por: @Html.Raw(RsCadastros.TAG_ENCERRAMENTO)');
                        ResizeTable('divTable');
                    },
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: baseUrl + '/api/DocumentoProducao/ServicosImprodutivos',
                        type: 'POST',
                        async: false,
                        data: function (data) {
                            data.Data_Inicio = $('#iDataInicio').val();
                            data.Data_Fim = $("#iDataFim").val();
                            data.Tipo_Data = $("#iDataAgendamento").is(':checked') ? "agendamento" : "encerramento";
                            data.Equipe = $('#iEquipe').val();
                            data.Supervisor = $('#iSupervisor').val();
                            data.Cod_Tipo_Serv = $('#iTipoServico').val();
                            data.Id_Categoria_Cliente = $('#iCategoriaCliente').val();
                            data.Id_Cliente = $('#iCliente').val();
                            data.CodCt_Encerramento = $('#iEncerramentoCodCt').val();
                            data.Codigo_Encerramento = $('#iEncerramento').val();
                            data.UF = $('#iEstadosBrasil').val();
                            data.Cidade = $('#iCidade').text();
                            data.Id_PlanoProduto = $('#iPlanoProduto').val()
                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
                    },
                    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                        var str = "@RsCadastros.INFODATATABLE";
                        if (iTotal == 0) { iEnd = 0; iStart = 0; }
                        str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                        $("#dtLegend").html(str);

                        return "";
                    },
                    pageLength: 5,
                    order: [],
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTableRelatorio({
                        title: "@Html.Raw(ViewBag.Title)",
                        pdfCustomize: function (doc) {

                            var agrupamento = [0];
                            doc.content[0].table.body = agruparDados(
                                agrupamento,
                                doc.content[0].table.body,
                                'serviço(s)'
                            );
                            const table = doc.content[0].table.body;
                            doc.content[0].table.body = table.map(p => {
                                if (!p[0].agrupamento) {
                                    return p.filter((y, index) => !agrupamento.includes(index));
                                } else {
                                    agrupamento.forEach(() => {
                                        p.pop();
                                    })
                                    return p;
                                }
                            });
                        },

                    }),
                    rowGroup: {
                        emptyDataGroup: 'Sem Grupo',
                        dataSrc: ['encerramento'],
                        startRender: function (rows, group, level) {

                            var retorno = CalculaTotalColunaDataTable(rows, [], group, rows.data().columns()[0].length-1, level);
                            return $('<tr>').append(retorno.string_append.replace(group, `${group}: ${rows.data().length} serviço(s)`));
                        },
                        endRender: function (rows, group) {
                            if (oDatatable)
                                oDatatable.columns.adjust();
                            else
                                $("#datatable").DataTable().columns.adjust();

                            ResizeTable('divTable');
                        }
                    },
                    columns: [
                        { data: "encerramento", className: "text-center", title: "@RsCadastros.TAG_ENCERRAMENTO", visible: false },
                        {
                            data: "numero_obra", className: "text-center", title: "@RsCadastros.NUMERO_OS", orderable: false,
                            render: function (data, type) {
                                return type === 'export' ? '\u200C' + data : data;
                            }
                        },
                        { data: "datahora_agendamento", className: "text-center", title: "@RsCadastros.DATA_HORA_AGENDAMENTO", orderable: false },
                        { data: "data_baixa", className: "text-center", title: "@RsCadastros.DATA_ENCERRAMENTO", orderable: false },
                        { data: "tipo_servico", className: "text-center", title: "@RsCadastros.TIPO_SERVICO", orderable: false },
                        { data: "equipe", className: "text-center", title: "@RsCadastros.EQUIPE", orderable: false},
                        { data: "supervisor", className: "text-center", title: "@RsCadastros.SUPERVISOR", orederable: false},
                        { data: "cpf_cliente", className: "text-center", title: "@RsCadastros.CPFCNPJ_CLIENTE", orderable: false },
                        { data: "nome_cliente", className: "text-center", title: "@RsCadastros.CLIENTE", orderable: false },
                        { data: "plano_produto", className: "text-center", title: "@RsCadastros.PLANO_PRODUTO", orderable: false },
                        { data: "uf", className: "text-center", title: "@RsCadastros.UF", orderable: false },
                        { data: "cidade", className: "text-center", title: "@RsCadastros.CIDADE", orderable: false },
                        { data: "bairro", className: "text-center", title: "@RsCadastros.BAIRRO", orderable: false }

                    ]
                });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });

            $('#datatable tbody').on('click', 'tr.dtrg-level-0', function () {

                var rowsCollapse = $(this).nextUntil('.dtrg-level-0');

                if (!$(this).hasClass("collapsed") && !$(this).hasClass("not-collapsed")) {
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                else if ($(this).hasClass("collapsed")) {
                    $(this).removeClass("collapsed");
                    $(this).addClass("not-collapsed");
                    rowsCollapse.removeClass("d-none");
                }

                else if ($(this).hasClass("not-collapsed")) {
                    $(this).removeClass("not-collapsed");
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                oDatatable.columns.adjust();
            });
                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control
                    rows_selected = [];
                });
            },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days')) > 30) {
                    Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 30 dias", "warning");
                    return false
                }
            }

            if (oDatatable == null) {
                TableManageButtons.init();
            }
            else {
                oDatatable.draw()
            }

            $('#modal-filter').modal('hide')


        }

    </script>
}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-tags"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">


                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>
                </div>

            </div>
        </div>

    </div>
    <div id="divSubTitle">
        <div id="FiltrosUtilizados" class="mr-2 ml-2 form-inline"></div>
        <div id="lbAgrupadoPor" class="fs-12 mr-2 ml-2 form-inline"></div>
        <div class="mr-2 ml-2 form-inline mt-1 fs-12">@(String.Format(RsFinanceiro.EMITIDO_POR_EM_AS, User.Identity.GetUserName(), DateTime.Now.ToString("dd/MM/yyyy"), DateTime.Now.ToString("HH:mm")))</div>
    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="form-group border_radius">
                    <div class="" style="display: grid;place-items:center">
                        <div class="">
                            <input type="radio" value="agendamento" id="iDataAgendamento" name="tipodata" checked /> <label for="iDataAgendamento">@RsCadastros.DATA_AGENDAMENTO</label>
                            <input type="radio" value="baixa" class="ml-2" id="iDataBaixa" name="tipodata" /> <label for="iDataBaixa">@RsCadastros.DATA_ENCERRAMENTO</label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col form-inline text-center mt-1" style="display:block">
                            <input class="form-control obrigatorio datepicker-period mb-1"
                                   id="iDataInicio"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />

                            <span class="pl-3 pr-3">@RsBase.A</span>

                            <input class="form-control obrigatorio datepicker-period  mb-1"
                                   id="iDataFim"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iEquipe">@RsCadastros.TECNICO:</label>
                            <select class="form-control" id="iEquipe"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.SUPERVISOR:</label>
                            <select class="form-control" id="iSupervisor"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iEncerramento">@RsCadastros.TAG_ENCERRAMENTO:</label>
                            <input type="hidden" id="iEncerramentoCodCt">
                            <select class="form-control" id="iEncerramento"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iPlanoProduto">@RsCadastros.PLANO_PRODUTO:</label>
                            <select class="form-control" id="iPlanoProduto"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iTipoServico">@RsCadastros.TIPO_SERVICO:</label>
                            <select class="form-control" id="iTipoServico"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iCliente">@RsCadastros.CLIENTE:</label>
                            <select class="form-control" id="iCliente"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iCategoriaCliente">@RsCadastros.CATEGORIA_CLIENTE:</label>
                            <select class="form-control" id="iCategoriaCliente"></select>
                        </div>
                    </div>
                </div>


                <div class="row">

                    <div class="col">
                        <div class="form-group">
                            <label>UF:</label>
                            <select class="form-control filtro" id="iEstadosBrasil">
                                <option value="" selected>@RsBase.TODOS</option>
                                <option value="AC">Acre</option>
                                <option value="AL">Alagoas</option>
                                <option value="AP">Amapá</option>
                                <option value="AM">Amazonas</option>
                                <option value="BA">Bahia</option>
                                <option value="CE">Ceará</option>
                                <option value="DF">Distrito Federal</option>
                                <option value="ES">Espírito Santo</option>
                                <option value="GO">Goiás</option>
                                <option value="MA">Maranhão</option>
                                <option value="MT">Mato Grosso</option>
                                <option value="MS">Mato Grosso do Sul</option>
                                <option value="MG">Minas Gerais</option>
                                <option value="PA">Pará</option>
                                <option value="PB">Paraíba</option>
                                <option value="PR">Paraná</option>
                                <option value="PE">Pernambuco</option>
                                <option value="PI">Piauí</option>
                                <option value="RJ">Rio de Janeiro</option>
                                <option value="RN">Rio Grande do Norte</option>
                                <option value="RS">Rio Grande do Sul</option>
                                <option value="RO">Rondônia</option>
                                <option value="RR">Roraima</option>
                                <option value="SC">Santa Catarina</option>
                                <option value="SP">São Paulo</option>
                                <option value="SE">Sergipe</option>
                                <option value="TO">Tocantins</option>
                            </select>
                        </div>

                    </div>

                    <div class="col">
                        <div class="form-group">
                            <label for="iCidade">Cidade:</label>
                            @Html.DropDownList("Cidade", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iCidade", @autocomplete = "off" })
                        </div>

                    </div>
                </div>


                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatableFunction(); $('#modal-filter').modal('hide');" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->
