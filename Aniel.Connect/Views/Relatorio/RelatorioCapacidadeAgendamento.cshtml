@{
    ViewBag.Title = RsCadastros.RELATORIO_CAPACIDADE_AGENDAMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.Render("~/Content/cssDataTable")
    <style>
        table.dataTable thead th {
            background-color: #357ca5 !important;
            font-weight: normal !important;
            color: white
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 5px 10px 0px 5px !important;
        }

        table.dataTable thead th, table.dataTable tbody td {
            padding: 4px 5px;
        }
    </style>
}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")
    <link href="~/bin/Content/preloaderbar.css" media="none" onload="if(media!='all')media='all'" rel="stylesheet" />
    <script>
        var oDatatable = null;
        $.fn.dataTable.ext.errMode = 'none';

        $('#iGrupoArea').change(function () {
            if ($('#iGrupoArea').val()) {
                $("#iArea").prop("disabled", false);
                AddSelect("iArea", "@CONSTANTES.URLPortal/api/Areaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, $('#iGrupoArea').val(), null, "@RsBase.SELECIONE", false);
            }
            else {
                $('#iArea').val(null).trigger('change');
                $('#iLocalidade').val(null).trigger('change');
                $('#iArea').prop("disabled", true);
                $('#iLocalidade').prop("disabled", true);
            }
        });

        $('#iArea').change(function () {
            if ($('#iArea').val()) {
                $("#iLocalidade").prop("disabled", false);
                AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, $('#iArea').val(), $('#iGrupoArea').val(), "@RsBase.SELECIONE", false);
            } else {
                $('#iLocalidade').val(null).trigger('change');
                $('#iLocalidade').prop("disabled", true);
            }
        });

        var handleGrupo = function () {
            $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {
                GrupoSelecionado = e.params.data

                if (GrupoSelecionado) {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false, handleArea);
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
                else {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, handleArea);
                }
            });
        };

        var handleArea = function () {
            $('#iArea').on('select2:select select2:unselecting', function (e) {
                AreaSelecionada = e.params.data

                if (AreaSelecionada) {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id) , null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
            });
        };

        let naturezaId = null;
        let contratoId = null;

        function CarregarTipoServico() {
            if (contratoId != null && naturezaId != null) {
                AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, contratoId, null, "@RsBase.SELECIONE", false, null, null, String(naturezaId));
            } else if (contratoId != null) {
                AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, contratoId, null, "@RsBase.SELECIONE", false);
            } else {
                AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            }
        }

        $("#iNatureza").on('select2:select select2:unselecting', function (e) {
            naturezaId = e.params.data ? e.params.data.id : null;
            CarregarTipoServico();
        })

        function HandleContrato () {
            $('#iContrato').unbind('select2:select select2:unselecting');
            $('#iContrato').on('select2:select select2:unselecting', function (e) {
                contratoId = e.params.data ? e.params.data.id : null;
                CarregarTipoServico();

            });
        };

        function carregaSelect2() {
            AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, handleGrupo);
            AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, handleArea);
            AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iTecnico", "@CONSTANTES.URLPortal/api/EquipeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iNatureza", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iPeriodo", "@CONSTANTES.URLPortal/api/PeriodoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iContrato", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleContrato);
        }

        $("#iLimparFiltro").click(function () {
            $('#iGrupoArea').val(null).trigger('change')
            $('#iArea').val(null).trigger('change')
            $('#iLocalidade').val(null).trigger('change')
            $('#iSupervisor').val(null).trigger('change')
            $('#iNatureza').val(null).trigger('change')
            $('#iPeriodo').val(null).trigger('change')

            carregaSelect2()

            if (oDatatable != null) {
                oDatatable.draw()
            }
        })

        $("#iLimparFiltroModal").click(function () {
            $("#iDataInicio").val("")
            $("#iDataFim").val("")

            $('#iGrupoArea').val(null).trigger('change')
            $('#iArea').val(null).trigger('change')
            $('#iLocalidade').val(null).trigger('change')
            $('#iSupervisor').val(null).trigger('change')
            $('#iTecnico').val(null).trigger('change')
            $('#iNatureza').val(null).trigger('change')
            $('#iPeriodo').val(null).trigger('change')

            carregaSelect2()
        })

        $(document).ready(async () => {
            $('#modal-filter').modal('show')
            carregaSelect2()
        })

        var filter_state = {
            periodo: {
                removable: false,
                onclick: () => null,
                label: "@RsFinanceiro.PERIODO", getDisplay: () => {
                    return Boolean($('#iDataInicio').val()) ? $('#iDataInicio').val() + " a " + $('#iDataFim').val() : ""
                }
            },
            grupoArea: {
                label: "@RsCadastros.GRUPO_AREA",
                getDisplay: () => { return Boolean($('#iGrupoArea').val()) ? $('#iGrupoArea option:selected').text() : "" },
                onclick: () => {
                    $('#iGrupoArea').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            area: {
                label: "@RsCadastros.AREA",
                getDisplay: () => { return Boolean($('#iArea').val()) ? $('#iArea option:selected').text() : "" },
                onclick: () => {
                    $('#iArea').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            localidade: {
                label: "@RsCadastros.LOCALIDADE",
                getDisplay: () => { return Boolean($('#iLocalidade').val()) ? $('#iLocalidade option:selected').text() : "" },
                onclick: () => {
                    $('#iLocalidade').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            tecnico: {
                label: "@RsCadastros.TECNICO",
                getDisplay: () => { return Boolean($('#iTecnico').val()) ? $('#iTecnico option:selected').text() : "" },
                onclick: () => {
                    $('#iTecnico').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            periodo: {
                label: "@RsCadastros.PERIODO",
                getDisplay: () => {

                    return Boolean($('#iDataInicio').val()) ? ($('#iDataInicio').val() + " a " + $('#iDataFim').val()) : ""

                },
                onclick: () => { $('#modal-filter').modal('show') }
            },
            natureza: {
                label: "@RsCadastros.NATUREZA",
                getDisplay: () => { return Boolean($('#iNatureza').val()) ? $('#iNatureza option:selected').text() : "" },
                onclick: () => {
                    $('#iNatureza').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
        }

        var datatable_columns = [
            { data: "data", className: "text-center", title: "@RsCadastros.DATA", orderable: false, visible: true },
            { data: "turno", className: "text-center", title: "@RsCadastros.PERIODO", orderable: false, visible: true },
            { data: "tecnicosEscalados", className: "text-center", title: "@RsCadastros.TECNICOS_ESCALADOS", orderable: false, visible: true },
            { data: "grupoArea", className: "text-center", title: "@RsCadastros.GRUPO_AREA", orderable: false, visible: true },
            { data: "area", className: "text-center", title: "@RsCadastros.AREA", orderable: false, visible: true },
            { data: "capacidadePlena", className: "text-center", title: "Capacidade Plena", orderable: false, visible: true },
            { data: "tempoExecucao", className: "text-center", title: "Tempo de Deslocamento + Execução", orderable: false, visible: true },
            { data: "capacidadeUtil", className: "text-center", title: "Capacidade Útil", orderable: false, visible: true },
            { data: "limiteMultiskill", className: "text-center", title: "% de Limite Multiskill", orderable: false, visible: true },
            { data: "capacidadeComLimite", className: "text-center", title: "Capacidade com Limite", orderable: false, visible: true },
            { data: "servicosAgendadosNatureza", className: "text-center", title: "Serviços Agendados da Natureza", orderable: false, visible: true },
            { data: "outrosServicosAgendados", className: "text-center", title: "Outros Serviços Agendados", orderable: false, visible: true },
            //{ data: "horasAgendadas", className: "text-center", title: "Horas Agendadas", orderable: false, visible: true },
            //{ data: "horasDeslocamento", className: "text-center", title: "Horas Deslocamento", orderable: false, visible: true },
            { data: "capacidadeDisponivel", className: "text-center", title: "Capacidade Disponível", orderable: false, visible: true },
            { data: "percAproveitamentoCapacidade", className: "text-center", title: "@RsCadastros.PERC_APROVEITAMENTO_CAPACIDADE", orderable: false, visible: true },
            { data: "capacidadeDisponivelComLimite", className: "text-center", title: "Capacidade Dísponivel com Limite", orderable: false, visible: true },
            { data: "percAproveitamentoCapacidadeUtil", className: "text-center", title: "@RsCadastros.PERC_APROVEITAMENTO_CAPACIDADE Limite", orderable: false, visible: true },
        ];

        "use strict";

        var handleDataTableButtons = function () {

            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                //select: { style: 'multi' },
                serverSide: true,
                searching: true,
                ordering: false,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                drawCallback: () => {
                    TagFilter("FiltrosUtilizados", filter_state)

                    if ($('input[name=AgruparPorPeriodo]:checked').val() == "S") {
                        $("#datatable").DataTable().column(1).visible(true)
                    }
                    else
                    {
                        $("#datatable").DataTable().column(1).visible(false);
                    }


                    //if ($('input[name=FormatoVisu]:checked').val() == "horas") {
                    //    $("#datatable").DataTable().column(3).visible(true)
                    //    $("#datatable").DataTable().column(4).visible(false)
                    //}
                    //else {
                    //    $("#datatable").DataTable().column(3).visible(false)
                    //    $("#datatable").DataTable().column(4).visible(true)
                    //}

                },
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/RelatorioCapacidadeAgendamentoApi/GetAll',
                    type: 'POST',
                    beforeSend: function () {
                        $("#divProgress").show();
                    },
                    complete: function () {
                        $("#divProgress").hide();
                    },
                    data: function (data) {
                        data.DataInicio = $("#iDataInicio").val();
                        data.DataFim = $("#iDataFim").val();

                        data.Equipe = $('#iEquipe').val();
                        data.CodEscritorio = $("#iGrupoArea").val();
                        data.CodArea = $("#iArea").val();
                        data.CodLocalidade = $("#iLocalidade option:selected").val();
                        data.CodNatureza = $("#iNatureza").val();
                        data.IdPeriodo = $("#iPeriodo").val();
                        data.CodSuperv = $("#iSupervisor").val();
                        data.Equipe = $("#iTecnico").val();
                        data.FormatoVisualizacao = $('input[name=FormatoVisu]:checked').val();
                        data.AgruparPorPeriodo = $('input[name=AgruparPorPeriodo]:checked').val();
                        data.Localidade = $("#iLocalidade option:selected").text();
                        data.TipoServico = $('#iTipoServico option:selected').val();
                        return data;
                    },
                    dataSrc: function (retorno) {
                        if (retorno.data === null) {
                            Notificar("Alerta", retorno.error, "warning");
                            return [];
                    }

                        return retorno.data;
                },
                    error: function (error) {
                        console.error("Erro na requisição:", error);
                    }
                },
                pageLength: 5,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTableRelatorio({ pageSize: GetPageSizePDF(datatable_columns) }),
                columns: datatable_columns
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                rows_selected = [];
            });
        },
        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtons();
                }
            }
        }();

    function CarregarRelatorio() {
        let erro = false

        if ($('#iDataInicio').val() && $('#iDataFim').val()) {

            const momentInicio = moment($('#iDataInicio').val(), "DD/MM/YYYY")
            const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

            if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                Notificar("@RsBase.ATENCAO_", "Periodo deve atender limite de 30 dias", "warning");
                erro = true
            }
        }

        if (!$("#iDataInicio").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, "data início")", "warning")
            erro = true
        }

        if (!$("#iDataFim").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, "data fim")", "warning")
            erro = true
        }

        if (DateDiff($("#iDataInicio").val(), $("#iDataFim").val()) > 30 || DateDiff($("#iDataInicio").val(), $("#iDataFim").val()) < 0) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, "um período válido")", "warning")
            erro = true
        }

        if (!erro) {
            if (oDatatable == null) {
                TableManageButtons.init();
            }
            else {
                oDatatable.draw()
            }
            $('#modal-filter').modal('hide')
        }
        else {
            $('#modal-filter').modal('show')
        }
    }

        $("#iPesquisar").on("click", function () {

            clicked = true;
            erro = false;

            if (!$("#iContrato").val())
            {
                  Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CONTRATO)", "warning");
                  erro = true
            }

            if (!$("#iTipoServico").val())
            {
                  Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TIPO_SERVICO)", "warning");
                  erro = true
            }

            if (erro)
            {
                clicked = false;
                return false;
            }

            CarregarRelatorio();
        })

        $("#btnAtualizar").on("click", function () {
            CarregarRelatorio();
        })

    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="far fa-calendar-check"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">

                @*<a class="btn btn-success btn-add-2" href="#" id="btnAtualizar" title="Atualizar">
                        <i class="fas fa-sync-alt" style="color: #fff"></i>
                    </a>*@
                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>
                </div>

            </div>
        </div>

    </div>
    <!--./main-->
    <div id="FiltrosUtilizados" class="mt-2 mr-2 ml-2">
    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <!-- Visualização -->
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iGrupoArea">@RsCadastros.FORMATO_VISUALIZACAO:</label><br />
                            <input type="radio" name="FormatoVisu" value="horas" checked> horas
                            <input type="radio" name="FormatoVisu" value="servicos"> serviços
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iAgruparPorPeriodo">Agrupar por Período: </label><br />
                            <input type="radio" name="AgruparPorPeriodo" value="S"> @RsBase.SIM
                            <input type="radio" name="AgruparPorPeriodo" value="N" checked> @RsBase.NAO
                        </div>
                    </div>
                </div>

                <!-- Contrato e Tipo de Serviço-->
                <div class="row">
                    <div class="col-12">
                        <label class="font-weight-bold small">
                            Tempo de execução para referência de cálculo:
                        </label>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <span class="text-danger">* </span><label for="iContrato">@RsCadastros.CONTRATO:</label>
                            <select class="form-control obrigatorio" id="iContrato"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <span class="text-danger">* </span><label for="iTipoServico">@RsCadastros.TIPO_SERVICO:</label>
                            <select class="form-control obrigatorio" id="iTipoServico"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <label class="font-weight-bold small">
                            Filtros:
                        </label>
                    </div>
                </div>

                <!-- Datas (Início e Fim) -->
                <div class="row">
                    <div class="col-12">
                        <div class="form-group d-flex align-items-center">
                            <span class="text-danger">* </span>
                            <label for="iDataInicio" class="mb-0 mr-2">@RsCadastros.PERIODO:</label>

                            <input class="form-control obrigatorio datepicker-period mb-1"
                                   id="iDataInicio"
                                   type="text"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />

                            <span class="px-2">@RsBase.A</span>

                            <input class="form-control obrigatorio datepicker-period mb-1"
                                   id="iDataFim"
                                   type="text"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iGrupoArea">@RsCadastros.GRUPO_AREA:</label>
                            <select class="form-control" id="iGrupoArea"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iArea">@RsCadastros.AREA:</label>
                            <select class="form-control" id="iArea"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iLocalidade">@RsCadastros.LOCALIDADE:</label>
                            <select class="form-control" id="iLocalidade"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iSupervisor">@RsCadastros.SUPERVISOR:</label>
                            <select class="form-control" id="iSupervisor"></select>
                        </div>
                    </div>
