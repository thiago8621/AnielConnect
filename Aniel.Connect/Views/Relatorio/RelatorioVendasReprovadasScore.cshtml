@using Microsoft.AspNet.Identity
@using Resources
@using Aniel.Connect.Model.enumerado
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.RELATORIO_VENDAS_SCORE_CREDITO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;

    List<Aniel.Connect.Core.ObjComboResult<String>> listaStatusVenda = new List<Aniel.Connect.Core.ObjComboResult<String>>();
    List<Aniel.Connect.Core.ObjComboResult<String>> listaEtapasVenda = new List<Aniel.Connect.Core.ObjComboResult<String>>();

    foreach (var valor in Enum.GetValues(typeof(Status_Venda)))
    {
        listaStatusVenda.Add(new Aniel.Connect.Core.ObjComboResult<string>
        {
            Id = Convert.ToInt32(valor).ToString(),
            Text = HtmlEnumExtensions.GetEnumDescription(valor)
        });
    }

    foreach (var valor in Enum.GetValues(typeof(EnumEtapaVenda)))
    {
        listaEtapasVenda.Add(new Aniel.Connect.Core.ObjComboResult<string>
        {
            Id = Convert.ToInt32(valor).ToString(),
            Text = HtmlEnumExtensions.GetEnumDescription(valor)
        });
    }

    var listaJson_StatusVenda = Newtonsoft.Json.JsonConvert.SerializeObject(listaStatusVenda.OrderBy(x => x.Text));
    var listaJson_EtapasVenda = Newtonsoft.Json.JsonConvert.SerializeObject(listaEtapasVenda.OrderBy(x => x.Text));
}

@section styles{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }

        .swal-wide {
            width: 650px !important;
        }

        #iSelectStatusVenda + .select2-container--default .select2-selection--single .select2-selection__placeholder {
            color: #495057 !important;
            font-size: 0.9rem !important;
            font-weight: 400 !important;
            line-height: 1.2 !important;
        }

        #iSelectStatusVenda + .select2-container--default .select2-selection--single {
            height: 23px !important;
            border: 1px solid #ced4da !important;
        }

            #iSelectStatusVenda + .select2-container--default .select2-selection--single .select2-selection__rendered {
                color: #495057 !important;
                padding-left: 10px !important;
                line-height: 22px !important;
            }
    </style>

}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")
    <script type="text/javascript">
        var oDatatable = null, filtro_vendedor = null, filtro_supervisor = null;
        $(document).ready(async () => {
            $('#modal-filter').modal('show');
            await carregaSelect2();

            const tipoInicial = $('input[name="iTipoStatus"]:checked').val();
            if (tipoInicial) {
                carregarStatus(tipoInicial);
            }
        });

        async function carregaSelect2() {
            await AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboFuncionarioSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleSupervisor);
            await AddSelect("iVendedor", "@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboVendedor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleVendedor, null, null, null, false);
            await AddSelect("iDepartamento", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            await AddSelect("iMotivoDesistencia", "@CONSTANTES.URLPortal/api/Motivo_Desistencia_VendaApi/GetComboMotivos", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            await AddSelect("iCampanha", "@CONSTANTES.URLPortal/api/campanhaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, null, null, null, null, false);

            var dadosEnum = @Html.Raw(listaJson_EtapasVenda);
            var dadosFormatados = $.map(dadosEnum, function (obj) {
                return {
                    id: obj.Id || obj.id,
                    text: obj.Text || obj.text
                };
            });
            $('#iEtapaVenda').select2({
                data: dadosFormatados,
                placeholder: "@RsBase.SELECIONE",
                allowClear: false,
                width: '100%',
                dropdownParent: $('#modal-filter')
            }).trigger('change');
        }

        let HandleSupervisor = function () {
            $('#iSupervisor').unbind('select2:select select2:unselecting');
            $('#iSupervisor').on('select2:select select2:unselecting', function (e) {
                var supervisor_param = e.params.data;
                if (supervisor_param) {
                    filtro_supervisor = supervisor_param.id;
                }
                else {
                    filtro_supervisor = null;
                }
            });
        };

        let HandleVendedor = function () {
            $('#iVendedor').unbind('select2:select select2:unselecting');
            $('#iVendedor').on('select2:select select2:unselecting', function (e) {
                var vendedor_param = e.params.data;
                if (vendedor_param) {
                    filtro_vendedor = vendedor_param.id;
                }
                else {
                    filtro_vendedor = null;
                }
            });
        };

        var filter_state = {
            periodo: {
                label: "@RsFinanceiro.PERIODO", getDisplay: () => {

                    var tipo_data = "";
                    switch ($('input[name="iTipoData"]:checked').val()) {

                        case 1: { tipo_data = "(Data de Criação) "; break; }
                        case 2: { tipo_data = "(Data de Encerramento) "; break; }
                    }

                    return Boolean($('#iDataInicio').val()) ? tipo_data + ($('#iDataInicio').val() + " a " + $('#iDataFim').val()) : ""
                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            status_venda: {
                label: "@RsCadastros.STATUS_VENDA", getDisplay: () => {
                    return Boolean($('#iSelectStatusVenda').val()) ? $('#iSelectStatusVenda').select2('data')[0].text : ""
                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            supervisor: {
                label: "@RsCadastros.SUPERVISOR",
                getDisplay: () => { return Boolean($('#iSupervisor').val()) ? $('#iSupervisor option:selected').text() : "" },
                onclick: () => {
                    $('#iSupervisor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            vendedor: {
                label: "@RsCadastros.VENDEDOR",
                getDisplay: () => { return Boolean($('#iVendedor').val()) ? $('#iVendedor option:selected').text() : "" },
                onclick: () => {
                    $('#iVendedor').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            etapa_venda: {
                label: "@RsCadastros.ETAPA_VENDA",
                getDisplay: () => { return Boolean($('#iEtapaVenda').val()) ? $('#iEtapaVenda option:selected').text() : "" },
                onclick: () => {
                    $('#iEtapaVenda').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            score_credito: {
                label: "Score de Crédito", getDisplay: () => {
                    var tipo_data = "";
                    switch ($('#iScoreCredito').val()) {

                        case "todos": {
                            tipo_data = "Todos";
                            break;
                        }
                        case "maior": {
                            tipo_data = "Maior que " + $("#iValor").val();
                            break;
                        }
                        case "menor": {
                            tipo_data = "Menor que " + $("#iValor").val();
                            break;
                        }
                        case "maior_igual": {
                            tipo_data = "Maior e/ou Igual " + $("#iValor").val();
                            break;
                        }
                        case "menor_igual": {
                            tipo_data = "Menor e/ou Igual " + $("#iValor").val();
                            break;
                        }
                        case "igual": {
                            tipo_data = "Igual " + $("#iValor").val();
                            break;
                        }
                        case "entre": {
                            tipo_data = "Entre " + $("#iValorInicial").val() + ' à ' + $("#iValorFinal").val();
                            break;
                        }
                    }

                    return Boolean($('#iScoreCredito').val()) ? tipo_data : ""
                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            departamento: {
                label: "Departamento",
                getDisplay: () => { return Boolean($('#iDepartamento').val()) ? $('#iDepartamento option:selected').text() : "" },
                onclick: () => {
                    $('#iDepartamento').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            campanha: {
                label: "Campanha",
                getDisplay: () => { return Boolean($('#iCampanha').val()) ? $('#iCampanha option:selected').text() : "" },
                onclick: () => {
                    $('#iCampanha').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
        }

        $("#iLimparFiltro, #iLimparFiltroModal").click(async () => {
            $('#modal-filter select').each(function () {
                if ($(this).data('select2')) {
                    $(this).val(null).trigger('change.select2');
                } else {
                    $(this).prop('selectedIndex', 0);
                }
            });

            $('input[name="iTipoData"][value="1"]').prop('checked', true);
            $('input[name="iTipoStatus"][value="1"]').prop('checked', true);

            $('#iDataInicio, #iDataFim').val('').datepicker('update');

            $('#iDataInicio').val('@DateTime.Now.AddDays(-30).ToString("dd/MM/yyyy")');
            $('#iDataFim').val('@DateTime.Now.ToString("dd/MM/yyyy")');

            $('#iDataInicio, #iDataFim').datepicker('update');
            $("#iValor, #iValorInicial, #iValorFinal").val(null);
            $("#iScoreCredito").val("todos").trigger('change');

            await carregaSelect2();
            carregarStatus(1);

            filtro_vendedor = null;
            filtro_supervisor = null;
            if (oDatatable != null) {
                oDatatable.draw()
            }
        });

        "use strict";

        var handleDataTableButtons = function () {

            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                select: {
                    style: 'multi'
                },
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '79vh',
                scrollX: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                pageLength: 10,
                order: [[0, 'asc']],
                language: traducaoDataTable,
                buttons: buttonsDataTableRelatorioPaginado({ title: "@Html.Raw(ViewBag.Title)" }),
                ajax: {
                    url: baseUrl + '/api/relatorioapi/RelatorioVendasReprovadasScore',
                    type: 'POST',
                    data: function (data) {
                        data.DataHoraIni = $('#iDataInicio').val();
                        data.DataHoraFim = $("#iDataFim").val();
                        data.TipoData = $('input[name="iTipoData"]:checked').val();
                        data.Supervisor = filtro_supervisor;
                        data.Vendedor = filtro_vendedor;
                        data.EtapaVenda = $("#iEtapaVenda").val();
                        data.TipoStatusVenda = $('input[name="iTipoStatus"]:checked').val();

                        var paramTextStatusVenda = $("#iSelectStatusVenda").text();
                        if (!$("#iSelectStatusVenda").val())
                            paramTextStatusVenda = "";

                        data.StatusVenda = $('input[name="iTipoStatus"]:checked').val() == 1 ? $("#iSelectStatusVenda").val() : paramTextStatusVenda;
                        data.Departamento = $("#iDepartamento").val();
                        data.Campanha = $("#iCampanha").val();

                        data.Motivo_JustificativaVenda = $("#iMotivoDesistencia").val();
                        data.TipoScoreCredito = $("#iScoreCredito").val();
                        data.Valor_Unico = $("#iValor").val();
                        data.Valor_Inicial = $("#iValorInicial").val();
                        data.Valor_Final = $("#iValorFinal").val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        if ($('#Count_listing').length === 0)
                            $('.dataTables_length').append($('<label id="Count_listing"></label>'));

                        $("#Count_listing").html(`<div class="form-group col-sm-push-1 ml-2 mt-1">
                           Total de Registros encontrados: <span style="font-weight:bold; margin-right:0px;" id="Total_OS">  &nbsp; `+ d.recordsFiltered + ` </span>
                        </div> `);

                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                preDrawCallback: function () {
                    $("#divProgress").show();
                },
                drawCallback: function () {
                    TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                    ResizeTable('divTable');

                    var agora = new Date();
                    var dataFormatada = agora.toLocaleDateString('pt-BR');
                    var horaFormatada = agora.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
                    var usuario = "@User.Identity.GetUserName()";
                    var texto = "Emitido por " + usuario + " em " + dataFormatada + " às " + horaFormatada;

                    $("#iEmitidoPor").text(texto);
                    $("#divProgress").hide();
                },
                columns: [
                    { data: "id", className: "text-center", title: "Nº Venda", orderable: true },
                    { data: "descCliente", className: "text-center", title: "@RsCadastros.CLIENTE", orderable: true },
                    { data: "descVendedor", className: "text-center", title: "@RsCadastros.VENDEDOR", orderable: true },
                    { data: "descSupervisor", className: "text-center", title: "@RsCadastros.SUPERVISOR", orderable: true },
                    { data: "dthCriacao", className: "text-center", title: "@RsCadastros.DATA_CRIACAO", orderable: true },
                    { data: "dthVenda", className: "text-center", title: "@RsCadastros.DATA_VENDA", orderable: true },
                    { data: "score", className: "text-center", title: "@RsCadastros.SCORE Crédito", orderable: true },
                    { data: "status", className: "text-center", title: "@RsCadastros.STATUS da Venda", orderable: true },
                    { data: "etapaVenda", className: "text-center", title: "@RsCadastros.ETAPA_VENDA", orderable: true },
                    { data: "statusConsultaCredito", className: "text-center", title: "Status de Consulta de Crédito", orderable: true },
                    { data: "descCampanha", className: "text-center", title: "Campanha", orderable: true },
                    { data: "motivoJustificativaVenda", className: "text-center", title: "Motivo/Justificativa da Venda", orderable: false },
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });

            $('#datatable tbody').on('click', 'tr.dtrg-level-0', function () {

                var rowsCollapse = $(this).nextUntil('.dtrg-level-0');

                if (!$(this).hasClass("collapsed") && !$(this).hasClass("not-collapsed")) {
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                else if ($(this).hasClass("collapsed")) {
                    $(this).removeClass("collapsed");
                    $(this).addClass("not-collapsed");
                    rowsCollapse.removeClass("d-none");
                }

                else if ($(this).hasClass("not-collapsed")) {
                    $(this).removeClass("not-collapsed");
                    $(this).addClass("collapsed");
                    rowsCollapse.addClass("d-none");
                }

                oDatatable.columns.adjust();
            });
            oDatatable.on('draw', function () {
                rows_selected = [];
            });
        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(), "DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days')) > 90) {
                    Notificar("@RsBase.ATENCAO_", "Atenção! Por favor filtrar um período válido (menor que 90 dias)", "warning");
                    return false
                }

                if (momentInicio.isAfter(momentFinal)) {
                    Notificar("@RsBase.ATENCAO_", "Atenção! Por favor, filtrar um período válido", "warning");
                    return false;
                }
            }

            if ($('#iValorInicial').val() > $("#iValorFinal").val()) {
                Notificar("@RsBase.ATENCAO_", `Atenção! Por favor, VALOR INICIAL (${$('#iValorInicial').val()}) é MAIOR que VALOR FINAL (${$('#iValorFinal').val()})`, "warning");
                return false;
            }

            if (oDatatable == null) {
                TableManageButtons.init();
            }
            else {
                oDatatable.draw()
            }

            $('#modal-filter').modal('hide')
        }

        function validarNumero(input) {
            input.value = input.value.replace(/[^0-9.]/g, '');
            if (parseFloat(input.value) <= 0) {
                input.value = 0;
            }
        }

        $('input[name="iTipoStatus"]').off('change').on('change', function () {
            const tipoSelecionado = $(this).val();

            carregarStatus(tipoSelecionado);
        });

        async function carregarStatus(tipoSelecionado) {
            if ($('#iSelectStatusVenda').data('select2')) {
                $('#iSelectStatusVenda').select2('destroy');
            }
            $('#iSelectStatusVenda').empty().append('<option value="">@RsBase.TODOS</option>');

            if (tipoSelecionado == 1) {
                var dadosEnum = @Html.Raw(listaJson_StatusVenda);
                var dadosFormatados = $.map(dadosEnum, function (obj) {
                    return {
                        id: obj.Id || obj.id,
                        text: obj.Text || obj.text
                    };
                });
                $('#iSelectStatusVenda').select2({
                    data: dadosFormatados,
                    placeholder: "@RsBase.TODOS",
                    allowClear: true,
                    width: '100%',
                    dropdownParent: $('#modal-filter')
                }).trigger('change');
            } else {
                await AddSelect("iSelectStatusVenda", "@CONSTANTES.URLPortal/api/Atividade_StatusVendaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            }
        }

        $('#iScoreCredito').off('change').on('change', function () {
            const selecao = $(this).val();

            $('.div-valor-unico, .div-valor-entre').addClass('d-none');
            $('#iValor, #iValorInicial, #iValorFinal').val('');

            $('#iValor, #iValorInicial, #iValorFinal').removeClass("obrigatorio");
            if (selecao === 'todos') {
                $('.div-valor-unico, .div-valor-entre').addClass('d-none');
                $('#iValor, #iValorInicial, #iValorFinal').val('');
            }
            else if (selecao === 'entre') {
                $('.div-valor-entre').removeClass('d-none');
                $('#iValorInicial, #iValorFinal').addClass("obrigatorio");
            }
            else {
                $('.div-valor-unico').removeClass('d-none');
                $('#iValor').addClass("obrigatorio");
            }
        });


    </script>
}

<div class="container-fluid" id="divTitle">
    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page"><i class="fa fa-star" aria-hidden="true"></i>@ViewBag.Title</h4>
            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>
        </div>

        <div class="col-auto">
            <div class="row title-page">
                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>
                </div>
            </div>
        </div>
    </div>
    <div id="divSubTitle">
        <div id="FiltrosUtilizados" class="mr-2 ml-2 form-inline"></div>
        <div id="lbAgrupadoPor" class="fs-12 mr-2 ml-2 form-inline"></div>
        <div class="mr-2 ml-2 form-inline mt-1 fs-12"><span id="iEmitidoPor"></span></div>
    </div>
</div>

<div id="divTable" style="width: 97.5vw; margin: auto">
    <table class="table table-hover nowrap display" id="datatable" style="width:100%">
    </table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter" data-backdrop="static" data-keyboard="false" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group border rounded p-3 mb-4" style="border: 1px solid #ebedef !important;">
                    <div class="d-flex justify-content-center mb-3">
                        <div class="custom-control custom-radio mx-3">
                            <input type="radio" id="iDthCriacao" name="iTipoData" class="custom-control-input" value="1" checked />
                            <label class="custom-control-label" for="iDthCriacao">Data de Criação</label>
                        </div>
                        <div class="custom-control custom-radio mx-3">
                            <input type="radio" id="iDthCancelamento" name="iTipoData" class="custom-control-input" value="2" />
                            <label class="custom-control-label" for="iDthCancelamento">Data de Encerramento</label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 d-flex justify-content-center align-items-center">
                            <input class="form-control datepicker text-center obrigatorio" id="iDataInicio" type="text" value="@DateTime.Now.Date.AddDays(-30)" style="width: 150px;" />
                            <span class="mx-3">a</span>
                            <input class="form-control datepicker-period text-center obrigatorio" id="iDataFim" type="text" value="@DateTime.Now.Date" style="width: 150px;" />
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center mb-2">
                    <div class="custom-control custom-radio mx-3">
                        <input type="radio" id="iStatusVendaPadrao" name="iTipoStatus" class="custom-control-input" value="1" checked />
