@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = RsCadastros.RELATORIO_REAGENDAMENTO_OS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        @*Reduzindo um pouco a largura da página para não gerar uma segunda barra de rolagem para a página inteira*@ html {
            /*width: 98vw;*/
            margin: auto;
        }

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }

        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }

        td.dt-center {
            text-align: center;
        }

        body {
            overflow-x: hidden;
        }

        #divFilter {
            display: block;
            width: 100%;
            height: 32.4px;
        }
    </style>

}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")
    <script>
        var oDatatable = null;

        var HandleContrato = function () {

            $('#iContrato').unbind('select2:select select2:unselecting');
            $('#iContrato').on('select2:select select2:unselecting', function (e) {

                Contrato = e.params.data
                if (Contrato) {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null,Contrato.id, null, "@RsBase.SELECIONE", false);
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null,Contrato.id, null, "@RsBase.SELECIONE", false);

                }
                else {
                    AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
            });

        };

        var HandleNatureza = function () {

            $('#iNaturezaServico').unbind('select2:select select2:unselecting');
            $('#iNaturezaServico').on('select2:select select2:unselecting', function (e) {

                Natureza = e.params.data
                if (Natureza) {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboTipoServicoNatureza", @CONSTANTES.PaginacaoRegistros, null, Natureza.id, null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboTipoServicoNatureza", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
                }
            });

        };


        var HandleGrupo = function () {
            $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

                GrupoSelecionado = e.params?.data
                if (GrupoSelecionado) {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false, HandleArea);
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
                else {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };

        var HandleArea = function () {
            $('#iArea').on('select2:select select2:unselecting', function (e) {

                AreaSelecionada = e.params?.data
                if (AreaSelecionada) {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id), null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };

        function carregaSelect2() {

            AddSelect("iContrato", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleContrato);
            AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iEquipe", "@CONSTANTES.URLPortal/api/EquipeApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iPlanoProduto", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iNaturezaServico", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleNatureza);
            AddSelect("iTipoServico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetComboTipoServicoNatureza", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupo);
            AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
            AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE");
        }

        var filter_state = {
            reabertura: {
                label: "Qtde Reabertura",
                getDisplay: () => {
                    var selectedValue = $('#iQtdReabertura').val();

                    if (selectedValue === "entre") {
                        var primeiroValor = $('#primeiroValorEntreReabertura').val();
                        var segundoValor = $('#segundoValorEntreReabertura').val();
                        return selectedValue + " " + primeiroValor + ' e ' + segundoValor;
                    } else if (selectedValue === "todas") {
                        return selectedValue;
                    } else {
                        var primeiroValor = $('#primeiroValorReabertura').val();
                        return selectedValue + " " + primeiroValor;
                    }
                },
                onclick: () => {
                },
                removable: false
            },
            reagendamento: {
                label: "Qtde Reagendamento",
                getDisplay: () => {
                    var selectedValue = $('#iQtdReagendamento').val();

                    if (selectedValue === "entre") {
                        var primeiroValor = $('#primeiroValorEntreReagendamento').val();
                        var segundoValor = $('#segundoValorEntreReagendamento').val();
                        return selectedValue + " " + primeiroValor + ' e ' + segundoValor;
                    } else if (selectedValue === "todas") {
                        return selectedValue;
                    } else {
                        var primeiroValor = $('#primeiroValorReagendamento').val();
                        return selectedValue + " " + primeiroValor;
                    }
                },
                onclick: () => {
                },
                removable: false
            },
            periodo: {
                label: "@RsFinanceiro.PERIODO", getDisplay: () => {

                    var selectedRadio = document.querySelector('input[name="tipodata"]:checked');
                    var selectedLabel = document.querySelector(`label[for="${selectedRadio.id}"]`);
                    var labelText = selectedLabel.innerText;

                    var tipo_data = labelText;
                    switch ($('input[name="tipodata"]:checked').val()) {
                        case "servico": { tipo_data = "(@RsCadastros.SERVICO) "; break; }
                    }

                    return Boolean($('#iDataInicio').val()) ? tipo_data + " - " + ($('#iDataInicio').val() + " a " + $('#iDataFim').val()) : ""
                },
                removable: false, onclick: () => { $('#modal-filter').modal('show') }
            },
            contrato: {
                label: "@RsCadastros.CONTRATO",
                getDisplay: () => { return Boolean($('#iContrato').val()) ? $('#iContrato option:selected').text() : "" },
                onclick: () => {
                },
                removable: false
            },
            projeto: {
                label: "@RsCadastros.PROJETO",
                getDisplay: () => { return Boolean($('#iProjeto').val()) ? $('#iProjeto option:selected').text() : "" },
                onclick: () => {

                },
                removable: false
            },
            equipe: {
                label: "@RsCadastros.TECNICO",
                getDisplay: () => { return Boolean($('#iEquipe').val()) ? $('#iEquipe option:selected').text() : "" },
                onclick: () => {
                    $('#iEquipe').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            area: {
                label: "@RsCadastros.AREA",
                getDisplay: () => { return Boolean($('#iArea').val()) ? $('#iArea option:selected').text() : "" },
                onclick: () => {
                }
            },
            grupoArea: {
                label: "@RsCadastros.GRUPO_AREA",
                getDisplay: () => { return Boolean($('#iGrupoArea').val()) ? $('#iGrupoArea option:selected').text() : "" },
                onclick: () => {
                }
            },
            localidade: {
                label: "@RsCadastros.LOCALIDADE",
                getDisplay: () => { return Boolean($('#iLocalidade').val()) ? $('#iLocalidade option:selected').text() : "" },
                onclick: () => {
                }
            },
            tipoServico: {
                label: "@RsCadastros.TIPO_SERVICO",
                getDisplay: () => { return Boolean($('#iTipoServico').val()) ? $('#iTipoServico option:selected').text() : "" },
                onclick: () => {
                    $('#iTipoServico').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            ordemServico: {
                label: "@RsCadastros.NUMERO_ORDEM_SERVICO",
                getDisplay: () => { return Boolean($('#iNumeroServico').val()) ? $('#iNumeroServico').text() : "" },
                onclick: () => {
                    oDatatable.draw()
                }
            },
        }

        $("#iLimparFiltro, #iLimparFiltroModal").click(() => {

            $("#iDataInicio").val(null).trigger('change');
            $("#iDataFim").val(null).trigger('change');
            $('#iEquipe').val(null).trigger('change');
            $('#iSupervisor').val(null).trigger('change');
            $('#iProducaoPrevista').prop('checked', false).trigger('change')
            $('#iServicoBaixadoMobile').prop('checked', false).trigger('change')
            $('#iServicoDocFisicoDevolvido').prop('checked', false).trigger('change')

            carregaSelect2()
            if (oDatatable != null) {
                oDatatable.draw()
            }
        })

        function carregaRelatorioReagendamentoOS()
        {
            var dataInicio = $("#iDataInicio").val();
            var dataFim = $("#iDataFim").val();

            const datatable_columns = [
                {
                    title: 'Número da OS', data: 'numOS',                                  // Número da OS
                    render: function (data, type) {
                        return type === 'export' ? '\u200C' + data : data;
                    }
                },
                { title: 'Qtd Reabertura', data: 'qtdReabertura' },                        // Quantidade de reaberturas
                { title: 'Qtd Reagendamento', data: 'qtdReagendamento' },                  // Quantidade de reagendamentos
                { title: 'Técnico', data: 'tecnicoResponsavel' },                          // Matrícula do técnico responsável
                { title: 'Data de Agendamento', data: 'dataAgendamento' },                 // Data de agendamento
                { title: 'Tipo de Serviço', data: 'tipoServico' },                         // Tipo de serviço
                { title: 'Data de Criação', data: 'dataCriacao' },                         // Data de criação da OS
                { title: 'Data de Encerramento', data: 'dataEncerramento' },               // Data de encerramento da OS
                { title: 'Descrição do Encerramento', data: 'descricaoEncerramento' },     // Descrição do encerramento
                { title: 'Usuário de Encerramento', data: 'usuarioEncerramento' },         // Usuário que encerrou a OS
                { title: 'Cliente', data: 'cliente' },                                     // Nome do cliente
                { title: 'Endereço', data: 'endereco' },                                   // Endereço do cliente
                { title: 'Complemento', data: 'complemento' },                             // Complemento do endereço
                { title: 'Bairro', data: 'bairro' },                                       // Bairro do cliente
                { title: 'Cidade', data: 'cidade' },                                       // Cidade do cliente
                { title: 'Grupo Área', data: 'grupoArea' },                                // Descrição do grupo da área
                { title: 'Status de Auditoria', data: 'statusAuditoria' }                  // Status de auditoria
            ];

            // Inicializar o DataTable com os dados recebidos
            if ($.fn.DataTable.isDataTable('#datatable')) {
                $('#datatable').DataTable().clear().destroy();
            }

            $('#datatable').DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                select: {
                    style: 'multi'
                },
                serverSide: true,
                searching: false,
                ordering: false,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '79vh',
                scrollX: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                pageLength: 10,
                order: [],
                language: traducaoDataTable,
                ajax: {
                    url: baseUrl + '/api/relatorioapi/RelatorioReagendamentoOS',
                    type: 'POST',
                    data: function (data) {

                        ShowPageLoading();

                        var selectReagendamento = $('#iQtdReagendamento').val();
                        var selectReabertura = $('#iQtdReabertura').val();

                        if (selectReagendamento === 'entre') {
                            var primeiroValorReagendamento = $('#primeiroValorEntreReagendamento').val();
                            var segundoValorReagendamento = $('#segundoValorEntreReagendamento').val();

                            data.primeiroValorReagendamento = primeiroValorReagendamento;
                            data.segundoValorReagendamento = segundoValorReagendamento;
                        } else if (selectReagendamento !== 'todas') {
                            var primeiroValorReagendamento = $('#primeiroValorReagendamento').val();
                            data.primeiroValorReagendamento = primeiroValorReagendamento;
                        }

                        if (selectReabertura === 'entre') {
                            var primeiroValorReabertura = $('#primeiroValorEntreReabertura').val();
                            var segundoValorReabertura = $('#segundoValorEntreReabertura').val();

                            data.primeiroValorReabertura = primeiroValorReabertura;
                            data.segundoValorReabertura = segundoValorReabertura;
                        } else if (selectReabertura !== 'todas') {
                            var primeiroValorReabertura = $('#primeiroValorReabertura').val();
                            data.primeiroValorReabertura = primeiroValorReabertura;
                        }

                        data.Data_Inicio = dataInicio,
                        data.Data_Fim = dataFim,
                        data.Contrato = $('#iContrato').val();
                        data.Projeto = $('#iProjeto').val();
                        data.Equipe = $('#iEquipe').val();
                        data.Supervisor = $('#iSupervisor').val();
                        data.TipoServico = $('#iTipoServico').val();
                        data.TipoData = $('input[name=tipodata]:checked').val();
                        data.NumOs = $('#iNumeroServico').val();
                        data.QtdeReabertura = $('#iQtdReabertura').val();
                        data.QtdeReagendamento = $('#iQtdReagendamento').val();
                        data.Area = $('#iArea').val();
                        data.GrupoArea = $('#iGrupoArea').val();
                        data.Localidade = $('#iLocalidade').val();
                    },
                    error: function (e) {
                        console.log(e);
                        HidePageLoading();
                    },
                    dataSrc: function (d) {
                        HidePageLoading();
                        return d.data;
                    }
                },
                columns: datatable_columns,
                drawCallback: () => {
                    HidePageLoading();
                    TagFilter("FiltrosUtilizados", filter_state, "Filtrado por:");
                    ResizeTable('divTable');
                },
                buttons: buttonsDataTableRelatorio({
                    title: "@Html.Raw(ViewBag.Title)",
                    pageSize: GetPageSizePDF(datatable_columns)
                }),
            });
        }

        $(document).ready(async () => {
            $('#modal-filter').modal('show')
            carregaSelect2();
            // Chamada AJAX para obter os dados do servidor
        })

        "use strict";
        function oDatatableFunction() {

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                $('.invalid-feedback').remove();
                return false;
            }

            if ($('#iDataInicio').val() && $('#iDataFim').val()) {

                const momentInicio = moment($('#iDataInicio').val(),"DD/MM/YYYY")
                const momentFinal = moment($('#iDataFim').val(), "DD/MM/YYYY")

                if ((momentFinal.diff(momentInicio, 'days') + 1) > 30) {
                    if ($('#iContrato option:selected').text().trim() === "") {
                        Notificar("@RsBase.ATENCAO_", "Selecione um período de 30 dias", "warning");
                        return false
                    }
                }
            }

            if (oDatatable == null) {
                carregaRelatorioReagendamentoOS();
            }
            else {
                oDatatable.draw()
            }

            $('#modal-filter').modal('hide')
        }

        function handleSelectReabertura() {
            var select = document.getElementById("iQtdReabertura").value;
            var divUnica = document.getElementById("divUnicaReabertura");
            var divDupla = document.getElementById("divDuplaReabertura");
            var divCol = document.getElementById("divHandleReabertura");

            // Esconde ambos os divs inicialmente
            divUnica.style.display = "none";
            divDupla.style.display = "none";

            // Verifica a seleção
            if (select === "entre") {
                divDupla.style.display = "block";
                divCol.classList.remove("col-6");
                divCol.classList.add("col-3");
            } else if (select !== "todas") {
                divUnica.style.display = "block";
                divCol.classList.remove("col-6");
                divCol.classList.add("col-3");
            } else {
                // Nenhum div extra visível, aumenta a largura do primeiro div
                divCol.classList.remove("col-3");
                divCol.classList.add("col-6");
            }
        }

        function handleSelectReagendamento() {
            var select = document.getElementById("iQtdReagendamento").value;
            var divUnica = document.getElementById("divUnicaReagendamento");
            var divDupla = document.getElementById("divDuplaReagendamento");
            var divCol = document.getElementById("divHandleReagendamento");

            // Esconde ambos os divs inicialmente
            divUnica.style.display = "none";
            divDupla.style.display = "none";

            // Verifica a seleção
            if (select === "entre") {
                divDupla.style.display = "block";
                divCol.classList.remove("col-6");
                divCol.classList.add("col-3");
            } else if (select !== "todas") {
                divUnica.style.display = "block";
                divCol.classList.remove("col-6");
                divCol.classList.add("col-3");
            } else {
                divCol.classList.remove("col-3");
                divCol.classList.add("col-6");
            }
        }


    </script>
}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="far fa-calendar-alt"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Relatorio")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.RELATORIO</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">


                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;"><i class="fas fa-file-excel"></i> @RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="#" onclick="$('.buttons-pdf').click(); return false;"><i class="fas fa-file-pdf"></i> @RsBase.EXPORTARPDF</a>
                </div>


            </div>
        </div>

    </div>
    <div id="divSubTitle">
        <div id="FiltrosUtilizados" class="mr-2 ml-2 form-inline"></div>
        <div class="mr-2 ml-2 form-inline mt-1 fs-12">@(String.Format(RsFinanceiro.EMITIDO_POR_EM_AS, User.Identity.GetUserName(), DateTime.Now.ToString("dd/MM/yyyy"), DateTime.Now.ToString("HH:mm")))</div>


    </div>
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="form-group border_radius">
                    <div class="row container">

                        <div class="col">
                            <input type="radio" value="CRIACAO" id="iDataCriacao" name="tipodata" checked />
                            <label for="iDataCriacao">@RsCadastros.DATA_CRIACAO</label>
                        </div>
                        <div class="col">
                            <input type="radio" value="AGENDAMENTO" id="iDataAgendamento" name="tipodata" />
                            <label for="iDataAgendamento">@RsCadastros.DATA_AGENDAMENTO</label>
                        </div>
                        <div class="col">
                            <input type="radio" value="ENCERRAMENTO" id="iDataEncerramento" name="tipodata" />
                            <label for="iDataEncerramento">@RsCadastros.DATA_ENCERRAMENTO</label>
                        </div>


                    </div>
                    <div class="row">
                        <div class="col form-inline text-center mt-1" style="display:block">
                            <input class="form-control obrigatorio datepicker-period mb-1"
                                   id="iDataInicio"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />

                            <span class="pl-3 pr-3">@RsBase.A</span>

                            <input class="form-control obrigatorio datepicker-period  mb-1"
                                   id="iDataFim"
                                   type="text"
                                   data-enddate="@(DateTime.Today.ToString("dd/MM/yyyy"))"
                                   data-startdate="@(DateTime.Now.ToString("01/01/0001"))"
                                   autocomplete="off"
                                   placeholder="00/00/0000" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="iNumeroServico">@RsCadastros.NUMERO_ORDEM_SERVICO</label>
                            <input type="text" class="form-control" id="iNumeroServico" />
                        </div>
                    </div>
                    <div class="col-6">
