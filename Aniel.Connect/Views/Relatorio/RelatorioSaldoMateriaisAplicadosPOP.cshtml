                            <select class="form-control filtro" id="iProjeto" disabled></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iPOP">@RsCadastros.POP:</label>
                            <select class="form-control filtro" id="iPOP"></select>
