                            <label for="iEmpresa">@RsCadastros.EMPRESA:</label>
                            <select class="form-control filtro" id="iEmpresa"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iFilial">@RsCadastros.FILIAL:</label>
                            <select class="form-control filtro" id="iFilial" disabled></select>
                        </div>
                    </div>
                </div>
                <div class="row">                                  
                    <div class="col">
                        <div class="form-group">
                            <label for="iContrato">@RsCadastros.CONTRATO:</label>
                            <select class="form-control filtro" id="iContrato"></select>
                        </div>
