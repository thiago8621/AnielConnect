        function testi(id, type, porta) {

            let url = "@CONSTANTES.URLPortal/api/Elemento_Rede_PortaApi/Reserva_Porta";

            $.ajax({
                url: url,
                type: "POST",
                data: {
                    Id_Caixa: id,
                    Id_Porta: type,
                    Porta: porta,
                    Cliente_PlanoProduto : plano

                },

                dataType: "json"

            }).done(function (data) {

                if (data.ok) {

                    if ($("a").filter(`[data-reservado='1']`).length > 0) {

                        let idReservaAntiga = $("a").filter(`[data-reservado='1']`)[0].id;
                        $(`#${idReservaAntiga}`).attr("data-reservado", 0);
                        document.getElementById(idReservaAntiga).style.color = "red";
                        document.getElementById(idReservaAntiga).innerHTML = "Reservar Porta";
                    }

                    $(`#${id}`).attr("data-reservado", 1);
                    document.getElementById(id).style.color = "green";
                    document.getElementById(id).innerHTML = "Reservada";
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning")
                }
            });
        }

