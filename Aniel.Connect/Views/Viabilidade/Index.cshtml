        $("#iReservarPorta").on("click", async () => {
            let [caixa, plano] = [$("#modal-reserva").attr("data-id"), $("#modal-reserva").attr("data-clienteplanoproduto")];
            Swal.fire({
                title: `Deseja Reservar uma Porta na Caixa ${caixa} ?`,
                text: "",
                showCancelButton: true,
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não',
                type: 'warning',
                confirmButtonColor: "#357ca5",
                allowOutsideClick: true,
                showCloseButton: true
            }).then(async (result) => {
                if (result.value) {
                    ShowPageLoading();
                    await reservaPorta(caixa, plano);
                    HidePageLoading();
                }
            });
        });

        async function reservaPorta(caixa, plano) {
            try {
                let url = "@CONSTANTES.URLPortal/api/Elemento_Rede_PortaApi/ReservarPortaByVenda";
                let resultado = await $.ajax({ url: url, data: { caixa: caixa, clientePlanoProduto: plano }, type: "POST", dataType: "json" });

                Notificar("@RsCadastros.CADASTRO_SUCESSO", `Porta ${resultado.numeroPorta} da Caixa ${resultado.IdCaixa} Reservada`, "info");
            }
            catch (exception) {
                Notificar("@RsCadastros.ERRO", `Erro ao gravar a reserva de porta`, "warning");
            }
            finally {
                $("#modal-reserva").modal("hide");
            }
        }

        async function gerarPoligonoAreaCobertura(IdsAreaCobertura) {

            $.ajax({
                type: "POST",
                url: "@CONSTANTES.URLPortal" + `/api/Area_CoberturaApi/GetPoligonosViabilidade`,
                dataType: "json",
                data: { Ids: IdsAreaCobertura }
            }).done(function (data) {
                for (let record of data) {
                    //Lendo de retangulos no mongo
                    switch (record?.tipo) {

                        case 1:
                            record.coordenadas.forEach(function (retangulo) {

                                var latlng = [];
                                for (var i = 0; i < retangulo.length; i++) {

                                    var lat = retangulo[i];
                                    i = i + 1;
                                    var lng = retangulo[i];

                                    latlng.push(new google.maps.LatLng(lat, lng));

                                }

                                console.log(latlng);

                                /*construtor*/
                                const polygon = new google.maps.Polygon({
                                    strokeColor: record.cor,
                                    strokeOpacity: 0.8,
                                    strokeWeight: 2,
                                    fillColor: record.cor,
                                    posicao: LatlngList.findIndex(i => i === retangulo),
                                    fillOpacity: 0.35,
                                    editable: false,
                                    map,
                                    paths: latlng,
                                });
                                console.log(polygon);

                                //click event in shape of polygon em que deixa ele editável
                                google.maps.event.addListener(polygon, 'click', function (event) {
                                    console.log("Posicao edicao:" + polygon.posicao);
                                    polygon.editable == false ? polygon.setEditable(false) : polygon.setEditable(true);
                                });

                                //evento ao clicar com botão direito no shape
                                google.maps.event.addListener(polygon, 'rightclick', function (event) {

                                    path = polygon.getPath();
                                    for (i = 0; i < path.length; i++) {
                                        if (event.latLng == path.getAt(i)) {
                                            path.removeAt(i);
                                        }
                                    }

                                });
                            });
                            break;
                    }
                }
            });
        }
