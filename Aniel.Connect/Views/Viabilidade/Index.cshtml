                           dataType: "json"

                             }).done(function (data) {
                              //Lendo de retangulos no mongo
                              console.log(data);

                                for (data of data) {
                                    console.log(data)

                                    switch (data.tipo) {

                                        case 1:
                                            data.coordenadas.forEach(function (retangulo) {
                                                LatlngList.push(retangulo);
