@section styles{

    <style>

        .rcorners2 {
            /*border-radius: 25px;*/
            border: 1px solid #cccccc;
            border-top-left-radius: 15px;
            border-bottom-left-radius: 15px;
            padding: 20px;
            width: 300px;
            height: 100px;
        }

        .rcorners3 {
            border-radius: 25px;
            border: 1px solid #cccccc;
            padding: 20px;
            width: 300px;
            height: 100px;
        }
