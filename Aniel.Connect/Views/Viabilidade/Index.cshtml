@section Scripts{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script src="https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?features=default"></script>
    <!-- Async script executes immediately and must be after any DOM elements used in callback. -->
    <script src="https://maps.googleapis.com/maps/api/js?key=@CONSTANTES.TokenGoogleAPI&v=3.64&libraries=places,drawing,geometry"></script>

    <!--GoogleMaps Config-->
    <!--map-font-icons-->
    <script src="~/Scripts/map-font-icons.js"></script>
    <script>
        const model = @Html.Raw(Json.Encode(Model));
        let IdsAreaCobertura = [];
        let marcadorAutoComplete = null;
        let autocomplete = null;
        initialize();

        let Visualizar_Caixa = null,
            plano = null,
            poligonoBanco = null;

        $(document).ready(async function () {
            if (model.PossuiDisponibilidade != Number("@(Convert.ToInt32(StatusConsultaViabilidade.Aprovado))")) {
                let reasons = [];
                reasons = model.Motivos;

                let text = "";

                if (reasons.length > 1) {
                    reasons.forEach(function (razao, index) {
                        number = index + 1;
                        text = `${text} <br> ${number}: ${razao.Motivo}`;
                    });
                }

                else {
                    text = `${text} ${reasons[0].Motivo}`;
                }

                Notificar("@RsBase.ATENCAO_", text, "warning");
                consultaViabilidade(model);
            }
            else {
                await initViabilidade(model, model.Caixas, [model.Latitude, model.Longitude]);
            }
        });

        function consultaViabilidade(consulta) {
            let geo_latitude = Number(consulta.Latitude);
            let geo_longitude = Number(consulta.Longitude);

            map.setCenter(new google.maps.LatLng(geo_latitude, geo_longitude));
            var token = '@CONSTANTES.TokenGoogleAPI';
            $.ajax({
                url: `https://maps.googleapis.com/maps/api/geocode/json?latlng=${geo_latitude},${geo_longitude}&key=${token}&sensor=false`,
                method: 'GET',
                crossOrigin: true,
                type: 'json'
            }).then(function (response) {
                var endereco = response.results[0].formatted_address;
                $("#iPesquisaMap").val(endereco);
                setPointLocalization();
            }).fail(function (err, msg) {
                console.info(err, msg);
            });
        }

        function setPointLocalization() {
            let pesquisa = $("#iPesquisaMap").val();
            var service = new google.maps.places.PlacesService(map);
            var request = {
                query: pesquisa,
                fields: ['name', 'geometry'],
            };
            service.findPlaceFromQuery(request, function (results, status) {
                if (marcadorAutoComplete) {
                    marcadorAutoComplete.setMap(null);
                }
                if (status === google.maps.places.PlacesServiceStatus.OK) {

                    if (results.length > 0) {
                        let latlng = {
                            lat: results[0].geometry.location.lat(),
                            lng: results[0].geometry.location.lng()
                        };

                        marcadorAutoComplete = new google.maps.Marker({
                            position: latlng,
                            map: map,
                            draggable: true,
                            title: $("#iPesquisaMap").val()
                        });

                        map.setCenter(results[0].geometry.location);
                    }
                } else if (status === google.maps.places.PlacesServiceStatus.ZERO_RESULTS) {
                    Notificar("@RsBase.ATENCAO_", "Nenhum resultado foi encontrado para a solicitação. Por favor, verifique a localização.", "warning");
                } else if (status === google.maps.places.PlacesServiceStatus.UNKNOWN_ERROR) {
                    Notificar("@RsBase.ATENCAO_", "Não foi possível processar a solicitação. Tente novamente mais tarde!", "warning");
                } else if (status === google.maps.places.PlacesServiceStatus.NOT_FOUND) {
                    Notificar("@RsBase.ATENCAO_", "O lugar referenciado não foi encontrado! Por favor, verifique a localização.", "warning");
                }
            });
        }

        async function initViabilidade(consulta, caixasConsulta, geocliente) {
            //#region json
            if ((caixasConsulta !== null) && (geocliente !== "") && (caixasConsulta.length > 0)) {

                let geo_latitude = Number(caixasConsulta[0].Latitude);
                let geo_longitude = Number(caixasConsulta[0].Longitude);

                let LatlngList = [];
                let Id_AreacoberturaPlano = [];
                let poligonosbanco = [];

                map.setCenter(new google.maps.LatLng(geo_latitude, geo_longitude));
                await $.ajax({
                    type: "GET",
                    url: '@String.Concat(CONSTANTES.URLPortal, "/api/Mapa_Analise_ComercialApi/GetComboPoligonosMongo")',
                    data: { Latitude: geo_latitude, Longitude: geo_longitude },
                    dataType: "json",
                    async: false
                }).done(function (data) {
                    //Lendo de retangulos no mongo
                    //console.log(data);

                    for (data of data.objeto) {

                        if (data) {
                            var Id_AreacoberturaDataPlano = data.id;
                            data.coordenadas.forEach(function (retangulo) {
                                LatlngList.push(retangulo);
                                var latlng = [];

                                for (let i = 0; i < retangulo.length; i++) {
                                    let lat = retangulo[i],
                                        lng = retangulo[++i];

                                    latlng.push(new google.maps.LatLng(lat, lng));
                                }

                                let polygon = new google.maps.Polygon({
                                    strokeColor: data.cor,
                                    strokeOpacity: 0.8,
                                    strokeWeight: 2,
                                    fillColor: data.cor,
                                    /*posicao: LatlngList.findIndex(i => i === retangulo),*/
                                    fillOpacity: 0.35,
                                    editable: false,
                                    paths: latlng,

                                });
                                console.log(latlng);
                                let point = new google.maps.LatLng(geo_latitude, geo_longitude);

                                if (google.maps.geometry.poly.containsLocation(point, polygon) == true) {
                                    polygon.setMap(map);
                                    Id_AreacoberturaPlano.push(Id_AreacoberturaDataPlano);
                                    console.log(Id_AreacoberturaPlano, "...........");
                                    pathlatlng = [];

                                    poligonosbanco.push(Id_AreacoberturaDataPlano);
                                }
                                else {
                                    console.log("no");
                                }
                            });
                        }
                    }
                })

                // #region plano
                let polygon = JSON.stringify(poligonosbanco);

                if (poligonosbanco.length > 0) {
                    await $.ajax({

                        url: `@String.Concat(CONSTANTES.URLPortal, "/api/Mapa_Analise_ComercialApi/GetInfo")?jsonrequest=${polygon}`,
                        type: "GET",
                        dataType: "json"
                        //testar agora
                    }).done(function (data) {

