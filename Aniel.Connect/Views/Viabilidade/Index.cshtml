        async function get_Objetos_Analise(Id) {
                var url = "@CONSTANTES.URLPortal/api/Mapa_Analise_ComercialApi/Get_Objetos_Analise";
                url = url + `?Id_check=${Id}`
                $.getJSON({ url: url, }).done(async function(data){
                    console.log(data);
              /*      initialize(map);*/
                switch (Id) {
                        case "0": { await renderPolygon(data.objeto,map); break; }
                        case "1": { await renderSingle(data.objeto,map); break; }
                        case "2": { await renderSingle(data.objeto, map); break; }
                        case "3": { await renderSingle(data.objeto, map); break; }
                        case "4": { await renderSingle(data.objeto, map); break; }
                    }
                });
            }

        async function renderPolygon(Data, map) {
            //Lendo de retangulos no mongo
            Data = Data.filter(p => { return p.coordenadas != null });
            for (var obj of Data) {

                for (var coordenada of obj.coordenadas) {
                    let latlng = [];
                    for (let i = 0; i < coordenada.length; i++) {

                        let lat = coordenada[i],
                            lng = coordenada[++i];

                        latlng.push(new google.maps.LatLng(lat, lng));
                        //console.log(latlng);
                    }

                    const polygon = new google.maps.Polygon({
                        strokeColor: obj.cor,
                        strokeOpacity: 0.8,
                        strokeweight: 2,
                        fillColor: obj.cor,
                        fillOpacity: 0.35,
                        editable: false,
                        map,
                        paths: latlng
                    });

                }
            }
        }

        async function renderSingle(Data, map) {
            var array_icon = []
            Data.forEach(p => {
                var icon = {
                    path: p.icone_Str,
                    fillColor: "blue",
                    fillOpacity: 0.6,
                    strokeWeight: 2,
                    rotation: 0,
                    scale: 0.2,
                    anchor: new google.maps.Point(0, 0)
                };
                new google.maps.Marker({
                    map,
                    title: "",
                    position: new google.maps.LatLng(p.latitude, p.Longitude),
                    icon: icon
                });
            });
        }

