@model Aniel.Connect.Models.ComboDetalheModel
@{
    ViewBag.Title = "DetalhesPlanoProduto";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section Scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>
        const data =@Html.Raw(Json.Encode(Model.ListaModelos));
        const lista = "ListaModelos";
        const table = $("#datatableComboPlanos").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: data,
            columns: [
                { title: "Descrição", data: "Descricao" },
                { title: "Plano/Produto", data: "PlanoProduto" },
                { title: "Franquia", data: "Franquia" },
                { title: "Ponto", data: "Ponto" },
                { title: "Velocidade (MB)", data: "Velocidade" },
                { title: "Frequência de Cobrança", data: "Frequencia_Cobranca" },
                { title: "Formato de Cobrança", data: "Formato_Cobranca" },
                {
                    title: "Detalhe",
                    data: "Detalhe",
                    render: function (data, type, row, meta) {
                        return `<a href="#" id="i${lista}_${meta.row}" data-toggle="collapse" data-target="#i${lista}_text_${meta.row}" name="i${lista}[${meta.row}].Detalhe">` +
                               '    <i class="fas fa-arrow-down"></i>' +
                               '</a>' +
                               `<span class="collapse"id="i${lista}_text_${meta.row}">${data}<span>`;
                    }
                },               
            ]
        });
    </script>
}

<hr />
<div class="card-body body-card-accord">
    <div class="row">
        <h4 class="text-muted" style="font-size: 15px">@RsCadastros.DETALHES_DO_CONTRATO</h4>
    </div>
    <div class="row">
        <div class="col-sm-3">
            <div class="form-group">
                <label>Valor do Combo:</label>
                <span id="iConsultaValorCombo">@Model.Valor_Combo</span>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="form-group">
                <label>Valor da Instalação:</label>
                <span id="iConsultaValorInstalacao">@Model.Valor_Instalacao</span>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="form-group">
                <label>@RsCadastros.NUMERO_PARCELAS_INSTALACAO:</label>
                <span id="inumparcelainstalacao">@Model.Numero_Parcelas</span>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="form-group">
                <label>Dias Teste Grátis:</label>
                <span id="inumparcelainstalacao">@Model.Numero_Parcelas</span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-3">
            <div class="form-group">
                <label for="iConsultaCheckPeriodoCarencia">@RsCadastros.TEM_CARENCIA:</label>
                <span id="iConsultaMeses_Carencia"> @Model.Tem_Carencia</span>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="form-group">
                <label for="iConsultaCheckPeriodoCarencia">@RsCadastros.PERIODO_CARENCIA_MESES:</label>
                <span id="iConsultaMeses_Carencia"> @Model.Periodo_Carencia</span>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="form-group">
                <label for="iConsultaCheckPeriodoCarencia">@RsCadastros.MULTA_CARENCIA_REAIS:</label>
                <span id="iConsultaMeses_Carencia"> @Model.Multa_Carencia_Reais</span>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="form-group">
                <label for="iConsultaCheckPeriodoCarencia">Renovação Automática:</label>
                <span id="iConsultaMeses_Carencia"> @Model.Cancelar_Contrato_Automatico_Fim_Carencia</span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-3">
            <div class="form-group">
                <label for="iConsultaCheckPeriodoCarencia">@RsCadastros.DESCONTO.Insert(@RsCadastros.DESCONTO.Length, " Combo") :</label>
                <span id="iConsultaMeses_Carencia"> @Model.Cancelar_Contrato_Automatico_Fim_Carencia</span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="card-header title-card" id="heading_5">
            <h5 class="mb-0"></h5>
            <span class="text-bold-card">Detalhes Complementares (@RsCadastros.COMBO)</span>
        </div>
        <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
            <div class="card-body">
                <table class="table table-hover nowrap text-center" id="datatableComboPlanos" style="width:100%"></table>
            </div>
        </div>
    </div>
</div>

<div class="card-body body-card-accord">
    @Html.DisplayFor(m => m.Detalhes, new { @class = "", id = "iDetalhes" })
</div>
