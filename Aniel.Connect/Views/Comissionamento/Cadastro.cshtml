@model Aniel.Connect.Models.ComissionamentoCadastroModel
@using Aniel.Connect.Core;

@{
    ViewBag.Title = RsCadastros.CADASTRO_COMISSIONAMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script>

        var oDatatable;

        function CarregarTodos() {

            Swal.fire({
                text: "Deseja carregar valores dos planos/produtos ?",
                type: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não'
            }).then((result) => {

                var link = '';

                if (result.value) {
                    link = '@String.Concat(CONSTANTES.URLPortal, "/api/ComissionamentoApi/CarregarPlanoProduto?IdComisionamento=")' + @Model.Id + "&CarregaValores=true";
                    try {
                        parent.App.startPageLoading();
                    }
                    catch (e) {
                        console.log(e);
                    }


                }
                else {
                    link = '@String.Concat(CONSTANTES.URLPortal, "/api/ComissionamentoApi/CarregarPlanoProduto?IdComisionamento=")' + @Model.Id + "&CarregaValores=false";
                }


                $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',

                })

                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsCadastros.DADOS_INSERIDOS", "info");

                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    })
                    .fail(function () {

                    })
                    .always(function () {
                        try {
                            parent.App.stopPageLoading();
                        }
                        catch (e) {
                            console.log(e);
                        }
                    });


            })

        }

        $(document).ready(function () {

            // AddSelect

            AddSelect("iFilial", "@CONSTANTES.URLPortal/api/FilialApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Filial", "@RsBase.SELECIONE", false);

            "use strict";

            //"Blfrtip"
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                select: 'multi',
                order: [[0, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollY: '73vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/Comissionamentoapi/GetAll_PlanoProduto',
                    type: 'POST',
                    data: function (data) {
                        data.Id_Comissionamento = @Model.Id;
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {

                        //if (d.data.length > 0) {
                        //    $("#btnCarregarTodos").hide();
                        //}
                        //else {
                        //    $("#btnCarregarTodos").show();
                        //}

                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";

                },
                pageLength: 10,
                language: traducaoDataTable,
                buttons: buttonsDataTable,
                columns: [
                    { data: "descricao", title: "@RsCadastros.DESCRICAO" },
                    { data: "quantidade", title: "@RsCadastros.QUANTIDADE" }
                ]
            });

            $('#datatable tbody').on('click', 'tr', function () {

                var _id = oDatatable.row(this).data().id;


                ShowDialog(true, true, 'Detalhes do Comissionamento', '@Url.Action("Comissao", "Comissionamento")' + '?Id=' + _id, 'divComissao', 800, 450, 'iframeDetalhesPlano',
                    function () {
                        try {

                            setTimeout(function () {
                                oDatatable.draw();
                            }, 500);


                        }
                        catch {
                            setTimeout(function () {
                                oDatatable.draw();
                            }, 500);
                        }
                    }
                );

            });
        });


        var clicked = false;
        function ValidaSubmit()
        {
            var erro = false;

            if (clicked) {
                return false;
            }

            if (!$("#iFilial").val()) {
                Notificar("@RsBase.REQUIRED", "@RsCadastros.FILIAL", "warning");
                erro = true;
            }

            if (erro) {
                return false;
            }

            clicked = true;
            ShowPageLoading();
            $('#form').submit();
        }

        function LimparTodos() {

            try {
                parent.App.startPageLoading();
            }
            catch (e) {
                console.log(e);
            }

        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/ComissionamentoApi/LimpaPlanoProduto?IdComisionamento=")' + @Model.Id + "&CarregaValores=false";

        $.ajax({
            url: link,
            type: 'GET',
            dataType: 'json',

        })

            .done(function (data) {

                if (data.ok) {
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsCadastros.DADOS_LIMPOS_SUCESSO", "info");

                    oDatatable.draw();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            })
            .fail(function () {

            })
            .always(function () {
                try {
                    parent.App.stopPageLoading();
                }
                catch (e) {
                    console.log(e);
                }
            });

    }

    </script>
}



@using (Html.BeginForm("Cadastro", "Comissionamento", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id, new { id = "hidden" })

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page">
                            <i class="fas fa-hand-holding-usd"></i> @ViewBag.Title
                        </h4>
                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Comissionamento")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_COMISSIONAMENTO</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        @*<span style="font-size:11px" id="dtLegend"></span>*@
                    </div>
                </div>

                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">

                            @if (Model.Id != 0)
                            {
                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                    <span class="text-bold-card">@ViewBag.Title</span>
                                </a>
                            }
                            else
                            {
                                <span class="text-bold-card">@ViewBag.Title</span>
                            }

                        </h5>
                    </div>

                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="row mt-2 mb-2">
                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iCodigo" class="mr-3">@RsCadastros.CODIGO:</label>
                                        @Html.TextBoxFor(model => model.Codigo, new { @class = "form-control", @id = "iCodigo", disabled = "disabled" })
                                        @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iDescricao" class="mr-3">@RsCadastros.DESCRICAO:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off" })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="iFilial">@RsCadastros.FILIAL</label>
                                        <div class="input-group">
                                            @Html.DropDownListFor(m => m.Id_Filial, new SelectList(new List<ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iFilial", @style = "height: 24px" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        @if (Model.Id != 0)
                                        {

                                            <label for="iStatus" class="mr-3">@RsCadastros.STATUS:</label>
                                            <div class="form-group">
                                                @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = "Status", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (Model.Id != 0)
                            {
                                <div class="row mt-3" id="carregar_Plano_Produto">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iOpcaoProRata" class="mb-1"></label><br>
                                            <input value="@RsConfiguracao.CARREGA_PLANO_PRODUTO" type="button" onclick="CarregarTodos()" class="btn btn-success" id="btnCarregarTodos" />

                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="iOpcaoPro" class="mb-1"></label><br>
                                            <input value="Limpar Planos e Produtos" type="button" onclick="LimparTodos()" class="btn btn-danger" id="btnLimparTodos" />
                                        </div>
                                    </div>

                                </div>
                            }
                        </div>
                    </div>
                </div>


                <div id="divComissao"></div>


                <!--AQUI DATATABLE-->

                @if (Model.Id != 0)
                {
                    <div id="accordion" class="col-sm-12 mt-3 pl-0 pr-0 ">
                        <div class="card div-card-accord">
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-header title-card" id="heading-6">
                                    <h5 class="col-sm-12">

                                        <span class="text-bold-card">@RsConfiguracao.LISTA_PLANO_PRODUTO</span>

                                    </h5>
                                </div>

                                <div class="card-body">

                                    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>

                                </div>

                            </div>
                        </div>

                    </div>
                }

            </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Comissionamento")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="ValidaSubmit()">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


}