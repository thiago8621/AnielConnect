@model Aniel.Connect.Models.Comissionamento_PlanoProdutoListaModel

@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@{
    ViewBag.Title = "Comissao";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}



@section scripts{

    @if (ViewBag.Sucesso == true)
    {

        <script type="text/javascript">
            $(document).ready(function () {

                try {
                    parent.dial.dialog('close');
                }
                catch (ex) {
                    console.log(ex);
                }
            });
        </script>
    }


    <script>

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;
            ShowPageLoading();

            $('#form').submit();


            try {
                parent.dial.dialog('close');
            }
            catch (ex) {
                console.log(ex);
            }

            return true;
        }
    </script>

}
@using (Html.BeginForm("Comissao", "Comissionamento", FormMethod.Post, htmlAttributes: new { @id = "form", @autocomplete = "off" }))
{
    <div class="row">

        <div class="col-sm-12 container" style="align-content:center;">

            <div class="form-group">
                <label for="iDescricao">@RsCadastros.DESCRICAO: </label>
                @Html.DisplayFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao" })
                @Html.HiddenFor(model => model.Id, new { @class = "form-control", @id = "iDescricao" })
            </div>
            @*<div class="form-group">
                <label for="iUnidade">@RsCadastros.UNIDADE</label>
                @Html.TextBoxFor(model => model.Unidade, new { @class = "form-control", @id = "iUnidade" })
            </div>*@
            <div class="form-group">
                <label for="iQuantidade">@RsCadastros.QUANTIDADE</label>
                @Html.TextBoxFor(model => model.Quantidade, new { @class = "form-control  ", @id = "iQuantidade" })
            </div>

        </div>

        <div class="form-group col-sm-12" style="padding: 15px;">
            <div class="text-center">
                <button type="button" onclick="parent.dial.dialog('close'); return false;" class="btn btn-danger" id="iLimparFiltroModal">Cancelar</button>
                <button type="button" onclick="return ValidaSubmit();" class="btn btn-success" id="iPesquisar">Salvar</button>
            </div>
        </div>
    </div>

    @*<div id="mapa"></div>*@
}


