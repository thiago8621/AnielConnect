@model Aniel.Connect.Models.Notificacoes_CadastroModel
@using Aniel.Connect.Models
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Microsoft.AspNet.Identity
@using Aniel.Connect.Models.T5

@{

    ViewBag.Title = RsCadastros.CONFIGURAR_NOTIFICACOES;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;

    List<Aniel.Connect.Core.ObjComboResult<String>> listaOrdenada = new List<Aniel.Connect.Core.ObjComboResult<String>>();

    foreach (var valor in Enum.GetValues(typeof(SecaoConnectPerfilEnum)))
    {
        string descricao = HtmlEnumExtensions.GetEnumDescription(valor);
        listaOrdenada.Add(new Aniel.Connect.Core.ObjComboResult<string>
        {
            Id = Convert.ToInt32(valor).ToString(),
            Text = descricao
        });
    }

    listaOrdenada = listaOrdenada.OrderBy(x => x.Text).ToList();


    //lista de seção / usuários


}

@section styles
{
    <style>
        #listVariaveisOLT, #listVariaveisOLTVoz, #listVariaveisONU {
            overflow-y: auto;
            padding-left: 15px;
            margin: 0
        }

            #listVariaveisOLT li, #listVariaveisOLTVoz li, #listVariaveisONU li {
                list-style: none;
                cursor: pointer
            }

                #listVariaveisOLT li:hover, #listVariaveisOLTVoz li:hover, #listVariaveisONU li:hover {
                    font-weight: bold;
                    color: dodgerblue;
                }

        .bold {
            font-weight: bold;
        }
    </style>
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

    @if (@Model.Id == null || Model.IdCadastro == null)
    {
        <text>
            <script>
                $("#iCodigo").prop("disabled", true);
                $("#iStatus").val(true);
                $("#divStatus").hide();
                $('#divTempoDisparoNotificacao').hide();
            </script>
        </text>

        Model.Id = null;
    }
    else
    {
        <text>
            <script>
                $("#iCodigo").prop("disabled", true);
                $("#divStatus").show();
            </script>
        </text>
        Model.IdCadastro = Model.Id;

        //Atendimento - Gestão de Tecnicos
        if (Model.AtendenteResp == true)
        {
            <script>
                $('#atendente_responsavel').prop('checked', true);
            </script>
        }
        else if (Model.SupervisorResp == true)
        {
            <script>
                $('#supervisor_responsavel').prop('checked', true);
            </script>
        }
        else if (Model.AtendentesAgentes == true)
        {
            <script>
                $('#atendentes_agentes').prop('checked', true);
            </script>
        }
        else if (Model.TodosAtendentes == true)
        {
            <script>
                $('#todos_atendentes').prop('checked', true);
            </script>
        }
        else if (Model.TodosSupervisoresAtendentes == true)
        {
            <script>
                $('#todos_supervisores_atendentes').prop('checked', true);
            </script>
        }

        //Comercial - Gestão de Tecnicos
        if (Model.SupervisorComercialResp == true)
        {
            <script>
                $('#supervisor_comercial_responsavel').prop('checked', true);
            </script>
        }
        else if (Model.VendedorResp == true)
        {
            <script>
                $('#vendedor_responsavel').prop('checked', true);
            </script>
        }
        else if (Model.TodosSupervisores == true)
        {
            <script>
                $('#todos_supervisores').prop('checked', true);
            </script>
        }
        else if (Model.TodosVendedores == true)
        {
            <script>
                $('#todos_vendedores').prop('checked', true);
            </script>
        }

        //Serviços - Gestão de Tecnicos
        if (Model.MonitorEquipe == true)
        {
            <script>
                $('#monitor_equipe').prop('checked', true);
            </script>
        }
        else if (Model.SupervisorEquipe == true)
        {
            <script>
                $('#supervisor_equipe').prop('checked', true);
            </script>
        }



    }


    <script>

    $(document).ready(async () => {
        AddSelect("iUsuario", "@CONSTANTES.URLPortal/api/Funcionarioapi/GetComboAllUsuarios", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        $("#iSecaoConnect").trigger("change");
    });


    $("#iSecaoConnect").on("change", function () {

        var secaoConnect = $(this).val();

        //Atendimento
        if (secaoConnect == 0) {
            $("#divAtendimento").show();
            $("#divComercial").hide();
            $("#divServico").hide();

            $("#variaveisAtendimento").show();
            $("#variaveisServico").hide();
            $("#variaveisComercial").hide();

        //Comercial
        } else if (secaoConnect == 1) {
            $("#divComercial").show();
            $("#divAtendimento").hide();
            $("#divServico").hide();

            $("#variaveisAtendimento").hide();
            $("#variaveisServico").hide();
            $("#variaveisComercial").show();
        }

        //Serviços
        else if (secaoConnect == 2) {
            $("#divServico").show();
            $("#divAtendimento").hide();
            $("#divComercial").hide();

            $("#variaveisAtendimento").hide();
            $("#variaveisServico").show();
            $("#variaveisComercial").hide();
        }

        //Gestão de Tecnicos
        else if (secaoConnect == 3) {
            $("#divServico").show();
            $("#divAtendimento").show();
            $("#divComercial").show();
        }
    });

    //Montando os outros destinatários
    var handleDataTableButtons = function () {
        "use strict";

        var array = @Html.Raw(Json.Encode(Model.Destinatarios));

        var nome_lista = "Destinatarios";//Nome_utilizado para enganar o razor

        //"Blfrtip"
        var oDatatable = $("#datatable").length && $("#datatable").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: array,
            pageLength: 5000,
            ordering: false,
            columns: [
                {
                    data: "Id",
                    orderable: false,
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluir" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Usuario" name="' + nome_lista + '[' + meta.row + '].Usuario" type="hidden" value="' + TrataNulo(row.Usuario) + '">';
                    }
                },
                {
                    data: "UsuarioNome",
                    orderable: false,
                    title: "@RsCadastros.FUNCIONARIO",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__UsuarioNome" name="' + nome_lista + '[' + meta.row + '].UsuarioNome" type="hidden" value="' + TrataNulo(data) + '">';
                        }
                        return data;
                    },
                    width: 380
                }
            ]
        });

        function handleExcluir() {
            $(".btnExcluir").unbind('click');
            $(".btnExcluir").click(function (e) {
                e.preventDefault();

                var idArquivo = $(this).attr("excluir");

                var trLinkButton = $(this).parents('tr');

                if (idArquivo === "0") {
                    oDatatable.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
                else {

                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/NotificacoesApi/ExcluirDestGrid?value=")' + idArquivo;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',

                    })
                        .done(function (data) {

                            if (data.ok) {
                                oDatatable.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                        .fail(function () {

                        })
                        .always(function () {

                        });
                }

            });
        }

        handleExcluir();

        $("#btnAdicionar").unbind('click');
        $("#btnAdicionar").on('click', function () {

            var erro = false;

            if (ValidaCamposObrigatorios(false)) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                return false;
            }

            for (var i = 0; i < oDatatable.rows().data().length; i++) {

                if (oDatatable.rows().data()[i].Id == $("#iUsuario").val()) {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.SELECIONE_USUARIO)", "warning");
                    erro = true;
                    break;
                }

            }

            if (erro) {
                return false;
            }

            oDatatable.row.add({
                Id: 0,
                Usuario: $("#iUsuario option:selected").val(),
                UsuarioNome: $("#iUsuario option:selected").text()
            }).draw(false);

            handleExcluir();
            $("#iUsuario").val(null);

        });

    },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();


    var clicked = false;


    function ValidaSubmit() {
        if (clicked) {
            return false;
        }

        clicked = true;

        var erro = false;

        if ($('#iDescricao').val() == "") {
            Notificar("@RsBase.ATENCAO_", "Informe a Descrição", "warning");
            erro = true;
        }
        if ($('#iSecaoConnect').val() == "") {
            Notificar("@RsBase.ATENCAO_", "Selecione a Seção Connect", "warning");
            erro = true;
        }
        if ($('#iTextoNotificacao').val() == "") {
            Notificar("@RsBase.ATENCAO_", "Digite o texto da notificação", "warning");
            erro = true;
        }

        if (erro) {
            clicked = false;
            return false;
        }


        ShowPageLoading();
        $('#form').submit();

    }

    </script>
}


@using (Html.BeginForm("Cadastro", "Notificacoes", FormMethod.Post, htmlAttributes: new { @id = "form" }))
