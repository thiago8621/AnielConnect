    function handleEditar() {
        $(".btnEditar").unbind('click');
        $(".btnEditar").click(function (e) {
            e.preventDefault();

            var idArquivo = $(this).attr("editar");
            var trLinkButton = $(this).parents('tr');
            linhaAlterar = trLinkButton;
            let dados = oDatatableFormaPagamento.row(trLinkButton).data();


            AddSelect("iFormaPagamentoEditar", "@CONSTANTES.URLPortal/api/Forma_PagamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, dados.Id_Forma_Pagamento, "@RsBase.SELECIONE", false, HandleFormaPagamentoEditar);
