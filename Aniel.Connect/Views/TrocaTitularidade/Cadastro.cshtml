@section scripts
{
    @Scripts.RenderFormat(Aniel.Connect.SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

<script>
    var oDatatable;
    var oDatatableDocsTermo;
    var oDatatableAtendimento;
    var oDatatableFormaPagamento;
    var oDatatablePendenciaEndereco;
    var rows_selected = [];
    var rows_DocsTermo = [];
    var rows_Atendimento = [];
    var valoresChecados = [];
    var listaFormasPagamento = [];
    var arrayFormaPagamento = @Html.Raw(Json.Encode(Model.Formas_Pagamento));

    @* Enumerado dos status das etapas da venda *@
    const STATUS_ETAPA_PENDENTE = @((int)StatusEtapaVenda.Pendente);
    const STATUS_ETAPA_APROVADA = @((int)StatusEtapaVenda.Aprovado);
    const STATUS_ETAPA_REPROVADA = @((int)StatusEtapaVenda.Reprovado);
    const STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR = @((int)StatusEtapaVenda.AguardandoAprovacaoGestor);
    const STATUS_ETAPA_APROVADA_MANUALMENTE = @((int)StatusEtapaVenda.AprovadoManualmente);
    let STATUS_CONSULTA_PENDENCIA_ENDERECO_ATUAL = "NAO_REALIZADA"


    const CONSULTA_VIABILIDADE_RESTRINGE_VENDA = @Html.Raw(Json.Encode(Model.ConsultaViabilidadeRestringeVenda));
    const CONSULTA_PENDENCIA_ENDERECO_RESTRINGE_VENDA = @Html.Raw(Json.Encode(Model.ConsultaPendenciaEnderecoRestringeVenda));
    const CONSULTA_PENDENCIA_FINANCEIRA_RESTRINGE_VENDA = @Html.Raw(Json.Encode(Model.ConsultaPendenciaFinanceiraRestringeVenda));
    const CONSULTA_CREDITO_RESTRINGE_VENDA = @Html.Raw(Json.Encode(Model.ConsultaCreditoRestringeVenda));


    @* Enumerado das etapas da venda *@
    const ETAPA_DADOS_GERAIS = @((int)EnumEtapaVenda.DadosGerais);
    const ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL = @((int)EnumEtapaVenda.ConsultaPendenciaFinanceira);
    const ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_NOVO = @((int)EnumEtapaVenda.ConsultaPendenciaFinanceiraNovo);
    const ETAPA_CONSULTA_PENDENCIA_ENDERECO_ATUAL = @((int)EnumEtapaVenda.ConsultaPendenciaEndereco);
    const ETAPA_CONSULTA_CREDITO = @((int)EnumEtapaVenda.ConsultaCredito);
    const ETAPA_CHECKLIST = @((int)EnumEtapaVenda.Checklist);
    const ETAPA_TERMO_ADESAO = @((int)EnumEtapaVenda.TermoAdesao);

    $(document).ready(function () {
        $("#iClienteContrato").prop("disabled", true);

        var options = {
            onKeyPress: function (cpf, ev, el, op) {
                var masks = ['000.000.000-000', '00.000.000/0000-00'];
                $('#iDocumentoNovo').mask((cpf.length > 14) ? masks[1] : masks[0], op);
            }
        }

        $('#iDocumentoNovo').mask('000.000.000-000', options);
        $('#iCPFResponsavelNovo').mask('000.000.000-000', options);

        $("#iTipoPessoaNovo").val("0").trigger("change");

        AddSelect('iClienteCriar', '@CONSTANTES.URLPortal/api/clienteapi/GetCombo',@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false)
        AddSelect("iCategoriaCliAtual", "@CONSTANTES.URLPortal/api/Categoria_ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.ClienteAtual.Id_Categoria_Cliente", "@RsBase.SELECIONE", false);

         @if (Model.Id != 0)
         {
             <text>
                 AddSelect("iCategoriaCliNovo", "@CONSTANTES.URLPortal/api/Categoria_ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.ClienteNovo.Id_Categoria_Cliente", "@RsBase.SELECIONE", false);
             </text>
         }
         else
         {
              <text>
                 AddSelect("iCategoriaCliNovo", "@CONSTANTES.URLPortal/api/Categoria_ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
             </text>
         }

        @if (classBloqueioCampoFundoCinza)
         {
            <text>
                AddSelect('iListaContratosVenda', '@CONSTANTES.URLPortal/api/clienteContratoapi/GetCombo',@CONSTANTES.PaginacaoRegistros, null, "@Model.ClienteNovo.Id_Cliente", "@Model.NumeroContrato", "@RsBase.SELECIONE", false)
                DisableSelect("iListaContratosVenda");
                $("#iClienteSelect").val("2").change();
                $('#iClienteSelect').prop("disabled", true);
                aplicarReadOnlyCampos();
            </text>
         }
         else
         {
             <text>
                AddSelect('iListaContratosVenda', '@CONSTANTES.URLPortal/api/clienteContratoapi/GetCombo',@CONSTANTES.PaginacaoRegistros, null, "@Model.ClienteAtual.Id_Cliente", "@Model.NumeroContrato", "@RsBase.SELECIONE", false)
            </text>
         }

         aplicarReadOnlyTitularNovo();
         initProgressBar();
         updateProgressBar();
    });

    var handleDataTableButtons = function () {
            "use strict";

            //"Blfrtip"
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                processing: true,
                ordering: true,
                destroy: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                autoWidth: false,
                scrollY: '79vh',
                scrollX: true,
                layout: {
                    bottomEnd: {
                        paging: {
                            firstLast: false
                        }
                    }
                },
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '',
                    type: 'POST',
                    data: function (data) {

                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                drawCallback: function () {
                    HidePageLoading();
                    $("#divProgress").hide();
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                initComplete: dataTableInitComplete,
                columns: [
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                oDatatable.search($(this).val()).draw();
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                var rowData = oDatatable.row($row).data();

                var index = $.inArray(rowData, rows_selected);

                if (this.checked && index === -1) {
                    rows_selected.push(rowData);
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                e.stopPropagation();

            });

            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                e.stopPropagation();
            });
        },
    TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtons();
                }
            }
        }();

    const handleDataTablePendenciaEndereco = function() {
        oDatatablePendenciaEndereco = $("#datatablePendenciaEndereco").length && $("#datatablePendenciaEndereco").DataTable({
                dom: "Bfrti",
                select: {
                    style: 'multi'
                },
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                destroy: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                scroller: {
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                drawCallback: function () {
                    if (oDatatablePendenciaEndereco.rows().data().length == 0) {
                        if (STATUS_CONSULTA_PENDENCIA_ENDERECO_ATUAL == "NAO_REALIZADA") {
                            $(".dataTables_empty").text("A consulta ainda não foi realizada para o endereço").css("color", "#ff0000");

                        }
                        else {
                            $(".dataTables_empty").text("Nenhuma pendência para esse endereço").css("color", "#ff0000");
                        }
                    }
                    $("#divProgress").hide();
                    ResizeTable('divTable');
                },
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/PendenciaEnderecoIntegracaoApi/GetFaturaByEndereco',
                    type: 'POST',
                    data: function (data) {
                        @if(Model.EnderecoCobranca != null)
                        {
                            <text>
                                data.Logradouro = "@Model.EnderecoCobranca.Logradouro";
                                data.Numero = "@Model.EnderecoCobranca.Numero";
                            </text>
                        }
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                rowCallback: function (row, data, dataIndex) {
                    var rowId = data.id;
                    // If row ID is in the list of selected row IDs
                    if ($.inArray(rowId, rows_selected) !== -1) {
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                    }
                },
                pageLength: 5,
                order: [],
                language: {
                    traducaoDataTableSimples,
                },
                buttons: buttonsDataTable,
                columns: [
                    { data: "cod_Contrato", title: "@RsCadastros.CODIGO_CONTRATO", orderable: false },
                    { data: "codConexao", title: "@RsCadastros.CODIGO_CONEXAO", orderable: false },
                    { data: "cod_Cliente", title: "@RsCadastros.CLIENTE", orderable: false },
