    function updateProgressBar() {
            const elemEtapas = $(".etapa-venda").toArray();


            for (let elemEtapa of elemEtapas) {
                const $elemEtapa = $(elemEtapa);

                const etapa = $elemEtapa.data("etapa");
                const status = Number($(`input[data-etapa=${etapa}][name$="Status"]`).val());

                const etapaConsulta =
                    etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL ||
                    etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_NOVO||
                    etapa === ETAPA_CONSULTA_PENDENCIA_ENDERECO_ATUAL ||
                    etapa === ETAPA_CONSULTA_CREDITO;

                switch (status) {
                    case STATUS_ETAPA_PENDENTE:
                        $elemEtapa.removeClass("done");
                        $elemEtapa.removeClass("aguardandoGestor");
                        $elemEtapa.removeClass("reprovado");
                        $elemEtapa.removeClass("aprovadomanual");
                        $elemEtapa.unbind("click");

                        if (etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaFinanceira(1);
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_NOVO) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaFinanceira(2);
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_PENDENCIA_ENDERECO_ATUAL) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaEndereco();
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_CREDITO) {

                            $elemEtapa.unbind("click");
                            if (status == STATUS_ETAPA_PENDENTE) {
                                $elemEtapa.on("click", async function () {
                                    $("#iModal_ConsultaCredito").modal("show");
                                });
                            }
                        }
                        break;
                    case STATUS_ETAPA_APROVADA:
                        @*Aplicação da regra de visualização do status da consulta*@
                        $elemEtapa.removeClass("aprovadomanual");
                        if (@Html.Raw(Json.Encode(AcessoHelper.TemAcesso(_areas, "322")))) {
                            $elemEtapa.addClass("done");
                            $elemEtapa.removeClass("reprovado");
                            $elemEtapa.removeClass("aguardandoGestor");
                            $elemEtapa.removeClass("configVendedor");
                        }
                        else {
                            $elemEtapa.addClass("done");
                            $elemEtapa.removeClass("reprovado");
                            $elemEtapa.removeClass("aguardandoGestor");
                            $elemEtapa.removeClass("configVendedor");
                        }

                        if (etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaFinanceira(1);
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_NOVO) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaFinanceira(2);
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_PENDENCIA_ENDERECO_ATUAL)
                        {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaEndereco();
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_CREDITO) {

                            $("#rowBtnAprovarManualCred").hide();
                            $("#rowBtnGravarCancelarManualCred").hide();

                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                $("#iModal_ConsultaCredito").modal("show");
                            });
                        }
                        break;
                    case STATUS_ETAPA_REPROVADA:
                        @* Aplicação da regra de visualização do status da consulta *@

                        if (@Html.Raw(Json.Encode(AcessoHelper.TemAcesso(_areas, "322")))) {
                            $elemEtapa.addClass("reprovado");
                            $elemEtapa.removeClass("done");
                            $elemEtapa.removeClass("aguardandoGestor");
                        }
                        else {

                            $elemEtapa.addClass("reprovado");
                            $elemEtapa.removeClass("done");
                            $elemEtapa.removeClass("aguardandoGestor");
                            $elemEtapa.removeClass("configVendedor");
                        }

                        if (etapa === ETAPA_CONSULTA_CREDITO) {
                             @if (AcessoHelper.TemAcesso(ViewBag.Areas, "361"))
                             {
                                     <text>
                                      $("#rowBtnAprovarManualCred").show();
                                      $("#rowBtnGravarCancelarManualCred").hide();
                                      </text>
                             }
                             else
                             {
                                     <text>
                                        $("#rowBtnAprovarManualCred").hide();
                                        $("#rowBtnGravarCancelarManualCred").hide();
                                     </text>
                             }
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                $("#iModal_ConsultaCredito").modal("show");
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_NOVO) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaFinanceira(2);
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_PENDENCIA_ENDERECO_ATUAL) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaEndereco(1);
                            });
                        }
                        break;
                    case STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR:
                        @* Aplicação da regra de visualização do status da consulta *@
                        if (@Html.Raw(Json.Encode(AcessoHelper.TemAcesso(_areas, "322")))) {
                            $elemEtapa.addClass("aguardandoGestor");
                            $elemEtapa.removeClass("reprovado");
                            $elemEtapa.removeClass("done");
                            $elemEtapa.removeClass("configVendedor");
                        }
                        else {
                            $elemEtapa.removeClass("aprovadomanual");

                            $elemEtapa.addClass("aguardandoGestor");
                            $elemEtapa.removeClass("reprovado");
                            $elemEtapa.removeClass("done");
                            $elemEtapa.removeClass("configVendedor");

                        }

                        if (etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaFinanceira(1);

                                $("#btnAprovarConsultaCredito").css("display", "block");
                                $("#btnReprovarConsultaCredito").css("display", "block");
                            });
                        }
                        if (etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_NOVO) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaFinanceira(2);

                                $("#btnAprovarConsultaCredito").css("display", "block");
                                $("#btnReprovarConsultaCredito").css("display", "block");
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_PENDENCIA_ENDERECO_ATUAL) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaEndereco();
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_CREDITO) {
                              @if (AcessoHelper.TemAcesso(ViewBag.Areas, "361"))
                              {
                                  <text>
                                  $("#rowBtnAprovarManualCred").show();
                                  $("#rowBtnGravarCancelarManualCred").hide();
                                  </text>
                              }
                              else
                              {
                                  <text>
                                    $("#rowBtnAprovarManualCred").hide();
                                    $("#rowBtnGravarCancelarManualCred").hide();
                                  </text>
                              }
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await Promise.all([
                                ]);
                                $("#iModal_ConsultaCredito").modal("show");
                            });
                        }

                        break;
                    case STATUS_ETAPA_APROVADA_MANUALMENTE:
                        $elemEtapa.addClass("aprovadomanual");
                        $elemEtapa.removeClass("reprovado");
                        $elemEtapa.removeClass("aguardandoGestor");
                        $elemEtapa.removeClass("done");

                        if (etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaFinanceira(1);
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_PENDENCIA_ENDERECO_ATUAL)
                        {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaEndereco(2);
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_CREDITO) {

                            $("#rowBtnAprovarManualCred").hide();
                            $("#rowBtnGravarCancelarManualCred").hide();
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await Promise.all([
                                ]);

                                $("#iModal_ConsultaCredito").modal("show");

                            });
                        }
                        break;
                }
                @if (AcessoHelper.TemAcesso(ViewBag.Areas, "341"))
                {
                    <text>
                       $("#rowBtnAprovarPendenciaFinanceiraManual").removeClass("escondido").addClass("visivel");
                    </text>
                }
                @if (AcessoHelper.TemAcesso(ViewBag.Areas, "342"))
                {
                    <text>
                       $("#rowBtnAprovarPendenciaEnderecoManual").removeClass("escondido").addClass("visivel");
                    </text>
                }

                @*@if (!AcessoHelper.TemAcesso(ViewBag.Areas, "322"))
                {
                <text>
                    $elemEtapa.unbind("click");
                </text>
                }*@
            }

            let etapaAtual = $(".etapa-venda[data-etapa-atual]").data("etapa");

            if (etapaAtual === ETAPA_DADOS_GERAIS) {
                $("#btnProximo").show();
                $("#btnAnterior").hide();
                $("#btnGravar").hide();
            }
            else if (etapaAtual == ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL) {
                $("#btnGravar").hide();
                $("#btnAnterior").show();
                $("#btnProximo").show();
            }
            else if (etapaAtual == ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_NOVO) {
                $("#btnGravar").hide();
                $("#btnAnterior").show();
                $("#btnProximo").show();
            } else if (etapaAtual == ETAPA_CONSULTA_PENDENCIA_ENDERECO_ATUAL) {
                $("#btnGravar").hide();
                $("#btnAnterior").show();
                $("#btnProximo").show();
            }
            else if (etapaAtual == ETAPA_CONSULTA_CREDITO) {
                $("#btnGravar").hide();
                $("#btnAnterior").show();
                $("#btnProximo").show();
            }
            else if (etapaAtual == ETAPA_CHECKLIST) {
                $("#btnGravar").hide();
                $("#btnAnterior").show();
                $("#btnProximo").show();
            }
            else if (etapaAtual == ETAPA_TERMO_ADESAO) {

                @if (classBloqueioCampoFundoCinza)
                {
                    <text>
                        $("#btnGravar").hide();
                        $("#btnAnterior").hide();
                        $("#btnProximo").hide();
                    </text>
                }
                else {
                    <text>
                        $("#btnGravar").show();
                        $("#btnAnterior").show();
                        $("#btnProximo").hide();
                    </text>

                }
            }
            $("#divProgress").hide();
     }

    function initProgressBar() {

        $("#divProgress").show();

        $("#btnProximo").click(async function () {
                const $etapaAtual = $(".etapa-venda[data-etapa-atual]");
                const etapa = $etapaAtual.data("etapa");

                @* Verificando se o checklist foi preenchido ao gravar qualquer etapa que venha após a etapa do checklist *@
                if (etapa === ETAPA_CHECKLIST) {
                    const $etapaChecklist = $(`.etapa-venda[data-etapa='${ETAPA_CHECKLIST}']`);

                    const retorno = await $.ajax({
                        type: "GET",
                        url: "@CONSTANTES.URLPortal/api/ChecklistApi/ChecklistPreenchido?IdVenda=@Model.Id",
                        dataType: "json"
                    });

                    if (retorno != null && retorno.ok) {
                        const checklistPreenchido = retorno.objeto;

                        if (checklistPreenchido) {
                            $etapaChecklist.removeClass("aguardandoGestor");
                            $etapaChecklist.removeClass("reprovado");

                            $etapaChecklist.addClass("done");
                            $(`input[data-etapa=${ETAPA_CHECKLIST}][name$="Status"]`).val(STATUS_ETAPA_APROVADA);
                        }
                        else {
                            $etapaChecklist.removeClass("aguardandoGestor");
                            $etapaChecklist.removeClass("done");

                            $etapaChecklist.addClass("reprovado");
                            $(`input[data-etapa=${ETAPA_CHECKLIST}][name$="Status"]`).val(STATUS_ETAPA_REPROVADA);

                            let retornoAlterarStatus = await alterarStatusEtapaVenda(ETAPA_CHECKLIST, STATUS_ETAPA_REPROVADA);

                            if (!retornoAlterarStatus.ok) {
                                Notificar("@RsBase.ATENCAO_", "Erro ao gravar a etapa de checklist como reprovada", "warning");
                                $("#divProgress").hide();
                                return;
                            }
                        }
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", "Erro ao verificar o preenchimento do checklist", "warning");
                        $("#divProgress").hide();
                        return;
                    }
                }

                if (etapa === ETAPA_CONSULTA_CREDITO) {
                    let statusCredito = null;

                    let idConsultaCredito = null;

                    @if (Model.ClienteNovo.TipoPessoa == Tipo_Pessoa.Fisica)
                    {
                        <text>
                    let cpf = "@Model.ClienteNovo.CpfCnpj";
                    let cnpj = "";
                        </text>
                    }
                    else
                    {
                        <text>
                    let cpf = "";
                    let cnpj = "@Model.ClienteNovo.CpfCnpj";
                        </text>
                    }

                    const dadosConsultaCredito = await GetConsultaCredito(cpf, cnpj);

                    if (dadosConsultaCredito != null && dadosConsultaCredito.ok) {
                        if (dadosConsultaCredito.objeto.existeConsulta) {
                            idConsultaCredito = dadosConsultaCredito.objeto.idConsultaCredito;
                            statusCredito = dadosConsultaCredito.objeto.statusConsulta;
                        }
                        else {
                            try {
                                let dadosExecucao = await ExecutarConsultaCredito("@Model.ClienteNovo.CpfCnpj");

                                idConsultaCredito = dadosExecucao?.objeto;
                                statusCredito = await GetResultadosParametrosRestricao();
                            }
                            catch {
                                Notificar("@RsBase.ATENCAO_", "Erro ao executar a consulta de crédito para o cliente", "warning");
                                $("#divProgress").hide();
                                return;
                            }
                        }
                    }
                    else if (dadosConsultaCredito.mensagem != "CPF SEM TITULAR"){
                        Notificar("@RsBase.ATENCAO_", "CPF irregular, não é possível avançar com a venda.", "warning");
                        $("#divProgress").hide();
                        return;
                    }

                    if (statusCredito == "@Html.Raw(RsCadastros.REPROVADO)" || dadosConsultaCredito.mensagem == "CPF SEM TITULAR") {
                        if (CONSULTA_CREDITO_RESTRINGE_VENDA || dadosConsultaCredito.mensagem == "CPF SEM TITULAR") {
                            $("#resultadoconsulta").text("");

                            let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_REPROVADA, idConsultaCredito);

                            if (!retornoAlterarStatus.ok) {
                                Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de crédito como reprovada", "warning");
                            }

                            $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_REPROVADA);
                        }
                        else {
                            let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR, idConsultaCredito);

                            if (!retornoAlterarStatus.ok) {
                                Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de crédito para aguardando avaliação do gestor", "warning");
                            }

                            $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR);
                        }

                        $etapaAtual.unbind("click");
                        $etapaAtual.on("click", async function () {
                            $("#iModal_ConsultaCredito").modal("show");
                        });
                    }
                    else if (statusCredito == "@Html.Raw(RsCadastros.AGUARDA_AVALIACAO_GESTOR)") {
                        $("#resultadoconsulta").text("A proposta necessita de aprovação do gestor, clique no item para ver detalhes.");

                        $etapaAtual.unbind("click");
                        $etapaAtual.on("click", async function () {
                            $("#iModal_ConsultaCredito").modal("show");
                        });

                        let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR, idConsultaCredito);

                        if (!retornoAlterarStatus.ok) {
                            Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de crédito como aguardando aprovação do gestor", "warning");
                        }

                        $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR);
                    }
                    else if (statusCredito == "@Html.Raw(RsCadastros.APROVACAO_SEM_INSTALACAO)" || statusCredito == "@Html.Raw(RsCadastros.APROVACAO_COM_INSTALACAO)") {
                        let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_APROVADA, idConsultaCredito);

                        if (!retornoAlterarStatus.ok) {
                            Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de crédito para aprovado", "warning");
                        }

                        $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_APROVADA);
                    }
                    else if (statusCredito == "@Html.Raw(RsCadastros.APROVADO)") {
                        let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_APROVADA, idConsultaCredito);

                        if (!retornoAlterarStatus.ok) {
                            Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de crédito para aprovado", "warning");
                        }

                        $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_APROVADA);
                    }

                    ValidaSubmit(etapa);
                }
                else if (etapa === ETAPA_CONSULTA_PENDENCIA_ENDERECO_ATUAL) {

                    let logradouro = "";
                    let numero = "";
                    let cidade = "";
                    let cep = "";

                    @if (Model.EnderecoCobranca != null)
                    {
                        <text>
                        logradouro = @Html.Raw(Json.Encode(Model.EnderecoCobranca.Logradouro));

                        </text>
                    }

                    @if (Model.EnderecoCobranca != null)
                    {
                        <text>
                        numero = @Html.Raw(Json.Encode(Model.EnderecoCobranca.Numero));
                        </text>
                    }

                    @if (Model.EnderecoCobranca != null)
                    {
                        <text>
                            cidade =  @Html.Raw(Json.Encode(@Model.EnderecoCobranca.Cidade));
                        </text>
                    }

                    @if (Model.EnderecoCobranca != null)
                    {
                        <text>
                            cep =  @Html.Raw(Json.Encode(@Model.EnderecoCobranca.CEP));
                        </text>
                    }

                    if (logradouro === "" || logradouro === undefined) {
                        Notificar("@RsBase.ATENCAO_", "Preencha o logradouro do endereço de cobranca antes de fazer a consulta", "warning");
                        $("#divProgress").hide();
                        return;
                    }

                    if (numero === "" || numero === undefined) {
                        Notificar("@RsBase.ATENCAO_", "Preencha o número do endereço de cobrança antes de fazer a consulta", "warning");
                        $("#divProgress").hide();
                        return;
                    }

                    let possuiPendencia = false;
                    let idConsultaPendenciaEndereco = null;

                    const dadosConsultaPendenciaEndereco = await GetConsultaPendenciaEndereco(logradouro, numero);

                    if (dadosConsultaPendenciaEndereco != null && dadosConsultaPendenciaEndereco.ok) {
                        if (dadosConsultaPendenciaEndereco.objeto != null && dadosConsultaPendenciaEndereco.objeto.dados != null) {
                            idConsultaPendenciaEndereco = dadosConsultaPendenciaEndereco.objeto.idConsultaPendenciaEndereco;
                            possuiPendencia = dadosConsultaPendenciaEndereco.objeto.dados.length > 0;
                        }
                        else {

                            const result = await ExecutarConsultaPendenciaEndereco(logradouro, numero, cidade, cep);

                            if (result != null && result.ok && result.objeto != null) {
                                idConsultaPendenciaEndereco = result.objeto.idConsultaPendenciaEndereco;
                                possuiPendencia = result.objeto.possuiPendencia;
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", "Erro ao executar a consulta de pendência no endereço", "warning");
                                $("#divProgress").hide();
                                return;
                            }
                        }
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", "Erro ao verificar se já existe consulta de pendência no endereço", "warning");
                        $("#divProgress").hide();
                        return;
                    }

                    if (possuiPendencia) {
                        if (CONSULTA_PENDENCIA_ENDERECO_RESTRINGE_VENDA) {

                             $etapaAtual.removeClass("done");
                             $etapaAtual.removeClass("aguardandoGestor");
                             $etapaAtual.addClass("reprovado");

                            let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_REPROVADA, idConsultaPendenciaEndereco);

                            if (!retornoAlterarStatus.ok) {
                                Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de pendência no endereço como reprovada", "warning");
                            }

                            $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_REPROVADA);
                        }
                        else {
                             $etapaAtual.removeClass("done");
                             $etapaAtual.removeClass("reprovado");
                             $etapaAtual.addClass("aguardandoGestor");

                            let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR, idConsultaPendenciaEndereco);

                            if (!retornoAlterarStatus.ok) {
                                Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de pendência no endereço para aguardando avaliação do gestor", "warning");
                            }

                            $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR);
                        }
                    }
                    else {
                        let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_APROVADA, idConsultaPendenciaEndereco);

                        if (!retornoAlterarStatus.ok) {
                            Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de pendência no endereço como aprovada", "warning");
                        }

                        $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_APROVADA);
                    }

                    $etapaAtual.on("click", async function () {
                        await ExibirModalPendenciaEndereco();
                    });

                    ValidaSubmit(etapa);
                }
                else if (etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_NOVO) {
                    let possuiPendencia = false;
                    let idConsultaPendenciaFinanceira = null;

                    @if (Model.ClienteNovo.TipoPessoa == Tipo_Pessoa.Fisica)
                    {
                        <text>
                    let cpf = "@Model.ClienteNovo.CpfCnpj";
                    let cnpj = "";
                        </text>
                    }
                    else
                    {
                        <text>
                    let cpf = "";
                    let cnpj = "@Model.ClienteNovo.CpfCnpj";
                        </text>
                    }

                    const dadosConsultaPendenciaFinanceira = await GetConsultaPendenciaFinanceiraByCpfCnpj(cpf, cnpj);

                    if (dadosConsultaPendenciaFinanceira != null && dadosConsultaPendenciaFinanceira.ok) {
                        if (dadosConsultaPendenciaFinanceira.objeto != null && dadosConsultaPendenciaFinanceira.objeto.dados != null) {
                            idConsultaPendenciaFinanceira = dadosConsultaPendenciaFinanceira.objeto.idConsultaPendenciaFinanceira;
                            possuiPendencia = dadosConsultaPendenciaFinanceira.objeto.dados.length > 0;
                        }
                        else {
                            const result = await ExecutarConsultaPendenciaFinanceira(cpf, cnpj);

                            if (result != null && result.ok && result.objeto != null) {
                                idConsultaPendenciaFinanceira = result.objeto.idConsultaPendenciaFinanceira;
                                possuiPendencia = result.objeto.possuiPendencia;
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", "Erro ao executar a consulta de pendência financeira", "warning");
                                $("#divProgress").hide();
                                return;
                            }
                        }
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", "Erro ao verificar se já existe consulta de pendência financeira", "warning");
                        $("#divProgress").hide();
                        return;
                    }

                    if (possuiPendencia) {
                        if (CONSULTA_PENDENCIA_FINANCEIRA_RESTRINGE_VENDA) {
                            let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_REPROVADA, idConsultaPendenciaFinanceira);

                            if (!retornoAlterarStatus.ok) {
                                Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de pendência financeira como reprovada", "warning");
                            }

                            $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_REPROVADA);
                        }
                        else {
                            let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR, idConsultaPendenciaFinanceira);

                            if (!retornoAlterarStatus.ok) {
                                Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de pendência financeira para aguardando avaliação do gestor", "warning");
                            }

                            $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR);
                        }
                    }
                    else {
                        let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_APROVADA, idConsultaPendenciaFinanceira);

                        if (!retornoAlterarStatus.ok) {
                            Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de pendência financeira como aprovada", "warning");
                        }

                        $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_APROVADA);
                    }

                    $etapaAtual.on("click", async function () {
                        await ExibirModalPendenciaFinanceira(2);
                    });

                    ValidaSubmit(etapa);
                }
                else if (etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL) {
                    let possuiPendencia = false;
                    let idConsultaPendenciaFinanceira = null;

                    @if (Model.ClienteAtual.TipoPessoa == Tipo_Pessoa.Fisica)
                    {
                        <text>
                    let cpf = "@Model.ClienteAtual.CpfCnpj";
                    let cnpj = "";
                        </text>
                    }
                    else
                    {
                        <text>
                    let cpf = "";
                    let cnpj = "@Model.ClienteAtual.CpfCnpj";
                        </text>
                    }

                    const dadosConsultaPendenciaFinanceira = await GetConsultaPendenciaFinanceiraByCpfCnpj(cpf, cnpj);

                    if (dadosConsultaPendenciaFinanceira != null && dadosConsultaPendenciaFinanceira.ok) {
                        if (dadosConsultaPendenciaFinanceira.objeto != null && dadosConsultaPendenciaFinanceira.objeto.dados != null) {
                            idConsultaPendenciaFinanceira = dadosConsultaPendenciaFinanceira.objeto.idConsultaPendenciaFinanceira;
                            possuiPendencia = dadosConsultaPendenciaFinanceira.objeto.dados.length > 0;
                        }
                        else {
                            const result = await ExecutarConsultaPendenciaFinanceira(cpf, cnpj);

                            if (result != null && result.ok && result.objeto != null) {
                                idConsultaPendenciaFinanceira = result.objeto.idConsultaPendenciaFinanceira;
                                possuiPendencia = result.objeto.possuiPendencia;
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", "Erro ao executar a consulta de pendência financeira", "warning");
                                return;
                            }
                        }
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", "Erro ao verificar se já existe consulta de pendência financeira", "warning");
                        return;
                    }


                    if (possuiPendencia) {
                        if (CONSULTA_PENDENCIA_FINANCEIRA_RESTRINGE_VENDA) {
                            let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_REPROVADA, idConsultaPendenciaFinanceira);

                            if (!retornoAlterarStatus.ok) {
                                Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de pendência financeira como reprovada", "warning");
                            }

                            $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_REPROVADA);
                        }
                        else {
                            let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR, idConsultaPendenciaFinanceira);

                            if (!retornoAlterarStatus.ok) {
                                Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de pendência financeira para aguardando avaliação do gestor", "warning");
                            }

                            $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR);
                        }
                    }
                    else {
                        let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_APROVADA, idConsultaPendenciaFinanceira);

                        if (!retornoAlterarStatus.ok) {
                            Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de pendência financeira como aprovada", "warning");
                        }

                        $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_APROVADA);
                    }

                    $etapaAtual.on("click", async function () {
                        await ExibirModalPendenciaFinanceira(1);
                    });

                    ValidaSubmit(etapa);
                }
                else if (etapa === ETAPA_TERMO_ADESAO) {
                    await VerificarTermoAdesao();
                }
                else {
                    if (etapa !== ETAPA_CHECKLIST && etapa !== ETAPA_TERMO_ADESAO) {
                        $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_APROVADA);
                    }

                    ValidaSubmit(etapa);
                }

                @if (!AcessoHelper.TemAcesso(ViewBag.Areas, "322"))
                {
                <text>
                $etapaAtual.unbind("click");
                </text>
                }
            });


            async function VerificarTermoAdesao() {
                const $etapaTermoAdesao = $(`.etapa-venda[data-etapa='${ETAPA_TERMO_ADESAO}']`);

                const retorno = await $.ajax({
                    type: "GET",
                    url: "@CONSTANTES.URLPortal/api/TermoAdesaoApi/CheckTermoAssinadoTermo?idTroca=@Model.Id",
                    dataType: "json"
                });

                if (retorno != null && retorno.ok) {
                    const checkTermoAssinado = retorno.objeto;

                    if (checkTermoAssinado) {
                        $etapaTermoAdesao.removeClass("aguardandoGestor");
                        $etapaTermoAdesao.removeClass("reprovado");

                        $etapaTermoAdesao.addClass("done");
                        $(`input[data-etapa=${ETAPA_TERMO_ADESAO}][name$="Status"]`).val(STATUS_ETAPA_APROVADA);
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", "Termo de Adesão não foi assinado.", "warning");
                        return;
                    }
                }
                else {
                    Notificar("@RsBase.ATENCAO_", "Erro ao gravar a etapa de  Termo de Adesão", "warning");
                    return;
                }

                const etapaAtual = $(".etapa-venda[data-etapa-atual]").data("etapa");
                ValidaSubmit(etapaAtual, false);
            }

            $("#iGravarAprovarManualFin").click(async function () {

                let etapaaa = $(".etapa-venda[data-etapa-atual]").data("etapa");

                let etapaMudanca = etapaaa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL ? ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL : ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_NOVO;

                mudancaEtapaConsulta(etapaMudanca, STATUS_ETAPA_APROVADA_MANUALMENTE);

                if (!$("#iMotivoAprovManualFin").val()) {
                    Notificar("@RsBase.ATENCAO_", "Preencha o motivo para aprovação da consulta de pendência financeira", "warning");
                      HidePageLoading();
                      return;
                }

                 const requestAprovarViabilidade = {
                     IdTroca: @Model.Id,
                     etapa: etapaMudanca,
                     MotivoAprovacao: $("#iMotivoAprovManualFin").val()
                 };

                 let retornoMotivoAprovacao = await $.ajax({
                     type: "POST",
                     url: "@CONSTANTES.URLPortal/api/Vendaapi/AprovarEtapaManual",
                     dataType: "json",
                     data: requestAprovarViabilidade
                 });

                if (retornoMotivoAprovacao == null || !retornoMotivoAprovacao.ok) {
                    Notificar("@RsBase.ATENCAO_", retornoMotivoAprovacao.mensagem, "warning");
                    HidePageLoading();
                    return;
                }
                else {
                    Notificar("@RsBase.ATENCAO_", "Etapa aprovada manualmente com sucesso!", "success");
                    window.location.reload();
                    HidePageLoading();
                    $(`input[data-etapa=${etapaaa}][name$="Status"]`).val(STATUS_ETAPA_APROVADA_MANUALMENTE);
                    @*Atualiza a barra de progresso, aonde o ícone ficará com a cor azul*@
                    updateProgressBar();
                }
            });

            $("#iGravarAprovarManualEnd").click(async function (etapa) {
                mudancaEtapaConsulta(etapa, STATUS_ETAPA_APROVADA_MANUALMENTE);

                let etapaaa = $(".etapa-venda[data-etapa-atual]").data("etapa");

                let etapaMudanca = etapaaa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL ? ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL : ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_NOVO;

                if (!$("#iMotivoAprovManualEnd").val()) {
                    Notificar("@RsBase.ATENCAO_", "Preencha o motivo para aprovação da consulta de pendência endereço", "warning");
                    HidePageLoading();
                    $("#divProgress").hide();
                    return;
                }

                var url = `@CONSTANTES.URLPortal/api/Vendaapi/AprovarEtapaManual`;

                 const requestAprovar = {
                     IdTroca: @Model.Id,
                     etapa: etapaMudanca,
                     MotivoAprovacao: $("#iMotivoAprovManualEnd").val()
                };

                let retorno = await $.ajax({
                    type: "POST",
                    url: "@CONSTANTES.URLPortal/api/Vendaapi/AprovarEtapaManual",
                    dataType: "json",
                    data: requestAprovar
                });

                if (retorno != null && retorno.ok) {
                    Notificar("@RsBase.ATENCAO_", "Etapa aprovada manualmente com sucesso!", "success");
                    window.location.reload();
                    HidePageLoading();
                    $("#divProgress").hide();
                    updateProgressBar();

                } else {
                    Notificar("@RsBase.ATENCAO_", retorno.mensagem, "warning");
                }
            });

            $("#btnAnterior").click(async function () {
                const $etapaAtual = $(".etapa-venda[data-etapa-atual]");
                const etapaAtual = $etapaAtual.data("etapa");

                $etapaAtual.unbind("click");

                const elemEtapas = $(".etapa-venda").toArray();

                const idxEtapaAtual = elemEtapas.indexOf($etapaAtual[0]);

                const $novaEtapaAtual = $(elemEtapas[idxEtapaAtual - 1]);
                const novaEtapa = $novaEtapaAtual.data("etapa");

                const dataAtual = await alterarStatusEtapaVenda(etapaAtual, STATUS_ETAPA_PENDENTE);

                if (!dataAtual.ok) {
                    Notificar("@RsBase.ATENCAO_", "Erro ao gravar a etapa atual como pendente", "warning");
                }

                const dataAnterior = await alterarStatusEtapaVenda(novaEtapa, STATUS_ETAPA_PENDENTE);

                if (!dataAnterior.ok) {
                    Notificar("@RsBase.ATENCAO_", "Erro ao gravar a etapa anterior como pendente", "warning");
                }

                $novaEtapaAtual.attr("data-etapa-atual", "");
                $etapaAtual.removeAttr("data-etapa-atual");
                $etapaAtual.removeData("data-etapa-atual");

                $(`input[data-etapa=${etapaAtual}][name$="Status"]`).val(STATUS_ETAPA_PENDENTE);
                $(`input[data-etapa=${novaEtapa}][name$="Status"]`).val(STATUS_ETAPA_PENDENTE);

                $("#iEtapaAtualVenda").val($novaEtapaAtual.data("etapa"));

                updateProgressBar();
            });

            $("#btnGravar").click(async function () {

                const $etapaTermoAdesao = $(`.etapa-venda[data-etapa='${ETAPA_TERMO_ADESAO}']`);

                const retorno = await $.ajax({
                    type: "GET",
                    url: "@CONSTANTES.URLPortal/api/TermoAdesaoApi/CheckTermoAssinadoTroca?idTroca=@Model.Id",
                    dataType: "json"
                });

                if (retorno != null && retorno.ok) {
                    const checkTermoAssinado = retorno.objeto;

                    if (checkTermoAssinado) {
                        $etapaTermoAdesao.removeClass("aguardandoGestor");
                        $etapaTermoAdesao.removeClass("reprovado");

                        $etapaTermoAdesao.addClass("done");
                        $(`input[data-etapa=${ETAPA_TERMO_ADESAO}][name$="Status"]`).val(STATUS_ETAPA_APROVADA);
                    }
                    else {
                        $etapaTermoAdesao.removeClass("aguardandoGestor");
                        $etapaTermoAdesao.removeClass("done");

                        $(`input[data-etapa=${ETAPA_TERMO_ADESAO}][name$="Status"]`).val(STATUS_ETAPA_PENDENTE);

                        let retornoAlterarStatus = await alterarStatusEtapaVenda(ETAPA_TERMO_ADESAO, STATUS_ETAPA_PENDENTE);

                        if (!retornoAlterarStatus.ok) {
                            Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de Termo de Adesão como reprovada", "warning");
                            return;
                        }
                    }
                }
                else {
                    Notificar("@RsBase.ATENCAO_", "Erro ao gravar a etapa de  Termo de Adesão", "warning");
                    return;
                }

                const etapaAtual = $(".etapa-venda[data-etapa-atual]").data("etapa");
                ValidaSubmit(etapaAtual);
            })
        }

