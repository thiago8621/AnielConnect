    function GerarChecklist() {

        var checkSelecionado = $("#iChecklistCriar option:selected").val();

        if (checkSelecionado == null || checkSelecionado == "" || checkSelecionado == undefined) {
            Notificar("@RsBase.INFORMACAO", "Nenhum checklist foi selecionado", "info");
            return false;
        }

        const link = '@String.Format("{0}/{1}", CONSTANTES.URLPortal, "api/TrocaTitularidadeApi/AssociarChecklistTroca")';

        var request = {
            IdTroca : "@Model.Id",
            IdChecklist : checkSelecionado
        };

        $.ajax({
            url: link,
            method: 'POST',
            dataType: "json",
            data: request,
            beforeSend: function () {
                $("#divProgress").show();
            },
            complete: function () {
                $("#divProgress").hide();
            }
        }).done(function (response) {
            if (response.ok) {
                 Notificar("@RsBase.INFORMACAO", "Checklist foi associado a Troca de Titularidade.", "info");
            }
            else {
                Notificar("@RsBase.ATENCAO_", "Ausência de checklist válido para associação a Troca de Titularidade.", "warning");
            }
            $("#iModalChecklist").modal("hide");
        });
    }

    function CancelarTrocaTitularidade(id) {

        let idsSelecionados = [];
        idsSelecionados.push(id);

        let request = { ids: idsSelecionados };

        $.ajax({
            url: baseUrl + `/api/TrocaTitularidadeApi/Cancelar`,
            type: 'POST',
            dataType: 'json',
            data: request
        }).done(function (response) {
            if (!response.ok) {
                Notificar("ATENÇÃO", "Não foi possível cancelar a Troca de Titularidade", "warning")
            }
            else {
                window.location.reload();
            }
        });
    }

    function ConverterData(data) {

        let parts = data.split("/");

        let month = parseInt(parts[0]) - 1;
        let year = parseInt(parts[1]);

        let dateObject = new Date(year, month, 1);

        return dateObject;
    }

