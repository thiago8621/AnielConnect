    function RedirectsModal(value) {
        if (value == "0") {
            Swal.fire({
                html: `<h4><b>Deseja aprovar a troca de titularidade?</b></h4> <br/>
                   <p>Não será possível retornar essa ação</p>`,
                type: "question",
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#FF0000",
                confirmButtonText: "Sim",
                showCancelButton: true,
                cancelButtonText: "Não"
            }).then((result) => {
                if (result.value) {
                    AprovacaoSelects();
                }
            });
        }
        else if (value == "1") {
            Swal.fire({
                html: `<h4>Deseja Cancelar todas as Trocas de Titularidades selecionadas?</h4> <br/>
                   <p>Não será possível retornar essa ação</p>`,
                showCancelButton: true,
                confirmButtonText: "Sim",
                cancelButtonText: `Não`,
                type: "question",
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#FF0000"
            }).then((result) => {
                if (result.value) {
                    CancelarTrocaTitularidade("@Model.Id");
                }
            });
        }
        else if (value == "2") {
            Swal.fire({
                html: `<h4><b>Deseja visualizar o Termo de Adesão?</b></h4> <br/>`,
                type: "question",
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#FF0000",
                confirmButtonText: "Sim",
                showCancelButton: true,
                cancelButtonText: "Não"
            }).then((result) => {
                if (result.value) {
                    VisualizarTermoAdesao();
                }
            });
        }
        else if (value == "3") {
            Swal.fire({
                title: "Deseja reenviar o termo de adesão?",
                type: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não'
            }).then(async (result) => {
                if (result.value)
                    ReenviarTermoAdesao();
            });
        }
        else if (value == "4") {
            if ($.fn.DataTable.isDataTable("#datatableDocsAdesao")) {
                $("#datatableDocsAdesao").DataTable().clear().destroy();
                TableManageButtonsAdesao.init();
            }
            else {
                TableManageButtonsAdesao.init();
            }
            $("#iModalVisuTermoAdesao").modal("show");
        }
        else if (value == "5") {
            CopiarLinkTermoAdesao();
        }
        else if (value == "6") {
            Swal.fire({
                html: `<h4><b>Deseja reenviar o Checklist?</b></h4><br/>`,
                type: "question",
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#FF0000",
                confirmButtonText: "Sim",
                showCancelButton: true,
                cancelButtonText: "Não"
            }).then((result) => {
                if (result.value) {
                    ReenviarChecklist();
                }
            });
        }
        else if (value == "7") {
            Swal.fire({
                html: `<h4><b>Deseja visualizar/responder o checklist?</b></h4><br/>`,
                type: "question",
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#FF0000",
                confirmButtonText: "Sim",
                showCancelButton: true,
                cancelButtonText: "Não"
            }).then((result) => {
                if (result.value) {
                    VisualizarChecklist();
                }
            });
        }
        else if (value == "8") {
            AddSelect('iChecklistCriar', '@CONSTANTES.URLPortal/api/ChecklistApi/GetComboTipo',@CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false)
            $("#iModalChecklist").modal('show');
        }
        else if (value == "9") {
            Swal.fire({
                html: `<h4><b>Deseja criar um atendimento para este Cliente</b></h4> <br/>
                   <p>Não será possível retornar essa ação</p>`,
                type: "question",
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#FF0000",
                confirmButtonText: "Sim",
                showCancelButton: true,
                cancelButtonText: "Não"
            }).then((result) => {
                if (result.value) {
                    $("#iModalAtendimentoContrato").modal("show");
                }
            });
        }
        else {
            $("#iModalAtendimento").modal("show");
        }
    }

