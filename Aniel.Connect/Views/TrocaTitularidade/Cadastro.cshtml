    async function ExibirModalPendenciaEndereco() {
            $("#iModalPendenciaEndereco").modal("show");

            let logradouro = "";
            let numero = "";
            @if (Model.EnderecoCobranca != null)
            {
                <text>
                        logradouro = @Html.Raw(Json.Encode(Model.EnderecoCobranca.Logradouro));
                        numero = @Html.Raw(Json.Encode(Model.EnderecoCobranca.Numero));
                </text>
            }

            $("#iLogradouroValue").text(logradouro);

            const dadosConsultaPendenciaEndereco = await GetConsultaPendenciaEndereco(logradouro, numero);

            if (dadosConsultaPendenciaEndereco == null || !dadosConsultaPendenciaEndereco.ok) {
                Notificar("@RsBase.ATENCAO_", "Erro ao verificar a consulta de pendência no endereço", "warning");
                return;
            }


            var lsMotivos = [];
            let LISTATODOSSTATUSETAPAS = @Html.Raw(Json.Encode(Model.EtapasTroca));
            lsMotivos = LISTATODOSSTATUSETAPAS.filter(x => x.Status == 4 && x.Etapa == 3);

            let ultimoMotivo = null;
            if(lsMotivos.length > 0)
                ultimoMotivo = lsMotivos[0].MotivoAprovacaoManual;

            if(ultimoMotivo == null) {
                $("#iUltimoMotivoAprovacaoEnderecoValue").text("");
                $("#divIdMotivoEndereco").hide();
            } else {
                $("#iUltimoMotivoAprovacaoEnderecoValue").text(ultimoMotivo);
                $("#divIdMotivoEndereco").show();
            }

            if (dadosConsultaPendenciaEndereco.objeto.dados != null) {
                var flagCEP = dadosConsultaPendenciaEndereco.objeto.dados.filter(x => x.flagCEP == true).map(x => x.flagCEP);
                $("#divIdFlagCEP").hide();
                if (flagCEP.length > 0) {
                    $("#divIdFlagCEP").show();
                }
            }


            STATUS_CONSULTA_PENDENCIA_ENDERECO_ATUAL = "CONSULTA_REALIZADA";

            TableManageButtonsPendenciaEndereco.init();
        }

