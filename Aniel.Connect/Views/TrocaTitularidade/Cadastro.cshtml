            AddSelect("iDescBancoEditar", "@CONSTANTES.URLPortal/api/BancoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, dados.Id_Banco, "@RsBase.SELECIONE", false);

            $("#iAgenciaEditar").val(dados.Agencia);
            $("#iContaCorrenteEditar").val(dados.Conta_Corrente);
            $("#iDigitoEditar").val(dados.Digito);
