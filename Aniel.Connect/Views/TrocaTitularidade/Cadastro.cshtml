    $("#iExecutarConsultaPendenciaFinanceira").on("click", async function (tipo) {
            $("#divProgress").show();

            let cpf = "";
            let cnpj = "";

            if (tipo == 1) {
                @if (Model.ClienteAtual.TipoPessoa == Tipo_Pessoa.Fisica)
                {
                    <text>
                        cpf = "@Model.ClienteAtual.CpfCnpj";
                        cnpj = "";
                    </text>
                }
                else
                {
                    <text>
                        let cpf = "";
                        let cnpj = "@Model.ClienteAtual.CpfCnpj";
                    </text>
                }
            }
            else {
                @if (Model.ClienteNovo.TipoPessoa == Tipo_Pessoa.Fisica)
                {
                    <text>
                        cpf = "@Model.ClienteNovo.CpfCnpj";
                        cnpj = "";
                    </text>
                }
                else
                {
                    <text>
                        let cpf = "";
                        let cnpj = "@Model.ClienteNovo.CpfCnpj";
                    </text>
                }
            }

            const result = await ExecutarConsultaPendenciaFinanceira(cpf, cnpj);

            if (result == null || !result.ok) {
                $("#divProgress").hide();

                Notificar("@RsBase.ATENCAO_", "Erro ao executar a consulta de pendência financeira", "warning");
                return;
            }

            const possuiPendenciaFinanceira = result.objeto.possuiPendencia;

            if (possuiPendenciaFinanceira) {
                if (CONSULTA_PENDENCIA_FINANCEIRA_RESTRINGE_VENDA) {
                    STATUS_CONSULTA_PENDENCIA_FINANCEIRA = STATUS_ETAPA_REPROVADA;
                }
                else {
                    STATUS_CONSULTA_PENDENCIA_FINANCEIRA = STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR;
                }
                $("#resumoConsultaAprov").css({ color: "red" });
                $("#resumoConsultaAprov").text("Consulta reprovada, possui pendências financeiras");
            }
            else {
                STATUS_CONSULTA_PENDENCIA_FINANCEIRA = STATUS_ETAPA_APROVADA;

                let etapaaa = $(".etapa-venda[data-etapa-atual]").data("etapa");

                let etapaMudanca = etapaaa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL ? ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL : ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_NOVO;
                $("#resumoConsultaAprov").css({ color: "green" });
                $("#resumoConsultaAprov").text("Consulta aprovada!");


                mudancaEtapaConsulta(etapaMudanca, STATUS_CONSULTA_PENDENCIA_FINANCEIRA);
            }

            Notificar("@RsBase.INFORMACAO", "Consulta de pendência financeira concluída", "info");

            $("#divProgress").hide();
      });

