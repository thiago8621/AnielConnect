        /* progress bar*/
        /* progress bar*/

        .botcontrolebarraprogresso {
            margin-left: 127px;
            width: 56%;
        }

        .barraprogresso {
            padding: 1em 0;
            width: 100%;
            margin-left: 0px;
        }

            .barraprogresso ol {
                overflow: hidden;
                margin: 0;
                padding: 1em 0;
                list-style: none;
                line-height: 1.2;
                font-size: 1em;
                counter-reset: li;
                animation: chase 1s 1 forwards;
            }

            .barraprogresso li {
                float: left;
                display: inline;
                position: relative;
                counter-increment: li;
                width: 11%;
                text-align: center;
                color: #ccc;
                transition: all 0.5s ease;
                margin-left: 0px;
                font-size: 11px;
            }

                /* Contorno para o botão da etapa atual */
                .barraprogresso li[data-etapa-atual]:before {
                    content: counter(li);
                    position: relative;
                    background-color: #ccc;
                    color: #fff;
                    width: 50px;
                    height: 50px;
                    padding: 14px;
                    margin: 0 auto .5em;
                    border-radius: 100%;
                    font-size: 13px;
                    text-align: center;
                    display: block;
                    z-index: 2;
                    border: 2px solid #57aed1;
                    box-shadow: 0 0 2px 2px #fff;
                    background-image: linear-gradient(-45deg,rgba(255,255,255,0.15) 25%,transparent 25%,transparent 50%,rgba(255,255,255,0.15) 50%,rgba(255,255,255,0.15) 75%,transparent 75%,transparent);
                    background-repeat: repeat;
                    background-size: 20px 20px;
                }

                .barraprogresso li:before {
                    content: counter(li);
                    position: relative;
                    background-color: #ccc; /*#8bc53f*/ /*#ccc*/
                    color: #fff;
                    width: 50px;
                    height: 50px;
                    padding: 14px;
                    margin: 0 auto .5em;
                    border-radius: 100%;
                    font-size: 13px;
                    text-align: center;
                    display: block;
                    z-index: 2;
                    border: 1px solid #b3b3b3;
                    box-shadow: 0 0 2px 2px #fff;
                    background-image: linear-gradient(-45deg,rgba(255,255,255,0.15) 25%,transparent 25%,transparent 50%,rgba(255,255,255,0.15) 50%,rgba(255,255,255,0.15) 75%,transparent 75%,transparent);
                    background-repeat: repeat;
                    background-size: 20px 20px;
                    cursor: pointer;
                }

                .barraprogresso li:after {
                    content: "";
                    position: absolute;
                    width: 100%;
                    height: 10px;
                    display: block;
                    background: #ccc;
                    z-index: 1;
                    top: 50%;
                    left: 50%;
                    margin-top: -1.2em;
                    background-image: linear-gradient(-45deg,rgba(255,255,255,0.15) 25%,transparent 25%,transparent 50%,rgba(255,255,255,0.15) 50%,rgba(255,255,255,0.15) 75%,transparent 75%,transparent);
                    background-repeat: repeat-x;
                    background-size: 20px 20px;
                    /*  font-size: 13px;*/
                }

                .barraprogresso li.configVendedor {
                    float: left;
                    display: inline;
                    position: relative;
                    counter-increment: li;
                    width: 11%;
                    text-align: center;
                    color: #ccc;
                    transition: all 0.5s ease;
                    margin-left: 0px;
                    font-size: 11px;
                }

                    .barraprogresso li.configVendedor:after {
                        content: "";
                        position: absolute;
                        width: 100%;
                        height: 10px;
                        display: block;
                        background: #57AED1;
                        z-index: 1;
                        top: 50%;
                        left: 50%;
                        margin-top: -1.2em;
                        background-image: linear-gradient(-45deg,rgba(255,255,255,0.15) 25%,transparent 25%,transparent 50%,rgba(255,255,255,0.15) 50%,rgba(255,255,255,0.15) 75%,transparent 75%,transparent);
                        background-repeat: repeat-x;
                        background-size: 20px 20px;
                        /*  font-size: 13px;*/
                    }

                .barraprogresso li:first-child.active:after {
                    left: 50%;
                }

                .barraprogresso li:last-child:after {
                    display: none;
                }

                .barraprogresso li.done {
                    color: #8BC53F;
                }

                    .barraprogresso li.done:after {
                        width: 100%;
                        background-color: #57AED1;
                        animation: progress 0.3s linear 10;
                    }

                    .barraprogresso li.done:before {
                        background-color: #8BC53F;
                        border-color: #70a130;
                        color: white;
                        cursor: pointer;
                    }

                /*Aprovado manualmente*/
                .barraprogresso li.aprovadomanual {
                    color: #19AEEA;
                }

                    .barraprogresso li.aprovadomanual:after {
                        width: 100%;
                        background-color: #19AEEA;
                        animation: progress 0.3s linear 10;
                    }

                    .barraprogresso li.aprovadomanual:before {
                        background-color: #19AEEA;
                        border-color: #19AEEA;
                        color: white;
                        cursor: pointer;
                    }

                .barraprogresso li.active {
                    width: 20%;
                    font-weight: bold;
                    color: #57AED1;
                }

                    .barraprogresso li.active:after {
                        width: 100%;
                    }

                    .barraprogresso li.active:before {
                        background-color: #57AED1;
                        border: 2px solid #fff;
                        color: white;
                        box-shadow: 0 0 0 2px #57AED1;
