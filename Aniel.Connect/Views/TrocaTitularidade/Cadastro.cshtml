            url: `@CONSTANTES.URLPortal/api/PendenciaEnderecoIntegracaoApi/ExisteConsultaPendenciaEndereco?Logradouro=${logradouro}&Numero=${numero}`,
            type: 'GET',
            dataType: 'json'
