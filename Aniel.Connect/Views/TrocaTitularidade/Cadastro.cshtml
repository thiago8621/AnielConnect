    function SelecionaArquivo(id) {


            var files = $('#' + id)[0].files;
            var fileList = files;

            var numFiles = files.length;
            var erro = false;
            var tamanhoSuportado = 5;

            for (var i = 0; i < numFiles; i++) {
                var tamanhoFiles = files[i].size / 1024 / 1024; // in MB
                if (tamanhoFiles > tamanhoSuportado) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.BOT_ANEXO_IMAGEM)", "warning");
                    erro = true;
                    $(".anexarArquivo").val('');
                } else {
                    var nomeFiles = files[i].name;
                    var extensaoArquivo = '.' + nomeFiles.substring(nomeFiles.lastIndexOf('.') + 1);
                    var extensoesPermitidas = /(.jpeg|.jpg|.gif|.png|.bmp|.tiff|.jfif|.jif)$/i;
                    if (!extensoesPermitidas.exec(nomeFiles)) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.BOT_ANEXO_IMAGEM)", "warning");
                        erro = true;
                        $(".anexarArquivo").val('');
                    } else {

                        var inputFile = document.getElementById(id);

                        var ParamBase64 = new FormData();
                        ParamBase64.enctype = "multipart/form-data";
                        ParamBase64.append('arquivo', inputFile.files[0]);
                        ParamBase64.append('idLado', $("iLado").val());
                        ParamBase64.append('idTipoDoc', $("iTipoDocumento").val());
                        ParamBase64.append('status', $("iStatusAnexo").val());
                        ParamBase64.append('idTroca', '@Model.Id');
                        ParamBase64.append('ext', extensaoArquivo);

                        var xhr = new XMLHttpRequest();


                        xhr.onload = function () {
                            if (xhr.status === 200) {
                                // A resposta foi recebida com sucesso
                                $('#iModalAnexarTemoDoc').modal('hide');
                                $('#datatableDocsAdesao').DataTable().ajax.reload();
                            } else {
                                // Ocorreu um erro durante a requisição
                                console.log('Erro:', xhr.status);
                            }
                        };


                        var url = `@Url.Action("GravarAnexoAvulso", "Termo_Adesao")`;
                        xhr.open('POST', url);
                        xhr.send(ParamBase64);
                        $(".anexarArquivo").val('');
                    }
                }
            }

            if (erro) {
                clicked = false;
                return false;
            }
    }

    function AlterarStatusAnexo(status, idAnexo) {

            @if (!AcessoHelper.TemAcesso(ViewBag.Areas, "396"))
            {
                <text>
                Notificar("@RsBase.ATENCAO_", "@Html.Raw(RsBase.NAO_POSSUI_AREA_ACESSO)", "warning");
                return false;
                </text>
            }

            var texto = '';

            if (status == 2) {
                texto = 'Aprovar';
            } else if (status == 3) {
                texto = 'Reprovar';
            }

            Swal.fire({
                title: "Deseja " + texto + " o anexo?",
                type: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não'
            }).then(async (result) => {
                if (result.value) {
                    var link = `@CONSTANTES.URLPortal/api/TermoAdesaoApi/AlterarStatusDocTermo?status=${status}&idTrocaTitular=${@Model.Id}&idDocTermo=${idAnexo}`;

                    await $.ajax({
                        url: link,
                        type: 'POST',
                        dataType: 'json'
                    })
                        .done(function (data) {
                            if (data.ok) {
                                Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                                ShowPageLoading();
                                $('#datatableDocsAdesao').DataTable().ajax.reload(); // Sucesso = "S"

                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        });
                }
            });

        }

</script>

