                {
                    let descricaoEtapa = $(`input[data-etapa=${etapa}][name$="Descricao"]`).val();
                    let propostaParalisada = false;
                    switch (etapa) {
                        case @Html.Raw((int)EnumEtapaVenda.ConsultaViabilidade) :
                            if (CONSULTA_VIABILIDADE_RESTRINGE_VENDA)
                                propostaParalisada = true;
                            break;
                        case @Html.Raw((int)EnumEtapaVenda.ConsultaPendenciaEndereco):
                            if (CONSULTA_PENDENCIA_ENDERECO_RESTRINGE_VENDA)
                                propostaParalisada = true;
                            break;
                        case @Html.Raw((int)EnumEtapaVenda.ConsultaPendenciaFinanceira):
                            if (CONSULTA_PENDENCIA_FINANCEIRA_RESTRINGE_VENDA)
                                propostaParalisada = true;
                            break;

                        case @Html.Raw((int)EnumEtapaVenda.ConsultaCredito):
                            if (CONSULTA_CREDITO_RESTRINGE_VENDA)
                                propostaParalisada = true;
                            break;
                    }

                    if (propostaParalisada) {
                        Notificar("@RsBase.ATENCAO_", `A etapa ${descricaoEtapa} encontra-se reprovada! Comunique seu gestor`, "warning");
                        erro = true;
                    }
                }
            }

            if (erro) {
                clicked = false;
                $("#divProgress").hide();
                return false;
            }

            $('#form').submit();
    }

    async function GetConsultaPendenciaFinanceiraByCpfCnpj(cpf, cnpj) {
