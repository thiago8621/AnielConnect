    async function VincularTrocaAtendimento() {

        if (rows_Atendimento.length == 0) {
            Notificar("ATENCAO!", "Nenhum atendimento foi selecionado!", "warning")
            return false;
        }

        var request = {
            IdsAtendimento: rows_Atendimento,
            IdTroca: "@Model.Id",
        };

        await $.ajax({
            url: baseUrl + "/api/TrocaTitularidadeApi/VincularTrocaAtendimento",
            method: "POST",
            dataType: "json",
            data: request
        }).done(async (response) => {

            if (!response.ok)
                Notificar("ATENÇÃO!", response.mensagem, "warning")
            else {
                Notificar("SUCESSO", response.mensagem, "success")
                $("#iCarregarAtendimento").trigger("click");
            }
        });
    }

    async function alterarStatusEtapaVenda(etapa, status, idConsulta = "") {
            @* Atualização do status das consultas na view para identificar que já existe uma consulta registrada no sistema *@
            switch (etapa) {
                case ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_ATUAL:
                    STATUS_CONSULTA_PENDENCIA_FINANCEIRA = status;
                break;
                    case ETAPA_CONSULTA_PENDENCIA_FINANCEIRA_NOVO:
                    STATUS_CONSULTA_PENDENCIA_FINANCEIRA = status;
                    break;
                case ETAPA_CONSULTA_PENDENCIA_ENDERECO_ATUAL:
                    STATUS_CONSULTA_PENDENCIA_ENDERECO_ATUAL = status;
                    break;
                case ETAPA_CONSULTA_CREDITO:
                    STATUS_CONSULTA_CREDITO = status;
                    break;
            }

            const idTroca = @Html.Raw(Json.Encode(Model.Id));

            @* Se a venda já foi gravada, atualizamos o registro da etapa da venda no banco *@
            if (idTroca != 0) {
                let link = "";

                if (idConsulta) {
                    link = `@String.Concat(CONSTANTES.URLPortal, "/api/VendaApi/AlterarStatusEtapaVenda")?idVenda=0&Etapa=${etapa}&Status=${status}&IdConsulta=${idConsulta}&idTrocaTitular=${idTroca}`;
                }
                else {
                    link = `@String.Concat(CONSTANTES.URLPortal, "/api/VendaApi/AlterarStatusEtapaVenda")?idVenda=0&Etapa=${etapa}&Status=${status}&idTrocaTitular=${idTroca}`;
                }

                return await $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',
                    beforeSend: function () {
                        //ShowPageLoading();
                        $("#divProgress").show();
                    },
                    complete: function () {
                        //HidePageLoading();
                        $("#divProgress").hide();
                    }
                });
            }
            else {
                return {
                    ok: true
                }
            }
     }

