    async function ReenviarChecklist() {

        let verificarChecklist = true;

        await $.ajax({
            url: '@String.Concat(CONSTANTES.URLPortal, "/api/TrocaTitularidadeApi/VerificaExisteChecklist")?IdTroca=@Model.Id',
            method: 'POST',
            dataType: 'json',
            beforeSend: function () {
                ShowPageLoading();
            },
            complete: function () {
                HidePageLoading();
            }
        }).done(async function (response) {
            if (!response.ok) {
                verificarChecklist = false;
                Notificar("@RsBase.ATENCAO_", `${response.mensagem}`, "info");
            }
        });

        if (!verificarChecklist)
            return false;

         const data = await $.ajax({
             url: '@String.Concat(CONSTANTES.URLPortal, "/api/TrocaTitularidadeApi/EnviarEmailChecklistTroca")?IdTroca=@Model.Id',
             type: 'GET',
             dataType: 'json',
             beforeSend: function () {
                 ShowPageLoading();
             },
             complete: function () {
                 HidePageLoading();
             }
         });

         if (data.ok) {
             Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "Checklist enviado", "info");
         }
         else {
             Notificar("@RsBase.ATENCAO_", "Erro ao enviar o checklist - " + data.mensagem, "warning");
         }
    }

    async function VisualizarChecklist() {

        let verificado = true;

        await $.ajax({
            url: '@String.Concat(CONSTANTES.URLPortal, "/api/TrocaTitularidadeApi/VerificaExisteChecklist")?IdTroca=@Model.Id',
            method: 'POST',
            dataType: 'json',
            beforeSend: function () {
                ShowPageLoading();
            },
            complete: function () {
                HidePageLoading();
            }
        }).done(async function (response) {
            if (!response.ok) {
                Notificar("@RsBase.ATENCAO_", `${response.mensagem}`, "info");
                verificado = false;
            }
        });

        if (!verificado)
            return false;

        let urlChecklist = `@Url.Action("VisualizarChecklist", "TrocaTitularidade", new { troca = Model.Id })`;

        AddAba(urlChecklist, '@RsCadastros.CHECKLIST', 'tab123close');

    }

