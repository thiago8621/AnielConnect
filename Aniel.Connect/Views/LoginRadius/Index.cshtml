@model  Aniel.Connect.Models.LoginRadiusListaModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = RsCadastros.LISTAGEM_LOGIN_RADIUS;
    ViewBag.Sessao = RsCadastros.GERENCIAMENTO_REDE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />
    <style>

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }

        table#datatableLoginSemClientePlanoProduto {
            width: 100% !important;
        }

        #datatableLoginSemClientePlanoProduto tbody tr.odd:hover {
            background-color: #dee2e6;
            cursor: pointer;
        }

        #datatableLoginSemClientePlanoProduto tr.odd:hover td.sorting_1 {
            background-color: #dee2e6;
            cursor: pointer;
        }

        #datatableLoginSemClientePlanoProduto tbody tr.even:hover {
            background-color: #dee2e6;
            cursor: pointer;
        }

        #datatableLoginSemClientePlanoProduto tr.even:hover td.sorting_1 {
            background-color: #dee2e6;
            cursor: pointer;
        }
    </style>

}


@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

<script>
    var oDatatable = null;
    var rows_selected = [];

    const HandleCliente = () => {
        $('#iNomeCliente').unbind('select2:select select2:unselecting');
        $("#iNomeCliente").on('select2:select select2:unselecting', async (e) => {
            if (e.params._type == 'select')
            {
                EnableSelect("iClientePlanoProduto");

                let cliente = e.params.data;
                AddSelect("iClientePlanoProduto", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboVinculoLoginRadius", "@CONSTANTES.PaginacaoRegistros", null, cliente.id, null, "@RsBase.SELECIONE", false);
            }
            else
            {
                $('#iClientePlanoProduto').val("").trigger('change');
                DisableSelect("iClientePlanoProduto");
            }
        });
    };

    $(document).ready(() => {
        AddSelect("iNomeCliente", "@CONSTANTES.URLPortal/api/clienteapi/GetCombo", "@CONSTANTES.PaginacaoRegistros", null, null, null, "@RsBase.SELECIONE", false, HandleCliente);
        DisableSelect("iClientePlanoProduto");
    });

        function AlterarStatus(status, id_motivo_cancelamento, flagSuspensao) {
             if (rows_selected.length == 0) {
                 Notificar("@RsCadastros.ATENCAO", "Selecione um login", "warning");
             }
             else {
                 const link = "@CONSTANTES.URLPortal/api/PlanoProdutoapi/AlterarStatus"
                 const selectData = oDatatable.data().toArray().filter(p => rows_selected.includes(p.id))
                 var listaClientePPNULL = [];
                 for (var i = 0; i < selectData.length; i++) {
                     if (selectData[i].idClientePlanoProduto == null) {
                         listaClientePPNULL.push(selectData[i]);
                         selectData.splice(i, 1);
                     }
                 }

                 var idsClientePlanoProduto = selectData.map(p => p.idClientePlanoProduto);
                 var idsLogins = selectData.map(p => p.id);

                $.ajax({
                    url: link,
                    type: "POST",
                    dataType: "json",
                    data: {
                        ids: idsClientePlanoProduto,
                        Status: status,
                        id_motivo_cancelamento: id_motivo_cancelamento,
                        observacao_motivo_suspensao: $("#iMotivo_Observacao_Suspensao_Plano_Login_Outros").val(),
                        idsLogins: idsLogins
                    },
                    beforeSend: function () {
                        $("#divProgress").show();
                    },
                    complete: function () {
                        $("#divProgress").hide();
                    }
                })
                .done(async function (data) {
                    if (data.ok) {
                        if (listaClientePPNULL.length > 0) {
                            var txt = flagSuspensao == true ? "SUSPENSÃO" : "REATIVAÇÃO";
                            const result = await Swal.fire({
                                title: "Log de Login(s) não bloqueada!",
                                text: `Não é possível efetuar a ${txt} de um ou mais LOGIN(s), pois não possuem PLANO/PRODUTO vinculado. Deseja visualizar o LOG de Login(s) não bloqueados?`,
                                icon: 'question',
                                cancelButtonText: 'Não',
                                confirmButtonText: 'Sim',
                                showCancelButton: true,
                            });

                            if (result.value) {
                                $('#modal-LoginSemClientePlanoProduto').modal('show');
                                $("#datatableLoginSemClientePlanoProduto").length && $("#datatableLoginSemClientePlanoProduto").DataTable({
                                    dom: "Bfrti",
                                    data: listaClientePPNULL,
                                    paging: false,
                                    destroy: true,
                                    deferRender: true,
                                    scrollResize: true,
                                    buttons: [
                                        {
                                            extend: "excelHtml5",
                                            title: "LOG LOGIN",
                                            exportOptions: { orthogonal: "export" },
                                            messageTop: "Emitido por " + username + " em " + RetornaDataHoraAtual(),
                                            sheet_name: "Sinapse"
                                        }
                                    ],
                                    scrollX: true,
                                    columns: [
                                        { data: "login", title: "@RsCadastros.LOGIN" },
                                        { data: "pop", title: "@RsCadastros.POP" },
                                        { data: "olt", title: "@RsCadastros.OLT" },
                                        { data: "slot", title: "@RsCadastros.SLOT" },
                                        { data: "pon", title: "@RsCadastros.PON" }
                                    ]
                                });
                            }
                        }

                        //Quando login Radius não pôde ser bloqueado/desbloqueado.
                        if (data.mensagem != undefined && data.mensagem != null)
                            Notificar("@RsBase.INFORMACAO", data.mensagem, "warning");
                        else
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");

                        oDatatable.draw()
                    }
                    else {
                        Notificar("@RsCadastros.ATENCAO", data.mensagem, "warning")
                    }
                })
            }
        }

        function ExibirRelatorioConexao(idLogin) {
            ShowDialog(true, true, '@Html.Raw(RsCadastros.RELATORIO_CONEXAO)', '@Url.Action("RelatorioConexao", "Painel_Diagnosticos")' + '?Id_Login_Radius=' + idLogin, 'divRelatorioConexao', 900, 650, 'iframeRelatorioConexao');
        }

        function ExibirPainelDiagnostico(idLogin) {
            ShowDialog(true, true, '@Html.Raw(RsCadastros.PAINELDIAGNOSTICOS)', '@Url.Action("PainelDiagnosticoFrame", "Painel_Diagnosticos")' + '?Id_Login_Radius=' + idLogin, 'divPainelDiagnostico', 1200, 700, 'iframePainelDiagnostico');
        }

        function AcessoEquipamentoCliente(idLogin) {
            ShowDialog(true, true, '@Html.Raw(RsCadastros.ACESSO_EQUIPAMENTO_CLIENTE_HTTP)', '@Url.Action("AcessoEquipamentoCliente", "Painel_Diagnosticos")' + '?Id_Login_Radius=' + idLogin, 'divAcessarEquipamentoCliente', 700, 500, 'iframeAcessarEquipamentoCliente');
        }

        function ExibirModalAlteracaoIp(idLogin) {
            ShowDialog(true, true, '@Html.Raw(RsCadastros.ALTERAR_IP)', '@Url.Action("AlteracaoIP", "Painel_Diagnosticos")' + '?Id_Login_Radius=' + idLogin, 'divAlteracaoIp', 700, 500, 'iframeAlteracaoIp');

        }

        function AbrirProvisionamento() {
            AddAba("@Url.Action("AutorizarONU","EstruturaFibra")", "@RsCadastros.PROVISIONAMENTO");
        }

        function DesconectarLogin(idClientePlanoProduto) {
            $.ajax({
                url: "@CONSTANTES.URLPortal/api/IntegracaoRadiusApiController/DesconectarLogin",
                type: "POST",
                data: {
                    idClientePlanoProduto: idClientePlanoProduto
                },
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                }
            })
            .done(function (data) {
                if (data.result) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info")
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.message, "warning")
                }
            })
        }

        function NormalizarVelocidade(idClientePlanoProduto) {
            $.ajax({
                url: "@CONSTANTES.URLPortal/api/IntegracaoRadiusApiController/NormalizarVelocidade",
                type: "POST",
                data: {
                    idClientePlanoProduto: idClientePlanoProduto
                },
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                }
            })
            .done(function (data) {
                if (data.result) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info")

                    const data = oDatatable.data().toArray()
                    data.filter(p => p.idClientePlanoProduto == idClientePlanoProduto)[0].Velocidade_Reduzida = false

                    $("#divAcoesPlanosProdutos").hide()
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning")
                }
            })
        }
    function DesbloqueioConfianca(idClienteContrato) {
            $.ajax({
                url: "@CONSTANTES.URLPortal/api/clienteContratoapi/DesbloqueioConfianca",
                type: "POST",
                data: {
                    idClienteContrato: idClienteContrato
                },
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                }
            }).done(function (data) {
                if (data.message != undefined && data.message != null)
                    Notificar("@RsBase.INFORMACAO", data.message, "warning");
                else
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");

                oDatatable.draw()
            })


        }

        function ReduzirVelocidade(idClientePlanoProduto) {
            $.ajax({
                url: "@CONSTANTES.URLPortal/api/IntegracaoRadiusApiController/ReduzirVelocidade",
                type: "POST",
                data: {
                    idClientePlanoProduto: idClientePlanoProduto
                },
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                }
            })
            .done(function (data) {
                if (data.result) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info")

                    const data = oDatatable.data().toArray()
                    data.filter(p => p.idClientePlanoProduto == idClientePlanoProduto)[0].Velocidade_Reduzida = true

                    $("#divAcoesPlanosProdutos").hide()
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning")
                }
            })
        }

        $("#btnVelocidadeNormal").on('click', function (e) {
            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            const selectData = oDatatable.data().toArray().filter(p => rows_selected.includes(p.id));
            selectData.forEach(p => NormalizarVelocidade(p.idClientePlanoProduto));

            e.stopPropagation();
        });

        $("#btnDesbloqConf").on('click', function (e) {
            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            const selectData = oDatatable.data().toArray().filter(p => rows_selected.includes(p.id));
            selectData.forEach(p => DesbloqueioConfianca(p.idClienteContrato));

            e.stopPropagation();
        });

        $("#btnSusPlano").on('click', async function (e) {
            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
                 }

                if (rows_selected.length > 1) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.APENAS_UM_REGISTRO_PODE_SER_SELECIONADO", "info");
                    return;
                }

            const result = await Swal.fire({
                title: "Deseja suspender o plano?",
                text: "Atenção! Não será possível retornar essa ação. Deseja Continuar?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não'
            });

               if (result.value) {
                $("#iMotivo_Observacao_Suspensao_Plano_Login_Outros").val("");
                $('#iMotivo_Suspensao_Plano_Login_Outros').addClass('d-none');
                $('#iModal_Motivo_Suspender_Plano_Login').modal({ backdrop: 'static', keyboard: false });
                AddSelect("iMotivo_Suspensao_Plano_Login", "@CONSTANTES.URLPortal/api/Motivo_Suspensao_ContratualApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, 2, null, "@RsBase.SELECIONE", false);
                $("#btnMotivoSuspensaoPlano_Login").off("click").on("click", function (e) {
                    if (($("#iMotivo_Suspensao_Plano_Login").val() > 0) || ($("#iMotivo_Observacao_Suspensao_Plano_Login_Outros").val() != "" && $("#iMotivo_Suspensao_Plano_Login").val() == -1)) {
                        AlterarStatus(4, $("#iMotivo_Suspensao_Plano_Login").val(), true);
                    } else {
                        Notificar("@RsBase.ATENCAO_", "Para efetuar a suspensão, é necessário selecionar o motivo!", "warning");
                        return false;
                    }
                    $('#iModal_Motivo_Suspender_Plano_Login').modal('hide');
                });

            }
            e.stopPropagation();
        });

    $('#iMotivo_Suspensao_Plano_Login').change(function (e) {
        var id = e.target.value;
        if (id == "-1") {
            $('#iMotivo_Suspensao_Plano_Login_Outros').removeClass('d-none');
        } else {
            $('#iMotivo_Suspensao_Plano_Login_Outros').addClass('d-none');
            $("#iMotivo_Observacao_Suspensao_Plano_Login_Outros").val("");
        }
    });

        $("#btnReativarPlano").off("click").on('click', function (e) {

             if (rows_selected.length == 0) {
                     Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                     return;
             }

              if (rows_selected.length > 1) {
                  Notificar("@RsBase.ATENCAO_", "@RsBase.APENAS_UM_REGISTRO_PODE_SER_SELECIONADO", "info");
                  return;
              }

             AlterarStatus(2, null, false);

             e.stopPropagation();
         });

        $("#btnReduzirVelocidade").on('click', function (e) {
            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            const selectData = oDatatable.data().toArray().filter(p => rows_selected.includes(p.id));
            selectData.forEach(p => ReduzirVelocidade(p.idClientePlanoProduto));

            e.stopPropagation();
        });

        $('#btnAlterarIp').on('click', function (e) {
            if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                if (rows_selected.length > 1) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.APENAS_UM_REGISTRO_PODE_SER_SELECIONADO", "info");
                    return;
            }

            var id_login = rows_selected[0];
            ExibirModalAlteracaoIp(id_login);

            e.stopPropagation();
        });

        $('#btnPainelDiagnostico').on('click', function (e) {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                if (rows_selected.length > 1) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.APENAS_UM_REGISTRO_PODE_SER_SELECIONADO", "info");
                    return;
                }

                var id_login = rows_selected[0];
                ExibirPainelDiagnostico(id_login);

                e.stopPropagation();
            });

        $('#btnEquipamentoCliente').on('click', function (e) {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                if (rows_selected.length > 1) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.APENAS_UM_REGISTRO_PODE_SER_SELECIONADO", "info");
                    return;
                }

                var id_login = rows_selected[0];
                AcessoEquipamentoCliente(id_login);

                e.stopPropagation();
            });

        $('#btnRelatorioConexao').on('click', function (e) {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                if (rows_selected.length > 1) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.APENAS_UM_REGISTRO_PODE_SER_SELECIONADO", "info");
                    return;
                }

                var id_login = rows_selected[0];
                ExibirRelatorioConexao(id_login);

                e.stopPropagation();
        });

        $("#btnDesconectarLogin").on('click', function (e) {
            if (rows_selected.length == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                return;
            }

            const selectData = oDatatable.data().toArray().filter(p => rows_selected.includes(p.id));
            //selectData.forEach(p => DesconectarLogin(p.idClientePlanoProduto));
            selectData.forEach(function (p) {
                if (p.status === "Ativo") {
                    DesconectarLogin(p.idClientePlanoProduto);
                }
                else {
                    Notificar("@RsBase.ATENCAO_", "Login já está desconectado ou inativo: " + p.login, "warning");
                }
            });

            e.stopPropagation();
        });

        var handleDataTableButtons = function () {
            "use strict";

            //"Blfrtip"
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                //processing: true,
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                ajax: {
                    url: baseUrl + '/api/LoginRadiusapi/GetAll',
                    type: 'POST',
                    data: function (data) {
                        var id_olt = $("#iOlt").val();

                        if ($("#iOlt option:selected").val() == "Selecione")
                            id_olt = null;

                        let cliente = $("#iNomeCliente").val();
                        let planoProduto = $("#iClientePlanoProduto").val();

                        data.Id_Olt = id_olt;
                        data.Id_Cliente = cliente;
                        data.Id_ClientePlanoProduto = planoProduto;
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                preDrawCallback: function () {
                    $("#divProgress").show();
                },
                drawCallback: function () {
                    $("#divProgress").hide();
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    {
                        data: "status",
                        title: "@RsFinanceiro.STATUS",
                        render: function (data, type, row, meta) {
                            return `<i class="fas fa-circle" style="vertical-align: middle; font-size: 16px; margin-top: -2px;color:${data === "Ativo" ? "green" : "red"}"></i>  ${data}`
                        }
                    },                    
                    { data: "login", title: "@RsCadastros.LOGIN" },
                    { data: "cliente", title: "@RsCadastros.CLIENTE" },
                    { data: "pop", title: "@RsCadastros.POP" },
                    { data: "olt", title: "@RsCadastros.OLT" },
                    { data: "slot", title: "@RsCadastros.SLOT" },
                    { data: "pon", title: "@RsCadastros.PON" },
                    @*{ data: "caixa_FTTH", title: "@RsCadastros.CAIXA_FTTH" },*@
                    @*{ data: "porta_FTTH", title: "@RsCadastros.PORTA_FTTH" },*@
                ]
            });          

            $("#iPesquisar").on("click", function () {
                $("#modal-filter").modal('hide');
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();

                return true;
            });

            $("#iLimparFiltroModal, #iLimparFiltro").on('click', function () {
                rows_selected = [];
                $('#txtSearch').val('');
                $('#iOlt').val('').trigger('change');
                $('#iNomeCliente').val("").trigger('change');
                $('#iClientePlanoProduto').val("").trigger('change');
                
                oDatatable.search($('#txtSearch').val()).draw();
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            $('#datatable tbody').on('click', 'tr', function () {
                 if (oDatatable.row(this).data() != null) {
                     var _id = oDatatable.row(this).data().id;

                     var url = '@Url.Action("Cadastro", "LoginRadius", new { id = "__id__" })';
                     window.location.href = url.replace('__id__', _id);
                     $("#divProgress").show();
                 }
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                 ShowPageLoading();
                updateDataTableSelectAllCtrl(oDatatable);
                stopPageLoading();
            });
        }

        var TableManageButtons = {
            init: function () {
                handleDataTableButtons();
            }
        }

        TableManageButtons.init();
    
    $('#txtSearch').keyup(function () {
        ShowPageLoading();
        rows_selected = [];
        oDatatable.search($(this).val()).draw();        
    });
    $('#iSearchLogin').off('click');
    $('#iSearchLogin').on("click", function () {
        rows_selected = [];        
        oDatatable.search($('#txtSearch').val()).draw();
    });
</script>
}


