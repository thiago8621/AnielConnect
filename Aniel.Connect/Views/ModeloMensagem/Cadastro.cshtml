@model Aniel.Connect.Models.ModeloMensagemCadastroModel
@using Resources
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Sinapse.Model.enumerados


@{
    /**/

    ViewBag.Title = RsCadastros.CADASTRO_MOD_MENSAGEM;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;

}


@section styles{
    <style>
        .status-label {
            display: inline-block;
            padding: 1px;
            border-radius: 0.25rem;
            text-align: center;
        }

        .status-aprovado {
            background-color: #28a745; /* Verde médio */
            color: #ffffff; /* Branco */
            border: 1px solid #1e7e34; /* Verde escuro */
        }

        .status-rejeitado {
            background-color: #dc3545; /* Vermelho médio */
            color: #ffffff; /* Branco */
            border: 1px solid #bd2130; /* Vermelho escuro */
        }

        .status-pausado {
            background-color: #ffc107; /* Amarelo médio */
            color: #212529; /* Preto suave */
            border: 1px solid #e0a800; /* Amarelo escuro */
        }

        .status-pendente {
            background-color: #6c757d; /* Cinza médio */
            color: #ffffff; /* Branco */
            border: 1px solid #545b62; /* Cinza escuro */
        }
    </style>
}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>

    AddSelect("IdWhatsAppBusinessIdentificacao", "@CONSTANTES.URLPortal/api/Canal_ComunicacaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdWhatsAppBusinessIdentificacao", "@RsBase.SELECIONE", false);

        //Não é permitido acentuações, espaços e letras maiúsculas nos nomes dos modelos
        function validateDescricao(input) {
            input.value = input.value.toLowerCase();
            input.value = input.value.replace(/\s/g, '_');
            input.value = input.value.replace(/[^a-z0-9_]/g, '');

            if (input.value.length > 512) {
                input.value = input.value.substring(0, 512);
            }
        }

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

	        if (erro) {
                clicked = false;
                return false;
            }


            if (@Json.Encode(AcessoHelper.TemAcesso(_areas, "397"))) {
                ShowPageLoading();
                $('#form').submit();
                return true;
                $("#btnsalvar").prop("href", "@Url.Action("Index", "ModeloMensagem")");
            }

        }

        $(document).ready(function () {
            const $statusElement = $("#iStatus");
            const statusValue = $statusElement.text().trim();

            let statusClass = "";
            switch (statusValue) {
                case "Aprovado":
                    statusClass = "status-aprovado";
                    break;
                case "Rejeitado":
                    statusClass = "status-rejeitado";
                    break;
                case "Pausado":
                    statusClass = "status-pausado";
                    break;
                case "Pendente":
                    statusClass = "status-pendente";
                    break;
                default:
                    statusClass = "status-pendente";
            }
            $statusElement.addClass(statusClass);

            if (statusValue === "") {
                $("#divStatusModelo").hide();
            } else {
                $("#divStatusModelo").show();
            }

        });


</script>
}


@using (Html.BeginForm("Cadastro", "ModeloMensagem", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @*@Html.HiddenFor(model => model.Id)*@
    @Html.HiddenFor(model => model.Codigo, new { @id = "iCodigo" })

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-code-branch"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "ModeloMensagem")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_MOD_MENSAGEM</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>



                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0 d-flex align-items-center">
                            <span class="text-bold-card">@ViewBag.Title</span>
                            <label for="iModeloPadraoWhatsApp" class="mb-0 ml-3">
                                <i class="fas fa-question-circle fa-1x" style="color: #2092EC" data-toggle="popover" data-html="true"
                                   title="Modelo Padrão de Mensagem do WhatsApp Business"
                                   data-content="<div style='font-size: 10px'>
                    <span class='p-3'>• É possível editar somente os modelos com status APROVADO, REJEITADO ou PAUSADO.</span><br />
                    <span class='p-3'>• Os modelos aprovados podem ser editados até 10 vezes dentro de 30 dias ou uma vez dentro de 24 horas. Não há restrição para o número de edições de modelos rejeitados ou pausados.</span><br />
                    <span class='p-3'>• Depois de editar um modelo aprovado ou pausado, ele será aprovado automaticamente, a não ser que seja reprovado na análise do modelo.</span><br />
                    <span class='p-3'>• Este modelo será enviado para o usuário todas as vezes que o atendente assumir a conversa fora do ciclo de 24 horas.</span><br />
                    </div>">
        </i>
                            </label>
                        </h5>

                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="iCodigo">@RsCadastros.CODIGO:</label>
                                        @Html.TextBoxFor(model => model.Id, new { @class = "form-control", @id = "iCodigo", @autocomplete = "off", @Maxlength = 100, @readonly = "readonly" })
                                        @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        <label for="iDescricao">@RsCadastros.NOME:</label>
                                        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao", @autocomplete = "off", @maxlength = "512", @oninput = "validateDescricao(this)" })
                                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        <label for="iTexto">@RsCadastros.TEXTO:</label>
                                        @Html.TextAreaFor(model => model.Texto, new { @class = "form-control", @id = "iTexto", @autocomplete = "off", @maxlength = "1024" })
                                        @Html.ValidationMessageFor(model => model.Texto, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div id="divStatusModelo" class="form-group" style="display: none;">
                                        <label for="iStatus">@RsCadastros.STATUS:</label>
                                        <div>
                                            <span id="iStatus" class="status-label">
                                                @Model.Status
                                            </span>
                                        </div>
                                    </div>


                                    <div class="form-group">
                                        <label for="IdWhatsAppBusinessIdentificacao">@RsCadastros.NUMERO_ID_WHATSAPP_BUSINESS:</label>
                                        <select class="form-control" id="IdWhatsAppBusinessIdentificacao" name="IdWhatsAppBusinessIdentificacao">
                                        </select>
                                        @Html.ValidationMessageFor(model => model.IdWhatsAppBusinessIdentificacao, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>




                </div>



            </div>


        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "ModeloMensagem")" class="float-cancel" onclick="ShowPageLoading(); return true;">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar" id="btnsalvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>


    </div>

}