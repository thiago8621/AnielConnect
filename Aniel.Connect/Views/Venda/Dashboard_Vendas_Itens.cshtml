@model Aniel.Connect.Models.Dashboard_Vendas_ItemListModel

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers

@{
    ViewBag.Title = RsCadastros.DASHBOARD_VENDA;
    ViewBag.Sessao = RsCadastros.VENDEDOR;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")

}


@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>


          var oDatatable;

        function MostrarPlanosProdutos(Id) {

            ShowDialog(true, true, 'Planos e Produtos', "@Url.Action("Dashboard_Vendas_Itens", "Venda")" + "?id=" + Id, 'divPlanosProdutos', 620, 450, 'iframePlanosProdutos', function () {
                try {
                    setTimeout(function () {
                        oDatatable.draw();
                    }, 500);


                }
                catch {
                    setTimeout(function () {
                        oDatatable.draw();
                    }, 500);
                }
            });

        }



            "use strict";

        oDatatable = $("#datatable").length && $("#datatable").DataTable({
            dom: "Bfrti",

            select: {
                style: 'multi'
            },
            order: [[1, 'asc']],
            serverSide: true,
            searching: true,
            ordering: true,
            paging: true,
            deferRender: true,
            scrollY: '73vh',
            scroller: {
                loadingIndicator: true,
                rowHeight: 40,
                boundaryScale: 0.5,
                displayBuffer: 3
            },
            stateSave: true,
            scrollX: true,
            fixedHeader: true,
            initComplete: dataTableInitComplete,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
            ajax: {
                url: baseUrl + '/api/Vendaapi/Dashboard_Vendas_Item',
                type: 'POST',
                data: function (data) {

                    data.Id_Funcionario = @Model.Id_Funcionario ;

                },
                error: function (e) {
                    console.log(e);
                },
                dataSrc: function (d) {
                    return d.data;
                }
            },
            infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                var str = "@RsCadastros.INFODATATABLE";
                if (iTotal == 0) { iEnd = 0; iStart = 0; }
                str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                $("#dtLegend").html(str);

                return "";
            },
            pageLength: 10,
            language: traducaoDataTableSimples,
            buttons: buttonsDataTable,
            columns: [
                { data: "nome_Plano_Produto", title: "@RsCadastros.PLANO_PRODUTO" },
                { data: "nome_Campanha", title: "@RsCadastros.CAMPANHA" },
                { data: "pontos", title: "@RsCadastros.PONTOS" },
                { data: "valor_Dinheiro", title: "@RsCadastros.VALOR" }
            ]
        });


        $('#datatable tbody').on('click', 'tr', function () {

            if (oDatatable.row(this).data() != null) {

                var _id = oDatatable.row(this).data().id;


                MostrarPlanosProdutos(_id);

            }

        });

    </script>
}


<div style="padding:10px;">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>




<div id="divFuncionario"></div>