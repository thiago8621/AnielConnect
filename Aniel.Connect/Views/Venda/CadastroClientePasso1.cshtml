@model Aniel.Connect.Models.Cliente_ProspectoPasso1ViewModel
@using Aniel.Connect.Core.Helpers
@using Sinapse.Model.enumerados;

@{
    ViewBag.Title = RsCadastros.VALIDACAO_CLIENTE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{

}

@section scripts
{



}

@if (ViewData.ModelState.Any(x => x.Value.Errors.Any()))
{
    <script type="text/javascript">

            $(document).ready(function () {

                var erros = @HtmlExtensions.GetStringToast(Html.ValidationSummary());
                var i;
                for (i = 0; i < erros.length; i++) {
                    Notificar("Atenção!", erros[i], "warning");
                }
            });
    </script>


    <script src="~/bin/Scripts/valida_cpf_cnpj.js"></script>

    <script>
        $(document).ready(function () {

            $("#iTipoPessoa").on("change", function () {
                var tipo = $("#iTipoPessoa option:selected").val();
                if (tipo == "0" || tipo == "2") {
                    $("#divPessoaJuridica").css("display", "none");
                    $("#iCNPJ").val("");
                    $("#iNascimento").val("");
                    $("#divPessoaFisica").css("display", "flex");
                    $("#iCPF").focus();
                }
                else {
                    $("#divPessoaJuridica").css("display", "flex");
                    $("#divPessoaFisica").css("display", "none");
                    $("#iCPF").val("");
                    $("#iCNPJ").focus();
                }

            });

            $('#iCPF').focusout(FormataCPF);

            $('#iCNPJ').focusout(FormataCNPJ);

            $('#iNascimento').focusout(ValidaData);

            //$("#iCPF").mask("000.000.000-00", { reverse: true });
            //$("#iCNPJ").mask("00.000.000/0000-00", { reverse: true });


            $("#iCPF").focus();
        });

        // Click do botão validar do CNPJ
        function validaCNPJ() {

            if (!$("#iCNPJ").val()) {

                Notificar("Atenção", "Informe dados válidos", "warning");

                return false;
            }

            parent.App.startPageLoading();

            return true;
        }

        // Click do botão validar do CPF
        function validaCPF() {

            if ((!$("#iCPF").val()) || (!$("#iNascimento").val())) {

                Notificar("Atenção", "Informe dados válidos", "warning");

                return false;
            }

            parent.App.startPageLoading();

            return true;
        }

        //Click do botão gravar
        function validaCPFCNPJ() {

            if ($("input[type=radio][name=TipoPessoa]").val() == "Fisica") {
                return validaCPF();
            }
            else {
                return validaCNPJ();
            }

            parent.App.startPageLoading();
        }


    </script>



}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page"><i class="fas fa-user"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Cliente")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELCLIENTES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>
                        <span style="font-size:11px;margin-left: 15px;" id="dtLegend"></span>
                    </div>

                </div>

                <div id="accordion">
                    <div class="card div-card-accord">
                        <div class="card-header title-card" id="heading-1">
                            <h5 class="mb-0">
                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                    <span class="text-bold-card">Validação</span>
                                </a>
                            </h5>
                        </div>
                        <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                            <div class="card-body body-card-accord">
                                <div class="form-group panel">
                                    <h5>@RsCadastros.TIPOPESSOA</h5>
                                    <label>Tipo de Pessoa:</label>
                                    @Html.EnumDropDownListFor(m => m.TipoPessoa, new { @class = "form-control col-sm-2", @id = "iTipoPessoa", @autocomplete = "off" })

                                    @*<label for="iFisico">@RsCadastros.FISICA</label>
                                        @Html.RadioButtonFor(m => m.TipoPessoa, Tipo_Pessoa.Fisica)

                                        <label for="iJuridico">@RsCadastros.JURIDICA</label>
                                        @Html.RadioButtonFor(m => m.TipoPessoa, Tipo_Pessoa.Juridica)*@

                                </div>
                                <div class="row" id="divPessoaFisica" style="display:@(Model.TipoPessoa == Tipo_Pessoa.Fisica ? "flex" : "none" )">
                                    <div class="col-sm-3">
                                        @Html.LabelFor(model => model.CPF, htmlAttributes: new { @For = "iCPF" })
                                        @Html.TextBoxFor(m => m.CPF, new { @id = "iCPF", @placeholder = "Informe o CPF", @class = "form-control cpf", @autocomplete = "off" })
                                    </div>
                                    <div class="col-sm-2">
                                        @Html.LabelFor(model => model.DataNascimento, htmlAttributes: new { @For = "iNascimento" })
                                        @Html.TextBoxFor(m => m.DataNascimento, new { @class = "form-control datepicker", @data_provide = "datepicker", @id = "iNascimento", @autocomplete = "off" })
                                    </div>
                                    <div class="col-sm-2" style="padding-top:19px;">
                                        <button type="submit" id="iValidar" class="btn btn-primary" name="validar" onclick="return validaCPF()">Validar</button>
                                    </div>
                                </div>
                                <div class="row" id="divPessoaJuridica" style="display:@(Model.TipoPessoa == Tipo_Pessoa.Juridica ? "flex" : "none" )">
                                    <div class="col-sm-3">
                                        @Html.LabelFor(model => model.CNPJ, htmlAttributes: new { @For = "iCNPJ" })
                                        @Html.TextBoxFor(m => m.CNPJ, new { @id = "iCNPJ", @placeholder = "Informe o CNPJ", @class = "form-control cnpj", @autocomplete = "off" })
                                    </div>
                                    <div class="col-sm-2" style="padding-top:19px;">
                                        <button type="submit" id="iValidar" class="btn btn-primary" name="validar" onclick="return validaCNPJ()">Validar</button>
                                    </div>
                                </div>

                                @if (!String.IsNullOrEmpty(ViewBag.Erro))
                                {
                                    <div class="alert alert-warning mt-3" role="alert">
                                        <div class="p-3">
                                            <span class="text-bold-card">@RsBase.ERROR :</span> @ViewBag.Erro <br />
                                        </div>
                                    </div>
                                }
                                else if (Model.retornoCPF != null)
                                {
                                    if (Model.retornoCPF.retorno == "OK")
                                    {
                                        <div class="alert @((Model.retornoCPF.result.situacao_cadastral == "REGULAR") ? "alert-info" : "alert-warning") mt-3" role="alert">
                                            <div class="p-3">
                                                <span class="text-bold-card">@RsCadastros.NUMERODECPF :</span> @Model.retornoCPF.result.numero_de_cpf <br />
                                                <span class="text-bold-card">@RsCadastros.NOMEDAPF :</span> @Model.retornoCPF.result.nome_da_pf <br />
                                                <span class="text-bold-card">@RsCadastros.DATANASCIMENTO :</span> @Model.retornoCPF.result.data_nascimento <br />
                                                <span class="text-bold-card">@RsCadastros.SITUACAOCADASTRAL :</span> @(String.IsNullOrEmpty(Model.retornoCPF.result.situacao_cadastral) ? RsBase.RECEITA_DADOSNAOCONFEREM : Model.retornoCPF.result.situacao_cadastral)  <br />
                                                <span class="text-bold-card">@RsCadastros.DATAINSCRICAO :</span> @Model.retornoCPF.result.data_inscricao <br />
                                                <span class="text-bold-card">@RsCadastros.DIGITOVERIFICADOR :</span> @Model.retornoCPF.result.digito_verificador <br />
                                                <span class="text-bold-card">@RsCadastros.COMPROVANTEEMITIDO :</span> @Model.retornoCPF.result.comprovante_emitido <br />
                                                <span class="text-bold-card">@RsCadastros.COMPROVANTEEMISSAODATA :</span> @Model.retornoCPF.result.comprovante_emitido_data <br />
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning mt-3" role="alert">
                                            <div class="p-3">
                                                <span class="text-bold-card">@RsCadastros.MENSAGEM_ERRO_RECEITA</span>
                                            </div>
                                        </div>
                                    }
                                }
                                else if (Model.retornoCNPJ != null)
                                {
                                    if (Model.retornoCNPJ.retorno == "OK")
                                    {

                                        <div class="alert @((Model.retornoCNPJ.result.situacao == "ATIVA") ? "alert-info" : "alert-warning") mt-3" role="alert">
                                            <div class="p-3">
                                                <span class="text-bold-card">@RsCadastros.NUMERODEINSCRICAO :</span> @Model.retornoCNPJ.result.numero_de_inscricao <br />
                                                <span class="text-bold-card">@RsCadastros.ABERTURA :</span> @Model.retornoCNPJ.result.abertura <br />
                                                <span class="text-bold-card">@RsCadastros.NOMEPJ :</span> @Model.retornoCNPJ.result.nome <br />
                                                <span class="text-bold-card">@RsCadastros.NOMEFANTASIA :</span> @Model.retornoCNPJ.result.fantasia<br />
                                                <span class="text-bold-card">@RsCadastros.LOGRADOURO :</span> @Model.retornoCNPJ.result.logradouro <br />
                                                <span class="text-bold-card">@RsCadastros.NUMERO :</span> @Model.retornoCNPJ.result.numero <br />
                                                <span class="text-bold-card">@RsCadastros.CEP :</span> @Model.retornoCNPJ.result.cep <br />
                                                <span class="text-bold-card">@RsCadastros.BAIRRO :</span> @Model.retornoCNPJ.result.bairro <br />
                                                <span class="text-bold-card">@RsCadastros.MUNICIPIO :</span> @Model.retornoCNPJ.result.municipio <br />
                                                <span class="text-bold-card">@RsCadastros.UF :</span> @Model.retornoCNPJ.result.uf <br />
                                                <span class="text-bold-card">@RsCadastros.EMAIL :</span> @Model.retornoCNPJ.result.email <br />
                                                <span class="text-bold-card">@RsCadastros.TELEFONE :</span> @Model.retornoCNPJ.result.telefone <br />
                                                <span class="text-bold-card">@RsCadastros.SITUACAO :</span> @(String.IsNullOrEmpty(Model.retornoCNPJ.result.situacao) ? RsBase.RECEITA_DADOSNAOCONFEREM : Model.retornoCNPJ.result.situacao) <br />
                                                <span class="text-bold-card">@RsCadastros.DTSITUACAOCADASTRAL :</span> @Model.retornoCNPJ.result.dt_situacao_cadastral<br />
                                            </div>
                                        </div>

                                    }
                                    else
                                    {
                                        <div class="alert alert-warning mt-3" role="alert">
                                            <div class="p-3">
                                                <span class="text-bold-card">@RsCadastros.MENSAGEM_ERRO_RECEITA</span>
                                            </div>
                                        </div>
                                    }
                                }

                                <div class="row">

                                    @if ((ViewBag.HabilitaCadastro) || (Model.retornoCPF != null && Model.retornoCPF.result.situacao_cadastral == "REGULAR"))
                                    {
                                        <div class="col-sm-12">
                                            <div align="right" class="form-group panel">
                                                <button type="submit" name="cadastrar" class="btn btn-success" onclick="return validaCPFCNPJ()">Cadastrar</button>
                                            </div>
                                        </div>
                                    }
                                    else if ((ViewBag.HabilitaCadastro) || (Model.retornoCNPJ != null && Model.retornoCNPJ.result.situacao == "ATIVA"))
                                    {
                                        <div class="col-sm-12">
                                            <div align="right" class="form-group panel">
                                                <button type="submit" name="cadastrar" class="btn btn-success" onclick="return validaCPFCNPJ()">Cadastrar</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>


}
