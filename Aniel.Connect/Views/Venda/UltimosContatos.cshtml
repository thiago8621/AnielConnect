@model List<Aniel.Connect.Models.Venda_Historico_Contrato_View>

@{
    ViewBag.Title = "ListaLoginRadius";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts {

    @Styles.RenderFormat(SiteKeys.ScriptVersion,"~/bundles/jsDataTableSimples")

    <script>

        var array = @Html.Raw(Json.Encode(Model));

        $("#datatableContato").DataTable({
            dom: "",
            language: traducaoDataTableSimples,            
            data: array,
            columns: [
                {
                    data: "Data_Ultimo_Contato",
                    title: "@RsCadastros.DATA_ULTIMO_CONTATO"
                },
                {
                    data: "Forma_Contato",
                    title: "@RsCadastros.FORMA_CONTATO",
                    orderable: false
                },
                {
                    data: "Observacao",
                    title: "@RsCadastros.OBSERVACAO",
                    orderable: false
                }
            ]
        });

    </script>
}

<table class="table table-hover nowrap" id="datatableContato" style="width:100%">
</table>