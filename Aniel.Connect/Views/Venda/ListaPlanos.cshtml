@model IEnumerable<Aniel.Connect.Models.Planos_HabilitadosModel>

@{
    ViewBag.Title = "ListaLoginRadius";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts {

    @Styles.RenderFormat(SiteKeys.ScriptVersion,"~/bundles/jsDataTableSimples")
    <style>
        .combo-pai:hover {
            background-color: #e9ecef !important;
            transition: background-color 0.2s ease-in-out;
        }
    </style>
    
    <script>

        var array = @Html.Raw(Json.Encode(Model));

        $("#datatableLogin").DataTable({
            dom: "",
            language: traducaoDataTableSimples,            
            data: array,
            ordering: false,
            paging: false,
            columns: [
                {
                    data: "Plano",
                    title : '@RsCadastros.PLANO_PRODUTO'
                },
                {
                    data: "Status",
                    title : '@RsCadastros.STATUS'
                },
                {
                    data: "Valor",
                    title : '@RsCadastros.VALOR'
                }
            ],
             
            createdRow: function (row, data) {

                if (data.Combo === true) {

                    $(row).css({
                        "font-weight": "bold",
                        "background-color": "#f8f9fa"
                    });
                }
            }          

        });

        $('#datatableLogin tbody').on('click', '.combo-pai', function () {

            var comboId = $(this).data("combo-id");
            var filhos = $('.combo-filho[data-combo-id="' + comboId + '"]');
            var estaAberto = filhos.is(":visible");          

            $('.combo-filho').hide();
            $('.toggle-icon')
                .removeClass('fa-chevron-down')
                .addClass('fa-chevron-right');
            
            if (!estaAberto) {

                filhos.slideDown(150);

                $(this).find('.toggle-icon')
                    .removeClass('fa-chevron-right')
                    .addClass('fa-chevron-down');
            }
        });

    </script>
}

<table class="table table-hover nowrap" id="datatableLogin" style="width:100%">
</table>