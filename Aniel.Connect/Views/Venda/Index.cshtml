        async function AlterarStatusVenda(listaVendas) {
            var objeto = {
                listaVenda: listaVendas
            }

            $('#iModal_Motivo_Desistencia_Venda').modal('hide');

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Vendaapi/CancelarVendasEmMassa")';

            ShowPageLoading();

            await $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: objeto
            })
                .done(async function (data) {
                    if (data.length > 0) {
                        Swal.fire({
                            type: 'question',
                            html: `Devido algumas restrições, não foi possível cancelar algumas vendas.</br>Deseja visualizar as Vendas não Canceladas? </br></br>`,
                            showCancelButton: true,
                            cancelButtonText: 'Não',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'Sim',
                        }).then((result) => {
                            if (result.value) {
                                //vai chamar funcao para carregar a modal com os resultados ShowVendasNaoCanceladas(data)
                                ShowVendasNaoCanceladas(data);
                            }
                            else {
                                CarregarIndex();
                            }
                        });
                    }
                    else {
                        CarregarIndex(true);
                    }
                });

            HidePageLoading();
        }


       async function CancelamentoMassa() {

           if (!rows_selected.length > 0)
           {
                Notificar("Atenção!", "Nenhum registro selecionado", "warning");
                return;
            }

           let result = await SwalFireAlertaCancelamento();
           if (result) {
                    $('#iModal_Motivo_Desistencia_Venda').modal('show'); //modal
                    $('#iMotivoACancelarVendaOutros').hide(); //textbox

                    $('#iMotivo_Desistencia_Venda').change(function (event) {
                        if ($('#iMotivo_Desistencia_Venda :selected').text() == "Outro") {
                            $('#iMotivoACancelarVendaOutros').show();
                   }
                   else {
                            $('#iMotivoACancelarVendaOutros').hide();
                        }
                    });

                    $("#btnMotivoDesistencia").click(async function () {
                        var motivo_cancelar_venda = $('#iMotivo_Desistencia_Venda').val();
                        var justificarCancelamento = $('#iMotivo_Cancelar_Venda_Outros').val();

                        if (motivo_cancelar_venda === null || motivo_cancelar_venda === undefined) {
                            Notificar("Atenção!", "Nenhum motivo de cancelamento foi selecionado, tente novamente.", "warning");
                            return;
                        }

                        var listaVenda = [];

                        for (var i = 0; i <= rows_selected.length; i++){
                            var requestData = {
                                id: rows_selected[i],
                                justificativa: justificarCancelamento,
                                status: 4, //cancelado
                                status_atual: 4,
                                usuario: "@User.Identity.GetUserId()",
                                idAtividadeWorkflow: null,
                                motivo_desistencia_venda: parseInt(motivo_cancelar_venda),
                                situacao: 1
                            };

                            if (!listaVenda.find(x => x == rows_selected[i])) {
                                if (rows_selected[i] !== null && rows_selected[i] !== undefined)
                                    listaVenda.push(requestData);
                            }
                        }

                        await AlterarStatusVenda(listaVenda);
                    });
       }
       }

