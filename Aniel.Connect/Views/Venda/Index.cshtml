        function validaCPFCNPJ() {

            var tipoCliente = null;
            var tipoPessoa = null;
            var tipoEntrada = null;
            // Tipo de Pessoa

            Swal.fire({
                title: 'Vender para Pessoa Física ou Jurídica?',
                input: 'radio',

                html: '<div class="swal2-radio" style="display: flex;"><label><input type="radio" id="iRadioCPF" name="swal2-radio-option" value="0" checked><span class="swal2-label">Física</span></label><label><input type="radio" name="swal2-radio-option" value="1"><span class="swal2-label">Jurídica</span></label></div><input class="swal2-input" id="iCPFCNPJ" type="text"/>',
                showCancelButton: true,
                confirmButtonText: 'Confirmar',
                cancelButtonText: 'Cancelar',
                showLoaderOnConfirm: true,
                onOpen: function () {

                    $("input[type=radio][name=swal2-radio-option]")[0].checked = true;

                    $("#iCPFCNPJ").bind('input propertychange', function (e) {

                        var textoEntrada = $("#iCPFCNPJ").val();
                        textoEntrada = textoEntrada.replace(".", ""); textoEntrada = textoEntrada.replace(".", ""); textoEntrada = textoEntrada.replace("-", ""); textoEntrada = textoEntrada.replace("/", "");
                        //Não é número, é texto
                        if (isNaN(textoEntrada)) {
                            //$("input[type=radio][name=swal2-radio-option]")[0].checked = true;
                            $(".swal2-input").unmask();
                        } else {
                            $("input[type=radio][name=swal2-radio-option]").change()
                        }

                    });


                    $("input[type=radio][name=swal2-radio-option]").change(function () {
                        if ($("[name='swal2-radio-option']:checked").val() == "0") {
                            $(".swal2-input").mask("000.000.000-00");
                        }
                        if ($("[name='swal2-radio-option']:checked").val() == "1") {
                            $(".swal2-input").mask("00.000.000/0000-00");
                        }
                    });

                },
                preConfirm: async (value) => {


                    let login = $('#iCPFCNPJ').val();

                    login = login.replace(".", ""); login = login.replace(".", ""); login = login.replace("-", ""); login = login.replace("/", "");
                    let tipo_pessoa = $("[name='swal2-radio-option']:checked").val() == "0" ? "0" : "1";

                    var acesso = false;
                    if ("@AcessoHelper.TemAcesso(_areas, "348")" == "True"){
                        acesso = true;
                    }

                    if (!login)
                    {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DOCUMENTO_CPF_CNPJ)", "warning");
                        return false;
                    }

                    var link = `@String.Concat(CONSTANTES.URLPortal, "/api/VendaApi/verificaVendaDuplicadaCpfCnpj")?cpfCnpj=${login}`;
                    const response = await $.ajax({
                        url: link,
                        type: 'POST',
                        dataType: 'json'
                    });

                    if (response.ok == false) {
                        await Swal.fire({
                            title: "Pendência encontrada!",
                            type: "warning",
                            text: response.mensagem,
                            confirmButtonText: 'OK'
                        });
                        return false;
                    }
                    else if (response.ok && acesso && response.idObjeto > 0) {

                        let criarVendaDuplicada = false;
                        await Swal.fire({
                            type: 'error',
                            title: response.mensagem,
                            text: "Deseja criar uma nova venda para o cliente selecionado?",
                            type: 'question',
                            showCancelButton: true,
                            confirmButtonColor: '#3085d6',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'Sim',
                            cancelButtonText: 'Não'
                        }).then(async (result) => {
                            if (result.value) {
                                criarVendaDuplicada = true
                            }
                        });

                        if (!criarVendaDuplicada) {
                            return false;
                        }
                    }
                    else if (response.idObjeto > 0 && !acesso) {
                        await Swal.fire({
                            title: "Venda duplicada!",
                            type: "warning",
                            text: response.mensagem,
                            confirmButtonText: 'OK'
                        });
                        return false;

                    }




                    let actionSwal = await handleSwalVenda(login, tipo_pessoa, bloquearVendaSemContatoValidado);


                    switch (actionSwal.type) {
                        case "success":
                            window.location.href = '@Url.Action("ClienteDadosGerais", "Venda")' + '?Id_Cliente=' + actionSwal.client;
                            await Swal.fire({
                                type: actionSwal.type,
                                title: actionSwal.title,
                                text: actionSwal.text
                            });
                            break;
                        case "error":
                            await Swal.fire({
                                type: actionSwal.type,
                                title: actionSwal.title,
                                text: actionSwal.text,
                                onClose: actionSwal.onClose
                            });
                            break;
                    }
                },

                allowOutsideClick: () => !Swal.isLoading(),
            })
            .then((result) => {

            });
        }

        async function handleSwalVenda(login, tipoPessoa, bloqueiaVenda) {
            const retornoSwal = {
                type: "error",
                title: "Oops...",
                text: "",
                client: null,
                onClose : null
            };
            let ok = false;

            let endpoint = "";
            let idCliente = null;
            let buscaBy = null;
            try
            {
                if (!isNaN(login)) {
                    endpoint = '@CONSTANTES.URLPortal/api/clienteapi/buscaCpf?term=' + login + "&tipo_cliente&tipo_pessoa";

                    await $.getJSON(endpoint, (data) => { buscaBy = data });
                    ok = buscaBy.ok;
                }
                else if (!ok && login) {
                    endpoint = '@CONSTANTES.URLPortal/api/clienteapi/buscaNome?term=' + login + "&tipo_cliente&tipo_pessoa";


                    await $.getJSON(endpoint, (data) => { buscaBy = data });
                    ok = buscaBy.ok;
                }
                if (ok) {
                    idCliente = buscaBy.objeto[0].id;

                    if (bloqueiaVenda) {
                        let numeroValidado = await hasNumeroValidado(idCliente);
                        if (!numeroValidado) {
                            throw "Cliente não pode iniciar uma venda sem número de celular validado.";
                        }
                    }
                    retornoSwal.type = "success";
                    retornoSwal.title = (isNaN(login) ? "Cliente" : tipoPessoa == "0" ? "CPF" : "CNPJ") + " Encontrado";
                    retornoSwal.client = idCliente;
                    retornoSwal.onClose = ShowPageLoading;
                }
                else {
                    throw "Cliente não Encontrado";
                }
            }
            catch (exception)
            {
                retornoSwal.type = "error";
                retornoSwal.title = "Oops";
                retornoSwal.client = null;
                retornoSwal.text = exception;
            }

            return retornoSwal;
        }

