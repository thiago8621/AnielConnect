@model IEnumerable<Aniel.Connect.Models.ClienteListViewModel>
@using Aniel.Connect.Repository.Model
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Microsoft.AspNet.Identity;

@{
    ViewBag.Title = RsCadastros.PAINEL_VENDAS;
    ViewBag.Sessao = RsCadastros.VENDA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    var StorageName = CONSTANTES.SIGLA_MODULO + " - " + ViewBag.Title + " - " + CONSTANTES.Versao;
    List<AreaModuloModel> _areas = ViewBag.Areas;
    PainelVendasFiltrosDashBoard DashBoard = ViewBag.DashBoard;
    bool BloquearVendaSemContatoValidado = ViewBag.BloquearVendaSemContatoValidado;

    //listaEtapas
    List<Aniel.Connect.Core.ObjComboResult<String>> listaEtapas = new List<Aniel.Connect.Core.ObjComboResult<String>>();
    foreach (var valor in Enum.GetValues(typeof(EnumEtapaVenda)))
    {
        string descricao = HtmlEnumExtensions.GetEnumDescription(valor);
        listaEtapas.Add(new Aniel.Connect.Core.ObjComboResult<string>
        {
            Id = Convert.ToInt32(valor).ToString(),
            Text = descricao
        });
    }
    listaEtapas = listaEtapas.OrderBy(x => x.Text).ToList();


}


