            $('#iCidade').change(
            /** */
                function () {
                const cidade = $('#iCidade option:selected').val();

                if ($(this).val() != null) {
                        AddSelect("iBairro", "@CONSTANTES.URLPortal/api/enderecoapi/GetComboBairros",@CONSTANTES.PaginacaoRegistros, null, cidade, null, "@RsBase.SELECIONE", false);
                }
                else {
                    if ($('#iBairro').data('select2')) {
                    $('#iBairro').select2('destroy');
                    }
                    $("#iBairro").empty();
                }

                var enderecoApi = "@CONSTANTES.URLPortal/api/enderecoapi/getbairros?Id_Cidade=" + cidade;

                $("#iBairro").val("");


                $('#iBairro').append($('<option></option>').attr('value', null).text('@RsBase.SELECIONE'));
                $.getJSON(enderecoApi, function (data) {
                    $.each(data, function (key, value) {
                        $('#iBairro').append($('<option></option>').attr('value', value.id).text(value.descricao));
                    })
                });
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });



            $('#datatable tbody').on('click', 'tr', function (e) {

                if (oDatatable.row(this).data() != null) {

                    var _id = oDatatable.row(this).data().id;

                    var url = '@Url.Action("ClienteDadosGerais", "Venda")' + "?Id_Venda=" + _id;
                    AddAba(url, 'Cadastro de Venda');
                    e.stopPropagation();
                }

            });

            // Handle btn login event
            $('#datatable tbody').on('click', '.btnPlanos', function (e) {

                var id = $(this).attr("id_venda");

                e.stopPropagation();
                ShowDialog(true, true, '@RsCadastros.PLANOS_E_PRODUTOS', '@Url.Action("ListaComboPlano", "Venda")' + '?Id_Venda=' + id, 'divLogin',450, 450, 'iframeLoginRadius');

            });

            $('#datatable tbody').on('click', '.btnUltimoContato', function (e) {

                var id = $(this).attr("id_venda");

                e.stopPropagation();
                ShowDialog(true, true, '@Html.Raw(RsCadastros.ULTIMO_CONTATO)', '@Url.Action("UltimosContatos", "Venda")' + '?Id_Venda=' + id, 'divLogin',650, 450, 'iframeUltimoContato');

            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

        //$('.swal2-select').addClass('form-control');
        if ($('input[name="iStatusEtapa"]:checked').val() == null) {
            $('#restricaoSection').hide()
