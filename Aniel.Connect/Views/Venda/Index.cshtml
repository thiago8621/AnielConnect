      //  console.log(colunas);

        async function GetColunas(id_modelo,colunas) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Modelo_PainelVendaApi/getcolunas")' + `?id_modelo=${id_modelo}`;

                var retorno = await $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json'
                });

                if (retorno.ok) {
                    let colunas_retorno = [];
                    let ordernar_por = null;
                    colunas_retorno.push({ title: "<input name='select_all' value='1' type='checkbox'>" });

                    console.log(retorno.objeto.colunas)

                    for (let coluna of retorno.objeto.colunas) {
                        let busca_coluna = colunas.filter(p => p.coluna_enum == coluna);
                        if (busca_coluna.length > 0)
                            colunas_retorno.push(busca_coluna[0]);
                    }


                    for (var i = 0; i < colunas_retorno.length; i++) {
                        if (colunas_retorno[i].coluna_enum == retorno.objeto.ordenar_por) {
                            ordernar_por = [[i, 'asc']]
                        }
                    }
                    return {
                        colunas: colunas_retorno,
                        ordenar_por: ordernar_por
                    };
                }
                else {
                    return {
                        colunas: null,
                        ordenar_por: null
                    };
                }

            }

