                @*<div class="container mt-3 justify-content-center">
                        <div class="row justify-content-center">
                            <img onmouseout="desativaZoom()" onmouseover="ativaZoom()" id="imgModal" class="img-fluid" style="display: inline-block; float: left;max-height: 70vh" />
