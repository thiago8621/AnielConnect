@model  List<Aniel.Connect.Models.Historico_UltimosContatos_AcaoStatusModel>
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = "Historico_UltimosContatos_AcaoStatus";

    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")


}

@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>

        var array = @Html.Raw(Json.Encode(Model));

        $("#datatable").DataTable({
            dom: "",
            language: traducaoDataTableSimples,
            data: array,
            paging:false,
            columns: [
                {
                    data: "Data_Ultimo_Contato",
                    title: "Data / Hora:"
                },
                {
                    data: "Usuario",
                    title: "@RsBase.USUARIO"
                },
                {
                    data: "Acao",
                    title: "Ação: ",
                    orderable: false
                },
              
                {
                    data: "Observacao",
                    title: "@RsCadastros.OBSERVACAO :",
                    orderable: false
                }
            ]
        });

    </script>
}
