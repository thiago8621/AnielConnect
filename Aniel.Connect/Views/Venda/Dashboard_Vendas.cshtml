         function escolherData(event, id_vendedor) {

            event.stopPropagation();

            var url = "@Url.Action("Comercial", "Mapa")?Id_Vendedor=" + id_vendedor + "&Data=" + dataAtualFormatada();
            window.location.href = url;

        }
        Venda = 1;

        function visualizarVendas(event, id_vendedor) {

            event.stopPropagation();

            var url = "@Url.Action("Index", "Venda")?vendedor=" + id_vendedor + "&dataVenda=" + Venda + "&dataBusca=" + dataAtualFormatada();
            window.location.href = url;


        }


        @*function MostrarPlanosProdutos(IdFuncionario) {

            ShowDialog(true, true, 'Extrato do vendedor', "@Url.Action("Dashboard_Vendas_Itens", "Venda")" + "?IdFuncionario=" + IdFuncionario, 'divPlanosProdutos', 620, 450, 'iframePlanosProdutos', function () {
                try {
                    setTimeout(function () {
