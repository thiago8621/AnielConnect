            event.stopPropagation();

            Swal.fire({
                title: "Escolha a Data de Exibição:",
                html: '<center><input class="form-control datepicker" id="dataMapa"></center>',
                type: "warning",
                customClass: 'swal2-overflow',
                onOpen: function () {
