@model  Aniel.Connect.Models.Acompanhamento_Venda_MapaModel

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.DASHBOARD_VENDEDOR;
    ViewBag.Sessao = RsCadastros.VENDEDOR;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")

    <link href="~/Content/map.css" rel="stylesheet" />
    <style>
        .dot {
            height: 35px;
            width: 35px;
            background-color: #ddd;
            border-radius: 50%;
            display: inline-block;
            border-color: #333;
            border-bottom-style: solid;
            border-width: unset;
            padding-top: 9px;
        }

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}


@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>


    $(document).ready(function () {

        AddSelect("iSupervisor", "@CONSTANTES.URLPortal/api/FuncionarioApi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
    });



        function ExibeMapa(equipe) {

            var url = "@Url.Action("Mapa_Equipes", "Venda")" + "?Equipe=" + equipe + "&Pagina=Acompanhamento";

            window.location = url;
            return false;
        }

        function dataAtualFormatada() {
            var data = new Date(),
                dia = data.getDate().toString(),
                diaF = (dia.length == 1) ? '0' + dia : dia,
                mes = (data.getMonth() + 1).toString(), //+1 pois no getMonth Janeiro começa com zero.
                mesF = (mes.length == 1) ? '0' + mes : mes,
                anoF = data.getFullYear();
            return diaF + "/" + mesF + "/" + anoF;
        }

        var oDatatable;


