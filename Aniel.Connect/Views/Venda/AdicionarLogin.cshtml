@model Aniel.Connect.Repository.Model.VendaDadosGeraisViewModel
@using Aniel.Connect.Core.Helpers
@using Sinapse.Model.enumerados;

@{
    ViewBag.Title = RsCadastros.LOGIN;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{

}

@section scripts
{  

    <script>

          $("#btnVincularLoginRadius").unbind('click');
        $("#btnVincularLoginRadius").click(function (e) {
            e.preventDefault();

            if (!$("#iLogin").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.LOGIN)", "warning")
            }
            else {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/LoginRadiusApi/ExisteLogin")?login=' + $("#iLogin").val()

                $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',
                    beforeSend: function () {
		                ShowPageLoading();
	                },
	                complete: function() {
		                HidePageLoading();
	                }
                })
                .done(function (data) {
                    if (!data.ok) {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                    else if (data.objeto) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.LOGIN_RADIUS_JA_EXISTE)", "warning");
                    }
                    else {
                   var link = '@String.Concat(CONSTANTES.URLPortal, "/api/RadiusApi/CadastrarUsuario?Name=")' + $("#iLogin").val() + "&Password=" + $("#iSenha").val();

                            $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',
                                async: false,
                                success: function (data) {
                                     Notificar("@RsBase.INFORMACAO", "Login adicionado", "info");
                                }
                            })
                        return false;


                    }
                })
            }
        });

        var clicked = false;
        function ValidaSubmit() {
