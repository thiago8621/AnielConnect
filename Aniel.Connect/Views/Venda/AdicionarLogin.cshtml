            if (!erro)
                return validaCPFCNPJ();
            else
                Notificar("Atenção", "Informe dados válidos", "warning");
        }



        /**/</script>




}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">

                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page">
                            <i class="fas fa-user"></i> @ViewBag.Title
                        </h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                              
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Cliente")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINELCLIENTES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>

                            </ol>
                        </nav>
                        @*<span style="font-size:11px;margin-left: 15px;" id="dtLegend"></span>*@
                    </div>
                </div>

                <div id="accordion">
                    <div class="card div-card-accord">
                        <div class="card-header title-card" id="heading-1">
                            <h5 class="mb-0">
                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                    <span class="text-bold-card">@RsCadastros.LOGIN</span>
                                </a>
                            </h5>
                        </div>
                        <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                            <div class="card-body body-card-accord">

                                <div class="row mb-5">

                                    <div class="col-sm-8 container" style="align-content:center;">

                                        <div class="form-group">
                                            <label for="ilogin">@RsCadastros.LOGIN: </label>
                                            @Html.TextBoxFor(model => model.Login, new { @class = "form-control", @id = "iLogin" })
                                        </div>
                                        <div class="form-group">
                                            <label for="iSenha">@RsCadastros.SENHA</label>
                                            @Html.TextBoxFor(model => model.Senha, new { @class = "form-control", @id = "iSenha", @type = "password" })
                                        </div>

                                    </div>
                                </div>
                                <div class="form-group mt-4">
                                    <div class="text-center">
                                        
                                        <button type="button" class="btn btn-success ml-2" id="btnVincularLoginRadius">Confirmar</button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>


}
