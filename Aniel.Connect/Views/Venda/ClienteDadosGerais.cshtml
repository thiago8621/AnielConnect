            function handleExcluirPlano() {
                $(document).off("click", ".btnExcluirPlano");
                $(document).on("click", ".btnExcluirPlano", async function (e) {
                    e.preventDefault();
                    if (termo_adesao_assinado) {
                        Notificar("@RsBase.ATENCAO_", "Termo Adesão Aprovado não é possível alterar Detalhes do Plano", "warning");
                        return;
                    }

                    const result = await Swal.fire({
                        title: "Deseja excluir Plano/Produto?",
                        icon: "question",
                        html: "<p>Não será possível retroceder a ação.</p>",
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Sim',
                        cancelButtonText: 'Não'
                    }).then(async (result) => {
                        if (!result.value) {
                            return;
                        }
                        else {
                            //var trLinkButton = $(`.btnExcluirPlano[charcode=${charCode}]`).parents('tr');

                            const idArquivo = $(this).attr("excluir");
                            const charCode = $(this).attr("charCode");
                            //const trLinkButton = $(`.btnExcluirPlano[charcode=${charCode}]`).closest("tr");
                            const trLinkButton = $(this).closest("tr");
                            const dataClicked = oDatatablePlano.row(trLinkButton).data();
                            $("#divProgress").show();

                            if (idArquivo === "0") {
                                oDatatablePlano.rows((idx, data) => `${data.Id_Plano_Atrelado}` == dataClicked.Id_Plano_Produto).remove();
                                oDatatablePlano.row(trLinkButton).remove();
                                oDatatablePlano.draw(false);

                                const records = oDatatablePlano.rows().data().toArray();
                                await atualizarValoresNaExclusao(records, dataClicked.Id_Plano_Produto);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                const allData = oDatatablePlano.rows().data().toArray();
                                const planos_adicionais = allData.filter(x => x.Id_Plano_Atrelado == dataClicked.Id_Plano_Produto).map(item => item.Id).join(',');

                                const link = '@String.Concat(CONSTANTES.URLPortal, "/api/Plano_Produtoapi/ExcluirGrid?value=")' + idArquivo + '&Ids=' + planos_adicionais + "&IdVenda=@Model.Id";
                                try {
                                    const response = await $.ajax({
                                        url: link,
                                        type: "GET",
                                        dataType: "json"
                                    });
                                    if (response.ok) {
                                        oDatatablePlano.rows((idx, data) => `${data.Id_Plano_Atrelado}` == dataClicked.Id_Plano_Produto).remove();
                                        oDatatablePlano.row(trLinkButton).remove();
                                        oDatatablePlano.draw(false);

                                        const records = oDatatablePlano.rows().data().toArray();
                                        await atualizarValoresNaExclusao(records, dataClicked.Id_Plano_Produto);
                                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                    } else {
                                        Notificar("@RsBase.ATENCAO_", response.mensagem, "warning");
                                    }

                                    // Garantia de remoção extra
                                    oDatatablePlano.rows((idx, data) => `${data.Id}` === dataClicked.Id).remove().draw(false);
                                } catch (error) {
                                    console.error("Erro ao excluir plano:", error);
                                    Notificar("@RsBase.ATENCAO_", "Erro ao excluir plano. Tente novamente.", "error");
                                }
                            }

                            $("#divProgress").hide();
                            const updatedRecords = oDatatablePlano.rows().data().toArray();
                            reorderRecords(updatedRecords);
                            displayDetalhesProposta(detalhesPropostaInicial);
                            oDatatable.ajax.reload(null, false);
                            $("#iContratoDescontoPlano").empty().append($('<option></option>').val("").text('@RsBase.SELECIONE'));
                            $("#iContratoDescontoPlano").select2({
                                data: GerarOptionsDesconto(oDatatablePlano),
                                width: "resolve"
                            });
                        }
                    });
                });
            }

            handleExcluirPlano();

            function ValidaContrato() {
                return new Promise(async (resolve, reject) => {
                    let erro = false;

                    if ($("#iPlano").val()) {
                        let link = '@String.Concat(CONSTANTES.URLPortal, "/api/Planoapi/FindById?Id=")' + $("#iPlano").val();
                        await $.getJSON(link, async function (data) {

                            if (data.objeto == null) {
                                link = '@String.Concat(CONSTANTES.URLPortal, "/api/Produtoapi/FindById?Id=")' + $("#iPlano").val();

                                await $.getJSON(link, function (data) {

                                    if (data.objeto.emitirContratoProduto == true) {

                                        if (!$("#iModelo_Contrato").val()) {
                                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MODELO_CONTRATO)", "warning");
                                            erro = true;
                                        }

                                        if ($("#numContratoDiv").is(":visible")) {

                                            if (!$("#iNumeroContratoPlanoProduto").val()) {
                                                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.NUMERO_CONTRATO)", "warning");
                                                erro = true;
                                            }
                                        }
                                    }

                                    resolve(erro);
                                });
                            }
                            else {

                                if (data.objeto.emitirContrato == true) {

                                    if (!$("#iModelo_Contrato").val()) {
                                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MODELO_CONTRATO)", "warning");
                                        erro = true;
                                    }
                                    if ($("#numContratoDiv").is(":visible")) {
                                        if (!$("#iNumeroContratoPlanoProduto").val()) {
                                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.NUMERO_CONTRATO)", "warning");
                                            erro = true;
                                        }
                                    }
                                }

                                resolve(erro);
                            }
                        });
                    }

                    resolve(erro);
                });
            }

            async function isPlanoProdutoVendaAgrup(planoId) {

                //verificar se há planos/produtos já adicionados no datatable.
                var alldatas = oDatatablePlano.rows().data();
                var hasPlanoAdd = alldatas.length > 0;

                if (!hasPlanoAdd)
                    return false;

                //verificar se foi aplicado algum tipo de combo ou algum tipo de campanha a esse novo plano que será adicionado

                var hasCampanha = $("#iCampanha option:selected").val() != 'undefined' && $("#iCampanha option:selected").val() != '' ? true : false;
                var hasCombo = $('#iComboSelect').val() ? true : false;

                if (hasCampanha || hasCombo)
                    return false;

                //caso nao tiver algum tipo de campanha, combo e já existe valores adicionados vou
                //verificar se esse plano / produto tem a configuração ativada como venda agrupada
                //caso sim, vou verificar se conta há configur

                var link = baseUrl + '/api/PlanoProdutoapi/HasVendaAgrupada?planoProdutoId=' + planoId;

                return await $.ajax({
                    url: link,
                    dataType: "json",
                    method: "GET"
                });
            }

            let ContratoDescontoCount = 0;
            const placeholder = "@RsCadastros.PLANO_TMP";

            async function atualizarValoresNaExclusao(records, Id_Plano_Produto) {
                if (records.length === 1) {

                    var novoValor = parseFloat(records[0].ValorPlanoOriginal.replace(/\./g, "").replace(",", ".")).toLocaleString("pt-BR", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });

                    var novoValorInstalacao = parseFloat(records[0].ValorInstalacao_Final.replace(/\./g, "").replace(",", ".")).toLocaleString("pt-BR", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });

                    let indexes = oDatatablePlano.rows().indexes().toArray();
                    for (let i = 0; i < indexes.length; i++) {
                        let row = oDatatablePlano.row(indexes[i]);
                        let data = row.data();

                        if (data.UtilizaVendaAgrupada === true) {
                            let retornoObj = await definindoInfomacoesPlano(novoValor, novoValorInstalacao, data.Descricao, data.Id_Plano_Produto);

                            data.ValorPlanoProduto = novoValor;
                            data.FlagPossuiValorAgrupado = true;
                            data.UtilizaVendaAgrupada = true;
                            data.ValorTotal = retornoObj.valorTotal;
                            data.UtilizaVendaAgroup = false;

                            FlagPossuiValorAgrupadoTmp = true;
                            row.data(data).draw(false);
                        }
                    }
                }
            }

            async function definindoInfomacoesPlano(iValorReal, iValorInstalacao, iPlanoTxt, iPlano_Selecionado) {
                var obj = {};
                if (tipoPlanoProduto) {
                    if (tipoPlanoProduto == 1) {

                        obj.descricao = iPlanoTxt;

                        var _valor = parseFloat(iValorReal.replace(",", ".")) + parseFloat(iValorInstalacao.replace(",", "."));
                        obj.valorTotal = _valor.toString().replace(".", ",");
                    }
                    else if (tipoPlanoProduto == 2) {

                        obj.descricao = iPlanoTxt;
                        obj.valorTotal = parseFloat(iValorReal.replace(',', '.'));
                    }
                }
                else if ($('#iComboSelect').val()) {
                    obj.descricao = $("#iComboSelect option:selected").html();

                    console.log("valor antes");
                    console.log(iValorReal);


                    obj.valorTotal = parseFloat(iValorReal.replace(/\./g, "").replace(",", ".")).toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                    console.log("valor depois");
                    console.log(obj.valorTotal);
                }

                if ($("#iEndereco_Instalacao").val() === "true") {
                    obj.insta_Principal = "Principal";
                }
                else {
                    obj.insta_Principal = "Instalacao";
                }

                if (servicos_Adicionais.length > 0) {
                    utilizaNovoServico = true;
                    obj.jsonServicos = JSON.stringify(servicos_Adicionais);
                }

                obj.isVendaAgrup = false;

                let data = await isPlanoProdutoVendaAgrup(iPlano_Selecionado);

                if (data != null && data != false) {
                    if (data.ok) {
                        if (tipoPlanoProduto == 1) {
                            var somatorio = data.objeto.valorVendaAgrupada + parseFloat(iValorInstalacao.replace(",", "."));
                            obj.valorTotal = somatorio.toString().replace(".", ",");
                            obj.valorPlanoVendaAgrup = data.objeto.valorVendaAgrupada;
                            obj.isVendaAgrup = true;
                        }
                        else {
                            obj.valorTotal = data.objeto.valorVendaAgrupada.toString().replace(".", ",");
                            obj.valorPlanoVendaAgrup = data.objeto.valorVendaAgrupada;
                            obj.isVendaAgrup = true;
                        }
                    }
                }

                return obj;
            }

            $("#btnAdicionarPlano").unbind('click');
            $("#btnAdicionarPlano").on('click', async function () {
                // Validando o status do termo Adesao DS4039
                if (termo_adesao_assinado) {
                    Notificar("@RsBase.ATENCAO_", "Termo Adesão Aprovado não é possivel alterar Detalhes do Plano", "warning");
                } else {
                    if ($("#iTipoTecnologia").val() == 2) {
                        const tipo_internet = oDatatablePlano.rows().data().toArray().filter(x => x.Tipo_Tecnologia == 2);
                        if (tipo_internet.length > 0) {
                            Notificar("@RsBase.ATENCAO_", "Já existe um plano de internet associado a esta venda.", "warning");
                            return false;
                        }
                    }
                    //Adicionando plano ainda sem contrato
                    if ($("#iTrocaPlanoEnumNao").is(":checked")) {
                        $("#iNumeroContratoPlanoProduto").val(`${placeholder}_${++ContratoDescontoCount}`);
                    } else {
                        $("#iNumeroContratoPlanoProduto").val($("#iModelo_ContratoExistentes option:selected").val());
                    }
                    if (!$("#iModelo_Contrato").val()) {
                        Notificar("@RsBase.ATENCAO_", "Preencha o Modelo de Contrato ao adicionar o plano!", "warning");
                        return;
                    }


                    var erro = false;
                    let formaPagamento = null;

                    let erroContrato = await ValidaContrato();
                    $("#divProgress").show();
                    erro = erroContrato;

                    formaPagamento = null;
                    if (incluiuNovaFormaPagamento) {

                        formaPagamento = oDatatableFormaPagamento.rows().data().toArray().filter(f => f.Id == $("#iFormaPagamentoPlanoProduto").val()).map(f => f.Id_Forma_Pagamento);
                    }
                    else {
                        formaPagamento = listaFormasPagamento.filter(f => f.Id == $("#iFormaPagamentoPlanoProduto").val()).map(f => f.Id_Forma_Pagamento);
                    }

                    if (formaPagamento === undefined || formaPagamento === null) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.FORMA_PAGAMENTO)", "warning");
                        erro = true;
                    }

                    if ($("#iTrocaPlanoEnumNao").is(":checked") && (!$("#iModelo_Contrato").val() || $("#iModelo_Contrato").val() == "")) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MODELO_CONTRATO)", "warning");
                        erro = true;
                    }

                    if ($("#iTrocaPlanoEnumSim").is(":checked") && ((!$("#iModelo_ContratoExistentes").val() || $("#iModelo_ContratoExistentes").val() == "" || !$("#iPlanoAntigo_InsersaoDataTable").val() || $("#iPlanoAntigo_InsersaoDataTable").val() == ""))) {
                        Notificar("@RsBase.ATENCAO_", "Informe o Contrato e/ou Plano Descontinuado.", "warning");
                        erro = true;
                    }

                    if (!$("#iPlano").val() || $("#iPlano").val() == "") {
                        if (!$("#iComboSelect").val() || $("#iComboSelect").val() == "") {
                            Notificar("@RsBase.ATENCAO_", "Plano não selecionado para adição à Venda", "warning");
                            erro = true;
                        }
                    }

                    if (parseInt($('#iValorInstalacao').val()) > 0) {
                        if (!$("#iNumero_Parcelas_Instalacao").val() || parseInt($("#iNumero_Parcelas_Instalacao").val()) < 1) {
                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.NUMERO_PARCELAS_INSTALACAO)", "warning");
                            erro = true;
                        }
                    }

                    if ($("#iPlanoAntigo_InsersaoDataTable").val() > 0) {
                        var link = "@CONSTANTES.URLPortal/api/VendaApi/Get_MudancaPlanoProduto_Venda?IdPlanoProduto_Troca=" + $("#iPlanoAntigo_InsersaoDataTable").val();
                        const _data = await $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',
                            beforeSend: function () {
                                $("#divProgress").show();
                            },
                            complete: function () {
                                $("#divProgress").hide();
                            }
                        });

                        if (_data.ok) {
                            Notificar("@RsBase.ATENCAO_", _data.mensagem, "warning");
                            erro = true;
                        }
                    }

                    if (erro) {
                        $("#iNumeroContratoPlanoProduto").val(null);
                        $("#divProgress").hide();
                        return false;
                    }

                    var link = "@CONSTANTES.URLPortal/api/Planoproduto/PossuiPlanoProduto?Id_Plano_Produto=" + $("#iPlano option:selected").val() + "&Id_Cliente=@Model.Id_Cliente";

                    let data = await $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',
                        beforeSend: function () {
                            $("#divProgress").show();
                        },
                        complete: function () {
                            $("#divProgress").hide();
                        }
                    });

                    tipoPlanoProduto = $("#iTipoPlanoProduto").val();

                    let plano_existente = oDatatablePlano.rows().data().toArray();
                    let iValorReal = $("#iValorReal").val(), iValorInstalacao = $("#iValorInstalacao").val();

                    if (isNaN(parseFloat(iValorReal.replace(",", ".")))) {
                        iValorReal = 0;
                        $("#iValorReal").val('0');
                    }
                    else if (isNaN(parseFloat(iValorInstalacao.replace(",", ".")))) {
                        iValorInstalacao = 0;
                        $("#iValorInstalacao").val("0");
                    }

                    var retornoObj = await definindoInfomacoesPlano(iValorReal, iValorInstalacao, $("#iPlano option:selected").html(), $("#iPlano option:selected").val());
                    var vlr_plano_venda_agrupada = iValorReal;
                    if ($("#iVendaCampanhaSim").is(":checked") == false) {
                        if (retornoObj.isVendaAgrup == true) {
                            vlr_plano_venda_agrupada = ValorVendaAgrupada;
                        }

                        if (plano_existente.filter(x => x.UtilizaVendaAgrupada == true).length > 0) {
                            oDatatablePlano.rows().every(function () {
                                var data = this.data();
                                if (data.UtilizaVendaAgrupada == true) {
                                    var novoValor = parseFloat(data.ValorVendaAgrupada.replace(/\./g, "").replace(",", ".")).toLocaleString("pt-BR", {
                                        minimumFractionDigits: 2,
                                        maximumFractionDigits: 2
                                    });

                                    data.ValorPlanoProduto = novoValor;
                                    data.ValorPlanoProduto_Final = novoValor;
                                    data.FlagPossuiValorAgrupado = true;
                                    data.UtilizaVendaAgrupada = true;
                                    data.UtilizaVendaAgroup = true

                                    this.data(data).draw(false);
                                }
                            });
                        }

                    }

                    let result = await $.ajax({
                        url: "@CONSTANTES.URLPortal/api/Planoproduto/HasPlanosAdicionais?Id_Plano_Produto=" + $("#iPlano option:selected").val(),
                        type: 'GET',
                        dataType: 'json'
                    });

                    let possuiPlanosAdicionais = false;
                    if (result.ok && result.objeto && result.objeto.length > 0) {
                        possuiPlanosAdicionais = true;
                    }

                    oDatatablePlano.row.add({
                        Id: 0,
                        Id_Endereco: 0,
                        Id_Plano_Produto: $("#iPlano option:selected").val(),
                                        Id_Campanha: '',
                        Descricao: retornoObj.descricao,
