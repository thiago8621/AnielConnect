                </text>
            }

            var texto = '';
            if (status == 2) {
                texto = 'Aprovar';
            } else if (status == 3) {
                texto = 'Reprovar';
            }

            Swal.fire({
                title: "Deseja " + texto + " o anexo?",
                type: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não'
            }).then(async (result) => {
                if (result.value) {
                    var link = `@CONSTANTES.URLPortal/api/TermoAdesaoApi/AlterarStatusTermo?status=${status}&id=${@Model.Id}`;

