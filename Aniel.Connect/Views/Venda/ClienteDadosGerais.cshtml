        var _row = null;
        $('#datatablePlanos tbody').on('click', '.alterarFormaPagto', function (e) {
            _row = $(this).closest('tr');
            $('#iModal_Alterar_FormaPagto').modal('show')
            {
                $('#iNovaFormaPagto').val('').trigger('change');
                var lista = incluiuNovaFormaPagamento == 0 ? listaFormasPagamento : [];
                var id_forma_pagamento_cliente = oDatatablePlano.row(_row).data().Id_Forma_Pagamento_Cliente;

                $('#iNovaFormaPagto').empty();

                lista.forEach(p => {
                    var texto = p.Dia_Vencimento != null ? p.Dia_Vencimento : "";
                    texto += p.Desc_Forma_Pagamento != null ? ` - ${p.Desc_Forma_Pagamento}` : "";
                    texto += p.LogradouroCobranca != null ? ` - ${p.LogradouroCobranca}` : "";
                    texto += p.NumeroCobranca != null ? `, ${p.NumeroCobranca}` : "";

                    $('#iNovaFormaPagto')
                        .append($(`<option>${p.Desc_Forma_Pagamento}</option>`)
                            .attr("value", p.Id)
                            .attr("pagamentoDesc", p.Desc_Forma_Pagamento)
                            .attr("selected", p.Id == id_forma_pagamento_cliente ? true : false)
                            .text(`Vencto Dia ${texto}`));
                });
                $('#iNovaFormaPagto').select2();
            }
        });

        $("#btnAlterarFormaPagto").click(async function (e) {
            if (@Model.Id != 0) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Plano_Produtoapi/AlterarFormaPagtoPlanoProduto")';
                var lista = incluiuNovaFormaPagamento ? oDatatableFormaPagamento.rows().data().toArray() : listaFormasPagamento;
                var novaFormaPagamentoCliente = lista.find(f => f.Id == $("#iNovaFormaPagto option:selected").val());

                const data = await $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        Id: $("#iNovaFormaPagto").val(),
                        Id_Forma_Pagamento: lista.find(f => f.Id == $("#iNovaFormaPagto option:selected").val()).Id_Forma_Pagamento,
                        Desc_Forma_Pagamento: $('#iNovaFormaPagto option:selected').attr('pagamentoDesc'),
                        Forma_Envio: novaFormaPagamentoCliente.Forma_Envio,
                        Desc_Forma_Envio: novaFormaPagamentoCliente.Desc_Forma_Envio,
                        Id_Vencimento: novaFormaPagamentoCliente.Id_Vencimento,
                        Desc_Banco: novaFormaPagamentoCliente.Desc_Banco,
                        Id_Banco: novaFormaPagamentoCliente.Id_Banco,
                        Conta_Corrente: novaFormaPagamentoCliente.Conta_Corrente,
                        Agencia: novaFormaPagamentoCliente.Agencia,

                        Digito: novaFormaPagamentoCliente.Digito,
                        Id_Cliente: novaFormaPagamentoCliente.Id_Cliente,
                        Id_PlanoProduto: oDatatablePlano.row(_row).data().Id,
                        Dia_Vencimento: novaFormaPagamentoCliente.Dia_Vencimento,
                        End_Cobranca_Igual_Principal: novaFormaPagamentoCliente.End_Cobranca_Igual_Principal,
                        Id_EnderecoCobranca: novaFormaPagamentoCliente.Id_EnderecoCobranca,
                        Id_Tipo_ImovelCobranca: novaFormaPagamentoCliente.Id_Tipo_ImovelCobranca,
                        Id_PaisCobranca: novaFormaPagamentoCliente.Id_PaisCobranca,
                        LatitudeCobranca: novaFormaPagamentoCliente.LatitudeCobranca,
                        LongitudeCobranca: novaFormaPagamentoCliente.LongitudeCobranca,

                        CEPCobranca: novaFormaPagamentoCliente.CEPCobranca,
                        LogradouroCobranca: novaFormaPagamentoCliente.LogradouroCobranca,
                        NumeroCobranca: novaFormaPagamentoCliente.NumeroCobranca,
                        BairroCobranca: novaFormaPagamentoCliente.BairroCobranca,
                        Id_BairroCobranca: novaFormaPagamentoCliente.Id_BairroCobranca,
                        Id_CidadeCobranca: novaFormaPagamentoCliente.Id_CidadeCobranca,
                        CidadeCobranca: novaFormaPagamentoCliente.CidadeCobranca,
                        UFCobranca: novaFormaPagamentoCliente.UFCobranca,
                        ComplementoCobranca: novaFormaPagamentoCliente.ComplementoCobranca,
                        Ponto_ReferenciaCobranca: novaFormaPagamentoCliente.Ponto_ReferenciaCobranca
                    },
                    beforeSend: function () {
                        $("#divProgress").show();
                    }
                });

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    location.href = "@Html.Raw(Url.Action("ClienteDadosGerais", "Venda", new { Id_Venda = Model.Id }))";
                    window.location.reload(true);
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    $("#divProgress").hide();
                }
            } else {
                var dataTemp = oDatatablePlano.row(_row).data();
                dataTemp.Desc_Forma_Pagto = $('#iNovaFormaPagto option:selected').attr('pagamentoDesc');
                dataTemp.Id_Forma_De_Pagamento = lista.find(f => f.Id == $("#iNovaFormaPagto option:selected").val()).map(f => f.Id_Forma_Pagamento);
                dataTemp.Id_Forma_Pagamento_Cliente = $('#iNovaFormaPagto option:selected').val();
                oDatatablePlano.row(_row).data(dataTemp).draw();
            }
        });

