                    @*Atualiza a barra de progresso, aonde o ícone ficará com a cor azul*@
                    updateProgressBar();

                } else {
                    Notificar("@RsBase.ATENCAO_", retorno.mensagem, "warning");
                }
            });

            $("#btnAnterior").click(async function () {
                const $etapaAtual = $(".etapa-venda[data-etapa-atual]");
                const etapaAtual = $etapaAtual.data("etapa");

                @* Removendo evento de click associado à etapa atual para que a modal das consultas de pendências não
                   fiquem disponíveis ao desfazer esssas etapas *@
                $etapaAtual.unbind("click");

                @* Lista de elementos em JS puro (não são elementos do jQuery!!!) com as etapas da barra de progresso *@
                const elemEtapas = $(".etapa-venda").toArray();

                @* Pegando o index da etapa atual da venda.

                É necessário acessar o "$etapaAtual[0]" pois o jQuery retorna uma lista de elementos que se
                encaixam no seletor informado na definição da variável e, como sabemos que sempre haverá apenas um elemento
                marcado como etapa atual, temos que selecionar sempre o primeiro ínidice dessa lista*@
                const idxEtapaAtual = elemEtapas.indexOf($etapaAtual[0]);

                const $novaEtapaAtual = $(elemEtapas[idxEtapaAtual - 1]);
                const novaEtapa = $novaEtapaAtual.data("etapa");

                const dataAtual = await alterarStatusEtapaVenda(etapaAtual, STATUS_ETAPA_PENDENTE);

                if (!dataAtual.ok) {
                    Notificar("@RsBase.ATENCAO_", "Erro ao gravar a etapa atual como pendente", "warning");
                }

                const dataAnterior = await alterarStatusEtapaVenda(novaEtapa, STATUS_ETAPA_PENDENTE);

                if (!dataAnterior.ok) {
                    Notificar("@RsBase.ATENCAO_", "Erro ao gravar a etapa anterior como pendente", "warning");
                }

                @* Adicionando o etapa-atual no dataset do novo elemento da etapa atual da barra de progresso.
                   O valor é apenas um placeholder uma vez que não leremos o valor do etapa-atual, só precisamos
                   verificar se o campo etapa-atual existe, independente do valor que está lá dentro.*@
                $novaEtapaAtual.attr("data-etapa-atual", "");
                $etapaAtual.removeAttr("data-etapa-atual");
                @* Essa chamada é necessária para remover o atributo do cache interno do jQuery *@
                $etapaAtual.removeData("data-etapa-atual");

                @*
                    Procurando o input da etapa anterior e da etapa atual cujo name termine com "Status" para definir os status das etapas como pendente
                    Referência: https://api.jquery.com/attribute-ends-with-selector/

                    Essa solução definitivamente não é a ideal mas foi a escolhida devido a falta de tempo,
                    sinta-se livre para refatorar no futuro
                *@
                $(`input[data-etapa=${etapaAtual}][name$="Status"]`).val(STATUS_ETAPA_PENDENTE);
                $(`input[data-etapa=${novaEtapa}][name$="Status"]`).val(STATUS_ETAPA_PENDENTE);

                $("#iEtapaAtualVenda").val($novaEtapaAtual.data("etapa"));

                updateProgressBar();
            });

            $("#btnGravar").click(async function () {
                                @* Verificando se o termo de adesão foi assinado ao gravar qualquer etapa que venha após a etapa do termo de adesão *@

                const $etapaTermoAdesao = $(`.etapa-venda[data-etapa='${ETAPA_TERMO_ADESAO}']`);

                const retorno = await $.ajax({
                    type: "GET",
                    url: "@CONSTANTES.URLPortal/api/TermoAdesaoApi/CheckTermoAssinado?idVenda=@Model.Id",
                    dataType: "json"
                });

                if (retorno != null && retorno.ok) {
                    const checkTermoAssinado = retorno.objeto;

                    if (checkTermoAssinado) {
                        $etapaTermoAdesao.removeClass("aguardandoGestor");
                        $etapaTermoAdesao.removeClass("reprovado");

                        $etapaTermoAdesao.addClass("done");
                        $(`input[data-etapa=${ETAPA_TERMO_ADESAO}][name$="Status"]`).val(STATUS_ETAPA_APROVADA);
                    }
                    else {
                        $etapaTermoAdesao.removeClass("aguardandoGestor");
                        $etapaTermoAdesao.removeClass("done");

                        //deve ficar pendente
                        /*$etapaTermoAdesao.addClass("reprovado");*/
                        $(`input[data-etapa=${ETAPA_TERMO_ADESAO}][name$="Status"]`).val(STATUS_ETAPA_PENDENTE);

                        let retornoAlterarStatus = await alterarStatusEtapaVenda(ETAPA_TERMO_ADESAO, STATUS_ETAPA_PENDENTE);

                        if (!retornoAlterarStatus.ok) {
                            Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de Termo de Adesão como reprovada", "warning");
                            return;
                        }
                    }
                }
                else {
                    Notificar("@RsBase.ATENCAO_", "Erro ao gravar a etapa de  Termo de Adesão", "warning");
                    return;
                }

                let statusCartao = false;

                if (CONTEM_ETAPA_CARTAO) {

                    var idCliente = "@Model.Id_Cliente";
                    await $.ajax({
                        url: "@CONSTANTES.URLPortal" + "/api/clienteapi/VerificaStatusCartao",
                        method: "POST",
                        data: { idCliente: idCliente }
                    })
                        .done(async function (data) {

                            if (data.ok) {
                                if (data.idObjeto.temPlanProdAtrelado) {
                                    if (data.idObjeto.idStatus != "1") {
                                        statusCartao = false;
                                        return data.idObjeto.idStatus == "0" ? Notificar("@RsBase.ATENCAO_", "Preenchimento do Cartão pendente", "warning") : Notificar("@RsBase.ATENCAO_", "Cartão Recusado ou Inválido.", "warning");
                                    }
                                    else {
                                        statusCartao = data.idObjeto.idStatus == "1" ? true : false;
                                    }
                                }
                                else {
                                    statusCartao = true;
                                }
                            }
                            else {
                                statusCartao = false;
                                Notificar("@RsBase.ATENCAO_", "Erro ao gravar a etapa de Dados do Cartão", "warning");
                                return;
                            }
                        });
                }

                if (CONTEM_ETAPA_CARTAO && statusCartao == false)
                    return;
                const etapaAtual = $(".etapa-venda[data-etapa-atual]").data("etapa");

                if (statusCartao) {
                    await alterarStatusEtapaVenda(etapaAtual, 1);
                    $(`input[data-etapa=${etapaAtual}][name$="Status"]`).val(1);
                }
                localStorage.setItem("btn_gravar", "btn_gravar");
                ValidaSubmit(etapaAtual, true);
            })
        }


