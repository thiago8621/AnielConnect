        function mudancaEtapaConsulta(etapa, status) {

            const etapaAtual = $(".etapa-venda[data-etapa-atual]").data("etapa");

            //gravação caso o parametro etapa seja referente a mesma etapa que estamos
            if (etapa == etapaAtual) {
                initProgressBar();
            }
            else {

                let arrayEtapas = $.makeArray($(".etapa-venda"));
                let objEtapas = [];
                arrayEtapas.forEach(function (value, index) {
                    objEtapas.push({ name: "", etapa: value.getAttribute("data-etapa") });
                });

                let etapaEncontrada = objEtapas.find(p => p.etapa == etapa);

                //Atualização do input para gravação
                $(`input[data-etapa=${etapa}][name$="Status"]`).val(status)
                //Atualização da cor da etapa
                switch (status) {
                    case STATUS_ETAPA_APROVADA:
                        $(`.etapa-venda[data-etapa=${etapaEncontrada.etapa}]`).removeClass("reprovado");
                        $(`.etapa-venda[data-etapa=${etapaEncontrada.etapa}]`).removeClass("aguardandoGestor");
                        //inserção de classe
                        $(`.etapa-venda[data-etapa=${etapaEncontrada.etapa}]`).addClass("done");
                        break;

                    case STATUS_ETAPA_REPROVADA:
                        $(`.etapa-venda[data-etapa=${etapaEncontrada.etapa}]`).removeClass("done");
                        $(`.etapa-venda[data-etapa=${etapaEncontrada.etapa}]`).removeClass("aguardandoGestor");
                        //inserção de classe
                        $(`.etapa-venda[data-etapa=${etapaEncontrada.etapa}]`).addClass("reprovado");

                        break;

                    case STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR:
                        $(`.etapa-venda[data-etapa=${etapaEncontrada.etapa}]`).removeClass("done");
                        $(`.etapa-venda[data-etapa=${etapaEncontrada.etapa}]`).removeClass("reprovado");
                        //inserção de classe
                        $(`.etapa-venda[data-etapa=${etapaEncontrada.etapa}]`).addClass("aguardandoGestor");
                        break;
                }
            }
        }


        $("#iExecutarConsultaViabilidade").on("click", async function () {

            if (vendaaprovada)
            {
                Notificar("@RsBase.ATENCAO_", "Não é possível realizar nova consulta, venda se encontra concluída.", "warning");
                return;
            }

            let latitude = Number($("#iLatitudeInstalacao").val().replace(",", "."));
            let longitude = Number($("#iLongitudeInstalacao").val().replace(",", "."));

            if (latitude == 0 && longitude == 0) {
                Notificar("@RsBase.ATENCAO_", "@RsCadastros.CRITICA_LATITUDE_LONGITUDE_VIABILIDADE", "warning");
                return;
            }

            $("#divProgress").show();

            const logradouro = $("#iId_Endereco_LogradouroInstalacao").val();
            const numero = $("#iNumeroInstalacao").val();

            const descricaoLogradouro = $("#iLogradouroInstalacao").val();
            const cidade = $("#iCidadeInstalacao").val();
            const condominio = $("#iCondominioInstalacao").val() == "true" ? $("#iId_Condominio_PredioInstalacao").val() : null;
            //Condomínio
            const bloco = $("#iBlocoSelectInstalacao").val();
            const apto_numero = $("#iApartamentoSelectInstalacao").val();

            const result = await ExecutarConsultaViabilidade(
                latitude,
                longitude,
                logradouro,
                numero,
                descricaoLogradouro,
                cidade,
                condominio,
                bloco,
                apto_numero
            );



            if (result == null || !result.ok) {
                Notificar("@RsBase.ATENCAO_", "Erro ao executar a consulta de viabilidade", "warning");
                $("#divProgress").hide();
                return;
            }

            @* Preenchimento dos dados da consulta de viabilidade realizada*@

