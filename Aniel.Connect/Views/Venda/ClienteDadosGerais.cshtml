        var HandleCombo = function () {
            $('#iComboSelect').on('select2:select select2:unselecting', async function (e) {
                if (e.params.data != undefined) {
                    const comboSelecionado = e.params.data;

                    ShowPageLoading();

                    const responseComboPermitido = await fetch("@CONSTANTES.URLPortal/api/ComboApi/ComboDisponivel/" + comboSelecionado.id + "/@Model.CpfCnpj")

                    const comboPermitido = await responseComboPermitido.json();

                    HidePageLoading();

                    if (!comboPermitido) {
                        Notificar("@RsBase.ATENCAO_", "Este cliente já possui uma assinatura ativa para este plano. Não é possível contratar o mesmo plano novamente", "warning");
                        $('#iComboSelect').val(null).trigger('change');
                        return false;
                        }

                    $("#iValorReal").val(comboSelecionado.valor);
                    //$("#iValor_Final").val(comboSelecionado.valor);

                    if (comboSelecionado.usaTecnologiaInternet) {
                        $("#iTipoTecnologia").val('2');
                    }
                    else {
                        $("#iTipoTecnologia").val('');
                    }

                    if (comboSelecionado.valorInstalacao !== null) {
                        $("#iValorInstalacao").val(comboSelecionado.valorInstalacao);
                        //$("#iValor_Instalacao_Final").val(comboSelecionado.valorInstalacao);

                        @if (AcessoHelper.TemAcesso(ViewBag.Areas, "323"))
                        {
                            <text>$("#iNumero_Parcelas_Instalacao").removeClass("readonly");</text>
                        }
                    }
                    else {
                        @if (!AcessoHelper.TemAcesso(ViewBag.Areas, "323"))
                        {
                            <text>$("#iNumero_Parcelas_Instalacao").addClass("readonly");</text>
                        }
                    }

                    if (comboSelecionado.check_DiasTesteGratis) {
                        $("#iCheckTesteGratis").prop("checked", comboSelecionado.check_DiasTesteGratis);
                        $("#iQtde_Dias").prop("disabled", false).val(comboSelecionado.qtdeDiasGratis);
                    }
                    else {
                        $("#iQtde_Dias").prop("disabled", "disabled").val(null);
                    }

                    if (comboSelecionado.checkVigenciaContrato) {
                        $("#iCheckPeriodoCarencia").prop("checked", comboSelecionado.checkVigenciaContrato);
                        $("#iMeses_Carencia").prop("disabled",false).val(comboSelecionado.periodoFidelidade);
                    }
                    else {
                        $("#iMesesCarencia").prop("disabled", "disabled").val(null);
                    }

                    $("#iDetalhesCombo").prop("id_Modelo_Contrato",`${comboSelecionado.id_Modelo_Contrato}`);
                    $("#iDetalhesCombo").show();

                    AddSelect("iModelo_Contrato", "@CONSTANTES.URLPortal/api/Modelo_ContratoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, comboSelecionado.id_Modelo_Contrato, "@RsBase.SELECIONE", vendaaprovada, HandleModelo_Contrato, null, null, null, true);
                }
                else {
                    $("#iDetalhesCombo").hide();
                    $("#iTipoTecnologia").val('');
                }
            });
        };


