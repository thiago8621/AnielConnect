@using Sinapse.Model.enumerados;
@using Microsoft.AspNet.Identity;

@model Aniel.Connect.Repository.Model.VendaDadosGeraisViewModel

@using Aniel.Connect.Models
@using Aniel.Connect.Model.enumerado
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.ControllersWebApi
@using Aniel.Connect.Models.T5
@using Aniel.Connect.Repository.Model

@{
    ViewBag.Title = RsCadastros.VENDAS_DADOS_GERAIS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    var Titulo_Modal = String.Join(" e ", new List<String> { RsCadastros.COMBO, RsCadastros.CAMPANHA }.Select(word => word + "s"));
    List<Aniel.Connect.Models.T5.AreaModuloModel> _areas = ViewBag.Areas;

    //Lista Lado
    List<Aniel.Connect.Core.ObjComboResult<String>> listaLadoAceite = new List<Aniel.Connect.Core.ObjComboResult<String>>();
    foreach (var valor in Enum.GetValues(typeof(Lado_Doc_Aceite)))
    {
        string descricao = HtmlEnumExtensions.GetEnumDescription(valor);
        listaLadoAceite.Add(new Aniel.Connect.Core.ObjComboResult<string>
        {
            Id = Convert.ToInt32(valor).ToString(),
            Text = descricao
        });
    }
    listaLadoAceite = listaLadoAceite.OrderBy(x => x.Text).ToList();


    //Lista TipoDocumento
    List<Aniel.Connect.Core.ObjComboResult<String>> listaTipoDocAceite = new List<Aniel.Connect.Core.ObjComboResult<String>>();
    foreach (var valor in Enum.GetValues(typeof(Tipo_Doc_Termo_Anexo)))
    {
        string descricao = HtmlEnumExtensions.GetEnumDescription(valor);
        listaTipoDocAceite.Add(new Aniel.Connect.Core.ObjComboResult<string>
        {
            Id = Convert.ToInt32(valor).ToString(),
            Text = descricao
        });
    }
    listaTipoDocAceite = listaTipoDocAceite.OrderBy(x => x.Text).ToList();

    //Lista Status Documento
    List<Aniel.Connect.Core.ObjComboResult<String>> listaStatusAceite = new List<Aniel.Connect.Core.ObjComboResult<String>>();
    foreach (var valor in Enum.GetValues(typeof(Status_Doc_Aceite)))
    {
        string descricao = HtmlEnumExtensions.GetEnumDescription(valor);
        listaStatusAceite.Add(new Aniel.Connect.Core.ObjComboResult<string>
        {
            Id = Convert.ToInt32(valor).ToString(),
            Text = descricao
        });
    }
    listaStatusAceite = listaStatusAceite.OrderBy(x => x.Text).ToList();


    var camposObrigatorios = (Dictionary<string, bool>)ViewBag.CamposObrigatorios;
    var camposBloqueados = (Dictionary<string, bool>)ViewBag.CamposBloqueados;

    var stringObrigatorio = Html.Raw("<span class=\"text-danger\">* </span>");
    var dominio_conf = Convert.ToBoolean(ViewBag.Criacao_Atendimento_DominioEmail);
    var urlBaseCriarOS = Html.Raw(Url.Action("Criar_Ordem_Servico", "Painel_Servicos", new { Id_Cliente = Model.Id_Cliente, Id_Venda = Model.Id }));
    bool configEnd_Insta_Mesmo_Princ = Convert.ToBoolean(ViewBag.End_Insta_Mesmo_Princ);



    if (TempData["Usuario_Vendedor"] == null)
    {
        TempData["Usuario_Vendedor"] = true;
    }

    bool usuarioVendedor = Convert.ToBoolean(TempData["Usuario_Vendedor"]);

    bool contemEtapaCartao = Convert.ToBoolean(Model.EtapasVenda.Any(x => x.Etapa == (int)EnumEtapaVenda.CartaoCredito));
    var classBloqueioCampoFundoCinza = Model.Status == Status_Venda.Venda_Aprovada || Model.Status == Status_Venda.Venda_Cancelada;
    List<KeyValuePair<int, string>> integracoes = ViewBag.IntegracaoConfigurada != null ? ViewBag.IntegracaoConfigurada : new List<KeyValuePair<int, string>>();

    if (integracoes == null)
    {
        integracoes = new List<KeyValuePair<int, string>>();
    }
}


