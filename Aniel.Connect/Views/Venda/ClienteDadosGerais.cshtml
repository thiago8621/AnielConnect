        function handleExcluirFormaPagamento() {

            $("#btnExcluirFormaPagamento").unbind('click');
            $("#datatableFormaPagamento").on('click', '#btnExcluirFormaPagamento', function (e) {

                // Validando o status do termo Adesao DS4039
                if (termo_adesao_assinado) {
                    Notificar("@RsBase.ATENCAO_", "Termo Adesão Aprovado não é possivel alterar Detalhes do Plano", "warning");
                } else {
                    e.preventDefault();

                    Swal.fire({
                        title: "Deseja excluir Forma de Pagamento?",
                        type: 'question',
                        html: '<p>Não será possível retroceder a ação.</p>',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Sim',
                        cancelButtonText: 'Não'
                    }).then((result) => {
                        if (!result.value) {
                            return;
                        }
                        else {
                            var idArquivo = $(this).attr("excluir");
                            var trLinkButton = $(this).parents('tr');

                            //console.log(idArquivo);
                            //return;


                            if (idArquivo == 0) {
                                oDatatableFormaPagamento.row(trLinkButton).remove().draw(false);

                                if (oDatatableFormaPagamento.rows().data().toArray().length === 1)
                                {
                                    let linhaAnterior = oDatatableFormaPagamento.row(0).data();
                                    linhaAnterior["Selecionado"] = true;
                                    oDatatableFormaPagamento.row(0).data(linhaAnterior).draw(false);
                                }

                                listaFormasPagamento = [];
                                listaFormasPagamento = oDatatableFormaPagamento.rows().data();

                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Forma_Pagamento_Clienteapi/ExcluirGrid?value=")' + idArquivo + "&idVenda=" + @Model.Id;

                                $.ajax({
                                    url: link,
                                    type: 'GET',
                                    dataType: 'json',
                                })
                                    .done(function (data) {

                                        if (data.ok) {
                                            oDatatableFormaPagamento.row(trLinkButton).remove().draw(false);
                                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                        }
                                        else {
                                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                        }
                                    });
                            }
                        }
                    });
                }//DS4039
            });
        }


