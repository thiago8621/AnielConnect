        async function AdicionarInformacaoComplementar()
        {
            if (vendaaprovada)
            {
                Notificar("@RsBase.ATENCAO_", "Não é possível adicionar nova informação complementar, venda se encontra concluída.", "warning");
                return;
            }

            let texto =  await parent.Swal.fire({
                title: 'Adicione uma informação complementar',
                input: 'textarea',
                inputAttributes: {
                    autocapitalize: 'off'
                },
                showCancelButton: true,
                confirmButtonText: '@RsBase.CONFIRMAR',
                cancelButtonText: '@RsBase.CANCELAR',
                showLoaderOnConfirm: true,
                preConfirm: (texto) => {

                    if (!texto.value)
                        Swal.showValidationMessage(`Nenhum dado informado`);

                    return texto;
                },
                allowOutsideClick: () => !Swal.isLoading()
            });

            if (texto.value)
            {
                let info = `[@User.Identity.GetUserName() - ${moment().format('DD/MM/YYYY HH:mm:ss')}]: ${texto.value}`;
                const link = '@String.Concat(CONSTANTES.URLPortal, "/api/VendaApi/AdicionarInformacaoComplementar")';
                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        IdVenda : @Model.Id,
                        Informacao : info
                    },
                    beforeSend: function () {
                        ShowPageLoading();
                    },
                    complete: function () {
                        HidePageLoading();
                    }
                }).done(function (data) {
                    if (data.ok) {
                        $(`#iInformacoesComplementares`).val(data.mensagem);
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                });
            }
        }
