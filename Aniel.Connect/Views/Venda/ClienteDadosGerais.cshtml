        async function ConsultarCpf(cpfCnpj) {
            $("#divProgress").show();

            let data = await $.ajax({
                url: "@String.Concat(CONSTANTES.URLPortal, "/api/Vendaapi/GetConsultaCpf")",
                type: 'POST',
                dataType: 'json',
                data: {
                    IdVenda: @Model.Id,
                    cpf: cpfCnpj
                }
            });

            if (data != null && !data.ok) {
                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
            }

            $("#divProgress").hide();

            return data;
        }

        async function GetResultadosParametrosRestricao() {
            try {
                const data =
                    await $.ajax({
                        url: "@String.Concat(CONSTANTES.URLPortal, "/api/Vendaapi/ResultParametrosRestricaoCreditoVenda")",
                        type: 'POST',
                        dataType: 'json',
                        data: {
                            IdVenda: @Model.Id,
                        }
                    });

                if (data != null && data.ok) {
                    $("#iStatusConsultaCredito").html(data.objeto);
                    if (data.objeto.toUpperCase() == "@(AprovacaoCriterioParametroCredito.REPROVADO)") {
                        $("#rowBtnAprovarManualCred").show();

                }
                }
                else if (data.mensagem != "CPF SEM TITULAR"){
                    throw new Error();
                }


                return data.objeto;
            }
            catch {
                Notificar("@RsBase.ATENCAO_", "Erro na consulta de restrição de crédito", "warning");
                return null;
            }
        }

