                    $etapaAtual.on("click", async function () {
                        await ExibirModalPendenciaFinanceira();
                    });
                    ValidaSubmit(etapa);
                }
                else if (etapa === ETAPA_CONSULTA_VIABILIDADE) {
                    let idConsultaViabilidade = null;
                    let possuiViabilidade = null;
                    let motivosInviabilidade = [];

                    let latitude = Number(latitudeBanco.replace(",", "."));
                    let longitude = Number(longitudeBanco.replace(",", "."));

                    if (latitude == 0 && longitude == 0) {
                        latitude = getLatitudeViabilidade();
                        longitude = getLongitudeViabilidade();

                        if (latitude == 0 && longitude == 0) {
                            Notificar("@RsBase.ATENCAO_", "@RsCadastros.CRITICA_LATITUDE_LONGITUDE_VIABILIDADE", "warning");
                            return;
                        }
                    }

                    const dadosConsultaViabilidade = await GetConsultaViabilidade(latitude, longitude);

                    if (dadosConsultaViabilidade != null && dadosConsultaViabilidade.ok) {
                        if (dadosConsultaViabilidade.objeto != null && dadosConsultaViabilidade.objeto.existeConsulta) {
                            possuiViabilidade = dadosConsultaViabilidade.objeto.possuiDisponibilidade;
                            idConsultaViabilidade = dadosConsultaViabilidade.objeto.idConsultaViabilidade;
                        }
                        else {
                            const logradouro = $("#iId_Endereco_LogradouroInstalacao").val();
                            const numero = $("#iNumeroInstalacao").val();

                            const descricaoLogradouro = $("#iLogradouroInstalacao").val();
                            const cidade = $("#iCidadeInstalacao").val();

                            //Condomínio
                            const condominio = $("#iCondominioInstalacao").val() == "true" ? $("#iId_Condominio_PredioInstalacao").val() : null;
                            const bloco = $("#iBlocoInstalacao").val();
                            const apto_numero = $("#iApartamentoInstalacao").val();

                            const result = await ExecutarConsultaViabilidade(
                                latitude,
                                longitude,
                                logradouro,
                                numero,
                                descricaoLogradouro,
                                cidade,
                                condominio,
                                bloco,
                                apto_numero
                            );

                            if (result != null && result.ok) {
                                possuiViabilidade = result.objeto.possuiDisponibilidade;

