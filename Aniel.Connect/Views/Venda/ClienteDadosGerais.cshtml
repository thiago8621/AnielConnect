            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/TermoAdesaoApi/getPdfTermoAdesao")' + "?IdVenda=" + "@Model.Id";

            $.ajax({
                url: link,
                type: 'GET',
                dataType: 'json',

                beforeSend: function () {
                    ShowPageLoading();
                },
                complete: function(){
                    HidePageLoading();
                }
             })
            .done(function (data) {
                if (data.ok) {
                    @{
                        string caminho = CONSTANTES.URLPortal + "/Arquivos/TermoAdesao/termo_adesao_" + Model.Id_Venda + ".pdf";
                    }
                    window.open("@caminho" + "?v=" + new Date().getTime());
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });
        }

