        $("#iExecutarConsultaPendenciaEndereco").on("click", async function () {

            if (vendaaprovada)
            {
                Notificar("@RsBase.ATENCAO_", "Não é possível realizar nova consulta, venda se encontra concluída.", "warning");
                $("#divProgress").hide();
                return;
            }

            let hasCadastroEndereco = Boolean($("#iBuscaEnderecoPrincipal").val());

            let logradouroP = $("#iLogradouroInstalacao").val();
            let numeroP = $("#iNumeroInstalacao").val();
            let cidadeP = $("#iCidadeInstalacao").val();
            let cepP = $("#iCEPInstalacao").val();

            if (!logradouroP) {
                Notificar("@RsBase.ATENCAO_", "Preencha o logradouro do endereço de instalação antes de fazer a consulta", "warning");
                $("#divProgress").hide();
                return;
            }

            if (!numeroP) {
                Notificar("@RsBase.ATENCAO_", "Preencha o número do endereço de instalação antes de fazer a consulta", "warning");
                $("#divProgress").hide();
                return;
            }

            $("#divProgress").show();

            const result = await ExecutarConsultaPendenciaEndereco(logradouroP, numeroP, cidadeP, cepP);

            const possuiPendenciaEndereco = result?.objeto?.possuiPendencia;

            if (result == null || !result.ok) {
                $("#divProgress").hide();

                Notificar("@RsBase.ATENCAO_", `Erro ao executar a consulta de pendência no endereço. \n\n\n\n\n\n\n\n\n\n ${result.mensagem}`, "warning");

                if(result.mensagem != "Não foi possível identificar o codigo auxiliar do endereço associado à venda para integração")
                {
                    $("#divProgress").hide();
                return;
            }
                else
                {
                    possuiPendenciaEndereco = false;
                }
            }


            if (possuiPendenciaEndereco) {
                if (CONSULTA_PENDENCIA_ENDERECO_RESTRINGE_VENDA) {
                    STATUS_CONSULTA_PENDENCIA_ENDERECO = STATUS_ETAPA_REPROVADA;
                }
                else {
                    STATUS_CONSULTA_PENDENCIA_ENDERECO = STATUS_ETAPA_AGUARDANDO_APROVACAO_GESTOR;
                }
            }
            else {
                STATUS_CONSULTA_PENDENCIA_ENDERECO = STATUS_ETAPA_APROVADA;
            }

            mudancaEtapaConsulta(ETAPA_CONSULTA_PENDENCIA_ENDERECO, STATUS_CONSULTA_PENDENCIA_ENDERECO);

            Notificar("@RsBase.INFORMACAO", "Consulta de pendência no endereço concluída", "info");

            TableManageButtonsPendenciaEndereco.init();

            $("#divProgress").hide();
        });

