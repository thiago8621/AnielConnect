        function OptionsPlano(obj = [{}], hascontrato = false) {

            try {
                for (let property of obj) {

                    //property["element"] = HTMLOptionElement;
                    property["hasContrato"] = property.id != undefined ? true : false;

                }
                //Se tiver contrato
                if (hascontrato) {
                    obj = obj.filter(p => p.hasContrato == true);
                }

                //Se não tiver contrato
                else {
                    obj.forEach(property, index => {
                        contador = 0;
                        if (property.id == null || property.id == undefined) {
                            //property.id = index;
                            property.id = contador++;
                        }
                    });
                    obj = obj.filter(p => p.hasContrato == false);
                }
            }
            catch (exception) { return []; }

            return obj;
        }

        function GerarOptionsDesconto(Planos) {
            let array = [];
            var lista_planos = Map.groupBy(Planos.data().toArray(), function ({ Id_Contrato }) { return Id_Contrato; });
            var lista_cliente_contratos = lista_planos.keys().toArray().sort();

            for (var i = 0; i < lista_cliente_contratos.length; i++) {
                var obj = Planos.data().toArray().filter(x => x.Id_Contrato == lista_cliente_contratos[i]);
                array.push(obj[0]);
            }

            array = array.map(p => { let obj = { id: p.Id, text: p.Numero_Contrato }; return obj; });

