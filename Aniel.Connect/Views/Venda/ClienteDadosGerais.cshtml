                        //$('#iValor_Instalacao_Final').addClass('readonly');

                        $('#iCheckTesteGratis').addClass('readonly');
                        $('#iQtde_Dias').addClass('readonly');

                        $('#iCheckPeriodoCarencia').addClass('readonly');
                        $('#iMeses_Carencia').addClass('readonly');

                        $("#iValorReal").addClass("readonly");
                        $("#iParcelas").addClass("readonly");
                        </text>
                    }

                    if (PlanoSelecionado.tipo == 1) {
                        if (PlanoSelecionado.autenticacaoRadius == true) {
                            $('#iDivBotaoLogin').show();
                        }

                        //verifica se vai pegar o valor do plano ou da campanha
                        if (($("#iCampanha").val() != "" && $("#iCampanha").val() != null &&
                            $("#iCampanha").val() != undefined && $("#iCampanha").val() > 0) &&
                            $("#iVendaCampanhaSim").is(':checked')) {
                            var idCampanha = $("#iCampanha").val();
                            var idPlanoProduto = $('#iPlano').val();

                            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/campanhaapi/GetValorPlanoProdutoCampanha?idCampanha=")' + idCampanha + "&idPlanoProduto=" + idPlanoProduto;

                            $.ajax({
                                url: link,
                                type: 'POST',
                                dataType: 'json'
                            })
                                .done(function (data) {
                                    if (data.ok) {
                                        $('#iValorReal').val((data.objeto[0].valor_Plano_Produto).toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                                        $('#iValorInstalacao').val((data.objeto[0].valor_Instalacao).toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                                    } else {
                                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                    }
                                })

                        }
                        else {
                            $('#iValorReal').val(PlanoSelecionado.valorPlanoProduto.toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                            $('#iValorInstalacao').val(PlanoSelecionado.valorInstalacao.toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                        }

                        if (modelo_Contrato !== null) {
                            $("#numContratoDiv").hide();

                            if (PlanoSelecionado.autenticacaoRadius == true) {
                                $('#iDivBotaoLogin').show();
                                $('#iDivBotaoPoolIp').show();
                            }
                            else {
                                $('#iDivBotaoLogin').hide();
                                $('#iDivBotaoPoolIp').hide();
                            }

                            $('#iCheckTesteGratis').prop('checked', modelo_Contrato.testeGratis);
                            $('#iQtde_Dias').val(modelo_Contrato.diasTeste);
                            $('#iCheckPeriodoCarencia').prop('checked', modelo_Contrato.tem_Carencia);
                            $('#iMeses_Carencia').val(modelo_Contrato.periodo_Carencia);
                        }
                        else {
                            $('#iCheckTesteGratis').prop('checked', false);
                            $('#iQtde_Dias').val("");
                            $('#iCheckPeriodoCarencia').prop('checked', "");
                            $('#iMeses_Carencia').val("");
                        }

                        if ($('#iMeses_Carencia').val() > 0) {
                            $('#iCheckPeriodoCarencia').attr('checked', true);
                        }

                        $('#iNumero_Parcelas_Instalacao').val(PlanoSelecionado.numero_Parcelas);
                    }
                    else if (PlanoSelecionado.tipo == 2) {
                        if (PlanoSelecionado.autenticacaoRadius == true) {
                            $('#iDivBotaoLogin').show();
                        }
                        else {
                            $('#iDivBotaoLogin').hide();
                        }
                        $('#iValorReal').val(PlanoSelecionado.valorPlanoProduto);
                        $('#iValorReal').text(PlanoSelecionado.valorPlanoProduto);
                        $('#iDivBotaoPoolIp').show();

                        //$('#iValor_Final').val(PlanoSelecionado.valorPlanoProduto);
                    }

                    $('#iCheckTesteGratis').prop('checked', PlanoSelecionado.teste_Gratis);
                    $('#iQtde_Dias').val(PlanoSelecionado.qtde_Dias);

                    $('#iCheckPeriodoCarencia').prop('checked', PlanoSelecionado.periodo_Carencia);
                    $('#iMeses_Carencia').val(PlanoSelecionado.meses_Carencia);

                    if (PlanoSelecionado.tipo === 1) {
                        $('#iDetalhesPlano').show();
                        $('#iDetalhesProduto').hide();
                        $('#iDetalhesCombo').hide();
                    }
                    else {

                        $('#iDetalhesPlano').hide();
                        $('#iDetalhesCombo').hide();
                        $('#iDetalhesProduto').show();
                    }
                    ValorVendaAgrupada = PlanoSelecionado.valorVendaAgrupada;
                    UtilizaVendaAgrupada = PlanoSelecionado.utilizaVendaAgrupada;
                }
                else {
                    $("#iTipoTecnologia").val("");
                    $('#iDetalhesPlano').hide();
                    $('#iDetalhesCombo').hide();
                    $('#iDetalhesProduto').show();

                    $('#iNumero_Parcelas_Instalacao').val(null).trigger("change");
                    $('#iValorReal').val(null).trigger("change");
                    $('#iValorInstalacao').val(null).trigger("change");
                    //$('#iValor_Instalacao_Final').val(null).trigger("change");
                    //$('#iValor_Final').val(null).trigger("change");

                    $("#iValorEntrada").addClass("readonly");
                    $("#iQuantidade").addClass("readonly");
                    $("#iParcelas").addClass("readonly");

                    $(".ocultar_parcela_entrada").addClass("d-none");
                    $(".ocultar_valor_entrada").addClass("d-none");
                    $(".ocultar_quantidade_valor_plano").addClass("d-none");

                    $("#iValorEntrada").val(null).trigger("change");
                    $("#iQuantidade").val(null).trigger("change");
                    $("#iParcelas").val(null).trigger("change");
                    $("#iValorTotalPlano").val(null).trigger("change");

                    ValorVendaAgrupada = 0;
                    UtilizaVendaAgrupada = false;
                }

                if (modelo_Contrato === null) {
                    // O getContratoVinculadoPlano já verifica o model de contrato cadastrado dentro do plano na hora de preencher o modelo_Contrato.
                    // Se o modelo_Contrato esteja nulo o ID do Modelo de Contrato obrigatoriamente estará nulo também.
                    AddSelect("iModelo_Contrato", "@CONSTANTES.URLPortal/api/Modelo_ContratoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", vendaaprovada, HandleModelo_Contrato, null, null, null, true);
                }
                else {
                    AddSelect("iModelo_Contrato", "@CONSTANTES.URLPortal/api/Modelo_ContratoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, modelo_Contrato.id, "@RsBase.SELECIONE", vendaaprovada, HandleModelo_Contrato, null, null, null, true);
                }

                const valorInstalacaoNumber = Number($('#iValorInstalacao').val()?.replace(",", "."));

                if (valorInstalacaoNumber) {
                    $('#iNumero_Parcelas_Instalacao').val("1");
                }

                @if (AcessoHelper.TemAcesso(ViewBag.Areas, "337"))
                {
                    <text>
                    $('#iCheckTesteGratis').trigger('change');
                    $('#iCheckPeriodoCarencia').trigger('change');
                    </text>
                }
                else
                {
                    <text>
                    $('#iCheckTesteGratis').prop('disabled', true);
                    $('#iCheckPeriodoCarencia').prop('disabled', true);

                    DisableSelect("iModelo_Contrato");
                    </text>
                }
            });
        }

