        function gerarChecklist(ok = false) {
            if(!ok){
                VendaCancelada();
                return;
            }
            const url = '@String.Format("{0}/{1}",CONSTANTES.URLPortal, "api/vendaapi/AssociarChecklistVenda")';
            $.post({ url: url, data: { Id:@Model.Id}, type: "POST", dataType: "json" })
                .done(function (data) {
                    if (data.ok) {
                        $("#checklist-tab").trigger("click");
                        Notificar("@RsBase.INFORMACAO", "Checklist foi associado a venda.", "info");
                    }
                    else {
