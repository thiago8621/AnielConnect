                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", "Erro ao verificar se já existe consulta de viabilidade", "warning");
                        return;
                    }

                    if (!possuiViabilidade || possuiViabilidade == VIABILIDADE_REPROVADA) {
                        if (CONSULTA_VIABILIDADE_RESTRINGE_VENDA) {
                            @* Aplicação da regra de visualização do status da consulta *@
                            if (!USUARIO_VENDEDOR || CONSULTA_VIABILIDADE_VENDEDOR_VISUALIZA) {
                                $etapaAtual.removeClass("aguardandoGestor");
                                $etapaAtual.removeClass("done");

                                $etapaAtual.addClass("reprovado");
