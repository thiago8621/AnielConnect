        async function CarregaPlanoAntigo(_IdTrocaPlano, value, tipo, value) {
            var link = "@CONSTANTES.URLPortal/api/clienteapi/GetComboMudancaPlano";
            const data = await $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    idpai: value,
                    idavo: "@Model.Id_Cliente"
                },
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                }
            });

            if (data.results.length > 0) {
                $(`#iPlanoAntigo${tipo}`).empty();
                $(`#iPlanoAntigo${tipo}`).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
                $.each(data.results, function (key, value) {
                    $(`#iPlanoAntigo${tipo}`).append($('<option>', {
                        value: value.id,
                        text: value.text,
                        selected: value.id == _IdTrocaPlano ? true : false
                    }));
                });
            } else {
                $(`#iPlanoAntigo${tipo}`).empty();
                $(`#iPlanoAntigo${tipo}`).append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));
            }
        }

        $('#datatablePlanos tbody').on('click', '.linkMudarPlano', async function (e) {
            var $row = $(this).closest('tr');
            $('#iModalMudancaPlano').modal('show');
            $("#iIdClientePlanoProduto").val($(this).attr("IdClientePlanoProduto"));
            var _IdTrocaPlano = $(this).attr("IdTrocaPlano");
            let value = e.currentTarget.getAttribute("externalprop");
            $('#iModalMudancaPlano').prop("externalprop", value);
            CarregaPlanoAntigo(_IdTrocaPlano, value, "_dataTable");
        });

