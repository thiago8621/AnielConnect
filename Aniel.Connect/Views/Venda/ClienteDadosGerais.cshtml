            get calculoAcrescimoPercentual() {
                if (oDatatablePlano.data().toArray().length > 0) {
                    var agrupamento_planos = Object.groupBy(oDatatablePlano.data().toArray(), function ({ Id_Contrato }) { return Id_Contrato; });
                    var lista_planos = Map.groupBy(oDatatablePlano.data().toArray(), function ({ Id_Contrato }) { return Id_Contrato; });
                    var lista_cliente_contratos = lista_planos.keys().toArray();

                    var resultado_percentual = 0, valor_total_contratos = 0, valor_total_desconto = 0, valor_total_percentual = 0;
                    if (lista_cliente_contratos.length > 0) {
                        for (var i = 0; i < lista_cliente_contratos.length; i++) {
                            var id_cliente_contrato = lista_cliente_contratos[i];
                            var lista_cliente_desconto = oDatatable.data().toArray().filter(x => x.numeroContratoVinculado == id_cliente_contrato);

                            if (lista_cliente_desconto.length > 0) {
                                var valor_desconto = 0, valor_percentual = 0;
                                for (var j = 0; j < lista_cliente_desconto.length; j++) {
                                    if (lista_cliente_desconto[j].Formato == 0) {
                                        valor_desconto += parseFloat(lista_cliente_desconto[j].Valor_Desconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.'));
                                        valor_percentual += parseFloat(lista_cliente_desconto[j].Percentual_Desconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.'));
                                    }
                                }

                                var formato = lista_cliente_desconto.filter(x => x.Formato == 0);
                                if (formato.length > 0) {
                                    let valorAPagar = agrupamento_planos[id_cliente_contrato].map(p => parseFloat(p.ValorPlanoProduto.toString().replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.'))).reduce((b, c) => b + c, 0);
                                    valor_total_contratos += valorAPagar;

                                    if (valor_desconto > 0) {
                                        valor_total_desconto += valor_desconto;
                                    }

                                    if (valor_percentual > 0) {
                                        valor_total_percentual += valor_percentual;
                                    }
                                } else {
                                    resultado_percentual = 0.0;
                                }
                            }
                        }
                        valor_total_desconto = valor_total_desconto > 0 ? ((valor_total_desconto / valor_total_contratos) * 100) : 0;

                        valor_total_percentual = valor_total_percentual > 0 ? valor_total_percentual : 0;
                        resultado_percentual = valor_total_desconto + valor_total_percentual;
                        return resultado_percentual;
                    }
                } else {
                    return 0.0;
                }
            },
            get calculoAcrescimo() {
                var agrupamento_planos = Object.groupBy(oDatatablePlano.data().toArray(), function ({ Id_Contrato }) { return Id_Contrato; });
                var lista_planos = Map.groupBy(oDatatablePlano.data().toArray(), function ({ Id_Contrato }) { return Id_Contrato; });
                var lista_cliente_contratos = lista_planos.keys().toArray();

                var valorAPagar = 0;
                if (lista_cliente_contratos.length > 0) {
                    for (var i = 0; i < lista_cliente_contratos.length; i++) {
                        var id_cliente_contrato = lista_cliente_contratos[i];
                        var lista_cliente_desconto = oDatatable.data().toArray().filter(x => x.numeroContratoVinculado == id_cliente_contrato);
                        if (lista_cliente_desconto.length > 0) {
                            if (lista_cliente_desconto.filter(x => x.Formato == 0).length > 0) {
                                valorAPagar += agrupamento_planos[id_cliente_contrato].map(p => parseFloat(p.ValorPlanoProduto.toString().replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.'))).reduce((b, c) => b + c, 0);
                            }
                        }
                    }
                }
                let totalPagar = ((valorAPagar * this.calculoAcrescimoPercentual) / 100);
                return totalPagar;
            },
            get calculoDescontoPercentual() {
                if (oDatatablePlano.data().toArray().length > 0) {
                    var agrupamento_planos = Object.groupBy(oDatatablePlano.data().toArray(), function ({ Id_Contrato }) { return Id_Contrato; });
