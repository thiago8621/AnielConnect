        function setarAbas() {
            if ("@Model.Id" == "0") {
                localStorage.setItem("aba_atual", "dados_gerias");
            }

            localStorage.removeItem("btn_gravar");
            var get_localStorage = localStorage.getItem("detalhes_planos_produtos");
            if (get_localStorage == null) {
                get_localStorage = localStorage.getItem("aba_atual");
            }
            switch (get_localStorage) {
                case "financeiro":
                    $("#financeiro-tab").trigger("click");
                    $("#financeiro-tab").addClass("active");

                    $("#dadosgerais-tab").removeClass("active");
                    $("#planos-tab").removeClass("active");
                    $("#checklist-tab").removeClass("active");
                    $("#historicoAtendimento-tab").removeClass("active");
                    $("#historicoOrdemServico-tab").removeClass("active");
                    $("#venda-tab").removeClass("active");
                    $("#termo-tab").removeClass("active");
                    break;
                case "planos_produtos":
                    $("#planos-tab").trigger("click");
                    $("#planos-tab").addClass("active");

                    $("#dadosgerais-tab").removeClass("active");
                    $("#financeiro-tab").removeClass("active");
                    $("#checklist-tab").removeClass("active");
                    $("#historicoAtendimento-tab").removeClass("active");
                    $("#historicoOrdemServico-tab").removeClass("active");
                    $("#venda-tab").removeClass("active");
                    $("#termo-tab").removeClass("active");

                    localStorage.removeItem("detalhes_planos_produtos");
                    break;
                case "atendimento":
                    $("#historicoAtendimento-tab").trigger("click");
                    $("#historicoAtendimento-tab").addClass("active");

                    $("#financeiro-tab").removeClass("active");
                    $("#planos-tab").removeClass("active");
                    $("#dadosgerais-tab").removeClass("active");
                    $("#checklist-tab").removeClass("active");
                    $("#historicoOrdemServico-tab").removeClass("active");
                    $("#venda-tab").removeClass("active");
                    $("#termo-tab").removeClass("active");
                    break;
                case "ordem_sevicos":
                    $("#historicoOrdemServico-tab").trigger("click");
                    $("#historicoOrdemServico-tab").addClass("active");

                    $("#financeiro-tab").removeClass("active");
                    $("#planos-tab").removeClass("active");
                    $("#dadosgerais-tab").removeClass("active");
                    $("#checklist-tab").removeClass("active");
                    $("#historicoAtendimento-tab").removeClass("active");
                    $("#venda-tab").removeClass("active");
                    $("#termo-tab").removeClass("active");
                    break;
                case "historico_venda":
                    $("#venda-tab").trigger("click");
                    $("#venda-tab").addClass("active");

                    $("#financeiro-tab").removeClass("active");
                    $("#planos-tab").removeClass("active");
                    $("#dadosgerais-tab").removeClass("active");
                    $("#historicoAtendimento-tab").removeClass("active");
                    $("#historicoOrdemServico-tab").removeClass("active");
                    $("#termo-tab").removeClass("active");
                    $("#checklist-tab").removeClass("active");
                    break;
                case "termo_adesao":
                    $("#termo-tab").trigger("click");
                    $("#termo-tab").addClass("active");

                    $("#financeiro-tab").removeClass("active");
                    $("#planos-tab").removeClass("active");
                    $("#dadosgerais-tab").removeClass("active");
                    $("#checklist-tab").removeClass("active");
                    $("#historicoAtendimento-tab").removeClass("active");
                    $("#historicoOrdemServico-tab").removeClass("active");
                    $("#venda-tab").removeClass("active");
                    break;
                case "checklist-tab":
                    $("#checklist-tab").trigger("click");
                    $("#checklist-tab").addClass("active");

                    $("#dadosgerais-tab").removeClass("active");
                    $("#financeiro-tab").removeClass("active");
                    $("#planos-tab").removeClass("active");
                    $("#termo-tab").removeClass("active");
                    $("#historicoAtendimento-tab").removeClass("active");
                    $("#historicoOrdemServico-tab").removeClass("active");
                    $("#venda-tab").removeClass("active");
                    break;
                default:
                    $("#dadosgerais-tab").trigger("click");
                    $("#dadosgerais-tab").addClass("active");

                    $("#financeiro-tab").removeClass("active");
                    $("#planos-tab").removeClass("active");
                    $("#termo-tab").removeClass("active");
                    $("#checklist-tab").removeClass("active");
                    $("#historicoAtendimento-tab").removeClass("active");
                    $("#historicoOrdemServico-tab").removeClass("active");
                    $("#venda-tab").removeClass("active");
                    break;
            }
        }

