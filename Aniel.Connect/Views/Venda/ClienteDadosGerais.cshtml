        async function alterarStatusEtapaVenda(etapa, status, idConsulta = "") {
            @* Atualização do status das consultas na view para identificar que já existe uma consulta registrada no sistema *@
            switch (etapa) {
                case ETAPA_CONSULTA_VIABILIDADE:
                    STATUS_CONSULTA_VIABILIDADE = status;
                    break;
                case ETAPA_CONSULTA_PENDENCIA_FINANCEIRA:
                    STATUS_CONSULTA_PENDENCIA_FINANCEIRA = status;
                    break;
                case ETAPA_CONSULTA_PENDENCIA_ENDERECO:
                    STATUS_CONSULTA_PENDENCIA_ENDERECO = status;
                    break;
                case ETAPA_CONSULTA_CREDITO:
                    STATUS_CONSULTA_CREDITO = status;
                    break;
            }

            const idVenda = @Html.Raw(Json.Encode(Model.Id));

            @* Se a venda já foi gravada, atualizamos o registro da etapa da venda no banco *@
            if (idVenda != 0) {
                let link = "";

                if (idConsulta) {
                    link = `@String.Concat(CONSTANTES.URLPortal, "/api/VendaApi/AlterarStatusEtapaVenda")?IdVenda=${idVenda}&Etapa=${etapa}&Status=${status}&IdConsulta=${idConsulta}`;
                }
                else {
                    link = `@String.Concat(CONSTANTES.URLPortal, "/api/VendaApi/AlterarStatusEtapaVenda")?IdVenda=${idVenda}&Etapa=${etapa}&Status=${status}`;
                }

                return await $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',
                    beforeSend: function () {
                        //ShowPageLoading();
                        $("#divProgress").show();
                    },
                    complete: function () {
                        //HidePageLoading();
                        $("#divProgress").hide();
                    }
                });
            }
            else {
                return {
                    ok: true
                }
            }
        }

        function updateProgressBar() {
            const elemEtapas = $(".etapa-venda").toArray();


            for (let elemEtapa of elemEtapas) {
                const $elemEtapa = $(elemEtapa);

                const etapa = $elemEtapa.data("etapa");
                const status = Number($(`input[data-etapa=${etapa}][name$="Status"]`).val());

                const etapaConsulta =
                    etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA ||
                    etapa === ETAPA_CONSULTA_PENDENCIA_ENDERECO ||
                    etapa === ETAPA_CONSULTA_VIABILIDADE ||
                    etapa === ETAPA_CONSULTA_CREDITO;

                switch (status) {
                    case STATUS_ETAPA_PENDENTE:
                        $elemEtapa.removeClass("done");
                        $elemEtapa.removeClass("aguardandoGestor");
                        $elemEtapa.removeClass("reprovado");
                        $elemEtapa.removeClass("aprovadomanual");
                        $elemEtapa.unbind("click");

                        if (etapa === ETAPA_PLANO_PRODUTO) {
                            $("#planos-tab").addClass("disabled");
                        }
                        else if (etapa === ETAPA_FINANCEIRO) {
                            $("#financeiro-tab").addClass("disabled");
                        }
                        else if (etapa === ETAPA_TERMO_ADESAO) {
                            $("#termo-tab").addClass("disabled");
                        }
                        else if (etapa === ETAPA_CONSULTA_VIABILIDADE) {
                            $("#rowBtnAprovarViabilidadeManual").hide();
                            $("#rowBtnGravarCancelarViabilidadeManual").hide();

                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                let latitude = Number(latitudeBanco.replace(",", "."));
                                let longitude = Number(longitudeBanco.replace(",", "."));

                                if (latitude == 0 && longitude == 0) {
                                    latitude = getLatitudeViabilidade();
                                    longitude = getLongitudeViabilidade();

                                    if (latitude == 0 && longitude == 0) {
                                        Notificar("@RsBase.ATENCAO_", "@RsCadastros.CRITICA_LATITUDE_LONGITUDE_VIABILIDADE", "warning");
                                        return;
                                    }
                                }

                                @* A tela de viabilidade não lê os parâmetros que eram passados pelo modelo então só
                                foi colocado um link para uma nova tab com a tela de consulta de viabilidade *@
                                let response = await GetDadosConsultaViabilidadeVenda();

                                notificacaoViabilidade(response);

                                $("#iVerificarMapa").prop("hidden", false);
                                $("#iVerificarMapa").prop("latitude", latitude);
                                $("#iVerificarMapa").prop("longitude", longitude);

                                $("#iModalConsultaViabilidade").modal("show");
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_PENDENCIA_FINANCEIRA) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaFinanceira();
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_PENDENCIA_ENDERECO) {
                            $elemEtapa.unbind("click");
                            $elemEtapa.on("click", async function () {
                                await ExibirModalPendenciaEndereco();
                            });
                        }
                        else if (etapa === ETAPA_CONSULTA_CREDITO) {
                            $("#rowBtnAprovarManualCred").hide();
                            $("#rowBtnGravarCancelarManualCred").hide();

                            $elemEtapa.unbind("click");
                            if (STATUS_CONSULTA_CREDITO == STATUS_ETAPA_PENDENTE) {
