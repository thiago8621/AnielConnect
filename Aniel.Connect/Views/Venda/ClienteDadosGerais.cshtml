            $("#btnAdicionarDesconto").unbind('click');
        $("#btnAdicionarDesconto").on('click', function () {
            if (termo_adesao_assinado) {
                Notificar("@RsBase.ATENCAO_", "Termo Adesão Aprovado não é possivel alterar Detalhes do Plano", "warning");
            } else {

                var erro = false;
                CalculaValorTotalPlanoProduto();

                if (!$("#iDesconto").val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.DESCONTO)", "warning");
                    erro = true;
                }

                let rows_desconto = oDatatable.rows().data();
                let id_contrato = $("#iContratoDescontoPlano option:selected").text();
                let valor_total_plano_contrato = oDatatablePlano.rows().data().toArray()
                    .filter(x => x.Id_Contrato == id_contrato || x.Numero_Contrato == id_contrato)
                    .map(p => {
                        let valorStr = String(p.ValorPlanoProduto_Final || "0");

                        let valorNumerico = parseFloat(
                            valorStr.replace(/[^0-9,.]/g, '')
                                .replace(/[.]/g, '')
                                .replace(',', '.')
                        );

                        return isNaN(valorNumerico) ? 0 : valorNumerico;
                    }).reduce((b, c) => b + c, 0);

                let percentual_total_descontos = rows_desconto.filter(x => x.numeroContratoVinculado == id_contrato).map(p => parseFloat(p.percentualDesconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.'))).reduce((b, c) => b + c, 0);
                let valor_total_descontos = rows_desconto.filter(x => x.numeroContratoVinculado == id_contrato).map(p => parseFloat(p.valorDesconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.'))).reduce((b, c) => b + c, 0);

                let percentual_objeto = DescontoSelecionado.percentual_Desconto != null ? parseFloat(DescontoSelecionado.percentual_Desconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.')) : 0;
                let valor_objeto = DescontoSelecionado.valor_Desconto != null ? parseFloat(DescontoSelecionado.valor_Desconto.replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.')) : 0;

                percentual_total_descontos = percentual_total_descontos > 0 ? percentual_total_descontos : 0;
                valor_total_descontos = valor_total_descontos > 0 ? valor_total_descontos : 0;

                percentual_total_descontos += percentual_objeto;
                valor_total_descontos += valor_objeto;

                let valor_percentual = 0, valor_desconto = 0;
                valor_percentual = (valor_total_plano_contrato * percentual_total_descontos) / 100;
                valor_desconto = valor_total_descontos;

                let soma_total_descontos = valor_percentual + valor_desconto;
                if (soma_total_descontos > valor_total_plano_contrato) {
                    Notificar("@RsBase.ATENCAO_", "@RsCadastros.DESCONTO_MAIOR_QUE_VALOR", "warning");
                    return false;
                }

                for (var i = 0; i < rows_desconto.length; i++) {

                    if (!@Json.Encode(ViewBag.Descontos_Tipo_Diferente)) {

                        if (!@Json.Encode(ViewBag.Acumula_Descontos_Mesmo_Tipo) && !@Json.Encode(ViewBag.Descontos_Tipo_Diferente)) {

                            if (rows_desconto[i].idDesconto == $("#iDesconto option:selected").val()) {

                                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.DESCONTO)", "warning");
                                erro = true;

                                return false;
                            }
                            else {

                                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.SOMENTE_UM_DESCONTO_VIEW)", "warning");
                                erro = true;

                                return false;
                            }
                        }
                        else if (rows_desconto[i].tipoDesconto != DescontoSelecionado.tipo_Desconto) {

                            if (rows_desconto[i].idDesconto == $("#iDesconto option:selected").val()) {

                                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.DESCONTO)", "warning");
                                erro = true;

                                return false;
                            }
                            else {

                                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.TIPO_DESCONTO_DIFERENTE_VIEW)", "warning");
                                erro = true;

                                return false;
                            }
                        }
                    }
                    else if (!@Json.Encode(ViewBag.Acumula_Descontos_Mesmo_Tipo)) {

                        if (rows_desconto[i].idDesconto == $("#iDesconto option:selected").val()) {

                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.DESCONTO)", "warning");
                            erro = true;

                            return false;
                        }
                        else if (rows_desconto[i].tipoDesconto == DescontoSelecionado.tipo_Desconto) {

                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.MESMO_TIPO_DESCONTO_VIEW)", "warning");
                            erro = true;

                            return false;
                        }
                    }

                    if (rows_desconto[i].idDesconto == $("#iDesconto option:selected").val() && rows_desconto[i].numeroContratoVinculado == id_contrato) {

                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.DESCONTO)", "warning");
                        erro = true;

                        return false;
                    }
                }

                if (erro) {
                    return false;
                }


                var objDesconto = DescontoSelecionado;

                oDatatable.row.add({
                    idDesconto: $("#iDesconto option:selected").val(),
                    descricao: $("#iDesconto option:selected").text(),
                    numeroContratoVinculado: $("#iContratoDescontoPlano option:selected").text(),
                    valorDesconto: objDesconto.valor_Desconto == null ? "-" : objDesconto.valor_Desconto,
                    percentualDesconto: objDesconto.percentual_Desconto == null ? "-" : objDesconto.percentual_Desconto,
                    tipoDesconto: objDesconto.tipo_Desconto,
                    formato: $("#iFormato").val(),
                    id: 0
                }).draw(false);

                /*// Calculando o valor a ser pago após os descontos*/

                /*
                 * Soma do valor dos descontos percentuais.
                 *
                 * OBS.: A porcentagem de desconto é aplicada sempre ao valor
                 *       total antes de aplicar os descontos
                 */

                var valorDescontoPercentual = 0

                var valorTotalNew = valorTotalInicial
                rows_desconto = oDatatable.rows().data()

                $.each(rows_desconto, function (index, value) {

                    if (rows_desconto[index].valorDesconto == "-" || !rows_desconto[index].valorDesconto) {

                        var pctDesconto = stringParaFloat(rows_desconto[index].percentualDesconto)
                        valorDescontoPercentual += valorTotalInicial * (pctDesconto / 100)
                    }
                    else {

                        valorTotalNew -= stringParaFloat(rows_desconto[index].valorDesconto)
                    }
                });

                valorTotalNew -= valorDescontoPercentual

                if (valorTotalNew <= 0) {

                    Notificar("@RsBase.ATENCAO_", "@RsCadastros.DESCONTO_MAIOR_QUE_VALOR", "warning")
                    oDatatable.row(":last").remove().draw()
                    return false
                }

                floatValorComDesconto = valorTotalNew

                var valorStr = floatParaString(valorTotalNew)
                handleExcluir()
                displayDetalhesProposta(detalhesPropostaInicial);
            }//DS4039
        });

