        function ModalFoto(id, idItem) {
            $('#modalFoto').modal('show');
            $(document).bind('keyup', function (e) {
                if (e.which == 39) {
                    $(".carousel-control-next-icon").click();
                }
                else if (e.which == 37) {
                    $(".carousel-control-prev-icon").click();
                }
            });
            $('#modalFoto').attr("data-idFoto", id);
            $('#modalFoto').attr("data-idItem", idItem);

        };

        $(`#carouselExampleIndicators`).bind('slid.bs.carousel', function (e) {
            const slideIndex = $(e.target).find(".active").index();

            const elemSlide = $(`*[data-slideIndex="${slideIndex}"]`);
            const dataIdFoto = elemSlide.attr("data-idFoto");
            const dataIdItem = elemSlide.attr("data-idItem");
            const dataPergunta = elemSlide.attr("data-Pergunta");
            $('#iPerguntaFoto').html(dataPergunta);
