                        let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_APROVADA, idConsultaViabilidade);

                        if (!retornoAlterarStatus.ok) {
                            Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de viabilidade como aprovada", "warning");
                        }
                    }
                    ValidaSubmit(etapa);
                }

                else if (etapa === ETAPA_TERMO_ADESAO && CONTEM_ETAPA_CARTAO) {
