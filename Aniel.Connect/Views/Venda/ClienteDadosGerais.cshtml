                if (etapa == ETAPA_PLANO_PRODUTO) {
                    if (oDatatablePlano.rows().data().length < 1) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PLANO_PRODUTO)", "warning");
                        erro = true;
                    }
                }

                let statusEtapa = $(`input[data-etapa=${etapa}][name$="Status"]`).val();

                if (statusEtapa == Number(@(Convert.ToInt32(StatusEtapaVenda.Reprovado)))) {
                    let descricaoEtapa = $(`input[data-etapa=${etapa}][name$="Descricao"]`).val();
                    let propostaParalisada = false;
                    switch (etapa) {
                        case @Html.Raw((int)EnumEtapaVenda.ConsultaViabilidade) :
                            if (CONSULTA_VIABILIDADE_RESTRINGE_VENDA)
                                propostaParalisada = true;
                            break;
                        case @Html.Raw((int)EnumEtapaVenda.ConsultaPendenciaEndereco):
                            if (CONSULTA_PENDENCIA_ENDERECO_RESTRINGE_VENDA)
                                propostaParalisada = true;
                            break;
                        case @Html.Raw((int)EnumEtapaVenda.ConsultaPendenciaFinanceira):
                            if (CONSULTA_PENDENCIA_FINANCEIRA_RESTRINGE_VENDA)
                                propostaParalisada = true;
                            break;

                        case @Html.Raw((int)EnumEtapaVenda.ConsultaCredito):
                            if (CONSULTA_CREDITO_RESTRINGE_VENDA)
                                propostaParalisada = true;
                            break;
                    }

                    if (propostaParalisada) {
                        Notificar("@RsBase.ATENCAO_", `A etapa ${descricaoEtapa} encontra-se reprovada! Comunique seu gestor`, "warning");
                        erro = true;
                    }
                }
            }

            if (validacaopreFunction("@RsBase.CADASTRAR", ...valoresValidacao)) {
                erro = true;
            }

            @if (ViewBag.Utiliza_Cadastro_Endereco)
             {
                <text>

                    let buscarPor = $("#iBuscaEnderecoPrincipal option:selected").val();
                    let enderecoLogradouro = $("#iId_Endereco_LogradouroPrincipal").val();
                    let condomioLogradouro = $("#iId_Condominio_PredioPrincipal").val();

                    if (buscarPor == "" || buscarPor == undefined || buscarPor == null){
                         Notificar("@RsBase.ATENCAO_", `Selecione a Busca por Endereço`, "warning");
                         erro = true;
                    }

                    if (buscarPor == "1"){
                         if (!enderecoLogradouro){
                              Notificar("@RsBase.ATENCAO_", `Nenhum Endereço/Logradouro foi selecionado.`, "warning");
                              erro = true;
                         }
                    }
                    else if (buscarPor == "2"){
                         if (!condomioLogradouro){
                              Notificar("@RsBase.ATENCAO_", `Nenhum Condomínio/Prédio foi selecionado.`, "warning");
                              erro = true;
                         }
                    }
                    else{
                        Notificar("@RsBase.ATENCAO_", `Não foi possível identificar o endereço selecionado.`, "warning");
                        erro = true;
                    }
                </text>

                if (!configEnd_Insta_Mesmo_Princ)
                {
                    <text>
                    let buscarPorInstalacao = $("#iBuscaEnderecoInstalacao option:selected").val();
                    let enderecoLogInstalacao = $("#iId_Endereco_LogradouroInstalacao").val();
                    let condomioLogInstalacao = $("#iId_Condominio_PredioInstalacao").val();

                    if (buscarPorInstalacao == "" || buscarPorInstalacao == undefined || buscarPorInstalacao == null){
                        Notificar("@RsBase.ATENCAO_", `Selecione a Busca por Endereço Instalação`, "warning");
                        erro = true;
                    }

                    if (buscarPorInstalacao == "1"){
                         if (!enderecoLogInstalacao){
                              Notificar("@RsBase.ATENCAO_", `Nenhum Endereço/Logradouro de Instalação foi selecionado.`, "warning");
                              erro = true;
                         }
                    }
                    else if (buscarPorInstalacao == "2"){
                         if (!condomioLogInstalacao){
                              Notificar("@RsBase.ATENCAO_", `Nenhum Condomínio/Prédio de Instalação foi selecionado.`, "warning");
                              erro = true;
                         }
                    }
                    else{
                        Notificar("@RsBase.ATENCAO_", `Não foi possível identificar o endereço de instalação selecionado.`, "warning");
                        erro = true;
                    }

                </text>
             }
            }


            if (erro) {
                clicked = false;
                return false;
            }

            //ShowPageLoading();
            $("#divProgress").show();
            $("#iVendaConcluida").val("N");

            if (vendaConcluida) {
                $("#iVendaConcluida").val("S");
            }

            $('#form').submit();
        }


