                }
                else {
                    return 0.0;
                }
            },
            get valor_final_total() {
                let valorPagar = (this.subValorTotal + this.calculoAcrescimo);
                return valorPagar - this.calculoDesconto;
            },
            get valor_final_total_com_instalacao() {
                let valorPagar = (this.calculoInstalacao + this.subValorTotal + this.calculoAcrescimo);
