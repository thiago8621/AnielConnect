        function AlterarStatusTermo(status, idAnexo) {

            @if (!AcessoHelper.TemAcesso(ViewBag.Areas, "396"))
            {
                <text>
                Notificar("@RsBase.ATENCAO_", "@Html.Raw(RsBase.NAO_POSSUI_AREA_ACESSO)", "warning");
