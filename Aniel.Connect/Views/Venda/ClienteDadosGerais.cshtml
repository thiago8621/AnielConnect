        async function getContratoVinculadoPlano(planoProduto) {
            let modeloContrato = null;
            let idModelo = null;

            await $.getJSON(`@CONSTANTES.URLPortal/api/Modelo_ContratoApi/Get_ModeloVinculadoPlano?idPlanos=${planoProduto.id}`, function (contrato) {
                idModelo = contrato.objeto;
            });

            if (idModelo === null) {
                if (planoProduto.id_Modelo_Contrato != null) {
                    await $.getJSON(`@CONSTANTES.URLPortal/api/Modelo_Contratoapi/FindById?Id=${planoProduto.id_Modelo_Contrato}`, function (contrato) {
                        modeloContrato = contrato.objeto;
                    });
                }
            }
            else {
                await $.getJSON(`@CONSTANTES.URLPortal/api/Modelo_Contratoapi/FindById?Id=${idModelo}`, function (modelo) {
                    modeloContrato = modelo.objeto;
                });
            }

            return modeloContrato;
        }
