                            $(`input[data-etapa=${etapa}][name$="Status"]`).val(STATUS_ETAPA_REPROVADA);

                            let retornoAlterarStatus = await alterarStatusEtapaVenda(etapa, STATUS_ETAPA_REPROVADA, idConsultaViabilidade);

                            if (!retornoAlterarStatus.ok) {
                                Notificar("@RsBase.ATENCAO_", "Erro ao gravar a mudança de status da etapa de consulta de viabilidade como reprovada", "warning");
                            }
                        }
                        else {
                            @* Aplicação da regra de visualização do status da consulta *@
                            if (!USUARIO_VENDEDOR || CONSULTA_VIABILIDADE_VENDEDOR_VISUALIZA) {
                                $etapaAtual.removeClass("reprovado");
                                $etapaAtual.removeClass("done");

                                $etapaAtual.addClass("aguardandoGestor");
