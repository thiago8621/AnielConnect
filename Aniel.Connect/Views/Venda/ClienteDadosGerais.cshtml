                    texto += parametro.Cidade != null ? `, ${parametro.Cidade}` : "";

                    $('#iListaPlanosProdutosVenda')
                        .append($(`<option>${texto}</option>`)
                            .attr("value", parametro.Id)
                            .text(`${texto}`));
                });
                $('#iListaPlanosProdutosVenda').select2({ width: '100%' });
            }
