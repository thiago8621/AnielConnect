        @*Modal*@
        $("#iAnexarArquivos").on("click", function () {
            if (@Model.EtapaAtualVenda == @((int)EnumEtapaVenda.TermoAdesao) && Boolean(@(Convert.ToInt32(Model.Status != Status_Venda.Venda_Aprovada)))) {
                $("#iCheckExigeAceite").removeClass("readonly");
                $("#iCheckExigeAceite").prop("disabled", false);
                if ("@Model.Termo_Adesao_Assinado" == "True") {
                    $("#iCheckExigeAceite").addClass("readonly");
                    $("#iCheckExigeAceite").prop("disabled", true);
                }
                $("#modal-AnexarDocumentos").modal("show");
            }
            else {
                Notificar("@RsBase.ATENCAO_", "Adição de anexos disponível a partir da Etapa de Termo de Adesão", "warning");
            }
        });
        @*Escolha de arquivos na interface padrão files*@
        $("#iBtnEscolherAnexos").on("click", function () { $("#iAnexosContrato").click(); });

        @*Geração de registro no datatable*@
        $("#iAdicionarAnexodt").on("click", async function () {

            $("#modal-AnexarDocumentos").modal("show");
            ShowPageLoading();

            const url = "@Url.Action("SaveAnexosContrato", "Venda")";
            const descricaoAnexoContrato = "";
            const arquivosAnexosContrato = Array.from($("#iAnexosContrato")[0].files);
            let form = new FormData();
            form.append("IdVenda", @Model.Id);
            form.append("ExigeAceite", $("#iCheckExigeAceite").is(":checked"));
            form.append("Descricao", $("#iDescricaoArquivo").val());
            for (let file of arquivosAnexosContrato) {
                form.append("file", file);
            }
            await fetch(url, { method: "POST", body: form }).then(function (data) { if (data.ok) { Notificar("@RsBase.ATENCAO_", "Anexo inserido com sucesso", "info"); datatableAnexoDocumentos.draw(false); } });
            HidePageLoading();
        });

        async function handleExcluirAnexosContrato() {
            $(".VisualizaAnexoContratoAceite").unbind("click");
            $(".VisualizaAnexoContratoAceite").on("click", function () {
                let caminho = $(this).attr("url");
                window.open(caminho);
            });

            $(".DeleteAnexoContratoAceite").unbind("click");
            $(".DeleteAnexoContratoAceite").on("click", async function () {
                if (@Model.EtapaAtualVenda == @((int)EnumEtapaVenda.TermoAdesao) && Boolean(@(Model.Status != Status_Venda.Venda_Aprovada))) {
                    ShowPageLoading();
                    let idAnexoContrato = $(this).attr("excluir");
                    let url = "@CONSTANTES.URLPortal/api/vendaapi/DeleteAnexoContratoAceite?Id=" + idAnexoContrato;

                    await $.get({
                        url: url,
                        type: "GET",
                        datatype: "json"
                    }).done(function (data) {
                        if (data.ok) {
                            Notificar("@RsBase.ATENCAO_", "Anexo Removido com sucesso", "info");
                            datatableAnexoDocumentos.draw(false);
                        }
                    });
                    HidePageLoading();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", "Remoção de anexos disponível a partir da Etapa de Termo de Adesão", "warning");
                }

            });

        }

        function limitarCaracteres(input) {
            // Remove tudo que não for dígito (0 a 9)
            input.value = input.value.replace(/\D/g, '');

            const valor_plano = parseFloat($("#iValorReal").val().replace(/[^0-9,.]/g, '').replace(/[.]/g, '').replace(',', '.'));
            const multiplicacao = valor_plano * input.value;
            const valorFormatado = multiplicacao.toLocaleString("pt-BR", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            $("#iValorTotalPlano").val(valorFormatado);
        }
    </script>

