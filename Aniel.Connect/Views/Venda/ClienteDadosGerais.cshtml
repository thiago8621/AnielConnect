        var HandleCampanha = function () {


            $("#iCampanha").unbind('select2:select select2:unselecting');
            $('#iCampanha').on('select2:select select2:unselecting', function (e) {

                let CampanhaSelecionada = e.params.data;
                var idCampanha = e.params.data.id;

                if (typeof CampanhaSelecionada !== "undefined") {
                    $('#iPlano').val(CampanhaSelecionada.id_Plano_Produto);
                    $('#iValorReal').text(CampanhaSelecionada.valor_Plano_Produto);
                    $('#iValorReal').val(CampanhaSelecionada.valor_Plano_Produto);
                    $('#iValorInstalacao').val(CampanhaSelecionada.valor_Instalacao);
                }

                if (CampanhaSelecionada != undefined) {
                    AddSelect("iPlano", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, CampanhaSelecionada.id, CampanhaSelecionada.id_Plano_Produto, "@RsBase.SELECIONE", vendaaprovada, HandlePlano, null, "PLANO_COMERCIALIZAVEL_SIM");
                }
                else {
                    AddSelect("iPlano", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", vendaaprovada, HandlePlano, null, "PLANO_COMERCIALIZAVEL_SIM");
                }

                if (e.params.programatico) return;
                if (alterandoViaMeio) return;
                if (!idCampanha) return;
                $.get("@CONSTANTES.URLPortal/api/campanhaapi/GetMeioByCampanha", { idCampanha: idCampanha })
