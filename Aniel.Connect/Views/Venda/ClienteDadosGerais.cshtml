        $("#btnAtividadeStatusVenda").on("click", function (e) {
            var erro = false;
            if (!$('#iWorkflowAtividade').val())
            {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.STATUS_PADRAO)", "warning");
                erro = true;
            }

            if (erro) {
                return;
            }

            $("#iModalAtividadeStatusVenda").modal("hide");

            let id_Workflow_Vendas = '@Model.Id_Workflow_Vendas';
            const link = `@String.Concat(CONSTANTES.URLPortal, "/api/workflow_vendasapi/FindById")?Id=${id_Workflow_Vendas}`;
            $.ajax({
                url: link,
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    if (data.ok) {
                        var listaAtividades = data.objeto.atividades;
                        var id = stringParaFloat($("#iWorkflowAtividade").val());

                        var valueStatus = stringParaFloat($("#idValorStatusVenda").val());

                        listaAtividades = listaAtividades.filter(x => x.id == id);
                        var idStatusPadrao = listaAtividades[0].id_Status_Padrao;

                        if (valueStatus == 1) {
                            if (idStatusPadrao == @((int)Status_Venda.Venda_Cancelada)) {
                                SwalCancelarVenda(@((int)Status_Venda.Venda_Cancelada));
                            } else {
                                SwalAprovarEtapaWorkflow(valueStatus);
                            }
                            return false;
                        } else {
                            let etapaAtual = $(".etapa-venda[data-etapa-atual]").data("etapa");

                            if (idStatusPadrao == @((int)Status_Venda.Venda_Aprovada)) {
                                if (etapaAtual == ETAPA_TERMO_ADESAO) {
                                    SwalConfirmaAprovarVenda(@((int)Status_Venda.Venda_Aprovada));
                                } else {
                                    Notificar("@RsBase.ATENCAO_", "Você não pode aprovar a venda, as etapas ainda não foram concluídas.", "warning");
                                }
                            } else {
                                SwalAprovarEtapaWorkflow(valueStatus);
                            }
                            return false;
                        }
                    }
                }
            });
        });

        function modalAtividadeStatusVenda(valueStatus, tipoProposta) {
            // 0 - StatusAtividadeAprovada
            // 1 - StatusAtividadeReprovada
            $("#idValorStatusVenda").val(valueStatus);
            $("#idTipoPropostaStatusVenda").val(tipoProposta);
            var param = false;
            if (tipoProposta == 0) {
                param = true;
            }

            $("#iModalAtividadeStatusVenda").modal("show");
            var id = "@(Model.Workflow_VendasAtividade != null ? Convert.ToString(Model.Workflow_VendasAtividade.Id): "")";
            AddSelect("iWorkflowAtividade", "@CONSTANTES.URLPortal/api/workflow_vendasapi/GetComboFiltroAprovadoReprovado", @CONSTANTES.PaginacaoRegistros, null, id, null, "@RsBase.SELECIONE", false, null, null, null, param);
        }

        function generateContentIntegracao(porcentagem, objeto) {
            let content = "";
            let progresso = $("#iProgresso");
            progresso.css("width", `${porcentagem}%`);
            if (porcentagem < 100) {
                content = htmlIntegracao(objeto, false);
                //content += "<h4 class='mt-4 mb-2'> Etapas Pendentes</h4><br/>";
                //content += `<div class="col"> Cliente: ${objeto.etapaClienteIXC ? objeto.cliente : 'Pendente'}</div>`;
                //content += `<div class="col"> Contratos: ${objeto.etapaContratoIXC.filter(p => p == true).length == objeto.etapaContratoIXC.length ? objeto.listaContratos.join(', ') : 'Pendente'}</div>`;
                //content += `<div class="col"> Login: ${objeto.etapaLoginIXC.filter(p => p == true).length == objeto.etapaLoginIXC.length ? objeto.listaLogins.join(', ') : 'Pendente'}</div>`;
                //content += `<div class="col"> Atendimentos: ${objeto.etapaAtendimentoIXC.filter(p => p == true).length == objeto.etapaAtendimentoIXC.length ? objeto.listaAtendimentos.join(', ') : 'Pendente'}</div>`;

                //if (objeto.etapaOrdemServico != null && objeto.etapaOrdemServico.length > 0) {
                //    content += `<div class="col"> Ordens de Serviço: ${objeto.etapaOrdemServico.filter(p => p == true).length == objeto.etapaOrdemServico.length ? ListaOrdemServico.join(', ') : 'Pendente'}</div>`;
                //}

                //content += `<div class="col"> ${objeto.mensagem}`;
                progresso.text(`Integração Incompleta! - ${porcentagem}%`);
                if (porcentagem <= 25) {
                    progresso.addClass("bg-danger");
                }
                else if (porcentagem <= 50) {
                    progresso.addClass("bg-warning");
                }
                else {
                    progresso.addClass("bg-primary");
                }
            }
            else {
                progresso.text(`Integração Completa! - ${porcentagem}%`);
                progresso.addClass("bg-success");
                content = htmlIntegracao(objeto, true);
                //content += `<div class="col"> ${objeto.mensagem.split('_').join('<br>').replace("_", " ") }`;
            }

            let string = content;
            let html = $.parseHTML(string);
            $("#iResumoIntegracao").append(html);
        }

        function htmlIntegracao(objeto, porcentagemCompleta) {
            var content = "";
            content += !porcentagemCompleta ? "<h4 class='mt-4 mb-2'> Etapas Pendentes</h4><br/>" : "";
            content += `<div class="col"> Cliente: ${objeto.etapaClienteIXC ? objeto.cliente : 'Pendente'}</div>`;
            content += `<div class="col"> Contratos: ${objeto.etapaContratoIXC.filter(p => p == true).length == objeto.etapaContratoIXC.length ? objeto.listaContratos.join(', ') : 'Pendente'}</div>`;
            content += `<div class="col"> Login: ${objeto.etapaLoginIXC.filter(p => p == true).length == objeto.etapaLoginIXC.length ? objeto.listaLogins.join(', ') : 'Pendente'}</div>`;
            content += `<div class="col"> Atendimentos: ${objeto.etapaAtendimentoIXC.filter(p => p == true).length == objeto.etapaAtendimentoIXC.length ? objeto.listaAtendimentos.join(', ') : 'Pendente'}</div>`;

            if (objeto.etapaOrdemServico != null && objeto.etapaOrdemServico.length > 0) {
                content += `<div class="col"> Ordens de Serviço: ${objeto.etapaOrdemServico.filter(p => p == true).length == objeto.etapaOrdemServico.length ? objeto.listaOrdemServico.join(', ') : 'Pendente'}</div>`;
            }

            return content;
        }

        $("#iModalIntegracao").on("hidden.bs.modal", async function () {
            $("#iResumoIntegracao").text("");
            $("#iProgresso").css("width", `0`);

            $("#iProgresso").removeClass("bg-success");
            $("#iProgresso").removeClass("bg-warning");
            $("#iProgresso").removeClass("bg-danger");
            $("#iProgresso").removeClass("bg-primary");

        });
        $("#iModalIntegracao").on("shown.bs.modal", function () {

            $("#iTitleModalIntegracao").text(`${$("#iLinkCheckIntegracao").text()}`);
        });

        $("#iLinkCheckIntegracao").on("click", async function () {
            $("#divProgress").show();
            const integracao = $("#iLinkCheckIntegracao").data("integracao");

            const { objeto, mensagem, ok } = await $.ajax({
                url: "@CONSTANTES.URLPortal/api/vendaapi/VerificarIntegracao",
                data: { integracao: integracao, venda:@Model.Id},
                dataType: "json",
                type: "POST"
            });
            try {
                if (!ok) { throw mensagem; }
                let arrayEtapas = [
                  objeto.etapaClienteIXC,
                  ...(objeto.etapaContratoIXC || []),
                  ...(objeto.etapaLoginIXC || []),
                  ...(objeto.etapaAtendimentoIXC || []),
                  ...(objeto.etapaOrdemServico || [])
                ];

                let [etapasConcluidas, etapasIntegracao] = [Number(arrayEtapas.filter(p => p == true).length), Number(arrayEtapas.length)];

                if (etapasConcluidas == -1 || etapasIntegracao == -1) {
                    throw "Erro de retorno da api.";
                }
                let porcentagem = (etapasConcluidas / etapasIntegracao) * 100;

                generateContentIntegracao(porcentagem, objeto);

                $("#divProgress").hide();
                $("#iModalIntegracao").modal("show");
            }
            catch (exception) {
                Notificar("@RsBase.ATENCAO_", exception, "warning");
                $("iModalIntegracao").modal('hide');
                $("#divProgress").hide();
                $("#iResumoIntegracao").text("");
            }
        });

