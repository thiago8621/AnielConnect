            var value = e.target.value;
            if (value == "Sim" && @Model.ClienteContratos.Count > 0) {
                /*
                * Desabilitar DropDownList Contrato Novo
                **/
                $("#modeloContratoDiv").addClass("d-none");
                $("#iVincularPlanoContratoExistente").prop("checked", true).trigger("change");

                /*
                * Habilitar DropDownList Contrato Existente
                **/
                $("#modeloContratoExistentesDiv").removeClass("d-none");

                CarregaPlanoAntigo(null, null, "_InsersaoDataTable");
                $("#iDivPlanoAntigo_InsersaoDataTable").removeClass("d-none");
            } else {
                /*
                * Desabilitar DropDownList Contrato Existente
                **/
                $("#iVincularPlanoNovoAoContrato").prop("checked", true).trigger("change");
                $("#modeloContratoExistentesDiv").addClass("d-none");

                $("#iModelo_ContratoExistentes").empty();

                $("#iDivPlanoAntigo_InsersaoDataTable").addClass("d-none");
                $("#iPlanoAntigo_InsersaoDataTable").empty();
                /*
                * Habilitar DropDownList Contrato Novo
                **/
                $("#modeloContratoDiv").removeClass("d-none");
