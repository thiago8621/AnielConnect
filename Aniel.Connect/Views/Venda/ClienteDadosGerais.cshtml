        async function SwalConfirmaAprovarVenda(status) {
            @if (Model.StatusAtividadeAprovada.HasValue)
            {
                <text>
                    status = @((int)Model.StatusAtividadeAprovada);
                </text>
            }

            let exigeTermoAdesao = @Model.Exige_Termo_Adesao.ToString().ToLower();
            let termoAdesaoAssinado = @Model.Termo_Adesao_Assinado.ToString().ToLower();
            let statusAguardandoAC = @((int)Status_Venda.Aguardando_Avaliacao_Comercial);
            let statusAguardadoAV = @((int)Status_Venda.Venda_Aprovada);

            function statusPrecisaAprovacao(element, index, array) {

                return element == STATUS_ETAPA_REPROVADA || element == STATUS_ETAPA_PENDENTE;
            }
            let array = exigeTermoAdesao ? LISTA_TODOS_STATUS_ETAPAS : LISTA_TODOS_STATUS_ETAPAS.slice(0, LISTA_TODOS_STATUS_ETAPAS.length - 1);
            let etapasPrecisaAprovacao = array.some(statusPrecisaAprovacao);
            if (etapasPrecisaAprovacao && status == @((int)Status_Venda.Venda_Aprovada)) {
                Notificar("@RsBase.ATENCAO_", "Uma ou mais etapas da venda ainda não foram aprovadas", "warning");
                return;
            }

            if (status == statusAguardandoAC) {
                Notificar("@RsBase.ATENCAO_", "Venda Pendente de Liberação pela Empresa", "warning");
            }

            if (status == statusAguardadoAV)
            {
                if (exigeTermoAdesao && !termoAdesaoAssinado) {
                    Notificar("@RsBase.ATENCAO_", "Assinatura do termo de adesão é obrigatória", "warning");
                    return;
                }
            }

            Swal.fire({
                title: "Deseja aprovar a venda?",
                text: "Não será possível retornar essa ação",
                type: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não'
            }).then(async (result) => {
                if (result.value) {
                    @*if ("@Model.Atividade_Decisoria" == "@Atividade_Decisoria.Sim") {
                        exibirModalAprovacao(false);
                    } else {
                        $('#iModal_Motivo_Aprovacao_Venda').modal('show'); //modal
                    }*@

                    $('#iModal_Motivo_Aprovacao_Venda').modal('show'); //modal

                    $('#iMotivoAprovacaoVendaOutros').hide(); //textbox
                    $('#iMotivoAprovacaoVendaOutros').removeClass('readonly'); //textbox

                    $("#iMotivo_Aprovacao_VendaM").off("change");
                    $('#iMotivo_Aprovacao_VendaM').change(function (event) {

                        if ($('#iMotivo_Aprovacao_VendaM :selected').text() == "Outro") {
                            $('#iMotivoAprovacaoVendaOutros').show();
                        } else {
                            $('#iMotivoAprovacaoVendaOutros').hide();
                        }
                    });


                    $("#btnMotivoAprovar").off("click");
                    $("#btnMotivoAprovar").click(async function () {
                        var motivo_aprovacao_venda = $('#iMotivo_Aprovacao_VendaM').val();
                        var justificarAprovacao = $('#iMotivo_Aprovacao_Venda_Outros').val();

                        if (motivo_aprovacao_venda || justificarAprovacao)
                        {
                            // Crítica: motivo "Outro" (id=0) exige preenchimento da justificativa
                            if (motivo_aprovacao_venda == 0 && !justificarAprovacao)
                            {
                                Notificar("@RsBase.ATENCAO_", "Informe a justificativa da aprovação", "warning");
                                return;
                            }

                            if (!validacaopreFunction("@RsBase.CADASTRAR", ...valoresValidacao))
                            {
                                await AlterarStatusVenda(status, justificarAprovacao, status, motivo_aprovacao_venda,0);
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", "Aprovação negada", "warning");
                                return false;
                            }

                            $("#iDesconto").empty()
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", "Selecione o motivo da aprovação", "warning");
                        }


                        $("#iDesconto").empty()
                    });
                }
            });

        }

        async function SwalAprovarEtapaWorkflow(status) {
            if (status == 0)
            {
                @if (Model.StatusAtividadeAprovada.HasValue)
                {
                    <text>
                    status = @((int)Model.StatusAtividadeAprovada);
                    </text>
                }
                @if (Model.StatusAtividadeAprovada == Status_Venda.Venda_Aprovada)
                {
                    <text>
                    SwalConfirmaAprovarVenda(@((int)Status_Venda.Venda_Aprovada));
                    return false;
                    </text>
                }

                @if (Model.StatusAtividadeAprovada == Status_Venda.Venda_Cancelada)
                {
                    <text>
                    SwalCancelarVenda(@((int)Status_Venda.Venda_Cancelada));
                    return false;
                    </text>
                }
            }
            else
            {
                @if (Model.StatusAtividadeReprovada.HasValue)
                {
                    <text>
                        status = @((int)Model.StatusAtividadeReprovada);
                    </text>
                }

                @if (Model.StatusAtividadeReprovada == Status_Venda.Venda_Cancelada)
                {
                    <text>
                    SwalCancelarVenda(@((int)Status_Venda.Venda_Cancelada));
                    return false;
                    </text>
                }

                @if (Model.StatusAtividadeReprovada == Status_Venda.Venda_Aprovada)
                {
                    <text>
                    SwalConfirmaAprovarVenda(@((int)Status_Venda.Venda_Aprovada));
                    return false;
                    </text>
                }
            }



            function statusPrecisaAprovacao(element, index, array) {
                return element != STATUS_ETAPA_APROVADA && element != STATUS_ETAPA_APROVADA_MANUALMENTE;
            }

            let etapasPrecisaAprovacao = LISTA_TODOS_STATUS_ETAPAS.some(statusPrecisaAprovacao);
            if (etapasPrecisaAprovacao && status == @((int)Status_Venda.Venda_Aprovada)) {
                Notificar("@RsBase.ATENCAO_", "Uma ou mais etapas da venda ainda não foram aprovadas", "warning");
                return;
            }

            var title = "";
            if (status == 0) {
                title = "Deseja Aprovar a etapa " + "@Model.StatusVenda" + "?";
            } else if (status == 1) {
                title = "Deseja Reprovar a etapa " + "@Model.StatusVenda" + "?";
            }

            Swal.fire({
                title: title,
                text: "Não será possível retornar essa ação!",
                type: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não'
            }).then(async (result) => {
                if (result.value)
                {
                    await AlterarStatusVenda("", "", "", "",status);
                }
            });

        }


