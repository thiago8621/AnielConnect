        var valorTotalInicial = 0;

        //calcula o valor total dos planos/produtos
        function CalculaValorTotalPlanoProduto() {
            var valor_total = 0,
                valor_InstalacaoTotal = 0;

            for (var i = 0; i < oDatatablePlano.data().count(); i++) {

                var valor_Instalacao_row = typeof oDatatablePlano.row(i).data().ValorInstalacao_Final == "string"
                    ?
                    oDatatablePlano.row(i).data().ValorInstalacao_Final.replace(",", ".")
                    :
                    oDatatablePlano.row(i).data().ValorInstalacao_Final;

                var valor_row = typeof oDatatablePlano.row(i).data().ValorPlanoProduto_Final == "string"
                    ?
                    oDatatablePlano.row(i).data().ValorPlanoProduto_Final.replace(",", ".")
                    :
                    oDatatablePlano.row(i).data().ValorPlanoProduto_Final;


                if (typeof valor_row === "undefined")
                    valor_row = 0;
                else {
                        valor_row = parseFloat(valor_row);
                }


                valor_total += valor_row;

                valor_Instalacao_row = typeof valor_Instalacao_row === "undefined" ? 0 : parseFloat(valor_Instalacao_row);
                valor_InstalacaoTotal += valor_Instalacao_row;
            }

            $("#iDetalhesValorInstalacao").val(valor_InstalacaoTotal);
            var valorStr = floatParaString(valor_total);

            $("#iDetalhesValorFinalComDesconto").val(valorStr);
            valorTotalInicial = valor_total;

            // Calculando o valor a ser pago após os descontos

            /*
             * Soma do valor dos descontos percentuais.
             *
             * OBS.: A porcentagem de desconto é aplicada sempre ao valor
             *       total antes de aplicar os descontos
             */

            var valorDescontoPercentual = 0;
            var valorTotalNew = valorTotalInicial
            rows_desconto = oDatatable.rows().data();

            var pctDesconto = null;

            $.each(rows_desconto, function (index, value) {

                if (rows_desconto[index].valorDesconto == "-" || !rows_desconto[index].valorDesconto) {

                    pctDesconto = stringParaFloat(rows_desconto[index].percentualDesconto);
                    valorDescontoPercentual += valorTotalInicial * (pctDesconto / 100);
                }
                else {

                    valorTotalNew -= stringParaFloat(rows_desconto[index].valorDesconto);
                }
            });

            valorTotalNew -= valorDescontoPercentual;

            if (valorTotalNew < 0) {

                Notificar("@RsBase.ATENCAO_", "@RsCadastros.DESCONTO_MAIOR_QUE_VALOR", "warning");
                oDatatable.row(":last").remove().draw();
                return false;
            }

            floatValorComDesconto = valorTotalNew
            var valorStr = floatParaString(valorTotalNew)

            $("#iDetalhesValorFinalComDesconto").val(valorStr);

        }

