        let interval;
        function ConsultaStatusCartao() {
            interval = setInterval(VerificaStatusCartao, 10000);
        }

        async function VerificaStatusCartao() {

            var idCliente = "@Model.Id_Cliente";

            await  $.ajax({
                    url: "@CONSTANTES.URLPortal" + "/api/clienteapi/VerificaStatusCartao",
                    method: "POST",
                    data: { idCliente: idCliente }
                    })
                    .done(async function (data) {
                        if (data.ok) {
                            var objMensagem = "Resumo do Retorno: " + `${data.idObjeto.mensagem}`;
                            var text = document.createTextNode(objMensagem);
                            var campoResultado = document.getElementById("iResultadoCartao");

                            if (objMensagem !== campoResultado.textContent) {
                                campoResultado.textContent = "";
                                campoResultado.appendChild(text);
                            }

                            if (data.idObjeto.idStatus == "1"){
                                clearInterval(interval);
                                await alterarStatusEtapaVenda(ETAPA_CARTAO, 1);
                            }

                            if (data.idObjeto.idStatus == "2") {
                                clearInterval(interval);
                                await alterarStatusEtapaVenda(ETAPA_CARTAO, 2);
                            }
                        }
                        else{
                            clearInterval(interval);
                        }
                   });
        }


