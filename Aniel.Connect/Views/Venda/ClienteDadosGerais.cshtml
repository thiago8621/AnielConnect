        var FlagPossuiValorAgrupadoTmp = false;
        function reorderRecords(records = []) {
            if (records.length > 0) {
                oDatatablePlano.clear();
                for (let record of records) {

                    oDatatablePlano.row.add({
                        Id: record.Id,
                        Id_Endereco: record.Id_Endereco,
                        Id_Plano_Produto: record.Id_Plano_Produto,
                        Id_Campanha: record.Id_Campanha,
