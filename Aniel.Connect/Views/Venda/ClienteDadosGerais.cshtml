        async function ResultFromMontagem() {
            /*//variaveis inicializadas*/
            let tv = parseInt($("#iServ_TV").val()),
                fixo = parseInt($("#iServ_Fixo").val()),
                movel = parseInt($("#iServ_Movel").val()),
                internet = parseInt($("#iServ_Internet").val()),
                refMontagemCombo = [tv, fixo, movel, internet].filter(p => { return p; });

            await $.get({
                url: `@CONSTANTES.URLPortal/api/Modelo_ContratoApi/Get_ModeloVinculadoPlano?idPlanos=${JSON.stringify(refMontagemCombo)}`
            })
                .done(async function (data) {

                    if (data.ok) {

                        await $.get({
                            url: `@CONSTANTES.URLPortal/api/Modelo_Contratoapi/FindById?Id=${data.objeto}`
                        }).done(function (ObjetoModeloDeContrato) {

                            //let definicao_contrato = new resumo_ContratoMontagem(ObjetoModeloDeContrato.objeto);
                            let resumo_string = `<b>Resumo: </b> ${ObjetoModeloDeContrato.objeto.descricao}<br/> `;
                            ObjetoModeloDeContrato.objeto.lista.forEach(function (p) {
                                let tipoDeCombo = track_enum(p.tipo_Combo);
                                switch (p.tipo_Combo) {
                                    case 5:
                                        resumo_string += `<b class="ServicosAdicionaisMontagem">Plano de ${tipoDeCombo}: </b> ${p.descricao} <br/> `;
                                        break;

                                    default:
                                        resumo_string += `<b>Plano de ${tipoDeCombo}: </b> ${p.descricao} <br/> `; break;
                                }
                            });
                            if (!resumo_string.includes(`class="servicosAdicionaisMontagem"`)) {
                                resumo_string += `<b class="ServicosAdicionaisMontagem"></b>`;
                            }
                            let html = $.parseHTML(resumo_string);
                            $("#iResumoMontagem").append(html);
                            AddSelect("iAdicionarServico", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandlePlano, null, "PLANO_COMERCIALIZAVEL_SIM", @Convert.ToInt64(Tipo_Tecnologia.Servicos_Adicionais));

                        })
                    }

                })
                .fail(function () {

                    Notificar("Erro ao Montar Combo");

                });

        }

