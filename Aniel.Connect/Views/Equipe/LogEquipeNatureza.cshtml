@{
    ViewBag.Title = RsCadastros.LOG_NATUREZA_EQUIPE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles{
    @Styles.Render("~/Content/cssDataTable")
}
@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script>
        var oDatatable = null;

        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {
            $('#iNatureza').val(null).trigger('change')
            $('#iEquipe').val(null).trigger('change')
            if (oDatatable != null) {
                oDatatable.draw()
            }
        })

        $(document).ready(async () => {
            $('#modal-filter').modal('show')
            AddSelect("iNatureza", "@CONSTANTES.URLPortal/api/Natureza_ProducaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iEquipe", "@CONSTANTES.URLPortal/api/Equipeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        })

        var filter_state = {
            equipe: {
                label: "@RsCadastros.EQUIPE",
                getDisplay: () => { return Boolean($('#iEquipe').val()) ? $('#iEquipe option:selected').text() : "" },
                onclick: () => {
                    $('#iEquipe').val(null).trigger("change")
                    oDatatable.draw()
                }
            },
            natureza: {
                label: "@RsCadastros.NATUREZA",
                getDisplay: () => { return Boolean($('#iNatureza').val()) ? $('#iNatureza option:selected').text() : "" },
                onclick: () => {
                    $('#iNatureza').val(null).trigger("change")
                    oDatatable.draw()
                }

            }
        }

        "use strict";

        function oDatatableFunction() {

            if (oDatatable == null) {

                oDatatable = $("#datatable").length && $("#datatable").DataTable({
                    dom: "Bfrti",
                    select: {
                        style: 'multi'
                    },
                    serverSide: true,
                    searching: true,
                    ordering: false,
                    paging: true,
                    deferRender: true,
                    scrollResize: true,
                    scrollY: '66vh',
                    scroller: {
                        loadingIndicator: true,
                        rowHeight: 40,
                        boundaryScale: 0.5,
                        displayBuffer: 3
                    },
                    stateSave: true,
                    scrollX: true,
                    fixedHeader: true,
                    order: [],
                    initComplete: dataTableInitComplete,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    ajax: {
                        url: baseUrl + '/api/Natureza_ProducaoApi/GetLogEquipeNatureza',
                        type: 'POST',
                        async: false,
                        data: function (data) {
                            data.Equipe = $('#iEquipe').val();
                            data.Natureza = $('#iNatureza').val();
                        },
                        error: function (e) {
                            console.log(e);
                        },
                        dataSrc: function (d) {
                            return d.data;
                        }
                    },
                    infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                        var str = "@RsCadastros.INFODATATABLE";
                        if (iTotal == 0) { iEnd = 0; iStart = 0; }
                        str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                        $("#dtLegend").html(str);

                        return "";
                    },
                    drawCallback: () => {
                        TagFilter("FiltrosUtilizados", filter_state)
                    },
                    pageLength: 5,
                    language: traducaoDataTableSimples,
                    buttons: buttonsDataTable,
                    columns: [
                        { data: "natureza", title: "@RsCadastros.NATUREZA", orderable: false },
                        { data: "equipe", title: "@RsCadastros.EQUIPE", orderable: false },
                        { data: "tipo_Alteracao", title: "@RsCadastros.TIPO_ALTERACAO", orderable: false },
                        { data: "data_Alteracao", title: "@RsBase.DATA_HORA_ALTERACAO", orderable: false },
                        { data: "usuario_Alteracao", title: "@RsBase.USUARIO_ALTERACAO", orderable: false }
                    ]
                });

                $('#txtSearch').val(oDatatable.search());
                $('#txtSearch').keyup(function () {
                    oDatatable.search($(this).val()).draw();
                });

                // Handle table draw event
                oDatatable.on('draw', function () {
                    // Update state of "Select all" control

                    rows_selected = [];
                });
            }
            else {
                oDatatable.draw()
            }

            $('#modal-filter').modal('hide')


        }

    </script>
}
<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="far fa-calendar-check"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Habilitar_Servicos", "Equipe")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.HABILITAR_NATUREZA_SERVICO_EQUIPE</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

        </div>

        <div class="col-auto">
            <div class="row title-page">


                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

            </div>
        </div>

    </div>
    <!--./main-->
    <div id="FiltrosUtilizados" class="mt-2 mr-2 ml-2">
    </div>
</div>
<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%"></table>
</div>

<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iEquipe">@RsCadastros.EQUIPE:</label>
                            <select class="form-control" id="iEquipe"></select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iNatureza">@RsCadastros.NATUREZA:</label>
                            <select class="form-control" id="iNatureza"></select>
                        </div>
                    </div>
                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatableFunction()" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->