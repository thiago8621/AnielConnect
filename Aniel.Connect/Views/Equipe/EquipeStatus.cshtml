@model  Aniel.Connect.Models.EquipeStatusModel
@*@model  Aniel.Connect.Models.Acompanhamento_EquipeListaModel*@
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@{
    ViewBag.Title = RsCadastros.EQUIPE_DISPONIVEL;
    ViewBag.Sessao = RsCadastros.EQUIPE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles
{


}

@section  scripts
{

}

<div style=" padding-left: 10px;padding-top: 20px;font-size: 12px; width: 90%; height: 250px !important;">

    <!--main-->

    <div class="row mt-1 mb-2">
        <div class="col-6">
            <i class="fas fa-thumbs-up"></i> <b>Status no APP:</b> <span class="font-weight-normal ">@Model.Tipo @Model.DataHora_Login </span>
        </div>
        <div class="col-sm-6">
            <i class="fas fa-map-marker-alt"></i> <b>GPS:</b> @Model.StatusGPS <span class="font-weight-normal">@Model.Atualizado_Em</span>
        </div>
    </div>


    <div class="row mt-1 mb-2">
        <div class="col-sm-6">
            <i class="fas fa-mobile-alt"></i> <b>Dispositivo Móvel:</b> <span class="font-weight-normal">@Model.Dispositivo</span>
        </div>
        <div class="col-sm-6">
            <i class="fas fa-rss"></i> <b>Precisão GPS:</b> <span class="font-weight-normal">@Model.Precisao</span><span>m</span>
        </div>
    </div>

    <div class="row mt-1 mb-2">
        <div class="col-sm-6">
            <i class="material-icons" style="font-size: 18px; margin-left: -5px;">touch_app</i><b>Versão App Touch:</b> <span class="font-weight-normal">@Model.Versao_App</span>
        </div>
        <div class="col-sm-6">
            <i class="fab fa-android" style="font-size:18px;"></i> <b>Versão Android:</b> <span class="font-weight-normal">@Model.Versao_Android</span>
        </div>
    </div>
    <div class="row mt-1 mb-2">
        <div class="col-sm-6">
            <i class="fas fa-signal"></i> <b>Internet Móvel:</b> <span class="font-weight-normal">@Model.InternetMovel</span>
        </div>
        <div class="col-sm-6">
            <i class="fas fa-wifi"></i> <b>Wi-fi:</b> <span class="font-weight-normal">@Model.WiFi</span>
        </div>
    </div>
    <div class="row mt-1 mb-2">
        <div class="col-sm-6">
            <i class="fas fa-info-circle"></i> <b>Número IMEI:</b> <span class="font-weight-normal">@Model.IMEI</span>
        </div>
        <div class="col-sm-6">
            <i class="fas fa-building"></i> <b>Endereço:</b> <span class="font-weight-normal">@Model.Endereco</span>
        </div>
    </div>
    <div class="row mt-1 mb-2">
        <div class="col-sm-6">
            <i class="fas fa-sync"></i> <b>Atualizado:</b> <span class="font-weight-normal">@Model.Atualizado_Em</span>
        </div>
        <div class="col-6">
            <div class="form-inline">
                <i class="fas fa-edit"></i> <b>Justificativa da ausência:</b> <span class="font-weight-normal" style="word-break:break-word" title="@Model.Justificativa_Ausencia">@Model.Justificativa_Ausencia </span>
            </div>
        </div>
    </div>
    <!--./main-->

</div>