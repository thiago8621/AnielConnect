@model  Aniel.Connect.Models.EquipeListaModel
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@{
    ViewBag.Title = RsCadastros.HABILITAR_AREA_ATUACAO_EQUIPE;
    ViewBag.Sessao = RsCadastros.EQUIPE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}
@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
}

@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script>

        var oDatatable = null;
        var rows_selected = [];

        var HandleGrupo = function () {
            $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

                GrupoSelecionado  = e.params.data
                if (GrupoSelecionado) {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false, HandleArea);
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
                else {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
                }

            });
        };

        var HandleArea = function () {
            $('#iArea').on('select2:select select2:unselecting', function (e) {

                AreaSelecionada = e.params.data
                if (AreaSelecionada) {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id) , null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };

        function carregaSelect2(){
            AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupo);
            AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
            AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
        }



        carregaSelect2()
        function AdicionarArea(Equipe) {
            ShowDialog(true, true, 'Adicionar Area', '@Url.Action("Adicionar_Area", "Equipe")' + '?Equipe=' + Equipe, 'divAdicionarArea', 600, 600, 'iframeAdicionarArea',
                function () { rows_selected = []; oDatatable.draw(); });
        }

        $("#iLimparFiltro,#iLimparFiltroModal").click(() => {
            $('#iGrupoArea').val(null).trigger('change')
            $('#iArea').val(null).trigger('change')
            $('#iLocalidade').val(null).trigger('change')
            carregaSelect2();
            if (oDatatable != null) {
                oDatatable.draw()
            }
        })

        var handleDataTableButtons = function () {
            "use strict";

            function AlterarStatusObj(Status) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/EquipeApi/alterarstatus")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected,
                        status: Status
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    });

                rows_selected = [];


            }

            $("#btnAddMassa").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AdicionarAreaMassa(rows_selected);
            });

            function AdicionarAreaMassa(rowsselected) {

                ShowDialog(true, true, 'Adicionar Area', '@Url.Action("Adicionar_Area", "Equipe")' + '?Equipes=' + rowsselected, 'divAdicionarArea', 600, 600, 'iframeAdicionarArea',
                function () {
                    try {

                        setTimeout(function () {
                            rows_selected = [];
                            oDatatable.draw();
                        }, 500);


                    }
                    catch {
                        setTimeout(function () {
                            rows_selected = [];
                            oDatatable.draw();
                        }, 500);
                    }
                });

            }

            //"Blfrtip"
            //var oDatatable = $("#datatable").length && $("#datatable").DataTable({
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/Equipeapi/GetAllSimpleArea',
                    type: 'POST',
                    data: function (data) {
                        data.GrupoArea = $("#iGrupoArea").val();
                        data.Area = $("#iArea").val();
                        data.Localidade = $("#iLocalidade").val();
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [

                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "equipe", title: "@RsCadastros.CODIGO" },
                    { data: "nome", title: "@RsCadastros.EQUIPE" },
                    { data: "descricao", title: "@RsCadastros.AREA_HABILITADA?" }

                    ]
                });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });


            $("#btnInativar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);

            });

           $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });


           $("#btnExcluir").on("click", function (e) {

               e.preventDefault();

               var ids = rows_selected;

               if (ids.length == 0) {
                   Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
               }
               else {

                   var link = '@String.Concat(CONSTANTES.URLPortal, "/api/EquipeLocalidadeapi/ExcluirGridEquipeLocalidadeEmMassa?value=")' + ids;

                   $.ajax({
                       url: link,
                       type: 'GET',
                       dataType: 'json',

                   })
                   .done(function (data) {

                       if (data.ok) {
                           rows_selected = [];
                           oDatatable.draw();
                           Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                       }
                       else {
                           Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                       }
                   })
                   .fail(function () {

                   })
                   .always(function () {

                   });
               }
            });

             // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().equipe;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function () {
                @if (AcessoHelper.TemAcesso(_areas, "120"))
                 {
                 <text>
                     if (oDatatable.row(this).data() != null)
                     {

                         var _id = oDatatable.row(this).data().equipe;

                         AdicionarArea(_id);
                         //ShowPageLoading();

                     }
                 </text>
                 }
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

    </script>
}

<div class="container-fluid" id="divTitle">
    <!--main-->
    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-user-plus"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a></li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

            <span style="font-size:11px" id="dtLegend"></span>
        </div>

        <div class="col-auto">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.CODIGO_OU_EQUIPE" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>

                <a class="btn btn-success btn-add" id="btnAddMassa" title="@RsBase.INCLUIR" href="#" onclick="return false;"><i class="la la-plus" style="color: #fff"></i></a>
                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" id="" href="@Url.Action("LogEquipeLocalidade","Equipe")" onclick="">@RsBase.VISUALIZAR_LOG</a>
                    <a class="dropdown-item" id="btnExcluir" href="#" onclick="return false;">@RsCadastros.EXCLUIR_AREA_MASSA</a>
                </div>
            </div>
        </div>

    </div>


    <!--./main-->
</div>
<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>
<!--Modal Filters-->
<div class="modal fade" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="iGrupoArea">@RsCadastros.GRUPO_AREA:</label>
                            <select class="form-control" id="iGrupoArea"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iArea">@RsCadastros.AREA:</label>
                            <select class="form-control" id="iArea"></select>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="iLocalidade">@RsCadastros.LOCALIDADE:</label>
                            <select class="form-control" id="iLocalidade"></select>
                        </div>
                    </div>
                </div>

                <div class="form-group col-sm-12" style="padding: 15px;">
                    <div class="text-center">
                        <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                        <button type="button" class="btn btn-success" onclick="oDatatable.draw(); $('#modal-filter').modal('hide');" id="iPesquisar">PESQUISAR</button>
                    </div>
                </div>

            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal-->

<div id="divAdicionarArea" style="display:none"></div>