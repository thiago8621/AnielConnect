@model Aniel.Connect.Models.Area_ManutencaoModels

@using Aniel.T5.Model.enumerado
@using Resources
@using Microsoft.AspNet.Identity;
@using Aniel.Connect.Core.Helpers;
@using Aniel.Connect.Models.T5;
@using Sinapse.Model.enumerados;


@{
    ViewBag.Title = RsCadastros.MANUTENCAO_REDE;
    ViewBag.Sessao = RsCadastros.IPOE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    List<AreaModuloModel> _areas = ViewBag.Areas;
    var StorageName = CONSTANTES.SIGLA_MODULO + " - " + ViewBag.Title + " - " + CONSTANTES.Versao;


}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

    <script>
        var rows_selected = [];
        var oDatatable;

        var _url = '@String.Concat(CONSTANTES.URLPortal,"/api/Area_ManutencaoApi/AlterarStatus")';
        function AlterarStatusObj(Status) {
        $.ajax({
            url: _url,
            type: `POST`,
            dataType: `json`,
            data: {
                ids: rows_selected,
                status: Status
            }

        })
            .done(function (data) {
                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    rows_selected = [];
                    oDatatable.draw(false);
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }

            });
    }

           $("#btnInativar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);
           });
        $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });

        var handleDataTableButtons = function () {
            "use strict";

            //"Blfrtip"

            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: `<'row'<'col-sm-4'l><'col-sm-8'p>> Bfrti`,
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '73vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: `${baseUrl}/api/Area_ManutencaoApi/GetAll`,
                    type: 'POST',
                    data: function (data) {
                        var dataInicial = $("#iDataInicial").val();
                        var horaInicial = $("#iHoraInicial").val();
                        var dataFinal = $("#iDataFinal").val();
                        var horaFinal = $("#iHoraFinal").val();

                        data.IdEmpresa = $("#iEmpresa").val()
                        data.IdFilial = $("#iFilial").val()

                        data.CodCt = $("#iCodCt").val()
                        data.Projeto = $("#iProjeto").val()

                        data.UF = $("#iUF").val()
                        data.IdCidade = $("#iCidade").val()
                        data.IdBairro = $("#iBairro").val()
                        data.DataInicial = dataInicial;
                        data.HoraInicial = horaInicial;
                        data.DataFinal = dataFinal;
                        data.DataInicial = horaFinal;
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },

                    { data: "id", title: "@RsCadastros.ID" },

                    { data: "descricao", title: "@RsCadastros.DESCRICAO" },

                    { data: "elementoRede", title: "@RsCadastros.ELEMENTO_REDE" },

                    { data: "dataInicial", title: "@RsCadastros.DATAINICIAL" },
                    { data: "horaInicial", title: "@RsCadastros.HORARIO_INICIO" },
                    { data: "dataFinal", title: "@RsCadastros.DATAFINAL" },
                    { data: "horaFinal", title: "@RsCadastros.HORARIO_FIM" },

                    { data: "status", title: "@RsCadastros.STATUS" },

                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($("#txtSearch").val()).draw();
            });

            $("#iPesquisar").on("click", function () {
                $("#modal-filter").modal('hide');

                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();

                return true;
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;
                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function () {
                if (oDatatable.row(this).data() != null) {
                    const _id = oDatatable.row(this).data().id;
                    const url = '@Url.Action("Cadastro", "Manutencao", new { id = "__id__" })';

                    window.location.href = url.replace('__id__', _id);

                    ShowPageLoading();
                }
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
        TableManageButtons = function () {
            "usestrict";
            return {
                init: function () {
                    handleDataTableButtons();
                }
            }
        }();

        TableManageButtons.init();

        var status_filtro = @(Html.GetArrayEnum<Status_Default>())
        var status_values = @(Json.Encode(Enum.GetValues(typeof(Status_Default)).Cast<Status_Default>()));
        $.each(status_filtro, function (key, value){
            $("#iStatus").append($(`<option>${value}</option>`).attr("value", status_values[key]).text(value));

        });
        $("#iStatus").select2({width:"resolve"});

    </script>
}


<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">

            <h4 class="title-page"><i class="fas fa-server"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Projeto_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.ANIEL_GEOGRAPHY</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>

            @*<span style="font-size:11px;margin-left: 15px;" id="dtLegend"></span>*@
        </div>

        <div class="col-auto mb-3">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.MANUTENCAO" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
                <a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "Manutencao")" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>

                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltro" onclick="$('#txtSearch').val('');oDatatable.search('').draw();" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" id="btnInativar" onclick="return false;">@RsBase.INATIVAR</a>
                    <a class="dropdown-item" id="btnAtivar" onclick="return false;">@RsBase.ATIVAR</a>

                </div>
            </div>
        </div>

    </div>
    <!--./main-->
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>

<!--Modal Filters-->

<div class="modal" id="modal-filter">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title text-muted"> Filtros Manutenção </h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">


                <div class="row pt-2 mt-2">


                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iDataInicial">@RsCadastros.DATAINICIAL:</label>
                            <br />
                            @Html.TextBoxFor(model => model.DataInicial, new { @class = "form-control datepicker obrigatorio", @placeholder = "00/00/0000", @id = "iDataInicial", @autocomplete = "off", @data_provide = "datepicker" })
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iHoraInicial">@RsCadastros.HORARIO_INICIO:</label>
                            @Html.TextBoxFor(model => model.HoraInicial, new { @class = "form-control hora obrigatorio", @placeholder = "00:00", @id = "iHoraInicial", @autocomplete = "off" })
                        </div>
                    </div>
                </div>
                <div class="row pt-2 mt-2">

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iDataFinal">@RsCadastros.DATAFINAL:</label>
                            <br />
                            @Html.TextBoxFor(model => model.DataFinal, new { @class = "form-control datepicker obrigatorio", @placeholder = "00/00/0000", @id = "iDataFinal", @data_provide = "datepicker", @autocomplete = "off" })
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="iHoraFinal" class="mr-3">@RsCadastros.HORARIO_FIM:</label>
                            @Html.TextBoxFor(model => model.HoraFinal, new { @class = "form-control hora obrigatorio ", @placeholder = "00:00", @id = "iHoraFinal", @autocomplete = "off" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                    </div>
                    <div class="col-sm-6">
                        <div class="text-center">
                            <div class="form-group">
                                <label for="iStatus">@RsCadastros.STATUS</label>
                                <select class="form-control" id="iStatus" style="width:100%">
                                    <option value="">@RsBase.TODOS</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div>
            </div>


            <div class="form-group col-sm-12" style="padding: 15px;">
                <div class="text-center">
                    <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                    <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- /.modal-->