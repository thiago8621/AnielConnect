@model Aniel.Connect.Models.Area_Cadastro_ManutencaoModels

@{
    ViewBag.Title = RsCadastros.CADASTRO_MANUT_REDE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@section styles
    {
    <style>
        .treeclass {
            width: 30%;
        }

        .treeDiv {
            height: 200px;
            overflow: auto;
        }
    </style>
}

@section scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/maskip")
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsTreeview")
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/treejsMaster")

<script>

    var clicked = false;

    let HandleProjeto = async () => {

        $("#iProjeto").unbind("select2:select select2:unselecting");
        $("#iProjeto").on("select2:select select2:unselecting", async (event) => {

            //$(this).unbind(HandleProjeto);

            let contrato = $("#iContrato").val();
            projeto = "";

            if (event.params._type == "select" || event.params._type == undefined) {
                projeto = event.params.data.id;
            }
            if (event.params._type == "select" || event.params._type == "unselect" || event.params._type == undefined) {
                await MasterTreeView(contrato, projeto);
            }

        });

    };

    let HandleContrato = async () => {
        $("#iContrato").on("select2:select select2:unselecting", async (event) => {

            //$(this).unbind(HandleContrato);
            let contrato = "";
            projeto = $("#iProjeto").val();

            if (event.params._type == "select") {
                contrato = event.params.data.id;

                AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo",@CONSTANTES.PaginacaoRegistros, null, `${contrato}`, "@Model.Projeto", "@RsBase.SELECIONE", false, HandleProjeto);
                EnableSelect("iProjeto");
            }
            else {
                if (event.params._type == "unselecting") {
                    $("#iProjeto").val(null).trigger("change");
                }
                DisableSelect("iProjeto");
            }
        });
    };

    function ValidaSubmit() {
        if (clicked) {
            return false;
        }

        clicked = true;

        erro = false;
        if (ValidaCamposObrigatorios(erro)) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
            erro = true
        }

        if (erro) {
            clicked = false;
            return false;
        }

        ShowPageLoading();
        SaveTreeViewData();
        $('#form').submit();
        return true;
    }

    $(document).ready(async function () {
        await AddSelect("iContrato", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo",@CONSTANTES.PaginacaoRegistros, null, null, "@Model.Contrato", "@RsBase.SELECIONE", false, HandleContrato);
        await AddSelect("iProjeto", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Projeto", "@RsBase.SELECIONE", false, HandleProjeto);
        @if (String.IsNullOrEmpty(Model.Projeto)) 
        {
            <text>
                DisableSelect("iProjeto");
            </text>
        }
    });

    let MasterTree = "";
    let DisabledNodes = [];
    var arrayElementos = [];

    async function MasterTreeView(Contrato = "", Projeto = "") {
        var array = [];
        url = `@String.Concat(CONSTANTES.URLPortal, "/api/Elemento_RedeApi/GetTreeView_Manutencao")`;

        if ((Contrato != "" && Contrato != null) && (Projeto != "" && Projeto != null)) {

            url += `?Contrato=${Contrato}&&Projeto=${Projeto}`;
        }

        if ($("#iIdNode").val() != '') {

            array.push($("#iIdNode").val().split(","));

        }

        await $.ajax({
            url: url,
            type: "GET",
            dataType: "json"
        })
            .done(function (data) {
                MasterTree = new Tree('.treeclass', {
                    data: data.objeto,
                    closeDepth: 1, loaded: function () {
                        this.values = $("#iIdNode").val().split(",");
                    }
                });
            })
            .fail(function () {
                Notificar("@RsBase.ATENCAO_", "Houve um erro na Obtenção dos dados", "warning");
            });
    }

    /**
     * Salva as Informações da Treeview para repassar ao Backend
     */
    function SaveTreeViewData() {
        let arrElementos = [];
        let arrayNode = [];
        let cadeiaNodesElemento = MasterTree.selectedNodes.filter(p => p.tipo == @((int)Aniel.Connect.Repository.Model.TipoAgrupamento.ElementoRede)).map((p) => { return p.id });

        /*cadeiaNodes.forEach(function (i) {
            var condicao = 0;
            var tracos = i.matchAll("-");
            for (let traco of tracos) {
                condicao++
            }
            var position = i.lastIndexOf("-") + 1;
            if (condicao == 2) {
                arrayNode.push(i);                
            }
        });*/

        cadeiaNodesElemento.forEach(function (caminho) {

            let position = caminho.lastIndexOf("-") + 1;
            arrayNode.push(caminho)
            arrElementos.push(caminho.substring(position, caminho.length));

        });

        $("#iIdNode").val(arrayNode);
        $("#iElementos").val(arrElementos);
    }

</script>
}

@using (Html.BeginForm("Cadastro", "Manutencao", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.HiddenFor(p => p.Id)
    @Html.HiddenFor(p => p.Ids_Elementos_Afetados, new { @id = "iElementos" })
    @Html.HiddenFor(p => p.Ids_Nodes, new { @id = "iIdNode" })

    <div>
        <div class="card" style="border:none;">
            <div class="card-body">

                <div class="row">
                    <div class="col-auto mr-auto">
                        <h4 class="title-page"><i class="fas fa-server"></i> @ViewBag.Title</h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Projeto_Rede")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.ANIEL_GEOGRAPHY</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Manutencao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.MANUTENCAO_REDE</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>

                        <span style="font-size:11px" id="dtLegend"></span>
                    </div>
                </div>


                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                <span class="text-bold-card">Cadastro</span>
                            </a>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">
                            <label for="iId"></label>



                            <div class="row">
                                <div class="col-sm-8">
                                    <label for="iDescricao">@RsCadastros.DESCRICAO</label>
                                    @Html.TextBoxFor(p => p.Descricao, new { id = "iDescricao", @class = "form-control obrigatorio", @maxlength = "100", @autocomplete = "off" })
                                </div>


                                @if (ViewBag.Id != null)
                                {
                                    <text>
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                <label for="iStatus">@RsCadastros.STATUS :</label><br>
                                                @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = "iE_Cabo", @data_toggle = "toggle", @data_off = @RsBase.NAO, @data_on = @RsBase.SIM, @data_offstyle = "light", @data_onstyle = "success" })
                                            </div>
                                        </div>
                                    </text>
                                }

                            </div>
                            <div class="row">

                                <div class="col-sm-4">

                                    <div class="form-group">
                                        <label for="iContrato">@RsCadastros.CONTRATO</label>
                                        @Html.DropDownListFor(model => model.Contrato, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", id = "iContrato", autocomplete = "off" })
                                    </div>

                                </div>

                                <div class="col-sm-4">

                                    <div class="form-group">
                                        <label for="iProjeto">@RsCadastros.PROJETO</label>
                                        @Html.DropDownListFor(model => model.Projeto, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", id = "iProjeto", autocomplete = "off" })
                                    </div>

                                </div>

                            </div>

                            <div class="row pt-2 mt-2">


                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iDataInicial">@RsCadastros.DATAINICIAL:</label>
                                        <br />
                                        @Html.TextBoxFor(model => model.DataInicial, new { @class = "form-control datepicker obrigatorio", @placeholder = "00/00/0000", @id = "iDataInicial", @autocomplete = "off", @data_provide = "datepicker" })
                                    </div>
                                </div>

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iHoraInicial">@RsCadastros.HORARIO_INICIO:</label>
                                        @Html.TextBoxFor(model => model.HoraInicial, new { @class = "form-control hora obrigatorio", @placeholder = "00:00", @id = "iHoraInicial", @autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                            <div class="row pt-2 mt-2">

                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <label for="iDataFinal">@RsCadastros.DATAFINAL:</label>
                                        <br />
                                        @Html.TextBoxFor(model => model.DataFinal, new { @class = "form-control datepicker obrigatorio", @placeholder = "00/00/0000", @id = "iDataFinal", @data_provide = "datepicker", @autocomplete = "off" })
                                    </div>
                                </div>

                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label for="iHoraFinal" class="mr-3">@RsCadastros.HORARIO_FIM:</label>
                                        @Html.TextBoxFor(model => model.HoraFinal, new { @class = "form-control hora obrigatorio ", @placeholder = "00:00", @id = "iHoraFinal", @autocomplete = "off" })
                                    </div>
                                </div>
                            </div>

                            <div class="row pt-4">
                                <div class="col-sm-6 ml-3 treeDiv">
                                    <div id="div_tree"></div>
                                    <div class="treeclass"></div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divTableExport" class="d-none">
        <table class="table table-hover nowrap" id="datatable" style="width:100%">
        </table>
    </div>


    <!--Button Float-->
    <a href="@Url.Action("Index", "Manutencao")" class="float-cancel" onclick="ShowPageLoading(); return true;">
        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
            <i class="fas fa-times fa-2x"></i>
        </div>
    </a>

    <a href="#" class="float-save" onclick="return ValidaSubmit();">
        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
            <i class="fas fa-save fa-2x"></i>
        </div>
    </a>
    <!-- .modal-->
    <div class="modal" id="modal-filter">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h4 class="modal-title text-muted"> Busca Elementos de Rede</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">

                    <div class="row">
                        <div class="col">
                            <div class="form-group">
                                <label for="iContrato">@RsCadastros.CONTRATO</label>
                                <select class="form-control" id="iContrato">
                                    <option value="">@RsBase.SELECIONE</option>
                                </select>
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="iProjeto">@RsCadastros.PROJETO</label>
                                <select class="form-control" id="iProjeto">
                                    <option value="">@RsBase.SELECIONE</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="form-group">
                                <label for="iOlt">@RsCadastros.OLT</label>
                                <select class="form-control" id="iOlt">
                                    <option value="">@RsBase.SELECIONE</option>
                                </select>
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="iPop">@RsCadastros.POP</label>
                                <select class="form-control" id="iPop">
                                    <option value="">@RsBase.SELECIONE</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group col-sm-12" style="padding: 15px;">
                        <div class="text-center">
                            <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                            <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- /.modal-->


}