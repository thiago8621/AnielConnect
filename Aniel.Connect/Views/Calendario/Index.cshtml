@model Aniel.Connect.Models.CalendarioCadastroModel

@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado

@{
    ViewBag.Title = RsCadastros.PAINELCALENDARIO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{

}

@section scripts
{
    @Scripts.Render("~/bundles/jsDataTableSimples")

    <script>

    $(".hora").mask("00:00");

    var clicked = false;
    function ValidaSubmit()
    {

        if (clicked) {
            return false;
        }

        clicked = true;
        

        var erro = false;

        var dias = ["Domingo", "Segunda", "Terca", "Quarta", "Quinta", "Sexta", "Sabado"];
        var tipos = ["", "2"];

        for (var y = 0; y < tipos.length; y++) {

            for (var i = 0; i < dias.length; i++) {

                if ($("#i" + dias[i] + "_Entrada" + tipos[y]).val() > 2359) {
                    Notificar("@Resources.ATENCAO_", "@String.Format(Resources.HORA_INVALIDA)", "warning");
                    erro = true;
                }

                if ($("#i" + dias[i] + "_Entrada" + tipos[y]).val()) {
                    if ($("#i" + dias[i] + "_Entrada" + tipos[y]).val().substr(3) > 59) {
                        Notificar("@Resources.ATENCAO_", "@String.Format(Resources.HORA_INVALIDA)", "warning");
                        erro = true;
                    }
                }

                if ($("#i" + dias[i] + "_Saida" + tipos[y]).val() > 2359) {
                    Notificar("@Resources.ATENCAO_", "@String.Format(Resources.HORA_INVALIDA)", "warning");
                    erro = true;
                }

                if ($("#i" + dias[i] + "_Saida" + tipos[y]).val()) {
                    if ($("#i" + dias[i] + "_Saida" + tipos[y]).val().substr(3) > 59) {
                        Notificar("@Resources.ATENCAO_", "@String.Format(Resources.HORA_INVALIDA)", "warning");
                        erro = true;
                    }
                }

                if (($("#i" + dias[i] + "_Saida" + tipos[y]).val() !== "") && ($("#i" + dias[i] + "_Entrada" + tipos[y]).val())) {
                    if ($("#i" + dias[i] + "_Saida" + tipos[y]).val() <= $("#i" + dias[i] + "_Entrada" + tipos[y]).val()) {
                        Notificar("@Resources.ATENCAO_", "@String.Format(Resources.HORA_INVALIDA)", "warning");
                        erro = true;
                    }
                }

            }
        }





        if (erro) {
            clicked = false;
            return false;
        }
        ShowPageLoading();
        $('#form').submit();

    }

    </script>
}


