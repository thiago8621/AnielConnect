
@model Aniel.Connect.Models.MotivosCancelamentos_CadastroModels

@{
    ViewBag.Title = RsCadastros.CADASTRO_MOTIVO_CANCELAMENTO_OS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script type="text/javascript">
        @if (Model.Id == null || Model.Codigo == 0 || Model.Id == String.Empty)
        {
            <text>
            $("#divStatus").hide();
            </text>
        }
        else
        {
            <text>
            $("#divStatus").show();
            </text>
        }

        function ValidaSubmit() {
            var erro = false;
            if ($('#iDescricao').val() == "") {
                Notificar("@RsBase.ATENCAO_", "Informe a Descrição", "warning");
                erro = true;
            }

            if (erro) {
                return false;
            }

            ShowPageLoading();

            $('#form').submit();
        }

    </script>
}

@using (Html.BeginForm("Cadastro", "MotivosCancelamentos", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Codigo, new { @id = "iCodigo" })

    <div style="padding:10px">
        <div class="card" style="border:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col main-title">
                        <h4 class="title-page">
                            <i class="fas fa-sync"></i> @ViewBag.Title
                        </h4>

                        <nav aria-label="breadcrumb" class="mb-20">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "MotivosCancelamentos")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.MOTIVO_CANCELAMENTO_OS</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <span>@ViewBag.Title</span>
                                </li>
                            </ol>
                        </nav>

                    </div>
                </div>
                <div class="card div-card-accord">
                    <div class="card-header title-card" id="heading-1">
                        <h5 class="mb-0">
                            <span class="text-bold-card pt-0">@ViewBag.Title</span>
                        </h5>
                    </div>
                    <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                        <div class="card-body body-card-accord">

                            <div class="row">
                                <div class="form-group col-sm-2">
                                    <label for="iCodigo" class="mr-3">@RsCadastros.CODIGO:</label><br>
                                    @Html.TextBoxFor(model => model.Codigo, new { @maxlength = 4, @class = "form-control", @id = "iCodigo", disabled = "disabled" })
                                </div>

                                <div class="form-group col-sm-4">
                                    <label for="iDescricao" class="mr-3">@RsCadastros.DESCRICAO:<span class="text-danger">* </span></label><br>
                                    @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", @id = "iDescricao" })
                                    @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-group col-sm-4">
                                    <label for="iCodigoAuxiliar" class="mr-3">Codigo Aulixiar:</label><br>
                                    @Html.TextBoxFor(model => model.Cod_Auxiliar, new { @class = "form-control", @id = "iCodigoAuxiliar" })
                                </div>

                                <div class="col-sm-2" id="divStatus" style="display:none">
                                    <div class="form-group">
                                        <label for="iStatus">@RsCadastros.STATUS:</label><br />
                                        @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })                                       
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <a href="#" onclick="ValidaSubmit();" class="float-save" id="btnGravar">
                        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                            <i class="fas fa-save fa-2x"></i>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "MotivosCancelamentos")" class="float-cancel">
                        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                            <i class="fas fa-times fa-2x"></i>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
}