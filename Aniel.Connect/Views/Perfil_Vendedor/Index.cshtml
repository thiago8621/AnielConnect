@model  Aniel.Connect.Models.Perfil_VendedorModels
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    ViewBag.Title = RsCadastros.LISTAGEM_PERFIL_VENDEDOR;
    ViewBag.Sessao = RsCadastros.PERFIL_VENDEDOR;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
    var StorageName = CONSTANTES.SIGLA_MODULO + " - " + ViewBag.Title + " - " + CONSTANTES.Versao;
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>

        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>

}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")

<script>

    $('#modal-filter').on('show.bs.modal', function (event) {

        $(this).find('input:text').val('');
        $(this).find('input:checkbox').bootstrapToggle('off');
        $(this).find('select').val('').trigger('change');



    })


    var rows_selected = [];

        var handleDataTableButtons = function () {
            "use strict";

            function AlterarStatusObj(Status) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Perfil_Vendedorapi/alterarstatus")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected,
                        status: Status
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    });

                rows_selected = [];
            }




            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    }
                ],
                select: {
                    style: 'multi'
                },
                order: [[1, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '66vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 40,
                    boundaryScale: 0.5,
                    displayBuffer: 3
                },
                stateSave: true,
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/Perfil_Vendedorapi/GetAll',
                    type: 'POST',
                    data: function (data) {

                        window.localStorage.setItem(
                            "@Html.Raw(StorageName)",
                            JSON.stringify(
                                $('.filtro').toArray().map(p => ({
                                    id: $(p).attr('id'),
                                    value: $(p).val(),
                                    checked: $(p).prop('checked')
                                }))
                            )
                        );

                        var status = $("#iStatusFiltro option:selected").val();
                        var tipo_Pessoa = $("#iTipo_PessoaFiltro option:selected").val();
                        var meio_Captacao = $('#iMeioCaptacaoFiltro').val();
                        var regiao = $('#iRegiaoFiltro').val();
                        var area_Cobertura = $('#iArea_Cobertura').val();
                        var categoria_Cliente = $('#iCategoria_ClienteFiltro').val();

                        data.id_Status = status;
                        data.id_Tipo_Pessoa = tipo_Pessoa;
                        data.id_Meio_Captacao = meio_Captacao;
                        data.id_Regiao = regiao;
                        data.id_Area_Cobertura = area_Cobertura;
                        data.id_Categoria_Cliente = categoria_Cliente;
                        data.search.option = $("#optionSearch").val();



                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    { data: "id", title: "@RsFinanceiro.CODIGO" },
                    { data: "descricao", title: "@RsFinanceiro.DESCRICAO" },
                    { data: "tipo_Especificas", title: "@RsCadastros.DEFINIDO_TIPO_PESSOA ?" },
                    { data: "meioEspecificos", title: "@RsCadastros.DEFINIDO_MEIO_CAPTACAO ?" },
                    { data: "categoria_Especificas", title: "@RsCadastros.DEFINIDO_CATEGORIA_CLIENTE ?" },
                    { data: "regioes_Espeficias", title: "@RsCadastros.DEFINIDO_REGIAO ?" },
                    { data: "area_Especificas", title: "@RsCadastros.DEFINIDO_AREA_COBERTURA ?" },
                    { data: "status", title: "@RsFinanceiro.STATUS" },
                ]
            });



            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();

            });


            $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {



                $("#iStatusFiltro").val("").trigger("change");
                $("#iTipo_PessoaFiltro").val("").trigger("change");
                $("#iMeioCaptacaoFiltro").val("").trigger("change");
                $("#iRegiaoFiltro").val("").trigger("change");
                $("#iCategoria_ClienteFiltro").val("").trigger("change");
                $("#iArea_Cobertura").val("").trigger("change");
                $('#txtSearch').val("");
                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();

            });

             $("#iPesquisar").on("click", function () {
                if (ValidaCamposObrigatorios(false)) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.PREENCHA_CAMPOS_OBRIGATORIOS)", "warning")
                    return false;
                }
                     $("#modal-filter").modal('hide');
                     rows_selected = [];
                     oDatatable.search($('#txtSearch').val()).draw()
                    return true;
             });


            $("#btnInativar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);

            });

            $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });


            $("#btnExcluir").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Cobranca_Servicoapi/excluirlista")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function () {
                @if (AcessoHelper.TemAcesso(_areas, "231"))
                {
                 <text>
                     if (oDatatable.row(this).data() != null) {

                         var _id = oDatatable.row(this).data().id;

                         var url = '@Url.Action("Cadastro", "Perfil_Vendedor", new { id = "__id__" })';
                         window.location.href = url.replace('__id__', _id);
                         ShowPageLoading();
                     }
                 </text>
                }
                else
                {
                    <text>
                     if (oDatatable.row(this).data() != null) {


                     }
                 </text>


                }
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                // Update state of "Select all" control
                updateDataTableSelectAllCtrl(oDatatable);

            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();

</script>
}


<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col-auto mr-auto">
            <h4 class="title-page"><i class="fas fa-user-tie"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                    </li>

                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>

                </ol>
            </nav>

            @*<span style="font-size:11px" id="dtLegend"></span>*@
        </div>

        <div class="col-auto">
            <div class="row title-page">
                <div class=" pl-4 pr-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.DESCRICAO" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
                @if (AcessoHelper.TemAcesso(_areas, "230"))
                {
                    <a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "Perfil_Vendedor")" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>
                }
                else
                {
                    <a class="btn btn-success btn-add" href="#" title="@RsBase.INCLUIR" onclick="Notificar('@RsBase.ATENCAO_', '@RsBase.NAO_POSSUI_AREA_ACESSO', 'warning'); return true;"><i class="la la-plus" style="color: #fff"></i></a>

                }
                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                    <a class="dropdown-item" href="@Url.Action("Historico_Alteracao", "Perfil_Vendedor")">@RsCadastros.LOG_ALTERACAO_AREA</a>
                    @if (AcessoHelper.TemAcesso(_areas, "230"))
                    {
                        <a class="dropdown-item" id="btnInativar" href="#" onclick="return false;">@RsBase.INATIVAR</a>
                        <a class="dropdown-item" id="btnAtivar" href="#" onclick="return false;">@RsBase.ATIVAR</a>
                    }
                </div>
            </div>
        </div>

    </div>
    <!--./main-->
</div>

<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>


<!--Modal Filters-->
<div class="modal" id="modal-filter">
    <div class="modal-dialog" style="max-width:60%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsBase.FILTRO_COBRANCA_SERVICO</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">

                    <div class="col-sm-12" style="align-content:center;">

                        <div class="row mt-1">

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iStatusFiltro">@RsCadastros.STATUS:</label>
                                    @Html.EnumDropDownListFor(m => m.StatusFiltro, RsBase.SELECIONE, new { @class = "form-control", @id = "iStatusFiltro", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-4">

                                <div class="form-group">
                                    <label for="iTipo_PessoaFiltro">@RsCadastros.DEFINIDO_TIPO_PESSOA ?</label>
                                    @Html.EnumDropDownListFor(m => m.Tipo_PessoaFiltro, RsBase.SELECIONE, new { @class = "form-control", @id = "iTipo_PessoaFiltro", @autocomplete = "off" })

                                </div>
                            </div>

                        </div>
                        <div class="row">

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iMeioCaptacaoFiltro">@RsCadastros.DEFINIDO_MEIO_CAPTACAO ?</label>
                                    @Html.EnumDropDownListFor(m => m.MeioCaptacaoFiltro, RsBase.SELECIONE, new { @class = "form-control", @id = "iMeioCaptacaoFiltro", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-4">

                                <div class="form-group">
                                    <label for="iCategoria_ClienteFiltro">@RsCadastros.DEFINIDO_CATEGORIA_CLIENTE ?</label>
                                    @Html.EnumDropDownListFor(m => m.Categoria_ClienteFiltro, RsBase.SELECIONE, new { @class = "form-control", @id = "iCategoria_ClienteFiltro", @autocomplete = "off" })
                                </div>
                            </div>

                        </div>
                        <div class="row">

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iRegiaoFiltro">@RsCadastros.DEFINIDO_REGIAO ?</label>
                                    @Html.EnumDropDownListFor(m => m.RegiaoFiltro, RsBase.SELECIONE, new { @class = "form-control", @id = "iRegiaoFiltro", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-4">

                                <div class="form-group">
                                    <label for="iArea_Cobertura">@RsCadastros.DEFINIDO_AREA_COBERTURA ?</label>
                                    @Html.EnumDropDownListFor(m => m.Area_Cobertura, RsBase.SELECIONE, new { @class = "form-control", @id = "iArea_Cobertura", @autocomplete = "off" })
                                </div>
                            </div>

                        </div>


                    </div>
                </div>
            </div>
            <div class="form-group col-sm-12" style="padding: 15px;">
                <div class="text-center">
                    <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                    <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                </div>
            </div>
        </div>
    </div><!-- /.modal-content -->
</div><!-- /.modal-dialog -->
