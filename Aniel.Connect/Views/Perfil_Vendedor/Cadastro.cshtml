                                                            @Html.ValidationMessageFor(model => model.Pais, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="iUf"> @RsCadastros.UF</label>
                                                            @Html.DropDownListFor(model => model.Uf, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control obrigatorioUF", @id = "iUf" })
                                                            @Html.ValidationMessageFor(model => model.Uf, "", new { @class = "text-danger" })
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="col-sm-3">

                                                    <div class="form-group">
                                                        <label for="iCidade">@RsCadastros.CIDADE</label>
                                                        @Html.DropDownListFor(model => model.Cidade, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control obrigatorioCidade", @id = "iCidade" })
                                                        @Html.ValidationMessageFor(model => model.Cidade, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>


                                                <div class="form-group col-sm-12" style="padding: 15px;">
                                                    <div class="text-left">

                                                        <button type="button" class="btn btn-success" id="btnAdicionarTipoRegiao">Adicionar</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="card div-card-accord">

                                        <div class="card-header title-card" id="heading-3">
                                            <h5 class="mb-0">
                                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-3" aria-expanded="true" aria-controls="collapse-3">
                                                    <span class="text-bold-card">@RsCadastros.LISTA_REGIOES</span>
                                                </a>
                                            </h5>
                                        </div>
                                        <div id="collapse-5" class="collapse show" data-parent="#accordion" aria-labelledby="heading-5">
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <table class="table table-hover nowrap" id="datatableTipoRegiao" style="width:100%"></table>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>

                        <!---Modal Area Cobertura-->
                        <div role="tabpanel" class="tab-pane" id="iAreaCobertura">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="card div-card-accord">

                                        <div class="card-header title-card" id="heading-2">
                                            <h5 class="mb-0">
                                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-2" aria-expanded="true" aria-controls="collapse-2">
                                                    <span class="text-bold-card">@RsCadastros.ADICIONAR_AREA_COBERTURA</span>
                                                </a>
                                            </h5>
                                        </div>
                                        <div id="collapse-2" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    <label for="iArea_Especificas">@RsCadastros.AREA_ESPECIFICA ?:</label>
                                                    @Html.CheckBoxFor(m => m.Area_Especificas, new { @data_height = 28, @class = "form-control", @id = "iArea_Especificas", @name = "iArea_Especificas", @data_toggle = "toggle", @data_on = "Ativo", @data_off = "Inativo", @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>
                                            <div id="AbaArea">
                                                <div class="col-sm-6">
                                                    <div class="form-group">
                                                        <label for="iArea"> @RsCadastros.AREA_COBERTURA</label>
                                                        @Html.DropDownListFor(model => model.Area, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control obrigatorioAreaCobertura", @id = "iArea" })
                                                        @Html.ValidationMessageFor(model => model.Area, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>


                                                <div class="form-group col-sm-12" style="padding: 15px;">
                                                    <div class="text-left">

                                                        <button type="button" class="btn btn-success" id="btnAdicionarTipoArea">Adicionar</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="card div-card-accord">

                                        <div class="card-header title-card" id="heading-3">
                                            <h5 class="mb-0">
                                                <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-3" aria-expanded="true" aria-controls="collapse-3">
                                                    <span class="text-bold-card">@RsBase.LISTA_AREA_ADICIONADA</span>
                                                </a>
                                            </h5>
                                        </div>
                                        <div id="collapse-5" class="collapse show" data-parent="#accordion" aria-labelledby="heading-5">
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <table class="table table-hover nowrap" id="datatableTipoArea" style="width:100%"></table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>



                    </div>
                </div>
            </div>
        </div>

        <!--Button Float-->
        <a href="@Url.Action("Index", "Cobranca_Servico")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>
    </div>

}