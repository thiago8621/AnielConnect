    var handleDataTableButtonsTipoPessoa= function () {
    "use strict";

        var array = @Html.Raw(Json.Encode(Model.TipoPessoa));
        var nome_lista = "TipoPessoa";//Nome_utilizado para enganar o razor

        //"Blfrtip"
        var oDatatableTipoPessoa = $("#datatableTipoPessoa").length && $("#datatableTipoPessoa").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: array,
            scrollX: true,
            ordering: true,
            scrollCollapse: true,
            paging: false,
            autoPrint: false,
            columns: [


                {
                    data: "Id",
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluirTipoPessoa" id="btnExcluirTipoPessoa' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
                {

                    data: "Tipo_Pessoa_Desc",
                    title: "@RsCadastros.TIPOPESSOA",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Tipo_Pessoa_Desc" name="' + nome_lista + '[' + meta.row + '].Tipo_Pessoa_Desc" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Tipo_Pessoa" name="' + nome_lista + '[' + meta.row + '].Tipo_Pessoa" type="hidden" value="' + TrataNulo(row.Tipo_Pessoa) + '">';
                        }
                        return data;
                    }

                },


            ]

        });

        function handleExcluir() {
            $(".btnExcluirTipoPessoa").unbind('click');
            $(".btnExcluirTipoPessoa").click(function (e) {
                e.preventDefault();

                var idArquivo = $(this).attr("excluir");

                var trLinkButton = $(this).parents('tr');

                if (idArquivo === "0") {
                    oDatatableTipoPessoa.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
                else {

                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Perfil_VendedorApi/ExcluirGridTipoPessoa?value=")' + idArquivo;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',

                    })
                        .done(function (data) {

                            if (data.ok) {
                                oDatatableTipoPessoa.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }
                        })
                        .fail(function () {

                        })
                        .always(function () {

                        });
                }

            });
        }

        handleExcluir();

        $("#btnAdicionarTipoPessoa").unbind('click');
        $("#btnAdicionarTipoPessoa").on('click', function () {

            var erro = false;
             if (ValidaObrigatoriosPorClasse("obrigatorioTipo_pessoa", false)) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                    return false;
                }


            for (var i = 0; i < oDatatableTipoPessoa.rows().data().length; i++) {

                if (oDatatableTipoPessoa.rows().data()[i].Tipo_Pessoa == $("#iTipo_Pessoa option:selected").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.TIPOPESSOA)", "warning");
                        erro = true;
                        i = oDatatableTipoPessoa.rows().data().length;
                    }

                }

                if (erro) {
                    return false;
                }

            oDatatableTipoPessoa.row.add({
                Id: 0,
                Tipo_Pessoa_Desc: $("#iTipo_Pessoa option:selected").text(),
                Tipo_Pessoa: $("#iTipo_Pessoa").val(),


            }).draw(false);

            handleExcluir();
           /* $("#iTipo_Pessoa").val(null).trigger('change');*/
        });
    },
        TableManageButtonsTipoPessoa = function () {
        "use strict";
        return {
            init: function () {
                handleDataTableButtonsTipoPessoa();
            }
        }
        }();

    TableManageButtonsTipoPessoa.init();

