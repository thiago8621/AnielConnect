        });

    },
      TableManageButtonsTipoCategoria = function () {
        "use strict";
        return {
            init: function () {
                handleDataTableButtonsTipoCategoria();

            }
        }
        }();

    TableManageButtonsTipoCategoria.init();

    var handleDataTableButtonsTipoArea = function () {
    "use strict";

      var array = @Html.Raw(Json.Encode(Model.TipoArea));
      var nome_lista = "TipoArea";//Nome_utilizado para enganar o razor

        //"Blfrtip Categoria"
        var oDatatableTipoArea = $("#datatableTipoArea").length && $("#datatableTipoArea").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            scrollX: true,
            ordering: true,
            data: array,
            columns: [
                {
                    data: "Id",
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluirTipoArea" id="btnExcluirTipoArea' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                            ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },


                {
                    data: "Tipo_Area_Desc",
                    title: "@RsCadastros.AREA_COBERTURA",
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Tipo_Area_Desc" name="' + nome_lista + '[' + meta.row + '].Tipo_Area_Desc" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Tipo_Area_Desc" name="' + nome_lista + '[' + meta.row + '].Tipo_Area" type="hidden" value="' + TrataNulo(row.Tipo_Area) + '">';
                        }
                        return data;
                    }
                },

            ]
        });

        function handleExcluir() {
            $(".btnExcluirTipoArea").unbind('click');
            $(".btnExcluirTipoArea").click(function (e) {
                e.preventDefault();

                var idArquivo = $(this).attr("excluir");

                var trLinkButton = $(this).parents('tr');


                if (idArquivo === "0") {
                    oDatatableTipoArea.row(trLinkButton).remove().draw(false);

                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
                else {

                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Perfil_VendedorApi/ExcluirTipoAreaGrid?value=")' + idArquivo;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json',

                    })
                        .done(function (data) {

                            if (data.ok) {
                                oDatatableTipoArea.row(trLinkButton).remove().draw(false);
                                Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                            }
                            else {
                                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            }

                        })
                        .fail(function () {

                        })
                        .always(function () {

                        });
                }
            });
        }

        handleExcluir();

        $("#btnAdicionarTipoArea").unbind('click');
        $("#btnAdicionarTipoArea").on('click', function () {

            var erro = false;
                if (ValidaObrigatoriosPorClasse("obrigatorioAreaCobertura", false)) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                    return false;
                }


            for (var i = 0; i < oDatatableTipoArea.rows().data().length; i++) {

                    if (oDatatableTipoArea.rows().data()[i].Tipo_Area == $("#iArea option:selected").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.AREA)", "warning");
                        erro = true;
                        i = oDatatableTipoArea.rows().data().length;
                    }

                }

                if (erro) {
                    return false;
                }

            oDatatableTipoArea.row.add({
                Id: 0,
                Tipo_Area_Desc: $("#iArea option:selected").text(),
                Tipo_Area: $("#iArea").val(),


            }).draw(false);


            handleExcluir();
            $("#iArea").val(null).trigger('change');

        });

    },
        TableManageButtonsTipoArea = function () {
        "use strict";
        return {
            init: function () {
                handleDataTableButtonsTipoArea();

            }
        }
        }();

    TableManageButtonsTipoArea.init();



    var clicked = false;
    function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

</script>
}


