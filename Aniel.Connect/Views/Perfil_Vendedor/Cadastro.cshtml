    ViewBag.Title = RsCadastros.CADASTRO_PERFIL_VENDEDOR;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")

    <style>
        /*div#divPerfil {
            height: 180px !important;
        }*/
    </style>
}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
<script>
    $('a[data-toggle="tab"]').on('shown.bs.tab', () => {
        $("#datatableTipoPessoa").DataTable().columns.adjust();
        $("#datatableTipoRegiao").DataTable().columns.adjust();
        $("#datatableTipoMeio").DataTable().columns.adjust();
        $("#datatableTipoCategoria").DataTable().columns.adjust();
        $("#datatableTipoArea").DataTable().columns.adjust();

    })

    $(document).ready(function () {

        $('#iTipo_Especificas').trigger('change');
        $('#iMeioEspecificos').trigger('change');
        $('#iCategoria_Especificas').trigger('change');
        $('#iRegiao_Especificas').trigger('change');
        $('#iRegiao_Especificas').trigger('change');


            AddSelect("iMeioCaptacao", "@CONSTANTES.URLPortal/api/Meio_Captacaoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iMeio_Categoria", "@CONSTANTES.URLPortal/api/Categoria_ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iPais", "@CONSTANTES.URLPortal/api/Paisapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Pais", "@RsBase.SELECIONE", false, HandlePais);
            AddSelect("iArea", "@CONSTANTES.URLPortal/api/Area_Coberturaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);


    });


      var PaisSelecionado = null;
          var HandlePais = function () {
              $('#iPais').on('select2:select select2:unselecting', function (e) {
                  PaisSelecionado = e.params.data;

                  if (PaisSelecionado == undefined) {
                      AddSelect("iPais", "@CONSTANTES.URLPortal/api/Paisapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandlePais);
                      $("#iUf").prop("disabled", true);
                      $('#iUf').val(null).trigger('change');
                      $("#iCidade").prop("disabled", true);
                      $('#iCidade').val(null).trigger('change');

                  } else {

                      $("#iUf").prop("disabled", false);
                      AddSelect("iUf", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, PaisSelecionado.id, "@Model.Uf", "@RsBase.SELECIONE", false, HandleUf);
                  }
            });
          }

        var UfSelecionado = null;
        var HandleUf = function () {
            $('#iUf').on('select2:select select2:unselecting', function (e) {
                UfSelecionado = e.params.data;

                if (UfSelecionado == undefined) {
                    AddSelect("iUf", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleUf);
                    $("#iCidade").prop("disabled", true);
