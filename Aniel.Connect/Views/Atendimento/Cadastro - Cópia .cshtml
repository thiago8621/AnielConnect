    $("#btnCriarOs").click(function () {

            @if (Model.Cliente_Status != Status_Cliente.Ativo)
            {
                <text>Notificar("@RsBase.ATENCAO_", "Não é possível criar Os para cliente Inativo.", "warning");</text>
            }
            else if (Model.Tipo_Cliente != Convert.ToInt32(Tipo_Cliente.Cliente))
            {
                <text>Notificar("@RsBase.ATENCAO_", "Não é possível criar Os para prospect.", "warning");</text>
            }
            else if (Model.Id_Plano_Produto == 0 && Model.Id_Plano_Produto == null)
            {
                <text>Notificar("@RsBase.ATENCAO_", "Não é possível criar Os pois nao foi informado plano/produto.", "warning");</text>
            }
            else {
                <text>ShowPageLoading();</text>
                <text>window.location = '@Url.Action("Criar_Ordem_Servico", "Painel_Servicos", new { Id_Atendimento = Model.Id })'</text>
            }

