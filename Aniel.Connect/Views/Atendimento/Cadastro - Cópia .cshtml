        function AddAba(url, title, id = 'undefined') {

            parent.addTabs({
                id: id,
                title: title,
                close: true,
                url: url,
                urlType: "absolute"
            });
        }

            function EnviarPesquisa() {
                @*var url = "@Url.Action("Cadastro", "Pesquisa_Satisfacao")";
                var titulo = "Pesquisa Satisfacao";
                AddAba(url, titulo);
                return false;*@
            }


            function AlterarEndereco(idEndereco) {
                if ($("#iCpfCliente").val() == "" && idEndereco == "") {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.INFORME_CLIENTE)", "warning");
                    return false;
                }
                if (idEndereco == "") {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.NAO_EXISTE_ENDERECO_INSTALACAO_ASSOCIADO_AO_CLIENTE)", "warning");
                    return false;
                }
                if ($("#iCpfCliente").val() != "") {
                    ShowDialog(true, true, 'Alterar Endereco', '@Url.Action("AlterarEndereco", "Cliente")?atendimento=' + @Model.Id + '&IdEndereco=' + idEndereco, 'divAlterarEndereco', 850, 525, 'iframeAlterarEndereco'); // + '?Id_Cliente=' + idCliente
                }
                else {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.INFORME_CLIENTE)", "warning");
                }
            }

        var clienteSelecionado = null;
        var tipoCliente = null;
        var listaPlanosProdutos = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Planos_Produtos,
                                                                                        Newtonsoft.Json.Formatting.Indented,
                                                                                        new Newtonsoft.Json.JsonSerializerSettings { ContractResolver = new Newtonsoft.Json.Serialization.CamelCasePropertyNamesContractResolver() } )));

        function findPlanoProduto(id) {

            return $.grep(listaPlanosProdutos, function (item) {
                return item.value == id;
            });
        };

        function AbrirHistorio() {

                var _id = $("#iId").val();
                window.location = '@Url.Action("HistoricoAtendimento", "Atendimento")' + "?IdAtendimento=" + _id;

        };


        function Script_Atendimento() {

            var _id_antendimento = $("#iId").val();
            var _id_tipo_atendimento = $("#iTipoAtendimento option:selected").val();

            window.location = "@Url.Action("Script_Atendimento", "Atendimento")" + "?IdAtendimento=" + _id_antendimento + "&IdTipoAtendimento=" + _id_tipo_atendimento;
        }


         var Responsaveis = @Html.Raw(Json.Encode(ViewBag.Responsaveis));


        var HandleDepartamento = function () {
            $('#iDepartamento').on('select2:select select2:unselecting', function (e) {
                DepartamentoSelecionado = e.params.data;
                AddSelect("iResponsavel", "@CONSTANTES.URLPortal/api/Identity_UserApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, DepartamentoSelecionado.id, "@Model.Id_Responsavel", "@RsBase.SELECIONE", disabled);
