@section scripts
{

    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

<script>



        var ja_passou = null;

        var criar_Os_Encerrar = false ;
        var id_tipo_atendimento = parseInt( $("#iTipoAtendimento option:selected").val() );
        var login_radius = "";

        var Tipo_AtendimentoSelecionado = null;
        var HandleTipo_Atendimento = function () {
            $('#iTipoAtendimento').on('select2:select select2:unselecting', function (e) {

                Tipo_AtendimentoSelecionado = e.params.data;

                if (Tipo_AtendimentoSelecionado.id != "@Model.Id_Tipo_Atendimento") {

                    if (Tipo_AtendimentoSelecionado != undefined && Tipo_AtendimentoSelecionado.prioridade_Padrao != '') {

                        Tipo_AtendimentoSelecionado.prioridade_Padrao == '@Convert.ToInt32(Prioridade_Atendimento.Alto)' ? $('#labelPrioridadeAlta').addClass('active') : $('#labelPrioridadeAlta').removeClass('active');
                        Tipo_AtendimentoSelecionado.prioridade_Padrao == '@Convert.ToInt32(Prioridade_Atendimento.Medio)' ? $('#labelPrioridadeMedia').addClass('active') : $('#labelPrioridadeMedia').removeClass('active');
                        Tipo_AtendimentoSelecionado.prioridade_Padrao == '@Convert.ToInt32(Prioridade_Atendimento.Baixo)' ? $('#labelPrioridadeBaixa').addClass('active') : $('#labelPrioridadeBaixa').removeClass('active');
                    }

                    if (Tipo_AtendimentoSelecionado != undefined && Tipo_AtendimentoSelecionado.categoria_Atendimento != '') {
                        var categoriaBloq = @Json.Encode(CamposObrigatoriosAtendimentoApiController.CampoBloqueado(campos, CamposObrigatoriosAtendimentoEnum.CATEGORIA_ATENDIMENTO));
                        AddSelect("iCategoriaAtendimento", "@CONSTANTES.URLPortal/api/categoria_atendimentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, Tipo_AtendimentoSelecionado.categoria_Atendimento, "@RsBase.SELECIONE", disabled || categoriaBloq);
                    }
                }

                if (Tipo_AtendimentoSelecionado != undefined && Tipo_AtendimentoSelecionado.criar_Os_Encerrar != '') {
                    if(Tipo_AtendimentoSelecionado.criar_Os_Encerrar == "1")
                        criar_Os_Encerrar = true;
                    else
                        criar_Os_Encerrar = false;
                }

                if (Tipo_AtendimentoSelecionado != undefined && Tipo_AtendimentoSelecionado.script != '') {
                    $("#iLink_Script_Atendimento").show();
                }
                else {
                    $("#iLink_Script_Atendimento").hide();
                }
            });
        }

        function CarregarTodos() {

            //$("#btnCarregarTodos").hide();

