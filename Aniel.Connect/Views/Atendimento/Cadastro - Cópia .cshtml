        $("#iStatusAtendimento").change(function () {

            $('#iDescMotivoStatus').val('');
            AddSelect("iDescMotivoStatus", "@CONSTANTES.URLPortal/api/motivo_status_atendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null,$("#iStatusAtendimento").val(),"@Model.Id_Motivo_Status", "@RsBase.SELECIONE", disabled);
            status_atendimento_value = $("#iStatusAtendimento option:selected").val();
            if (['2', '3', '4'].includes(status_atendimento_value)) {
                $('#iDivMotivoStatus').removeClass('readonly');
                HandleDescMotivoStatus();
            }
            else {
                $('#select2-iDescMotivoStatus-container').parent().addClass('readonly');
            }


        });

        function HandleDescMotivoStatus() {
           jQuery($("#iDescMotivoStatus")).removeData('autocomplete');
            $("#iDescMotivoStatus").autocomplete({
                source: '@(CONSTANTES.URLPortal)' + '/api/motivo_status_atendimentoapi/busca' + '?Status_Motivo=' + $("#iStatusAtendimento").val(),
                dataType: "json",
                minLength: 2,
                focus: function () { return false; },
                open: function () {
                    setTimeout(function () {
                        $('.ui-autocomplete').css('z-index', 99999999999999);
                    }, 0);
                },
                select: function (event, ui) {
                    var obj = ui.item;
                    $("#iMotivoStatus").val(obj.value);
                    $("#iDescMotivoStatus").val(obj.label);
                    return false;
                },
                change: function (event, ui) {
                    if (!ui.item) {
                        $("#iMotivoStatus").val(null);
                        $("#iDescMotivoStatus").val(null);
                    }
                    return false;
                }
            }).css('z-index', 100);
        }

        var disabled = (@Json.Encode((new[] { Status_Atendimento.Concluido, Status_Atendimento.Cancelado }).Contains(Model.Status_Atendimento)));
        $('#iGrupoArea').change(function () {

            var grupo_area = $('#iGrupoArea option:selected').val();
            var enderecoApi = "@CONSTANTES.URLPortal/api/Areaapi/GetList?grupo_area=" + grupo_area;

            $('#iArea').empty();
            $('#iLocalidade').empty();

            $.ajax({
            url: enderecoApi,
            type: 'GET',
            dataType: 'json'

        })
                .done(function (data) {

                    $('#iArea').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                    $.each(data.objeto, function (key, value) {
                        $('#iArea').append($('<option></option>').attr('value', value.value).text(value.label));
                });

                var grupo_area = $('#iGrupoArea option:selected').val();
                var area = $('#iArea option:selected').val();

                var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

                    $('#iLocalidade').empty();

                    $.getJSON(enderecoApi, function (data) {
                        $('#iLocalidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                        $.each(data.objeto, function (key, value) {
                            $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));
                    });

                });
            })
            .fail(function () {
                console.log("error");
            })
            .always(function () {
                try {
                    parent.App.stopPageLoading();
                }
                catch (ex) { console.log(ex); }

            });

        });

        $('#iArea').change(function () {

            var grupo_area = $('#iGrupoArea option:selected').val();
            var area = $('#iArea option:selected').val();

            var enderecoApi = "@CONSTANTES.URLPortal/api/Localidadeapi/GetList?grupo_area=" + grupo_area + "&area=" + area;

            $('#iLocalidade').empty();

            $.getJSON(enderecoApi, function (data) {
                $('#iLocalidade').append($('<option></option>').attr('value',"").text('@RsBase.SELECIONE'));
                $.each(data.objeto, function (key, value) {
                    $('#iLocalidade').append($('<option></option>').attr('value', value.value).text(value.label));
                });

            });


        });


