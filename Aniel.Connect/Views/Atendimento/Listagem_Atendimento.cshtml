                        <a class="dropdown-item" href="@Url.Action("Index", "Modelo_PainelAtendimento")">@RsBase.GERENCIAR_MODELOS_DE_VISUALIZACAO</a>
                    }
                    @if (AcessoHelper.TemAcesso(_areas, "184"))
                    {
                        <a class="dropdown-item" onclick="mesclarAtendimento()">@RsCadastros.MESCLAR_ATENDIMENTO</a>
                    }

                </div>
                <button class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" return true;" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>
                <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
