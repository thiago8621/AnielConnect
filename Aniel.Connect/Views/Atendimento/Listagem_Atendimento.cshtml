                else if (!isNaN($("input[type='radio'][name='periodo']:checked").val()) && $("#iData_Inicial").val() == "" && $("#iData_Final").val() == "") {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.DATA_INVALIDA)", "warning");
                }
                else if (data_ini > data_fim) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.DATA_INVALIDA)", "warning");
                }
                else {

                    $("#iData_Inicial").val(_data_ini);
                    $("#iData_Final").val(_data_fim);

                    rows_selected = [];
                    oDatatable.search($('#txtSearch').val()).draw();


                    $("#iData_Inicial").val(_data_ini_old);
                    $("#iData_Final").val(_data_fim_old);
                }
                return true;
            });

