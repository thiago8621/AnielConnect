            async function sweetAlertMotivo() {

                Swal.fire({
                    title: 'Por favor selecione um motivo para cancelar os atendimentos.',
                    html: '<select class="swal2-input" type="text" id="iDescMotivoCancelar" autocomplete="off">',
                    showCancelButton: true,
                    onOpen: function () {
                        AddSelect("iDescMotivoCancelar", "@CONSTANTES.URLPortal/api/motivo_status_atendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, 3, null, "@RsBase.SELECIONE", false);
                    },
                    cancelButtonText: 'Não',
                    confirmButtonText: 'Sim',
                    type: 'question',
                    allowOutsideClick: () => !Swal.isLoading(),
                }).then(async input => {
                    
                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoApi/VerificaAtendimentoChatMongo")';
                    const result = await $.ajax({
                        url: link,
                        type: 'POST',
                        dataType: 'json',
                        beforeSend: function () {
                            ShowPageLoading();
                        },
                        complete: function () {
                            HidePageLoading();
                        },
                        data: {
                            ids: rows_selected
                        }
                    });
                    
                    if (result.objeto.length > 0) {
                        var protocolo = "";
                        for (var i = 0; i < rows_selected.length; i++) {
                            const item_array = rows_selected[i];
                            const array_protocolo = result.objeto.filter(x => x.id == item_array);
                            if (array_protocolo.length > 0) {
                                rows_selected.splice(i, 1);

                                if (protocolo != "") {
                                    protocolo += ",";
                                }
                                protocolo += array_protocolo[0].protocolo;
                            }
                        }

                        if (protocolo != "") {
                            var html = `Atenção! Não foi possível cancelar o(s) protocolo(s) {protocolo}. Pois, se encontra em atendimento com o chat.`, protocolo_aux = '';
                            var split = protocolo.includes(',') ? protocolo.split(',') : [protocolo];
                            for (var i = 0; i < split.length; i++) {
                                protocolo_aux += `${split[i]}\n`;
                            }

                            html = html.replace("{protocolo}", protocolo_aux);
                            await Swal.fire({
                                text: `${html}`,
                                type: 'warning',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'OK',
                            });
                        }
                    }

                    if (input.value && $('#iDescMotivoCancelar').val()) {
                        AlterarStatusObj(3, $('#iDescMotivoCancelar').val());
                    }
                    else if (input.value && !$('#iDescMotivoCancelar').val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsCadastros.MOTIVO_STATUS_ATENDIMENTO)", "warning");
                    }
                });

            }

            $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(1);
            });


            $("#btnExcluir").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoApi/excluirlista")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();

                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                });
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                var rowId = oDatatable.row($row).data().id;

                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                if ($("input[name='select_all']").prop("checked")) {

                    //Exibe quantidade de linhas selecionadas
                    rowsSelectedMessage()
                    $("#dtLegendRecordsTotal").show();

                } else {

                    //Esconde quantidade de linhas selecionadas
                    rowsSelectedMessage()
                    $("#dtLegendRecordsTotal").hide();
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });


            $('#datatable tbody').on('click', 'tr', function (e) {
                if ($(e.target).hasClass('modal-ordem-servico') || $(e.target).closest('.modal-ordem-servico').length > 0) {
                    //selecionarAtendimento(oDatatable.row(this).data().numero);
