<div id="divTable">
    <table class="table table-hover nowrap" id="datatable" style="width:100%">
    </table>
</div>


<!--Modal Filters-->
<div class="modal" id="modal-filter">
    <div class="modal-dialog" style="max-width:60%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">@RsCadastros.FILTROS_PAINEL_ATENDIMENTO</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">

                    <div class="col-sm-12" style="align-content:center;">

                        <label style="font-size: 12px">@RsCadastros.SLA_ATENDIMENTO:</label><br />
                        <div class="col-sm-12 pl-3 border_radius">

                            <div class="form-group">
                                <div class="form-check mt-2">
                                    <div class="row">

                                        <div class="col">
                                            @Html.CheckBoxFor(m => m.Dentro_Prazo, new { @class = "form-check-input", @id = "iDentroPrazo", @autocomplete = "off" })
                                            <label for="iDentroPrazo">@RsCadastros.DENTRO_PRAZO </label>
                                        </div>

                                        <div class="col">
                                            @Html.CheckBoxFor(m => m.Atencao, new { @class = "form-check-input", @id = "iAtencao", @autocomplete = "off" })
                                            <label for="iAtencao">@RsCadastros.ATENCAO </label>
                                        </div>
                                        <div class="col">
                                            @Html.CheckBoxFor(m => m.Vencimento_Proximo, new { @class = "form-check-input", @id = "iVencimentoProximo", @autocomplete = "off" })
                                            <label for="iVencimentoProximo">@RsCadastros.VENCIMENTO_PROXIMO </label>
                                        </div>
                                        <div class="col">
                                            @Html.CheckBoxFor(m => m.Risco_Perda_Prazo, new { @class = "form-check-input", @id = "iRiscoPerdaPrazo", @autocomplete = "off" })
                                            <label for="iRiscoPerdaPrazo">@RsCadastros.RISCO_PERDA_PRAZO </label>
                                        </div>
                                        <div class="col">
                                            @Html.CheckBoxFor(m => m.Prazo_Vencido, new { @class = "form-check-input", @id = "iPrazoVencido", @autocomplete = "off" })
                                            <label for="iPrazoVencido">@RsCadastros.PRAZO_VENCIDO </label>
                                        </div>

                                    </div>
                                </div>
                            </div>

                        </div>


                        <label style="font-size: 12px">@RsCadastros.PRIORIDADE_ATENDIMENTO:</label><br />
                        <div class="col-sm-12 pt-1 pl-3 border_radius">

                            <div class="form-group">
                                <div class="form-check mt-2">
                                    <div class="row">
                                        <div class="col-sm-2">
                                            @Html.CheckBoxFor(m => m.Baixa, new { @class = "form-check-input", @id = "iBaixa", @autocomplete = "off" })
                                            <label for="iBaixa">@RsCadastros.BAIXA </label>
                                        </div>

                                        <div class="col-sm-2">
                                            @Html.CheckBoxFor(m => m.Media, new { @class = "form-check-input", @id = "iMedia", @autocomplete = "off" })
                                            <label for="iMedia">@RsCadastros.MEDIA </label>
                                        </div>

                                        <div class="col-sm-2">
                                            @Html.CheckBoxFor(m => m.Alta, new { @class = "form-check-input", @id = "iAlta", @autocomplete = "off" })
                                            <label for="iAlta">@RsCadastros.ALTA </label>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-1">

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iCategoria_Atendimento">@RsCadastros.CATEGORIA_ATENDIMENTO:</label>
                                    @Html.DropDownList("Categoria_Atendimento", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iCategoria_Atendimento", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-4">

                                <div class="form-group">
                                    <label for="iTipoAtendimento">@RsCadastros.TIPO_ATENDIMENTO:</label>
                                    @Html.DropDownList("TipoAtendimento", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iTipoAtendimento", @autocomplete = "off" })
                                </div>

                            </div>

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label> @RsCadastros.ETAPA_ATUAL: </label>
                                    @Html.DropDownListFor(m => m.Etapa_Atual, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iEtapa_Atual", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Etapa_Atual, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row mt-1">





                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iSetor">@RsCadastros.SETOR:</label>
                                    @Html.DropDownList("Setor", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iSetor", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-8">
                                <div class="form-group">
                                    <label> @RsCadastros.RESPONSAVEL_ATUAL: </label>
                                    @Html.DropDownListFor(m => m.Responsavel_Atual, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iUsuario_Responsavel", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Responsavel_Atual, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row mt-1">

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iStatus">@RsCadastros.STATUS:</label>
                                    @Html.EnumDropDownListFor(m => m.Status_Atendimento, RsBase.SELECIONE, new { @class = "form-control", @id = "iStatus" })
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iStatus">@RsCadastros.STATUS Auditoria:</label>
                                    @Html.EnumDropDownListFor(m => m.StatusAuditoria, RsBase.SELECIONE, new { @class = "form-control", @id = "iStatusAuditoria" })
                                </div>
                            </div>

                            <div class="col-sm-8">
                                <div class="form-group">

                                    @Html.CheckBox("ativarMotivo", false, new { @id = "ativarMotivo" })<label for="iMotivo_Status" class="pl-1">@RsCadastros.MOTIVO_STATUS_ATENDIMENTO:</label>

                                    @Html.DropDownList("Motivo_Status", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iMotivo_Status", @autocomplete = "off" })
                                </div>
                            </div>
                        </div>

                        <div class="row mt-1">

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iNum_Os">@RsCadastros.NUMERO_ATENDIMENTO:</label>
                                    @Html.TextBoxFor(m => m.Num_Os, new { @class = "form-control", @id = "iNum_Os" })
                                </div>
                            </div>

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label> @RsCadastros.ORIGEM: </label>
                                    @Html.DropDownListFor(m => m.Origem, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iOrigem", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Origem, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label> @RsCadastros.PLANOS_E_PRODUTOS: </label>
                                    @Html.DropDownListFor(m => m.Plano_Produto, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iPlano_Produto", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Plano_Produto, "", new { @class = "text-danger" })
                                </div>
                            </div>

                        </div>

                        <div class="row mt-1">

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iCategoria_Cliente">@RsCadastros.CATEGORIA_CLIENTE:</label>
                                    @Html.DropDownList("Categoria_Cliente", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iCategoria_Cliente", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iOrganizacao">@RsCadastros.ORGANIZACAO_CLIENTE:</label>
                                    @Html.DropDownList("Organizacao", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iOrganizacao", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iCliente_Prospecto">@RsCadastros.CLIENTE_PROSPECTO:</label>
                                    @Html.DropDownList("Cliente_Prospecto", new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control filtro", @id = "iCliente_Prospecto", @autocomplete = "off" })
                                </div>
                            </div>

                        </div>                        

                        <div class="mt-1">

                            <div class="form-group">
                                <label for="divDatas" class="mb-2">@RsCadastros.PERIODO:</label><br />

                                @Html.RadioButton("periodo", 0, false, new { @id = "radioAbertura" }) <label for="radioAbertura">@RsCadastros.DATA_ABERTURA</label><br />
                                @Html.RadioButton("periodo", 1, false, new { @id = "radioEncerramento" }) <label for="radioEncerramento">@RsCadastros.DATA_ENCERRAMENTO</label><br />
                                @Html.RadioButton("periodo", 2, false, new { @id = "radioSlaEtapa" }) <label for="radioSlaEtapa">@RsCadastros.DATA_SLA_ETAPA</label>

                            </div>

                            <div class="row pl-3" id="divDatas">

                                @Html.TextBoxFor(m => m.Data_Inicial, new { @tabindex = "7", @class = "form-control datepicker mr-2", @data_provide = "datepicker", @id = "iData_Inicial", @autocomplete = "off" }) @RsBase.A
                                @Html.TextBoxFor(m => m.Data_Final, new { @tabindex = "7", @class = "form-control datepicker ml-2", @data_provide = "datepicker", @id = "iData_Final", @autocomplete = "off" })

                            </div>



                        </div>
                    </div>



                </div>

            </div>

            <div class="form-group col-sm-12" style="padding: 15px;">
                <div class="text-center">
                    <button type="button" class="btn btn-danger" id="iLimparFiltroModal">@RsBase.LIMPAR_FILTRO</button>
                    <button type="button" class="btn btn-success" id="iPesquisar">@RsCadastros.PESQUISAR</button>
                </div>
            </div>

        </div>




    </div><!-- /.modal-content -->
</div><!-- /.modal-dialog -->
