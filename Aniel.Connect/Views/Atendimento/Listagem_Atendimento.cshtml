            //"Blfrtip"
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti",
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center',
                        render: function (data, type, full, meta) {
                            return "<input type='checkbox'></input>";
                        }
                    },
                    {
                        targets: 1,
                        searchable: false,
                        orderable: false,
                        width: '1%',
                        className: 'dt-body-center'
                    }
                ],
                select: 'multi',
                order: colunas_modelo?.ordenar_por == null ? [[3, 'desc']] : colunas_modelo.ordenar_por,
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '79vh',
                stateSave: false, //statesave carregando datable com info antiga
                scrollX: true,
                fixedHeader: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                pageLength: 10,
                ajax: {
                    url: baseUrl + '/api/atendimentoapi/GetAll',
                    type: 'POST',
                    data: function (data) {


                        window.localStorage.setItem(
                            "@Html.Raw(StorageName)",
                            JSON.stringify(
                                $('.filtro').toArray().map(p => ({
                                    id: $(p).attr('id'),
                                    value: $(p).val(),
                                    checked: $(p).prop('checked')
                                }))
                            )
                        );

                        var tipo_data = $("input[type='radio'][name='periodo']:checked").val();

                        // Prioridade
                        let lista_prioridade = [];
                        if ($("#iAlta").prop("checked")) {
                            //data.prioridade_Atendimento = 2;
                            lista_prioridade.push(2);
                        }
                        if ($("#iMedia").prop("checked")) {
                            //data.prioridade_Atendimento = 1;
                            lista_prioridade.push(1);
                        }
                        if ($("#iBaixa").prop("checked")) {
                            //data.prioridade_Atendimento = 0;
                            lista_prioridade.push(0);
                        }

                        data.lista_PrioridadeAtendimento = lista_prioridade;

                        // SLA
                        data.dentro_Prazo = $("#iDentroPrazo").prop("checked") ? true : false;
                        data.atencao = $("#iAtencao").prop("checked") ? true : false;
                        data.vencimento_Proximo = $("#iVencimentoProximo").prop("checked") ? true : false;
                        data.risco_Perda_Prazo = $("#iRiscoPerdaPrazo").prop("checked") ? true : false;
                        data.prazo_Vencido = $("#iPrazoVencido").prop("checked") ? true : false;
                        data.id_Modelo_PainelAtendimento = $("#iModeloPainel").val()

                        // Período
                        data.tipo_Data = tipo_data;
                        data.data_Inicial = $("#iData_Inicial").val();
                        data.data_Final = $("#iData_Final").val();

                        data.motivo_Status = $("#ativarMotivo").prop("checked") ? $("#iMotivo_Status").val() : null;
                        data.num_Os = $("#iNum_Os").val();
