<script>

    var atendimentoSelecionado;

    function VerificarDepartamento() {

        const id_user = "@User.Identity.GetUserId()";

        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/AcessoApi/GetFilialUsuario?id_usuario=")' + id_user;

        $.ajax({
        url: link,
        type: 'POST',
        data: {
            id_Usuario: id_user
        },
        dataType: 'json',
        beforeSend: function () {
            ShowPageLoading();
        },
        complete: function () {
            HidePageLoading();
        }
        }).done(function (data) {
            if (data.id_Departamento == 0) {
                Notificar("@RsCadastros.ATENCAO", "Você não tem Setor/Departamento definido para criar o Atendimento.", "warning");
            } else {
                window.location = '@Url.Action("Cadastro", "Atendimento")';
            }
        });
    }


        var rows_selected = [];
        var oDatatable;
        let global_iTotal = 0;


        function findStoragedProperty(id) {
            const storageItem = window.localStorage.getItem("@Html.Raw(StorageName)")
            let filtros = storageItem ? JSON.parse(storageItem) : [];
            let filtro = filtros.filter(p => p.id == id);

            if (filtro.length > 0)
                return filtro[0].value;
            else
                return null;
        }

        $(document).ready(async function () {

            const storageItem = window.localStorage.getItem("@Html.Raw(StorageName)")
            let filtros = storageItem ? JSON.parse(storageItem) : [];
            for (const filtro of filtros) {
                if ($(`#${filtro.id}`).attr('type') == 'checkbox' || $(`#${filtro.id}`).attr('type') == 'radio') {
                    $(`#${filtro.id}`).prop('checked', filtro.checked)
                }
                else {
                    $(`#${filtro.id}`).val(filtro.value)
                }
            }

            $("input[type='radio'][name='periodo']").trigger('change');

            await AddSelectSemPag('iModeloPainel', '@CONSTANTES.URLPortal/api/Modelo_PainelAtendimentoApi/GetCombo', null, null, findStoragedProperty('iModeloPainel'), '@RsBase.SELECIONE', false, HandleModeloPainel, "@User.Identity.GetUserId()");
            AddSelect("iTipoAtendimento", "@CONSTANTES.URLPortal/api/Tipo_Atendimentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false,HandleTipoAtendimento);
