    function montarEnumeradorBuscaRapida() {
        var enumList = @Html.Raw(Json.Encode(Lista_PesquisaRapidaAtendimento));
        $('#iPesquisaRapida').empty();
        $.each(enumList, function (key, value) {
            $(`#iPesquisaRapida`).append($('<option>', {
                value: value.Value,
                text: value.Text,
                selected: value.id == 1 ? true : false
            }));
        });
    }

    async function mesclarAtendimento() {


        if (rows_selected.length == 0) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
            return;
        }

        if (rows_selected.length > 5) {
            Notificar("@RsBase.ATENCAO_", "Não é possivel mesclar mais de 5 atendimentos.", "info");
            return;
        }

        let confirmacao = await Swal.fire({
            title: 'Tem certeza que deseja Mesclar?',
            showCancelButton: true,
            cancelButtonText: 'Não',
            confirmButtonText: 'Sim',
            type: 'question',
            allowOutsideClick: () => !Swal.isLoading(),
        })

        if (!confirmacao.value)
            return false;


                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoApi/UnificarAtendimento")';

        $.ajax({
            url: link,
            type: 'POST',
            dataType: 'json',
            data: {
                ids: rows_selected
            }
        })
            .done(function (data) {

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    rows_selected = [];
                    oDatatable.draw();

                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });
        rows_selected = [];
        }

        var handleDataTableButtons = async function () {
            "use strict";

            if (oDatatable != null) {
                oDatatable.destroy();
                $("#datatable").empty();
            }

            function AlterarStatusObj(Status,Status_Motivo) {
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoApi/alterarstatus")';

                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: rows_selected,
                        status: Status,
                        motivo_status: Status_Motivo
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            rows_selected = [];
                            oDatatable.draw();

                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    });

