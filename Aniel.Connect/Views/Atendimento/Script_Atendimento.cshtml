@model  IList<Aniel.Connect.Models.Atendimento_Script_AtendimentoModel>


@{
    ViewBag.Title = RsCadastros.TIPO_ATENDIMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    Int32 i = -1;
}


@section scripts
{
    <script>

        function anterior(perguntaAtual) {
            $("#divPergunta_" + perguntaAtual).hide();
            $("#divPergunta_" + (perguntaAtual - 1)).show();
        }

        function proximo(perguntaAtual) {
            $("#divPergunta_" + perguntaAtual).hide();
            $("#divPergunta_" + (perguntaAtual + 1)).show();
        }


    function ScriptAtendimentoClick() {
        ShowPageLoading();
        window.location.href = '@Url.Action("Cadastro", "Atendimento")' + '?Id=' + '@Model.First().Id_Atendimento';
        return true;
    };



        $(document).ready(function () {

            $("#divPergunta_0").show();

            @if (ViewBag.Sucesso == "S")
            {
            <text>
            Notificar("@RsBase.INFORMACAO", "@RsCadastros.DADOS_GRAVADOS_SUCESSO", "info");
            </text>
            }
        });


/**/</script>
}


@using (Html.BeginForm("Script_Atendimento", "Atendimento", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
    @Html.AntiForgeryToken();

    <div style="padding:10px">
        <div class="card-body">
            <div class="card" style="border:none;">

                @*<nav aria-label="breadcrumb" style="font-size:12px" class="mb-3">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item" style="margin-top:-18px">
                                <a href="@Url.Action("Index", "Atendimento")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_ATENDIMENTO</a>
                            </li>
                            <li class="breadcrumb-item" style="margin-top:-18px">
                                <a href="#" style="color:#367fa9" onclick="ScriptAtendimentoClick(); return true;">@RsCadastros.ACOMPANHAMENTO_ATENDIMENTO</a>
                            </li>


                            <li class="breadcrumb-item" style="margin-top:-18px">
                                <span>Script de Atendimento</span>
                            </li>

                        </ol>
                    </nav>*@


                @for (int y = 0; y < Model.Count(); y++)
                {
                    i++;

                    <div id="divPergunta_@i" style="display:none;">

                        <div>
                            @Html.HiddenFor(p => Model[y].Id_Resposta_Pergunta)
                            @Html.HiddenFor(p => Model[y].Id_Atendimento)
                            @Html.HiddenFor(p => Model[y].Id_Tipo_Atendimento)
                            @Html.HiddenFor(p => Model[y].Id_Modelo_Pergunta)
                        </div>

                        <div class="mt-3 mb-3">
                            @if (!String.IsNullOrEmpty(Model[y].Pergunta))
                            {
                                <h4>
                                    <i class="far fa-question-circle"></i> @RsCadastros.PERGUNTA<br />
                                    <label for="iNome" class="ml-3" style="font-size: 14px;"> @(String.Format(@i + 1 + " - " + Model[y].Pergunta))</label>
                                </h4>
                            }
                        </div>

                        @if (String.IsNullOrEmpty(Model[y].Instrucao_Atendente) == false)
                        {

                            <div class="card div-card-accord mb-3">
                                <div class="card-header title-card" id="heading-1">
                                    <h5 class="mb-0">
                                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                            <span class="text-bold-card"><i class="fas fa-book-reader"></i> @RsCadastros.EXPLICACAO_OPERADOR</span>

                                        </a>
                                    </h5>
                                </div>

                                <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                    <div class="card-body body-card-accord">
                                        <div class="row mt-2 mb-2">
                                            <div class="col-sm-12">
                                                <span>@Html.Raw(Model[y].Instrucao_Atendente)</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (String.IsNullOrEmpty(Model[y].Instrucao_Cliente) == false)
                        {
                            <div class="card div-card-accord mb-3">
                                <div class="card-header title-card" id="heading-2">
                                    <h5 class="mb-0">
                                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-2" aria-expanded="true" aria-controls="collapse-2">
                                            <span class="text-bold-card"><i class="fas fa-bullhorn"></i> @RsCadastros.EXPLICACAO_CLIENTE</span>
                                        </a>
                                    </h5>
                                </div>

                                <div id="collapse-2" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                                    <div class="card-body body-card-accord">
                                        <div class="row mt-2 mb-2">
                                            <div class="col-sm-12">
                                                <span>@Html.Raw(Model[y].Instrucao_Cliente)</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }


                        <div class="card mb-3">
                            <div class="card">
                                <div class="card-header title-card" id="heading-3">
                                    <h5 class="mb-0">
                                        @*<a class="collapsed" role="button" data-toggle="collapse" href="#collapse-3" aria-expanded="true" aria-controls="collapse-3">*@
                                        <span class="text-bold-card"><i class="fas fa-headset"></i> @RsCadastros.RESPOSTA_CLIENTE</span>

                                    </h5>
                                </div>

                                <div id="collapse-3" class="collapse show" data-parent="#accordion" aria-labelledby="heading-3">
                                    <div class="card-body body-card-accord">
                                        <div class="mt-2 mb-2 ml-0 mr-0">

                                            @if (Model[y].Tipo_Resposta == Aniel.Connect.Model.enumerado.Script_Tipo_Resposta.Texto)
                                            {
                                                @Html.TextBoxFor(model => Model[y].Resposta, new { @class = "form-control " + (ViewBag.AtendimentoCanceladoConcluido ? "readonly" : ""), @id = "iResposta" })
                                            }
                                            else if (Model[y].Tipo_Resposta == Aniel.Connect.Model.enumerado.Script_Tipo_Resposta.Data)
                                            {
                                                @Html.TextBoxFor(model => Model[y].Resposta, new { @class = "form-control datepicker " + (ViewBag.AtendimentoCanceladoConcluido ? "readonly" : ""), @placeholder = "dd/mm/aaaa", @data_provide = "datepicker", @id = "iResposta" })
                                            }
                                            else if (Model[y].Tipo_Resposta == Aniel.Connect.Model.enumerado.Script_Tipo_Resposta.Valor)
                                            {
                                                @Html.TextBoxFor(model => Model[y].Resposta, new { @class = "form-control money " + (ViewBag.AtendimentoCanceladoConcluido ? "readonly" : ""), @placeholder="0,00", @id = "iResposta" })
                                            }
                                            else if (Model[y].Tipo_Resposta == Aniel.Connect.Model.enumerado.Script_Tipo_Resposta.Unica_Escolha)
                                            {


                                                Int32 w = -1;
                                                foreach (var respostaPossivel in Model[y].RespostasPossiveis)
                                                {
                                                    w++;

                                                    <div class="form-inline mt-1">
                                                        @Html.RadioButtonFor(model => Model[y].Resposta, respostaPossivel, new { @class = "form-control " + (ViewBag.AtendimentoCanceladoConcluido ? "readonly" : ""), @id = "idRadio_" + w })
                                                        <label for="idRadio_@w" class="pl-1 pr-1"> @respostaPossivel</label>
                                                    </div>
                                                }
                                            }
                                            else if (Model[y].Tipo_Resposta == Aniel.Connect.Model.enumerado.Script_Tipo_Resposta.Multipla_Escolha)
                                            {
                                                Int32 z = -1;
                                                foreach (var respostaPossivel in Model[y].RespostasPossiveis)
                                                {
                                                    z++;

                                                    <div class="form-inline mt-1">
                                                        @Html.CheckBoxFor(model => Model[y].RespostasMultiplas[z], new { @class = "form-control " + (ViewBag.AtendimentoCanceladoConcluido ? "readonly" : ""), @id = "iCheck_" + z })
                                                        <label for="iCheck_@z" class="pl-1 pr-1"> @respostaPossivel</label>
                                                        <br>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>



                        <div class="card mb-3">
                            <div class="card">
                                <div class="card-header title-card" id="heading-3">
                                    <h5 class="mb-0">
                                        <span class="text-bold-card"><i class="far fa-clipboard"></i> @RsCadastros.OBSERVACAO_ATENDIMENTO</span>
                                    </h5>
                                </div>

                                <div id="collapse-3" class="collapse show" data-parent="#accordion" aria-labelledby="heading-3">
                                    <div class="card-body body-card-accord">
                                        <div class="mt-2 mb-2 ml-0 mr-0">
                                            @Html.TextAreaFor(model => model[y].Observacao_Atendimento, new { @rows = "4", @class = "form-control " + (ViewBag.AtendimentoCanceladoConcluido ? "readonly" : ""), @id = "iExplicacao_Cliente", @autocomplete = "off" })

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>



                        <div class="row mt-5 mb-5">
                            <div class="col-sm-2">
                                @if (i != 0)
                                {
                                    <button type="button" class="btn btn-outline-dark" onclick="anterior(@i)"><i class="fas fa-arrow-left"></i> Anterior</button>
                                }
                            </div>

                            <div class="col-sm-2">
                                @if (Model.Count() != (i + 1))
                                {
                                    <button type="button" id="iBtnProximo" class="btn btn-outline-dark" onclick="proximo(@i)"><i class="fas fa-arrow-right"></i> Próximo</button>
                                }
                            </div>


                            @if (ViewBag.AtendimentoCanceladoConcluido == false)
                            {

                                <div class="col text-right">
                                    <button type="submit" class="btn btn-outline-dark"><i class="fas fa-paper-plane"></i> Salvar e Finalizar Script</button>
                                </div>
                            }

                        </div>
                    </div>

                }

            </div>
        </div>
    </div>
}
