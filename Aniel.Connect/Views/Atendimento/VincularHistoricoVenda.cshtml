    {
        <link href="~/Content/timeline.css" rel="stylesheet" />
    }*@



@Html.HiddenFor(model => model.Id_Cliente, new { @id = "iIdClienteHisFat" })


<div style="padding:10px;">
    <div class="card" style="box-shadow: 0 8px 17px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.1); border:none;">
        <div class="card-body" style="padding-top: 0">
            <!--main-->
            <!--Filtros-->

            <div class="card-header title-card" id="heading_1">
                <h5 class="mb-1">
                    <a role="button" data-toggle="collapse" data-target="#collapse_5" aria-expanded="true" aria-controls="collapse_5">
                        <span class="text-bold-card">@RsCadastros.HISTORICO_ATENDIMENTO</span>
                    </a>
                </h5>
            </div>
            <div id="collapse_5" class="collapse show" aria-labelledby="heading_5" data-parent="#heading_5">

                <div class="row mt-3">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="" for="iNome">@RsCadastros.PERIODO:</label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-4 col-md-2">
                        <div class="form-group" style="margin-bottom:0px !important">
                            <label for="iAssunto" class="mr-3">@RsCadastros.DE:</label>
                        </div>
                        <input type="text" class="form-control datepicker" value="@DateTime.Today.AddDays(-90).Date.ToString("dd/MM/yyyy")" data_provide="datepicker" id="iDtInicialFiltro">

                    </div>

                    <div class="col-sm-4 col-md-2">
                        <div class="form-group" style="margin-bottom:0px !important">
                            <label for="iAssunto" class="mr-3">@RsCadastros.PARA:</label>
                        </div>
                        <input type="text" class="form-control datepicker" value="@DateTime.Today.Date.ToString("dd/MM/yyyy")" data_provide="datepicker" id="iDtFinalFiltro">

                    </div>

                    <div class="col-sm-3">
                        <div class="form-group">
                            <label for="iAssunto" class="mr-3">@RsCadastros.STATUS_VENDA:</label>
                        </div>

                        @Html.EnumDropDownListFor(m => m.Status_Venda, RsBase.SELECIONE, new { @class = "form-control", @id = "iStatusAtendimento", @autocomplete = "off" })
                        @Html.ValidationMessageFor(model => model.Status_Venda, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-sm-3">
                        <div class="form-group">
                            <label for="iAssunto" class="mr-3">@RsCadastros.TERMO_ADESAO?</label>
                        </div>

                        @Html.EnumDropDownListFor(m => m.Termo_Adessao, RsBase.SELECIONE, new { @class = "form-control", @id = "iStatusAtendimento", @autocomplete = "off" })
                        @Html.ValidationMessageFor(model => model.Termo_Adessao, "", new { @class = "text-danger" })
                    </div>


               

                    <div class="col-sm-4 col-md-2 text-right mt-3 pb-2 pr-5">
                        <input type="button" class="btn btn-outline-secondary" style="font-size:0.8rem" value="Carregar" id="btnFiltro" onclick="return FiltrarDataTable()" />
                    </div>

                </div>

                <!--.Filtros-->

                <table class="table table-hover nowrap" id="datatable" style="width:100%">
                    <thead class="tb-head">

                    </thead>
                </table>


            </div>
        </div>
    </div>
</div>