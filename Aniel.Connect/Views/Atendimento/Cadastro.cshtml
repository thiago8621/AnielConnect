    async function aplicarRespostasCampos(aplicarResposta) {

        let atendimentoId = '@Model.Id';

        if (aplicarResposta) {

            var response = await $.ajax({
                url: baseUrl + `/api/AtendimentoCamposApi/ObterVinculoRespostas?IdAtendimento=${atendimentoId}`,
                method: 'POST',
                dataType: 'json'
            });

            if (response.ok) {
                let arrayObjetos = response.idObjeto;

                console.log("array respostas");
                console.log(arrayObjetos);

                for (let campo of arrayObjetos) {

                    $(`#camp-${campo.idCampo}`).val(campo.resposta);
                    $(`#camp-${campo.idCampo}`).text(campo.resposta);
                    $(`#camp-${campo.idCampo}`).prop("readonly", true);
                    for (let resp of campo.listaRespostas) {
                        $(`#resp-${resp.idResposta}`).prop('checked', true).trigger('change');
                        $(`#resp-${resp.idResposta}`).prop("readonly", true);
                    }
                }
            }
        }
    }


