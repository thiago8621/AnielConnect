    function inserirAtividade(item, i) {
        console.log(item);

        if (item.usuario != null) {
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/IdentityUserapi/FindById?Id=")' + item.usuario;

            $.ajax({
                url: link,
                type: 'GET',
                //contentType: false,
                //processData: false,
                /* data: item.responsavel*/

            }).done(function (data) {
                nome_responsavel_historico = data.objeto.desc_User;
                //etapa_atual = data.etapa_atual;
                historico_atividade();
            })
        } else {
            //nome_responsavel_historico = "@User.Identity.GetUserName()";
                //etapa_atual = data.etapa_atual;
                historico_atividade();
        }

        function historico_atividade() {
            //${ item.mensagens_Chat ? '<h4 class="fs-14">Descrição de atendimento por Chat</h4>' : '<h4 class="fs-14">Atividade</h4>' }
            const id = "@Model.Id";

            var [conteudo, mensagens] = [item.html ?? `<p style="white-space: pre-wrap;">${item.descricaoAcao}</p>`, ""];
            let [corTipoAtividade, TipoAtividade] = ["#80808057", ""];
            if (item.tipoAtividade == "1") {
                corTipoAtividade = "#0041f97a";
                TipoAtividade = "@RsCadastros.PUBLICO";
            }
            else if (item.tipoAtividade == "0") {
                corTipoAtividade = "#f900007a";
                TipoAtividade = "@RsCadastros.INTERNO";
            }


            var iResponsavel = nome_responsavel_historico == "" ? item.responsavel : item.responsavel + " - " + nome_responsavel_historico;
            var editarExcluir = `<br/><a class="removerAtividade text-danger" href="#" atividade=${i}><i class="fas fa-trash-alt m-2" style="float:right"></i></a><a href="#iAssuntoAtendimento" class="editarAtividade m-2" atividade=${i}><i class="fas fa-pen m-2" style="float:right"></i></a>`;

                var arquivos = item.arquivos.length > 0 ?
                `<a href="#" id="arquivos${i}" data-arquivos='${JSON.stringify(item.arquivos)}' data-toggle="tooltip" data-placement="bottom" title="@RsCadastros.ARQUIVO" class="text-dark pr-2 arquivos"><label class="btn btn-outline-dark mt-1"><i class="fas fa-folder-open"></i> <span class="fs-12"> clique para visualizar lista de arquivos </span></label></a>` :
                    `<a href="#" id="arquivos${i}" data-arquivos='${JSON.stringify(item.arquivos)}' data-toggle="tooltip" data-placement="bottom" title="@RsCadastros.ARQUIVO" class="text-dark pr-2 arquivos"></a>`

                for (var mensagem of item.mensagenschat) {

                    let divArquivo = "";

                    if (mensagem.arquivos.length > 0) {
                        for (var arquivosMensagem of mensagem.arquivos) {
                            divArquivo += (`<div id="${arquivosMensagem.id}" style="margin-top: 5px;"><a class="tag  mr-1 ml-1 text-truncate" href="${arquivosMensagem.url} "target="_blank"><i class="fas fa-paperclip"></i> ${arquivosMensagem.name}</a></div>`);
                        }
                    }

                    if (mensagem.fluxoChat == false) {

                        mensagens += `<div class="row justify-content-${mensagem.enviadoPeloSuporte ? "end" : "start"}">
                                                                            <div class="mb-1 mt-1" style="width:50%">
                                                                                <div class="card-body ${mensagem.enviadoPeloSuporte ? "text-left" : "text-right"}>
                                                                                    <span class="font-italic" style="color: #357ca5">  ${mensagem.usuario == null ? 'Não identificado' : mensagem.usuario}</span>
                                                                                    <span class="text-muted" style="font-size:10px">  &nbsp;${mensagem.dataHora}</span>

                                                                                    <p>${mensagem.mensagem == null ? '' : mensagem.mensagem} </p>
                                                                                    <p>${divArquivo}</p>
                                                                                </div>
                                                                            </div>
                                                                        </div>`;
                    }
                    else {
                        mensagens += `<div class="mb-1 mt-1" style="width:50%">
                                        <div class="${mensagem.enviadoPeloSuporte ? "text-left" : "text-right"}">
                                            <p>${mensagem.dataHora} ${mensagem.mensagem == null ? '' : mensagem.mensagem}</p>
                                            <p>${divArquivo} </p>
                                        </div>
                                      </div>`;
                    }
                }

            $("#iDivHistoricoAtividade").prepend(`<div class="card shadow rounded classeAdicionados mb-2" id="atividadeAdicionada${i}">
                                                            <div class="form-inline" style="background-color: ${corTipoAtividade.replace('7a', '3a')};padding-top: 15px;border-bottom: 1px solid ${corTipoAtividade};">
                                                            <div style= "width: 100%;">
                                                            <div class="col-9" >
                                                                    <p class="" style="margin-bottom: 0;"><strong><span class="text-muted text-captalize">${iResponsavel}</span></strong></p>
                                                                    <p class="" style="margin-bottom: 0;"><span class="text-muted">Origem: ${item.origem}, ${item.dataCriacao}</span></p>
                                                                    <p class=""><span class="text-muted">${TipoAtividade}</span></p>

                                                                </div>
                                                                <div class="col-12">
                                                                    <span style="float:right" class="ordemAtividade mr-2"><b>${$('.classeAdicionados').length + 1}</b></span>
                                                                    ${id == "0" ? editarExcluir : ""}
                                                                </div>
                                                                </div>
                                                            </div>
                                                        <div class="card-body">
                                                            <div class="content-right-container">
                                                                <div class="content-right">
                                                                    <div class="mr-0 mt-3">
                                                                        <div class="container mb-3" id="atividadeConteudo${i}" style="overflow-y: auto;max-height: 300px;">${item.mensagens_Chat ? mensagens : conteudo}</div>
                                                                    </div>

                                                                    ${arquivos}

                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>`);




                @if (Model.Id == 0) {
                    <text>
            var [quantidadeAdicionar, quantidadeAdicionarPlano] = [$(".atividadeAdicionar").length, $(".atividadeAdicionarPlano").length];
                $("#iDivHistoricoAtividade").append(`<input type="hidden" id="atividadeAdicionarDescricaoAcao${i}" class="atividadeAdicionar atividadeAdicionar${i}" name="historico_Atendimento[${quantidadeAdicionar}].descricaoAcao" value='${encodeURIComponent(conteudo)}'>`);
                $("#iDivHistoricoAtividade").append(`<input type="hidden"  class="atividadeAdicionar${i}" name="historico_Atendimento[${quantidadeAdicionar}].usuario" value='@User.Identity.GetUserId()'>`);
                $("#iDivHistoricoAtividade").append(`<input type="hidden"  class="atividadeAdicionar${i}" name="historico_Atendimento[${quantidadeAdicionar}].tipoAtividade" value='${item.tipoAtividade}'>`);

                    for (var i = 0; i < item.arquivos.length; i++) {
                        $("#iDivHistoricoAtividade").append(`<input type="hidden" class="atividadeAdicionar${i}" name="historico_Atendimento[${quantidadeAdicionar}].arquivos[${i}].nome_Arquivo" value='${item.arquivos[i].nome_Arquivo}'>`);
                        $("#iDivHistoricoAtividade").append(`<input type="hidden" class="atividadeAdicionar${i}" name="historico_Atendimento[${quantidadeAdicionar}].arquivos[${i}].extensao" value='${item.arquivos[i].extensao}'>`);

                    }

                    </text>
                }
            }
    }

    var Tipo_AtendimentoSelecionado = null;
    var HandleTipo_Atendimento = async function () {
        $('#iTipoAtendimento').unbind('select2:select select2:unselecting');
        $('#iTipoAtendimento').on('select2:select select2:unselecting', async function (e) {

            Tipo_AtendimentoSelecionado = e.params.data;
            if (Tipo_AtendimentoSelecionado != undefined && Tipo_AtendimentoSelecionado.id != "@Model.Id_Tipo_Atendimento") {
