        function create_UUID() {
            var dt = new Date().getTime();
            var uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                var r = (dt + Math.random() * 16) % 16 | 0;
                dt = Math.floor(dt / 16);
                return (c == 'x' ? r : (r & 0x3 | 0x8)).toString(16);
            });
            return uuid;
        }

        function renderMessage(message, datetime, usuario, fromClient, fluxoChat = false, arquivos,protocolo = "") {

            if (!datetime)
                datetime = moment().format("HH:mm")

            if (arquivos == undefined) {
                arquivos = [];
            }

            if (fluxoChat == false) {

                let IdArquivo = create_UUID();

                //let divArquivo = `<div id="${IdArquivo}"><a href="#" target="_blank">Visit W3Schools</a></div>`
                let divArquivo = "";
                var vazio = "";

                if (arquivos.length > 0) {
                    for (var arquivosMensagem of arquivos) {
                        let IdArquivo = create_UUID();

                        divArquivo += (`<div id="${IdArquivo}" style="margin-top: 5px;"><a class="tag  mr-1 ml-1 text-truncate" href="${arquivosMensagem.url} " target="_blank"><i class="fas fa-paperclip"></i> ${arquivosMensagem.name}</a></div>`);
                    }
                }

                $('#messages', $('#chatFrame').contents()).html($('#messages', $('#chatFrame').contents()).html() +

                    `<div class="row justify-content-${fromClient == true ? "end" : "start"}">
            <div class="card mb-3 mt-3" style="width:50%; border-radius: 1rem;">
                <div style="border-radius: 1rem;" class="card-body ${fromClient == true ? " alert-secondary text-left" : "alert-info text-left"} ">
                    <div class="row" style="font-size: 14px;">
                        <div class="col text-capitalize text-truncate">
                            ${fromClient == true ? `<i class='icofont-ui-head-phone'></i><strong style='text-transform: capitalize !important;'> ${usuario}</strong>` : `<i class='icofont-ui-user'></i><strong> ${usuario}</strong>`}
                        </div>
                        <div class="col text-right">
                            <span class="ml-5">${datetime}</span>
                        </div>
                    </div>
                    <hr style="margin-top: 5px;margin-bottom: 5px; background-color: #000;">
                    <div class="row" style="font-size: 14px;">
                        <div class="col" style="white-space:pre-line">
                            ${message == null ? '' : message}
                        </div>
                    </div>
                </div>
                ${divArquivo}
            </div>
            `);



                //if (window.frames['chatFrame'].contentWindow)
                //    window.frames['chatFrame'].contentWindow.messageArquivos(IdArquivo, arquivos)
            }
            else {
                $('#messages', $('#chatFrame').contents()).html($('#messages', $('#chatFrame').contents()).html() +

                    `<div class="row justify-content-${fromClient == true ? "end" : "start"}">
                <div class=" mb-3 mt-3" style="width:50%;">
