        async function SwalVincularOs() {
            const iframe = document.getElementById('iVincularOsFrame1');
            if (!iframe) return;

            const iframeContent = iframe.contentDocument || iframe.contentWindow?.document;
            if (!iframeContent) return;

            const tabela = iframeContent.getElementById('datatable');
            if (!tabela) return;

            const rows = tabela.getElementsByTagName('tr');

            let temSelecionado = false;

            for (let i = 0; i < rows.length; i++) {
                const [row, checkbox] = [rows[i], row.querySelector('input[type="checkbox"]')];
                if (checkbox && checkbox.checked) {
                    temSelecionado = true;
                    break;
                }
            }

            if (!temSelecionado) {
                Swal.fire("Atenção", "Por favor, selecione ao menos uma OS para vincular.", "warning");
                return;
            }

        Swal.fire({
            title: "Deseja Vincular o Atendimento à Ordem de Serviço?",
            text: "Não será possível retornar essa ação!",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Sim',
            cancelButtonText: 'Não'
        }).then((result) => {
            if (result.value) {
                var iframe = document.getElementById('iVincularOsFrame1');
                if (iframe) {
                    var [iframeContent, tabela] = [iframe.contentDocument || iframe.contentWindow.document, iframeContent.getElementById('datatable')];
                    if (tabela) {
                        var rows = tabela.getElementsByTagName('tr');

                        for (var i = 0; i < rows.length; i++) {
                            var [row, checkbox] = [rows[i], row.querySelector('input[type="checkbox"]')];
                            if (checkbox && checkbox.checked) {
                                 /*---/////---/////---/////
                                    1.Usa a instância do DataTable dentro do iframe
                                    2.datatable precisa estar acessível no global
                                                            ---/////---/////*/
                                var [iframeWindow, datatable] = [iframe.contentWindow, iframeWindow.oDatatable];
                                if (!datatable) {
                                    console.error("DataTable não encontrado no iframe.");
                                    return;
                                }

                                var rowData = datatable.row(row).data();
                                if (!rowData) continue;

                                var [codCt, projeto, num_Os, num_Doc] = [rowData.codCt, rowData.projeto, rowData.num_Os, rowData.num_Doc];
                                console.log({ codCt, projeto, num_Os, num_Doc });

                                VincularAtendimento(codCt, projeto, num_Os, num_Doc);
                            }
                        }
                    }
                }
            }
        });
    }


    async function VincularAtendimento(codCt, projeto, num_Os, num_Doc) {
      $('#modal-vincular').modal('hide');

       $("#divProgress").show();

       var link = '@String.Concat(CONSTANTES.URLPortal, "/api/AtendimentoApi/VincularOs")';
       var requestData = {
          codCt: codCt,
          projeto: projeto,
          usuario: "@User.Identity.GetUserId()",
          Num_OS: num_Os,
          Num_Doc: num_Doc,
          idAtendimento: "@Model.Numero"

       };

       await $.ajax({
           url: link,
           type: 'POST',
           dataType: 'json',
           data: requestData
       }).done(function (data) {
           if (data.ok) {
              ShowPageLoading();
              Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
              rows_selected = [];
               //oDatatable.draw();

           }
           else {
               Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
           }
       });
    $("#divProgress").hide();
    HidePageLoading();
}

