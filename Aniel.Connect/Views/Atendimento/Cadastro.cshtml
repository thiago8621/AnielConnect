    function AlterarStatusObj(Status, IdClientePlanoProduto, idMotivo_cancelamento = null) {

        $("#divProgress").show();
        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/PlanoProdutoapi/AlterarStatus")';
        var requestData = {
            Id: '@Model.Id',
            usuario: '@User.Identity.Name'
        }

        $.ajax({
            url: link,
            type: 'POST',
            dataType: 'json',
            data: {
                ids: [IdClientePlanoProduto],
                status: Status,
                id_motivo_cancelamento: idMotivo_cancelamento,
                observacao_motivo_suspensao: $("#iMotivo_Observacao_Suspensao_Plano_Outros").val()
            }
        })
            .done(function (data) {

                if (data.ok) {

                    //Quando login Radius não pôde ser bloqueado/desbloqueado.
                    if (data.mensagem != undefined && data.mensagem != null)
                        Notificar("@RsBase.INFORMACAO", data.mensagem, "warning");
                    else
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");

                    $("#divProgress").show();
                    location.href = "@Html.Raw(Url.Action("Cadastro", "Atendimento", new { Id = Model.Id }))"
                    window.location.reload(true);
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            }).always(function () {

                $("#divProgress").hide();

            });
    }

        function TestarLogin(idPlanoProduto) {

            if (idPlanoProduto == 0 || idPlanoProduto == undefined)
                idPlanoProduto = "@Model.Id_Cliente_Plano_Produto";

            ShowPageLoading();

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/IntegracaoRadiusApiController/TesteLogin")';

            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    idClientePlanoProduto: idPlanoProduto
                }
            })
            .done(function (data) {

                if (data.result) {

                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                }
                else {

                    if(data.message)
                        Notificar("@RsBase.ATENCAO_", data.message, "warning");
