        }).done(async function (response) {
            if (!response.ok) {
                consulta = false;
                Swal.fire({
                    text: `${response.mensagem}`,
                    type: 'warning',
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'OK',
