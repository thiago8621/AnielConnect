                idClienteDestino: rows_selected[0],
                idClienteUnificar: "@Model.Id_Cliente",
                _IdContatos: rowsSelectedContato,
            },
            beforeSend: function () {
                $("#divProgress").show();
            },
            /*complete: function () {
                $("#divProgress").hide();
            },*/
            fail: function (e) {
                $("#divProgress").hide();
            }
        }).done(function (data) {
            if (data.ok) {
                //window.location = "@Url.Action("Listagem_Atendimento", "Atendimento")";
                window.location.reload(true);
                $("#divProgress").hide();
