    async function VerificaFluxoEncerramento(idAtendimento, proximaEtapa) {
        let consulta;

        await $.ajax({
            url: baseUrl + `/api/atendimentoapi/VerificaFluxoEncerramento?Id_Atendimento=${idAtendimento}&Id_ProximaEtapa=${proximaEtapa}`,
            method: 'POST',
