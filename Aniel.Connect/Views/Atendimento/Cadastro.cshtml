    async function MudancaPlano() {
        if ("@((int?)Model.Status_PlanoProduto)" != 2) {
            Notificar("@RsBase.ATENCAO_", "Para efetuar a mudança de plano, é necessário, que o CONTRATO, PLANO/PRODUTO, esteja, HABILITADO!!", "warning");
            return false;
        }

        let url = "@CONSTANTES.URLPortal/api/Vendaapi/FindVendaById_Cpp?Id_cpp=" + "@Model.Id_Cliente_Plano_Produto";
        let venda = null;

        try {
              @*Ajax para obter venda*@

            await $.ajax({
                type: "GET",
                url: url,
                dataType: "json",
                success: (retorno) => { venda = retorno.objeto },
                error: (retorno) => { throw retorno.mensagem; },
            });



        @*Url de mudanca com parâmetro da venda agora*@
        let urlMudanca = "@Url.Action("ClienteDadosGerais", "Venda", new { @*Id_Venda="__venda__",*@ Id_Cliente = "__cliente__"@*, IdAtendimento = "__atendimento__"*@})";
        urlMudanca = urlMudanca.replace("__cliente__","@Model.Id_Cliente");

        AddAba(urlMudanca, "@RsCadastros.MUDANCA_CONTRATO_SEM_ACENTO");

        }
        catch (error) {
