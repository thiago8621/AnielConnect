                $("#divProgress").hide();
            }
        });
    });

    $('#iUnificar').click(async function () {
        if (rows_selected.length == 0) {
            Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "warning");
            return;
        }

        if (rows_selected.length > 1) {
            Notificar("@RsBase.ATENCAO_", "Apenas um registro pode ser selecionado", "warning");
            return;
        }

        let title = 'Deseja Unificar o Cliente selecionado?';

        if (oDatatableUnificar.data()[0].status == "@RsCadastros.INATIVO")
            title = 'Cliente selecionado está com status Inativo. Tem certeza que deseja unificar ?';

        let { ok, objeto: contatoDuplicado } = await $.ajax({
            url: '@String.Concat(CONSTANTES.URLPortal, "/api/clienteapi/VerificarContato")',
            type: "POST",
            dataType: "json",
            data: {
                Objeto: { Id: oDatatableUnificar.data()[0].id }
            },
        });

        if (ok && contatoDuplicado) {
            $('#modal-unificarCliente').modal('hide');
            $("#iModal_SelecaoContato").modal("show");
            await CarregaContatos(oDatatableUnificar.data()[0].id);
            return;
        }
        else {
        let confirmar = await Swal.fire({
            title: title,
            text: 'Não será possível desfazer essa ação!',
            showCancelButton: true,
            cancelButtonText: 'Não',
            confirmButtonText: 'Sim',
            type: 'question',
            allowOutsideClick: () => false,
        });

        if (confirmar.value) {
            $('#modal-unificarCliente').modal('hide');
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/clienteapi/UnificarCliente")';
            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    usuario: "@User.Identity.GetUserId()",
                    idClienteDestino: rows_selected[0],
                    idClienteUnificar: "@Model.Id_Cliente"
                },
                beforeSend: function () {
                    $("#divProgress").show();
                },
                /*complete: function () {
                    $("#divProgress").hide();
                },*/
                fail: function (e) {
                    $("#divProgress").hide();
                }
                }).done(function (data) {
                    if (data.ok) {
                        //window.location = "@Url.Action("Listagem_Atendimento", "Atendimento")";
                        window.location.reload(true);
                        $("#divProgress").hide();
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        $("#divProgress").hide();
                    }
                });
        }
        }
    });

