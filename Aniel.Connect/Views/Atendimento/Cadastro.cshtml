            //<!--ENVIA AS MENSAGENS DO CHAT-->
    async function sendMessage() {

        var haTexto = $('#inlineFormInputGroupUsername2').val().trim() !== "";
        var haAnexo = $('#idMensagemModelo').val() ? false : $('#iArquivoChat').get(0).files.length > 0;

        if (!haTexto && !haAnexo) {
            Notificar("@RsBase.ATENCAO_", "Não é possível enviar mensagens em branco.", "warning");
        } else {

            // const datetime = moment().format("DD/MM/YYYY HH:mm")
            const datetime = moment().format("HH:mm");
            const message = {
                id: create_UUID(),
                mensagem: $('#inlineFormInputGroupUsername2').val(),
                dataHora: datetime,
                enviadoPeloSuporte: true,
                statusEnvio: 1,
                usuario: "@User.Identity.GetUserName()",
                matriculaUsuario: "@User.Identity.GetUserId()",
                arquivos: [],
                idConexao: parent.chat.connection.id,
                idModeloMensagem: $('#idMensagemModelo').val()
            };

            if (!$('#idMensagemModelo').val()) {
                let obj = $('#iArquivoChat')[0];

                if (obj.files.length > 0) {

                    let fileid = create_UUID();
                    var data = new FormData();
                    data.append("UploadedImage", obj.files[0]);
                    data.append("id", fileid);
                    var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Atendimentoapi/AdicionarArquivoMensagemChat")';

                    //valida o tipo
                    var nomeFiles = obj.files[0].name;
                    var tipo = 0;
                    var extensoesPermitidasImagem = /(.jpeg|.jpg|.gif|.png|.bmp|.tiff)$/i;
                    var extensoesPermitidasVideo = /(.mpeg|.mp4|.quicktime|.webm|.3gpp|.3gpp2|.3gpp-tt|.H261|.H263-1998|.H263-2000|.mp4|.H264)$/i;
                    var extensoesPermitidasAudio = /(.L24|.mp3|.mpeg|.ogg|.vnd.rn-realaudio|.vnd.wave|.3gpp|.3gpp2|.ac3|.webm|.amr-nb|.amr|.snd|.au|.aac|.opus)$/i;
                    var extensoesPermitidasArquivo = /(.vcard|.pdf|.directory|.calendar|.richtext|.rtf|.x-vcard|.doc|.docx|.xls|.xlsx)$/i;

                    if (extensoesPermitidasImagem.exec(nomeFiles)) {
                        tipo = 0;
                    } else if (extensoesPermitidasVideo.exec(nomeFiles)) {
                        tipo = 1;
                    } else if (extensoesPermitidasAudio.exec(nomeFiles)) {
                        tipo = 2;
                    } else if (extensoesPermitidasArquivo.exec(nomeFiles)) {
                        tipo = 3;
                    }

                    message.arquivos.push({
                        name: removerAcentos(obj.files[0].name),
                        id: fileid,
                        url: "@CONSTANTES.URLPortal" + "/Arquivos/Atendimento/Chat/" + removerAcentos(obj.files[0].name),
                        tipo: tipo
                    });

                    let resultUploadArquivo = await $.ajax({
                        url: link,
                        type: 'POST',
                        contentType: false,
                        processData: false,
                        data: data,
                        beforeSend: function () {
                            $("#divProgressUploadArquivo").show();
                        },
                        complete: function () {
                            $("#divProgressUploadArquivo").hide();
                        }
                    });

                    if (!resultUploadArquivo.ok) {
                        Notificar("@RsBase.ATENCAO_", resultUploadArquivo.mensagem, "warning");
                        return false;
                    }
                }
            }

            let sucesso = await parent.chat.server.enviarMensagem('@Model.Numero', JSON.stringify(message))

            if (sucesso.result) {
                    var btn_concluir = document.getElementById("btnConcluirChat");
                    if (btn_concluir != null) {
                        $("#btnConcluirChat").removeClass("readonly");
                        btn_concluir.addEventListener("click", function (event) {
                            finalizarAtendimento();
                        });
                    }

                    var btn_convidar = document.getElementById("btnConvidarAtendente");
                    if (btn_convidar != null) {
                        $("#btnConvidarAtendente").removeClass("readonly");
                        btn_convidar.addEventListener("click", function (event) {
                            ConvidarAtendenteChat();
                        });
                    }

                renderMessage(message.mensagem, message.dataHora, message.usuario, true, false, message.arquivos, '@Model.Numero');
                }
            else {
                if (sucesso.message == "{ERROR_NOT_USER}") {
                    notifica_bloqueio_chat()
                }
                else
                {
                    Notificar("@RsBase.ATENCAO_", sucesso.message, "warning");
                }
            }

            $('#inlineFormInputGroupUsername2').val("")
            $('#idMensagemModelo').val("");
            $('#idMensagemModelo').attr("data-texto", "");
            animateMessageScroll();

            //limpa os anexos
            limparAnexo();
        }
    }

