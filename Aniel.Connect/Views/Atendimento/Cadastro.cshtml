                if (Tipo_AtendimentoSelecionado != undefined  && Tipo_AtendimentoSelecionado.script) {

                var link = '@Html.Raw(String.Concat(CONSTANTES.URLPortal, "/api/AtendimentoApi/GetScriptAtendimentoAtivo?idScript="))' + Tipo_AtendimentoSelecionado.script;
                const data = await $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',

                });
                if (data.ok) {
                    Swal.fire({
                        title: 'Esse Tipo de Atendimento tem um Script de Atendimento Vinculado, Deseja Preencher agora?',
                        showCancelButton: true,
                        cancelButtonText: 'Não',
                        confirmButtonText: 'Sim',
                        type: 'question',
                        allowOutsideClick: () => !Swal.isLoading(),
                    }).then(result => {
                        if (result.value) {
                            getScriptAtendimento(Tipo_AtendimentoSelecionado.id);
                            $(`#iNavScript`).show();
                            $('#scriptAtendimento-tab').tab('show');
                        }
                        else {
                            $(`#iNavScript`).fadeOut(150, () => { $(`#iNavScript`).hide(); });
                        }

                    });
                }
                else {
                    $(`#iNavScript`).fadeOut(150, () => { $(`#iNavScript`).hide(); });
                }
            } else {
                $(`#iNavScript`).fadeOut(150, () => { $(`#iNavScript`).hide(); });
            }
            </text>
            }

            if (Tipo_AtendimentoSelecionado != undefined && Tipo_AtendimentoSelecionado.criar_Os_Encerrar != '') {
                if(Tipo_AtendimentoSelecionado.criar_Os_Encerrar == "1")
                    criar_Os_Encerrar = true;
                else
                    criar_Os_Encerrar = false;
            }

            var iStatusAtendimento = $("#iStatusAtendimento option:selected").val();
            if (iStatusAtendimento == 4 || iStatusAtendimento == 3) {
                DisableSelect("iTipoAtendimento");
            }
        });
