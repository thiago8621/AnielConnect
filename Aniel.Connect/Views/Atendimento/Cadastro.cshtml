    $('#btnInserirAtividade').click(async function () {
        if ($(`#iResponsavel`).val() != "@User.Identity.GetUserId()" && !(@Json.Encode(AcessoHelper.TemAcesso(_areas, "204")))) {
            Notificar("@RsBase.ATENCAO_", "Usuário não possui acesso para editar todos atendimentos ou não é responsável pelo mesmo!", "warning");
            return true;

        } else {

           if ($('#mytextarea').trumbowyg('html') === '') {
                Notificar("@RsBase.ATENCAO_", "Descreva o assunto", "warning");
                return true;
            }

            @if (Model.Id != 0)
            {
            <text>
            var data = new FormData();
            let arquivos = [];
            for (let obj of $(`input[type="file"][atividade=${id_atividades_add + 1}]`)) {
                var file = obj.files;
                for (i = 0; i < file.length; i++) {
                    arquivos.push(file[i]);
                }
            }

            for (i = 0; i < arquivos.length; i++) {
                    //Appending each file to FormData object
                data.append(arquivos[i].name, arquivos[i]);
                let arrayfile = arquivos[i].name.split('.');
                const [extension, filename] = ['.' + arrayfile.pop(), arrayfile.join('.')];
                    data.append(`Arquivos[${i}].id`, 0);
                    data.append(`Arquivos[${i}].arquivo`, filename);
                    data.append(`Arquivos[${i}].nome_Arquivo`, filename);
                    data.append(`Arquivos[${i}].extensao`, extension);
                }

            data.append('Id', 0);
            data.append('IdAtendimento', "@Model.Id");
            data.append('DescricaoAcao', encodeURIComponent($('#mytextarea').trumbowyg('html')));
            data.append('Numero', "@Model.Numero");
            data.append('Usuario', "@User.Identity.GetUserId()");
            data.append('TipoAtividade', $('input[name=TipoAtividade]:checked').val());


            await $.ajax({
                url: '@Url.Action("GravarAcao", "Atendimento")',
                type: 'POST',
                processData: false,
                contentType: false,
                data: data,
                beforeSend: function () {
                    ShowPageLoading();
                },
                complete: function () {

                },
                fail: function (e) {
                    HidePageLoading();
                }

            }).done(async function (data) {

                let retorno = JSON.parse(data);

                if (retorno.Ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    await atualizarHistoricoAtividades();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.Mensagem, "warning");
                }

                HidePageLoading();

            });

            $(`input[type="file"][atividade=${id_atividades_add + 1}]`).each(function (i, obj) {
                obj.value = null;
            });

            </text>
            }

            else {
         <text>

            if ($(this).attr("editar")) {

                let atividadeEditar = $(this).attr("editar");
                $(`#atividadeAdicionarDescricaoAcao${atividadeEditar}`).val(encodeURIComponent($(`#mytextarea`).trumbowyg('html')));
                $(`#atividadeAdicionarPlanoDescricaoAcao${atividadeEditar}`).val(encodeURIComponent($(`#mytextarea`).trumbowyg('html')));
                $(`#atividadeConteudo${atividadeEditar}`).html($(`#mytextarea`).trumbowyg('html'));
                $('#mytextarea').trumbowyg('empty');
                filter_state = {};
                TagFilter("tagFiles", filter_state);
                $('#TagLabel').hide();
                $('#btnInserirAtividade').val("@RsCadastros.INSERIR_ATIVIDADE");
                $('#btnInserirAtividade').removeAttr('editar');

                let arquivos = [];
                for (let obj of $(`input[type="file"][atividade="${atividadeEditar}"]`)) {
                    var file = obj.files;
                    for (i = 0; i < file.length; i++) {

                        let arrayfile = file[i].name.split('.');
                        const extension = '.' + arrayfile.pop();
                        const filename = arrayfile.join('.');

                        arquivos.push({ nome_Arquivo: filename, extensao: extension });
                    }
                }

                if (arquivos.length > 0) {
                    $(`#arquivos${atividadeEditar}`).attr(`data-arquivos`, JSON.stringify(arquivos));
                    $(`#arquivos${atividadeEditar}`).html('<label class="btn btn-outline-dark mt-1"><i class="fas fa-folder-open"></i><span class="fs-12"> clique para visualizar lista de arquivos </span></label>');
                }
                else {
                    $(`#arquivos${atividadeEditar}`).attr(`data-arquivos`, JSON.stringify([]));
                    $(`#arquivos${atividadeEditar}`).empty();
                }

                Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                return;
            }

            let [arquivos, atividadeBuscar] = [[], id_atividades_add + 1];
            for (let obj of $(`input[type="file"][atividade="${atividadeBuscar}"]`)) {
                var file = obj.files;
                for (i = 0; i < file.length; i++) {

                    let arrayfile = file[i].name.split('.');
                    const extension = '.' + arrayfile.pop();
                    const filename = arrayfile.join('.');

                    arquivos.push({ nome_Arquivo: filename, extensao: extension, atividadeBuscar: atividadeBuscar });
                }
            }

            inserirAtividade({
                            descricaoAcao: $(`#mytextarea`).trumbowyg('html'),
                            responsavel: "@User.Identity.GetUserName()",
                            usuario: "@User.Identity.GetUserId()",
                            dataCriacao: moment().format('DD/MM/YYYY HH:mm:ss'),
                            mensagenschat: [],
                            mensagens_Chat: false,
                            arquivos: arquivos,
                            origem: "@RsCadastros.MANUAL",
                            tipoAtividade: $('input[name=TipoAtividade]:checked').val()
                        }, id_atividades_add + 1);


            </text>
            }

            id_atividades_add++;
            $('#mytextarea').trumbowyg('html', '');
            filter_state = {};
            TagFilter("tagFiles", filter_state);
            $('#TagLabel').hide();
        }

        });


