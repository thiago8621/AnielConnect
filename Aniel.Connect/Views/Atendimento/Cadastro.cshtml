    $(document).on('click', '.removerAtividade', function () {

        let atividade = $(this).attr('atividade');


        if (atividade == $('#btnInserirAtividade').attr('editar')) {
            Notificar("@RsBase.ATENCAO_", "Atividade está em processo de edição", "warning");
            return false;
        }


        $(`#atividadeAdicionada${atividade}`).fadeOut(150, function () {
            $(this).remove();

            $(`.atividadeAdicionar${atividade}`).remove();
            $(`.atividadeAdicionarPlano${atividade}`).remove();
            $('.ordemAtividade').each((i, value) => {
                $(value).html(`${$('.ordemAtividade').length - i}`);
            });

            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");

        })
    });

    $(document).on('click', '.editarAtividade', function () {

        let atividade = $(this).attr('atividade');
        Swal.fire({
            title: 'Você está tentando editar uma atividade, deseja continuar?',
            showCancelButton: true,
            confirmButtonText: `@RsBase.SIM`,
            cancelButtonText: `@RsBase.NAO`,
        }).then((result) => {

            if (result.value) {
                $('#mytextarea').trumbowyg('html', $(`#atividadeConteudo${atividade}`).html());
                filter_state = {};
                TagFilter("tagFiles", filter_state);
                $('#TagLabel').hide();

                $(`input[type="file"][atividade=${atividade}]`).each(function (i, obj) {
                    if (obj.files.length > 0) {
                        filter_state[obj.files[0].name + i] = {
                            label: "",
                            removable: true,
                            getDisplay: () => { return obj.files[0].name },
                            onclick: () => {
                                obj.remove();
                            }
                        }
                        $('#TagLabel').show();
                    }
                });

                TagFilter("tagFiles", filter_state);

                $('#btnInserirAtividade').val("@RsCadastros.EDITAR_ATIVIDADE");
                $('#btnInserirAtividade').attr('editar', atividade);
                $('#mytextarea').trumbowyg('focus');
            }

        })
    });

