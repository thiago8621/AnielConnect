    async function verificaQtdeAtendimentoTitular(id_cliente_plano_produto, id_cliente_contrato) {
        if (id_cliente_plano_produto != iValor_ClientePlanoProduto || iValor_ClienteContrato != id_cliente_contrato) {
            iValor_ClientePlanoProduto = id_cliente_plano_produto;
            iValor_ClienteContrato = id_cliente_contrato;
            var link = `@String.Concat(CONSTANTES.URLPortal, "/api/AtendimentoApi/QtdeAtendimentos_Titular?Id_Cliente=")${$(`#iCliente`).val()}&Id_Cliente_Contrato=${iValor_ClienteContrato}&Id_Cliente_Plano_Produto=${iValor_ClientePlanoProduto}&Protocolo=${$(`#iProtocolo`).val()}`;
            const data = await $.ajax({
                url: link,
                type: 'GET',
                dataType: 'json'
            });

            if (data.ok == true) {
                if (data.objeto.length > 0) {
                    var obj = data.objeto;

                    var html = `Cliente já possui um atendimento em andamento. {trocarProtocolo}. Deseja continuar e/ou criar um novo atendimento para este cliente?.\n`;
                    var protocolo = ``;
                    for (var i = 0; i < obj.length; i++) {
                        protocolo += `Protocolo - ${obj[i].protocolo};\n`;
                    }

                    html = html.replace("{trocarProtocolo}", protocolo);
                    var result = await Swal.fire({
                        text: html,
                        type: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Sim',
                        cancelButtonText: 'Não'
                    });

                    if (result.dismiss == "cancel") {
                        $("#divProgress").show();

                        location.href = "@Html.Raw(Url.Action("Listagem_Atendimento", "Atendimento"))";
                    }
                }
            } else {
                Notificar("@RsBase.ATENCAO_", data.mensagem, "info");
            }
        }
    }

