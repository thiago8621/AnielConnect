    async function getStatusLogin(idPlanoProduto) {
        try {

            const response = await $.ajax({
                url:  `@CONSTANTES.URLPortal/api/IntegracaoRadiusApiController/VerificaStatusLogin`,
                type: 'POST',
                dataType: 'json',
                data: { idClientePlanoProduto: idPlanoProduto},
                success: function (data) {
                    if (data === 0) {
                        $('#iStatusLogin').html("@RsCadastros.ONLINE").css("color", "green");
                    }
                    else if (data === 1) {
                        $('#iStatusLogin').html("@RsCadastros.OFFLINE").css("color", "red");
                    }
                    else if (data === 2) {
                        $('#iStatusLogin').html("@RsCadastros.SEM_SESSAO_DISPONIVEL");
                    }
                    else {
                        $('#iStatusLogin').html("@RsCadastros.ERRO_STATUS_LOGIN").css("color", "red");
                    }

                },
                error: function (xhr, status, error) {

                    $('#iStatusLogin').html("@RsCadastros.ERRO_STATUS_LOGIN").css("color", "red");
                }
            });
        } catch (error) {

            $('#iStatusLogin').html("@RsCadastros.ERRO_STATUS_LOGIN").css("color", "red");
        }
    }


