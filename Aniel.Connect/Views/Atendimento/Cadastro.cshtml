async function ConvidarAtendenteChat(atendenteConvidado) {
    var result = Boolean(atendenteConvidado) == false ? await Swal.fire({
        title: 'Convidar Atendente',
        text: 'Após convidar, uma solicitação será enviada.',
        icon: 'warning',
        html: `<div class="form-group mb-2 mt-2">
                    <label><b>O convidado poderá ou não aceitar a solicitação e terá acesso ao histórico e novas mensagens.</b></label><br /><br />
                    <label for="iSetorConvidar">@RsCadastros.SETOR:</label>
                    <select class="form-control obrigatorioTransferencia selectContainerSub" id="iSetorConvidar"></select>

                    <label class="mt-2" for="iResponsavelConvidar">@RsCadastros.ATENDENTE:</label>
                    <select class="form-control selectContainerSub" id="iResponsavelConvidar"></select>
                </div>`,
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: '@Html.Raw(RsCadastros.CONVIDAR_ATENDENTE)',
        cancelButtonText: '@Html.Raw(RsBase.CANCELAR)',
        onOpen: async () => {
            var HandleDepartamentoTransferencia = function () {
                $('#iSetorConvidar').on('select2:select select2:unselecting', async function (e) {
                    DepartamentoSelecionado = e.params.data;
                    await AddSelect("iResponsavelConvidar", "@CONSTANTES.URLPortal/api/Identity_UserApi/GetComboUserId", @CONSTANTES.PaginacaoRegistros, null, DepartamentoSelecionado.id, null, "@RsBase.SELECIONE", false);
                });
            };

            await AddSelect("iResponsavelConvidar", "@CONSTANTES.URLPortal/api/Identity_UserApi/GetComboUserId", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            await AddSelect("iSetorConvidar", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleDepartamentoTransferencia);
        },
        preConfirm: () => {
            if (ValidaObrigatoriosPorClasse("obrigatorioTransferencia", false)) {
                return false;
            }

            atendenteConvidado = $(`#iResponsavelConvidar`).val();
        }
    }) : { value: true };

    if (result.value) {
        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoapi/ConvidarAtendente")';
        await $.ajax({
            url: link,
            type: 'POST',
            dataType: 'json',
            data: {
                usuarioConvidado: atendenteConvidado,
                protocolo: "@Model.Numero"
            },
            beforeSend: function () {
                $("#divProgress").show();
            },
            complete: function () {
                $("#divProgress").hide();
            }
        })
            .done(function (data) {
                if (data.ok) {
                    Notificar("@RsBase.ATENCAO_", `Convite enviado! Ao aceitar a solicitação, ${atendenteConvidado} entrará na conversa.`, "info");
                } else {
                    if (data.mensagem == "{ERROR_NOT_USER}") {
                        notifica_bloqueio_chat();
                    } else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
                }
            });
    }
}


    async function TransferirAtendimentoChat(novoAtendente,novoDepartamento = null) {

        var result = Boolean(novoAtendente) == false ? await Swal.fire({
            title: 'Transferir Atendimento',
            text: 'após transferir, a tela de atendimento será fechada',
            icon: 'warning',
            html: `<div class="form-group mb-2 mt-2">
                        <label><b>Após transferir, a tela de atendimento será fechada.</b></label><br /><br />
                        <label for="iSetorTransferir">@RsCadastros.SETOR:</label>
                        <select class="form-control obrigatorioTransferencia" id="iSetorTransferir"></select>

                        <label class="mt-2" for="iResponsavelTransferir">@RsCadastros.RESPONSAVEL:</label>
                        <select class="form-control" id="iResponsavelTransferir"></select>
                    </div>`,
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: '@Html.Raw(RsCadastros.TRANSFERIR)',
            onOpen: async () => {

                var HandleDepartamentoTransferencia = function () {
                    $('#iSetorTransferir').on('select2:select select2:unselecting', async function (e) {
                        DepartamentoSelecionado = e.params.data;
                        await AddSelect("iResponsavelTransferir", "@CONSTANTES.URLPortal/api/Identity_UserApi/GetComboUserId", @CONSTANTES.PaginacaoRegistros, null, DepartamentoSelecionado.id, null, "@RsBase.SELECIONE", false);
                    });
                }

                await AddSelect("iResponsavelTransferir", "@CONSTANTES.URLPortal/api/Identity_UserApi/GetComboUserId", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                await AddSelect("iSetorTransferir", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleDepartamentoTransferencia);

            },
            cancelButtonText: '@Html.Raw(RsBase.CANCELAR)',
            preConfirm: () => {
                if (ValidaObrigatoriosPorClasse("obrigatorioTransferencia", false)) {
                    return false;
                }

                novoDepartamento = $(`#iSetorTransferir`).val();
                novoAtendente = $(`#iResponsavelTransferir`).val();
            }
        }) : {value : true};

        if (result.value) {

            var iStatusAt = $('#iStatusAtendimento option:selected').val();
            if (iStatusAt == 0 || iStatusAt == 5) {
                $("#iStatusAtendimento").val("5");
            }

            ////await parent.chat.server.transferirChat("@Model.Numero", novoAtendente, novoDepartamento);
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoapi/TransferirAtendimento")';
            let dataTransferencia = await $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    usuario: "@User.Identity.GetUserId()",
                    protocolo: "@Model.Numero",
                    novoAtendente: novoAtendente,
                    novoDepartamento: novoDepartamento
                },
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                }
            });

            if (dataTransferencia.ok) {

                const idTransferenciasNotificacao = @notificacaoTransferencia;
                await parent.chat.server.transferirChat("@Model.Numero", novoAtendente, novoDepartamento);
                await $.ajax({
                    url: "@String.Concat(CONSTANTES.URLPortal,"/api/NotificacoesApi/EnviaNotificacoesTransferenciaChat")",
                    data: { idNotificacao: idTransferenciasNotificacao, idAtendimento: @Model.Id},
                    type: "POST",
                    dataType: "json"
                });

                        if (novoAtendente == "@User.Identity.GetUserId()")
                            window.location = "@Url.Action("Cadastro", "Atendimento")" + "?Numero_Protocolo=@Model.Numero";
                        else
                            window.location = "@Url.Action("Listagem_Atendimento", "Atendimento")";
                    }
            else {
                Notificar("@RsBase.ATENCAO_", dataTransferencia.mensagem, "warning");
                    }
        }
    }

