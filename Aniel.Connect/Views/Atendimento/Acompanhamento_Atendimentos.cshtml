@model Aniel.Connect.Models.AtendimentoFiltroModel

@using Microsoft.AspNet.Identity
@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5

@{
    /**/

    ViewBag.Title = RsCadastros.ACOMPANHAMENTO_ATENDIMENTOS;
    ViewBag.Sessao = RsCadastros.ATENDIMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    <link href="~/bin/Content/preloaderbar.css" media="none" onload="if(media!='all')media='all'" rel="stylesheet" />
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .select2-dropdown {
            z-index: 1500 !important;
        }

        h3.popover-header {
            font-size: 0.8rem !important;
        }
    </style>

}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")


    <script>

        var rows_selected = [];
        var oDatatable;
        var oDatatableEmAtendimento;
        var oDatatableEmAtendimentoBot;


        var handleDataTableButtons = async function () {
            "use strict";

            if (oDatatable != null) {
                oDatatable.destroy();
                $("#datatable").empty();
            }

            if (oDatatableEmAtendimento != null) {
                oDatatableEmAtendimento.destroy();
                $("#datatableEmAtendimento").empty();
            }

            if (oDatatableEmAtendimentoBot != null) {
                oDatatableEmAtendimentoBot.destroy();
                $("#datatableEmAtendimentoBot").empty();
            }

            //"Blfrtip"
            oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                data: @Html.Raw(Json.Encode(ViewBag.Aguardando)),
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                pageLength: 100,
                scroller: true,
                scrollX: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '30vh',
                columns: [
                    {
                        data: "chat", title: "@RsCadastros.CHAT", render: function (data, type, row, meta) {
                            const rowData = JSON.stringify(row).replace(/"/g, '&quot;');
                            return `<a href="#" onclick="abrirAtendimento(${rowData}, 'S')">Assumir Chat</a>`;
                        }
                    },
                    {
                        data: "protocolo", title: "@RsCadastros.PROTOCOLO", render: function (data, type, row, meta) {
                            const rowData = JSON.stringify(row).replace(/"/g, '&quot;');
                            return `<a href="#" onclick="abrirAtendimento(${rowData}, 'N')">${data}</a>`;
                        }
                    },
                    { data: "cliente", title: "@RsCadastros.CLIENTE" },
                    { data: "organizacaoCliente", title: "@RsCadastros.ORGANIZACAO_CLIENTE" },
                    { data: "categoriaCliente", title: "@RsCadastros.CATEGORIA_CLIENTE"},
                    { data: "tipoAtendimento", title: "@RsCadastros.TIPOATENDIMENTO" },
                    { data: "etapa_Atual", title: "@RsCadastros.ETAPA_ATUAL" },
                    { data: "tempo_Gasto", title: "@RsCadastros.TEMPO_GASTO" },
                    { data: "data_Sla_Etapa", title: "@RsCadastros.DATA_SLA_ETAPA" },
                    { data: "data_Sla_Etapa", title: "@RsCadastros.PRAZO_ETAPA_ATUAL" },
                    {
                        data: "tempoEspera", title: "@RsCadastros.TEMPO_ESPERA",render: function (data, type, row, meta) {
                            return `${data} minutos`
                        }},
                    { data: "origem", title: "@RsCadastros.ORIGEM" },
                    {
                        data: "sla", title: "@RsCadastros.SLA", render: function (data, type, row, meta) {
                            return `<span class="fs-12"><i class="fas fa-flag" style="color:${data}">`
                        }
                    }

                ]
            });

            oDatatableEmAtendimento = $("#datatableEmAtendimento").length && $("#datatableEmAtendimento").DataTable({
                dom: "Bfrti",
                data: @Html.Raw(Json.Encode(ViewBag.EmAtendimento)),
                language: traducaoDataTableSimples,
                buttons: buttonsDataTable,
                scroller: true,
                scrollX: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '30vh',
                columns: [
                    {
                        data: "chat", title: "@RsCadastros.CHAT", render: function (data, type, row, meta) {
                            const rowData = JSON.stringify(row).replace(/"/g, '&quot;');
                            return `<a href="#" onclick="abrirAtendimento(${rowData}, 'N')">Visualizar Chat</a>`;
                        }
                    },

                    {
                        data: "protocolo", title: "@RsCadastros.PROTOCOLO", render: function (data, type, row, meta) {
                            const rowData = JSON.stringify(row).replace(/"/g, '&quot;');
                            return `<a href="#" onclick="abrirAtendimento(${rowData}, 'N')">${data}</a>`;
                        }
                    },
                    { data: "cliente", title: "@RsCadastros.CLIENTE" },
                    { data: "organizacaoCliente", title: "@RsCadastros.ORGANIZACAO_CLIENTE" },
                    { data: "categoriaCliente", title: "@RsCadastros.CATEGORIA_CLIENTE"},
                    { data: "tipoAtendimento", title: "@RsCadastros.TIPOATENDIMENTO" },
                    { data: "etapa_Atual", title: "@RsCadastros.ETAPA_ATUAL" },
                    { data: "tempo_Gasto", title: "@RsCadastros.TEMPO_GASTO" },
                    { data: "data_Sla_Etapa", title: "@RsCadastros.DATA_SLA_ETAPA" },
                    { data: "data_Sla_Etapa", title: "@RsCadastros.PRAZO_ETAPA_ATUAL" },
                    { data: "agente", title: "@RsCadastros.RESPONSAVEL_ATUAL"},
                    { data: "tempoEspera", title: "Tempo de Duração",render: function (data, type, row, meta) { return `${data} minutos` }},
                    { data: "origem", title: "@RsCadastros.ORIGEM" },
                    { data: "sla", title: "@RsCadastros.SLA", render: function (data, type, row, meta) { return `<span class="fs-12"><i class="fas fa-flag" style="color:${data}">`}}

                ]
            });

            //TESTE
            var array = @Html.Raw(Json.Encode(ViewBag.EmAtendimentoBot));
            var nome_lista = "bot"; //Nome_utilizado para enganar o razor
            //"Blfrtip"
            var oDatatableEmAtendimentoBot = $("#datatableEmAtendimentoBot").length && $("#datatableEmAtendimentoBot").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                buttons: buttonsDataTable,
                scroller: true,
                scrollX: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '30vh',
                columns: [
                      {
                          data: "chat", title: "@RsCadastros.CHAT", render: function (data, type, row, meta) {
                              const rowData = JSON.stringify(row).replace(/"/g, '&quot;');
                              return `<a href="#" onclick="abrirAtendimento(${rowData}, 'S')">Assumir Chat</a>`;
                          }
                      },
                    {
                        data: "protocolo",
                        orderable: false,
                        title: "@RsCadastros.PROTOCOLO",
                        render: function (data, type, row, meta) {
                            const rowData = JSON.stringify(row).replace(/"/g, '&quot;');
                            return `<a href="#" onclick="abrirAtendimento(${rowData}, 'N')">${data}</a>`;
                        },
                        width: 380
                    },
                    {
                        data: "cliente",
                        orderable: false,
                        title: "@RsCadastros.CLIENTE",
                        render: function (data, type, row, meta) {
                            if (data == null || data == '') {
                                data = 'Não identificado';
                            }
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__cliente" name="' + nome_lista + '[' + meta.row + '].cliente" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        },
                        width: 380
                    },
                    {
                        data: "organizacaoCliente",
                        orderable: false,
                        title: "@RsCadastros.ORGANIZACAO_CLIENTE",
                        render: function (data, type, row, meta) {
                            if (data == null || data == '') {
                                data = 'Não identificado';
                            }
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__organizacaoCliente" name="' + nome_lista + '[' + meta.row + '].organizacaoCliente" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        },
                        width: 380
                    },
                    {
                        data: "nomeBot",
                        orderable: false,
                        title: "@RsCadastros.BOT",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__nomeBot" name="' + nome_lista + '[' + meta.row + '].nomeBot" type="hidden" value="' + data + '">';
                            }
                            return data;
                        },
                        width: 380
                    },
                    {
                        data: "tempoEspera",
                        orderable: false,
                        title: "@RsCadastros.TEMPO_ATENDIMENTO",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__tempoEspera" name="' + nome_lista + '[' + meta.row + '].tempoEspera" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return `${data} minutos`
                        },
                        width: 380
                    },
                     {
                        data: "origem",
                        orderable: false,
                        title: "@RsCadastros.ORIGEM",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__origem" name="' + nome_lista + '[' + meta.row + '].origem" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        },
                        width: 380
                    },
                    {
                        data: "sla", title: "@RsCadastros.SLA", render: function (data, type, row, meta) {
                            return `<span class="fs-12"><i class="fas fa-flag" style="color:${data}">`
                        }
                    }


                ]
            });
        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

    TableManageButtons.init();

        async function abrirAtendimento(row, assumir_chat) {
            var url = `@Url.Action("Cadastro","Atendimento")?Numero_Protocolo=${row.protocolo}`;
            var assumir_atendimento = true;
            if (assumir_chat == "S") {
                assumir_atendimento = await assumirAtendimento(row.protocolo);
            }

            if (assumir_atendimento) {
                AddAba(url);
            }
        }

        async function assumirAtendimento(protocolo) {
            const resultado = await $.ajax({
                url: `@CONSTANTES.URLPortal/api/Atendimentoapi/BuscaDados?protocolo=${protocolo}`,
                type: 'GET',
                dataType: 'json',
                beforeSend: function () {
                    $("#divProgress").show();
                },
                complete: function () {
                    $("#divProgress").hide();
                }
            });

            if (resultado.ok) {
                const obj = resultado.objeto;
                if (obj.id_Responsavel) {
                    await Swal.fire({
                        text: `Não é possível assumir atendimento, pois, o mesmo já se encontra em andamento.`,
                        type: 'warning',
                        confirmButtonColor: '#3085d6',
                        confirmButtonText: 'OK',
                    });

                    location.href = "@Html.Raw(Url.Action("Acompanhamento_Atendimentos", "Atendimento"))";
                    $("#divProgress").show();
                    return false;
                } else {
                    const atendimento = await $.ajax({
                        url: `@CONSTANTES.URLPortal/api/Atendimentoapi/AtualizarResponsavel_Setor?protocolo=${protocolo}`,
                        type: 'GET',
                        dataType: 'json',
                        beforeSend: function () {
                            $("#divProgress").show();
                        },
                        complete: function () {
                            $("#divProgress").hide();
                        }
                    });

                    if (!atendimento.ok) {
                        Notificar("@RsBase.ATENCAO_", atendimento.mensagem, "warning");
                        return false;
                    }

                    await parent.chat.server.transferirChat(protocolo, "@User.Identity.GetUserId()", null);

                    return true;
                }
            } else {
                Notificar("@RsBase.ATENCAO_", resultado.mensagem, "warning");
                return false;
            }
        }

    </script>
}

