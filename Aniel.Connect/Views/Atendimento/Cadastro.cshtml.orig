                if ($("#iScriptAtendimentoFrame").attr("src") != "@Html.Raw(Url.Action("Script_Atendimento", "Atendimento", new { IdAtendimento = Model.Id, IdTipoAtendimento = Model.Id_Tipo_Atendimento }))") {

                    $('#divProgressScript').show();

                    $('#iScriptAtendimentoFrame').on("load", function () {
                        $('#divProgressScript').fadeOut();
