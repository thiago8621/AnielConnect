@section scripts
{
    <!--TyneMCE-->
    <script src="https://cdn.tiny.cloud/1/5cd306b14gcnqz5xzm9ekr2ekz3far2tsel7sfe91nytmkt8/tinymce/5/tinymce.min.js" referrerpolicy="origin"></script>
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
    @if (ViewBag.ChatAtivo)
    {<text>
            <script type="module">


        import { EmojiButton } from 'https://cdn.jsdelivr.net/npm/@("@")joeattardi/emoji-button@4.0.1/dist/index.min.js';

        var picker = new EmojiButton();
        picker.on('emoji', selection => {
            $('#inlineFormInputGroupUsername2').val($('#inlineFormInputGroupUsername2').val() + selection.emoji);
        });

        $("#iEmoji").click(function () {
            picker.togglePicker(this);
        });


            </script>
    </text>
}
<script>
    var id_Categoria_Cliente_selecionado;
    var Id_Responsavel_nome = "";
    $.ajax({
        type: 'GET',
        url: `@CONSTANTES.URLPortal/api/IdentityUserapi/FindById?Id=${"@User.Identity.GetUserId()"}`,
        dataType: 'json'
    }).
        done(function (data) {
            Id_Responsavel_nome = data.objeto.desc_User;
        });



        function DownloadInputFile(atividade, nome_Arquivo, extensao) {
            file = $(`input[type='file'][atividade="${atividade}"]`)[0].files[0];
            fr = new FileReader();
            fr.readAsDataURL(file);

            var blob = new Blob([file], { type: "application/octet-binary" });


            var objectURL = window.URL.createObjectURL(blob);
            console.log(objectURL);

            if (navigator.appVersion.toString().indexOf('.NET') > 0) {
                window.navigator.msSaveOrOpenBlob(blob, nome_Arquivo + extensao);
            } else {
                var link = document.createElement('a');
                link.href = objectURL;
                link.download = nome_Arquivo + extensao;
                document.body.appendChild(link);
                link.click();
                link.remove();
            }
        }

        function VisuInputFile(atividade, nome_Arquivo, extensao) {
            file = $(`input[type='file'][atividade="${atividade}"]`)[0].files[0];
            fr = new FileReader();
            fr.readAsDataURL(file);

            var blob = new Blob([file], { type: "application/octet-binary" });


            var objectURL = window.URL.createObjectURL(blob);
            console.log(objectURL);

            if (navigator.appVersion.toString().indexOf('.NET') > 0) {
                window.navigator.msSaveOrOpenBlob(blob, nome_Arquivo + extensao);
            } else {
                var link = document.createElement('a');
                link.href = objectURL;
                link.target = "_blank";
                link.download = nome_Arquivo + extensao;
                document.body.appendChild(link);
                link.click();
                link.remove();
            }
        }

        tinymce.init({
            selector: '#mytextarea',
            language: 'pt_BR',
            paste_data_images: true,
            plugins: [
                'advlist lists image print',
                'visualblocks code fullscreen',
                'paste'
            ],
            toolbar: 'insertfile undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | image',
            file_picker_types: 'image',
            file_picker_callback: function (cb, value, meta) {
                var input = document.createElement('input');
                input.setAttribute('type', 'file');
                input.setAttribute('accept', 'image/*');

                /*
                  Note: In modern browsers input[type="file"] is functional without
                  even adding it to the DOM, but that might not be the case in some older
                  or quirky browsers like IE, so you might want to add it to the DOM
                  just in case, and visually hide it. And do not forget do remove it
                  once you do not need it anymore.
                */

                input.onchange = function () {
                    var file = this.files[0];

                    var reader = new FileReader();
                    reader.onload = function () {
                        /*
                          Note: Now we need to register the blob in TinyMCEs image blob
                          registry. In the next release this part hopefully won't be
                          necessary, as we are looking to handle it internally.
                        */
                        var id = 'blobid' + (new Date()).getTime();
                        var blobCache = tinymce.activeEditor.editorUpload.blobCache;
                        var base64 = reader.result.split(',')[1];
                        var blobInfo = blobCache.create(id, file, base64);
                        blobCache.add(blobInfo);

                        /* call the callback and populate the Title field with the file name */
                        cb(blobInfo.blobUri(), { title: file.name });
                    };
                    reader.readAsDataURL(file);
                };

                input.click();
            }


        });

        var ja_passou = null;

    var criar_Os_Encerrar = false;
    var nome_responsavel_historico = "";
    var  etapa_atual = "";
        var id_tipo_atendimento = parseInt( $("#iTipoAtendimento option:selected").val() );
        var login_radius = "";
        let id_atividades_add = 0;


        $('#btnLog').on('click', function () {

            let _url = `@Url.Action("Index", "LogGenerico")?Modelo=2`;

            AddAba(_url, "@( String.Format(RsFinanceiro.LOGDE, RsFinanceiro.CONTAS_RECEBER) )");
        });

        async function getAvisoImportante() {

            let listaPromises = [];
            let promiseInadimplente = $.ajax({
                url: "@CONSTANTES.URLFinanceiro/api/Controle_Inadimplentesapi/GetAll_Contas_Inadimplentes",
                type: "POST",
                data: {
                    id_Cliente: $('#iCliente').val(),
                }
            })
                .done(function (data) {

                    if (data.data.length > 0) {
                        var max = data.data.map(p => p.dias_Atraso).reduce(function (a, b) {
                            return Math.max(a, b);
                        },0);

                        if (max > 0) {
                            $('#accordion_infoPlano').show();
                            $('#accordion_infoCliente').show();
                            $('#accordion_Atendimento').show();
                            $('#accordion_Chat').show();

                            $('.inadimplente').show();
                            $('.ClienteInadimplente').html(`<span style='color:red;font-weight:bold'>${max} dias</span>`);
                        }
                        else {
                            $('.inadimplente').hide();
                            $('.ClienteInadimplente').html(``);
                        }
                    }
                    else {
                        $('.inadimplente').hide();
                        $('.ClienteInadimplente').html(``);
                    }
                });


            if ($('#iCpf_Cnpj_Cliente').html()) {
             let Fim_Manutenção = $.ajax({
                 url: "@CONSTANTES.URLPortal/api/Area_ManutencaoApi/GetClienteManutencao",
                type: "POST",
                data: {
                    CPF: $('#iCpf_Cnpj_Cliente').html(),
                }
            })
                 .done(function (data) {
                     if (data.objeto.length > 0) {
                         var datafinal = data.objeto[0].dataFinal;
                         $('#accordion_infoPlano').show();
                         $('#accordion_infoCliente').show();
                         $('#accordion_Atendimento').show();
                         $('#accordion_Chat').show();

                         $('.manutencaoRegiao').show();
                         $('.manutencaoRegiaotxt').html(` <span style='color:red;font-weight:bold'>${datafinal}</span> `);
                     }
                     else {
                         $('.manutencaoRegiao').hide();
                     }

                 });
                listaPromises.push(Fim_Manutenção);
            };

            let TermoAdesaoCliente = $.ajax({
                url: "@CONSTANTES.URLPortal/api/Vendaapi/TermoAdesaoCliente",
                type: "POST",
                data: {
                  Id_Cliente: $('#iCliente').val(),
                }
            })
                .done(function (data) {

                    if (data.objeto.length > 0) {
                        $('#accordion_infoPlano').show();
                        $('#accordion_infoCliente').show();
                        $('#accordion_Atendimento').show();
                        $('#accordion_Chat').show();

                         $('.termoAdesao').show();
                         $('.termoAdesaotxt').html(` <span style='color:red;font-weight:bold'>&#160;Pendente de Assinatura</span> `);
                     }
                     else {
                         $('.termoAdesao').hide();
                     }

                 });
            listaPromises.push(TermoAdesaoCliente);

            let QtdFaturasAberto = $.ajax({

                url: `@CONSTANTES.URLPortal/api/clienteapi/GetAllFaturasAbertoTotal?IdCliente=${$('#iCliente').val()}`,
                type: "POST",
            })
                .done(function (data) {
                    if (data != 0) {
                        $('#accordion_infoPlano').show();
                        $('#accordion_infoCliente').show();
                        $('#accordion_Atendimento').show();
                        $('#accordion_Chat').show();

                        $('.faturasAberto').show();
                        $('.faturasAbertotxt').html(` <span style='color:red;font-weight:bold'>&#160;${data}</span> `);
                    } else {
                        $('.faturasAberto').hide();
                    }
                });

            listaPromises.push(QtdFaturasAberto);




            let promiseNegociacao = $.ajax({
                url: `@CONSTANTES.URLPortal/api/clienteapi/ClienteEmNegociacao?Id_cliente=${$('#iCliente').val()}`,
                type: "GET"
            })

                .done(function (data) {

                    if (data.ok) {
                        if (data.objeto.possui_Negociacao) {
                            var Valor_Negociado = data.objeto.valor_Negociado;
                            $('#accordion_infoPlano').show();
                            $('#accordion_infoCliente').show();
                            $('#accordion_Atendimento').show();
                            $('#accordion_Chat').show();

                            $('.emNegociacao').show();
                            $('.emNegociacaotxt').html(`<span style='color:red;font-weight:bold'> Negociação em aberto no valor de R$${Valor_Negociado}</span> `);
                        }
                        else {
                            $('.emNegociacao').hide();
                        }
                    }

                });

                //.done(function (data) {
                //    if (data.ok) {

                //        if (data.objeto) {
                //            $('#accordion_infoPlano').show();
                //            $('#accordion_infoCliente').show();
                //            $('#accordion_Atendimento').show();
                //            $('#accordion_Chat').show();
                //            $('.emNegociacao').show();
                //        }
                //        else {
                //            $('.emNegociacao').hide();
                //        }


                //    }
                //    else {
                //        $('.emNegociacao').hide();
                //    }
                //});

            if ($('#iOLT').html() && $('#iPON').html() && $('#iONU').html()) {
                let promiseStatusSinal = $.ajax({
                    url: `@CONSTANTES.URLPortal/api/IntegracaoAtivacaoApiController/DiagnosticoONU`,
                    type: "POST",
                    data: {
                        idOLT: $('#iOLT').html(),
                        idPON: $('#iPON').html(),
                        idONU: "@Model.Id_ONU"
                    }
                })
                    .done(function (data) {
                        if (data.rx) {

                            if (data.rx != "0") {
                                $('.SinalPlano').html("@RsCadastros.ONLINE");
                            }
                            else {
                                $('#accordion_infoPlano').show();
                                $('#accordion_infoCliente').show();
                                $('#accordion_Atendimento').show();
                                $('#accordion_Chat').show();

                                $('.SinalPlano').html("@RsCadastros.OFFLINE");
                            }

                        }
                        else {
                            $('#accordion_infoPlano').show();
                            $('#accordion_infoCliente').show();
                            $('#accordion_Atendimento').show();
                            $('#accordion_Chat').show();

                            $('.statusSinal').show();
                            $('.SinalPlano').html("@RsCadastros.NAO_FOI_POSSIVEL_DETERMINAR_SITUACAO");
                        }
                    });

                listaPromises.push(promiseStatusSinal);
            }
            else {
                $('.statusSinal').hide();
                $('.velocidadeReduzida').hide();
                $('.SinalPlano').hide();
            }

            listaPromises.push(promiseNegociacao);
            listaPromises.push(promiseInadimplente);



            Promise.all(listaPromises).then((values) => {

                if ($('#iVelocidadeReduzida').val() == true || $('#iVelocidadeReduzida').val() == "true") {
                    $('#accordion_infoPlano').show();
                    $('#accordion_infoCliente').show();
                    $('#accordion_Atendimento').show();
                    $('#accordion_Chat').show();

                    $('.velocidadeReduzida').show();
                }
                else {
                    $('.velocidadeReduzida').hide();
                }


                if ($('#iStatusPlanoProdutoHidden').val() == 3 || $('#iStatusPlanoProdutoHidden').val() == 4) {
                    $('#accordion_infoPlano').show();
                    $('#accordion_infoCliente').show();
                    $('#accordion_Atendimento').show();
                    $('#accordion_Chat').show();

                    $('.sinalBloqueado').show();
                }
                else {
                    $('.sinalBloqueado').hide();
                }
                @if (Model.Cliente_Status != Status_Cliente.Ativo)
                {
                    <text>
                    $('#accordion_infoPlano').show();
                    $('#accordion_infoCliente').show();
                    $('#accordion_Atendimento').show();
                    $('#accordion_Chat').show();

                    $('.clienteProspectInativo').show();
                    </text>
                }
                else {
                    <text>
                        $('.clienteProspectInativo').hide();
                    </text>
                }

                });

        }


        $('#iAtualizarPlano').on('click', function () {

            @if (Model.Id_Cliente != null && Model.Tipo_Cliente == 0)
            {
                <text>AddAba("@Url.Action("ClienteDadosGerais", "Cliente", new { Id = Model.Id_Cliente })","@RsCadastros.CADASTRO_CLIENTE")</text>
            }
            else if (Model.Id_Cliente != null && Model.Tipo_Cliente == 1)
            {
                <text>AddAba("@Url.Action("ClienteDadosGerais", "Cliente_Prospecto", new { Id = Model.Id_Cliente })","@RsCadastros.CADASTRO_PROSPECTO")</text>
            }
        });

        function anterior(perguntaAtual) {
            $("#divPergunta_" + perguntaAtual).hide();
            $("#divPergunta_" + (perguntaAtual - 1)).show();
        }

        function proximo(perguntaAtual) {
            $("#divPergunta_" + perguntaAtual).hide();
            $("#divPergunta_" + (perguntaAtual + 1)).show();
        }

        async function atualizarHistoricoAtividades() {
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoapi/FindById_Historico?Id=")' + "@Model.Id";
            var data = await $.ajax({
                url: link,
                type: 'GET',
                dataType: 'json',

            });

            if (data.ok) {
                $(`#iDivHistoricoAtividade`).empty();
                for (let [i, atividade] of data.objeto.historico_Atendimento.entries()) {
                    inserirAtividade(atividade,i + 1);
                }
            }
            else {
                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
            }
        }

    async function getScriptAtendimento(idTipoAtendimento) {
        var link = '@Html.Raw(String.Concat(CONSTANTES.URLPortal, "/api/AtendimentoApi/GetViewScriptAtendimento?Id_Atendimento=null&Id_TipoAtendimento="))' + idTipoAtendimento;
        await $.ajax({
            url: link,
            type: 'GET',
            dataType: 'json',

        })

            .done(function (data) {
                $('#iCardScript').empty();
                let i = -1;
                if (data.ok) {
                    for (let y = 0; y < data.objeto.length; y++) {
                        i++;

                        let appendString = "";
                        appendString += `<div id="divPergunta_${i}" style="display:none;" >`;


                        appendString += `<input type="hidden" name="RespostasScript[${y}].Id_Tipo_Atendimento" value=${idTipoAtendimento}>`;
                        appendString += `<input type="hidden" name="RespostasScript[${y}].Id_Pergunta" value=${data.objeto[y].id_Pergunta}>`;


                        appendString += `<div class="mt-3 mb-3">`;
                        if (data.objeto[y].pergunta) {
                            appendString += `
                                <h4>
                                    <i class="far fa-question-circle"></i> @RsCadastros.PERGUNTA<br/>
                                    <label for="iNome" class="ml-3" style="font-size: 14px;"> ${i + 1 + " - " + (data.objeto[y].pergunta ?? "")}</label>
                                </h4>`;
                        }
                        appendString += `</div>`;

                        let instrucaoAtendente = data.objeto[y].instrucao_Atendente ? `<div class="card div-card-accord mb-3">
                            <div class="card-header title-card" id="heading-1">
                                <h5 class="mb-0">
                                    <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                        <span class="text-bold-card"><i class="fas fa-book-reader"></i> @RsCadastros.EXPLICACAO_OPERADOR</span>

                                    </a>
                                </h5>
                            </div>
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body body-card-accord">
                                    <div class="row mt-2 mb-2">


                                        <div class="col-sm-12">
                                            <span>${data.objeto[y].instrucao_Atendente ?? ""}</span>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>` : "";

                        let instrucaoCliente = data.objeto[y].instrucao_Cliente ? `<div class="card div-card-accord mb-3">
                            <div class="card-header title-card" id="heading-2">
                                <h5 class="mb-0">
                                    <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-2" aria-expanded="true" aria-controls="collapse-2">
                                        <span class="text-bold-card"><i class="fas fa-bullhorn"></i> @RsCadastros.EXPLICACAO_CLIENTE</span>
                                    </a>
                                </h5>
                            </div>
                            <div id="collapse-2" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                            <div class="card-body body-card-accord">
                                <div class="row mt-2 mb-2">


                                    <div class="col-sm-12">
                                        <span>${data.objeto[y].instrucao_Cliente ?? ""}</span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        </div>` : "";

                        appendString += ` ${instrucaoAtendente}

                                          ${instrucaoCliente}


                        <div class="card mb-3">
                            <div class="card">
                                <div class="card-header title-card" id="heading-3">
                                    <h5 class="mb-0">
                                        @*<a class="collapsed" role="button" data-toggle="collapse" href="#collapse-3" aria-expanded="true" aria-controls="collapse-3">*@
                                        <span class="text-bold-card"><i class="fas fa-headset"></i> @RsCadastros.RESPOSTA_CLIENTE</span>

                                    </h5>
                                </div>

                                <div id="collapse-3" class="collapse show" data-parent="#accordion" aria-labelledby="heading-3">
                                    <div class="card-body body-card-accord">
                                        <div class="mt-2 mb-2 ml-0 mr-0">`;


                        if (data.objeto[y].tipo_Resposta == 0)
                        {
                            appendString += `<input type="text" class="form-control" name="RespostasScript[${y}].Resposta">`;

                        }
                        else if (data.objeto[y].tipo_Resposta == 1)
                        {
                            appendString += `<input type="text" class="form-control datepicker" name="RespostasScript[${y}].Resposta">`;
                        }
                        else if (data.objeto[y].tipo_Resposta == 2)
                        {
                            appendString += `input type="text" class="form-control money" name="RespostasScript[${y}].Resposta">`;
                        }
                        else if (data.objeto[y].tipo_Resposta == 3)
                        {
                            let w = -1;
                            for (var respostaPossivel of data.objeto[y].respostasPossiveis)
                            {
                                w++;
                                appendString += `
                                <div class="form-inline mt-1">
                                    <input type="radio" value="${respostaPossivel}" class="form-control" name="RespostasScript[${y}].Resposta" >
                                    <label for="idRadio_${w}" class="pl-1 pr-1">&nbsp;${respostaPossivel}</label>
                                </div>`;
                            }
                        }
                        else if (data.objeto[y].tipo_Resposta == 4)
                        {
                            let z = -1;
                            //var respostasPossiveis = Model[y].RespostasPossiveis.FirstOrDefault().Split(',');
                            for (var respostaPossivel of data.objeto[y].respostasPossiveis)
                            {
                                z++;
                                appendString += `<div class="form-inline mt-1">
                                    <input type="checkbox" class="form-control" name="RespostasScript[${y}].RespostasMultiplas[${z}]" value="true">
                                    <input name="RespostasScript[${y}].RespostasMultiplas[${z}]" type="hidden" value="false">
                                    <label for="iCheck_${z}" class="pl-1 pr-1">&nbsp;${respostaPossivel}</label>
                                    <br>
                                </div>`;
                            }
                        }

                        appendString += `</div>
                                   </div>
                                </div>
                            </div>
                        </div>



                        <div class="card mb-3">
                            <div class="card">
                                <div class="card-header title-card" id="heading-3">
                                    <h5 class="mb-0">
                                        <span class="text-bold-card"><i class="far fa-clipboard"></i> @RsCadastros.OBSERVACAO_ATENDIMENTO</span>
                                    </h5>
                                </div>

                                <div id="collapse-3" class="collapse show" data-parent="#accordion" aria-labelledby="heading-3">
                                    <div class="card-body body-card-accord">
                                        <div class="mt-2 mb-2 ml-0 mr-0">
                                            <input type="textarea" rows=4 class="form-control" name="RespostasScript[${y}].Observacao_Atendimento">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>`;

                        appendString += `<div class="row mt-5 mb-5">
                            <div class="col-sm-2">
                                ${i != 0 ? `<button type="button" class="btn btn-outline-dark" onclick="anterior(${i})"><i class="fas fa-arrow-left"></i> Anterior</button>` : ""}
                            </div>

                            <div class="col-sm-2">
                                ${data.objeto.length != (i + 1) ? `<button type="button" id="iBtnProximo" class="btn btn-outline-dark" onclick="proximo(${i})"><i class="fas fa-arrow-right"></i> Próximo</button>` : ""}
                            </div>

                        </div>`;

                        $('#iCardScript').append(appendString);
                    }
                    $("#divPergunta_0").show();
                    //DATEPICKER
                    $(".datepicker").mask("00/00/0000");
                    $(".datepicker")
                        .datepicker({
                            format: "dd/mm/yyyy",
                            language: "pt-BR",
                            todayHighlight: "true",
                            autoclose: true
                        })
                        .on("changeDate", function (e) {
                            if ($(this).val().length === 10) return $(this).trigger("focusout");
                            else return true;
                        })
                        .after(function () {
                            var nameLink = `${$(this)[0].id}_dp`;

                            return $(this).is(".readonly") || $(this).prop("readonly")
                                ? $(
                                    `<i id='${nameLink}' class='far fa-calendar-alt fs-15 color-icon-date pl-1 pr-1'></i>`
                                )
                                : $(
                                    `<a id='${nameLink}' href='javascript: void(0);' class='pl-1 pr-1'><i class='far fa-calendar-alt fs-15 color-icon-date'></i></a>`
                                ).click(function () {
                                    $(this)
                                        .prev()
                                        .datepicker("show");
                                });
                        });
                    //MONEY
                    $(".money")
                        .mask("##0,00", {
                            reverse: true,
                            onKeyPress: function (val, event, currentField, options) {
                                currentField.val(FormatDinero(currentField.val()));
                            }
                        })
                        .on("blur", function () {
                            if (!$(this).val()) $(this).val("0,00");
                        });
                }
            });
    }

