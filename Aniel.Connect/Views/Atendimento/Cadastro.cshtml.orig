                else {
                    link = '@String.Concat(CONSTANTES.URLPortal, "/api/AtendimentoApi/Gravar?value=")' + @Model+ `&NomeUsuario=${nome_responsavel_historico}`;
                }


                $.ajax({
                    url: link,
                    type: 'GET',
                    dataType: 'json',

                })

                    .done(function (data) {

