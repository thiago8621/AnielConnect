                                                    <label for="iValorFinalPlano" class="font-weight-bold">@RsCadastros.VALOR_FINAL_TOTAL_SER_PAGO:</label>
                                                    <span id="iValorFinalPlano">@Model.Valor_Final_Plano</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iFormaPagamento" class="font-weight-bold">@RsCadastros.FORMA_PAGAMENTO:</label>
                                                    <span id="iFormaPagamento">@Model.Forma_Pagamento_Utilizada</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iBanco" class="font-weight-bold">@RsCadastros.BANCO:</label>
                                                    <span id="iBanco">@Model.Banco</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iDiaVencimento" class="font-weight-bold">@RsCadastros.DIA_VENCIMENTO:</label>
                                                    <span id="iDiaVencimento">@Model.Dia_Vencimento</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iFormaEnvioFatura" class="font-weight-bold">@RsCadastros.FORMA_ENVIO_FATURA:</label>
                                                    <span id="iFormaEnvioFatura">@Model.Forma_Envio</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iTesteGratis" class="font-weight-bold">@RsCadastros.TESTE_GRATIS:</label>
                                                    <span id="iTesteGratis">@Model.Dias_Teste_Gratis</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iPeriodoCarencia" class="font-weight-bold">@RsCadastros.PERIODO_CARENCIA:</label>
                                                    <span id="iPeriodoCarencia">@Model.Periodo_Carencia</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iDiasCarencia" class="font-weight-bold">@RsCadastros.DIAS_CARENCIA:</label>
                                                    <span id="iDiasCarencia">@Model.Meses_Carencia</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iMultaRescisao" class="font-weight-bold">@RsCadastros.VALOR_MULTA_RESCISAO:</label>
                                                    <span id="iMultaRescisao">@Model.Multa_Rescisao</span>
                                                </div>

                                                @if (Model.Id_Cliente_Plano_Produto != null)
                                                {
                                                    <div class="container">
                                                        <div class="row" style=" margin-left: -30px;">
                                                            <div class="col"><button id="iAtualizarPlano" type="button" class="btn btn-outline-dark"><i class="fa fa-sync-alt mr-2"></i>@RsCadastros.ATUALIZAR_DADOS_PLANO_PRODUTO</button></div>
                                                            <div class="col"><button type="button" onclick="Swal.fire('Recurso ainda está em desenvolvimento.')" class="btn btn-outline-dark"><i class="fa fa-exchange-alt mr-2"></i>@RsCadastros.MUDANCA_PLANO</button></div>
                                                            <div class="w-100 p-1"></div>

                                                            @if (Model.Status_PlanoProduto != Status_PlanoProduto.Suspenso_Empresa)
                                                            {
                                                                <div class="col"><button type="button" onclick='AlterarStatusObj(4, $("#iClientePlanoProduto").val())' class="btn btn-outline-dark"><i class="fa fa-ban mr-2"></i>@RsCadastros.SUSPENDER_PLANO_PRODUTO</button></div>
                                                            }
                                                            else
                                                            {
                                                                <div class="col"><button type="button" onclick='AlterarStatusObj(2, $("#iClientePlanoProduto").val())' class="btn btn-outline-dark"><i class="fa fa-ban mr-2"></i>@RsCadastros.REATIVAR_PLANOS</button></div>
                                                            }


                                                            <div class="col"> <button type="button" onclick='ConfirmarCancelarPlano($("#iClientePlanoProduto").val())' class="btn btn-outline-dark"><i class="fa fa-times mr-2"></i>@RsCadastros.CANCELAR_PLANO</button></div>
                                                        </div>
                                                    </div>
                                                }





                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!--Informações Técnicas-->
                            <div class="accordion mb-3" id="accordion_42">
                                <div class="card div-card-accord">
                                    <div class="card-header title-card" id="heading_42">
                                        <h5 class="mb-0">
                                            <a role="button" data-toggle="collapse" data-target="#collapse_42" aria-expanded="true" aria-controls="collapse_42">
                                                <span class="text-bold-card">@RsCadastros.INFORMACOES_TECNICAS</span>
                                            </a>
                                        </h5>
                                    </div>
                                    <div id="collapse_42" class="collapse show" aria-labelledby="heading_42" data-parent="#accordion_42">
                                        <div class="card-body" style="margin-top: -20px;">

                                            <div class="form-group">
                                                <label for="iLogin_Radius" class="font-weight-bold">@RsCadastros.LOGIN:</label>
                                                <span id="iLogin_Radius">@Model.Login_Radius</span>
                                            </div>
                                            <div class="form-group">
                                                <label for="iSenha_Radius" class="font-weight-bold">@RsCadastros.SENHA:</label>
                                                <span id="iSenha_Radius">@Model.Senha_Radius</span>
                                            </div>
                                            <div class="form-group">
                                                <label for="iPOP" class="font-weight-bold">@RsCadastros.POP:</label>
                                                <span id="iPOP">@Model.POP</span>
                                            </div>
                                            <div class="form-group">
                                                <label for="iONU" class="font-weight-bold">@RsCadastros.ONU:</label>
                                                <span id="iONU">@Model.ONU</span>
                                            </div>
                                            <div class="form-group">
                                                <label for="iOLT" class="font-weight-bold">@RsCadastros.OLT:</label>
                                                <span id="iOLT">@Model.OLT</span>
                                            </div>
                                            <div class="form-group">
                                                <label for="iSlot" class="font-weight-bold">@RsCadastros.SLOT:</label>
                                                <span id="iSlot">@Model.Slot</span>
                                            </div>
                                            <div class="form-group">
                                                <label for="iEnderecoInstalacao" class="font-weight-bold">@RsCadastros.PON:</label>
                                                <span id="iPON">@Model.PON</span>
                                            </div>
                                            <div class="form-group">
                                                <label for="iCaixa_FTTH" class="font-weight-bold">@RsCadastros.CAIXA_FTTH:</label>
                                                <span id="iCaixa_FTTH">@Model.Caixa_FTTH</span>
                                            </div>
                                            <div class="form-group">
                                                <label for="iPorta_FTTH" class="font-weight-bold">@RsCadastros.PORTA_FTTH:</label>
                                                <span id="iPorta_FTTH">@Model.Porta_FTTH</span>
                                            </div>
                                            <div class="form-group">
                                                <label for="iVelocidade_Download" class="font-weight-bold">@RsCadastros.VELOCIDADE_DOWNLOAD:</label>
                                                <span id="iVelocidade_Download">@Model.Velocidade_Download</span>
                                            </div>
                                            <div class="form-group">
                                                <label for="iVelocidade_Upload" class="font-weight-bold">@RsCadastros.VELOCIDADE_UPLOAD:</label>
                                                <span id="iVelocidade_Upload">@Model.Velocidade_Upload</span>
                                            </div>
                                            <div class="form-group">
                                                <label for="iVelocidade_Nominal" class="font-weight-bold">@RsCadastros.VELOCIDADE_NOMINAL:</label>
                                                <span id="iVelocidade_Nominal">@Model.Velocidade_Nominal</span>
                                                <input type="hidden" id="iVelocidadeReduzida" value="@(Model.Velocidade_Reduzida ? "true" : "false")">
                                            </div>
                                            <div class="form-group">
                                                <label for="iVelocidade_Download_Reduzida" class="font-weight-bold">@RsCadastros.VELOCIDADE_DOWNLOAD_REDUZIDA:</label>
                                                <span id="iVelocidade_Download_Reduzida">@Model.Velocidade_Download_Reduzida</span>
                                            </div>
                                            <div class="form-group">
                                                <label for="iVelocidade_Upload_Reduzida" class="font-weight-bold">@RsCadastros.VELOCIDADE_UPLOAD_REDUZIDA:</label>
                                                <span id="iVelocidade_Upload_Reduzida">@Model.Velocidade_Upload_Reduzida</span>
                                            </div>

                                            @if (Model.Id_Cliente_Plano_Produto != null)
                                            {
                                                <div class="container">
                                                    <div class="row" style="margin-left: -30px;">
                                                        <div class="col">
                                                            <button type="button" onclick="ReiniciarOnu();" class="btn btn-outline-dark"><i class="icofont-power pr-1"></i>@RsCadastros.REINICIAR_ONU</button>
                                                        </div>
                                                        <div class="col">
                                                            <button type="button" onclick='TestarLogin($("#iClientePlanoProduto").val())' class="btn btn-outline-dark"><i class="icofont-globe pr-1"></i>@RsCadastros.TESTAR_CONEXAO</button>
                                                        </div>
                                                        <div class="col">
                                                            <button type="button" onclick="ResetOnu();" class="btn btn-outline-dark"><i class="icofont-wifi-router pr-1"></i>@RsCadastros.RESET_ONU</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }




                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (Model.Id != 0)
                        {
                            if (Model.ScriptAtendimento)
                            {
                                <!--SCRIPT DE ATENDIMENTO-->
                                <div role="tabpanel" class="tab-pane" id="iTabScriptAtendimento">
                                    <div class="overlay" id="divProgressScript" style="display:none;position:relative">
                                        <div class="preloaderbar show active" style="position:relative;">
                                            <span class="bar" style="width:auto !important"></span>
                                            <span class="text" style="color:black">@RsCadastros.PROCESSANDO ...</span>
                                        </div>
                                    </div>
                                    <iframe id="iScriptAtendimentoFrame" style="width: 100%; height: 900px" name="iScriptAtendimentoFrame" frameBorder="0" class="mt-1" scrolling="yes"></iframe>
                                </div>

                            }
                            <!--HISTÓRICO DE FATURA-->
                            <div role="tabpanel" class="tab-pane" id="iTabHistoricoFatura">
                                <div class="overlay" id="divProgressHistoricoFatura" style="display:none;position:relative">
                                    <div class="preloaderbar show active" style="position:relative;">
                                        <span class="bar" style="width:auto !important"></span>
                                        <span class="text" style="color:black">@RsCadastros.PROCESSANDO ...</span>
                                    </div>
                                </div>
                                <iframe id="iHistoricoFaturaFrame" style="width: 100%; height: 900px" name="iHistoricoFaturaFrame" frameBorder="0" class="mt-1" scrolling="yes"></iframe>

                            </div>
                            <!--ORDENS DE SERVIÇO-->
                            <div role="tabpanel" class="tab-pane" id="iTabOrdemServico">
                                <div class="overlay" id="divProgressOrdensServico" style="display:none;position:relative">
                                    <div class="preloaderbar show active" style="position:relative;">
                                        <span class="bar" style="width:auto !important"></span>
                                        <span class="text" style="color:black">@RsCadastros.PROCESSANDO ...</span>
                                    </div>
                                </div>
                                <iframe id="iOrdensServicoFrame" style="width: 100%; height: 900px" name="iOrdensServicoFrame" frameBorder="0" class="mt-1" scrolling="yes"></iframe>

                            </div>
                            <!--HISTÓRICO DE ATENDIMENTO-->
                            <div role="tabpanel" class="tab-pane" id="iTabHistoricoAtendiemnto">
                                <div class="overlay" id="divProgressHistoricoAtendimento" style="display:none;position:relative">
                                    <div class="preloaderbar show active" style="position:relative;">
                                        <span class="bar" style="width:auto !important"></span>
                                        <span class="text" style="color:black">@RsCadastros.PROCESSANDO ...</span>
                                    </div>
                                </div>
                                <iframe id="iHistoricoAtendimentoFrame" style="width: 100%; height: 900px" name="iHistoricoAtendimentoFrame" frameBorder="0" class="mt-1" scrolling="yes"></iframe>
                            </div>
                        }
                        else
                        {
                            <div role="tabpanel" class="tab-pane" id="iTabScriptAtendimento">
                                <div style="padding:10px">
                                    <div class="card-body">
                                        <div class="card" id="iCardScript" style="border:none;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div><!--./Direita-->
        </div>

        @if (Model.Id == 0)
        {

            <!--Button Float-->
            <a href="#" class="float-cancel" onclick="BotaoCancelar('@Url.Action("Listagem_Atendimento", "Atendimento")')">
                <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                    <i class="fas fa-times fa-2x"></i>
                </div>
            </a>

            <a href="#" class="float-save" onclick="return SweetAlertOs();">
                <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                    <i class="fas fa-save fa-2x"></i>
                </div>
            </a>
        }


    </div>





}

<div class="modal fade" id="modal-unificarCliente">
    <div class="modal-dialog" style="max-width:60%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted">Unificar Cliente</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-2 ml-2">
                    <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.NOMEOUDOCUMENTO" autocomplete="off">
                    <i class="la la-search la-2x" style="color: #999"></i>
                </div>
                <div class="row">
                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="iStatusUnificar" autocomplete="off" class="">@RsCadastros.STATUS:</label>
                            <select id="iStatusUnificar" class="form-control">
                                <option value="">@RsBase.TODOS</option>
                                <option value="0">@RsCadastros.INATIVO</option>
                                <option value="1">@RsCadastros.ATIVO</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="iTipoCadastro" class="">@RsCadastros.TIPO_CADASTRO:</label>
                            <select id="iTipoCadastro" class="form-control">
                                <option value="">@RsBase.TODOS</option>
                                <option value="0">@RsCadastros.CLIENTE</option>
                                <option value="1">@RsCadastros.PROSPECTO</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="iTipoPessoa" class="">@RsCadastros.TIPOPESSOA:</label>
                            <select id="iTipoPessoa" class="form-control">
                                <option value="">@RsBase.TODOS</option>
                                <option value="0">@RsCadastros.FISICA</option>
                                <option value="1">@RsCadastros.JURIDICA</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-sm-4 text-right mt-4 pb-2 pr-5">
                        <input type="button" class="btn btn-outline-secondary" style="font-size:0.8rem" value="Carregar" id="btnFiltro" onclick="return carregarUnificarCliente()" />
                    </div>

                </div>

                <table class="table table-hover nowrap" id="datatableUnificar" style="width:100%">
                </table>

            </div>

            <div class="form-group col-sm-12" style="padding: 15px;">
                <div class="text-center">
                    <button type="button" class="btn btn-danger" onclick='$("#modal-unificarCliente").modal("toggle")'>@RsBase.CANCELAR</button>
                    <button type="button" class="btn btn-success" id="iUnificar">@RsCadastros.UNIFICAR</button>
                </div>
            </div>

        </div>




    </div><!-- /.modal-content -->
</div><!-- /.modal-dialog -->


<div class="modal" id="modal-filter">
    <div class="modal-dialog" style="max-width:60%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted" style="margin-left:auto;">Etapa Atual: <label style="color:red;"> @Model.EtapaAtual</label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div style="text-align: center">
                <label>
                    <p>
                        Lembre-se ao confirmar a próxima etapa,</br>
                        não tera como voltar a etapa anterior.
                    </p>
                </label>


                @if (Model.EtapaAtualDecisoria)
                {
                    <div class="row">
                        <div class="form-group" style="margin-left: auto; margin-right: auto;">
                            <label>Proxima Sequencia: </label>
                            @Html.DropDownListFor(m => m.ProximaEtapa, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iProxima_Etapa", @autocomplete = "off" })
                            @Html.ValidationMessageFor(model => model.ProximaEtapa, "", new { @class = "text-danger" })
                        </div>
                    </div>
                }
                else if (String.IsNullOrEmpty(Model.ProximaEtapa) == false)
                {
                    <h4 class="modal-title text-muted" style="margin-left:auto;">Proxima Etapa: <label style="color:red;"> @Model.ProximaEtapa</label></h4>
                }

            </div></br>

            <div class="text-center">
                <button type="button" onclick="EnviarEtapaDecisoria();" class="btn btn-success" id="btnConfimar" style="background-color:dodgerblue;">Confirmar</button>
            </div>


            @if (String.IsNullOrEmpty(Model.EtapaAtual) == false)
            { }
        </div>
    </div>

</div>


<div class="modal" id="modal-final">
    <div class="modal-dialog" style="max-width:60%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-muted" style="margin-left:auto;">Etapa Atual: <label style="color:red;"> @Model.EtapaAtual</label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div style="text-align: center">


                @if (Model.Encerrar_Atendimento == false)
                {
                    <label>
                        <p>
                            Atenção! Etapa configurada para encerrar o atendimento automaticamente.

                        </p>
                    </label>
                }

            </div>
            <div class="text-center">

                <button type="button" class="btn btn-success" data-dismiss="modal" aria-label="Close" id="iLimparFiltroModal"> Confirmar </button>

              </div>




        </div>




    </div><!-- /.modal-content -->
</div><!-- /.modal-dialog -->

<div class="modal fade" id="iModal_Motivo_Cancelamento" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-center mx-auto" id="exampleModalLongTitle">Informe o motivo do cancelamento</h4>
            </div>
            <div class="modal-body">
                <div class="form-group mx-auto">
                    <select class="form-control obrigatorioCancelar" id="iMotivo_Cancelamento" autocomplete="off" required="required">
                        <option value="">@RsBase.SELECIONE</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success mx-auto" id="btnMotivoCancelamento">Gravar</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="iModal_EnviarPesquisaSatisfacao" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-center mx-auto" id="exampleModalLongTitle">Informe a Pesquisa que deseja enviar</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group mx-auto">
                    <select class="form-control obrigatorioPesquisa" id="iPesquisaSatisfacao" autocomplete="off" required="required">
                        <option value="">@RsBase.SELECIONE</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success mx-auto" onclick="EnviarPesquisa()" id="btnEnviarPesquisa">Enviar</button>
            </div>
        </div>
    </div>
</div>
<div id="divHistoricoConsumo"></div>
