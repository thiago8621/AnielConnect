    async function finalizarAtendimento() {

        var BuscarOs = '@String.Concat(CONSTANTES.URLPortal, "/api/Documento_ProducaoApi/BuscarPorAtendimentotrava?AtendimentoId=")' + @Model.Id;
        let travadoPorOs = await $.ajax({
            url: BuscarOs,
            type: 'POST',
            dataType: 'json',
            beforeSend: function () {
                ShowPageLoading();
            },
            complete: function () {
                HidePageLoading();
            }

        });

        if (travadoPorOs == false) {
            var result = await Swal.fire({
                title: 'Concluir Chat',
                text: "Desejar concluir o atendimento junto ao término do atendimento por chat?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: '@Html.Raw(RsBase.SIM)',
                cancelButtonText: '@Html.Raw(RsBase.NAO)'
            })

            if (result.dismiss != "backdrop") {

                if (result.value) {
                    Swal.fire({
                        title: 'Selecione um motivo para conclusão:',
                        html: '<select class="swal2-input" type="text" id="iDescMotivo" autocomplete="off">',
                        showCancelButton: false,
                        onOpen: function () {
                            AddSelect("iDescMotivo", "@CONSTANTES.URLPortal/api/motivo_status_atendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, 4, null, "@RsBase.SELECIONE", false);
                        },
                        confirmButtonText: 'Ok',
                        type: 'question',
                        allowOutsideClick: () => !Swal.isLoading(),
                    }).then(async (input) => {
                        if (input.value && $('#iDescMotivo').val()) {
                            ShowPageLoading();
                            await parent.chat.server.finalizarAtendimento('@Model.Numero', true, '@User.Identity.GetUserId()', $('#iDescMotivo').val());

                            //verifica se possui OS a ser criada
                            if (criar_Os_Encerrar == true && travadoPorOs == false) {
                                Swal.fire({
                                    text: "Deseja criar OS?",
                                    type: 'question',
                                    showCancelButton: true,
                                    confirmButtonColor: '#3085d6',
                                    cancelButtonColor: '#d33',
                                    confirmButtonText: 'Sim',
                                    cancelButtonText: 'Não'
                                }).then((result) => {

                                    var link = '';

                                    if (result.value) {

                                        if ($("#iTipoAtendimento option:selected").val() == "") {
                                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.TIPO_ATENDIMENTO)", "warning");
                                            erro = true;
                                        }

                                        document.getElementById("iCriar_Os_Encerrar_Parametro_Controller").value = true;
                                        $('#iStatusAtendimento').val(4);
                                        $('#iDescMotivoStatus').val($('#iDescMotivo').val());
                                        $('#iHiddenMotivo').val($('#iDescMotivo').val());



                                        ValidaSubmit();

                                    } else {
                                        var clicked = false;

                                        if ($("#iTipoAtendimento option:selected").val() == "") {
                                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.TIPO_ATENDIMENTO)", "warning");
                                            erro = true;
                                        }
                                        if ($("#iOrigem").val() == null) {
                                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.TIPO_ATENDIMENTO)", "warning");
                                            erro = true;
                                        }

                                        document.getElementById("iCriar_Os_Encerrar_Parametro_Controller").value = false;
                                        $('#iStatusAtendimento').val(4);
                                        $('#iDescMotivoStatus').val($('#iDescMotivo').val());
                                        $('#iHiddenMotivo').val($('#iDescMotivo').val());

                                        ValidaSubmit();
                                    }
                                })
                            }

                            else {
                                ValidaSubmit();
                            }
                        }
                        else if (input.value && !$('#iDescMotivo').val()) {
                            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MOTIVO_STATUS_ATENDIMENTO)", "warning");
                        }
                    });

                }
                else {
                    ShowPageLoading();
                    await parent.chat.server.finalizarAtendimento('@Model.Numero', false, '@User.Identity.GetUserId()', null);
                    window.location.reload();
                }

            }
        }
        else {
            await parent.chat.server.finalizarAtendimento('@Model.Numero', false, '@User.Identity.GetUserId()', null);
            window.location.reload();
        }



    }




    listaPromisesReady = [];
    @if (Model.Id != 0) {
        <text>listaPromisesReady.push(atualizarHistoricoAtividades())</text>
    }



    @if (Model.ScriptAtendimento) {
        <text>
        $(`#iNavScript`).show();
        </text>
    }
    $(document).ready(async function () {



        $(window).resize(function () {
            $("#Chat").css({
                height: $(window).height() - $(window).height() / 6
            });
        });

            @if (ViewBag.ChatAtivo)
            {
                <text>$('#divProgressChat').show();</text>
                if (ViewBag.ChatSuporte == User.Identity.GetUserId())
                {
                <text>
        parent.chat.server.entrarChatAtendimento('@Model.Numero', "@User.Identity.GetUserId()", parent.chat.connection.id);
        parent.chat.client.mensagemResposta = (mensagem) => {
            if (!mensagem.enviadoPeloSuporte) {
                $('#chatFrame').contentWindow.renderMessage(mensagem.mensagem, mensagem.dataHora, mensagem.usuario, false, false, mensagem.arquivos)
            }



        }


        var mensagens_string = parent.getChatMessages('@Model.Numero');
        listaPromisesReady.push(mensagens_string);
        mensagens_string.then(function (mensagensString) {
            var mensagens = Boolean(mensagensString) ? JSON.parse(mensagensString) : [];



            $('#chatFrame').on('load', function () {

                $('#divProgressChat').fadeOut();
                for (message of mensagens) {
                    renderMessage(message.mensagem, message.dataHora, message.usuario, message.enviadoPeloSuporte ? true : false, message.fluxoChat, message.arquivos);
                }

                animateMessageScroll();

            });


            $("#chatFrame").attr("src", "@Url.Action("Chat_iFrame", "Atendimento")");


            $("#Chat").css({
                height: $(window).height() - $(window).height() / 6
            });
        });


                </text>
                }
                else if (ViewBag.ChatSuporte == null) {
                    <text>
        if (parent.chat) {
            Swal.fire({
                title: "Assumir Chat?",
                text: "Há um cliente aguardando atendimento! Deseja assumir o atendimento?",
                type: 'question',
                showCancelButton: true,
                cancelButtonText: 'Não',
                confirmButtonText: 'Sim',
                allowOutsideClick: false
            }).then(async (result) => {
                if (result.value) {
                    await TransferirAtendimentoChat("@User.Identity.GetUserId()")
                    parent.chat.client.mensagemResposta = (mensagem) => {
                        if (!mensagem.enviadoPeloSuporte) {
                            $('#chatFrame').contentWindow.renderMessage(mensagem.mensagem, mensagem.dataHora, mensagem.usuario, false, false, message.arquivos)
                        }
                    }
                    var mensagens_string = await parent.getChatMessages('@Model.Numero')
                    var mensagens = Boolean(mensagens_string) ? JSON.parse(mensagens_string) : [];

                    $('#chatFrame').on('load', function () {
                        $('#divProgressChat').fadeOut();
                        for (message of mensagens) {
                            renderMessage(message.mensagem, message.dataHora, message.usuario, message.enviadoPeloSuporte ? true : false, message.fluxoChat, message.arquivos);
                        }
                    });


                    $("#chatFrame").attr("src", "@Url.Action("Chat_iFrame", "Atendimento")");

                    $("#Chat").css({
                        height: $(window).height() - $(window).height() / 6
                    });
                }
                else {


                    window.location = "@Url.Action("Listagem_Atendimento", "Atendimento")";
                }
            });
        }
        else {
            Swal.fire({
                title: "Atendimento aguardando atendente para chat",
                text: "Usuário logado não esta configurado para atender por chat.",
                type: 'question',
                allowOutsideClick: false
            }).then(() => {
                window.location = "@Url.Action("Listagem_Atendimento", "Atendimento")";
            });
        }
                    </text>
                }
                else {
                    <text>
        Swal.fire({
            title: "Chat em Progresso",
            text: "Atendimento se encontra em chat com outro usuario.",
            type: 'question',
            allowOutsideClick: false
        }).then(() => {
            window.location = "@Url.Action("Listagem_Atendimento", "Atendimento")";
        });
                    </text>
                }
            }


        if (@Json.Encode(ViewBag.MensagemReabrirOsOuCancelarAtd == "S")) {


            Swal.fire({
                //text: "Reabrir OS ou Cancelar Atendimento ?",
                title: "Não é permitido concluir este atendimento. Por favor abrir uma nova Ordem de Serviço ou Cancelar o atendimento. ",
                text: "Não é permitido concluir este atendimento. Por favor abrir uma nova Ordem de Serviço ou Cancelar o atendimento. ",
                type: 'question',
                html: "<div class='text-center'><button id='btnConfirm' class='swal2-confirm swal2-styled'> Reabrir OS </button>" +
                    "<button id='btnCancel' class='swal2-cancel swal2-styled' style='background-color: #d33;'> Cancelar Atendimento </button> </div>",
                showConfirmButton: false
                //showCancelButton: true,
                //confirmButtonColor: '#3085d6',
                //cancelButtonColor: '#d33',
                //confirmButtonText: 'Reabrir OS',
                //cancelButtonText: 'Cancelar Atendimento'

            })

            $("#btnConfirm").on("click", function () {

                var url = '@Html.Raw(@Url.Action("Criar_Ordem_Servico", "Painel_Servicos", new { Id_Atendimento = Model.Id }))';

                window.open(url, "_self");

                Swal.close();
            })

            $("#btnCancel").on("click", function () {

                //
                Swal.fire({
                    title: 'Selecione um motivo para o cancelamento:',
                    html: '<select class="swal2-input" type="text" id="iDescMotivoCancelar" autocomplete="off">',
                    showCancelButton: true,
                    onOpen: function () {
                        AddSelect("iDescMotivoCancelar", "@CONSTANTES.URLPortal/api/motivo_status_atendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, 3, null, "@RsBase.SELECIONE", false);
                    },
                    cancelButtonText: 'Não',
                    confirmButtonText: 'Sim',
                    type: 'question',
                    allowOutsideClick: () => !Swal.isLoading(),
                }).then(input => {
                    if (input.value && $('#iDescMotivoCancelar').val()) {

                        var motivo = $("#iDescMotivoCancelar").val();
                        var link = "@(CONSTANTES.URLPortal + "/api/atendimentoapi/CancelarAtendimento")" + "?id_atendimento=@Model.Id" + "&id_motivo_status=" + motivo + "";
                        var retorno = null;

                        $.getJSON(link, function (data) {

                            //return retorno = data;
                        })

                        //Swal.close();

                        //Modal Sucesso
                        Swal.fire({

                            title: "Atendimento cancelado com sucesso. ",

                            type: 'success',

                            showConfirmButton: true


                        }).then(input => {
                            var _id = @Model.Id;

                            var url = '@Url.Action("Cadastro", "Atendimento", new { id = "__id__" })';
                            window.location.href = url.replace('__id__', _id);
                        });

                        //Swal.fire({
                        //title: 'Atendimento cancelado com sucesso',
                        //type: 'success',
                        //});
                        //Swal.close();
                        //



                    }
                    else if (input.value && !$('#iDescMotivoCancelar').val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MOTIVO_STATUS_ATENDIMENTO)", "warning");
                    }
                });
                //



            })


        }
        else if (@Json.Encode(ViewBag.MensagemReabrirOsOuCancelarAtd == "N")) {


            //Notificar("@RsBase.INFORMACAO", " Atendimento só poderá ser concluido se a OS vinculada estiver fechada. ", "info")
            Swal.fire({
                title: " Atendimento só poderá ser concluido se a OS vinculada estiver fechada. ",
                type: 'info',
            }).then(result => {
                var _id = @Model.Id;

                var url = '@Url.Action("Cadastro", "Atendimento", new { id = "__id__" })';
                window.location.href = url.replace('__id__', _id);
                return false;
            })


        }

        $('#iStatusAtendimento option').each(function () {

            @if (Model.Id == 0) {
            <text>
            if ($(this).val() == 0)
                $(this).remove();
             </text>
            }
        });






        if (disabled) {
            $("#iHiddenMotivo").prop('disabled', false);
        }
        else {
            $("#iHiddenMotivo").prop('disabled', true);
        }


        listaPromisesReady.push(AddSelect("iTipoAtendimento", "@CONSTANTES.URLPortal/api/Tipo_Atendimentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Tipo_Atendimento", "@RsBase.SELECIONE", disabled, HandleTipo_Atendimento));

        if (!"@Model.Numero") {

            $("#iStatusAtendimento").val("5");

            let departamentoFunc = async () => {
                await AddSelect("iDepartamento", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@ViewBag.Departamento_Usuario", "@RsBase.SELECIONE", disabled);
                await AddSelect("iResponsavel", "@CONSTANTES.URLPortal/api/Identity_UserApi/GetComboUserId", @CONSTANTES.PaginacaoRegistros, null, "@ViewBag.Departamento_Usuario", "@User.Identity.GetUserId()", "@RsBase.SELECIONE", disabled);
            }

            listaPromisesReady.push(departamentoFunc());
        }
        else {

            let departamentoFunc = async () => {
                await AddSelect("iDepartamento", "@CONSTANTES.URLPortal/api/DepartamentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Setor", "@RsBase.SELECIONE", disabled, HandleDepartamento);
                await AddSelect("iResponsavel", "@CONSTANTES.URLPortal/api/Identity_UserApi/GetComboUserId", @CONSTANTES.PaginacaoRegistros, null, "@Model.Id_Setor", "@Model.Id_Responsavel", "@RsBase.SELECIONE", disabled);
            }

            listaPromisesReady.push(departamentoFunc());

        };

        $("#iStatusAtendimento").trigger("change");
        $("#iResponsavel").trigger("change");
        $("#iRdOutros").trigger("change");
        listaPromisesReady.push(AddSelect("iOrigem", "@CONSTANTES.URLPortal/api/Origemapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Origem_Atendimento", "@RsBase.SELECIONE", disabled));

        AddSelect("iProxima_Etapa", "@CONSTANTES.URLPortal/api/FluxoAtendimentoApi/GetComboEtapa", @CONSTANTES.PaginacaoRegistros, '@Model.Id_Tipo_Atendimento','@Model.ProximaEtapa', null, "@RsBase.SELECIONE", false);

        if (@Model.Id == 0) {

            let clienteFunc = async () => {
                await AddSelect("iCliente", "@CONSTANTES.URLPortal/api/clienteapi/GetComboCPFAtendimento", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Cliente", "@RsBase.SELECIONE", disabled, HandleCliente);
                await AddSelect("iClientePlanoProduto", "@CONSTANTES.URLPortal/api/clienteapi/GetComboClientePlanoProduto", @CONSTANTES.PaginacaoRegistros, null, "@Model.Id_Cliente", "@Model.Id_Cliente_Plano_Produto", "@RsBase.SELECIONE", disabled, HandleClientePlanoProduto);
                await AddSelect("iTipoAtendimento", "@CONSTANTES.URLPortal/api/Tipo_Atendimentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Tipo_Atendimento", "@RsBase.SELECIONE", disabled, HandleTipo_Atendimento);

            }

            listaPromisesReady.push(clienteFunc());
        }
        else {

            let clienteFunc = async () => {
                await AddSelect("iCliente", "@CONSTANTES.URLPortal/api/clienteapi/GetComboCPFAtendimento", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Cliente", "@RsBase.SELECIONE", false, HandleCliente);
                await AddSelect("iClientePlanoProduto", "@CONSTANTES.URLPortal/api/clienteapi/GetComboClientePlanoProduto", @CONSTANTES.PaginacaoRegistros, null, "@Model.Id_Cliente", "@Model.Id_Cliente_Plano_Produto", "@RsBase.SELECIONE", disabled, HandleClientePlanoProduto);
                await AddSelect("iTipoAtendimento", "@CONSTANTES.URLPortal/api/Tipo_Atendimentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Tipo_Atendimento", "@RsBase.SELECIONE", false, HandleTipo_Atendimento);
            }

            listaPromisesReady.push(clienteFunc());
        }



        var categoriaBloq = @Json.Encode(CamposObrigatoriosAtendimentoApiController.CampoBloqueado(campos, CamposObrigatoriosAtendimentoEnum.CATEGORIA_ATENDIMENTO));
        listaPromisesReady.push(AddSelect("iCategoriaAtendimento", "@CONSTANTES.URLPortal/api/categoria_atendimentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Categoria_Atendimento", "@RsBase.SELECIONE", disabled || categoriaBloq));


        @if (Request.Params["os_criada"] == "true")
        {
         <text>
        Notificar("@RsBase.INFORMACAO", "Os criada com sucesso", "info")
        </text>
        }

        @if (Request.Params["Sucesso"] == "S")
        {
         <text>
        Notificar("@RsBase.INFORMACAO", "@RsCadastros.DADOS_GRAVADOS_SUCESSO", "info")
        </text>
        }

        if (disabled) {
            listaPromisesReady.push(AddSelect("iDescMotivoStatus", "@CONSTANTES.URLPortal/api/motivo_status_atendimentoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, $("#iStatusAtendimento").val(), "@Model.Id_Motivo_Status", "@RsBase.SELECIONE", disabled));
            $("#iAssuntoAtendimento").addClass("readonly");
            $("#iStatusAtendimento").addClass("readonly");
            $("#labelPrioridadeAlta").addClass("readonly");
            $("#labelPrioridadeMedia").addClass("readonly");
            $("#labelPrioridadeBaixa").addClass("readonly");
            $("#iExplicacao_Cliente").addClass("readonly");
            $("#iExplicacao_Cliente").addClass("readonly");
            $("#iPessoa_Contato").addClass("readonly");
            $("#iGrauLigacao").addClass("readonly");
            $("#iPrioridade_Atendimento").addClass("readonly");

            DisableSelect("iTipoAtendimento");
            DisableSelect("iCategoriaAtendimento");
            DisableSelect("iDescMotivoStatus");
            DisableSelect("iOrigem");
            DisableSelect("iDepartamento");
            DisableSelect("iResponsavel");

            $("#iRdOutros").click(function () {
                return false;
            });

            $("#iRdTitular").click(function () {
                return false;
            });

                @Json.Encode(Model.Prioridade != Prioridade_Atendimento.Alto)   ?$('#labelPrioridadeAlta').addClass('prioridade-label-inactive')  : "";
                @Json.Encode(Model.Prioridade != Prioridade_Atendimento.Medio)  ?$('#labelPrioridadeMedia').addClass('prioridade-label-inactive') : "";
                @Json.Encode(Model.Prioridade != Prioridade_Atendimento.Baixo)  ?$('#labelPrioridadeBaixa').addClass('prioridade-label-inactive') : "";
        }
        else {
            var categoriaBloq = @Json.Encode(CamposObrigatoriosAtendimentoApiController.CampoBloqueado(campos, CamposObrigatoriosAtendimentoEnum.CATEGORIA_ATENDIMENTO));
            if (categoriaBloq) DisableSelect("iCategoriaAtendimento");

            var origemBloq = @Json.Encode(CamposObrigatoriosAtendimentoApiController.CampoBloqueado(campos, CamposObrigatoriosAtendimentoEnum.ORIGEM));
            if (origemBloq) DisableSelect("iOrigem");
        }




        @*$("#iGrau_LigacaoHidden").val(@Html.Raw(Json.Encode(Model.Grau_Ligacao)));*@

        $("#iGrauLigacao").each(function () {
            // Add $(this).val() to your list
            //$('#iGrau_LigacaoHidden option[value=]').attr('selected','selected');
            //$("iGrauLigacao select").val("val2");
            //if ($(this).val() == $("#iGrau_LigacaoHidden").val()) {
            //    $("#iGrau_LigacaoHidden").attr('selected', 'selected');
            //}
        });

        var id = parseInt($("#iId").val());
        //var id = $("#iId"").val();

        if (id > 0) {
            $("#iAcao").attr("disabled", "disabled");
        }
        else if (id == 0) {
            $("#iAcao").attr("disabled", false);
        }

        $("#iRdOutros").trigger("change");
        $("#iRdTitular").trigger("change");
        $(".readonly").attr("tabindex", "-1");


        if ($("#iGrupoArea").val()) {
            $("#iGrupoArea").trigger('change');
        }

        var True = true;
        var False = false;

        @if (Model.Id != 0)
        {
         <text>
            if (!@ViewBag.ChatAtivo) {

                if (!(@Json.Encode(AcessoHelper.TemAcesso(_areas, "204"))
                    || ("@User.Identity.GetUserId()" == "@Model.Id_Responsavel")
                    || ("@Model.Id_Responsavel" == "")
                    || ($("#iStatusAtendimento").val() == '3')
                    || ($("#iStatusAtendimento").val() == '4'))){


                    $("#iAssuntoAtendimento").addClass("readonly");
                    $("#iStatusAtendimento").addClass("readonly");
                    $("#labelPrioridadeAlta").addClass("readonly");
                    $("#labelPrioridadeMedia").addClass("readonly");
                    $("#labelPrioridadeBaixa").addClass("readonly");
                    $("#iExplicacao_Cliente").addClass("readonly");
                    $("#iExplicacao_Cliente").addClass("readonly");
                    $("#iPessoa_Contato").addClass("readonly");
                    $("#iGrauLigacao").addClass("readonly");
                    $("#iPrioridade_Atendimento").addClass("readonly");

                    $("#iResponsavel").addClass("readonly");
                    $("#iResponsavel").prop('disabled', true);
                    $("#iClientePlanoProduto").addClass("readonly");
                    $("#iClientePlanoProduto").prop('disabled', true);

                    DisableSelect("iTipoAtendimento");
                    DisableSelect("iCategoriaAtendimento");
                    DisableSelect("iDescMotivoStatus");
                    DisableSelect("iOrigem");
                    DisableSelect("iDepartamento");
                    DisableSelect("iResponsavel");

                    $("#iRdOutros").click(function () {
                        return false;
                    });

                    $("#iRdTitular").click(function () {
                        return false;
                    });

                    @Json.Encode(Model.Prioridade != Prioridade_Atendimento.Alto)   ?$('#labelPrioridadeAlta').addClass('prioridade-label-inactive')  : "";
                    @Json.Encode(Model.Prioridade != Prioridade_Atendimento.Medio)  ?$('#labelPrioridadeMedia').addClass('prioridade-label-inactive') : "";
                    @Json.Encode(Model.Prioridade != Prioridade_Atendimento.Baixo)  ?$('#labelPrioridadeBaixa').addClass('prioridade-label-inactive') : "";

                    Swal.fire({
                        title: "Atendimento em Progresso",
                        text: "Atendimento se encontra com outro usuario.",
                        type: 'question',
                        allowOutsideClick: false
                    }).then(() => {
                        window.location = "@Url.Action("Listagem_Atendimento", "Atendimento")";
                    });
                }
        }

            if (disabled == false) {
                Promise.all(listaPromisesReady).then((values) => {

                    //BLOQUEIA O CLIENTE EM CASO DE JÁ SELECIONADO/PREENCHIDO/ATRIBUÍDO
                        @if (Model.Id != 0 && Model.Id_Cliente_Plano_Produto != null)
                        {
                        <text>
                    DisableSelect("iClientePlanoProduto");
                    DisableSelect("iCliente");
                        </text>
                        }
                        else if (Model.Id != 0 && Model.Id_Cliente != null)
                        {
                        <text>
                    DisableSelect("iCliente");
                        </text>
                        }

                    getAvisoImportante();

                    //Teste


                    $('#iResponsavel').change(async function () {
                        var iResponsavel = $('#iResponsavel').val();
                        if ("@User.Identity.GetUserId()" != iResponsavel) {
                            transferirBarra();
                        }
                    })

                    $(`#iDescMotivoStatus,#iStatusAtendimento,#iDepartamento,#iOrigem,#iPrioridade_Atendimento,#iCategoriaAtendimento,#iTipoAtendimento,#iAssuntoAtendimento,#iRdTitular,#iRdOutros,#iPessoa_Contato,#iGrauLigacao`).change(async function () {
                        SweetAlertOs();
                    })
                });
            }
            else {
                //BLOQUEIA O CLIENTE EM CASO DE JÁ SELECIONADO/PREENCHIDO/ATRIBUÍDO
                @if (Model.Id != 0 && Model.Id_Cliente_Plano_Produto != null)
                {
                <text>
                DisableSelect("iClientePlanoProduto");
                DisableSelect("iCliente");
                </text>
                }
                else if (Model.Id != 0 && Model.Id_Cliente != null)
                {
                <text>
                DisableSelect("iCliente");
                </text>
                }
            }
        </text>
        }


    });

    $("#iRdOutros").change(function () {
        if ($("#iRdOutros").is(':checked')) {
            $('#iLblPessoa_Contato').show();
            $('#iLblGrau_Ligacao').show();
            $('#iPessoa_Contato').show();
            $('#iGrauLigacao').show();
        }
        else {
            $('#iLblPessoa_Contato').hide();
            $('#iLblGrau_Ligacao').hide();
            $('#iPessoa_Contato').hide();
            $('#iGrauLigacao').hide();
        }
    });

    $("#iRdTitular").change(function () {
        if ($("#iRdTitular").is(':checked')) {
            $('#iLblPessoa_Contato').hide();
            $('#iLblGrau_Ligacao').hide();
            $('#iPessoa_Contato').hide();
            $('#iGrauLigacao').hide();
        }
        else {
            $('#iLblPessoa_Contato').show();
            $('#iLblGrau_Ligacao').show();
            $('#iPessoa_Contato').show();
            $('#iGrauLigacao').show();
        }
    });



        function swalReabrirAtendimento(idAtendimento) {
            Swal.fire({
            text: "Deseja Reabrir esse Atendimento?",
                type: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não'
            }).then((result) => {

                var link = '';

                if (result.value) {

                    ReabrirAtendimento(idAtendimento)

                }

            });
    }

    function transferirBarra() {
        if (@Model.Id != 0) {
            TransferirAtendimentoChat();
        } else {
            SweetAlertOs();
        }
    }

    // Reabrir Atendimento
        function ReabrirAtendimento(idAtendimento) {

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoapi/ReabrirAtendimento")'


            @*@if (Json.Encode(!AcessoHelper.TemAcesso(_areas, "150")))*@
            if (!@Json.Encode(AcessoHelper.TemAcesso(_areas, "150")))
            {
                //<text>
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.USUARIO_SEMACESSO_150, "150")", "warning");
                return false;
                //</text>
            }
            else {
                $.ajax({
                    url: link,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        ids: [idAtendimento],
                        usuario: "@User.Identity.GetUserId()"

                        //status: Status
                    }
                })
                    .done(function (data) {

                        if (data.ok) {
                            Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                            ShowPageLoading();
                            location.reload();
                            //oDatatable.draw();
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    });
            }




        }

            function LimpaControles() {
                $("#idCliente").val(null);
                $("#iCpfCliente").val(null);
                $("#iCpf").html(null);
                $("#iCategoria_Cliente").html(null);
                $("#iTelefone_Fixo").html(null);
                $("#iiDias").html(null);
                $("#iCelular").html(null);
                $("#iTelefone_Recado").html(null);
                $("#iEmail_Principal").html(null);
                $("#iForma_Pagamento_Utilizada").html(null);
                $("#iLogin_Radius").html(null);
                $("#iLogin_Rad").html(null);
                $("#iEndereco_Instalacao").html(null);
                $("#iValor_Final_Total").html(null);
                $("#iEndereco").html(null);
                $('#iPlano_Produto').empty();
            }



            $('#iClientePlanoProduto').change(function () {

                var id = $(this).val()

                if (@Model.Id == 0) {
                    getPlanoProduto(id);
                }

                $('#iCliente_Plano_Produto').val($('#iPlano_Produto').val())

            });


        $(document).on('click', '.removerAtividade', function () {

            let atividade = $(this).attr('atividade');


            if (atividade == $('#btnInserirAtividade').attr('editar')) {
                Notificar("@RsBase.ATENCAO_", "Atividade está em processo de edição", "warning");
                return false;
            }


            $(`#atividadeAdicionada${atividade}`).fadeOut(150, function () {
                $(this).remove();

                $(`.atividadeAdicionar${atividade}`).remove();
                $('.ordemAtividade').each((i, value) => {
                    $(value).html(`${$('.ordemAtividade').length - i}`);
                });

                Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");

            })
        });

        $(document).on('click', '.editarAtividade', function () {

            let atividade = $(this).attr('atividade');
            Swal.fire({
                title: 'Você está tentando editar uma atividade, deseja continuar?',
                showCancelButton: true,
                confirmButtonText: `@RsBase.SIM`,
                cancelButtonText: `@RsBase.NAO`,
            }).then((result) => {

                if (result.value) {
                    tinyMCE.activeEditor.setContent($(`#atividadeConteudo${atividade}`).html());
                    filter_state = {};
                    TagFilter("tagFiles", filter_state);
                    $('#TagLabel').hide();

                    $(`input[type="file"][atividade=${atividade}]`).each(function (i, obj) {
                        if (obj.files.length > 0) {
                            filter_state[obj.files[0].name + i] = {
                                label: "",
                                removable: true,
                                getDisplay: () => { return obj.files[0].name },
                                onclick: () => {
                                    obj.remove();
                                }
                            }
                            $('#TagLabel').show();
                        }
                    });

                    TagFilter("tagFiles", filter_state);

                    $('#btnInserirAtividade').val("@RsCadastros.EDITAR_ATIVIDADE");
                    $('#btnInserirAtividade').attr('editar', atividade);
                    tinyMCE.activeEditor.focus();
                }

            })
        });




        var clicked = false;

    async function SweetAlertOs() {



        let result = @Model.Id == 0 ? await Swal.fire({
            title: 'Cadastrar Atendimento?',
            showCancelButton: true,
            cancelButtonText: 'Não',
            confirmButtonText: 'Sim',
            type: 'question',
            allowOutsideClick: () => !Swal.isLoading(),
        }) : { value: true };

        if (result.value) {

            /* $.getJSON(enderecoApi, function (data) {*/


            //$("#iNumeroAtendimentoHtml").html(data.idObjeto);
            //$("#iProtocoloHtml").html(data.idObjeto);
            //$("#iNumeroAtendimento").val(data.idObjeto);
            //$("#iProtocolo").val(data.idObjeto);







            if (clicked)
                return;


            clicked = true;
            var erro = false;
            var _id_atendimento = parseInt($("#iId").val());
            var _id_plano_produto = parseInt($("#iClientePlanoProduto").val());

            var BuscarOs = '@String.Concat(CONSTANTES.URLPortal, "/api/Documento_ProducaoApi/BuscarPorAtendimentotrava?AtendimentoId=")' + @Model.Id;
            var Os_atend_criada_link = '@String.Concat(CONSTANTES.URLPortal, "/api/Documento_ProducaoApi/Os_Criada_Atendimento?AtendimentoId=")' + @Model.Id;
            var Os_atend_criada_qtde = 0;

            await $.ajax({
                url: Os_atend_criada_link,
                type: 'GET',
                dataType: 'json',

            }).done(function (data) {

                if (data != 0) {
                    Os_atend_criada_qtde = data;
                }
            });

            if (['2', '3', '4'].includes($("#iStatusAtendimento").val()) && !$('#iDescMotivoStatus').val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.MOTIVO_STATUS_ATENDIMENTO)", "warning");
                erro = true;
            }

            if (!$('#iTipoAtendimento').val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.TIPO_ATENDIMENTO)", "warning");
                erro = true;
            }

            if (!$('#iOrigem').val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ORIGEM)", "warning");
                erro = true;
            }

            if (!$('#iCliente').val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CLIENTE)", "warning");
                erro = true;
            }

            if (!$('#iDepartamento').val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.SETOR)", "warning");
                erro = true;
            }

            @if (ViewBag.ChatAtivo == false)
            {
            <text>
                if ($('.classeAdicionados').length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ATIVIDADE)", "warning");
                    erro = true;
                }
                if (!$('#iAssuntoAtendimento').val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ASSUNTO)", "warning");
                    erro = true;
                }
            </text>
            }

                      @if (Model.Id == 0)
                      {
                <text>
            if (!$('#iResponsavel').val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.RESPONSAVEL)", "warning");
                erro = true;
            }
                </text>
                      }

            if ($("#iRdOutros").is(':checked')) {

                if (!$('#iPessoa_Contato').val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.PESSOA_QUE_ENTROU_EM_CONTATO)", "warning");
                    erro = true;
                }

                if (!$('#iGrauLigacao').val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.GRAU_DE_INSTRUCAO)", "warning");
                    erro = true;
                }

            }



                      @if (Model.Id == 0) {
             <text>
            if (!$("#iClientePlanoProduto").val() && $("#iTipoCliente").val() == 0) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsCadastros.PLANO_PRODUTO)", "warning");
                erro = true;
            }
             </text>


             }

            if ($('#iLocalidadeInstalacao').text() != 'Selecione') {

            }

            if (erro) {
                clicked = false;
                erro = false;
                return false;
            }


            $.ajax({
                url: BuscarOs,
                type: 'POST',
                dataType: 'json',

            }).done(function (data) {


                if (criar_Os_Encerrar == true && $('#iStatusAtendimento').val() == @Convert.ToInt32(Status_Atendimento.Concluido) && Os_atend_criada_qtde == 0) {
                    Swal.fire({
                        text: "Deseja Criar OS?",
                        type: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Sim',
                        cancelButtonText: 'Não'
                    }).then((result) => {

                        var link = '';

                        if (result.value) {

                            if ($("#iTipoAtendimento option:selected").val() == "") {
                                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.TIPO_ATENDIMENTO)", "warning");
                                erro = true;
                            }


                            document.getElementById("iCriar_Os_Encerrar_Parametro_Controller").value = true;

                            ValidaSubmit();

                        }
                        else {
                            var clicked = false;

                            if ($("#iTipoAtendimento option:selected").val() == "") {
                                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.TIPO_ATENDIMENTO)", "warning");
                                erro = true;
                            }
                            if ($("#iOrigem").val() == null) {
                                Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.TIPO_ATENDIMENTO)", "warning");
                                erro = true;
                            }

                            document.getElementById("iCriar_Os_Encerrar_Parametro_Controller").value = false;
                            ValidaSubmit();
                        }
                    })
                }

                else {
                    ValidaSubmit();
                }


            });
        }
        else {
            LimpaControles();
        }
    }

    async function ValidaSubmit() {
        var erro = false;
        var _id_atendimento = parseInt($("#iId").val());
        var _id_plano_produto = parseInt($("#Id_Plano_Produto").val());
        var BuscarOs = '@String.Concat(CONSTANTES.URLPortal, "/api/Documento_ProducaoApi/BuscarPorAtendimentotrava?AtendimentoId=")' + @Model.Id;

        erro = false;

        if ($('#iStatusAtendimento').val() == @Convert.ToInt32(Status_Atendimento.Concluido) ||
            $('#iStatusAtendimento').val() == @Convert.ToInt32(Status_Atendimento.Cancelado)) {

            $.ajax({
                url: BuscarOs,
                type: 'POST',
                dataType: 'json',

            }).done(function (data) {

                if (data) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.ATENDIMENTO_TRAVADO)", "warning");
                    erro = true;
                }

                if (erro) {
                    clicked = false;
                    return false;
                }

                ShowPageLoading();
                $('#form').submit();
                return true;

            })
        }

        else {


            if (erro) {
                clicked = false;
                return false;
            }

              @if (Model.Id == 0)
              {
                    <text>
            if (dados_parametros_cliente_selecionado) {
                var _mensagem = 'Foi gerado o número de protocolo #' + $("#iNumeroAtendimento").val() + '. Favor informá-lo ao';
                _mensagem += dados_parametros_cliente_selecionado.tipo_Cliente == 0 ? ' cliente' : ' prospect' + ' .';

                Swal.fire({
                    title: _mensagem,
                    type: 'success',
                });
            }
            ShowPageLoading();
            $('#form').submit();
            return true;
                    </text>
              }
              else
              {
                        <text>


            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoapi/Gravar")';

            await $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    Objeto: {
                        Id_Cliente: $("#iCliente").val(),
                        Id: @Model.Id,
                        Id_Cliente_Plano_Produto: "@Model.Id_Cliente_Plano_Produto",
                        Id_Motivo_Status: $('#iDescMotivoStatus').val(),
                        Status_Atendimento: $('#iStatusAtendimento').val(),
                        Id_Responsavel: $('#iResponsavel').val(),
                        Id_Setor: $('#iDepartamento').val(),
                        Id_Origem_Atendimento: $('#iOrigem').val(),
                        Prioridade: $('#iPrioridade_Atendimento').val(),
                        Id_Categoria_Atendimento: $('#iCategoriaAtendimento').val(),
                        Id_Tipo_Atendimento: $('#iTipoAtendimento').val(),
                        Assunto: $('#iAssuntoAtendimento').val(),
                        Tipo_Pessoa_Contato: $("#iRdTitular").is(':checked') ? 0 : 1,
                        Pessoa_Contato: $('#iPessoa_Contato').val(),
                        Grau_Ligacao: $('#iGrauLigacao').val(),
                        //Numero: $("#iNumeroAtendimento").val(),
                        Protocolo: "@Model.Numero",

                    },
                    Usuario: "@User.Identity.GetUserId()",
                    NomeUsuario: Id_Responsavel_nome,
                }
            })
                .done(function (data) {

                    if (data.ok) {
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                        ShowPageLoading();

                        if ($('#iCriar_Os_Encerrar_Parametro_Controller').val() == 'true') {
                            window.location = "@Url.Action("Criar_Ordem_Servico", "Painel_Servicos", new { Id_Atendimento = Model.Id})"
                        }
                        else
                            location.reload();
                    }
                    else if (data.mensagens.length > 0) {
                        for (var item of data.mensagens) {
                            Notificar("@RsBase.ATENCAO_", item.mensagem, "warning");
                        }
                        clicked = false;

                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                    }
                });
                        </text>
              }
        }
    }



</script>

}


@using (Html.BeginForm("Cadastro", "Atendimento", FormMethod.Post, htmlAttributes: new { enctype = "multipart/form-data", @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id, new { @id = "iId" })
    @Html.HiddenFor(model => model.NomeUsuario, new { @id = "iNomeUsuario" })


    @Html.HiddenFor(model => model.Criar_Os_Encerrar_Parametro_Controller, new { @id = "iCriar_Os_Encerrar_Parametro_Controller" })

    @Html.HiddenFor(model => model.Id_Endereco, new { @id = "idEnderecoCliente" })


    @Html.HiddenFor(model => model.Id_Plano_Produto, new { @id = "iIdPlanoProduto" })


    <div class="container-fluid">

        <!--main-->
        <div class="sticky-top bg-white" style=" z-index: 1021 !important;">
            <div class="row bg-white">
                <div class="col main-title mr-auto">
                    <h4 class="title-page">
                        <i class="fas fa-headset"></i>
                        @if (Model.Id != 0)
                        {
                            @RsCadastros.ACOMPANHAMENTO_ATENDIMENTO
                        }
                        else
                        {
                            @ViewBag.Title
                        }

                    </h4>

                    <nav class="mb-20">
                        <ol class="breadcrumb">

                            <li class="breadcrumb-item">
                                @if (Model.Id != 0)
                                {
                                    <a href="@Url.Action("Index", "Atendimento")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_ATENDIMENTOS</a>
                                }
                                else
                                {
                                    <a href="#" style="color:#367fa9" onclick="BotaoCancelar('@Url.Action("Index", "Atendimento")')">@RsCadastros.PAINEL_ATENDIMENTOS</a>
                                }
                            </li>

                            <li class="breadcrumb-item">
                                @if (Model.Id != 0)
                                {
                                    <a href="@Url.Action("Listagem_Atendimento", "Atendimento")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_ATENDIMENTO</a>
                                }
                                else
                                {
                                    <a href="#" style="color:#367fa9" onclick="BotaoCancelar('@Url.Action("Listagem_Atendimento", "Atendimento")')">@RsCadastros.LISTAGEM_ATENDIMENTO</a>
                                }
                            </li>
                            <li class="breadcrumb-item active">
                                <span>@ViewBag.Title</span>
                            </li>
                        </ol>
                    </nav>

                </div>



                <!--Button Menu-->
                <div class="col-auto">

                    @if (Model.Id != 0)
                    {
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">

                            @if (Model.Id != 0)
                            {
                                <a class="dropdown-item" id="btnHistorico" href="#" onclick="AbrirHistorio();"><i class="far fa-clock"></i> @RsCadastros.HISTORICO_ALTERACAO</a>
                            }


                            @if (Model != null && Model.Id != 0)
                            {
                                if (Model.Status_Atendimento != Aniel.Connect.Model.enumerado.Status_Atendimento.Concluido)
                                {

                                    <a class="dropdown-item" id="btnCriarOs"><i class="fas fa-wrench"></i> @RsCadastros.CRIAR_OS</a>

                                }
                            }


                            @*<a href="@Url.Action("Criar_Ordem_Servico", "Painel_Servicos", new { Id_Atendimento = Model.Id })" class="dropdown-item" id="btnCriarOs" onclick=""><i class="fas fa-wrench"></i> @RsCadastros.CRIAR_OS</a>*@


                            @if (Model.Id_Cliente != null)
                            {
                                if (Model.Tipo_Cliente == 0)
                                {
                                    <a class="dropdown-item" id="btnAtalhoCadCli" onclick='AddAba("@Url.Action("ClienteDadosGerais", "Cliente", new { Id = Model.Id_Cliente })","@RsCadastros.CADASTRO_CLIENTE")'><i class="fas fa-user"></i> @RsCadastros.ATALHO_CADASTRO_CLIENTE</a>
                                }
                                else if (Model.Tipo_Cliente == 1)
                                {
                                    <a class="dropdown-item" id="btnAtalhoCadCli" onclick='AddAba("@Url.Action("ClienteDadosGerais", "Cliente_Prospecto", new { Id = Model.Id_Cliente })","@RsCadastros.CADASTRO_PROSPECTO")'><i class="fas fa-user"></i> @RsCadastros.ATALHO_CADASTRO_PROSPECT</a>
                                }

                                <a class="dropdown-item" id="btnAtalhoCadCli" onclick='AddAba("@Url.Action("ClienteDadosGerais", "Venda", new { Id_Cliente = Model.Id_Cliente, IdAtendimento = Model.Id })","@RsCadastros.CADASTRO_VENDAS")'><i class="fas fa-user"></i> @RsCadastros.CADASTRO_VENDAS</a>
                            }

                            @if (Model != null && Model.Id != 0)
                            {
                                if (Model.Status_Atendimento == Aniel.Connect.Model.enumerado.Status_Atendimento.Concluido)
                                {

                                    <a class="dropdown-item" id="btnEnviarPesqSat" href="#" onclick='$("#iModal_EnviarPesquisaSatisfacao").modal("show");AddSelect("iPesquisaSatisfacao", "@CONSTANTES.URLPortal/api/Pesquisa_SatisfacaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);'><i class="far fa-smile"></i> @RsCadastros.ENVIAR_PESQUISA_SATISFACAO</a>

                                }
                                else
                                {
                                    <a class="dropdown-item" id="btnEnviarPesqSat" href="#" onclick='return Notificar("@RsBase.ATENCAO_", "Envio de pesquisa será habilitado somente se o atendimento estiver concluído", "warning");'><i class="far fa-smile"></i> @RsCadastros.ENVIAR_PESQUISA_SATISFACAO</a>

                                }
                            }

                            @*@if (Model.Id != 0)
                                {
                                    <a class="dropdown-item" id="btnEnviarEmailAss" href="#" onclick=""><i class="fas fa-envelope"></i> @RsCadastros.ENVIAR_EMAIL_AO_ASSINANTE</a>
                                }*@

                            @if (Model.Status_Atendimento != Aniel.Connect.Model.enumerado.Status_Atendimento.Concluido)
                            {
                                <a class="dropdown-item" id="btnTrocarEnderecoInstalacao" href="#" onclick="AlterarEndereco($('#idEnderecoCliente').val())"><i class="fas fa-map-marker-alt"></i> @RsCadastros.TROCAR_ENDERECO_INSTALACAO</a>
                            }



                            @if (Model.Id != 0 && (Model.Status_Atendimento == Aniel.Connect.Model.enumerado.Status_Atendimento.Cancelado || Model.Status_Atendimento == Aniel.Connect.Model.enumerado.Status_Atendimento.Concluido))
                            {
                                <a class="dropdown-item" id="btnReabrirAtendimento" href="#" onclick="return swalReabrirAtendimento($('#iId').val());"><i class="fas fa-headset"></i> @RsCadastros.REABRIR_ATENDIMENTO</a>
                            }

                            @if (Model.Status_Atendimento != Aniel.Connect.Model.enumerado.Status_Atendimento.Concluido && Model.Id_Cliente_Plano_Produto != null)
                            {
                                <a class="dropdown-item" id="btnDesbloqueioConfianca" href="#" onclick='DesbloqueioConfianca($("#iClientePlanoProduto").val());'><i class="fas fa-ban"></i> @RsCadastros.DESBLQUEIO_CONFIANCA</a>
                                <a class="dropdown-item" id="btnReduzirVelocidade" href="#" onclick='ReduzirVelocidade($("#iClientePlanoProduto").val());'><i class="far fa-clock"></i> @RsCadastros.REDUZIR_VELOCIDADE</a>
                                <a class="dropdown-item" id="btnHistoricoConsumo" href="#" onclick='ExibirHistoricoConsumo("@Model.Login_Radius");'><i class="fas fa-chart-bar"></i> @RsCadastros.HISTORICO_CONSUMO</a>
                            }

                        </div>
                    }

                    <a id="botao_ellipsis" class="btn-default" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                    </a>

                </div>
            </div>

            <!--Número Atendimento-->
            <div class="row bg-white">
                <div class="col form-group mb-0 ml-5">
                    <label for="iNome" class="text-bold-card" style="font-size: 20px;">@RsCadastros.PROTOCOLO: </label>
                    @Html.HiddenFor(model => model.Protocolo, new { Id = "iNumeroAtendimento" })
                    @Html.HiddenFor(model => model.Numero, new { Id = "iProtocolo" })
                    <span id="iNumeroAtendimentoHtml" style="font-size: 20px;">@Model.Numero</span>
                </div>
            </div>

        </div><!--.stick-top-->


        <div class="row pl-3 pr-3">
            <!--COLUNA ESQUERDA - SOBRE O ATENDIMENTO-->
            <div class="col-4" id="left">
                <!--Titular-->
                <div class="card div-card-accord mt-2">
                    <div class="card-body m-2">
                        <div class="container">
                            <div class="form-inline form-group">
                                <label for="iCliente" class="text-bold-card"><span class="text-danger">* </span>@RsCadastros.TITULAR </label>
                                <div class="ml-input">
                                    @Html.DropDownListFor(m => m.Id_Cliente, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control ml-input", @id = "iCliente", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Id_Cliente, "", new { @class = "text-danger" })
                                </div>

                                @if (Model.Id_Cliente != null)
                                {
                                    <a href="#" title="Unificar Cliente" id="iUnificarCliente"><i class="fas fa-exchange-alt" style="margin-left:6px"></i></a>
                                }
                                else
                                {
                                    <a href="#" title="Criar Pessoa" id="iCriarClienteProspect"><i class="fas fa-plus-circle" style="margin-left:6px"></i></a>
                                }
                            </div>
                            <!--Plano-->
                            <div class="form-group">
                                <label for="iClientePlanoProduto" class="text-bold-card">@RsCadastros.PLANO_PRODUTO:</label>
                                <div class="ml-input">
                                    @Html.DropDownListFor(m => m.Id_Cliente_Plano_Produto, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control ml-input", @id = "iClientePlanoProduto", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Id_Cliente_Plano_Produto, "", new { @class = "text-danger" })
                                    <input type="checkbox" class="form-group mt-1" id="iExibePlanoCancelado" /> Exibir planos cancelados
                                </div>
                            </div>
                            <!--Pessoa que entrou em contato-->
                            <div class="form-group">
                                <label for="iPessoaContato" class="text-bold-card">@RsCadastros.PESSOA_QUE_ENTROU_EM_CONTATO</label>
                                <div class="ml-input">
                                    @Html.RadioButtonFor(m => m.Tipo_Pessoa_Contato, "Titular", new { @id = "iRdTitular", @style = "margin-top: 2px;" })
                                    <label for="iRdTitular" class="pl-1 mr-2">@RsCadastros.TITULAR</label>

                                    @Html.RadioButtonFor(m => m.Tipo_Pessoa_Contato, "Outros", new { @id = "iRdOutros", @style = "margin-top: 2px;" })
                                    <label for="iRdOutros" class="pl-1">@RsCadastros.OUTROS</label>
                                </div>


                                <div class="ml-input">

                                    <label id="iLblPessoa_Contato"> Nome: </label>
                                    @Html.TextBoxFor(model => model.Pessoa_Contato, new { @class = "form-control " + (CamposObrigatoriosAtendimentoApiController.CampoBloqueado(campos, CamposObrigatoriosAtendimentoEnum.PESSOA_QUE_ENTROU_EM_CONTATO) ? "readonly" : ""), @id = "iPessoa_Contato", @autocomplete = "off", @required = true })

                                    <div class="form-group">
                                        <label id="iLblGrau_Ligacao"> Grau de Ligação :</label>
                                        @Html.EnumDropDownListFor(m => m.Grau_Ligacao, RsBase.SELECIONE, new { @class = "form-control " + (CamposObrigatoriosAtendimentoApiController.CampoBloqueado(campos, CamposObrigatoriosAtendimentoEnum.PESSOA_QUE_ENTROU_EM_CONTATO) ? "readonly" : ""), @id = "iGrauLigacao" })
                                    </div>


                                </div>

                            </div>
                        </div>

                        <!--Tipo de Atendimento-->
                        <div class="container">
                            <div class="form-group">
                                <label for="iTipoAtendimento" class="text-bold-card"><span class="text-danger">* </span>@RsCadastros.TIPO_ATENDIMENTO:</label>
                                <div class="ml-input">
                                    @Html.DropDownListFor(m => m.Id_Tipo_Atendimento, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control ml-input", @id = "iTipoAtendimento", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Id_Tipo_Atendimento, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            @if (String.IsNullOrEmpty(Model.EtapaAtual) == false)
                            {
                                <div class="form-group">
                                    <div> <label><i class="fas fa-arrow-circle-right"></i> @RsCadastros.ETAPA_ATUAL: @Model.EtapaAtual</label></div>

                                    <label><i class="fas fa-hourglass-half"></i> @RsCadastros.PRAZO_ETAPA_ATUAL: @Model.Prazo_Etapa_Atual</label>


                                    <label><i class="fas fa-clock"></i> @RsCadastros.TEMPO_GASTO: @Model.Tempo_Gasto_Etapa_Atual</label>


                                    <label><i class="fas fa-flag"></i> @RsCadastros.DATA_SLA_ETAPA: @Model.Sla_Etapa_Atual</label>

                                    @if (Model.Status_Atendimento != Status_Atendimento.Concluido)
                                    {
                                        <button type="button" class="btn btn-success" data-toggle="modal" data-target="#modal-filter" style=" font-size: 10px;"> @RsCadastros.PROXIMA_ETAPA <i class="fas fa-chevron-right"></i></button>
                                    }
                                    else
                                    { <button type="button" class="btn btn-success" data-toggle="modal" data-target="#modal-final" style=" font-size: 10px;"> @RsCadastros.PROXIMA_ETAPA <i class="fas fa-chevron-right"></i></button>}
                                </div>
                            }

                            <!--Categoria de Atendimento-->
                            <div class="form-group">
                                <label for="iCategoriaAtendimento" class="text-bold-card">@(CamposObrigatoriosAtendimentoApiController.CampoObrigatorio(campos, CamposObrigatoriosAtendimentoEnum.CATEGORIA_ATENDIMENTO) ? Html.Raw(stringObrigatorio) : Html.Raw(""))@RsCadastros.CATEGORIA_ATENDIMENTO:</label>
                                <div class="ml-input">
                                    @Html.DropDownListFor(m => m.Id_Categoria_Atendimento, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control " + (CamposObrigatoriosAtendimentoApiController.CampoBloqueado(campos, CamposObrigatoriosAtendimentoEnum.CATEGORIA_ATENDIMENTO) ? "readonly" : ""), @id = "iCategoriaAtendimento", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Id_Categoria_Atendimento, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <!--Prioridade-->




                            <div class="form-group">
                                <label for="iPrioridade_Atendimento" class="text-bold-card">@(CamposObrigatoriosAtendimentoApiController.CampoObrigatorio(campos, CamposObrigatoriosAtendimentoEnum.PRIORIDADE) ? Html.Raw(stringObrigatorio) : Html.Raw(""))@RsCadastros.PRIORIDADE_ATENDIMENTO:</label>
                                <div class="ml-input">
                                    @Html.EnumDropDownListFor(m => m.Prioridade, RsBase.SELECIONE, new { @class = "form-control " + (CamposObrigatoriosAtendimentoApiController.CampoBloqueado(campos, CamposObrigatoriosAtendimentoEnum.PRIORIDADE) ? "readonly" : ""), @id = "iPrioridade_Atendimento" })
                                    @Html.ValidationMessageFor(model => model.Prioridade, "", new { @class = "text-danger" })
                                </div>
                            </div>




                            <!--SLA de Atendimento-->

                            @if (Model.Id != 0)
                            {
                                <div class="m-1">
                                    <label class="text-bold-card">@RsCadastros.SLA_ATENDIMENTO:</label>
                                    <div class="ml-input">
                                        <span class="fs-12"><i class="fas fa-flag" style="color:@Model.Sla"></i> @Model.DataHoraIndicador</span>
                                    </div>
                                </div>
                            }
                            <!--Origem do Atednimento-->
                            <div class="form-group">
                                <label for="iNome" class="text-bold-card">@*<span class="text-danger">* </span>*@@(CamposObrigatoriosAtendimentoApiController.CampoObrigatorio(campos, CamposObrigatoriosAtendimentoEnum.ORIGEM) ? Html.Raw(stringObrigatorio) : Html.Raw(""))@RsCadastros.ORIGEM:</label>
                                <div class="ml-input">
                                    @Html.DropDownListFor(m => m.Id_Origem_Atendimento, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control ml-input " + (CamposObrigatoriosAtendimentoApiController.CampoBloqueado(campos, CamposObrigatoriosAtendimentoEnum.ORIGEM) ? "readonly" : ""), @id = "iOrigem", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Id_Origem_Atendimento, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <!--Setor-->
                            <div class="form-group">
                                <label for="iDepartamento" class="text-bold-card"><span class="text-danger">* </span>@(CamposObrigatoriosAtendimentoApiController.CampoObrigatorio(campos, CamposObrigatoriosAtendimentoEnum.SETOR_ENVOLVIDO) ? Html.Raw(stringObrigatorio) : Html.Raw(""))@RsCadastros.SETOR:</label>
                                <div class="ml-input">
                                    @Html.DropDownListFor(m => m.Id_Setor, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control ml-input " + (CamposObrigatoriosAtendimentoApiController.CampoBloqueado(campos, CamposObrigatoriosAtendimentoEnum.SETOR_ENVOLVIDO) ? "readonly" : ""), @id = "iDepartamento", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Id_Setor, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <!--Responsável-->
                            <div class="form-group">
                                <label for="iResponsavel" class="text-bold-card">@(Model.Id == 0 ? Html.Raw(stringObrigatorio) : Html.Raw(""))@RsCadastros.RESPONSAVEL:</label>
                                <div class="ml-input">
                                    @Html.DropDownListFor(m => m.Id_Responsavel, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control ml-input", @id = "iResponsavel", @autocomplete = "off" })
                                </div>
                            </div>
                            <!--Status do Atendimento-->
                            <div class="form-group">
                                <label for="iStatusAtendimento" class="text-bold-card"><span class="text-danger">* </span>@RsCadastros.STATUS_ATEDIMENTO:</label>
                                <div class="ml-input">
                                    @Html.EnumDropDownListFor(m => m.Status_Atendimento, RsBase.SELECIONE, new { @class = "form-control", @id = "iStatusAtendimento" })
                                    @Html.ValidationMessageFor(model => model.Status_Atendimento, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <!--Motivo do Status-->
                            <div class="form-group" id="iDivMotivoStatus">

                                <label for="iMotivoStatus" class="text-bold-card">@RsCadastros.MOTIVOS_STATUS_ATENDIMENTO:</label>
                                <div class="ml-input">
                                    @Html.HiddenFor(model => model.Id_Motivo_Status, new { @id = "iHiddenMotivo" })
                                    @Html.DropDownListFor(m => m.Id_Motivo_Status, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), String.Concat(RsBase.SELECIONE, " ", RsCadastros.MOTIVOS_STATUS_ATENDIMENTO), new { @class = "form-control ml-input", @id = "iDescMotivoStatus", @autocomplete = "off" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--Cliente-->
                <div id="divAlterarEndereco"></div>
                <span id="iTipoCliente" hidden="hidden"></span>

            </div> <!--./Esquerda-->
            <!--COLUNA DIREITA - CHAT-->
            <div class="col-8" id="right" style="padding-top: 89px;">

                <!--Nav Tabs-->
                <div class="row bg-white sticky-top bg-white">
                    <ul class="nav nav-tabs" id="myTab" role="tablist">

                        @if (ViewBag.ChatAtivo)
                        {
                            <li class="nav-item">
                                <a class="nav-link active" id="chat-tab" data-toggle="tab" href="#iTabChat" role="tab" aria-controls="chat" aria-selected="true"><i class="fas fa-comment-alt"></i> @RsCadastros.CHAT</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" id="atendimento-tab" data-toggle="tab" href="#iTabAtendimento" role="tab" aria-controls="atendimento" aria-selected="false"><i class="fa fa-headset"></i> @RsCadastros.ATENDIMENTO</a>
                        </li>
                        <li class="nav-item">
                            @if (Model.Id == 0)
                            {
                                <a class="nav-link" id="clienteProspect-tab" data-toggle="tab" href="#iTabClienteProspect" role="tab" aria-controls="clienteProspect" aria-selected="false"><i class="fa fa-user"></i> @RsCadastros.CLIENTE__PROSPECTO</a>
                            }
                            else
                            {
                                <a class="nav-link" id="clienteProspect-tab" data-toggle="tab" href="#iTabClienteProspect" role="tab" aria-controls="clienteProspect" aria-selected="false"><i class="fa fa-user"></i> @(Model.Tipo_Cliente == 0 ? @RsCadastros.DADOS_CLIENTE : @RsCadastros.DADOS_PROSPECT)</a>
                            }
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="planoProduto-tab" data-toggle="tab" href="#iTabPlanoProduto" role="tab" aria-controls="PlanoProduto" aria-selected="true"><i class="fa fa-wifi"></i> @RsCadastros.PLANO_PRODUTO</a>
                        </li>
                        <li class="nav-item" id="iNavScript" style="display:none">
                            <a class="nav-link" id="scriptAtendimento-tab" data-toggle="tab" href="#iTabScriptAtendimento" role="tab" aria-controls="scriptAtendimento" aria-selected="false"><i class="fa fa-code"></i> @RsCadastros.SCRIPT_ATENDIMENTO</a>
                        </li>
                        @if (Model.Id != 0)
                        {

                            <li class="nav-item">
                                <a class="nav-link" id="historicoFatura-tab" data-toggle="tab" href="#iTabHistoricoFatura" role="tab" aria-controls="historicoFatura" aria-selected="false"><i class="fa fa-file-archive"></i> @RsCadastros.HISTORICO_FATURA</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="ordemServico-tab" data-toggle="tab" href="#iTabOrdemServico" role="tab" aria-controls="ordemServico" aria-selected="true"><i class="fas fa-file-contract"></i> @RsCadastros.ORDEM_SERVICO_ABA</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="historicoAtendiemnto-tab" data-toggle="tab" href="#iTabHistoricoAtendiemnto" role="tab" aria-controls="historicoAtendiemnto" aria-selected="false"><i class="fa fa-file-audio"></i> @RsCadastros.HISTORICO_ATENDIMENTO</a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Tab Content Master-->
                <div class="row">
                    <div class="col tab-content" id="myTab">
                        <!--CHAT-->
                        <div role="tabpanel" class="tab-pane @(ViewBag.ChatAtivo ? "active" : "")" id="iTabChat">
                            <div class="accordion mb-3" id="accordion_Chat" style="display:none">
                                <div class="card border border-secondary div-card-accord">
                                    <div class="card-header text-center title-card" id="heading_infoCliente" style="border-color: #6c757d">
                                        <h5 class="mb-1">
                                            <a role="button" data-toggle="" data-target="#accordion_Chat" aria-expanded="true" aria-controls="accordion_Chat">
                                                <span class="text-danger text-bold-card"><i style="color:dimgray" class="fas fa-exclamation-triangle"></i> @RsCadastros.AVISO_IMPORTANTE!</span>
                                            </a>
                                        </h5>
                                    </div>
                                    <div id="accordion_Chat" class="collapse show" aria-labelledby="heading_infoCliente" data-parent="#accordion_Chat">
                                        <div class="card-body" style="margin-top: -20px;">
                                            <div class="container">
                                                <div class="row">
                                                    <div class="col">
                                                        <div class="row">
                                                            <label class="inadimplente fs-12"><i class="fas fa-hand-holding-usd"></i> @RsCadastros.CLIENTE_INADIMPLENTE a:&#160;</label>
                                                            <span class="ClienteInadimplente inadimplente fs-12"></span>
                                                        </div>
                                                        <div class="row">
                                                            <label class="manutencaoRegiao fs-12"><i class="icofont-under-construction"></i>@RsCadastros.MANUTENCAO_DATA_PREVISTA: </label>
                                                            <span class="manutencaoRegiaotxt manutencaoRegiao fs-12"></span>
                                                        </div>
                                                        <div class="row">
                                                            <span class="emNegociacao fs-12"><i class="far fa-handshake"></i> @RsCadastros.PENDENCIAS_FINANCEIRAS: @RsCadastros.CLIENTE_NEGOCIACAO.Replace("Cliente", "")</span>
                                                            <span class="emNegociacaotxt emNegociacao fs-12"></span>
                                                        </div>
                                                        <div class="row">
                                                            <span class="clienteProspectInativo fs-12"><i class="fas fa-user-times"></i> @(Model.Tipo_Cliente == 0 ? @RsCadastros.CLIENTE : @RsCadastros.PROSPECTO) @RsCadastros.INATIVO</span>
                                                        </div>
                                                        <div class="row">
                                                            <label class="faturasAberto fs-12"><i class="fas fa-file-invoice"></i>&#160;@RsCadastros.EV_FATURAS_ABERTO.Replace("Consultar f", "F"):&#160;</label>
                                                            <span class="faturasAbertotxt faturasAberto fs-12"></span>
                                                        </div>
                                                    </div>
                                                    <div class="col">
                                                        <div class="row">
                                                            <label class="termoAdesao fs-12"><i class="fas fa-exclamation-triangle"></i>@RsCadastros.TERMO_ADESAO</label>
                                                            <span class="termoAdesaotxt termoAdesao fs-12"></span>
                                                        </div>
                                                        <div class="row">
                                                            <span class="velocidadeReduzida fs-12"><i class="fas fa-thumbtack"></i> @RsCadastros.VELOCIDADE_REDUZIDA</span>
                                                        </div>
                                                        <div class="row">
                                                            <span class="sinalBloqueado fs-12"><i class="fas fa-thumbtack"></i> @RsCadastros.SINAL_BLOQUEADO</span>
                                                        </div>
                                                        <div class="row">
                                                            <label class="statusSinal fs-12"><i class="fas fa-thumbtack"></i> Status Sinal:</label>
                                                            <span class="SinalPlano statusSinal fs-12"></span>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="overlay" id="divProgressChat" style="display:none;position:relative">
                                <div class="preloaderbar show active" style="position:relative;">
                                    <span class="bar" style="width:auto !important"></span>
                                    <span class="text" style="color:black">@RsCadastros.PROCESSANDO...</span>
                                </div>
                            </div>
                            <!--Chat-->
                            <div class="accordion mb-3" id="accordion_10">
                                <div class="card div-card-accord" style="height: 100%;">
                                    <div class="card-header title-card" id="heading_10">
                                        <h5 class="mb-0">
                                            <a role="button" data-toggle="collapse" data-target="#collapse_10" aria-expanded="true" aria-controls="collapse_10">
                                                <span class="text-bold-card">@RsCadastros.CHAT</span>
                                            </a>
                                        </h5>
                                    </div>
                                    <div id="collapse_10" class="collapse show" aria-labelledby="heading_10" data-parent="#accordion_10">
                                        <div class="card-body" style="margin-top: -20px; height: 45vh;">

                                            <!--Botões-->
                                            <div class="col">
                                                <div class="row mb-3">
                                                    <div class="col-4 pl-0">
                                                        <div class="form-group" style=" height: 20px;">
                                                            <select class="form-control btn-outline-secondary" id="exampleFormControlSelect1" style="height:28px;">
                                                                <option>Convidar outro Atendente</option>
                                                                <option>2</option>
                                                                <option>3</option>
                                                                <option>4</option>
                                                                <option>5</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="col text-right">
                                                        <button type="button" class="btn btn-outline-secondary" onclick="TransferirAtendimentoChat();">Transferir Atendimento</button>
                                                        @*<input type="button" id="btnGravar" value="Gravar" class="btn btn-outline-secondary ml-3" />*@
                                                        <a class="btn btn-outline-secondary ml-3" href="#" onclick="finalizarAtendimento()">Concluir Chat</a>
                                                    </div>
                                                </div>
                                            </div>

                                            <!--Chat-->
                                            <!--Messages Chat iFrame-->
                                            <iframe id="chatFrame" data-pageid="chat@(Model.Numero)" frameBorder="0" class="mt-1" scrolling="yes" style="width:100%; height:86%"></iframe>


                                            <!--Footer Send Message-->
                                            <div class="input-group mb-2 mr-sm-2 mt-3" style="width: auto;">
                                                <div class="input-group-prepend">
                                                    <div class="input-group-text" style="background-color: transparent !important;border: none !important" ;>
                                                        <a href="#" class="text-dark" id="iEmoji"><i class="far fa-smile"></i></a>
                                                    </div>
                                                </div>
                                                <input type="text" class="form-control" id="inlineFormInputGroupUsername2" placeholder="Escreva aqui...">
                                                <div class="input-group-apend">
                                                    <div class="input-group-text" style="background-color: transparent;border: none" ;>
                                                        <a href="#" onclick="sendMessage()" class="text-dark"> <i class="fas fa-paper-plane"></i> </a>
                                                        <label class="m-2">
                                                            <span class="fas fa-paperclip"></span>
                                                            <input id="iArquivoChat" name="ArquivosChat" type="file" data-index=0 hidden class="anexarArquivo">
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>


                        </div>
                        <!--ATENDIMENTO-->
                        <div role="tabpanel" class="tab-pane @(ViewBag.ChatAtivo ? "" : "active")" id="iTabAtendimento">
                            <div class="accordion mb-3" id="accordion_Atendimento" style="display:none">
                                <div class="card border border-secondary div-card-accord">
                                    <div class="card-header text-center title-card" id="heading_infoCliente" style="border-color: #6c757d">
                                        <h5 class="mb-1">
                                            <a role="button" data-toggle="" data-target="#accordion_Atendimento" aria-expanded="true" aria-controls="accordion_Atendimento">
                                                <span class="text-danger text-bold-card"><i style="color:dimgray" class="fas fa-exclamation-triangle"></i> @RsCadastros.AVISO_IMPORTANTE!</span>
                                            </a>
                                        </h5>
                                    </div>
                                    <div id="accordion_Atendimento" class="collapse show" aria-labelledby="heading_infoCliente" data-parent="#accordion_Atendimento">
                                        <div class="card-body" style="margin-top: -20px;">
                                            <div class="container">
                                                <div class="row">
                                                    <div class="col">
                                                        <div class="row">
                                                            <label class="inadimplente fs-12"><i class="fas fa-hand-holding-usd"></i> @RsCadastros.CLIENTE_INADIMPLENTE a:&#160;</label>
                                                            <span class="ClienteInadimplente inadimplente fs-12"></span>
                                                        </div>
                                                        <div class="row">
                                                            <label class="manutencaoRegiao fs-12"><i class="icofont-under-construction"></i>@RsCadastros.MANUTENCAO_DATA_PREVISTA: </label>
                                                            <span class="manutencaoRegiaotxt manutencaoRegiao fs-12"></span>
                                                        </div>
                                                        <div class="row">
                                                            <span class="emNegociacao fs-12"><i class="far fa-handshake"></i> @RsCadastros.PENDENCIAS_FINANCEIRAS: @RsCadastros.CLIENTE_NEGOCIACAO.Replace("Cliente", "")</span>
                                                            <span class="emNegociacaotxt emNegociacao fs-12"></span>
                                                        </div>
                                                        <div class="row">
                                                            <span class="clienteProspectInativo fs-12"><i class="fas fa-user-times"></i> @(Model.Tipo_Cliente == 0 ? @RsCadastros.CLIENTE : @RsCadastros.PROSPECTO) @RsCadastros.INATIVO</span>
                                                        </div>
                                                        <div class="row">
                                                            <label class="faturasAberto fs-12"><i class="fas fa-file-invoice"></i>&#160;@RsCadastros.EV_FATURAS_ABERTO.Replace("Consultar f", "F"):&#160;</label>
                                                            <span class="faturasAbertotxt faturasAberto fs-12"></span>
                                                        </div>
                                                    </div>
                                                    <div class="col">
                                                        <div class="row">
                                                            <label class="termoAdesao fs-12"><i class="fas fa-exclamation-triangle"></i>@RsCadastros.TERMO_ADESAO</label>
                                                            <span class="termoAdesaotxt termoAdesao fs-12"></span>
                                                        </div>
                                                        <div class="row">
                                                            <span class="velocidadeReduzida fs-12"><i class="fas fa-thumbtack"></i> @RsCadastros.VELOCIDADE_REDUZIDA</span>
                                                        </div>
                                                        <div class="row">
                                                            <span class="sinalBloqueado fs-12"><i class="fas fa-thumbtack"></i> @RsCadastros.SINAL_BLOQUEADO</span>
                                                        </div>
                                                        <div class="row">
                                                            <label class="statusSinal fs-12"><i class="fas fa-thumbtack"></i> Status Sinal:</label>
                                                            <span class="SinalPlano statusSinal fs-12"></span>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!--Atendimento-->
                            <div class="accordion mb-3" id="accordion_20">
                                <div class="card div-card-accord">
                                    @*<div class="card-header title-card" id="heading_20">
                                            <h5 class="mb-0">
                                                <a role="button" data-toggle="collapse" data-target="#collapse_20" aria-expanded="true" aria-controls="collapse_20">
                                                    <span class="text-bold-card">@RsCadastros.ATENDIMENTO</span>
                                                </a>
                                            </h5>
                                        </div>*@
                                    <div id="collapse_20" class="collapse show" aria-labelledby="heading_20" data-parent="#accordion_20">
                                        <div class="card-body" style="margin-top: -20px;">

                                            <!--Assunto Atendimento-->
                                            <div class="ml-3 mt-2">
                                                <label for="iAssuntoAtendimento" class="text-bold-card">@(CamposObrigatoriosAtendimentoApiController.CampoObrigatorio(campos, CamposObrigatoriosAtendimentoEnum.ASSUNTO) ? Html.Raw(stringObrigatorio) : Html.Raw(""))@RsCadastros.ASSUNTO:</label>
                                                <div class="form-group">
                                                    @Html.TextBoxFor(model => model.Assunto, new { @class = "form-control ml-input" + (CamposObrigatoriosAtendimentoApiController.CampoBloqueado(campos, CamposObrigatoriosAtendimentoEnum.ASSUNTO) ? "readonly" : ""), @id = "iAssuntoAtendimento", @autocomplete = "off", @required = true, @Maxlength = 100, @placeholder = RsCadastros.PLACEHOLDER_ASSUNTO })
                                                    @Html.ValidationMessageFor(model => model.Assunto, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <!--Editor de Texto-->
                                            @if (Model.Status_Atendimento != Status_Atendimento.Cancelado && Model.Status_Atendimento != Status_Atendimento.Concluido)
                                            {
                                                <form method="post">

                                                    <textarea id="mytextarea" placeholder="@RsCadastros.PLACEHOLDER_INSERIR_ATIVIDADE"></textarea>
                                                    <div class="row" id="divArquivo">
                                                        <div class="col-sm-12">
                                                            <div class="btn-group-sm" role="group" aria-label="Basic example">
                                                                <label class="btn btn-outline-dark mt-1">
                                                                    <span class="mr-2 ml-2"><i class="fas fa-paperclip"></i> Clique para anexar</span> <input id="iArquivoAtividade" type="file" name="Files[0]" data-index=0 hidden>
                                                                </label>




                                                                <br />
                                                                <div class="mt-2" style="display:inline-block">
                                                                    <div id="iDivTipoAtividade" style="">
                                                                        <label class="">
                                                                            Tipo de Atividade:
                                                                        </label>
                                                                        <input type="radio" value="1" checked name="TipoAtividade"> @RsCadastros.PUBLICO
                                                                        <input type="radio" value="0" name="TipoAtividade"> @RsCadastros.INTERNO
                                                                    </div>
                                                                </div>


                                                            </div>
                                                        </div>
                                                    </div>

                                                </form>

                                                <div class="form-inline mt-2">
                                                    <label id="TagLabel" style="display:none">Arquivos: </label>
                                                    <div id="tagFiles">

                                                    </div>
                                                </div>

                                                <input type="button" id="btnInserirAtividade" value="@RsCadastros.INSERIR_ATIVIDADE" class="btn btn-success mt-2 mb-2" style="float:right">
                                            }

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!--Histórico de Atividades-->
                            <h4 class="mt-5"><i class="far fa-clock"></i> @RsCadastros.HISTORICO_ATIVIDADES</h4>
                            <hr color="3c8dbc" class="mt-0" style="height:1.5px">
                            <div id="iDivHistoricoAtividade">


                            </div>

                        </div>
                        <!--CLIENTE/PROSPECT-->
                        <div role="tabpanel" class="tab-pane" id="iTabClienteProspect">


                            <div class="accordion mb-3" id="accordion_infoCliente" style="display:none">
                                <div class="card border border-secondary div-card-accord">
                                    <div class="card-header text-center title-card" id="heading_infoCliente" style="border-color: #6c757d">
                                        <h5 class="mb-1">
                                            <a role="button" data-toggle="" data-target="#accordion_infoCliente" aria-expanded="true" aria-controls="accordion_infoCliente">
                                                <span class="text-danger text-bold-card"><i style="color:dimgray" class="fas fa-exclamation-triangle"></i> @RsCadastros.AVISO_IMPORTANTE!</span>
                                            </a>
                                        </h5>
                                    </div>
                                    <div id="accordion_infoCliente" class="collapse show" aria-labelledby="heading_infoCliente" data-parent="#accordion_infoCliente">
                                        <div class="card-body" style="margin-top: -20px;">
                                            <div class="container">
                                                <div class="row">
                                                    <div class="col">
                                                        <div class="row">
                                                            <label class="inadimplente fs-12"><i class="fas fa-hand-holding-usd"></i> @RsCadastros.CLIENTE_INADIMPLENTE a:&#160;</label>
                                                            <span class="ClienteInadimplente inadimplente fs-12"></span>
                                                        </div>
                                                        <div class="row">
                                                            <label class="manutencaoRegiao fs-12"><i class="icofont-under-construction"></i>@RsCadastros.MANUTENCAO_DATA_PREVISTA: </label>
                                                            <span class="manutencaoRegiaotxt manutencaoRegiao fs-12"></span>
                                                        </div>
                                                        <div class="row">
                                                            <span class="emNegociacao fs-12"><i class="far fa-handshake"></i> @RsCadastros.PENDENCIAS_FINANCEIRAS: @RsCadastros.CLIENTE_NEGOCIACAO.Replace("Cliente", "")</span>
                                                            <span class="emNegociacaotxt emNegociacao fs-12"></span>
                                                        </div>
                                                        <div class="row">
                                                            <span class="clienteProspectInativo fs-12"><i class="fas fa-user-times"></i> @(Model.Tipo_Cliente == 0 ? @RsCadastros.CLIENTE : @RsCadastros.PROSPECTO) @RsCadastros.INATIVO</span>
                                                        </div>
                                                        <div class="row">
                                                            <label class="faturasAberto fs-12"><i class="fas fa-file-invoice"></i>&#160;@RsCadastros.EV_FATURAS_ABERTO.Replace("Consultar f", "F"):&#160;</label>
                                                            <span class="faturasAbertotxt faturasAberto fs-12"></span>
                                                        </div>
                                                    </div>
                                                    <div class="col">
                                                        <div class="row">
                                                            <label class="termoAdesao fs-12"><i class="fas fa-exclamation-triangle"></i>@RsCadastros.TERMO_ADESAO</label>
                                                            <span class="termoAdesaotxt termoAdesao fs-12"></span>
                                                        </div>
                                                        <div class="row">
                                                            <span class="velocidadeReduzida fs-12"><i class="fas fa-thumbtack"></i> @RsCadastros.VELOCIDADE_REDUZIDA</span>
                                                        </div>
                                                        <div class="row">
                                                            <span class="sinalBloqueado fs-12"><i class="fas fa-thumbtack"></i> @RsCadastros.SINAL_BLOQUEADO</span>
                                                        </div>
                                                        <div class="row">
                                                            <label class="statusSinal fs-12"><i class="fas fa-thumbtack"></i> Status Sinal:</label>
                                                            <span class="SinalPlano statusSinal fs-12"></span>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!--Dados Gerais - Dados Pessoais-->
                            <div class="accordion mb-3" id="accordion_31">
                                <div class="card div-card-accord">
                                    <div class="card-header title-card" id="heading_31">
                                        <h5 class="mb-0">
                                            <a role="button" data-toggle="collapse" data-target="#collapse_31" aria-expanded="true" aria-controls="collapse_31">
                                                <span class="text-bold-card">@RsCadastros.DADOS_BASICOS</span>
                                            </a>
                                        </h5>
                                    </div>
                                    <div id="collapse_31" class="collapse show" aria-labelledby="heading_31" data-parent="#accordion_31">
                                        <div class="card-body" style="margin-top: -20px;">

                                            <!--Dados Pessoais-->
                                            <div class="form-group panel">
                                                <div class="form-group">
                                                    <label for="iCpf_Cnpj_Cliente" class="font-weight-bold">@RsCadastros.CPFCNPJ:</label>
                                                    <span id="iCpf_Cnpj_Cliente">@Model.CPF_CNPJ_Cliente</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iRG_Cliente" class="font-weight-bold">@RsCadastros.RG:</label>
                                                    <span id="iRG_Cliente">@Model.RG_Cliente</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iNomeCliente" class="font-weight-bold">@RsCadastros.NOMECOMPLETO:</label>
                                                    <span id="iNomeCliente">@Model.Nome_Cliente</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iData_Nascimento" class="font-weight-bold">@RsCadastros.DATANASCIMENTO:</label>
                                                    <span id="iData_Nascimento">@Model.Data_Nascimento</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iCategoriaCliente" class="font-weight-bold">@RsCadastros.CATEGORIA_CLIENTE:</label>
                                                    <span id="iCategoriaCliente">@Model.Categoria_Cliente</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iIdentificacaoCliente" class="font-weight-bold">@RsCadastros.IDENTIFICACAO_CLIENTE:</label>
                                                    <span id="iIdentificacaoCliente">@Model.Id_Cliente</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iTelefoneFixo" class="font-weight-bold">@RsCadastros.TELEFONEFIXO:</label>
                                                    <span id="iTelefoneFixo">@Model.Telefone_Fixo</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iTelefoneCelular" class="font-weight-bold">@RsCadastros.TELEFONECELULAR:</label>
                                                    <span id="iTelefoneCelular">@Model.Telefone_Celular</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iTelefoneRecado" class="font-weight-bold">@RsCadastros.TELEFONERECADO:</label>
                                                    <span id="iTelefoneRecado">@Model.Telefone_Recado</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iNomeRecado" class="font-weight-bold">@RsCadastros.NOMERECADO:</label>
                                                    <span id="iNomeRecado">@Model.Nome_Recado</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iEmail" class="font-weight-bold">@RsCadastros.EMAIL:</label>
                                                    <span id="iEmail">@Model.Email_Principal</span>
                                                </div>
                                                <div class="form-group">
                                                    <label for="iClienteHa" class="font-weight-bold">@RsCadastros.CLIENTE_HA:</label>
                                                    <span id="iClienteHa">@Model.Cliente_Ha</span>
                                                </div>
                                                @if (Model.Id_Cliente != null && Model.Tipo_Cliente == 0)
                                                {
                                                    <button type="button" onclick='AddAba("@Url.Action("ClienteDadosGerais","Cliente", new { Id = Model.Id_Cliente })","@RsCadastros.CADASTRO_CLIENTE")' class="btn btn-outline-dark"><i class="fa fa-sync-alt mr-2"></i>@RsCadastros.ATUALIZAR_DADOS_CLIENTE</button>
                                                }
                                                else if (Model.Id_Cliente != null && Model.Tipo_Cliente == 1)
                                                {
                                                    <button type="button" onclick='AddAba("@Url.Action("ClienteDadosGerais","Cliente_Prospecto", new { Id = Model.Id_Cliente })","@RsCadastros.CADASTRO_PROSPECTO")' class="btn btn-outline-dark"><i class="fa fa-sync-alt mr-2"></i>@RsCadastros.ATUALIZAR_DADOS_PROSPECT</button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

