                    text: '',
                    showCancelButton: true,
                    cancelButtonText: '@RsCadastros.CLIENTE',
                    confirmButtonText: '@RsCadastros.PROSPECTO',
                    type: 'question',
                    cancelButtonColor: "#3085d6",
                    confirmButtonColor: "#3085d6",
