        function AddAba(url, title, id = 'undefined') {

            parent.addTabs({
                id: id,
                title: title,
                close: true,
                url: url,
                urlType: "absolute"
            });
        }

        async function EnviarPesquisa() {

            if (ValidaObrigatoriosPorClasse("obrigatorioPesquisa", false)) {
                Notificar("@RsBase.ATENCAO_", "Informe a pesquisa de satisfação", "warning");
                return false;
            }

            let pesquisaSatisfacao = $('#iPesquisaSatisfacao option:selected').val();
            let usuario = "@User.Identity.GetUserId()";
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/pesquisa_SatisfacaoApi/Enviar")' + `?Id_Cliente=@Model.Id_Cliente&Id_Pesquisa=${pesquisaSatisfacao}&Usuario=${usuario}`;
            var data = await $.ajax({
                url: link,
                type: 'GET',
                dataType: 'json',
                beforeSend: function () {
                    ShowPageLoading();
                },
                complete: function () {
                    HidePageLoading();
                }
            });

            if (data.ok) {
                Notificar("@RsBase.INFORMACAO", "@RsCadastros.DADOS_GRAVADOS_SUCESSO", "info");
                $("#iModal_EnviarPesquisaSatisfacao").modal("hide");
            }
            else {
                Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                $("#iModal_EnviarPesquisaSatisfacao").modal("hide");
            }

    }

    async function EnviarEtapaDecisoria() {

        let proximaEtapa = $('#iProxima_Etapa option:selected').val();
        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoapi/MudarEtapaFluxo")';

        var data = await $.ajax({
            url: link,
            type: 'POST',
            dataType: 'json',
            data: {
                IdProximaEtapa: proximaEtapa,
                IdAtendimento: @Model.Id
            },
            beforeSend: function () {
                ShowPageLoading();
            },
            complete: function () {
                HidePageLoading();
            }
        });

        if (data.ok) {
            Notificar("@RsBase.INFORMACAO", "@RsCadastros.DADOS_GRAVADOS_SUCESSO", "info");

            if (data.idObjeto?.encerraAtendimento == true && data.idObjeto?.criaOs) {
                $('#iCriar_Os_Encerrar_Parametro_Controller').val(true);
                ValidaSubmit();
            }
            else {
                window.location = "@Url.Action("Cadastro", "Atendimento", new { Id = Model.Id })";
            }

        }
        else {
            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");

        }

    }






            function AlterarEndereco(idEndereco) {
                if ($("#iCpfCliente").val() == "" && idEndereco == "") {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.INFORME_CLIENTE)", "warning");
                    return false;
                }
                if (idEndereco == "") {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.NAO_EXISTE_ENDERECO_INSTALACAO_ASSOCIADO_AO_CLIENTE)", "warning");
                    return false;
                }
                if ($("#iCpfCliente").val() != "") {
                    ShowDialog(true, true, 'Alterar Endereco', '@Url.Action("AlterarEndereco", "Cliente")?atendimento=' + @Model.Id + '&IdEndereco=' + idEndereco, 'divAlterarEndereco', 850, 525, 'iframeAlterarEndereco'); // + '?Id_Cliente=' + idCliente
                }
                else {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsCadastros.INFORME_CLIENTE)", "warning");
                }
            }

