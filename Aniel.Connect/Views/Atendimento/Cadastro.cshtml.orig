        function create_UUID() {
            var dt = new Date().getTime();
            var uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                var r = (dt + Math.random() * 16) % 16 | 0;
                dt = Math.floor(dt / 16);
                return (c == 'x' ? r : (r & 0x3 | 0x8)).toString(16);
            });
            return uuid;
        }

        function renderMessage(message, datetime, usuario, fromClient, fluxoChat = false, arquivos) {

            if (!datetime)
                datetime = moment().format("HH:mm")

            if (arquivos == undefined) {
                arquivos = [];
            }



            if (fluxoChat == false) {

                let IdArquivo = create_UUID();

                /*let divArquivo = `<div id="${IdArquivo}"><a href="${arquivos}" target="_blank">Visit W3Schools</a></div>`*/

                $('#messages', $('#chatFrame').contents()).html($('#messages', $('#chatFrame').contents()).html() +

                    `<div class="row justify-content-${fromClient == true ? "start" : "end"}">
                    <div class="card mb-3 mt-3" style="width:50%; border-radius: 1rem;">
                        <div style="border-radius: 1rem;" class="card-body ${fromClient == true ? "alert-secondary text-left" : "alert-info text-left"} ">
                           <div class="row" style="font-size: 14px;">
                              <div class="col text-capitalize text-truncate">
                                ${fromClient == true ? `<i class='icofont-ui-head-phone'></i><strong style='text-transform: capitalize !important;'> ${usuario}</strong>` : "<i class='icofont-ui-user'></i><strong> @Model.Nome_Cliente</strong>"}
                              </div>
                            <div class="col text-right">
                                <span class="ml-5">${datetime}</span>
                            </div>
                          </div>
                          <hr style="margin-top: 5px;margin-bottom: 5px; background-color: #000;">
                          <div class="row" style="font-size: 14px;">
                              <div class="col" style="white-space:pre-line">
                                   ${message}
                              </div>
                          </div>
                    </div>
                     ${arquivos.length > 0 ? `<div id="${IdArquivo}" style="margin-top: 5px;"><a class="tag  mr-1 ml-1 text-truncate" href="${arquivos[0].url} "target="_blank"><i class="fas fa-paperclip"></i> ${arquivos[0].name}</a></div>` : "" }
                </div>
                `);

                //if (window.frames['chatFrame'].contentWindow)
                //    window.frames['chatFrame'].contentWindow.messageArquivos(IdArquivo, arquivos)
            }
            else {
                $('#messages', $('#chatFrame').contents()).html($('#messages', $('#chatFrame').contents()).html() +

                    `<div class="row justify-content-${fromClient == true ? "start" : "end"}">
                    <div class=" mb-3 mt-3" style="width:50%;">
                        <div style="" class="${message.enviadoPeloSuporte == true ? "text-left" : "text-right"} ">
                           <div class="row" style="font-size: 14px;">
                              <div class="col text-right">
                                <span class="ml-5">${datetime} ${message}</span>
                            </div>
                          </div>
                    </div>
                </div>
                `);
            }

            //${fromClient ? "<i class='icofont-ui-head-phone'></i>" : "<i class='icofont-ui-user'></i>"}

        }

    async function sendMessage() {

        // const datetime = moment().format("DD/MM/YYYY HH:mm")
        const datetime = moment().format("HH:mm");
        const message = {
            mensagem: $('#inlineFormInputGroupUsername2').val(),
            dataHora: datetime,
            enviadoPeloSuporte: true,
            statusEnvio: 1,
            usuario: "@User.Identity.GetUserName()",
            arquivos: []
        };


        let obj = $('#iArquivoChat')[0];

        if (obj.files.length > 0) {

            let fileid = create_UUID();
            var data = new FormData();
            data.append("UploadedImage", obj.files[0]);
            data.append("id", fileid);
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Atendimentoapi/AdicionarArquivoMensagemChat")';

            //valida o tipo
            var nomeFiles = obj.files[0].name;
            var tipo = 0;
            var extensoesPermitidasImagem = /(.jpeg|.jpg|.gif|.png|.bmp|.tiff)$/i;
            var extensoesPermitidasVideo = /(.mpeg|.mp4|.quicktime|.webm|.3gpp|.3gpp2|.3gpp-tt|.H261|.H263-1998|.H263-2000|.H264)$/i;
            var extensoesPermitidasAudio = /(.L24|.mp3|.mpeg|.ogg|.vnd.rn-realaudio|.vnd.wave|.3gpp|.3gpp2|.ac3|.webm|.amr-nb|.amr|.snd|.au)$/i;
            var extensoesPermitidasArquivo = /(.vcard|.pdf|.directory|.calendar|.richtext|.rtf|.x-vcard|.doc|.docx)$/i;

            if (extensoesPermitidasImagem.exec(nomeFiles)) {
                tipo = 0;
            } else if (extensoesPermitidasVideo.exec(nomeFiles)) {
                tipo = 1;
            } else if (extensoesPermitidasAudio.exec(nomeFiles)) {
                tipo = 2;
            } else if (extensoesPermitidasArquivo.exec(nomeFiles)) {
                tipo = 3;
            }

            message.arquivos.push({
                name: obj.files[0].name,
                id: fileid,
                url: "@CONSTANTES.URLPortal" + "/Arquivos/Atendimento/Chat/" + obj.files[0].name,
                tipo: tipo,
            });

            $.ajax({
                url: link,
                type: 'POST',
                contentType: false,
                processData: false,
                data: data

            }).done(function (data) {

            })
                .fail(function () {

                })
                .always(function () {

                });
        }

