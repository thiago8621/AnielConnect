                                    <div class="card-header title-card" id="heading_41">
                                        <h5 class="mb-0">
                                            <a role="button" data-toggle="collapse" data-target="#collapse_41" aria-expanded="true" aria-controls="collapse_41">
                                                <span class="text-bold-card">@RsCadastros.INFORMACOES_PLANO_PRODUTO</span>
