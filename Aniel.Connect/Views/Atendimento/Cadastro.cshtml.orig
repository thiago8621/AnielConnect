    $("#ordemServico-tab").click(function () {


        let idAtendimento = "@Model.Id";
        let idCliente = "@Model.Id_Cliente";
        let idClientePlanoProduto = "@Model.Id_Cliente_Plano_Produto";


        try {
            if (!"@Model.Id_Cliente") {
                Notificar("@RsBase.ATENCAO_", "Selecione um cliente.", "warning");
                event.preventDefault();
                return false;
            } else {
                if ($("#iOrdensServicoFrame").attr("src") != "@Url.Action("Ordens_Servico", "Atendimento")" + `?Id_Atendimento=${idAtendimento}&Id_Cliente=${idCliente}`) {

                    $('#divProgressOrdensServico').show();

                    $('#iOrdensServicoFrame').on("load", function () {
                        $('#divProgressOrdensServico').fadeOut();
                    });

                    $("#iOrdensServicoFrame").attr("src", "@Url.Action("Ordens_Servico", "Atendimento")" + `?Id_Atendimento=${idAtendimento}&Id_Cliente=${idCliente}`);
                }
                else {
                    window.frames['iOrdensServicoFrame'].switchTabInIframe();
                }
            }
        } catch (ex) { }
    });

        $("#historicoAtendiemnto-tab").click(function () {

            try {
                if (!"@Model.Id_Cliente") {
                    Notificar("@RsBase.ATENCAO_", "Selecione um cliente.", "warning");
                    event.preventDefault();
                    return false;
                }
                else {
                    if ($("#iHistoricoAtendimentoFrame").attr("src") != "@Url.Action("HistoricoAtendimento", "Atendimento", new { IdCliente = Model.Id_Cliente })") {

                        $('#divProgressHistoricoAtendimento').show();

                        $('#iHistoricoAtendimentoFrame').on("load", function () {
                            $('#divProgressHistoricoAtendimento').fadeOut();
                        });

                        $("#iHistoricoAtendimentoFrame").attr("src", "@Url.Action("HistoricoAtendimento", "Atendimento", new { IdCliente = Model.Id_Cliente })");
                    }
                    else {
                        window.frames['iHistoricoAtendimentoFrame'].switchTabInIframe();
                    }
                }

            } catch (ex) { }
        });



    function ConfirmarCancelarPlano(idPlanoProduto) {

        Swal.fire({
            title: "Deseja cancelar o plano?",
            text: "Não será possível retornar essa ação!",
            type: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Sim',
            cancelButtonText: 'Não'
        }).then((result) => {
            if (result.value) {
                $('#iModal_Motivo_Cancelamento').modal('show');
                AddSelect("iMotivo_Cancelamento", "@CONSTANTES.URLPortal/api/Motivo_Cancelamento_PlanoProdutoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

                $("#btnMotivoCancelamento").click(function (e) {
                    if (!ValidaObrigatoriosPorClasse("obrigatorioCancelar", false)) {
                        var idMotivo_cancelamento = $("#iMotivo_Cancelamento").val();
                        AlterarStatusObj(5, idPlanoProduto, idMotivo_cancelamento);
                    }
                })
            }
        });
    }

        function AlterarStatusObj(Status, idPlanoProduto, idMotivo_cancelamento = null) {

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/PlanoProdutoapi/AlterarStatus")';

            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    ids: idPlanoProduto,
                    status: Status,
                    id_motivo_cancelamento: idMotivo_cancelamento
                }
            })
            .done(function (data) {

                if (data.ok) {

                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    window.location.reload(true);
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });
        }

        function TestarLogin(idPlanoProduto) {

            if (idPlanoProduto == 0 || idPlanoProduto == undefined)
                idPlanoProduto = "@Model.Id_Cliente_Plano_Produto";

            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/IntegracaoRadiusApiController/TesteLogin")';

            $.ajax({
                url: link,
                type: 'POST',
                dataType: 'json',
                data: {
                    idClientePlanoProduto: idPlanoProduto
                }
            })
            .done(function (data) {

                if (data.result) {

                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                }
                else {

                    if(data.message)
                        Notificar("@RsBase.ATENCAO_", data.message, "warning");
                    else
                        Notificar("@RsBase.ATENCAO_", "Falha ao realizar login", "warning");
                }
            });
        }


        $('#btnInserirAtividade').click(async function () {

            @if (Model.Id != 0)
            {
            <text>
                var data = new FormData();
                let arquivos = [];
                for (let obj of $(`input[type="file"][atividade=${id_atividades_add + 1}]`)){
                    var file = obj.files;
                    for (i = 0; i < file.length; i++) {
                        //Appending each file to FormData object
                        data.append(file[i].name, file[i]);
                        let arrayfile = file[i].name.split('.');
                        const extension = '.' + arrayfile.pop();
                        const filename = arrayfile.join('.');

                        data.append(`Arquivos[${i}].id`, 0);
                        data.append(`Arquivos[${i}].arquivo`, filename);
                        data.append(`Arquivos[${i}].nome_Arquivo`, filename);
                        data.append(`Arquivos[${i}].extensao`, extension);
                    }
                }

                data.append('Id', 0);
                data.append('IdAtendimento', "@Model.Id");
                data.append('DescricaoAcao', encodeURIComponent(tinymce.activeEditor.getContent()));
                data.append('Numero', "@Model.Numero");
                data.append('Usuario', "@User.Identity.GetUserId()");
                data.append('TipoAtividade', $('input[name=TipoAtividade]:checked').val());







                await $.ajax({
                    url: '@Url.Action("GravarAcao", "Atendimento")',
                    type: 'POST',
                    processData: false,
                    contentType: false,
                    data: data,
                    beforeSend: function () {
                        ShowPageLoading();
                    },
                    complete: function () {

                    },
                    fail: function (e) {
                        HidePageLoading();
                    }

                }).done(async function (data) {

                    let retorno = JSON.parse(data);

                    if (retorno.Ok) {
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                        await atualizarHistoricoAtividades();
                    }
                    else {
                        Notificar("@RsBase.ATENCAO_", data.Mensagem, "warning");
                    }

                    HidePageLoading();

                });

                $(`input[type="file"][atividade=${id_atividades_add + 1}]`).each(function (i, obj) {
                    obj.value = null;
                });

            </text>
            }

            else {
            <text>

                if ($(this).attr("editar")) {

                    let atividadeEditar = $(this).attr("editar");
                    $(`#atividadeAdicionarDescricaoAcao${atividadeEditar}`).val(encodeURIComponent(tinymce.activeEditor.getContent()));
                    $(`#atividadeConteudo${atividadeEditar}`).html(tinymce.activeEditor.getContent());
                    tinymce.activeEditor.setContent("");
                    filter_state = {};
                    TagFilter("tagFiles", filter_state);
                    $('#TagLabel').hide();
                    $('#btnInserirAtividade').val("@RsCadastros.INSERIR_ATIVIDADE");
                    $('#btnInserirAtividade').removeAttr('editar');


                    let arquivos = [];
                    for (let obj of $(`input[type="file"][atividade="${atividadeEditar}"]`)) {
                        var file = obj.files;
                        for (i = 0; i < file.length; i++) {

                            let arrayfile = file[i].name.split('.');
                            const extension = '.' + arrayfile.pop();
                            const filename = arrayfile.join('.');

                            arquivos.push({ nome_Arquivo: filename, extensao: extension });
                        }
                    }

                    if (arquivos.length > 0) {
                        $(`#arquivos${atividadeEditar}`).attr(`data-arquivos`, JSON.stringify(arquivos));
                        $(`#arquivos${atividadeEditar}`).html('<label class="btn btn-outline-dark mt-1"><i class="fas fa-folder-open"></i><span class="fs-12"> clique para visualizar lista de arquivos </span></label>');
                    }
                    else {
                        $(`#arquivos${atividadeEditar}`).attr(`data-arquivos`, JSON.stringify([]));
                        $(`#arquivos${atividadeEditar}`).empty();
                    }

                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    return;
                }

                let arquivos = [];
                let atividadeBuscar = id_atividades_add + 1;
                for (let obj of $(`input[type="file"][atividade="${atividadeBuscar}"]`)) {
                    var file = obj.files;
                    for (i = 0; i < file.length; i++) {

                        let arrayfile = file[i].name.split('.');
                        const extension = '.' + arrayfile.pop();
                        const filename = arrayfile.join('.');

                        arquivos.push({ nome_Arquivo: filename, extensao: extension, atividadeBuscar: atividadeBuscar });
                    }
                }

            inserirAtividade({ descricaoAcao: tinymce.activeEditor.getContent(), responsavel: "@User.Identity.GetUserId()", dataCriacao: moment().format('DD/MM/YYYY HH:mm:ss'), mensagenschat: [], mensagens_Chat: false, arquivos: arquivos, origem: "@RsCadastros.MANUAL", tipoAtividade: $('input[name=TipoAtividade]:checked').val() }, id_atividades_add + 1);

            </text>
            }

            id_atividades_add++;
            tinymce.activeEditor.setContent("");
            filter_state = {};
            TagFilter("tagFiles", filter_state);
            $('#TagLabel').hide();

        })


        $(document).on('click','.arquivos',function () {
            const arquivos = JSON.parse($(this).attr('data-arquivos'))
            let conteudo = "";

            for (const arq of arquivos) {

                if (arq.arquivo) {

                    conteudo += `<div class="row mt-3">
                                                    <div class="col-sm-6 text-truncate text-center fs-12">${arq.nome_Arquivo}</div>
                                                    <div class="col-sm-2 text-truncate text-center fs-12">${arq.extensao}</div>
                                                    <div class="col-sm-2 fs-12"><a target="_blank" href="@CONSTANTES.URLPortal/Arquivos/Atendimento/${arq.arquivo}"><i class="fas fa-eye"></i></a></div>
                                                    <div class="col-sm-2 fs-12"><a download href="@CONSTANTES.URLPortal/Arquivos/Atendimento/${arq.arquivo}"><i class="fa fa-download"></i></a></div>
                                                </div>`;
                }
                else {
                    conteudo += `<div class="row mt-3">
                                                    <div class="col-sm-6 text-truncate text-center fs-12">${arq.nome_Arquivo}</div>
                                                    <div class="col-sm-2 text-truncate text-center fs-12">${arq.extensao}</div>
                                                    <div class="col-sm-2 fs-12"><a href="#"><i class="fas fa-eye" onclick="VisuInputFile(${arq.atividadeBuscar},'${arq.nome_Arquivo.replaceAll(" ", "")}','${arq.extensao}')" ></i></a></div>
                                                    <div class="col-sm-2 fs-12"><a onclick="DownloadInputFile(${arq.atividadeBuscar},'${arq.nome_Arquivo.replaceAll(" ","")}','${arq.extensao}')" href="#"><i class="fa fa-download"></i></a></div>
                                                </div>`;
                }
            }


            Swal.fire({
                title: '@RsCadastros.ANEXOS_ATIVIDADE',
                customClass: "swal2-lg",
                showCloseButton: true,
                showConfirmButton: false,
                html:
                    `<div class="mb-3">
                        <div class="row font-weight-bold mb-2 fs-12 mt-2"><div class="col-sm-6">Nome</div><div class="col-sm-2">Extensão</div><div class="col-sm-2">Visualizar</div><div class="col-sm-2">Download</div></div>
                        ${conteudo}
                    </div>`
            })
        })


    $(document).on('change', 'input[type="file"]', function () {

        $(this).click(function () { e.preventDefault(); });


        let atividade = $('#btnInserirAtividade').attr('editar') ? $('#btnInserirAtividade').attr('editar') : id_atividades_add + 1;


        $(this).attr('adicionado', true)
        $(this).attr("atividade", atividade);
        const novo_index = Number($(this).attr('data-index') + 1);
        let newFile = document.createElement("INPUT");
        newFile.setAttribute("type", "file");
        newFile.setAttribute("hidden", "hidden");
        newFile.setAttribute("data-index", novo_index);

        newFile.setAttribute("name", `Files[${novo_index}]`);
        $(this).before(newFile);

        var filter_state = {};

        $(`input[type="file"][atividade=${atividade}]`).each(function (i, obj) {

            if (obj.files.length > 0) {
                filter_state[obj.files[0].name + i] = {
                    label: "",
                    removable: true,
                    getDisplay: () => { return obj.files[0].name },
                    onclick: () => {
                       obj.remove();
                    }
                }
            }
        });


        TagFilter("tagFiles", filter_state)
        $('#TagLabel').show()

    });

    function inserirAtividade(item, i) {
        console.log(item);
        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/IdentityUserapi/FindById?Id=")' + item.responsavel;

        $.ajax({
            url: link,
            type: 'GET',
            //contentType: false,
            //processData: false,
           /* data: item.responsavel*/

        }).done(function (data) {
            nome_responsavel_historico = data.objeto.desc_User;
            etapa_atual = data.etapa_atual;
            historico_atividade();
        })
        function historico_atividade() {
        //${ item.mensagens_Chat ? '<h4 class="fs-14">Descrição de atendimento por Chat</h4>' : '<h4 class="fs-14">Atividade</h4>' }

        const id = "@Model.Id";
        var conteudo = item.html ?? `<p style="white-space: pre-wrap;">${item.descricaoAcao}</p>`;
        var mensagens = "";
        let corTipoAtividade = "#80808057";
        let TipoAtividade = "";

        if (item.tipoAtividade == "1") {
            corTipoAtividade = "#0041f97a";
            TipoAtividade = "@RsCadastros.PUBLICO";
        }
        else if (item.tipoAtividade == "0") {
            corTipoAtividade = "#f900007a";
            TipoAtividade = "@RsCadastros.INTERNO";
        }

        var editarExcluir = `<br/><a class="removerAtividade text-danger" href="#" atividade=${i}><i class="fas fa-trash-alt m-2" style="float:right"></i></a><a href="#iAssuntoAtendimento" class="editarAtividade m-2" atividade=${i}><i class="fas fa-pen m-2" style="float:right"></i></a>`;
        var arquivos = item.arquivos.length > 0 ?
            `<a href="#" id="arquivos${i}" data-arquivos='${JSON.stringify(item.arquivos)}' data-toggle="tooltip" data-placement="bottom" title="@RsCadastros.ARQUIVO" class="text-dark pr-2 arquivos"><label class="btn btn-outline-dark mt-1"><i class="fas fa-folder-open"></i> <span class="fs-12"> clique para visualizar lista de arquivos </span></label></a>` :
            `<a href="#" id="arquivos${i}" data-arquivos='${JSON.stringify(item.arquivos)}' data-toggle="tooltip" data-placement="bottom" title="@RsCadastros.ARQUIVO" class="text-dark pr-2 arquivos"></a>`

        for (var mensagem of item.mensagenschat) {

            if (mensagem.fluxoChat == false) {

                mensagens += `<div class="row justify-content-${mensagem.enviadoPeloSuporte ? "start" : "end"}">
                                                                        <div class="mb-1 mt-1" style="width:50%">
                                                                            <div class="card-body ${mensagem.enviadoPeloSuporte ? "text-left" : "text-right"}>
                                                                                <span class="font-italic" style="color: #357ca5">  ${mensagem.usuario}</span>
                                                                                <span class="text-muted" style="font-size:10px">  &nbsp;${mensagem.dataHora}</span>

                                                                                <p> ${mensagem.mensagem}</p>
                                                                            </div>
                                                                        </div>
                                                                    </div>`;
            }
            else {
                mensagens += `<div class="mb-1 mt-1" style="width:50%">
                                    <div class="${mensagem.enviadoPeloSuporte ? "text-left" : "text-right"}">
                                        <p>${mensagem.dataHora} ${mensagem.mensagem}</p>
                                    </div>
                                  </div>`;
            }
        }

        $("#iDivHistoricoAtividade").prepend(`<div class="card shadow rounded classeAdicionados mb-2" id="atividadeAdicionada${i}">
                                                        <div class="bg-light form-inline" style="padding-top: 15px;border-bottom: 1px solid ${corTipoAtividade};">
                                                            <div class="col-9">
                                                                <p class="" style="margin-bottom: 0;"><strong><span class="text-muted text-captalize">${item.responsavel} - ${nome_responsavel_historico}</span></strong></p>
                                                                <p class="" style="margin-bottom: 0;"><span class="text-muted">origem: ${item.origem}, ${item.dataCriacao}</span></p>
                                                                <p class=""><span class="text-muted">${TipoAtividade}</span></p>
                                                                <p class=""><span class="text-muted">${TipoAtividade}</span></p>
                                                            </div>
                                                            <div class="col-3">
                                                                <span style="float:right" class="ordemAtividade mr-2"><b>${$('.classeAdicionados').length + 1}</b></span>
                                                                ${id == "0" ? editarExcluir : ""}
                                                            </div>
                                                        </div>
                                                    <div class="card-body">
                                                        <div class="content-right-container">
                                                            <div class="content-right">
                                                                <div class="mr-0 mt-3">
                                                                    <div class="container mb-3" id="atividadeConteudo${i}" style="overflow-y: auto;max-height: 300px;">${item.mensagens_Chat ? mensagens : conteudo}</div>
                                                                </div>

                                                                ${arquivos}

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>`);
              @if (Model.Id == 0) {
                <text>

                var quantidadeAdicionar = $(".atividadeAdicionar").length;
        $("#iDivHistoricoAtividade").append(`<input type="hidden" id="atividadeAdicionarDescricaoAcao${i}" class="atividadeAdicionar atividadeAdicionar${i}" name="historico_Atendimento[${quantidadeAdicionar}].descricaoAcao" value='${encodeURIComponent(conteudo)}'>`);
            $("#iDivHistoricoAtividade").append(`<input type="hidden"  class="atividadeAdicionar${i}" name="historico_Atendimento[${quantidadeAdicionar}].usuario" value='@User.Identity.GetUserId()'>`);
            $("#iDivHistoricoAtividade").append(`<input type="hidden"  class="atividadeAdicionar${i}" name="historico_Atendimento[${quantidadeAdicionar}].tipoAtividade" value='${item.tipoAtividade}'>`);

                for (var i = 0; i < item.arquivos.length; i++) {
                    $("#iDivHistoricoAtividade").append(`<input type="hidden" class="atividadeAdicionar${i}" name="historico_Atendimento[${quantidadeAdicionar}].arquivos[${i}].nome_Arquivo" value='${item.arquivos[i].nome_Arquivo}'>`);
                    $("#iDivHistoricoAtividade").append(`<input type="hidden" class="atividadeAdicionar${i}" name="historico_Atendimento[${quantidadeAdicionar}].arquivos[${i}].extensao" value='${item.arquivos[i].extensao}'>`);
                }

                </text>
              }
        }




        }

        var Tipo_AtendimentoSelecionado = null;
        var HandleTipo_Atendimento = function () {
            $('#iTipoAtendimento').on('select2:select select2:unselecting', async function (e) {

                Tipo_AtendimentoSelecionado = e.params.data;



                if (Tipo_AtendimentoSelecionado != undefined && Tipo_AtendimentoSelecionado.id != "@Model.Id_Tipo_Atendimento") {

                    if (Tipo_AtendimentoSelecionado != undefined && Tipo_AtendimentoSelecionado.prioridade_Padrao != '') {

                        $.ajax({
                            url: '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoapi/GetComboPrioridade")',
                            type: 'POST' ,
                         dataType: 'json',
                            data: {
                                Id_Cliente_Plano_Produto: $("#iClientePlanoProduto").val(),
                                    Id_Cliente: $("#iCliente").val(),
                        id_categoria_cliente: id_Categoria_Cliente_selecionado,
                        Tipo_AtendimentoSelecionado: Tipo_AtendimentoSelecionado.id

                        //status: Status
                    }
                        }).done(function (data) {

                            var prioridade_atendimento = data.objeto.prioridade_Atendimento;
                            if (prioridade_atendimento != null) {

                             $('#iPrioridade_Atendimento').val(prioridade_atendimento);
                         } else {
                             $('#iPrioridade_Atendimento').val('');
                         }


                    });

                 /* $('#iPrioridade_Atendimento').val(Tipo_AtendimentoSelecionado.prioridade_Padrao);*/
                    }

                    if (Tipo_AtendimentoSelecionado != undefined && Tipo_AtendimentoSelecionado.categoria_Atendimento != '') {
                        var categoriaBloq = @Json.Encode(CamposObrigatoriosAtendimentoApiController.CampoBloqueado(campos, CamposObrigatoriosAtendimentoEnum.CATEGORIA_ATENDIMENTO));
                        await AddSelect("iCategoriaAtendimento", "@CONSTANTES.URLPortal/api/categoria_atendimentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, Tipo_AtendimentoSelecionado.categoria_Atendimento, "@RsBase.SELECIONE", disabled || categoriaBloq);
                    }
                }

                @if (Model.Id == 0) {
                    <text>
                    $('#iCardScript').empty();
                    if (Tipo_AtendimentoSelecionado != undefined  && Tipo_AtendimentoSelecionado.script) {


                        Swal.fire({
                            title: 'Esse Tipo de Atendimento tem um Script de Atendimento Vinculado, Deseja Preencher agora?',
                            showCancelButton: true,
                            cancelButtonText: 'Não',
                            confirmButtonText: 'Sim',
                            type: 'question',
                            allowOutsideClick: () => !Swal.isLoading(),
                        }).then(result => {
                            if (result.value) {
                                getScriptAtendimento(Tipo_AtendimentoSelecionado.id);
                                $(`#iNavScript`).show();
                            }
                            else {
                                $(`#iNavScript`).fadeOut(150, () => { $(`#iNavScript`).hide(); });
                            }
                        });


                    }
                    else {
                        $(`#iNavScript`).fadeOut(150, () => { $(`#iNavScript`).hide();});
                    }
                    </text>
                }

                if (Tipo_AtendimentoSelecionado != undefined && Tipo_AtendimentoSelecionado.criar_Os_Encerrar != '') {
                    if(Tipo_AtendimentoSelecionado.criar_Os_Encerrar == "1")
                        criar_Os_Encerrar = true;
                    else
                        criar_Os_Encerrar = false;
                }

                //if (Tipo_AtendimentoSelecionado != undefined && Tipo_AtendimentoSelecionado.script != '') {
                //    $("#iLink_Script_Atendimento").show();
                //}
                //else {
                //    $("#iLink_Script_Atendimento").hide();
                //}


            });
        }

    async function getDadosCliente(id,cpf) {

        let retorno;
        await $.ajax({
            url: "@CONSTANTES.URLPortal/api/clienteapi/buscaAtedimento?term=" + id,
            type: 'GET',
            dataType: 'json',

        })
            .done(function (data) {

                if (data[0].value == id) {

                    let obj = data[0];

                    $('#iCpf_Cnpj_Cliente').html(obj.cpF_CNPJ_Cliente);
                    $('#iData_Nascimento').html(obj.data_Nasc_Cliente);
                    $('#iRG_Cliente').html(obj.rG_Cliente);
                    $('#iNomeCliente').html(obj.label);
                    $('#iCategoriaCliente').html(obj.categoria_Cliente);
                    id_Categoria_Cliente_selecionado = obj.id_Categoria_Cliente;
                    $('#iIdentificacaoCliente').html(obj.numero_Contrato);
                    $('#iTelefoneFixo').html(obj.telefone_Fixo);
                    $('#iTelefoneCelular').html(obj.telefone_Celular);
                    $('#iTelefoneRecado').html(obj.telefone_Recado);
                    $('#iNomeRecado').html(obj.nome_Recado);
                    $('#iEmail').html(obj.email_Principal);
                    $('#iClienteHa').html(obj.cliente_Ha + " Dias ");
                    retorno = obj;

                }

            })
            .fail(function () {

            })
            .always(function () {
                try {
                    parent.App.stopPageLoading();
                }
                catch (e) {
                    console.log(e);
                }
            });

        return retorno;
    }

    async function getPlanoProduto(id) {

        let retorno;
        await $.ajax({
            url: "@CONSTANTES.URLPortal/api/planoprodutoapi/GetDadosPlanoProduto?IdClientePlanoProduto=" + id,
            type: 'GET',
            dataType: 'json',

        })
            .done(function (data) {

                if (data.ok) {

                    let obj = data.objeto;

                    $('#iLogin_Radius').html(obj.login_Radius);
                    $('#iSenha_Radius').html(obj.senha_Radius);
                    $('#iPOP').html(obj.pop);
                    $('#iONU').html(obj.onu);
                    $('#iONU').val(obj.id_ONU);
                    $('#iOLT').html(obj.olt);
                    $('#iSlot').html(obj.slot);
                    $('#iPON').html(obj.pon);
                    $('#iCaixa_FTTH').html(obj.caixa_FTTH);
