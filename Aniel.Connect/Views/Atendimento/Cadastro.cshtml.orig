        function DesbloqueioConfianca(idClientePlanoProduto) {
            $.ajax({
                url: "@CONSTANTES.URLPortal/api/IntegracaoRadiusApiController/DesbloqueioConfianca",
                type: "POST",
                data: {
                    idClientePlanoProduto: idClientePlanoProduto,
                    usuario: "@User.Identity.GetUserId()"
                }
            })
                .done(function (data) {
                    if (data.result)
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info")
                    else
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning")
                });
        }

        function ReiniciarOnu() {

            if (!$('#iOLT').html()) {
                Notificar("@RsBase.ATENCAO_", "OLT não identificada", "warning")
            }
            if (!$('#iPON').html()) {
                Notificar("@RsBase.ATENCAO_", "PON não identificada", "warning")
            }
            if (!$('#iONU').html()) {
                Notificar("@RsBase.ATENCAO_", "ONU não identificada", "warning")
            }

            //ShowPageLoading();
            var requestReiniciar = $.ajax({
                url: "@CONSTANTES.URLPortal/api/IntegracaoAtivacaoApiController/ReiniciarONU",
                type: "POST",
                data: {
                    idOLT: "@Model.Id_OLT",
                    idPON: "@Model.Id_PON",
                    idONU: "@Model.Id_ONU"
                }
            })
                .done(function (data) {
                    if (data.result)
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info")
                    else
                        Notificar("@RsBase.ATENCAO_", data.message, "warning")
                    swal.close();
                    //HidePageLoading();
                }).fail(function (jqXHR, textStatus, errorThrown) {
                    Notificar("@RsBase.ATENCAO_", "Ocorreu um erro ao reiniciar ONU", "warning")
                    swal.close();
                });

            var swalRequestReiniciar = Swal.fire({
                        html:'<img src="' + baseUrl + '/Images/loading/loading-spinner-grey.gif"/>&nbsp;&nbsp;<span>Carregando...</br></span>',
                        showCancelButton: false,
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'Abortar',
                        allowOutsideClick: () => false,
                    }).then(async(okay) =>
                    {
                        if (okay.value) {
                            requestReiniciar.abort(); //abortar o request na API
                        }
                    });
        }

        function ResetOnu() {
             ShowPageLoading();
            Swal.fire({
                title: '@RsBase.ATENCAO_',
                //text: "Este procedimento redefinirá as configurações do equipamento, retornando ao padrão de fábrica e aplicando configurações pré-definidas ao equipamento. Deseja prosseguir?",
                html: '<p align="center">Este procedimento redefinirá as configurações do equipamento, retornando ao padrão de fábrica e aplicando configurações predefinidas ao equipamento.</p><p>Deseja prosseguir?</p>',
                showCancelButton: true,
                confirmButtonColor: '#357ca5',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não',
                //target: "#iChecklist"
            }).then(async (okay) => {
                if (okay.value) {
                    //Swal.fire('Recurso ainda está em desenvolvimento.');
                   var requestReiniciar = $.ajax({
                url: "@CONSTANTES.URLPortal/api/IntegracaoAtivacaoApiController/ResetarONU",
                type: "POST",
                data: {
                    idOLT: "@Model.Id_OLT",
                    idPON: "@Model.Id_PON",
                    idONU: "@Model.Id_ONU"
                }
            })
                .done(function (data) {
                    if (data.result)
                        Notificar("@RsBase.INFORMACAO", "Equipamento resetado com sucesso", "info")
                    else
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning")
                    swal.close();
                    //HidePageLoading();
                }).fail(function (jqXHR, textStatus, errorThrown) {
                    Notificar("@RsBase.ATENCAO_", "Ocorreu um erro ao reiniciar ONU", "warning")
                    swal.close();
                });

                }

                HidePageLoading();

            });
        }

        function ReduzirVelocidade(idClientePlanoProduto) {
            $.ajax({
                url: "@CONSTANTES.URLPortal/api/IntegracaoRadiusApiController/ReduzirVelocidade",
                type: "POST",
                data: {
                    idClientePlanoProduto: idClientePlanoProduto
                }
            })
            .done(function (data) {
                if (data.result) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info")

                    const data = oDatatablePlano.data().toArray();
                    data.find(p => p.Id == idClientePlanoProduto).Velocidade_Reduzida = true

                    $("#divAcoesPlanosProdutos").hide();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.message, "warning")
                }
            })
        }

