        var HandleCliente = function () {
            $("#iCliente").unbind("select2:select select2:unselecting");
            $('#iCliente').on('select2:select select2:unselecting', async function (e) {

                var id_cliente = $('#iCliente').val();

                if (@Model.Id == 0) {

                    var enderecoApi = "@CONSTANTES.URLPortal/api/AtendimentoApi/GerarProtocolo?Id_Cliente=" + id_cliente;

                    $.ajax({
                        url: enderecoApi,
                        type: 'GET',
                        dataType: 'json',
                        async: false,

                    }).done(function (data) {

                        if (data.ok) {

                            $("#iNumeroAtendimentoHtml").html(data.idObjeto);
                            $("#iProtocoloHtml").html(data.idObjeto);
                            $("#iNumeroAtendimento").val(data.idObjeto);
                            $("#iProtocolo").val(data.idObjeto);
                            $("#iNomeUsuario").val(Id_Responsavel_nome);

                        }
                        else {
                            //Exibir erro
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                            LimpaControles();
                        }
                    });

                }

                let ClienteSelecionado = e.params.data;

                if (ClienteSelecionado != undefined) {
                    //Pergunta se deseja mesmo atribuir o cliente selecionado ao chat
                    if ("@Model.Numero" && ClienteSelecionado.id != null && !"@Model.Id_Cliente") {

                        var result = await Swal.fire({
                            title: 'Atribuir Cliente a Chat',
                            text: "Desejar atribuir o cliente selecionado ao chat?",
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#3085d6',
                            cancelButtonColor: '#d33',
                            confirmButtonText: '@Html.Raw(RsBase.SIM)',
                            cancelButtonText: '@Html.Raw(RsBase.NAO)'
                        })

                        if (result.dismiss != "backdrop") {
                            ValidaSubmit();
                            $("#iTipoCliente").val(ClienteSelecionado.tipoCliente);
                            dados_parametros_cliente_selecionado = await getDadosCliente(ClienteSelecionado.id, ClienteSelecionado.cpf);
                            await AddSelect("iClienteContrato", "@CONSTANTES.URLPortal/api/clienteContratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, ClienteSelecionado.id, "@Model.Id_Cliente_Contrato", "@RsBase.SELECIONE", false, HandleClienteContrato);
                            DisableSelect("iCliente");
                        }
                    } else {

                        $("#iTipoCliente").val(ClienteSelecionado.tipoCliente);
                        dados_parametros_cliente_selecionado = await getDadosCliente(ClienteSelecionado.id, ClienteSelecionado.cpf);

                        if (!!"@Model.Numero") {

                            let contrato = "@Model.Id_Cliente_Contrato";
                            let plano = "@Model.Id_Cliente_Plano_Produto";

                            if (contrato) {
                                await AddSelect("iClienteContrato", "@CONSTANTES.URLPortal/api/clienteContratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, ClienteSelecionado.id, contrato, "@RsBase.SELECIONE", false, HandleClienteContrato);
                            }
                        } else {
                            await AddSelect("iClienteContrato", "@CONSTANTES.URLPortal/api/clienteContratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, ClienteSelecionado.id, null, "@RsBase.SELECIONE", false, HandleClienteContrato);
                        }
                    }
                }
                else {
                    AddSelect("iClienteContrato", "@CONSTANTES.URLPortal/api/clienteContratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleClienteContrato);
                }

            });
        };

    var HandleClientePlanoProduto = function () {
        $("#iClientePlanoProduto").unbind("select2:select select2:unselecting");
        $('#iClientePlanoProduto').on('select2:select select2:unselecting', async function (e) {
