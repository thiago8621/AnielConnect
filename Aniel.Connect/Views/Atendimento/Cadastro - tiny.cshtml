    function readImage() {

        var extensoesPermitidasImagem = /(.jpeg|.jpg|.gif|.png|.bmp|.tiff)$/i;
        var extensoesPermitidasVideo = /(.mpeg|.mp4|.quicktime|.webm|.3gpp|.3gpp2|.3gpp-tt|.H261|.H263-1998|.H263-2000|.H264)$/i;
        var extensoesPermitidasAudio = /(.L24|.mp3|.mpeg|.ogg|.vnd.rn-realaudio|.vnd.wave|.3gpp|.3gpp2|.ac3|.webm|.amr-nb|.amr|.snd|.au)$/i;
        var extensoesPermitidasArquivo = /(.vcard|.pdf|.directory|.calendar|.richtext|.rtf|.x-vcard|.doc|.docx|.xls|.xlx)$/i;

        if (this.files && this.files[0]) {
            var file = new FileReader();

            var patch = this.files[0].name;
            if (extensoesPermitidasImagem.exec(patch)) {
                file.onload = function (e) {
                    document.getElementById("preview").src = e.target.result;
                };
            } else if (extensoesPermitidasVideo.exec(patch)) {
                document.getElementById("preview").src = `@{@CONSTANTES.URLPortal}/Content/images/video.svg`;
            } else if (extensoesPermitidasAudio.exec(patch)) {
                document.getElementById("preview").src = `@{@CONSTANTES.URLPortal}/Content/images/audio.svg`;
            } else {
                document.getElementById("preview").src = `@{@CONSTANTES.URLPortal}/Content/images/file.svg`;
            }

            file.readAsDataURL(this.files[0]);
        }
        document.getElementById("anexosSelecionados").style.display = 'block';
        document.getElementById("nameAnexo").value = this.files[0].name;
    }

