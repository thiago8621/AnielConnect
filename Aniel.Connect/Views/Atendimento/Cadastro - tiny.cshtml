        function DownloadInputFile(atividade, nome_Arquivo, extensao) {
            file = $(`input[type='file'][atividade="${atividade}"]`)[0].files[0];
            fr = new FileReader();
            fr.readAsDataURL(file);

            var blob = new Blob([file], { type: "application/octet-binary" });


            var objectURL = window.URL.createObjectURL(blob);
            console.log(objectURL);

            if (navigator.appVersion.toString().indexOf('.NET') > 0) {
                window.navigator.msSaveOrOpenBlob(blob, nome_Arquivo + extensao);
            } else {
                var link = document.createElement('a');
                link.href = objectURL;
                link.download = nome_Arquivo + extensao;
                document.body.appendChild(link);
                link.click();
                link.remove();
            }
        }

