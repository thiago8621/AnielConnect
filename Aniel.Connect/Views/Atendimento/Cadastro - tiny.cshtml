    function aprovarAuditoria() {

        Swal.fire({
            title: 'Deseja Aprovar Auditoria?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#00FF00',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Sim',
            cancelButtonText: 'Não',
            reverseButtons: true,
        }).then((confirmado) => {
            if (confirmado) {
                Swal.fire({
                    title: 'Insira uma justificativa',
                    input: 'textarea',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    inputValidator: (value) => {
                        if (!value) {
                            return 'Campo obrigatório'
                        }
                    }
                }).then((justificativa) => {
                    ShowPageLoading();

                    $.ajax({
                        type: "POST",
                        url: "@CONSTANTES.URLPortal/api/AtendimentoApi/AprovarAuditoria",
                        dataType: "json",
                        contentType: "application/json; charset=utf-8",
                        data: JSON.stringify({
                            id: '@Model.Id',
                            justificativa: justificativa.value
                        }),
                        success: function (response) {
                            document.location.reload(true);
                        }
                    });
                })
            }
        })

    }


    $("#iConfirmarAtribuirPlano").on("click", async function () {
        const Plano_ProdutoAtri = $('#iPlanoProdutoAtribuir').val();
        const id_Atendimento = '@Model.Id';
        const id_Cliente = '@Model.Id_Cliente';
        $("#divProgress").show();
        var resultado = await getContratoPlanoProduto($("#iPlanoProdutoAtribuir").val());
        if (resultado.status_PlanoProdutoStr == "Aguardando aprovação da venda" || resultado.status_PlanoProdutoStr == "Venda Cancelada" || resultado.status_PlanoProdutoStr == "Cancelado (Mudança de Plano)" ||
            resultado.status_PlanoProduto == "6" || resultado.status_PlanoProduto == "7" || resultado.status_PlanoProduto == "8") {
            Notificar("@RsBase.ATENCAO_", "Atenção!!! Não foi possível criar ordem de Serviço, pois o plano / produto está AGUARDANDO APROVAÇÃO DA VENDA ou CANCELADO.", "warning");
            $("#divProgress").hide();
            return false;
        }

        var retornoOS = await $.ajax({
            url: `@CONSTANTES.URLPortal/api/Atendimentoapi/GetOrdensServicos_TrocaEndereco?IdCliente=${id_Cliente}&IdClientePlanoProduto=${Plano_ProdutoAtri}`,
            type: 'GET',
            dataType: 'json',
            beforeSend: function () {
                $("#divProgress").show();
            }
        });

        if (retornoOS.length > 0) {
            var html = `Atenção! Cliente já possui uma troca de endereço pendente para este plano/produto {trocarNrOS} Por favor trate a OS (baixando ou cancelando) e depois tente trocar o endereço novamente.\n`;
            var numOs = ``;
            for (var i = 0; i < retornoOS.length; i++) {
                numOs += `Ordem de Serviço gerada Nº ${retornoOS[i].numero_Obra_Original};\n`;
            }
            html = html.replace("{trocarNrOS}", numOs);
            const _resultSwalConsultaOS = await Swal.fire({
                text: html,
                type: 'question',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'OK',
            });

            $("#divProgress").hide();
            return false;
        } else {
            $("#divProgress").hide();
        }

        let urlos = '@Url.Action("Criar_Ordem_Servico", "Painel_Servicos")' + '?Id_Atendimento=' + id_Atendimento + '&Id_PlanoProdutoAt=' + Plano_ProdutoAtri + '&Id_Cliente=' + id_Cliente;
        AddAba(urlos);
        $("#modal-atribuirPlanoProduto").modal("hide");
    });

