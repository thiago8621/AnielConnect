                    idOLT: "@Model.Id_OLT",
                    idPON: "@Model.Id_PON",
                    idONU: "@Model.Id_ONU"
                }
            })
                .done(function (data) {
                    if (data.result) {
                        HidePageLoading();
                        Notificar("@RsBase.INFORMACAO", "Equipamento resetado com sucesso", "info")
                    }
                    else
                    {
                        HidePageLoading();
                        Notificar("@RsBase.ATENCAO_", data.mensagem, "warning")
                    }

                    swal.close();
                    //HidePageLoading();
                }).fail(function (jqXHR, textStatus, errorThrown) {
                    Notificar("@RsBase.ATENCAO_", "Ocorreu um erro ao reiniciar ONU", "warning")
                    swal.close();
                });

                }



            });
        }

