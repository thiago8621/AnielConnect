                //target: "#iChecklist"
            }).then(async (okay) => {
                ShowPageLoading();
                if (okay.value) {
                    //Swal.fire('Recurso ainda está em desenvolvimento.');
                   var requestReiniciar = $.ajax({
                url: "@CONSTANTES.URLPortal/api/IntegracaoAtivacaoApiController/ResetarONU",
