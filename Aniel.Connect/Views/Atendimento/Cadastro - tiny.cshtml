            let pesquisaSatisfacao = $('#iPesquisaSatisfacao option:selected').val();
            let usuario = "@User.Identity.GetUserId()";
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/pesquisa_SatisfacaoApi/Enviar")' + `?Id_Cliente=@Model.Id_Cliente&Id_Pesquisa=${pesquisaSatisfacao}&Usuario=${usuario}`;
