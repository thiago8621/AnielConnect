    var HandleClienteContrato = function () {
        $("#iClienteContrato").unbind("select2:select select2:unselecting");
        $("#iClienteContrato").on('select2:select select2:unselecting', async function (e) {
            let ContratoSelecionado = e.params.data;
            if (ContratoSelecionado) {
                if ("@Model.Id_Cliente" > 0 && "@Model.Id_Cliente_Contrato" > 0 && "@Model.Id_Cliente_Plano_Produto" > 0) {
                    await AddSelect("iClientePlanoProduto", "@CONSTANTES.URLPortal/api/clienteapi/GetComboClientePlanoProduto", @CONSTANTES.PaginacaoRegistros, "@Model.Id_Cliente_Contrato", "@Model.Id_Cliente", "@Model.Id_Cliente_Plano_Produto", "@RsBase.SELECIONE", false);
                } else {
                    await AddSelect("iClientePlanoProduto", "@CONSTANTES.URLPortal/api/clienteapi/GetComboClientePlanoProduto", @CONSTANTES.PaginacaoRegistros, ContratoSelecionado.id, $('#iCliente').val(), null, "@RsBase.SELECIONE", false);
                }
            } else {
                $("#iClientePlanoProduto").prop("disabled", true);
                $("#iClientePlanoProduto").addClass("readonly");
                await AddSelect("iClientePlanoProduto", "@CONSTANTES.URLPortal/api/clienteapi/GetComboClientePlanoProduto", @CONSTANTES.PaginacaoRegistros, null, $('#iCliente').val(), null, "@RsBase.SELECIONE", true);
            }
            getLimpaCampos();
        });
    };

