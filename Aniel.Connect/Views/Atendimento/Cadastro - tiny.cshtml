                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">

                                    <center>
                                        <iframe id="iHistoricoAtendimentoFrame1"
                                                scrolling='auto'
                                                style="width:100%; height: 400px"
                                                allowtransparency='false'
                                                frameBorder='0'></iframe>
                                    </center>
                                    <div class="form-group col-sm-12" style="padding: 15px;">
                                        <div class="text-center">
                                            <button type="button" class="btn btn-danger" data-dismiss="modal" aria-label="Close" id="iLimparFiltroModal">Cancelar </button>
                                            <button type="button" onclick="SwalVincularAtendimento();" class="btn btn-success" id="btnAdicionarFluxo">Vincular</button>
                                        </div>
                                    </div>
                                </div>
                            </div><!-- /.modal-content -->
                        </div><!-- /.modal-dialog -->
                    </div><!-- /.modal-->

                    <div class="modal" id="modal-atribuirPlanoProduto">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h4 class="modal-title text-muted">@RsCadastros.PLANOSPRODUTOS_CLIENTE</h4>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">

                                    <div class="container" style="align-content:center;">
                                        <!--Filtro por data de Abertura OS-->
                                        <div class="row">
                                            <div class="col-sm-12">
                                                <div class="form-group">
                                                    <label for="iPlanoProdutoAtribuir">@RsCadastros.PLANOSPRODUTOS_CLIENTE:</label>
                                                    @Html.DropDownListFor(m => m.Plano_ProdutoAtri, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iPlanoProdutoAtribuir", @autocomplete = "off" })
                                                </div>
                                            </div>
                                        </div>


                                        <div class="form-group col-sm-12" style="padding: 15px;">
                                            <div class="text-center">
                                                <button type="button" class="btn btn-success" id="iConfirmarAtribuirPlano">Confirmar</button>
                                            </div>
                                        </div>


                                    </div>
                                </div>
                            </div><!-- /.modal-content -->
                        </div><!-- /.modal-dialog -->
                    </div><!-- /.modal-->


                </div>
            </div>
        </div>
    </div>
}

