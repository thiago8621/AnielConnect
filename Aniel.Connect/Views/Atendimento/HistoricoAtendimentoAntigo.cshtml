@model Aniel.Connect.Models.AtendimentoHistoricoCadastroModel

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Models
@using Aniel.Connect.Core.Helpers

@{
    ViewBag.Title = RsCadastros.HISTORICO_ATENDIMENTO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    //ViewBag.URLArquivo = String.Format("{0}/Arquivos/Atendimento/{1}", CONSTANTES.URLPortal, Model.Id);
    //ViewBag.URLArquivo = String.Format("C:/Checkouts/Connect/Aniel.Connect/Aniel.Connect/Aniel.Connect/Arquivos/Atendimento");
}

@section scripts{
    <script src="~/bin/Scripts/download.js"></script>



    <!--Usando link para imprimir a página atual-->
    <script>
        $('.printMe').click(function () {
            window.print();
        });

        $('.arquivos').click(function () {
            const arquivos = JSON.parse($(this).attr('data-arquivos'))
            let conteudo = ""

            for (const arq of arquivos) {
                conteudo += `<div class="row mt-3">
                                                    <div class="col-sm-6 text-truncate text-center fs-12">${arq.Nome_Arquivo}</div>
                                                    <div class="col-sm-3 text-truncate text-center fs-12">${arq.Extensao}</div>
                                                    <div class="col-sm-3 fs-12"><a target="_blank" href="${arq.Arquivo}"><i class="fas fa-eye"></i></a></div>
                                                </div>`
            }


            Swal.fire({
                title: 'Anexos da Ação',
                customClass: "swal2-lg",
                showCloseButton: true,
                showConfirmButton: false,
                html:
                    `<div class="mb-3">
                        <div class="row font-weight-bold mb-2 fs-12 mt-2"><div class="col-sm-6">Nome</div><div class="col-sm-3">Extensão</div><div class="col-sm-3">Visualizar</div></div>
                        ${conteudo}
                    </div>`
            })
        })

        /**/</script>
}


@section styles
{
    <link href="~/Content/timeline.css" rel="stylesheet" />
    <style>
        .swal2-lg {
            width: 500px !important
        }
    </style>
}

<script>



    function AcompanhamentoClick() {
        ShowPageLoading();
        window.location.href = '@Url.Action("Cadastro", "Atendimento")' + '?Id=' + '@Model.Id';
        return true;
    };

</script>


@Html.HiddenFor(model => model.Id, new { @id = "iId" })

<div style="padding:10px">
    <div class="card-body" style="border:none;">
        <div class="card" style="border:none;">
            <div class="row">
                <div class="col-sm-6">
                    <h4 class="title-page"><i class="fas fa-history"></i> @ViewBag.Title</h4>

                    <nav aria-label="breadcrumb" style="font-size:12px" class="mb-3">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item" style="margin-left:22px; margin-top:-18px">
                                <a href="@Url.Action("Index", "Atendimento")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_ATENDIMENTO</a>
                            </li>
                            <li class="breadcrumb-item" style="margin-top:-18px">

                                <a href="#" id="iAcompanhamento" onclick="return AcompanhamentoClick();" style="color:#367fa9">@RsCadastros.ACOMPANHAMENTO_ATENDIMENTO</a>

                            </li>
                            <li class="breadcrumb-item" style="margin-top:-18px">
                                <span>@ViewBag.Title</span>
                            </li>

                        </ol>
                    </nav>

                    <span style="font-size:11px" id="dtLegend"></span>
                </div>

                <div class="col-sm-2 mt-4 offset-4">
                    <div class="btn-group-sm" role="group" aria-label="Basic example">

                        <a href="@Url.Action("Cadastro", "Atendimento", new { Id = Model.Id })" class="btn btn-outline-dark" onclick="ShowPageLoading(); return true;"><i class="fas fa-plus"></i> Nova Ação</a>

                        <a href="#" class="btn-pdf pl-2 printMe"><i class="far fa-file-pdf"></i></a>

                    </div>
                </div>
            </div>

            <!--Número Atendimento-->
            <div class="col-sm-12 pl-4 ml-4">
                <label for="iNome" class="text-bold-card text-muted fs-12"># @Model.Numero - @Model.Assunto</label>
                <span id=""></span>
                <br>
                <label for="iNome" class="text-bold-card text-muted fs-12">@RsCadastros.TIPO_ATENDIMENTO: </label>
                <span class="text-muted fs-12"> @Model.Tipo_Atendimento</span>
                <br>
                <label for="iNome" class="text-bold-card text-muted fs-12">@RsCadastros.DATA_LIMITE: </label>
                <span class="text-muted fs-12"> @Model.Data_Limite</span>
            </div>



            @foreach (var item in Model.Historico_Atendimento)
            {
                <!-- Vertical Timeline -->



                <section id="conference-timeline" style="max-width:inherit">
                    @*<div class="timeline-start">Início</div>*@



                    <div class="conference-timeline-content">

                        <div class="conference-center-line" style="top:0;height: 100vh !important;left: 24% !important;">
                            <div class="meta-date" style="margin-left:-27px;margin-top: 40px;z-index: 1; position: absolute;">
                                <span class="date"><i class="far fa-dot-circle iTimeLine" style="color: @item.Cor_SLA;font-size: 350%;background: #fff;"></i></span>
                            </div>
                        </div>


                        <div class="timeline-article">

                            <div class="content-left-container" style="width: auto !important;">
                                <div class="content-left">
                                    <p class="text-left">@item.DataCriacao</p>
                                    <p class="text-left">@RsCadastros.USUARIO: <span class="text-muted">@(item.Usuario ?? "-")</span></p>
                                </div>
                            </div>



                            <div class="content-right-container">
                                <div class="content-right">
                                    <p class="mt-3">Responsável: <span class="text-muted">@(item.Responsavel ?? "-")</span></p>

                                    <p>Setor: <span class="text-muted">@(item.Setor ?? "-")</span></p>
                                    <p>Status: <span class="text-muted">@item.Status</span></p>
                                    <div class="mr-0 mt-3">
                                        @if (item.Mensagens_Chat)
                                        {
                                            <h4 class="fs-16">Descrição de atendimento por Chat</h4>
                                        }
                                        else
                                        {
                                            <h4 class="fs-16">Ação</h4>
                                        }
                                    <div class="container mb-3" style="overflow-y: auto;max-height: 300px;">

                                        @if (item.Mensagens_Chat)
                                        {
                                            foreach (var acao in Json.Decode<List<Mensagem_ChatModels>>(item.DescricaoAcao))
                                            {
                                                <div class="row justify-content-@(acao.enviadoPeloSuporte ? "start" : "end")">
                                                    <div class="mb-1 mt-1" style="width:50%">
                                                        <div class="card-body @(acao.enviadoPeloSuporte ? "text-left" : "text-right")">
                                                            <span class="font-italic" style="color: #357ca5"> @(acao.enviadoPeloSuporte ? "Suporte" : "Cliente")</span>
                                                            <span class="text-muted" style="font-size:10px">  &nbsp;@acao.dataHora</span>

                                                            <p> @Html.Raw(acao.mensagem)</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }

                                        else if(!String.IsNullOrEmpty(item.HTML))
                                        {
                                            @Html.Raw(item.HTML)
                                        }
                                        else
                                        {
                                            <p style="white-space: pre-wrap;">@Html.Raw(item.DescricaoAcao)</p>
                                        }

                                    </div>
                                        @if (item.Arquivos.Count() > 0)
                                        {
                                            <a href="#" data-arquivos="@Json.Encode(item.Arquivos)" data-toggle="tooltip" data-placement="bottom" title="@RsCadastros.ARQUIVO" class="text-dark pr-2 arquivos"><i class="fas fa-paperclip fa-1x"></i></a>
                                        }
                                    </div>
                                </div>
                            </div>




                            @*<div class="meta-date">
                                    <span class="date"><i class="far fa-dot-circle iTimeLine" style="color:@item.Cor_SLA"></i></span>
                                </div>*@
                        </div>



                    </div>
                </section>
                <!-- // Vertical Timeline -->

            }



        </div>
    </div>
</div>