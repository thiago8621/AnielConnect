@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5


@{
    ViewBag.Title = RsCadastros.PAINEL_ATENDIMENTOS;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@{
    List<AreaModuloModel> _areas = ViewBag.Areas;

}

@section scripts {

    <script>
        $(document).ready(function () {

            @if(Request.Params["AtualizarNomeEmpresa"] == "S"){
                <text>
                    try {
                        parent.AtualizarNomeEmpresa();
                    }
                    catch{
                        console.log("erro ao tentar atualizar o nome da empresa")
                    }
                </text>
            }
            OrdenarUls();
        });

    </script>

}

<div class="container-fluid" id="divTitle">
    <div class="row">

        <div class="col-auto mr-auto pl-0">
            <h4 class="title-page"><i class="fas fa-headset"></i> @ViewBag.Title</h4>
        </div>

    </div>


    <div class="row pl-4" style="margin-top: -10px;">

        @if (AcessoHelper.TemAcessos(_areas, "178"))
        {  // Visualizar Atendimentos do Painel de Atendimentos
            <div class="col-sm-3">
                <div class="row">
                    <i class="fas fa-headset" style="margin-top: 16px;"></i>
                    <p class="pConfig mt-3"><u>@RsCadastros.ATENDIMENTOS</u></p>
                </div>
                <div class="text-left">
                    <ul class="ulConfig">

                        @if (AcessoHelper.TemAcesso(_areas, "04")) // Visualizar Atendimento

                        {
                            <li class="liConfig"><a href="@Url.Action("Listagem_Atendimento", "Atendimento")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_ATENDIMENTO</a></li>
                        }

                    </ul>
                </div>
            </div>
        }

        @if (AcessoHelper.TemAcessos(_areas, "181")) // Visualizar Atendimentos Via Chat
        {
            <div class="col-sm-3">
                <div class="row">
                    <i class="fas fa-comments" style="margin-top: 16px;"></i>
                    <p class="pConfig mt-3"><u>@RsCadastros.ATENDIMENTOS_VIA_CHAT</u></p>
                </div>
                <div class="text-left">
                    <ul class="ulConfig">

                        @if (AcessoHelper.TemAcesso(_areas, "179"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Acompanhamento_Agentes", "Atendimento")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.ACOMPANHAMENTO_AGENTES</a></li>
                        }

                        @if (AcessoHelper.TemAcesso(_areas, "180"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Acompanhamento_Atendimentos", "Atendimento")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.ACOMPANHAMENTO_ATENDIMENTOS</a></li>
                        }
                        
                        @if (AcessoHelper.TemAcesso(_areas, "180"))
                        {
                            <li class="liConfig"><a href="@Url.Action("Painel_Atendimento", "Atendimento")" class="aConfig" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_CONVERSAS_CHAT_ATENDIMENTO</a></li>
                        }



                    </ul>
                </div>
            </div>
        }

    </div>

</div>
