                //    }
                //});

            if ($('#iOLT').html() && $('#iPON').html() && $('#iONU').html()) {
                let promiseStatusSinal = $.ajax({
                    url: `@CONSTANTES.URLPortal/api/IntegracaoAtivacaoApiController/DiagnosticoONU`,
                    type: "POST",
                    data: {
                        idOLT: $('#iOLT').html(),
                        idPON: $('#iPON').html(),
                        idONU: "@Model.Id_ONU"
                    }
                })
                    .done(function (data) {
                        if (data.rx) {

                            if (data.rx != "0") {
                                $('.SinalPlano').html("@RsCadastros.ONLINE");
                            }
                            else {
                                $('#accordion_infoPlano').show();
                                $('#accordion_infoCliente').show();
                                $('#accordion_Atendimento').show();
                                $('#accordion_Chat').show();

                                $('.SinalPlano').html("@RsCadastros.OFFLINE");
                            }

                        }
                        else {
                            $('#accordion_infoPlano').show();
                            $('#accordion_infoCliente').show();
                            $('#accordion_Atendimento').show();
                            $('#accordion_Chat').show();

                            $('.statusSinal').show();
                            $('.SinalPlano').html("@RsCadastros.NAO_FOI_POSSIVEL_DETERMINAR_SITUACAO");
                        }
                    });

                listaPromises.push(promiseStatusSinal);
            }
            else {
                $('.statusSinal').hide();
                $('.velocidadeReduzida').hide();
                $('.SinalPlano').hide();
            }

            listaPromises.push(promiseNegociacao);
            listaPromises.push(promiseInadimplente);



            Promise.all(listaPromises).then((values) => {

                if ($('#iVelocidadeReduzida').val() == true || $('#iVelocidadeReduzida').val() == "true") {
                    $('#accordion_infoPlano').show();
                    $('#accordion_infoCliente').show();
                    $('#accordion_Atendimento').show();
                    $('#accordion_Chat').show();

                    $('.velocidadeReduzida').show();
                }
                else {
                    $('.velocidadeReduzida').hide();
                }


                if ($('#iStatusPlanoProdutoHidden').val() == 3 || $('#iStatusPlanoProdutoHidden').val() == 4) {
                    $('#accordion_infoPlano').show();
                    $('#accordion_infoCliente').show();
                    $('#accordion_Atendimento').show();
                    $('#accordion_Chat').show();

                    $('.sinalBloqueado').show();
                }
                else {
                    $('.sinalBloqueado').hide();
                }
                @if (Model.Cliente_Status != Status_Cliente.Ativo)
                {
                    <text>
                    $('#accordion_infoPlano').show();
                    $('#accordion_infoCliente').show();
                    $('#accordion_Atendimento').show();
                    $('#accordion_Chat').show();

                    $('.clienteProspectInativo').show();
                    </text>
                }
                else {
                    <text>
                        $('.clienteProspectInativo').hide();
                    </text>
                }

                });

        }


