            //<!--ENVIA AS MENSAGENS DO CHAT-->
        async function sendMessage() {
            var protocolo = $('#protocolo').val();

            const datetime = moment().format("DD/MM/YYYY HH:mm:ss");
            const message = {
                mensagem: $('#inlineFormInputGroupUsername2').val(),
                dataHora: datetime,
                enviadoPeloSuporte: true,
                statusEnvio: 1,
                usuario: "@User.Identity.GetUserId()",
                nome_usuario: getNomeUsuario("@User.Identity.GetUserId()"),
                matriculaUsuario: "@User.Identity.GetUserId()",
                arquivos: [],
                idModeloMensagem: $('#idMensagemModelo').val()
            };


            let obj = $('#iArquivoChat')[0];

            if (obj.files.length > 0) {

                let fileid = create_UUID();
                var data = new FormData();
                data.append("UploadedImage", obj.files[0]);
                data.append("id", fileid);
                var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Atendimentoapi/AdicionarArquivoMensagemChat")';

                //valida o tipo
                var nomeFiles = obj.files[0].name;
                var tipo = 0;
                var extensoesPermitidasImagem = /(.jpeg|.jpg|.gif|.png|.bmp|.tiff)$/i;
                var extensoesPermitidasVideo = /(.mpeg|.mp4|.quicktime|.webm|.3gpp|.3gpp2|.3gpp-tt|.H261|.H263-1998|.H263-2000|.H264)$/i;
                var extensoesPermitidasAudio = /(.L24|.mp3|.mpeg|.ogg|.vnd.rn-realaudio|.vnd.wave|.3gpp|.3gpp2|.ac3|.webm|.amr-nb|.amr|.snd|.au)$/i;
                var extensoesPermitidasArquivo = /(.vcard|.pdf|.directory|.calendar|.richtext|.rtf|.x-vcard|.doc|.docx)$/i;

                if (extensoesPermitidasImagem.exec(nomeFiles)) {
                    tipo = 0;
                } else if (extensoesPermitidasVideo.exec(nomeFiles)) {
                    tipo = 1;
                } else if (extensoesPermitidasAudio.exec(nomeFiles)) {
                    tipo = 2;
                } else if (extensoesPermitidasArquivo.exec(nomeFiles)) {
                    tipo = 3;
                }

                message.arquivos.push({
                    name: removerAcentos(obj.files[0].name),
                    id: fileid,
                    url: "@CONSTANTES.URLPortal" + "/Arquivos/Atendimento/Chat/" + removerAcentos(obj.files[0].name),
                    tipo: tipo,
                });

                let resultUploadArquivo = await $.ajax({
                    url: link,
                    type: 'POST',
                    contentType: false,
                    processData: false,
                    data: data,
                    beforeSend: function () {
                        $("#divProgressUploadArquivo").show();
                    },
                    complete: function () {
                        $("#divProgressUploadArquivo").hide();
                    }
                });

                if (!resultUploadArquivo.ok) {
                    Notificar("@RsBase.ATENCAO_", resultUploadArquivo.mensagem, "warning");
                    return false;
            }
            }

            let sucesso = parent.chat.server.enviarMensagem(protocolo, JSON.stringify(message))
            sucesso.then(x => {
                if (x.message != null) {
                    if (x.message == "{ERROR_NOT_USER}") {
                notifica_bloqueio_chat()
            }
                    else {
                        Notificar("@RsBase.ATENCAO_", x.message, "warning");
            }
                }

                //if (x.result) {
                //    renderMessage(message.mensagem, message.dataHora, message.usuario, true, false, message.arquivos);
                //}
