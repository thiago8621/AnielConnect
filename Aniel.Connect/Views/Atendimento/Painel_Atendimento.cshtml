        async function carregaHistorico(protocolo) {

            listaPromisesReady = [];
            $("#chatFrame").attr("data-pageid", `chat${protocolo}`);

            //Apaga as mensagens anteriores do frame
            $('#messages', $('#chatFrame').contents()).empty();

            $('#protocolo').val(protocolo);

            var mensagens_string = parent.getChatMessages(protocolo);
            listaPromisesReady.push(mensagens_string);
            mensagens_string.then(function (mensagensString) {

                var mensagens = "";
                mensagens = Boolean(mensagensString) ? JSON.parse(mensagensString) : [];

                $('#chatFrame').off('load');
                $("#chatFrame").off('load');
                $('#chatFrame').on('load', function () {


                    parent.iFrameConversaAberto = true;
                    $('#messages', $('#chatFrame').contents()).empty();
                    $('#divProgressChat').fadeOut();
                    for (message of mensagens) {

                        //if (message.usuario == null) {
                        //    message.usuario = 'Não identificado';
                        //}

                        renderMessage(message.mensagem, message.dataHora, message.nome_usuario, message.enviadoPeloSuporte ? true : false, message.fluxoChat, message.arquivos);
                    }


                    if ($('#iOrigem').val() == "-3")
                    {
                        if (mensagens.filter(p => !p.enviadoPeloSuporte).length > 0) {

                            let message = mensagens.filter(p => !p.enviadoPeloSuporte).at(-1);
                            // Data salva no formato dd/MM/yyyy HH:mm
                            const dataSalva = moment(message.dataHora, "DD/MM/YYYY HH:mm");
                            // Data atual
                            const agora = moment();
                            // Verifica se já passaram 24 horas
                            if (agora.diff(dataSalva, 'hours') >= 24)
                            {
                                Notificar("@RsBase.ATENCAO_", "Após 24 horas sem resposta, o WhatsApp impede o envio de novas mensagens espontâneas ao cliente. Para retomar o atendimento, utilize Mensagens Modelo através do ícone de raio.", "warning");
                            }
                            else
                            {
                                $('#inlineFormInputGroupUsername2').removeAttr("readonly");
                            }
                        }
                        else {
                            $('#inlineFormInputGroupUsername2').removeAttr("readonly");
                        }

                    }
                    else
                    {
                        $('#inlineFormInputGroupUsername2').removeAttr("readonly");
                    }



                    if ($("#txtSearch").val()) {
                        var iframe = document.getElementById("chatFrame");
                        var iframeWin = iframe.contentWindow;

                        // pega o jQuery do iframe
                        var $iframe = iframeWin.jQuery;

                        // seta valor e dispara o evento pelo jQuery DELE
                        $iframe("#palavra-chave")
                            .val($("#txtSearch").val())
                            .trigger("input");
                    }
                    else {
                        animateMessageScroll();
                    }
                });

                $("#chatFrame").attr("src", "@Url.Action("Chat_iFrame", "Atendimento")");

                $("#Chat").css({
                    height: $(window).height() - $(window).height() / 6
                });

            });


        }

        async function SwalMensagemModelo() {
            await Swal.fire({
                title: 'Escolha um Modelo de Mensagem',
                text: '',
                icon: 'warning',
                html: `<div class="form-group mb-2 mt-2">
                            <label class="mt-2" for="iModeloMensagem">@RsCadastros.MODELO_PADRAO:</label>
                            <select class="form-control" id="iModeloMensagem"></select>
                        </div>`,
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                cancelButtonText: '@Html.Raw(RsBase.CANCELAR)',
                confirmButtonText: '@Html.Raw(RsBase.ENVIAR_MENSAGEM)',
                onOpen: async () => {
                    var HandleModeloMensagem = function () {
                        $('#iModeloMensagem').on('select2:select select2:unselecting', async function (e) {
                            let ModeloSelecionado = e.params.data;
                            $('#idMensagemModelo').val(ModeloSelecionado.id);
                            $('#idMensagemModelo').attr("data-texto",ModeloSelecionado.textoMensagem);
                        });
                    };

                    await AddSelect("iModeloMensagem", "@CONSTANTES.URLPortal/api/ModeloMensagemApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleModeloMensagem);
                },
                preConfirm: () => {
                    if (ValidaObrigatoriosPorClasse("obrigatorioTransferencia", false)) {
                        return false;
                    }
                    $('#inlineFormInputGroupUsername2').val($('#idMensagemModelo').attr("data-texto"));
                    sendMessage();
                    $('#inlineFormInputGroupUsername2').removeClass("readonly");
                    $("#iSendMessageBtn").off('click');
                    var btn_sendMessage = document.getElementById("iSendMessageBtn");
                    if (btn_sendMessage != null) {
                        $("#iSendMessageBtn").removeClass("readonly");
                        btn_sendMessage.addEventListener("click", function (event) {
                            sendMessage();
                        });
                    }
                },
                onClose: () => {
                    if (!$('#iModeloMensagem').val()) {
                        $('#idMensagemModelo').val("");
                        $('#idMensagemModelo').attr("data-texto", "");
                    }
                }

            });
        }

