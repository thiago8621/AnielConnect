                                    <label for="iNome" class="ml-3" style="font-size: 14px;"> ${i + 1 + " - " + (data.objeto[y].pergunta ?? "")}</label>
                                </h4>`;
                        }
                        appendString += `</div>`;

                        let instrucaoAtendente = data.objeto[y].instrucao_Atendente ? `<div class="card div-card-accord mb-3">
                            <div class="card-header title-card" id="heading-1">
                                <h5 class="mb-0">
                                    <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-1" aria-expanded="true" aria-controls="collapse-1">
                                        <span class="text-bold-card"><i class="fas fa-book-reader"></i> @RsCadastros.EXPLICACAO_OPERADOR</span>

                                    </a>
                                </h5>
                            </div>
                            <div id="collapse-1" class="collapse show" data-parent="#accordion" aria-labelledby="heading-1">
                                <div class="card-body body-card-accord">
                                    <div class="row mt-2 mb-2">


                                        <div class="col-sm-12">
                                            <span>${data.objeto[y].instrucao_Atendente ?? ""}</span>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>` : "";

                        let instrucaoCliente = data.objeto[y].instrucao_Cliente ? `<div class="card div-card-accord mb-3">
                            <div class="card-header title-card" id="heading-2">
                                <h5 class="mb-0">
                                    <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-2" aria-expanded="true" aria-controls="collapse-2">
                                        <span class="text-bold-card"><i class="fas fa-bullhorn"></i> @RsCadastros.EXPLICACAO_CLIENTE</span>
                                    </a>
                                </h5>
                            </div>
                            <div id="collapse-2" class="collapse show" data-parent="#accordion" aria-labelledby="heading-2">
                            <div class="card-body body-card-accord">
                                <div class="row mt-2 mb-2">


                                    <div class="col-sm-12">
                                        <span>${data.objeto[y].instrucao_Cliente ?? ""}</span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        </div>` : "";

                        appendString += ` ${instrucaoAtendente}

                                          ${instrucaoCliente}


                        <div class="card mb-3">
                            <div class="card">
                                <div class="card-header title-card" id="heading-3">
                                    <h5 class="mb-0">
                                        @*<a class="collapsed" role="button" data-toggle="collapse" href="#collapse-3" aria-expanded="true" aria-controls="collapse-3">*@
                                        <span class="text-bold-card"><i class="fas fa-headset"></i> @RsCadastros.RESPOSTA_CLIENTE</span>

                                    </h5>
                                </div>

                                <div id="collapse-3" class="collapse show" data-parent="#accordion" aria-labelledby="heading-3">
                                    <div class="card-body body-card-accord">
                                        <div class="mt-2 mb-2 ml-0 mr-0">`;


