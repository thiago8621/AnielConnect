        function ReiniciarOnu() {

            if (!$('#iOLT').html()) {
                Notificar("@RsBase.ATENCAO_", "OLT não identificada", "warning")
            }
            if (!$('#iPON').html()) {
                Notificar("@RsBase.ATENCAO_", "PON não identificada", "warning")
            }
            if (!$('#iONU').html()) {
                Notificar("@RsBase.ATENCAO_", "ONU não identificada", "warning")
            }

            //ShowPageLoading();
            var requestReiniciar = $.ajax({
                url: "@CONSTANTES.URLPortal/api/IntegracaoAtivacaoApiController/ReiniciarONU",
                type: "POST",
                data: {
                    idOLT: $('#Id_OLT').val(),
                    idPON: $('#Id_PON').val(),
                    idONU: $('#Id_ONU').val()
                }
            })
                .done(function (data) {
                    if (data.result)
                        Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info")
                    else
                        Notificar("@RsBase.ATENCAO_", data.message, "warning")
                    swal.close();
                    //HidePageLoading();
                }).fail(function (jqXHR, textStatus, errorThrown) {
                    Notificar("@RsBase.ATENCAO_", "Ocorreu um erro ao reiniciar ONU", "warning")
                    swal.close();
                });

            var swalRequestReiniciar = Swal.fire({
                        html:'<img src="' + baseUrl + '/Images/loading/loading-spinner-grey.gif"/>&nbsp;&nbsp;<span>Carregando...</br></span>',
                        showCancelButton: false,
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'Abortar',
                        allowOutsideClick: () => false,
                    }).then(async(okay) =>
                    {
                        if (okay.value) {
                            requestReiniciar.abort(); //abortar o request na API
                        }
                    });
        }



