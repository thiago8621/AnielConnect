                        {
                            appendString += `<input type="text" class="form-control" name="RespostasScript[${y}].Resposta">`;

                        }
                        else if (data.objeto[y].tipo_Resposta == 1)
                        {
                            appendString += `<input type="text" class="form-control datepicker" name="RespostasScript[${y}].Resposta">`;
                        }
                        else if (data.objeto[y].tipo_Resposta == 2)
                        {
                            appendString += `input type="text" class="form-control money" name="RespostasScript[${y}].Resposta">`;
