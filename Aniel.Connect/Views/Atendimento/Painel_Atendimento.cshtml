    async function getDadosCliente(id,cpf) {

        let retorno;
        await $.ajax({
            url: "@CONSTANTES.URLPortal/api/clienteapi/buscaAtedimento?term=" + id,
            type: 'GET',
            dataType: 'json',

        })
            .done(function (data) {

                if (data[0].value == id) {

                    let obj = data[0];

                    $('#iCpf_Cnpj_Cliente').html(obj.cpF_CNPJ_Cliente);
                    $('#iData_Nascimento').html(obj.data_Nasc_Cliente);
                    $('#iRG_Cliente').html(obj.rG_Cliente);
                    $('#iNomeCliente').html(obj.label);
                    $('#iCategoriaCliente').html(obj.categoria_Cliente);
                    id_Categoria_Cliente_selecionado = obj.id_Categoria_Cliente;
                    $('#iIdentificacaoCliente').html(obj.numero_Contrato);
                    $('#iTelefoneFixo').html(obj.telefone_Fixo);
                    $('#iTelefoneCelular').html(obj.telefone_Celular);
                    $('#iTelefoneRecado').html(obj.telefone_Recado);
                    $('#iNomeRecado').html(obj.nome_Recado);
                    $('#iEmail').html(obj.email_Principal);
                    $('#iClienteHa').html(obj.cliente_Ha + " Dias ");
                    retorno = obj;

                }

            })
            .fail(function () {

            })
            .always(function () {
                try {
                    parent.App.stopPageLoading();
                }
                catch (e) {
                    console.log(e);
                }
            });

        return retorno;
    }


