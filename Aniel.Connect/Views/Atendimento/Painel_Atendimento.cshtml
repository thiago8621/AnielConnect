        function ChatFrameAtivo() {
            var mensagens_string = parent.getChatMessages($('#protocolo').val());
            listaPromisesReady.push(mensagens_string);
            mensagens_string.then(function (mensagensString) {
                var mensagens = Boolean(mensagensString) ? JSON.parse(mensagensString) : [];

                $("#chatFrame").off('load');
                $('#chatFrame').on('load', function () {

                    parent.iFrameConversaAberto = true;

                    $('#divProgressChat').fadeOut();
                    for (message of mensagens) {
                        renderMessage(message.mensagem, message.dataHora, message.nome_usurio, message.enviadoPeloSuporte ? true : false, message.fluxoChat, message.arquivos);
                    }

                    if ($("#txtSearch").val()) {
                        var iframe = document.getElementById("chatFrame");
                        var iframeWin = iframe.contentWindow;

                        // pega o jQuery do iframe
                        var $iframe = iframeWin.jQuery;

                        // seta valor e dispara o evento pelo jQuery DELE
                        $iframe("#palavra-chave")
                            .val($("#txtSearch").val())
                            .trigger("input");
                    }
                    else {
                        animateMessageScroll();
                    }
                });

                $("#chatFrame").attr("src", "@Url.Action("Chat_iFrame", "Atendimento")");

                $("#Chat").css({
                    height: $(window).height() - $(window).height() / 6
                });

                var iStatusAt = $('#iStatusAtendimento option:selected').val();
                if (iStatusAt == 0 || iStatusAt == 5) {
                    $("#iStatusAtendimento").val("5");
                }

            });

        }

