    let oDatatableUnificar = null;

    function carregarUnificarCliente() {


        if (oDatatableUnificar != null) {
            oDatatableUnificar.destroy();
            $("#datatableUnificar").empty();
            oDatatableUnificar = null;
        }

        oDatatableUnificar = $("#datatableUnificar").length && $("#datatableUnificar").DataTable({
            dom: "frti",
                columnDefs: [{
                    targets: 0,
                    searchable: false,
                    orderable: false,
                    width: '1%',
                    className: 'dt-body-center',
                    render: function (data, type, full, meta) {
                        return "<input type='checkbox'></input>";
                    }
                },
                {
                    targets: 1,
                    searchable: false,
                    orderable: false,
                    width: '1%',
                    className: 'dt-body-center'
                }],
                select: {
                    style: 'single'
                },
                order: [[0, 'asc']],
                serverSide: true,
                searching: true,
                ordering: false,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '50vh',
                scroller: {
                    loadingIndicator: true,
                    rowHeight: 10,
                    boundaryScale: 0.2,
                    displayBuffer: 100
                },
                scrollX: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                ajax: {
                    url: baseUrl + '/api/clienteapi/GetAllUnificarCliente',
                    type: 'POST',
                    data: function (data) {

                        let tipoCadastro = $('#iTipoCadastro option:selected').val();
                        let status = $('#iStatusUnificar option:selected').val();
                        let tipoPessoa = $('#iTipoPessoa option:selected').val();

                        data.tipoCadastro = tipoCadastro;
                        data.status = status;
                        data.tipoPessoa = tipoPessoa;
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                     if($.inArray(rowId, rows_selected) !== -1){
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTable,
                buttons: buttonsDataTable,
                columns: [
                    { title: "", ordering: false },
                    { data: "status", title: "@RsCadastros.STATUS",ordering:false },
                    { data: "tipoCliente", title: "@RsCadastros.TIPO_CADASTRO", ordering: false },
                    { data: "tipoPessoa", title: "@RsCadastros.TIPOPESSOA", ordering: false },
                    { data: "nomeFantasia", title: "@RsCadastros.NOMEFANTASIA", ordering: false },
                    { data: "cpfCnpj", title: "@RsCadastros.CPFCNPJ", ordering: false }
                ]
        });

        $('#txtSearch').val(oDatatableUnificar.search());
        $('#txtSearch').keypress(function (e) {
            if (e.which == 13 || e.keyCode == 13) {
            rows_selected = [];
            oDatatableUnificar.search($(this).val()).draw();
            }
        });

        $('#datatableUnificar tbody').on('click', 'input[type="checkbox"]', function (e) {
            var $row = $(this).closest('tr');

            // Get row data
            var rowId = oDatatableUnificar.row($row).data().id;

            var index = $.inArray(rowId, rows_selected);

            // If checkbox is checked and row ID is not in list of selected row IDs
            if (this.checked && index === -1) {
                rows_selected.push(rowId);

                // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
            } else if (!this.checked && index !== -1) {
                rows_selected.splice(index, 1);
            }

            if (this.checked) {
                $row.addClass('selected');
            } else {
                $row.removeClass('selected');
            }

            // Prevent click event from propagating to parent
            e.stopPropagation();
        });
    }


