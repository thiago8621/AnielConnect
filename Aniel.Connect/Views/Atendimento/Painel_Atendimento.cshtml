        async function atualizarHistoricoAtividades() {
            var link = '@String.Concat(CONSTANTES.URLPortal, "/api/atendimentoapi/FindById_Historico?Id=")' +  $('#iId').val();
            var data = await $.ajax({
                url: link,
                type: 'GET',
