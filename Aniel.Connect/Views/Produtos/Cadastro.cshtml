                    <div role="tabpanel" class="tab-pane" id="iDesconto">
                        <div id="accordion-descontos">
                            <div class="card div-card-accord">
                                <div class="card-header title-card" id="heading-5">
                                    <h5 class="mb-0">
                                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-5" aria-expanded="true" aria-controls="collapse-5">
                                            <span class="text-bold-card">@RsConfiguracao.DESCONTOPRODUTO</span>
                                        </a>
                                    </h5>
                                </div>
                                <div id="collapse-5" class="collapse show" data-parent="#accordion-descontos" aria-labelledby="heading-5">
                                    <div class="card-body body-card-accord">

                                        <div class="row">
                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label for="iUtilizaDesconto" class="mb-1">@RsConfiguracao.DESCONTO ?</label><br>
                                                    @Html.CheckBoxFor(m => m.Utiliza_Desconto, new { @class = "form-control", @id = "iUtilizaDesconto", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                                </div>
                                            </div>
                                            <div class="col-sm-3 d-none" id="iDivDesconto">
                                                <div class="form-group">
                                                    <label for="iDescontoSelect"> @RsCadastros.DESCONTO :</label>
                                                    @Html.DropDownListFor(m => m.Desconto, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iDescontoSelect", @autocomplete = "off" })
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <!--5º Bloco - Configurações Adicionais Produto-->
                    <div role="tabpanel" class="tab-pane" id="iConfiguracoesAdicionais">
                        <div id="accordion-configs-adicionais">
                            <div class="card div-card-accord">
                                <div class="card-header title-card" id="heading-3">
                                    <h5 class="mb-0">
                                        <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-3" aria-expanded="true" aria-controls="collapse-3">
                                            <span class="text-bold-card">@RsConfiguracao.CONFIGURACAOADICIONALPRODUTO</span>
                                        </a>
                                    </h5>
                                </div>
                                <div id="collapse-3" class="collapse show" data-parent="#accordion-configs-adicionais" aria-labelledby="heading-3">
                                    <div class="card-body body-card-accord">


                                        <div class="row">
                                            <div class="col-sm-3">
                                                <div class="form-group">
                                                    <label for="iOsMudacaPlano" class="mb-1">Utiliza Plano adicional?</label>
                                                    <i class="ml-2 fas fa-question-circle fa-2x " style="color: #2092EC"
                                                       data-toggle="popover" title=""
                                                       data-content='Marcando como "Sim" o sistema identifica que este plano/produto não será comercializado sozinho,e exibirá um campo para selecionar todos os
                                                                     planos/produtos que serão vinculados à venda automaticamente, quando o mesmo for adicionado.'></i>
                                                    <br>
                                                    @Html.CheckBoxFor(m => m.UsaPlanoAdicional, new { @class = "form-control", @id = "iUsaPlanoAdicional", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })

                                                </div>
                                            </div>
                                            <!--datatable plano adicional-->
                                            <div id="dataPlanosAdicionais">
                                                <div class="form-group">
                                                    <label>Selecione os Planos/Produtos adicionais:</label>
                                                    @Html.DropDownListFor(m => m.PlanoProduto, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iPlanoProduto", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.PlanoProduto, "", new { @class = "text-danger" })
                                                </div>
                                                <button type="button" class="btn btn-success" id="btnAdicionarPlano">Adicionar</button>

                                            </div>
                                            <div class="col-sm-4" id="listaPlanos">
                                                <div class="card-header title-card" id="heading-3">
                                                    <h5 class="mb-0">
                                                        <a>
                                                            <span class="text-bold-card">Lista dos Planos/Produtos adicionais</span>
                                                        </a>
                                                    </h5>
                                                </div>
                                                <div id="collapse-3" class="collapse show">
                                                    <div class="card-body">
                                                        <table class="table table-hover nowrap" id="datatablePlanos" style="width:100%"></table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mt-3">

                                            <div class="col-sm-3" id="AtivarValidade">
                                                <div class="form-group">
                                                    <label for="Validade" class="mb-1">
                                                        @RsConfiguracao.ATIVARVALIDADE ? <i class="ml-2 fas fa-question-circle fa-2x " style="color: #2092EC"
                                                                                            data-toggle="popover" title=""
                                                                                            data-content="Ao habilitar o sistema identifica que este plano
                                                                     será comercializado por um determinado tempo, ao atingir a data preenchida ele não irá aparecer
                                                                     mais na lista de planos para comercialização" data-trigger="click"></i>
                                                </label>

                                                @Html.CheckBoxFor(m => m.AtivarValidade, new { @class = "form-control", @id = "iAtivarValidade", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                            </div>
                                        </div>

                                        <div class="col-sm-4" id="datavalidade">
                                            <label for="Data_Validade">@RsConfiguracao.VALIDADEPRODUTO :</label><br>
                                            @Html.TextBoxFor(m => m.Data_Validade, new { @id = "iData_Validade", @class = "form-control datepicker-limit", @data_provide = "datepicker", @autocomplete = "off" })
                                            @Html.ValidationMessageFor(m => m.Data_Validade, "", new { @class = "text-danger" })
                                        </div>

                                    </div>



                                    <div class="row mt-3">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label for="iUtilizaVenda" class="mb-1">
                                                    @RsCadastros.UTILIZA_VENDA_AGRUPADA <a href="#" data-toggle="popover"
                                                                                           data-trigger="hover"
                                                                                           data-content='Ao habilitar como "SIM", o usuário poderá definir um valor diferente a ser cobrado,
                                                                                                                                    toda vez que este Plano/Produto for vendido junto com 1 ou mais itens'
                                                                                           data-title=""><i class="ml-2 fas fa-question-circle fa-2x" style="color: #2092EC"></i></a>
                                            </label><br>
                                            @Html.CheckBoxFor(m => m.UtilizaVendaAgroup, new { @class = "form-control", @id = "iUtilizaVendaAgroup", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>

                                    <div class="col-sm-1" id="divVendaAgroup" style="display:none">
                                        <div class="form-group">
                                            <label for="iUtilizaVenda" class="mb-1">Valor em Reais (R$):</label><br>
                                            @Html.TextBoxFor(m => m.ValorVendaAgrupada, new { @class = "form-control money", @id = "iValorVendaAgroup", @placeholder = "0,00" })
                                        </div>
                                    </div>
                                </div>


                                <div class="row mt-3">
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label for="iProRata" class="mb-1">@RsConfiguracao.PRORATA ?</label><br>
                                            @Html.CheckBoxFor(m => m.ProRataProduto, new { @class = "form-control", @id = "iProRata", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3" id="opcoesprorata">
                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label for="iOpcaoProRata" class="mb-1">@RsConfiguracao.OPCAOPRORATA ?</label><br>

                                            @Html.CheckBoxFor(m => m.Pro_Rata_Habilitacao, new { @type = "checkbox", @checked = "checked", @id = "iPro_Rata_Habilitacao" })
                                            <span> @RsConfiguracao.HABILITACAO </span><br>

                                            @Html.CheckBoxFor(m => m.Pro_Rata_Interrupcao, new { @checked = "true", @id = "iPro_Rata_Interrupcao" })
                                            <span> @RsConfiguracao.INTERRUPCAO </span><br>

                                            @Html.CheckBoxFor(m => m.Pro_Rata_Cancelamento, new { @checked = "true", @id = "iPro_Rata_Cancelamento" })
                                            <span> @RsConfiguracao.CANCELAMENTO </span>
                                        </div>
                                    </div>
                                </div>

                                @if (Model.Id == 0)
                                {
                                    <div class="row mt-3">
                                        <div class="col-sm-2">

                                            <label for="iPlano_Comercializavel" class="mr-3">@RsBase.PLANO_COMERCIAL.Replace("Plano", "Produto") </label><br>
                                            @Html.CheckBoxFor(model => model.Plano_Comercializavel, new { @class = "form-control", @id = "iPlano_Comercializavel", @name = "iPlano_Comercializavel", @data_toggle = "toggle", @data_on = RsBase.SIM, @data_off = RsBase.NAO, @data_onstyle = "success", @data_offstyle = "light" })
                                            <i class="ml-2 fas fa-question-circle fa-2x " style="color: #2092EC" data-toggle="popover" title="" data-content="Marcando como NÃO o sistema não apresentará o mesmo para venda ou para vincular ao cliente"></i>
                                        </div>
                                                    <div class="col-sm-2 naoComercializavel">
                                                <div class="form-group">
                                                    <label for="Momento_Cobranca"> @RsCadastros.MOMENTO_COBRAR:</label>
                                                    @Html.EnumDropDownListFor(m => m.Momento_Cobranca, RsBase.SELECIONE, new { @class = "form-control", @id = "iMomento_Cobranca", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.Momento_Cobranca, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                                    <div class="col-sm-3 naoComercializavel">
                                                <div class="form-group">
                                                    <label for="Cobranca_Realizada"> @RsCadastros.COBRANCA_REALIZADA:</label>
                                                    @Html.EnumDropDownListFor(m => m.Cobranca_Realizada, RsBase.SELECIONE, new { @class = "form-control", @id = "iCobranca_Realizada", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.Cobranca_Realizada, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                                    <div class="col-sm-3 naoComercializavel" id="apenasBoleto">
                                                        <div class="form-group">
                                                            <label for="iFormaPagCob"> Selecione a @RsCadastros.FORMA_PAGAMENTO do Boleto:</label>
                                                            @Html.DropDownListFor(m => m.IdFormaPagamentoCob, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iFormaPagCob", @autocomplete = "off" })
                                                            @Html.ValidationMessageFor(model => model.IdFormaPagamentoCob, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-2 naoComercializavel">
                                                        <div class="form-group">
                                                            <label for="iDescricaoPlano">@RsCadastros.DIAS_VENCIMENTO :</label>
                                                            @Html.TextBoxFor(m => m.Dias_Vencimento, new { @class = "form-control", @id = "iDias_Vencimento", @autocomplete = "off" })
                                                            @Html.ValidationMessageFor(model => model.Dias_Vencimento, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>                                                  
                                                </div>
                                }

                                <div class="row mt-3">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="TesteGratis" class="mb-1">@RsCadastros.OS_PREMIER ?</label><br>
                                            @Html.CheckBoxFor(m => m.OsPremier, new { @class = "form-control", @id = "iOsPremier", @data_toggle = "toggle", @data_on = "Sim", @data_off = "Não", @data_onstyle = "success", @data_offstyle = "light" })
                                            @Html.ValidationMessageFor(m => m.OsPremier, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<!--Button Float-->
<a href="@Url.Action("index", "Plano_Produto")" class="float-cancel" onclick="ShowPageLoading(); return true;">
    <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
        <i class="fas fa-times fa-2x"></i>
    </div>
</a>

<a href="#" class="float-save" onclick="return ValidaSubmit();" name="gravar">
    <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
        <i class="fas fa-save fa-2x"></i>
    </div>
</a>
}