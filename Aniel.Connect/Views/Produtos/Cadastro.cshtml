@model Aniel.Connect.Models.ProdutoCadastroModel

@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core

@{
    ViewBag.Title = "Planos/Produtos";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    
}

@section styles
{
    <style>
        @* O datepicker estava sendo cortado pela metade por causa das estruturas de tab,
           aumentando o z-index é possível fazer com que o datepicker apareça por completo *@
        .datepicker {
            z-index: 9999;
        }
        .popover-body {
            background-color: #357CA5;
            color: white;
        }
    </style>
}

@section scripts
{
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples");

    <script>
        $('#iUtilizaVendaAgroup').on('change', function () {
            if ($('#iUtilizaVendaAgroup').is(":checked"))
                $('#divVendaAgroup').show();
            else
                $('#divVendaAgroup').hide();
        });



    $('#iCobranca_Realizada').on("change", function () {

        let valorSelecionado = $("#iCobranca_Realizada").val();

        if (valorSelecionado == "0")
            $("#apenasBoleto").show();
        else if (valorSelecionado == "" || valorSelecionado == undefined) {
            $("#apenasBoleto").hide();
        }
        else
            $("#apenasBoleto").hide();
    });

    $("#iMomento_Cobranca").on("change", function () {

        let valorMomento = $("#iMomento_Cobranca").val();

        if (valorMomento == "1") {
            $('#iCobranca_Realizada option[value="0"]').hide();
        }
        else if (valorMomento == "" || valorMomento == undefined) {
            $('#iCobranca_Realizada').val(null).trigger("change");
        }
        else {
            $('#iCobranca_Realizada option[value="0"]').show();
        }
    });

        $('#iPlano_Comercializavel').prop('checked', true);
        $('#iPlano_Comercializavel').change(function () {

            // Se igual a analitico
            if ($("#iPlano_Comercializavel").is(':checked')) {

                $(".naoComercializavel").hide();
                $("#iMomento_Cobranca").prop('checked', 'false');
                $("#iCobranca_Realizada").prop('checked', 'false');
                $("#iDias_Vencimento").prop('checked', 'false');


            }
            else {
                $(".naoComercializavel").show();//show()
                $("#iMomento_Cobranca").prop('checked', 'true');
                $("#iCobranca_Realizada").prop('checked', 'true');
                $("#iDias_Vencimento").prop('checked', 'true');

            }

        });

        $('#iTipo_Discriminado').change(function () {

            // Se igual a analitico
            if ($('#iTipo_Discriminado').val() == 1) {

                $("#PercntDisc").hide();
                $("#iPercentual_Discriminado").val(null);
                $("#valordisc").show();


            } else if ($('#iTipo_Discriminado').val() == 2) {
                $("#PercntDisc").show();
                $("#valordisc").hide();
                $("#iValor_Discriminado").val(null);
            } else {
                $("#PercntDisc").hide();
                $("#valordisc").hide();
                $("#iValor_Discriminado").val(null);
                $("#iPercentual_Discriminado").val(null);
            }

        });
        $('a[data-toggle="tab"]').on('shown.bs.tab', () => {
            $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle('destroy')
            $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle()
        })

        let global_valor_discriminado_total = 0;
        let global_valor_plano_final = 0;

        const utiliza_eva = @Json.Encode(@ViewBag.UtilizaEva);

        var oDatatable = null;
        var oDatatableMensalidade = null;

        @if (Model.IdContaFinanceiraInstalacao.GetValueOrDefault(0) != 0)
        {
            <text>
                AddSelect("iContaFinanceiraInstalacao", "@CONSTANTES.URLPortal/api/Conta_FinanceiraApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, @Model.IdContaFinanceiraInstalacao, "@RsBase.SELECIONE", false);
            </text>
        }
        else
        {
            <text>
                AddSelect("iContaFinanceiraInstalacao", "@CONSTANTES.URLPortal/api/Conta_FinanceiraApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            </text>
        }

        AddSelect("idContaFinanceiraProduto", "@CONSTANTES.URLPortal/api/Conta_FinanceiraApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Conta_Financeira", "@RsBase.SELECIONE", false);
        AddSelect("iId_Cfop", "@CONSTANTES.URLPortal/api/cfopApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iId_Recibo", "@CONSTANTES.URLPortal/api/Modelo_ReciboApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Recibo", "@RsBase.SELECIONE", false);
        AddSelect("iFormaPagCob", "@CONSTANTES.URLPortal/api/Modelo_ReciboApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Recibo", "@RsBase.SELECIONE", false);


        $('.money').mask('000000000000000,00', { reverse: true });
        $('.percent').mask('000,00', { reverse: true });

        $("input[type='radio'][name='TipoValor']").click(function () {
            var value = $(this).val();

            if (value == 'valor') {
                $('#iValor_Discriminado').removeClass('readonly');
                $('#iPercentual_Discriminado').addClass('readonly');
            }
            else {
                $('#iValor_Discriminado').addClass('readonly');
                $('#iPercentual_Discriminado').removeClass('readonly');
            }
        });

        $('#IFormatoCobranca').change(function () {
            if (!validaProRata()) {
                $('#IFormatoCobranca').val("")
            }
        });

        function validaProRata() {
            if ($("#iProRata").is(':checked')) {
                if ($('#IFormatoCobranca').val() == "0") {
                    Notificar("@RsBase.ATENCAO_", 'Não é Possível Habilitar Pró-Rata e Formato de Cobrança Pré-Pago ao mesmo tempo.', "warning");
                    return false
                }
            }

            return true
        }

        $('#iCobrancaInstalacao').change(function () {
            if ($(this).prop("checked")) {
                $("#divValorInstalacao").show();
                $("#divComprovantePagamentoInstalacao").show();
                $("#divContaFinanceiraInstalacao").show();
                $("#divMomentoCobrancaInstalacao").show();
            }
            else {
                $("#divValorInstalacao").hide();
                $("#divComprovantePagamentoInstalacao").hide();
                $("#divContaFinanceiraInstalacao").hide();
                $("#divMomentoCobrancaInstalacao").hide();
            }
        });

        $('#iComprovantePagamentoInstalacao').change(function () {
            // Se igual a analitico
            if ($('#iComprovantePagamentoInstalacao option:selected').val() == 1) {
                $("#bloconf_instalacao").show();
                $("#cfop").show();
                $("#ModReciboInstalacao").hide();
            }
            else if ($('#iComprovantePagamentoInstalacao option:selected').val() == 2) {

                $("#ModReciboInstalacao").show();
                $("#bloconf_instalacao").hide();
            }
            else {
                $("#bloconf_instalacao").hide();
                $("#ModReciboInstalacao").hide();
            }

        });

        $('#iAtivarValidade').change(function () {
            // Se igual a analitico
            if ($("#iAtivarValidade").is(':checked')) {
                $("#datavalidade").show();
            }
            else {
                $("#datavalidade").hide();
            }
        });

        $('#iPercentualDescontoAntecipado').change(function () {
            if (!$('#iPercentualDescontoAntecipado').val() == "") {

                $('#iValorDescontoAntecipado').prop('disabled', true);
            }
            else {
                $('#iValorDescontoAntecipado').prop('disabled', false);
            }
        });

        $('#iValorDescontoAntecipado').change(function () {
            if (!$('#iValorDescontoAntecipado').val() == "") {

                $('#iPercentualDescontoAntecipado').prop('disabled', true);
            }
            else {
                $('#iPercentualDescontoAntecipado').prop('disabled', false);
            }
        });

        $('#iDescontoProgressivo').change(function () {
            if ($(this).is(':checked'))
                $('#iFaixaMensalidaContainer').show()
            else
                $('#iFaixaMensalidaContainer').hide()
        });

        $('#iPercentualDescontoProgressivo').change(function () {
            if (!$('#iPercentualDescontoProgressivo').val() == "") {

                $('#iValorDescontoProgressivo').prop('disabled', true);
            }
            else {
                $('#iValorDescontoProgressivo').prop('disabled', false);
            }
        });

        $('#iValorDescontoProgressivo').change(function () {
            if (!$('#iValorDescontoProgressivo').val() == "") {

                $('#iPercentualDescontoProgressivo').prop('disabled', true);
            }
            else {
                $('#iPercentualDescontoProgressivo').prop('disabled', false);
            }
        });

        $('#iProRata').change(function () {
            if (!validaProRata()) {
                $('#iProRata').bootstrapToggle('off');
                $('#iProRata').prop("checked",false);
            }

            // Se igual a analitico
            if ($("#iProRata").is(':checked')) {
                $("#opcoesprorata").show();//show()
                $("#iPro_Rata_Habilitacao").prop('checked', 'true');
                $("#iPro_Rata_Interrupcao").prop('checked', 'true');
                $("#iPro_Rata_Cancelamento").prop('checked', 'true');
            }
            else {
                $("#opcoesprorata").hide();
                 $("#iPro_Rata_Habilitacao").prop('checked', 'false');
                $("#iPro_Rata_Habilitacao").prop('checked', 'false');
                $("#iPro_Rata_Habilitacao").prop('checked', 'false');
            }
        });

        $('#iEmitirContrato').change(function () {
            // Se igual a analitico
            if ($("#iEmitirContrato").is(':checked')) {
                $("#mdcontrato").show();
                $("#mdcontratoca").show();
                $("#mdcontratope").show();
            }
            else {
                $("#mdcontrato").hide();
                $("#mdcontratoca").hide();
                $("#mdcontratope").hide();
            }
        });

        $('#iFrequenciaCobranca').change(function () {
            if ($('#iFrequenciaCobranca option:selected').val() == 6) {
                $('#divcomprovantepagamento').hide();
                $('#divformatocobranca').hide();
                $('#iDescContaFinanceiraProduto').hide();
                $('#ModRecibo').hide();
            }
            else {
                $('#divcomprovantepagamento').show();
                $('#divformatocobranca').show();
                $('#iDescContaFinanceiraProduto').show();
                $('#ModRecibo').show();
            }
        });

        $('#iDescontoAntecipado').change(function () {
            // Se igual a analitico
            if ($("#iDescontoAntecipado").is(':checked')) {
                $("#qtddiasvencto").show();
                $("#percentualdesconto").show();
                $("#valordesconto").show();
            }
            else {
                $("#qtddiasvencto").hide();
                $("#percentualdesconto").hide();
                $("#valordesconto").hide();
            }
        });

        $('#iDescontoProgressivo').change(function () {
            // Se igual a analitico
            if ($("#iDescontoProgressivo").is(':checked')) {
                $("#mensalidadeini").show();
                $("#mensalidadefim").show();
                $("#descprogressivo").show();
                $("#valordesc").show();
            }
            else {
                $("#mensalidadeini").hide();
                $("#mensalidadefim").hide();
                $("#descprogressivo").hide();
                $("#valordesc").show();
            }
        });

        $('#iComprovantePagamento').change(function () {
            // Se igual a analitico
            if ($('#iComprovantePagamento option:selected').val() == "1") {
                $("#bloconf").show();
                $("#mdnotafiscal").show();
                $("#cfop").show();
                $("#ModRecibo").hide();
            }
            else if ($('#iComprovantePagamento option:selected').val() == "2") {
                $("#ModRecibo").show();
                $("#bloconf").hide();
            }
            else if ($('#iComprovantePagamento option:selected').val() == "0") {
                $("#bloconf").hide();
                $("#ModRecibo").hide();
            }
            else {
                $("#bloconf").hide();
                $("#ModRecibo").hide();
            }
        });

        $('#iPercentual_Desconto').on("keyup", function () {
            if (!$('#iPercentual_Desconto').val() == "") {
                $('#iValor_Desconto').prop('disabled', true);
            }
            else {
                $('#iValor_Desconto').prop('disabled', false);
            }
        });

        $('#iValor_Desconto').on("keyup", function () {
            if (!$('#iValor_Desconto').val() == "") {
                $('#iPercentual_Desconto').prop('disabled', true);
            }
            else {
                $('#iPercentual_Desconto').prop('disabled', false);
            }
        });

        $('#iModeloNotaFiscal').change(function () {
            // Se igual a analitico
            if ($('#iModeloNotaFiscal option:selected').val() == 1 || $('#iModeloNotaFiscal option:selected').val() == 2) {
                $("#bloconf").show();
                $("#desc_atividade").show();
                $("#retencaoimposto").show();
                $("#pis").show();
                $("#cofins").show();
                $("#Iss").show();
                $("#icms").show();
            }
            else {
                $("#desc_atividade").hide();
                $("#retencaoimposto").hide();
                $("#pis").hide();
                $("#cofins").hide();
                $("#Iss").hide();
                $("#icms").hide();
            }

            if ($('#iModeloNotaFiscal option:selected').val() == 3) {
                $("#bloconf").show();
                $("#retencaoimposto").show();
                $("#pis").show();
                $("#cofins").show();
                $("#Iss").show();
                $("#icms").show();
            }
        });

        $('#iStatusInicial').change(function () {
            let value = $('#iStatusInicial option:selected').val()
            if (value && value == @Convert.ToInt16(Status_PlanoProduto.Aguardando_Criacao_OS)) {
                $('#iTipo_ServicoCol').show();
                $('#iSubtipo_ServicoCol').show();
            }
            else {
                $('#iTipo_ServicoCol').hide();
                $('#iSubtipo_ServicoCol').hide();
            }
        });

         $('#iUsaPlanoAdicional').change(function () {
            // Se igual a analitico
            if ($("#iUsaPlanoAdicional").is(':checked')) {
                $("#listaPlanos").show();
                $("#dataPlanosAdicionais").show();
                $("#iUsaPlanoAdicional").text("Sim");
                @Model.UsaPlanoAdicional = true;
            }
            else {
                $("#listaPlanos").hide();
                $("#dataPlanosAdicionais").hide();
                @Model.UsaPlanoAdicional = false;
            }
         });

        var TipoServicoSelecionado = null;
        var HandleTipoServico = function () {
            $('#iTipo_Servico').on('select2:select select2:unselecting', function (e) {
                TipoServicoSelecionado = e.params.data;
                $('#iSubtipo_Servico').val(null).trigger('change');
                AddSelect("iSubtipo_Servico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, TipoServicoSelecionado.id, null, "@RsBase.SELECIONE", false, HandleSubTipoServico);
                return true;
            });
        };

        var SubTipoServicoSelecionado = null;
        var HandleSubTipoServico = function () {
            $('#iSubtipo_Servico').on('select2:select select2:unselecting', function (e) {
                SubTipoServicoSelecionado = e.params.data;
                return true;
            });
        };

        $(document).ready(function () {

            @if (Model.UtilizaVendaAgroup)
            {
                <text>
                    $('#divVendaAgroup').show();
                </text>
            }


            $("#iEmitirContrato").prop('checked', true).trigger('change');
            $("#mdcontratope").hide();
            $("#EmitirContrato").hide();
            $("#PercntDisc").hide();
            $("#valordisc").hide();
            $("#iSubtipo_ServicoCol").hide();
            $("#iTipo_ServicoCol").hide();
            $(".comerciavel").hide();
            $('#iStatusInicial option').each(function () {
                if (!['@Convert.ToInt16(Status_PlanoProduto.Aguardando_Criacao_OS)', '@Convert.ToInt16(Status_PlanoProduto.Habilitado)', ''].includes($(this).val())){
                    $(this).remove();
                }
            });



            AddSelect("iDescontoSelect","@CONSTANTES.URLPortal/api/Descontoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iTipo_Servico", "@CONSTANTES.URLPortal/api/Tipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Id_Tipo_Servico", "@RsBase.SELECIONE", false, HandleTipoServico);
            AddSelect("iSubtipo_Servico", "@CONSTANTES.URLPortal/api/SubTipo_Servicoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, "@Model.Id_Tipo_Servico", "@Model.Id_Subtipo_Servico", "@RsBase.SELECIONE", false, HandleSubTipoServico);
            AddSelect("iPlanoProduto", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iClassificacaoTributaria", "@CONSTANTES.URLPortal/api/PlanoProdutoApi/GetComboClassificacaoTributaria", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);

            AddSelect("iModeloContrato", "@CONSTANTES.URLPortal/api/Modelo_ContratoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdModeloContrato", "@RsBase.SELECIONE", false, handleModeloContrato);

            $('#iPlano_Comercializavel').trigger('change');
            $('#iReducaoVelocidade').trigger('change');
            $('#iCobrancaInstalacao').trigger('change');
            $('#iComprovantePagamentoInstalacao').trigger('change');

            $('#iAtivarValidade').trigger('change');

            $('#iProRata').trigger('change');

            $('#iUsaPlanoAdicional').trigger('change');

            $('#iEmitirContrato').trigger('change');

            $('#iDescontoAntecipado').trigger('change');

            $('#iDescontoProgressivo').trigger('change');

            $('#iModeloNotaFiscal').trigger('change');

            $('#iValorDescontoProgressivo').trigger('change');

            $('#iValorDescontoAntecipado').trigger('change');

            $('#iPercentualDescontoProgressivo').trigger('change');

            $('#iPercentualDescontoAntecipado').trigger('change');

            $('#iFrequenciaCobranca').trigger('change');

            $('#iComprovantePagamento').trigger('change');
            $('#iDescontoProgressivo').trigger('change');

            $('#iStatusInicial').trigger('change');

            const valor_discriminado_total = oDatatable.data().map(p => parseFloat(p.ValorDiscriminado)).reduce((a, b) => a + b, 0)
            const valor_plano = parseFloat($('#iValorProduto').val().replace(",", "."))
            const valor_plano_final = isNaN(valor_plano) ? 0 : valor_plano

            global_valor_discriminado_total = valor_discriminado_total;
            console.log(valor_discriminado_total);
            global_valor_plano_final = valor_plano_final;
        });

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;

            var erro = false;

            if ($('#iUtilizaVendaAgroup').is(":checked")) {

                let valor = $('#iValorVendaAgroup').val();

                let valorVenda = parseFloat(valor.replace(',', '.')).toFixed(2);

                if (valorVenda < 0.01 || valorVenda == NaN || valorVenda === undefined || valor === "") {
                    Notificar("@RsBase.ATENCAO_", `Obrigatório preencher com valor maior do que zero`, "warning")
                    erro = true;
                }
            }
            if ($("#iUsaPlanoAdicional").is(':checked')) {
                var datas = oDatatablelistaPlanos.rows().data();

                if (datas.length === 0) {
                    Notificar("@RsBase.ATENCAO_", `Atenção! Informe ao menos um Plano/Produto`, "warning")
                    erro = true
                }
            }

            if ($('#iComprovantePagamento').val() === "1") {
                if (global_valor_discriminado_total.toFixed() != global_valor_plano_final) {
                    Notificar("@RsBase.ATENCAO_", `Total da composição da nota fiscal do produto <strong class=text-primary> R$ ${global_valor_discriminado_total} </strong><br> deve ser igual ao valor do produto <strong class=text-danger> R$ ${global_valor_plano_final} </strong>.`, "warning")
                    erro = true
                }
            }

            @if (Model.Id == 0)
            {
                <text>
                    if ($('#iAtivarValidade').is(':checked')) {

                        var data = $('#iData_Validade').val();
                        var partesData = data.split("/");
                        var data = new Date(partesData[2], partesData[1] - 1, partesData[0]);

                        var hoje = new Date().toLocaleDateString();
                        var partesData = hoje.split("/");
                        var hoje = new Date(partesData[2], partesData[1] - 1, partesData[0]);

                        if (data < hoje) {

                            Notificar("Atenção!", '@RsCadastros.INFORME_DATAVALIDA', "warning");
                            erro = true;
                        }

                        if ($('#iData_Validade').val() == "") {
                            Notificar("@RsBase.ATENCAO_", '@RsCadastros.INFORME_DATAVALIDADEPRODUTO', "warning");
                            erro = true;
                        }
                    }
                </text>
            }

            if ($('#iEmitirContrato').is(':checked') && $('#iModeloContrato option:selected').val() == "") {
               Notificar("@RsBase.ATENCAO_", 'Informe o modelo de contrato', "warning");
               erro = true;
            }

            if (utiliza_eva) {
                if (!$('#IFormatoCobranca').val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsConfiguracao.FORMATOCOBRANCA)", "warning");
                    erro = true;
                }

                if(!$('#idContaFinanceiraProduto').val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED,RsConfiguracao.CONTAFINANCEIRA)", "warning");
                    erro = true;
                }

                if (!$('#iFrequenciaCobranca').val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsConfiguracao.FREQUENCIACOBRANCA)", "warning");
                    erro = true;
                }

                if (!$('#iComprovantePagamento').val()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsConfiguracao.COMPROVANTEPAGAMENTO)", "warning");
                    erro = true;
                }
            }

            if ($('#iDescontoAntecipado').is(':checked') && $('#iQtdDiasVencto').val() <= 0) {
                Notificar("@RsBase.ATENCAO_", 'informe a quantidade de dias de vencimento', "warning");
                erro = true;
            }

            if ($('#iDescontoAntecipado').is(':checked')) {
                if ($('#iPercentualDescontoAntecipado').val() == "" && $('#iValorDescontoAntecipado').val() == "") {
                    Notificar("@RsBase.ATENCAO_", 'informe o percentual ou valor de desconto antecipado', "warning");
                    erro = true;
                }
            }

            if ($('#iDescontoProgressivo').is(':checked')) {
                if ($('#iPercentualDescontoProgressivo').val() == "" && $('#iValorDescontoProgressivo').val() == "") {
                    Notificar("@RsBase.ATENCAO_", 'informe o percentual ou valor de desconto progressivo', "warning");
                    erro = true;
                }
            }

            if ($('#iStatusInicial option:selected').val() == @Convert.ToInt16(Status_PlanoProduto.Aguardando_Criacao_OS) &&
                !$('#iTipo_Servico option:selected').val()) {
                Notificar("@RsBase.ATENCAO_", 'Informe um tipo de serviço', "warning");
                erro = true;
            }

            if ($("#iCobrancaInstalacao").prop("checked")) {
