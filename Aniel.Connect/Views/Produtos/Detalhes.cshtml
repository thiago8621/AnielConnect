@model Aniel.Connect.Models.ProdutoDetalhesModels
@{
    ViewBag.Title = "DetalhesPlanoProduto";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

<hr />
<div class="card-body body-card-accord">
    <div class="row">
        <h4 class="text-muted" style="font-size:15px">@RsCadastros.PRODUTO</h4>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <div class="form-group">
                <label>Valor Real:</label>
                <span id="iConsultaValorPlano">@Model.ValorPlano</span>
            </div>
        </div>
    </div>
</div>

<div class="card-header title-card" id="heading-2" style="margin-left:0px">
</div>

<h4 class="text-muted" style="font-size:15px">@RsConfiguracao.DETALHES</h4>

<div class="card-body body-card-accord">
    @Html.DisplayFor(m => m.Detalhes, new { @class = "", id = "iDetalhes" })
</div>

<div class="card-header title-card" id="heading-2" style="margin-left:0px">
</div>

<h4 class="text-muted" style="font-size:15px">Planos/Produtos Adicionais</h4>

<div class="card-body body-card-accord">
    @foreach (var plano in Model.PlanosProdutosAdicionais)
    {
        <p>@plano.Descricao</p>
    }
</div>
