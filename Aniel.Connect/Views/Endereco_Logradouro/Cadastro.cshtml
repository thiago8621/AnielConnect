@model Aniel.Connect.Models.Endereco_LogradouroCadastroModel

@{
    ViewBag.Title = RsCadastros.CADASTRO_ENDERECO_LOGRADOURO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@section scripts
{
    <script>


        const handleArea = async function () {
            $("#iArea").unbind("select2:select select2:unselecting");
            $("#iArea").on("select2:select select2:unselecting", async function (e) {
                const areaSelecionada = e.params.data;

                if (areaSelecionada) {
                    await AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $("#iGrupoArea").val(), String(areaSelecionada.id), null, "@RsBase.SELECIONE", false);
                }
                else {
                    await AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
            });
        };

        const handleGrupo = async function () {
            $("#iGrupoArea").unbind("select2:select select2:unselecting");
            $("#iGrupoArea").on("select2:select select2:unselecting", async function (e) {
                const grupoSelecionado = e.params.data;

                if (grupoSelecionado) {
                    await AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(grupoSelecionado.id), null, "@RsBase.SELECIONE", false, handleArea);
                    await AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
                else {
                    await AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, handleArea);
                }
            });
        };

        $(document).ready(async function () {

            await AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Cod_Escritorio", "@RsBase.SELECIONE", false, handleGrupo);
            await AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Cod_Area", "@RsBase.SELECIONE", true, handleArea);
            await AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Cod_Localidade", "@RsBase.SELECIONE", true);


            if ($("#iCodigo").val() == 0)
                $("#iCodigo").val('')
            $("#iCep").mask("99999-999");

            await AddSelect("iPais", "@CONSTANTES.URLPortal/api/Paisapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Pais", "@RsBase.SELECIONE", false, HandlePais);
            await AddSelect("iUF", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, "@Model.Pais", "@Model.UF", "@RsBase.SELECIONE", false, HandleUf);
            await AddSelect("iCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, "@Model.UF", "@Model.Cidade", "@RsBase.SELECIONE", false, HandleCidade);
            await AddSelect("iBairro", "@CONSTANTES.URLPortal/api/Bairroapi/GetCombo", @CONSTANTES.PaginacaoRegistros, "@Model.UF","@Model.Cidade", "@Model.Bairro", "@RsBase.SELECIONE", false);

            @if (!Model.Pais.HasValue) {<text> $("#iCidade").prop("disabled", true); $("#iBairro").prop("disabled", true); $("#iUF").prop("disabled", true);</text> }


        });

          var PaisSelecionado = null;
          var HandlePais = function () {
              $('#iPais').on('select2:select select2:unselecting', function (e) {
                  PaisSelecionado = e.params.data;

                  if (PaisSelecionado == undefined) {

                      AddSelect("iPais", "@CONSTANTES.URLPortal/api/Paisapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandlePais);
                      $("#iUF").prop("disabled", true);
                      $('#iUF').val(null).trigger('change');
                      $("#iCidade").prop("disabled", true);
                      $('#iCidade').val(null).trigger('change');
                      $("#iBairro").prop("disabled", true);
                      $('#iBairro').val(null).trigger('change');

                  } else {

                      $("#iUF").prop("disabled", false);
                      $('#iCidade').val(null).trigger('change');
                      AddSelect("iUF", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, PaisSelecionado.id, null, "@RsBase.SELECIONE", false, HandleUf);

                  }
            });
          }

          var UfSelecionado = null;
          var HandleUf = function () {
              $('#iUF').on('select2:select select2:unselecting', function (e) {
                  UfSelecionado = e.params.data;
                  if (UfSelecionado == undefined) {

                       AddSelect("iUF", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleUf);

                      $("#iCidade").prop("disabled", true);
                      $('#iCidade').val(null).trigger('change');
                      $("#iBairro").prop("disabled", true);
                      $('#iBairro').val(null).trigger('change');
                  } else {

                      $("#iCidade").prop("disabled", false);
                      AddSelect("iCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, UfSelecionado.id, null, "@RsBase.SELECIONE", false, HandleCidade);
                  }
            });
          }

          var CidadeSelecionada = null;
          var HandleCidade = function () {
              $('#iCidade').on('select2:select select2:unselecting', function (e) {
                  CidadeSelecionada = e.params.data;
                  if (CidadeSelecionada == undefined) {

                       AddSelect("iCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null,null, "@RsBase.SELECIONE", false, HandleCidade);
                      $("#iBairro").prop("disabled", true);
                      $('#iBairro').val(null).trigger('change');

                  } else {

                      $("#iBairro").prop("disabled", false);
                      AddSelect("iBairro", "@CONSTANTES.URLPortal/api/Bairroapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, CidadeSelecionada.id, null, "@RsBase.SELECIONE", false);

                  }
            });
          }

        var BairroSelecionado = null;

        $("#iCep").on('blur',async function (e) {
            if (e.target.value.length == 9) {
                var cep = e.target.value.replace(/\D/g, '');
                var url = 'https://viacep.com.br/ws/' + cep + '/json/';

                ShowPageLoading();
                $.ajax({
                    url: url,
                    type: "GET",
                    success: async function (responseCEP) {
                        if (!responseCEP.erro) {
                            $("#iDescricao").val(responseCEP.logradouro);

                            var cidade = responseCEP.localidade;
                            var bairro = responseCEP.bairro.toUpperCase();
                            var uf = responseCEP.uf.toUpperCase();

                            var enderecoApiCidade = "@CONSTANTES.URLPortal/api/enderecoapi/getcidades?Uf=" + uf;
                            var enderecoApiBairro = "";
                            var enderecoApiPais = "@CONSTANTES.URLPortal/api/enderecoapi/GetPaisViaCep?idPais=" + 1;
                            var enderecoApiUf = "@CONSTANTES.URLPortal/api/enderecoapi/GetUFViaCep?"

                            await $.getJSON(enderecoApiUf,async function (data) {
                                UfSelecionado = data.find(x => x.descricao == uf);

                                $("#iUF").prop("disabled", false);
                                await AddSelect("iUF", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, UfSelecionado.id, "@RsBase.SELECIONE", false, HandleUf);
                            });

                            await $.getJSON(enderecoApiCidade, async function (data) {
                                CidadeSelecionada = data.find(x => x.descricao == cidade);

                                if (CidadeSelecionada != undefined || CidadeSelecionada != null) {
                                    $("#iCidade").prop("disabled", false);
                                    enderecoApiBairro = "@CONSTANTES.URLPortal/api/enderecoapi/GetBairros?Id_Cidade=" + CidadeSelecionada.id;
                                    await AddSelect("iCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, UfSelecionado.id, CidadeSelecionada.id, "@RsBase.SELECIONE", false, HandleCidade);
                                }
                                else
                                    Notificar("@RsBase.ATENCAO_", `Cidade ${cidade} não cadastrada`, "warning");
                            });

                            await $.getJSON(enderecoApiBairro, async function (data) {
                                BairroSelecionado = data.find(x => x.descricao.toUpperCase() == bairro);

                                if (enderecoApiBairro != undefined || enderecoApiBairro != null) {
                                    $("#iBairro").prop("disabled", false);
                                    await AddSelect("iBairro", "@CONSTANTES.URLPortal/api/Bairroapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, CidadeSelecionada.id, BairroSelecionado.id, "@RsBase.SELECIONE", false);
                                }
                                else
                                    Notificar("@RsBase.ATENCAO_", `Bairro ${responseCEP.bairro} não cadastrado`, "warning");
                            });

                            await $.getJSON(enderecoApiPais, async function (data) {
                                $('#iPais').empty();
                                $('#iPais').append($('<option></option>').attr('value', "").text('@RsBase.SELECIONE'));

                                $.each(data, function (key, value) {
                                    $('#iPais').append($('<option></option>').attr('value', value.id).text(value.descricao));
                                });

                                $("#iPais option:contains('BRASIL')").attr("selected", true);
                                $("#iPais").prop("disabled", false);
                            });
                        } else {
                            Notificar("@RsBase.ATENCAO_", 'CEP Não encontrado!!', "warning");
                        }
                    }
                });

                HidePageLoading();
            }
        });

        var clicked = false;
        function ValidaSubmit() {
            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

            if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

    </script>
}


@using (Html.BeginForm("Cadastro", "Endereco_Logradouro", FormMethod.Post, htmlAttributes: new { @id = "form" }))
{
@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.Id)

<div style="padding:10px">
    <div class="card" style="border:none;">
        <div class="card-body">
            <div class="row">
                <div class="col main-title">
                    <h4 class="title-page"><i class="fas fa-road"></i>@ViewBag.Title</h4>
                    <nav aria-label="breadcrumb" class="mb-20">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index", "Configuracao")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index", "Endereco_Logradouro")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.PAINEL_ENDERECO_LOGRADOURO</a>
                            </li>
                            <li class="breadcrumb-item">
                                <span>@ViewBag.Title</span>
                            </li>

                        </ol>
                    </nav>

                    @*<span style="font-size:11px" id="dtLegend"></span>*@
                </div>
            </div>

            <div class="accordion" id="accordion_4">
                <div class="card div-card-accord mb-3">
                    <div class="card-header title-card" id="heading_4">
                        <h5 class="mb-0">
                            <a role="button" data-toggle="collapse" data-target="#collapse_4" aria-expanded="true" aria-controls="collapse_4">
                                <span class="text-bold-card">@RsCadastros.CADASTRO_ENDERECO_LOGRADOURO</span>
                            </a>
                        </h5>
                    </div>

                    <div class="card-body body-card-accord">

                        <div class="row mb-3">
                            <div class="col-sm-1">
                                <div class="form-group">
                                    <label for="iCodigo">@RsCadastros.CODIGO:</label>
                                    @Html.TextBoxFor(model => model.Id, new { @class = "form-control", @id = "iCodigo", @autocomplete = "off", @required = true, @readonly = "readonly" })
                                </div>
                            </div>

                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="iCep">@RsCadastros.CEP:<span class="text-danger font-weight-bold"> *</span></label>
                                    @Html.TextBoxFor(model => model.Cep, new { @class = "form-control obrigatorio", @id = "iCep", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Cep, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            @if (Model.Id != 0)
                                {
                            <div class="col-sm-2" style="position:absolute;right:0;">
                                <div class="form-group">
                                    <label for="iStatus">@RsFinanceiro.STATUS:</label><br />
                                    @Html.CheckBoxFor(m => m.Status, new { @class = "form-control", @id = "iStatus", @name = " iStatus", @data_toggle = "toggle", @data_on = RsCadastros.ATIVO, @data_off = RsCadastros.INATIVO, @data_onstyle = "success", @data_offstyle = "light" })
                                </div>
                            </div>
                                }

                        </div>

                        <div class="row mb-3">

                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="iTipo">@RsCadastros.TIPO_ENDERECO_LOGRADOURO:<span class="text-danger font-weight-bold"> *</span></label>
                                    @Html.EnumDropDownListFor(m => m.Tipo_Endereco_Logradouro, RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iTipo", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Tipo_Endereco_Logradouro, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="iDescricao">@RsCadastros.DESCRICAO_ENDERECO_LOGRADOURO:<span class="text-danger font-weight-bold"> *</span></label>
                                    @Html.TextBoxFor(m => m.Descricao, new { @class = "form-control obrigatorio", @id = "iDescricao", @autocomplete = "off", @required = true })
                                    @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                </div>
                            </div>



                        </div>


                        <div class="row">
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="iPais">@RsCadastros.PAIS:<span class="text-danger font-weight-bold"> *</span></label>
                                    @Html.DropDownListFor(m => m.Pais, new List<SelectListItem>(), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iPais", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-1">
                                <div class="form-group">
                                    <label for="iUF">@RsCadastros.UF:<span class="text-danger font-weight-bold"> *</span></label>
                                    @Html.DropDownListFor(m => m.UF, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iUF", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label for="iCidade">@RsCadastros.CIDADE:<span class="text-danger font-weight-bold"> *</span></label>
                                    @Html.DropDownListFor(m => m.Cidade, new List<SelectListItem>(), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iCidade", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label for="iBairro">@RsCadastros.BAIRRO:<span class="text-danger font-weight-bold"> *</span></label>
                                    @Html.DropDownListFor(m => m.Bairro, new List<SelectListItem>(), RsBase.SELECIONE, new { @class = "form-control obrigatorio", @id = "iBairro", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label for="iTipo_Zona">@RsCadastros.TIPO: <span class="text-danger">*</span></label>
                                    @Html.EnumDropDownListFor(m => m.Tipo_Zona, RsBase.SELECIONE, new { @class = "form-control", @id = "iTipo_Zona", @autocomplete = "off" })
                                    @Html.ValidationMessageFor(model => model.Tipo_Zona, "", new { @class = "text-danger" })
                                </div>
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iGrupoArea">@RsCadastros.GRUPO_AREA: </label>
                                    @Html.DropDownListFor(p => p.Cod_Escritorio, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iGrupoArea", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iArea">@RsCadastros.AREA: </label>
                                    @Html.DropDownListFor(p => p.Cod_Area, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iArea", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="iLocalidade">@RsCadastros.LOCALIDADE: </label>
                                    @Html.DropDownListFor(p => p.Cod_Localidade, new SelectList(new List<Aniel.Connect.Core.ObjComboResult<String>>(), "Id", "Text"), RsBase.SELECIONE, new { @class = "form-control", @id = "iLocalidade", @autocomplete = "off" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label for="iPais">Codigo auxiliar:</label>
                                    @Html.TextBoxFor(model => model.CodigoAuxiliar, new { @class = "form-control", @id = "iCodAux", @autocomplete = "off", @required = false })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Button Float-->
    <a href="@Url.Action("Index", "Endereco_Logradouro")" class="float-cancel">
        <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
            <i class="fas fa-times fa-2x"></i>
        </div>
    </a>

    <a href="#" class="float-save" onclick="return ValidaSubmit();">
        <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
            <i class="fas fa-save fa-2x"></i>
        </div>
    </a>


</div>

}