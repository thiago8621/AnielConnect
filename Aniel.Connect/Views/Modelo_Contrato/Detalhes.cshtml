@model Aniel.Connect.Models.Modelo_ContratoComboDetalhesModels
@{
    ViewBag.Title = "DetalhesPlanoProduto";
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}
@*@section Layouts
    { 
    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")

}*@

@section Scripts
    {
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable")
    <script>
        var array_data_planos =@Html.Raw(Json.Encode(Model.ListaModelos));
        var lista = "ListaModelos";
        var table = $("#datatableComboPlanos").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: array_data_planos,
            columns: [
                {
                    title: "Descricao",
                    data: "Descricao",
                },
                {
                    title: "Plano/Produto",
                    data: "PlanoProduto",
                //    render: function (data, type, row, meta) { return data; }
                },
                {
                    title: "Franquia",
                    data: "Franquia",
                //    render: function (data, type, row) { return data;}
                },
                {
                    title: "Ponto",
                    data: "Ponto",
                //    render: function (data, type, row, meta) { return data;}
                },
                {
                    title: "Velocidade (MB)",
                    data: "Velocidade",
                //    render: function (data, type, row) { return data; }
                },
                {
                    title: "Frequencia de Cobrança",
                    data: "Frequencia_Cobranca",
                //    render: function (data, type, row, meta) { return data; }
                },
                {
                    title: "Formato de Cobrança",
                    data: "Formato_Cobranca",
                //    render: function (data, type, row) { return data; }
                },
                {
                    title: "Detalhe",
                    data: "Detalhe",
                    render: function (data, type, row, meta) {
                        return `<a href="#" id="i${lista}_${meta.row}" data-toggle="collapse" data-target="#i${lista}_text_${meta.row}" name="i${lista}[${meta.row}].Detalhe">` +
                               `<i class=" fas fa-arrow-down"></i></a>`+
                            ` <span class="collapse"id="i${lista}_text_${meta.row}">${data}<span>`;
                    }
                //    render: function (data, type, row) { return data; }
                },               
            ]
            @*,
            ajax: {
                url: "@CONSTANTES.URLPortal" + '/api/Modelo_ContratoApi/GetListDetalhes',
                type: 'POST',
            }*@
        });

    </script>
}

