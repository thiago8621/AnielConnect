@model Aniel.Connect.Models.Modelo_ContratoCadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Aniel.Connect.Model.enumerado;
@using Newtonsoft.Json;

@{
    /**/

    ViewBag.Title = RsCadastros.CADASTRO_MODELO_CONTRATO;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    ViewBag.URLArquivo = CONSTANTES.URLPortal + "/Arquivos/Modelo_Contrato/modelo_contrato.docx";

    List<AreaModuloModel> _areas = ViewBag.Areas;
    List<String> Variaveis = Enum.GetNames(typeof(VariaveisModeloContrato)).ToList();
}

@section styles
{
    <style>
        #listVariaveis, #listVariaveisONU {
            overflow-y: auto;
            padding-left: 15px;
            margin: 0;
            height: 240px;
        }

            #listVariaveis li, #listVariaveisONU li {
                list-style: none
            }

        .custom-file-input {
            height: auto
        }
    </style>
}

@section scripts
{
    @*@Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")*@

<script>
        $('a[data-toggle="tab"]').on('shown.bs.tab', () => {
            $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle('destroy')
            $("input[type='checkbox'][data-toggle='toggle']").bootstrapToggle()
        })

        AddSelect("iDesconto", "@CONSTANTES.URLPortal/api/Descontoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.Desconto", "@RsBase.SELECIONE", false);

        $('#iDisponibilizaTelefonia').change(function () {
            if ($('#iDisponibilizaTelefonia').is(':checked')) {
                $('#iDivIntegracaoTelefonia').show();
                $('#iDivQuantidadeDid').show();
                $('#iDivDidFormatoCobrar').show();
                $('#iDivFormatoCobrancaTelefonia').show();
                $('.span').show();
            }
            else {
                $('#iDivIntegracaoTelefonia').hide();
                $('#iDivQuantidadeDid').hide();
                $('#iDivDidFormatoCobrar').hide();
                $('#iDivFormatoCobrancaTelefonia').hide();
                $('.span').hide();
            }
        });

        $('#iTemCarencia').change(function () {
            if ($('#iTemCarencia').is(':checked')) {
                $('#iDivPeriodoCarencia').show();
                $('#iDivMultaCarencia').show();
            }
            else {
                $('#iDivPeriodoCarencia').hide();
                $('#iDivMultaCarencia').hide();
                $("#iPeriodoCarencia").val("");
                $("#iMultaCarencia").val("");
            }
        });

        //Telefonia -- Quantidade
        $("#iQuantidadeDid").on("change", function () {
            $("#iDivDidFormatoCobrar").show();
            $('#iSpanText').show();

            var num = $(this).val() > 0 ? true : false;

            if (!num) {
                $("#iDivDidFormatoCobrar").hide();
                $('#iSpanText').hide();

                $("#iDidFormatoCobrar").val(null);
            }
        });

        //Arquivo
        $('#iArquivo').on('change', function () {
            var myfile = $(this).val();
            var ext = myfile.split('.').pop();

            if (!ext == "docx" || !ext == "pdf" || !ext == "doc") {
                Notificar("@RsCadastros.ATENCAO", "Apenas permitido arquivos DOCX, DOC e PDF", "warning");
                $(this).val("");
            }
            else {
                var arquivo = $(this)[0].files[0];
                getBase64($("#btnDownloadModelo"), arquivo)

                var fileName = arquivo.name;
                $(this).next('.custom-file-label').html(fileName);
            }
        });

        function getBase64(btnDownload, arquivo) {
            let reader = new FileReader();
            reader.onload = function (e) {

                btnDownload.prop('href', e.target.result)
                btnDownload.prop('download', arquivo.name)
            }

            reader.readAsDataURL(arquivo)
        }

        let clicked = false;
        function ValidaSubmit()
        {
            let erro = false;

            if (clicked) {
                return;
            }

            clicked = true;

            if (!$("#iDescricao").val()) {
                Notificar("@RsBase.ATENCAO_", "Informe a descrição", "warning");
                erro = true;
            }

            @if (!AcessoHelper.TemAcesso(_areas, "53"))
            {
                <text>
                Notificar("@RsBase.ATENCAO_", "@RsBase.NAO_POSSUI_AREA_ACESSO", "warning");
                erro = true;
                </text>
            }

            const arquivoContrato = $("#iArquivo").val();

            let iArquivo = document.getElementById("iArquivo");
            for (var i = 0; i < iArquivo.files.length; i++) {
                var file = iArquivo.files[i];
                if (file.name.length > 100) {
                    Notificar("@RsBase.ATENCAO_", 'Não foi possível salvar o arquivo, descrição está maior que 100 caracteres!!', "warning");
                    erro = true;
                }
            }

            if (!arquivoContrato) {
                if (!$('#nomeArquivoGravado').html()) {
                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ARQUIVO)", "warning");
                    erro = true;
                }
            }
            else {
                const ext = arquivoContrato.split('.').pop();

                if (!(ext == "docx" || ext == "doc" || ext == "pdf")) {
                    Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_DOCX", "warning");
                    erro = true;
                }
            }

            if ($("#iTemCarencia").is(':checked')) {
                if ($('#iPeriodoCarencia').val() == "") {
                    Notificar("@RsBase.ATENCAO_", 'Informe o período de carência ', "warning");
                    erro = true;
                }

                if ($('#iMultaCarencia').val() == "") {
                    Notificar("@RsBase.ATENCAO_", 'Informe a multa de carência', "warning");
                    erro = true;
                }
            }

            if ($("#iDiasTeste").val() < 0) {
                Notificar("@RsBase.ATENCAO_", 'O número de dias deve ser maior que zero', "warning");
                erro = true;
            }

            if ($("#iPeriodoCarencia").val() < 0) {
                Notificar("@RsBase.ATENCAO_", 'O número de meses deve ser maior que zero', "warning");
                erro = true;
            }

            if ($("#iPercentual_Reajuste").val() < 0) {
                Notificar("@RsBase.ATENCAO_", 'O percentual deve ser maior que zero', "warning");
                erro = true;
            }

            if ($("#iValor_Reajuste").val() < 0) {
                Notificar("@RsBase.ATENCAO_", 'O valor deve ser maior que zero', "warning");
                erro = true;
            }

            if ($("#idesblqueio_conf").is(":checked")) {
                if ($("#iQuantidadeDiasBloqueio").val() <= 0) {
                    Notificar("@RsBase.ATENCAO_", 'A quantidade de dias de bloqueio, deve ser maior que zero', "warning");
                    erro = true;
                }

                if ($("#iFrequenciaDesbloqueio").val() == "") {
                    Notificar("@RsBase.ATENCAO_", 'Informe a Frequência permitida para desbloqueio em confiança.', "warning");
                    erro = true;
                }
            }

            if ($("#iBloqueioAutomaticoDebito").is(":checked")) {
                if ($("#iBloquearNumeroDias").val() <= 0) {
                    Notificar("@RsBase.ATENCAO_", 'O campo, Bloquear ao atrasar (Nº de dias), deve ser maior que zero', "warning");
                    erro = true;
                }

                if ($("#iBloquearAtrasarRenegociadas").val() <= 0) {
                    Notificar("@RsBase.ATENCAO_", 'O campo, Bloquear ao atrasar renegociadas (Nº de dias), deve ser maior que zero', "warning");
                    erro = true;
                }

                if ($("#iMaximoTitulosAberto").val() <= 0) {
                    Notificar("@RsBase.ATENCAO_", '0 campo, Máximo de títulos em aberto para gerar financeiro, deve ser maior que zero', "warning");
                    erro = true;
                }
            }

            if (!erro) {
                ShowPageLoading();
                $('#form').submit();
                return;
            }

            clicked = false;
            return;
        }

        $(document).ready(function () {

            $("#iContrato_Automatico").prop('checked', true);
            if ($("#iContrato_Automatico").is(":checked") == true) {
                $("#IContratoAutomatico").text("Sim")
            }
            else {
                $("#IContratoAutomatico").text("Não")
            }

            let temReajuste = $("#iTemReajuste").prop("checked");
            if (temReajuste == true) {
                $(".divPercentual_Reajuste").show();
            } else {
                $(".divPercentual_Reajuste").hide();
            }

            $("#iPercentual_Reajuste").prop("disabled", "disabled");
            $("#iValor_Reajuste").prop("disabled", "disabled");

            $(".bloqueiodatas").hide();
            $("#ifrequenciadesbloqueio").hide();
            $("#idias_desbloq").hide();

            if ($("#iDiasTeste").val() != null) {
                $("#diasdeteste").show();
            } else {
                $("#diasdeteste").hide();
            }

            $("#iTesteGratis").trigger('change');
            $('#iTemCarencia').trigger('change');
            $('#iDisponibilizaTelefonia').trigger('change');
            $("#iUtilizaDesconto").trigger('change');
            $("#idesblqueio_conf").trigger('change');
            $("#iBloqueioAutomaticoDebito").trigger('change');
            $("#ImpedirBloqueio_Automatico").trigger('change');
        });

        $('#ImpedirBloqueio_Automatico').change(function () {
            if ($("#ImpedirBloqueio_Automatico").is(":checked")) {
                $('.bloqueiodatas').show();
                 }
            else {
                $('#ImpedirBloqueio_Automaticosegunda').prop('checked', false);
                $('#ImpedirBloqueio_Automaticoterca').prop('checked', false);
                $('#ImpedirBloqueio_Automaticoquarta').prop('checked', false);
                $('#ImpedirBloqueio_Automaticoquinta').prop('checked', false);
                $('#ImpedirBloqueio_Automaticosexta').prop('checked', false);
                $('#ImpedirBloqueio_Automaticosabado').prop('checked', false);
                $('#ImpedirBloqueio_Automaticodomingo').prop('checked', false);
                $('#ImpedirBloqueio_Automaticoferiado').prop('checked', false);
                $('.bloqueiodatas').hide();
            }
        });

        $("#iUtilizaDesconto").on("change", function () {
            if ($(this).is(":checked")) {
                $("#iDivDesconto").removeClass("d-none");
            }
            else {
                $("#iDivDesconto").addClass("d-none");
                $('#iDesconto').val(null).trigger('change')
            }
        });

        $("#idesblqueio_conf").on("change", function () {
            if ($(this).is(":checked")) {
                $("#ifrequenciadesbloqueio").show();
                $("#idias_desbloq").show();
                $(".oculta-desbloqueio-confianca").show();
            }
            else {
                $("#ifrequenciadesbloqueio").hide();
                $("#idias_desbloq").hide();
                $("#iDias_Desbloq").val("");
                $('#ifrequenciadesbloqueio option[value=""]').prop("selected","selected");
                $(".oculta-desbloqueio-confianca").hide();
            }
        });

        $("#iBloqueioAutomaticoDebito").on("change", function () {
            if ($(this).is(":checked")) {
                $(".oculta-bloqueio-automatico").show();
            }
            else {
                $("#iBloquearNumeroDias").val(0);
                $("#iBloquearAtrasarRenegociadas").val(0);
                $("#iMaximoTitulosAberto").val(0);
                $(".oculta-bloqueio-automatico").hide();
            }
        });

        $("#iTesteGratis").on("change", function () {
            if ($(this).is(":checked")) {
                $("#diasdeteste").show();
            }
            else {
                $("#iDiasTeste").val("");
                $("#diasdeteste").hide();
            }
        });

        $("#iTemReajuste").on("change", function () {
            if ($(this).is(":checked")) {
                $(".divPercentual_Reajuste").show();
            }
            else {
                $(".divPercentual_Reajuste").hide();
                $("#iRadioPercentual").prop("checked", false);
                $("#iRadioValor").prop("checked", false);

                $("#iPercentual_Reajuste").prop("disabled", true);
                $("#iValor_Reajuste").prop("disabled", true);

            }
        });

        $("#iRadioPercentual").on("change", function () {
            if ($("#iRadioPercentual").prop("checked", true)) {
                $("#iPercentual_Reajuste").prop("disabled", false);
                $("#iValor_Reajuste").prop("disabled", true);
                $("#iValor_Reajuste").val("");
            }
        });

        $("#iRadioValor").on("change", function () {
            if ($("#iRadioValor").prop("checked", true)) {
                $("#iPercentual_Reajuste").prop("disabled", true);
                $("#iValor_Reajuste").prop("disabled", false);
                $("#iPercentual_Reajuste").val("");
            }
        });

</script>

