            AddSelect(`smsNegativacao${qntNegativacao}`, "@CONSTANTES.URLPortal/api/Configuracao_Envio_Mensagensapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
