                    </div>
                </div>

            `);

            AddSelect(`emailRemoverNegativacao${qntRemoverNegativacao}`, "@CONSTANTES.URLPortal/api/Configuracao_Envio_Mensagensapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect(`smsRemoverNegativacao${qntRemoverNegativacao}`, "@CONSTANTES.URLPortal/api/Configuracao_Envio_Mensagensapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect(`notificacaoRemoverNegativacao${qntRemoverNegativacao}`, "@CONSTANTES.URLPortal/api/Configuracao_Envio_Mensagensapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        }

        $(document).ready(function () {
            //adiciona as listas para o submit do form
            $('#form').on('submit', async function (e) {
                e.preventDefault();

                var form = document.getElementById("form");

                var data = new FormData(form);

                var bloqueios = [];
                var cobrancas = [];
                var cobrancasPre = [];
                var negativacoes = [];
                var removerNegativacoes = [];

                for (var i = 1; i <= qntBloqueio; i++) {
                    bloqueios.push({
                        dias: $(`#diasBloqueio${i}`).val(),
                        email: $(`#emailBloqueio${i}`).val(),
                        sms: $(`#smsBloqueio${i}`).val()
                    });
                }

                for (var i = 1; i <= qntCobranca; i++) {
                    cobrancas.push({
                        dias: $(`#diasCobranca${i}`).val(),
                        email: $(`#emailCobranca${i}`).val(),
                        sms: $(`#smsCobranca${i}`).val()
                    });
                }

                for (var i = 1; i <= qntPreCobranca; i++) {
                    cobrancasPre.push({
                        dias: $(`#diasPreCobranca${i}`).val(),
                        email: $(`#emailPreCobranca${i}`).val(),
                        sms: $(`#smsPreCobranca${i}`).val()
                    });
                }

                for (var i = 1; i <= qntNegativacao; i++) {
                    negativacoes.push({
                        dias: $(`#diasNegativacao${i}`).val(),
                        email: $(`#emailNegativacao${i}`).val(),
                        sms: $(`#smsNegativacao${i}`).val()
                    });
                }

                for (var i = 1; i <= qntRemoverNegativacao ; i++) {
                    removerNegativacoes.push({
                        dias: $(`#diasRemoverNegativacao${i}`).val(),
                        email: $(`#emailRemoverNegativacao${i}`).val(),
                        sms: $(`#smsRemoverNegativacao${i}`).val()
                    });
                }

                data.append("bloqueios", JSON.stringify(bloqueios));
                data.append("cobrancas", JSON.stringify(cobrancas));
                data.append("cobrancasPre", JSON.stringify(cobrancasPre));
                data.append("negativacao", JSON.stringify(cobrancasPre));
                data.append("removerNegativacao", JSON.stringify(cobrancasPre));

                let response = await fetch('@Url.Action("Cadastro", "Modelo_Contrato")', {
                    method: 'POST',
                    body: data
                });

                let url = '@Url.Action("Index","Modelo_Contrato")';
                window.location.href = url;
            });
        });

    </script>

