@model Aniel.Connect.Repository.Model.PerfilVisualizacaoVendaCadastroModel
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Model.enumerado
@using Aniel.T5.Model.enumerado

@{
    ViewBag.Title = RsCadastros.CADASTRO_PARAM_VISUALIZACAO_VENDA;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    //listaTipoPessoa
    List<Aniel.Connect.Core.ObjComboResult<String>> listaTipoPessoa = new List<Aniel.Connect.Core.ObjComboResult<String>>();
    foreach (var valor in Enum.GetValues(typeof(Sinapse.Model.enumerados.Tipo_Pessoa)))
    {
        string descricao = HtmlEnumExtensions.GetEnumDescription(valor);
        listaTipoPessoa.Add(new Aniel.Connect.Core.ObjComboResult<string>
        {
            Id = Convert.ToInt32(valor).ToString(),
            Text = descricao
        });
    }
    listaTipoPessoa = listaTipoPessoa.OrderBy(x => x.Text).ToList();


}

@section scripts
{
@Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
<script>

            var UfSelecionado = null;
    var HandleUf = function () {
        $('#iUF').on('select2:select select2:unselecting', function (e) {
            UfSelecionado = e.params.data;

            if (UfSelecionado == undefined) {
                AddSelect("iUF", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleUf);
                $("#iCidade").prop("disabled", true);
            } else {
                $("#iCidade").prop("disabled", false);
                AddSelect("iCidade", "@CONSTANTES.URLPortal/api/Cidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, UfSelecionado.id, null, "@RsBase.SELECIONE", false);
            }
        });
    }

    $(document).ready(function () {
        AddSelect("iMeioCaptacao", "@CONSTANTES.URLPortal/api/Meio_CaptacaoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iCategoriaCliente", "@CONSTANTES.URLPortal/api/Categoria_ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iSetorDepto", "@CONSTANTES.URLPortal/api/FolhaDeptoApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iEquipeVenda", "@CONSTANTES.URLPortal/api/EquipeVendasApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
        AddSelect("iUF", "@CONSTANTES.URLPortal/api/Ufapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleUf);


        $("#iPadraoVisualizaoLead").trigger("change");

    });


    $("#iPadraoVisualizaoLead").on("change", function () {
        if ($(this).prop("checked")) {
            $("#divQtdDiasBloqueioLead").hide();
        }
        else {
