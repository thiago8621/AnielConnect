        }
    });

    @* DATATABLE TIPO PESSOA *@
    let oDatatableTipoPessoa = null;

    const handleDataTableTipoPessoa = function () {
        "use strict";

        const dataTipoPessoa = @Html.Raw(Json.Encode(Model.ParamsTipoPessoa));

        @* Nome_utilizado para enganar o razor *@
        const nomeLista = "ParamsTipoPessoa";

        oDatatableTipoPessoa = $("#datatableTipoPessoa").length && $("#datatableTipoPessoa").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: dataTipoPessoa,
            paging: false,
            ordering: false,
            drawCallback: function () {
                handleExcluirTipoPessoa();
            },
            columns: [
                {
                    data: "Id",
                    title: "",
                    width: "1%",
                    className: "dt-body-center",
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluirTipoPessoa" id="btnExcluirTipoPessoa_' + meta.row + '" excluir="' + data + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                               '<input id="' + nomeLista + '_' + meta.row + '__Id" name="' + nomeLista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
                {
                    data: "TipoPessoa",
                    title: "@RsCadastros.TIPOPESSOA",
                    width: 380,
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nomeLista + '_' + meta.row + '__CodTipoPessoa" name="' + nomeLista + '[' + meta.row + '].CodTipoPessoa" type="hidden" value="' + TrataNulo(row.CodTipoPessoa) + '">';
                        }

                        return data;
                    },
                }
            ]
        });

        function handleExcluirTipoPessoa() {
            $(".btnExcluirTipoPessoa").unbind('click');
            $(".btnExcluirTipoPessoa").click(function (e) {
                e.preventDefault();

                const idParamTipoPessoa = $(this).attr("excluir");
                const trLinkButton = $(this).parents('tr');

                if (idParamTipoPessoa !== "0") {
                    const link = '@String.Concat(CONSTANTES.URLPortal, "/api/PerfilVisualizacaoVendaApi/ExcluirParamTipoPessoa?Id=")' + idParamTipoPessoa;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json'
                    })
                    .done(function (data) {
                        if (data.ok) {
                            oDatatableTipoPessoa.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    });
                }
                else {
                    oDatatableTipoPessoa.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
            });
        }

        handleExcluirTipoPessoa();

        $("#btnAdicionarTipoPessoa").unbind('click');
        $("#btnAdicionarTipoPessoa").on('click', function () {
            let erro = false;

            let dataTipoPessoa = oDatatableTipoPessoa.data().toArray();

            if (!$("#iTipoPessoa").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CONTRATO)", "warning");
                erro = true;
            }
            else {
                if (dataTipoPessoa.find(x => x.TipoPessoa === $("#iTipoPessoa option:selected").text())) {
                    Notificar("@RsBase.ATENCAO_", "Tipo de Pessoa já adicionado", "warning");
                    erro = true;
                }
            }

            if (erro) {
                return;
            }

            oDatatableTipoPessoa.row.add({
                Id: 0,
                CodTipoPessoa: $("#iTipoPessoa option:selected").val(),
                TipoPessoa: $("#iTipoPessoa option:selected").text()
            }).draw(false);

            handleExcluirTipoPessoa();

            $("#iTipoPessoa").val(null).trigger("change");
        });
    },
        TableManageButtonsTipoPessoa = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableTipoPessoa();
                }
            }
        }();

    TableManageButtonsTipoPessoa.init();

