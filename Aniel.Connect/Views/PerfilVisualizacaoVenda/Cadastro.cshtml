                                </div>
                            </div>
                        </div>

                        @* Tab Equipe de Vendas *@

                        <div role="tabpanel" class="tab-pane" id="btnEquipeVendas">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="card div-card-accord">
                                        <div class="card-header title-card">
                                            <h5 class="mb-1">
                                                <a role="button">
                                                    <span class="text-bold-card">Adicionar Equipe de Vendas</span>
                                                </a>
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col">
                                                    <div class="form-group">
                                                        <label for="iEquipeVenda">@RsCadastros.EQUIPE_VENDAS:</label>

                                                        <select class="form-control" id="iEquipeVenda">
                                                            <option value="">@RsBase.SELECIONE</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col">
                                                    <div class="text-right mt-3">
                                                        <input type="button" id="btnAdicionarEquipeVenda" class="btn btn-success" value="@RsCadastros.ADICIONAR" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="card div-card-accord">
                                        <div class="card-header title-card">
                                            <h5 class="mb-1">
                                                <a role="button">
                                                    <span class="text-bold-card">Lista de Equipes de Vendas Adicionadas</span>
                                                </a>
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-hover nowrap" id="datatableEquipeVenda" style="width:100%"></table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                            </div>
        </div>

        <a href="@Url.Action("Index", "PerfilVisualizacaoVenda")" class="float-cancel">
            <div class="text-btn-float-cancel" data-toggle="tooltip" data-placement="left" title="Cancelar">
                <i class="fas fa-times fa-2x"></i>
            </div>
        </a>

        <a href="#" class="float-save" onclick="return ValidaSubmit();">
            <div class="text-btn-float-save" data-toggle="tooltip" data-placement="left" title="Salvar">
                <i class="fas fa-save fa-2x"></i>
            </div>
        </a>
    </div>
}

