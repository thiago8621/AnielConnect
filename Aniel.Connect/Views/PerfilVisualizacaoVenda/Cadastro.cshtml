            }

            if (!$("#iCidade").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.CIDADE)", "warning");
                erro = true;
            }

            let dataRegiao = oDatatableRegiao.data().toArray();

            if (dataRegiao.find(x => x.UF === $("#iUF option:selected").text() && x.Cidade === $("#iCidade option:selected").text())) {
                Notificar("@RsBase.ATENCAO_", "Cidade e UF já adicionadas", "warning");
                erro = true;
            }

            if (erro) {
                return;
            }

            oDatatableRegiao.row.add({
                Id: 0,

                CodUF: $("#iUF option:selected").val(),
                UF: $("#iUF option:selected").text(),
                CodCidade: $("#iCidade option:selected").val(),
                Cidade: $("#iCidade option:selected").text()
            }).draw(false);

            handleExcluirRegiao();

            $("#iRegiao").val(null).trigger('change');
        });
    },
        TableManageButtonsRegiao = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableRegiao();
                }
            }
        }();

    TableManageButtonsRegiao.init();


        @* Datatable Equipe de Vendas *@

    let oDatatableEquipeVenda = null;

    const handleDataTableEquipeVenda = function () {
        "use strict";

        const dataEquipeVenda = @Html.Raw(Json.Encode(Model.ParamsEquipeVenda));

        @* Nome utilizado para enganar o razor *@
        const nomeLista = "ParamsEquipeVenda";

        oDatatableEquipeVenda = $("#datatableEquipeVenda").length && $("#datatableEquipeVenda").DataTable({
            dom: "Bfrti",
            language: traducaoDataTableSimples,
            data: dataEquipeVenda,
            paging: false,
            ordering: false,
            drawCallback: function () {
                handleExcluirEquipeVenda();
            },
            columns: [
                {
                    data: "Id",
                    title: "",
                    width: "1%",
                    className: "dt-body-center",
                    render: function (data, type, row, meta) {
                        return '<a href="#" class="btnExcluirEquipeVenda" id="btnExcluirEquipeVenda_' + meta.row + '" excluir="' + data + '"><i class="far fa-trash-alt" style="font-size:16px; padding-right:2px;"></i></a>' +
                               '<input id="' + nomeLista + '_' + meta.row + '__Id" name="' + nomeLista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">';
                    }
                },
                {
                    data: "Equipe",
                    title: "@RsCadastros.EQUIPE_VENDAS",
                    width: 380,
                    render: function (data, type, row, meta) {
                        if (type === 'display') {
                            data = data + ' <input id="' + nomeLista + '_' + meta.row + '__CodEquipe" name="' + nomeLista + '[' + meta.row + '].CodEquipe" type="hidden" value="' + TrataNulo(row.CodEquipe) + '">';
                        }

                        return data;
                    },
                }
            ]
        });

        function handleExcluirEquipeVenda() {
            $(".btnExcluirEquipeVenda").unbind('click');
            $(".btnExcluirEquipeVenda").click(function (e) {
                e.preventDefault();

                const idParamEquipeVenda = $(this).attr("excluir");
                const trLinkButton = $(this).parents('tr');

                if (idParamEquipeVenda !== "0") {
                    const link = '@String.Concat(CONSTANTES.URLPortal, "/api/PerfilVisualizacaoVendaApi/ExcluirParamEquipeVenda?Id=")' + idParamEquipeVenda;

                    $.ajax({
                        url: link,
                        type: 'GET',
                        dataType: 'json'
                    })
                    .done(function (data) {
                        if (data.ok) {
                            oDatatableEquipeVenda.row(trLinkButton).remove().draw(false);
                            Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                        }
                        else {
                            Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                        }
                    });
                }
                else {
                    oDatatableEquipeVenda.row(trLinkButton).remove().draw(false);
                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                }
            });
        }

        handleExcluirEquipeVenda();

        $("#btnAdicionarEquipeVenda").unbind('click');
        $("#btnAdicionarEquipeVenda").on('click', function () {
            let erro = false;

            if (!$("#iEquipeVenda").val()) {
                Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.EQUIPE_VENDAS)", "warning");
                erro = true;
            }

            let dataEquipeVenda = oDatatableEquipeVenda.data().toArray();

            if (dataEquipeVenda.find(x => x.CodEquipe === $("#iEquipeVenda option:selected").val())) {
                Notificar("@RsBase.ATENCAO_", "Equipe de Venda já adicionada", "warning");
                erro = true;
            }

            if (erro) {
                return;
            }

            oDatatableEquipeVenda.row.add({
                Id: 0,

                CodEquipe: $("#iEquipeVenda option:selected").val(),
                Equipe: $("#iEquipeVenda option:selected").text()
            }).draw(false);

            handleExcluirEquipeVenda();

            $("#iEquipeVenda").val(null).trigger('change');
        });
    },
        TableManageButtonsEquipeVenda = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableEquipeVenda();
                }
            }
        }();

    TableManageButtonsEquipeVenda.init();


    let clicked = false;

    function ValidaSubmit() {
        if (clicked) {
            return false;
        }

        clicked = true;
        erro = false;

        if (!$("#iDescricao").val()) {
            Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsBase.DESCRICAO)", "warning")
            erro = true
        }

        if (erro) {
            clicked = false;
            return false;
        }

        ShowPageLoading();
        $('#form').submit();

        return true;
    }

    $("#iQtdDiasBloqueioLead").on("keyup", function (e) {
        var value = e.target.value;
        // remove tudo que não for número
        value = value.replace(/\D/g, "");

        // atualiza o campo com o valor filtrado
        e.target.value = value;

        // valida: só aceita vazio ou maior que 1
        if (value !== "" && parseInt(value) <= 0) {
            e.target.value = ""; // limpa o campo
        }
    });
</script>
}

