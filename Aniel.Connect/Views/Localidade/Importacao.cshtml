@model  Sinapse.Util.ExcelServiceLog<Aniel.Connect.Models.Localidade_Importacao>

@{
    ViewBag.Title = RsCadastros.IMPORTAR_LOCALIDADE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";

    ViewBag.Modelo = CONSTANTES.URLPortal + @"/Arquivos/Roteirizacao/Modelo_Padrao_Importacao_Localidade.xlsx";
}

@section styles
{
    @Styles.Render("~/Content/cssDataTable")
    <link href="~/bin/Content/preloaderbar.css" rel="stylesheet" />

    <style>
        .popover{
            max-width: 45%; /* Max Width of the popover (depending on the container!) */
        }
    </style>
}


@section  scripts
{
    @Scripts.Render("~/bundles/jsDataTable")
    <script src="~/bin/Scripts/download.js"></script>

    <script>

        let datatableExportMuni
        var oDatatable = undefined

        $('#iArquivo').on('change', function () {

            var myfile = $(this).val();
            var ext = myfile.split('.').pop();
            if (!(ext == "xls" || ext == "xlsx")) {

                Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                $(this).val("");
            }
            else {

                var arquivo = $(this)[0].files[0];

                var fileName = arquivo.name;
                $(this).next('.custom-file-label').html(fileName);
            }
        });

        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;
            var erro = false;

            myfile= $("#iArquivo").val();
            if (!myfile) {

                if ($('#iArquivo').next('.custom-file-label').html() == '') {

                    Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.REQUIRED, RsCadastros.ARQUIVO)", "warning");
                    erro = true;
                }
                else {

                    var ext = $('#iArquivo').next('.custom-file-label').html().split('.').pop();
                    if (!(ext == "xlsx" || ext == "xls")) {

                        Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                        erro = true;
                    }
                }
            }
            else {

                var ext = myfile.split('.').pop();
                if (!(ext == "xlsx" || ext == "xls")) {

                    Notificar("@RsCadastros.ATENCAO", "@RsCadastros.PERMITIDO_XLS_XLSX", "warning");
                    erro = true;
                }
            }

            if (erro) {

                clicked = false;
                return false;
            }

            $("#divProgress").show();

            $('#form').submit();
        }

        $(document).ready(function () {
              $('[data-toggle="popover"]').popover()

            var sucesso = "@Html.Raw(ViewBag.Sucesso)";
            if (sucesso == "S") {
                Notificar("@RsCadastros.INFORMACAO", "Importação de Localidade finalizada!", "info");
            }

        });

    </script>


    @if (Model.Log.Count() > 0)
    {
        <text>
            <script>

           var array = @Html.Raw(Json.Encode(Model.Log));
           var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                scrollX: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '30vh',
                drawCallback: function (settings) {
                    $('.switchToggle').bootstrapToggle('state', true);
                },
                columns: [
                    {
                        data: "Chave",
                        title: "@Html.Raw(RsCadastros.CODIGO)",
                    },
                    {
                        data: "Erro",
                        title: "Mensagem"
                    }
                ]
            });
            </script>
        </text>
    }
}

<div class="container-fluid" id="divTitle">
    <!--main-->

    <div class="row">
        <div class="col">

            <h4 class="title-page"><i class="fas fa-file-download"></i> @ViewBag.Title</h4>

            <nav aria-label="breadcrumb" class="mt-25">

                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Configuracao", new { Id = Request.Params["Id"] })" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Localidade")" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.LISTAGEM_LOCALIDADE</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span>@ViewBag.Title</span>
                    </li>

                </ol>
            </nav>
        </div>





    </div>
    <!--./main-->
</div>

<div class="container-fluid">

    <div class="accordion" id="accordion_5">
        <div class="card div-card-accord mb-3">
            <div class="collapse show" aria-labelledby="heading_5" data-parent="#heading_5">
                <div class="card-body pb-0">


                    <div class="row mb-3">
                        <div class="col-10">
                            <label>Para importar a Localidade siga os seguintes passos:</label>
                        </div>
                        <div class="col text-right">
                            <a tabindex="0" class="btn text-right" role="button" data-toggle="popover" data-html="true" data-placement="left" data-trigger="focus" title="Informação"
                            data-content="
                                <ul>
                                    <li><b>Código Localidade</b> -  <span class='text-danger'>Obrigatório</span> - Campo numérico único de até 50 caracteres. Ex.: 13.</li>
                                    <li><b>Descrição da Localidade</b> -  <span class='text-danger'>Obrigatório</span> - Campo alfanumérico de até 50 caracteres. Ex.: Jardim Paulista.</li>
                                    <li><b>Área</b> -  <span class='text-danger'>Obrigatório</span> - Preencher com um Código ou Descrição de Área ativa, cadastrada no sistema. Ex.: 12 ou Duque de Caxias.</li>
                                    <li><b>Grupo Área</b> -  <span class='text-danger'>Obrigatório</span> - Preencher com um Código ou Descrição do Grupo Área ativo, cadastrado no sistema. Ex.: 82 ou Rio de Janeiro.</li>
                                    <li><b>Contrato</b> -  <span class='text-danger'>Obrigatório</span> - Preencher com o Código do Contrato que as OS's dessa Localidade serão alocadas.</li>
                                    <li><b>Projeto</b> -  <span class='text-danger'>Obrigatório</span> - Preencher com o Código do Projeto que as OS's dessa Localidade serão alocadas.</li>

                                </ul>
                            ">
                            <i class="fas fa-info-circle icofont-1dot5x ml-2" style="color:#486B91;"></i>
                            </a>
                        </div>
                        <div class="col-12">
                            <label>1 - Faça o download da planilha padrão;</label>
                        </div>
                        <div class="col-12">
                            <label>2 - A primeira linha da planilha está preenchida com um exemplo para auxiliá-lo no preenchimento;</label>
                        </div>
                        <div class="col-12">
                            <label>3 - Apague o exemplo e preencha a planilha com os dados da Localidade que deseja importar para o cadastro;</label>
                        </div>
                        <div class="col-12">
                            <label>4 - Para saber mais informações sobre os campos, clique no ícone informativo no canto superior direito da tela;</label>
                        </div>
                        <div class="col-12">
                            <label>5 - Ao preencher a planilha, salve em seu computador e faça o upload do arquivo;</label>
                        </div>
                        <div class="col-12">
                            <label>6 - Ao final do processo será exibido um log de registros importados e não importados.</label>
                        </div>
                    </div>
                    <div class="row mb-1">
                        <div class="form-group col-sm-12" style="padding: 15px;" id="teste3">
                            <div class="form-group">
                                <a href="@ViewBag.Modelo" type="button" class="btn btn-primary" id="iLimparFiltroModal" data-dismiss="modal"><i class="fas fa-download"></i> @RsPontoEletronico.DOWNLOADPLANILHAPADRAO</a>
                                <button type="button" data-toggle="modal" data-target="#modal-filter" class="btn btn-success" id="iPesquisar"><i class="fas fa-upload"></i> @RsCadastros.UPLOADPLANILHALOCALIDADE</button>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

@if (Model.Log.Count() > 0)
{
    <text>
        <div class="container-fluid">
            <div class="accordion" id="accordion_5">
                <div class="card div-card-accord mb-3">

                    <div class="card-header title-card mb-0" id="heading_5">
                        <h5 class="mb-0">
                                <span class="text-bold-card">Log de Importação de Localidade</span>
                        </h5>
                    </div>
                    <div class="collapse show" aria-labelledby="heading_5" data-parent="#heading_5">
                        <table class="table table-hover nowrap table-responsive" id="datatable">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </text>
}
@using (Html.BeginForm("Importacao", "Localidade", FormMethod.Post, new { enctype = "multipart/form-data", @id = "form", autocomplete = "off" }))
{
    @*@Html.AntiForgeryToken()*@

    <!--Modal Filters-->
    <div class="modal" id="modal-filter">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title text-muted">Upload Planilha de Localidades</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">

                    <div class="row">

                        <div class="col-sm-12">

                            <div class="row">

                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label><strong>@RsCadastros.ARQUIVO</strong></label>
                                        <div class="input-group mb-3">
                                            <input type="file" class="custom-file-input" name="Arquivo" id="iArquivo" />
                                            <label for="Arquivo" id="arquivoi" class="custom-file-label"><i class="fas fa-upload"></i> @RsBase.ESCOLHAUMARQUIVO</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="form-group col-sm-12" style="padding: 15px;">
                        <div class="text-center">
                            <button type="button" class="btn btn-danger" id="iLimparFiltroModal" data-dismiss="modal">@RsBase.CANCELAR</button>
                            <button type="button" class="btn btn-success" id="iImportar" onclick="return ValidaSubmit();">@RsBase.IMPORTAR</button>
                        </div>
                    </div>

                </div>

            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal-->
}

<div class="overlay" id="divProgress" style="display:none;">
    <div class="preloaderbar show active">
        <span class="bar"></span>
        <span class="text">@RsCadastros.PROCESSANDO...</span>
    </div>
</div>

<table id="datatable" class="d-none"></table>