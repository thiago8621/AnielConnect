@using Resources
@using Sinapse.Model.enumerados
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using Microsoft.AspNet.Identity;
@model Aniel.Connect.Models.Localidade_CadastroModel

@{
    ViewBag.Title = RsCadastros.LISTAGEM_LOCALIDADE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
}

@{
    List<AreaModuloModel> _areas = ViewBag.Areas;

}

@section styles
{
    @Styles.RenderFormat(SiteKeys.StyleVersion, "~/Content/cssDataTable")
    <style>
        .pagination {
            position: relative;
            margin-left: 30px !important;
        }

        #datatable_length {
            margin-right: auto !important;
        }


        #dtLegend {
            display: none !important;
        }

        select[name="datatable_length"] {
            min-width: 65px !important;
        }
    </style>
}


@section  scripts
{
    @Scripts.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTable11")

    <script>
        let rows_selected = [];
    let oDatatable;

    function AlterarStatusObj(Status) {
        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Localidadeapi/alterarstatus")';

        $.ajax({
            url: link,
            type: 'POST',
            dataType: 'json',
            data: {
                ids: rows_selected,
                status: Status
            }
        })
            .done(function (data) {

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    rows_selected = [];
                    oDatatable.draw();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });

        rows_selected = [];
    }

    function BuscarGeocalizacao(Status) {
        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/Localidadeapi/BuscarGeocalizacao")';

        let ids = rows_selected.map(p => {
            let _chaves = p.split('|');
            let IdGrupoArea = _chaves[0];
            let IdArea = _chaves[1];
            let Localidade = _chaves[2];

            return {
                CodGrupoArea: IdGrupoArea,
                CodArea: IdArea,
                Localidade: Localidade
            };
        });

        $.ajax({
            url: link,
            type: 'POST',
            dataType: 'json',
            data: {
                ids: ids,
                usuario: "@User.Identity.GetUserId()"
            }
        })
            .done(function (data) {

                if (data.ok) {
                    Notificar("@RsBase.INFORMACAO", "@RsBase.OPERACAOBEMSUCEDIDA", "info");
                    rows_selected = [];
                    oDatatable.draw();
                }
                else {
                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                }
            });

        rows_selected = [];
    }

     function carregaSelect2() {
          AddSelect("iGrupoAreaFiltro", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
          AddSelect("iAreaFiltro", "@CONSTANTES.URLPortal/api/Areaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, $("#iGrupoAreaFiltro").val(), null, "@RsBase.SELECIONE", false);
          AddSelect("iContratoFiltro", "@CONSTANTES.URLPortal/api/Contratoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
          AddSelect("iProjetoFiltro", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, $("#iContratoFiltro").val(), null, "@RsBase.SELECIONE", false);

    }

    $(document).ready(async () => {
        carregaSelect2()
    })

    $("#iContratoFiltro").on("change", function () {
        var idContrato = $("#iContratoFiltro").val();
        AddSelect("iProjetoFiltro", "@CONSTANTES.URLPortal/api/Projetoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, idContrato, null, "@RsBase.SELECIONE", false);
    });



    $("#iGrupoAreaFiltro").on("change", function () {
        var idGrupoArea = $("#iGrupoAreaFiltro").val();
        AddSelect("iAreaFiltro", "@CONSTANTES.URLPortal/api/Areaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, idGrupoArea, null, "@RsBase.SELECIONE", false);
    });

        var handleDataTableButtons = function () {

            "use strict";

            //"Blfrtip"
            oDatatable = new DataTable("#datatable",{
                dom: "<'row'<'col-sm-4'l><'col-sm-8'p>>" + "Bfrti" ,
                columnDefs: [{
                    targets: 0,
                    searchable: false,
                    orderable: false,
                    width: '1%',
                    className: 'dt-body-center',
                    render: function (data, type, full, meta) {
                        return "<input type='checkbox'></input>";
                    }
                },
                {
                    targets: 1,
                    searchable: false,
                    orderable: false,
                    width: '1%',
                    className: 'dt-body-center'
                }],
                select: 'multi',
                order: [[4, 'asc']],
                serverSide: true,
                searching: true,
                ordering: true,
                paging: true,
                deferRender: true,
                scrollResize: true,
                scrollY: '79vh',
                /*stateSave: true,*/
                scrollX: true,
                initComplete: dataTableInitComplete,
                lengthMenu: [[10, 25, 50, 100, 250, 750, 1000], [10, 25, 50, 100, 250, 750, 1000]],
                ajax: {
                    url: baseUrl + '/api/Localidadeapi/GetAll',
                    type: 'POST',
                    data: function (data) {
                        // Read values
                        data.Status = $("#iStatusFiltro option:selected").val();
                        data.IdGrupoArea = $("#iGrupoAreaFiltro option:selected").val();
                        data.IdArea = $("#iAreaFiltro option:selected").val();
                        data.Projeto = $("#iProjetoFiltro option:selected").val();
                        data.IdContrato = $("#iContratoFiltro option:selected").val();
                        data.search.option = $("#optionSearch").val();
                        data.VisualizarSemLocalizacao = $("#iVisualizarSemLocalizacao").is(":checked");
                    },
                    error: function (e) {
                        console.log(e);
                    },
                    dataSrc: function (d) {
                        return d.data;
                    }
                },
                infoCallback: function (oSettings, iStart, iEnd, iMax, iTotal, sPre) {

                    var str = "@RsCadastros.INFODATATABLE";
                    if (iTotal == 0) { iEnd = 0; iStart = 0; }
                    str = str.replace("{0}", iStart).replace("{1}", iEnd).replace("{2}", iTotal);
                    $("#dtLegend").html(str);

                    return "";
                },
                preDrawCallback: function () {

                    //if (ajustePageLength) {
                    //    divPageLength = $('#datatable_length');
                    //}

                    ShowPageLoading();
                },
                drawCallback: function () {

                    //if (ajustePageLength == false) {
                    //    $('#datatable_length').prependTo('.pagination');
                    //    ajustePageLength = true;
                    //    divPageLength = $('#datatable_length');
                    //}
                    //else {
                    //    divPageLength.prependTo('.pagination');
                    //}

                    HidePageLoading();
                },
                rowCallback: function(row, data, dataIndex){
                     // Get row ID
                     var rowId = data.id;

                     // If row ID is in the list of selected row IDs
                    if ($.inArray(rowId, rows_selected) !== -1)
                    {
                        $(row).find('input[type="checkbox"]').prop('checked', true);
                        $(row).addClass('selected');
                     }
                },
                pageLength: 10,
                language: traducaoDataTable,
                buttons: buttonsDataTable,
                columns: [
                    { title: "<input name='select_all' value='1' type='checkbox'>" },
                    {
                        data: "pendencia", render: function (data) {
                            if (data) return '<i class="fas fa-circle text-danger"></i>';
                            else return '';
                        }
                    },
                    { data: "id", title: "@RsCadastros.CODIGO" },
                    { data: "descricao", title: "@RsCadastros.DESCRICAO_LOCALIDADE" },
                    { data: "grupoArea", title: "@RsCadastros.DESCRICAO_GRUPO_AREA" },
                    { data: "area", title: "@RsCadastros.DESCRICAO_AREA" },
                    { data: "contrato", title: "@RsCadastros.CONTRATO" },
                    { data: "projeto", title: "@RsCadastros.PROJETO" },
                    { data: "status", title: "@RsCadastros.STATUS" },
                    { data: "padrao", title: "@RsCadastros.PADRAO" }
                ]
            });

            $('#txtSearch').val(oDatatable.search());
            $('#txtSearch').keyup(function () {
                rows_selected = [];
                oDatatable.search($(this).val()).draw();
            });

            $("#iPesquisar").on("click", function () {
                $("#modal-filter").modal('hide');

                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();

                return true;
            });

            $("#iLimparFiltroModal, #iLimparFiltro").on("click", function () {
                $("#iStatusFiltro").val("");
                $('#iGrupoAreaFiltro').val(null).trigger('change');
                $('#iAreaFiltro').val(null).trigger('change');
                $('#iContratoFiltro').val(null).trigger('change');
                $('#iProjetoFiltro').val(null).trigger('change');
                $('#txtSearch').val("");
                carregaSelect2();

                rows_selected = [];
                oDatatable.search($('#txtSearch').val()).draw();
            });

            $("#btnInativar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Inativo
                AlterarStatusObj(0);

            });

            $("#btnBuscarGeolocalizacao").on("click", function () {

                BuscarGeocalizacao();

            });

            $("#btnAtivar").on("click", function () {

                if (rows_selected.length == 0) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.NENHUMREGISTROSELECIONADO", "info");
                    return;
                }

                //Alterando para Ativo
                AlterarStatusObj(1);
            });

            // Handle click on checkbox
            $('#datatable tbody').on('click', 'input[type="checkbox"]', function (e) {
                var $row = $(this).closest('tr');

                // Get row data
                /*var rowId = oDatatable.row($row).data().id;*/

                var rowId = oDatatable.row($row).data().idGrupoArea + "|" +
                    oDatatable.row($row).data().idArea + "|" +
                    oDatatable.row($row).data().descricao;


                var index = $.inArray(rowId, rows_selected);

                // If checkbox is checked and row ID is not in list of selected row IDs
                if (this.checked && index === -1) {
                    rows_selected.push(rowId);

                    // Otherwise, if checkbox is not checked and row ID is in list of selected row IDs
                } else if (!this.checked && index !== -1) {
                    rows_selected.splice(index, 1);
                }

                if (this.checked) {
                    $row.addClass('selected');
                } else {
                    $row.removeClass('selected');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            $('#datatable tbody').on('click', 'tr', function () {

                @if (AcessoHelper.TemAcesso(_areas, "237"))
                {
                    <text>
                    if (oDatatable.row(this).data() != null) {


                        let grupoArea = oDatatable.row(this).data().idGrupoArea;
                        let area = oDatatable.row(this).data().idArea;
                        let localidade = oDatatable.row(this).data().descricao;

                        if (!grupoArea) {
                            Notificar("@RsBase.ATENCAO_", "Localidade não é possivel ser acessada por nao possuir Grupo Área", "warning");
                            return;
                        }
                        if (!area) {
                            Notificar("@RsBase.ATENCAO_", "Localidade não é possivel ser acessada por nao possuir Área", "warning");
                            return
                        }

                        var _id = grupoArea + "|" +
                            area + "|" +
                            localidade;

                        var url = '@Url.Action("Cadastro", "Localidade", new { id = "__id__" })';
                        window.location.href = url.replace('__id__', _id);
                        ShowPageLoading();
                    }
                    </text>
                }
                else
                {
                    <text>
                    Notificar("@RsBase.ATENCAO_", "Usuário sem acesso", "warning");
                    </text>
                }

            });


            // Handle btn login event
            $('#datatable tbody').on('click', '.btnLogin', function (e) {

                var id = $(this).attr("id_cliente");
                ExibirLogin(id);

                e.stopPropagation();
            });

            // Handle click on table cells with checkboxes
            $('#datatable').on('click', 'tbody td, thead th:first-child', function (e) {
                $(this).parent().find('input[type="checkbox"]').trigger('click');
            });

            // Handle click on "Select all" control
            $('thead input[name="select_all"]', oDatatable.table().container()).on('click', function (e) {
                if (this.checked) {
                    $('#datatable tbody input[type="checkbox"]:not(:checked)').trigger('click');
                } else {
                    $('#datatable tbody input[type="checkbox"]:checked').trigger('click');
                }

                // Prevent click event from propagating to parent
                e.stopPropagation();
            });

            // Handle table draw event
            oDatatable.on('draw', function () {
                updateDataTableSelectAllCtrl(oDatatable);
            });

        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

        TableManageButtons.init();
    </script>
}
@using (Html.BeginForm("Cadastro", "Localidade", FormMethod.Post, htmlAttributes: new { enctype = "multipart/form-data", @id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    <div class="container-fluid" id="divTitle">
        <!--main-->
        <div class="row">
            <div class="col-auto mr-auto">
                <h4 class="title-page"><i class="fas fa-map-marker-alt"></i> @ViewBag.Title</h4>

                <nav aria-label="breadcrumb" class="mt-25">
                    <ol class="breadcrumb">
                        @if (AcessoHelper.TemAcesso(_areas, "239"))
                        {
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index", "Configuracao", new { Id = Request.Params["Id"] })" style="color:#367fa9" onclick="ShowPageLoading(); return true;">@RsCadastros.CONFIGURACOES</a>
                            </li>
                            <li class="breadcrumb-item">
                                <span>@RsCadastros.LISTAGEM_LOCALIDADE</span>
                            </li>
                        }
                    </ol>
                </nav>
            </div>

            <div class="col-auto">
                <div class="row title-page">
                    <div class=" pl-4 pr-2">
                        <input type="text" class="input-search" id="txtSearch" placeholder="@RsCadastros.DESCRICAO" autocomplete="off">
                        <i class="la la-search la-2x" style="color: #999"></i>
                    </div>
                    @if (AcessoHelper.TemAcesso(_areas, "240"))
                    {
                        <a class="btn btn-success btn-add" href="@Url.Action("Cadastro", "Localidade", new { Id = Request.Params["Id"]})" title="@RsBase.INCLUIR" onclick="ShowPageLoading(); return true;"><i class="la la-plus" style="color: #fff"></i></a>
                    }

                    <button type="button" class="btn btn-default btn-add" data-toggle="modal" data-target="#modal-filter" title="@RsBase.FILTRO"><i class="la la-filter la-2x" style="color: #999"></i></button>

                    <button type="button" class="btn btn-default btn-add" id="iLimparFiltro" title="@RsBase.LIMPAR_FILTRO"><i class="la la-eraser la-2x" style="color: #999"></i></button>

                    <button class="btn btn-default btn-add" type="button" title="@RsBase.EXPORTAR" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="la la-ellipsis-v la-2x" style="color: #999"></i>
                    </button>

                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                        <a class="dropdown-item" href="#" onclick="$('.buttons-excel').click(); return false;">@RsBase.EXPORTAREXCEL</a>
                        @if (AcessoHelper.TemAcesso(_areas, "241"))
                        {
                            <a class="dropdown-item" id="btnInativar" href="#" onclick="return false;">@RsBase.INATIVAR</a>
                            <a class="dropdown-item" id="btnAtivar" href="#" onclick="return false;">@RsBase.ATIVAR</a>
                            <a class="dropdown-item" href="@Url.Action("Importacao", "Localidade")" onclick="ShowPageLoading(); return true;">@RsCadastros.IMPORTAR_LOCALIDADE</a>
                            <a class="dropdown-item" href="@Url.Action("Historico_Alteracao", "Localidade")">@RsCadastros.LOG_ALTERACAO_LOCALIDADE</a>
                            <a class="dropdown-item" id="btnBuscarGeolocalizacao" href="#" onclick="return false;">@RsCadastros.BUSCAR_GEOLOCALIZACAO</a>
                        }
                    </div>
                </div>
            </div>
        </div>


        <!--./main-->
        <!--MODAL DE FILTRO-->
        <div class="modal" id="modal-filter">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title text-muted">@RsBase.FILTROS</h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="iStatusFiltro" class="mr-3" style="font-size: 12px"><b>@RsCadastros.STATUS: </b></label><br>
                            <select id="iStatusFiltro" class="form-control">
                                <option value="">@RsBase.TODOS</option>
                                <option value="0">@RsCadastros.INATIVO</option>
                                <option value="1">@RsCadastros.ATIVO</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="iGrupoAreaFiltro">@RsCadastros.GRUPO_AREA:</label>
                            <select class="form-control filtro" id="iGrupoAreaFiltro"></select>
                        </div>
                        <div class="form-group">
                            <label for="iAreaFiltro">@RsCadastros.AREA:</label>
                            <select class="form-control filtro" id="iAreaFiltro"></select>
                        </div>
                        <div class="form-group">
                            <label for="iContratoFiltro">@RsCadastros.CONTRATO:</label>
                            <select class="form-control filtro" id="iContratoFiltro"></select>
                        </div>
                        <div class="form-group">
                            <label for="iProjetoFiltro">@RsCadastros.PROJETO:</label>
                            <select class="form-control filtro" id="iProjetoFiltro"></select>
                        </div>
                        <div class="form-inline fs-12">
                            <label for="iProjetoFiltro">@RsCadastros.VISUALIZAR_LOCALIDADE_SEM_LOCALIZACAO</label>
                            <input type="checkbox" id="iVisualizarSemLocalizacao" class="form-control m-2">
                        </div>

                    </div>
                    <div class="form-group col-sm-12" style="padding: 15px;">
                        <div class="text-center">
                            <button type="button" class="btn btn-danger" id="iLimparFiltroModal"> Limpar Campo</button>
                            <button type="button" class="btn btn-success" id="iPesquisar"> Filtrar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divTable">
        <table class="table table-hover nowrap" id="datatable" style="width:100%">
        </table>
    </div>

}