                                        <div class="row">
                                            <div class="col">
                                                <div class="form-group">
                                                    <label class="form-inline" for="iConcluir_Atendi_Auto_Apos_x_Minutos_Envio_Notif_Inatividade">
                                                        @RsCadastros.CONCLUIR_ATENDI_AUTO_DEPOIS_DE

                                                        @Html.TextBoxFor(m => m.Concluir_Atendi_Auto_Apos_x_Minutos_Envio_Notif_Inatividade, new { @class = "form-control ml-2 mr-2 text-center", @id = "iConcluir_Atendi_Auto_Apos_x_Minutos_Envio_Notif_Inatividade", @name = "nConcluir_Atendi_Auto_Apos_x_Minutos_Envio_Notif_Inatividade", @autocomplete = "off", @style = "width: 50px;", @maxlength = "2" })
                                                        minutos do envio da notificação por inatividade.
                                                    </label>
                                                    @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
