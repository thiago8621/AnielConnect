        },
         TableManageButtons_Tipo_atendimento = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons_Tipo_atendimento();
                    }
                }
            }();

        TableManageButtons_Tipo_atendimento.init();

        var handleDataTableButtonsLocalidade = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Localidades));

            var nome_lista = "Localidades";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            var oDatatableLocalidade = $("#datatableLocalidade").length && $("#datatableLocalidade").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            return '<a href="#" class="btnExcluirLocalidade" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Area" name="' + nome_lista + '[' + meta.row + '].Cod_Area" type="hidden" value="' + TrataNulo(row.Cod_Area) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Escritorio" name="' + nome_lista + '[' + meta.row + '].Cod_Escritorio" type="hidden" value="' + TrataNulo(row.Cod_Escritorio) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Cod_Localidade" name="' + nome_lista + '[' + meta.row + '].Cod_Localidade" type="hidden" value="' + TrataNulo(row.Cod_Localidade) + '">';

                        }
                    },
                    {
                        data: "Desc_Escritorio",
                        title: "@RsCadastros.GRUPO_AREA",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Desc_Escritorio" name="' + nome_lista + '[' + meta.row + '].Desc_Escritorio" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Desc_Area",
                        title: "@RsCadastros.AREA",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                var valor = row.Todas_Areas == 1 ? "@RsBase.TODAS" : data;

                                data = valor + ' <input id="' + nome_lista + '_' + meta.row + '__Desc_Escritorio" name="' + nome_lista + '[' + meta.row + '].Desc_Area" type="hidden" value="' + TrataNulo(data) + '">' +
                                    ' <input id="' + nome_lista + '_' + meta.row + '__Todas_Areas" name="' + nome_lista + '[' + meta.row + '].Todas_Areas" type="hidden" value="' + TrataNulo(row.Todas_Areas) + '">';
                            }
                            return data;
                        }
                    },
                    {
                        data: "Desc_Localidade",
                        title: "@RsCadastros.LOCALIDADE",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                var valor = row.Todas_Localidades == 1 ? "@RsBase.TODAS" : data;

                                data = valor + ' <input id="' + nome_lista + '_' + meta.row + '__Desc_Escritorio" name="' + nome_lista + '[' + meta.row + '].Desc_Localidade" type="hidden" value="' + TrataNulo(data) + '">' +
                                    ' <input id="' + nome_lista + '_' + meta.row + '__Todas_Localidades" name="' + nome_lista + '[' + meta.row + '].Todas_Localidades" type="hidden" value="' + TrataNulo(row.Todas_Localidades) + '">';
                            }
                            return data;
                        }
                    }
                ],
                paging:false
            });

            function handleExcluirLocalidade() {
                $(".btnExcluirLocalidade").unbind('click');
                $(".btnExcluirLocalidade").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatableLocalidade.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/agenteapi/ExcluirGridLocalidade?value=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatableLocalidade.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });
            }

            handleExcluirLocalidade();

            $("#btnAdicionarLocalidade").on('click', function () {
                var erro = false;
                
                if (!$("#iTodas_Localidades").is(":checked")) {
                    $("#iLocalidade").addClass("obrigatorioLocalidade");
                }
                else {
                    $("#iLocalidade").removeClass("obrigatorioLocalidade");
                }

                if ($("#iTodas_Areas").is(":checked")) {
                    $("#iArea").removeClass("obrigatorioLocalidade");
                    $("#iLocalidade").removeClass("obrigatorioLocalidade");
                    $("#iTodas_Localidades").prop("checked", true);
                }

                if (ValidaObrigatoriosPorClasse("obrigatorioLocalidade", false)) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                    return false;
                }

                for (var i = 0; i < oDatatableLocalidade.rows().data().length; i++) {
                    if (oDatatableLocalidade.rows().data()[i].Cod_Area == $("#iArea option:selected").val() && oDatatableLocalidade.rows().data()[i].Cod_Escritorio == $("#iGrupoArea option:selected").val()
                        && oDatatableLocalidade.rows().data()[i].Cod_Localidade == $("#iLocalidade option:selected").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.LOCALIDADE)", "warning");
                        erro = true;
                        i = oDatatableLocalidade.rows().data().length;
                    }
                }

                if (erro) {
                    return false;
                }

                oDatatableLocalidade.row.add({
                    Cod_Escritorio: $("#iGrupoArea option:selected").val(),
                    Cod_Area: $("#iArea option:selected").val(),
                    Cod_Localidade: $("#iLocalidade option:selected").val(),
                    Desc_Escritorio: $("#iGrupoArea option:selected").text(),
                    Desc_Area: $("#iArea option:selected").text(),
                    Desc_Localidade: $("#iLocalidade option:selected").text(),
                    Todas_Localidades: $("#iTodas_Localidades").is(":checked"),
                    Todas_Areas: $("#iTodas_Areas").is(":checked"),
                    Id: 0
                }).draw(false);
                
                handleExcluirLocalidade();

                $("#iGrupoArea").val(null).trigger('change');
                $("#iArea").val(null).trigger('change');

                $("#iLocalidade").val(null).trigger("change");
                $("#iTodas_Localidades").prop("checked", false);
                $('#iTodas_Localidades').trigger("change");
                $("#iTodas_Areas").prop("checked", false);
                $('#iTodas_Areas').trigger("change");
            });


        },
            TableManageButtonsLocalidade = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtonsLocalidade();
                    }
                }
            }();

        TableManageButtonsLocalidade.init();


