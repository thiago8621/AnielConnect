                                                        @Html.TextBoxFor(m => m.Enviar_Notif_Cliente_Conclusao_Auto_Apos_x_Minutos, new { @class = "form-control ml-2 mr-2 text-center", @id = "iEnviar_Notif_Cliente_Conclusao_Auto_Apos_x_Minutos", @name = "nEnviar_Notif_Cliente_Conclusao_Auto_Apos_x_Minutos", @autocomplete = "off", @style = "width: 50px;", @maxlength = "2" })
                                                        minutos.
                                                    </label>
                                                    @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                                                </div>
