@model Aniel.Connect.Models.AgenteCadastroModel
@using Resources
@using Aniel.Connect.Core.Helpers
@using Aniel.Connect.Models.T5
@using System.Linq.Expressions;
@{
    ViewBag.Title = RsCadastros.CADASTRO_AGENTE;
    Layout = "~/Views/Shared/_LayoutLimpo.cshtml";
    //List<AreaModuloModel> _areas = ViewBag.Areas;
}

@section styles
{
    <style>
        .toggle btn btn-success {
            height: 23px !important;
        }
    </style>

}

@section scripts
{

    @Styles.RenderFormat(SiteKeys.ScriptVersion, "~/bundles/jsDataTableSimples")
<script>
        ///<reference path="../../../../AnielConnectCore/Aniel.Connect.Core/Scripts/connect.js" />
        $(document).ready(function () {
            AddSelect("iUsuario", "@CONSTANTES.URLPortal/api/Identity_UserApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iCategoria", "@CONSTANTES.URLPortal/api/Categoria_ClienteApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iGrupoArea", "@CONSTANTES.URLPortal/api/GrupoAreaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, HandleGrupo);
            AddSelect("iArea", "@CONSTANTES.URLPortal/api/Areaapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true, HandleArea);
            AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
            AddSelect("iTipo_atendimento", "@CONSTANTES.URLPortal/api/Tipo_Atendimentoapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            AddSelect("iBot", "@CONSTANTES.URLPortal/api/Botapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, "@Model.IdBot", "@RsBase.SELECIONE", false);
            $(`#iAtivar_Inatividade`).trigger(`change`);
            $(`#iPerfil_Atende_Chat`).trigger(`change`);

            $("#iTodas_Areas").prop('disabled', true);
        });

        var HandleArea = function () {
            $('#iArea').unbind('select2:select select2:unselecting');
            $('#iArea').on('select2:select select2:unselecting', function (e) {

                AreaSelecionada = e.params.data
                if (AreaSelecionada) {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, $('#iGrupoArea').val(), String(AreaSelecionada.id), null, "@RsBase.SELECIONE", false);
                }
                else {
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }
            });
        };

        var HandleGrupo = function () {
            $('#iGrupoArea').on('select2:select select2:unselecting', function (e) {

                $("#iTodas_Areas").prop('disabled', true);
                GrupoSelecionado  = e.params.data
                if (GrupoSelecionado) {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, String(GrupoSelecionado.id), null, "@RsBase.SELECIONE", false);
                    AddSelect("iLocalidade", "@CONSTANTES.URLPortal/api/Localidadeapi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);

                    $("#iTodas_Areas").prop('disabled', false);
                }
                else {
                    AddSelect("iArea", "@CONSTANTES.URLPortal/api/AreaApi/GetCombo", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", true);
                }

            });
        };

        $(`#iAtivar_Inatividade`).change(function () {
            if (this.checked == true) {
                $(`#iDivInatividade`).show();
            }
            else {
                $(`#iDivInatividade`).hide();
            }
        });

        $(`#iPerfil_Atende_Chat`).change(function () {
            if (this.checked == true) {
                $(`#iDivChat`).show();


                if (!$('#iNumero_Max_Atendi_Simultaneo_Por_Agente').val()) {
                    $('#iNumero_Max_Atendi_Simultaneo_Por_Agente').val(1);
                }

            }
            else {
                $(`#iDivChat`).hide();
            }
        });

        $('#iNumero_Max_Atendi_Simultaneo_Por_Agente').on('change blur', function () {

            let atendeChat = document.getElementById('iPerfil_Atende_Chat').checked;
            if (atendeChat && $(this).val().trim().length === 0) {
                $(this).val(1);
            }

            if ($(this).val() > 2000) {
                Notificar("@RsBase.ATENCAO_", "Numero máximo de atendimentos é 2000.", "warning");
                $(this).val(2000);

            }

        })




        var handleDataTableButtons = function () {
            "use strict";

            var array = @Html.Raw(Json.Encode(Model.Categorias));

            var nome_lista = "Categorias";//Nome_utilizado para enganar o razor

            //"Blfrtip"
            var oDatatable = $("#datatable").length && $("#datatable").DataTable({
                dom: "Bfrti",
                language: traducaoDataTableSimples,
                data: array,
                columns: [
                    {
                        data: "Id",
                        render: function (data, type, row, meta) {
                            return '<a href="#" class="btnExcluirCategoria" id="btnExcluir_' + meta.row + '" excluir="' + row.Id + '"><i class="far fa-trash-alt" style="font-size:16px;;padding-right:2px;"></i></a>' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id" name="' + nome_lista + '[' + meta.row + '].Id" type="hidden" value="' + TrataNulo(data) + '">' +
                                ' <input id="' + nome_lista + '_' + meta.row + '__Id_Categoria" name="' + nome_lista + '[' + meta.row + '].Id_Categoria" type="hidden" value="' + TrataNulo(row.Id_Categoria) + '">';
                        }
                    },
                    {
                        data: "Categoria",
                        title: "@RsCadastros.CATEGORIA",
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = data + ' <input id="' + nome_lista + '_' + meta.row + '__Categoria" name="' + nome_lista + '[' + meta.row + '].Categoria" type="hidden" value="' + TrataNulo(data) + '">';
                            }
                            return data;
                        }
                    }
                ],
                paging: false,
            });

            function handleExcluirCategoria() {
                $(".btnExcluirCategoria").unbind('click');
                $(".btnExcluirCategoria").click(function (e) {
                    e.preventDefault();

                    var idArquivo = $(this).attr("excluir");

                    var trLinkButton = $(this).parents('tr');

                    if (idArquivo === "0") {
                        oDatatable.row(trLinkButton).remove().draw(false);
                        Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                    }
                    else {

                        var link = '@String.Concat(CONSTANTES.URLPortal, "/api/agenteapi/ExcluirGridCategoria?value=")' + idArquivo;

                        $.ajax({
                            url: link,
                            type: 'GET',
                            dataType: 'json',

                        })
                            .done(function (data) {

                                if (data.ok) {
                                    oDatatable.row(trLinkButton).remove().draw(false);
                                    Notificar("@RsBase.OPERACAOBEMSUCEDIDA", "@RsBase.REGISTROREMOVIDO", "info");
                                }
                                else {
                                    Notificar("@RsBase.ATENCAO_", data.mensagem, "warning");
                                }
                            })
                            .fail(function () {

                            })
                            .always(function () {

                            });
                    }

                });
            }



            handleExcluirCategoria();

            $("#btnAdicionar").on('click', function () {

                var erro = false;
                if (ValidaObrigatoriosPorClasse("obrigatorioCategoria", false)) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                    return false;
                }


                for (var i = 0; i < oDatatable.rows().data().length; i++) {

                    if (oDatatable.rows().data()[i].Id_Categoria == $("#iCategoria option:selected").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.CATEGORIA)", "warning");
                        erro = true;
                        i = oDatatable.rows().data().length;
                    }

                }

                if (erro) {
                    return false;
                }


                oDatatable.row.add({
                    Id_Categoria: $("#iCategoria option:selected").val(),
                    Categoria: $("#iCategoria option:selected").text(),
                    Id: 0
                }).draw(false);

                $("#iCategoria").val(null).trigger('change');

                handleExcluirCategoria();
            });


        },
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                }
            }();

    TableManageButtons.init();

