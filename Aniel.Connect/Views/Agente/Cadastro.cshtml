                });
            }



            handleExcluir();

            $("#btnAdicionarUsuario").on('click', function () {

                var erro = false;


                if (ValidaObrigatoriosPorClasse("obrigatorioUsuario", false)) {
                    Notificar("@RsBase.ATENCAO_", "@RsBase.PREENCHA_CAMPOS_OBRIGATORIOS", "warning");
                    return false;
                }


                for (var i = 0; i < oDatatableUsuario.rows().data().length; i++) {
                    if (oDatatableUsuario.rows().data()[i].Usuario_Id == $("#iUsuario option:selected").val()) {
                        Notificar("@RsBase.ATENCAO_", "@String.Format(RsBase.JA_EXISTE, RsCadastros.USUARIO)", "warning");
                        erro = true;
                        i = oDatatableUsuario.rows().data().length;
                    }
                }

                if (erro) {
                    return false;
                }


                oDatatableUsuario.row.add({
                    Usuario_Id: $("#iUsuario option:selected").val(),
                    Usuario: $("#iUsuario option:selected").text(),
                    Id: ""
                }).draw(false);

                $("#iUsuario").val(null).trigger('change');


                handleExcluir();
            });


        },
            TableManageButtonsUsuario = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtonsUsuario();
                    }
                }
            }();

        TableManageButtonsUsuario.init();


        var clicked = false;
        function ValidaSubmit()
        {
            if (clicked) {
                return false;
            }

            clicked = true;


            erro = false;

	        if (erro) {
                clicked = false;
                return false;
            }

            ShowPageLoading();
            $('#form').submit();
            return true;
        }

</script>
}


