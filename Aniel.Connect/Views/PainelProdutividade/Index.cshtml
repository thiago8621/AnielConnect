    function RecarregarTela() {
        window.location.href = '@Url.Action("Index", "PainelProdutividade")';
    }

    async function GravarConfiguracoes() {

        var validarCampos = ValidarCamposConfig();

        if (validarCampos) {
            Notificar("Alerta", "Valide os campos a serem preenchidos e tente novamente", "warning");
        }

        let urlGravarConfig = baseUrl + '/api/PainelProdutividadeApi/GravarConfiguracoes';

        let resultado = await $.ajax({
            url: urlGravarConfig,
            type: 'POST',
            dataType: 'json',
            data: {
                id: "1",
                producaoPorcentTec: $('#iProducaoValue').val(),
                metaProdutivaTec: $('#iMetaProdutivaTec').val(),
                revisitaPorcentTec: $('#iRevisitaValue').val(),
                metaRevisitaTec: $('#iMetaRevisitaTec').val(),
                baixasPrazoPorcentTec: $('#iBaixasValue').val(),
                metaBaixasPrazoTec: $('#iMetaBaixasTec').val(),
                vistoriaPorcentTec: $('#iVistoriaValue').val(),
                metaVistoriaTec: $('#iMetaVistoriaTec').val(),
                sLAPorcentTec: $('#iSLAValue').val(),
                metaSLATec: $('#iMetaSLATec').val(),
                // Configs Supervisor
                producaoPorcentSup: $('#iProducaoValueSup').val(),
                metaProdutivaSup: $('#iMetaProdutivaSup').val(),
                revisitaPorcentSup: $('#iRevisitaValueSup').val(),
                metaRevisitaSup: $('#iMetaRevisitaSup').val(),
                baixasPrazoPorcentSup: $('#iBaixasValueSup').val(),
                metaBaixasPrazoSup: $('#iMetaBaixasSup').val(),
                qualidadePorcentSup: $('#iQualidadeValueSup').val(),
                metaQualidadeSup: $('#iMetaQualidadeSup').val(),
                sLAPorcentSup: $('#iSLAValueSup').val(),
                metaSLASup: $('#iMetaSLATecSup').val(),
                // Configs Monitor
                producaoPorcentMon: $('#iProducaoValueMon').val(),
                metaProdutivaMon: $('#iMetaProdutivaMon').val(),
                revisitaPorcentMon: $('#iRevisitaValueMon').val(),
                metaRevisitaMon: $('#iMetaRevisitaMon').val(),
                rTIPorcentMon: $('#iRTIValue').val(),
                metaRTIMon: $('#iMetaRTIMon').val(),
