    const handleDataTableButtons = async function () {
        "use strict";

         let link = baseUrl;
         var tipoSelecionado = $('input[name="iAgroup"]:checked').val();

         if (tipoSelecionado === "0") {
             link = link + '/api/PainelProdutividadeApi/GetAllTecnicos';
             $("#selectAgroup option[value='0']").prop("selected", true);
         }
         else if (tipoSelecionado === "1") {
             link = link + '/api/PainelProdutividadeApi/GetAllSupervisores';
             $("#selectAgroup option[value='1']").prop("selected", true);
         }
         else {
             link = link + '/api/PainelProdutividadeApi/GetAllMonitores';
             $("#selectAgroup option[value='2']").prop("selected", true);
         }

         let resultado = await $.ajax({
             url: link,
             type: 'POST',
             dataType: 'json',
             data: {
                 grupoArea: $("#iGrupoAreaId").val(),
                 tipoSelecionado: $('input[name="iAgroup"]:checked').val(),
                 pessoaAgrupamento: $("#iAgroupId").val(),
                 contratoValor: $("#iContratoId").val(),
                 projetoValor: $("#iProjetoId").val(),
                 dataInicio: $("#iDataInicial").val(),
                 dataFim: $("#iDataFim").val(),
                 tipoData: $('input[name="iTipoData"]:checked').val()
             },
             beforeSend: function () {
                 ShowPageLoading();
             },
             complete: function (data) {
                 HidePageLoading();
             }
         });


        AtualizarHeader($('input[name="iAgroup"]:checked').val());

        TagFilter("FiltrosUtilizados", filter_state());

        oDatatable = $('#datatable').DataTable({
            dom: "Bfrti",
            orderCellsTop: true,
            orderable: false,
            columns: tipoSelecionado === "0" ? colunasTecnicos : (tipoSelecionado === "1" ? colunasSupervisores : colunasMonitores),
            data: resultado,
            paging: false,
            searching: false,
            scrollX: true,
            /*scrollY: '800px',*/
            scrollCollapse: true,
            buttons: buttonsDataTable,
            drawCallBack: function () {
                HidePageLoading();
            }
        });
    },
        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtons();
                }
            }
        }();


        $("#iAplicarFiltro").on('click', function () {

            var valido = ValidarCamposFiltros();

            if (!valido)
                return;

            $('#iFiltro').modal('hide');
            TableManageButtons.init();
        });

        $('#iContratoId').on('change', function () {
            if (!$('#iContratoId').val()) {
                $('#iProjetoId').empty();
                $('#iProjetoId').prop('disabled', true);
                return;
            }
            $('#iProjetoId').prop('disabled', false);
        });


        $('input[name="iAgroup"]').on('click', async function () {
            let valueSelect = $('input[name="iAgroup"]:checked').val();

            if (valueSelect === '0') {
                $('#iLabelAgroup').text(null);
                $('#iLabelAgroup').text("Técnico:");
                await AddSelect('iAgroupId', '@CONSTANTES.URLPortal/api/EquipeApi/GetCombo', @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false, null)
            }
            else if (valueSelect === '1') {
                $('#iLabelAgroup').text(null);
                $('#iLabelAgroup').text("Supervisor:");
                await AddSelect("iAgroupId", "@CONSTANTES.URLPortal/api/FuncionarioAnielapi/GetComboSupervisor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            }
            else {
                $('#iLabelAgroup').text(null);
                $('#iLabelAgroup').text("Monitor:");
                await AddSelect('iAgroupId', "@CONSTANTES.URLPortal/api/IdentityUserApi/GetComboMonitor", @CONSTANTES.PaginacaoRegistros, null, null, null, "@RsBase.SELECIONE", false);
            }
        });

        $("#iLimparFiltro").on('click', function () {
            $('#iDataInicial').val('');
            $('#iDataFim').val('');
            $('#iAgroupId').empty();
            $('#iContratoId').empty();
            $('#iProjetoId').empty();
            $('#iGrupoAreaId').empty();

            $('#iFiltro').modal('show');
        });

        $("#iLimparFiltrosModal").on('click', function () {
            $('#iDataInicial').val('');
            $('#iDataFim').val('');
            $('#iAgroupId').empty();
            $('#iContratoId').empty();
            $('#iProjetoId').empty();
            $('#iGrupoAreaId').empty();

            $('#iFiltro').modal('show');
        });
</script>
