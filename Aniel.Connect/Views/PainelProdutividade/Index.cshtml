    function ValidarCamposFiltros() {
        var dateInicial = $("#iDataInicial").val();
        var dateFinal = $("#iDataFim").val();

        var tipoData = $('input[name="iTipoData"]:checked').val();

        if (!tipoData) {
            Notificar("Alerta", "Selecione o Período", "warning");
            return false;
        }

        if (!dateInicial && !dateFinal) {
            Notificar("Alerta", "Preencha a Data Inicial", "warning");
            Notificar("Alerta", "Preencha a Data Final", "warning");
            return false;
        }

        if (!dateInicial) {
            Notificar("Alerta", "Preencha a Data Inicial", "warning");
            return false;
        }

        if (!dateFinal) {
            Notificar("Alerta", "Preencha a Data Final", "warning");
            return false;
        }

        if (DataMaior('iDataInicial', 'iDataFim')) {
            Notificar("Alerta", "A Data Inicial não pode ser maior que a Data Final", "warning");
            return false;
        }

        let diferencaDias = DateDiff(dateInicial, dateFinal);

        if (diferencaDias > 31) {
            Notificar("Alerta", "O período filtrado é maior que 31 dias!", "warning");
            return false;
        }

        if ($('#iProjetoId').val()) {
            if (!$('#iContratoId').val()) {
                Notificar("Alerta", "Selecione o Contrato", "warning");
                return false;
            }
        }

        return true;
    }

