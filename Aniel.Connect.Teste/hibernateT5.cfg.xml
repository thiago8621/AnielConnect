<hibernate-configuration  xmlns="urn:nhibernate-configuration-2.2" >
  <session-factory>
    <property name="connection.driver_class">NHibernate.Driver.FirebirdClientDriver</property>
    <property name="current_session_context_class">web</property>
    <property name="connection.connection_string">
      Server=cloud.sinapseinformatica.com.br/3051;
      database=cloud.sinapseinformatica.com.br/3051:C:\BD_INTERNO\TESTE\SINAPSE.FDB;
      User=SYSDBA;
      Password=masterkey;
      <!--Server=cloud.sinapseinformatica.com.br/3052;
      Database=cloud.sinapseinformatica.com.br/3052:C:\BD\Apresentacao-novo\SINAPSE.FDB;
      User=SYSDBA;
      Password=masterkey;-->
    </property>
    <property name="adonet.batch_size">200</property>
    <property name="hbm2ddl.auto">none</property>
