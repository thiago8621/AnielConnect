<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Acesso" table="TB_ACESSO" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <many-to-one name="Area_Modulo" class="Area_Modulo" column="ID_AREA_MODULO" foreign-key="fk_acesso_area" cascade="none"  />   
    <many-to-one name="Usuario" class="Usuario" column="ID_USUARIO" foreign-key="fk_acesso_usuario" cascade="none"  />
    
  </class>
</hibernate-mapping>