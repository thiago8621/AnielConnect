<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Documento_Producao" table="TB_DOCUMENTO_PRODUCAO" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <many-to-one name="Projeto" class="Projeto" column="ID_PROJETO" foreign-key="fk_doc_projeto" cascade="none"  />
    <many-to-one name="Equipe" class="Equipe" column="ID_EQUIPE" foreign-key="fk_doc_equipe" cascade="none"  />

    <property name="Num_Obra" column="NUM_OBRA" type="String" length="50" />
    <property name="Num_Doc" column="NUM_DOC" type="Int32" />

    <property name="Num_RVT" column="NUM_RVT" type="String" length="15" />
    <property name="Tarefa" column="TAREFA" type="String" length="15" />
    
    <many-to-one name="Escritorio" class="Escritorio" column="ID_ESCRITORIO" foreign-key="fk_doc_escritorio" cascade="none"  />
    <many-to-one name="Area" class="Area" column="ID_AREA" foreign-key="fk_doc_area" cascade="none"  />
    <many-to-one name="Localidade" class="Localidade" column="ID_LOCALIDADE" foreign-key="fk_doc_localidade" cascade="none"  />
    <many-to-one name="Codigo_Encerramento" class="Codigo_Encerramento" column="ID_COD_ENCERRAMENTO" foreign-key="fk_doc_codencerramento" cascade="none"  />

    <many-to-one name="Tipo_Servico_Equipe" class="Tipo_Servico_Equipe" column="ID_TIPO_SERVICO" foreign-key="fk_doc_codencerramento" cascade="none"  />
    <many-to-one name="Sub_Tipo_Servico" class="Sub_Tipo_Servico" column="ID_SUB_TIPO" foreign-key="fk_doc_codencerramento" cascade="none"  />
    
    <property name="Data_Agendamento" column="DATA_AGENDAMENTO" type="DateTime" />
    <property name="Data_Producao" column="DATA_PRODUCAO" type="DateTime" />
    <property name="Hora_Producao" column="HORA_PRODUCAO" type="DateTime" />
    <property name="Observacao" column="OBSERVACAO" type="String" length="100" />
    <property name="Logradouro" column="LOGRADOURO" type="String" length="100" />
    <property name="Numero" column="NUMERO" type="String" length="10" />
    <property name="Complemento" column="COMPLEMENTO" type="String" length="100" />
    <property name="Bairro" column="BAIRRO" type="String" length="100" />
    <property name="Cep" column="CEP" type="String" length="20" />
    <property name="Latitude_Baixa" column="LATITUDE_BAIXA" type="Double" />
    <property name="Longitude_Baixa" column="LONGITUDE_BAIXA" type="Double" />

  </class>
</hibernate-mapping>