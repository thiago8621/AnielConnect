<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Tipo_Imovel" table="TB_TIPO_IMOVEL" lazy="false">
    
    <id name="Id" column="ID" type="Int64">
      <generator class="sequence">
        <param name="sequence">GN_TIPO_IMOVEL</param>
      </generator>
    </id>

    <property name="Cod_Tipo_Imovel" column="COD_TIPO_IMOVEL" type="Int32" />
    <property name="Descricao" column="DESCRICAO" type="String" length="50" />
  
  </class>
</hibernate-mapping>