<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Projeto" table="TB_PROJETO" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    
    <property name="Codigo" column="PROJETO" type="String" length="20" />
    <property name="Localidade" column="LOCALIDADE" type="String" length="50" />

    <property name="IniPrev" column="INIPREV" type="DateTime" />
    <property name="TermPrev" column="TERMPREV" type="DateTime" />
    <property name="IniReal" column="INIREAL" type="DateTime" />
    <property name="TermReal" column="TERMREAL" type="DateTime" />
    <property name="TermReal2" column="TERMREAL2" type="DateTime" />

    <many-to-one name="Contrato" class="Contrato" column="ID_CONTRATO" foreign-key="fk_projeto_contrato" cascade="none"  />
    
    <many-to-one name="Projeto_Regulador" class="Projeto" column="ID_PROJETOREGULADOR" foreign-key="fk_projeto_projetoreg" cascade="none"  />
    <many-to-one name="Filial" class="Filial" column="ID_FILIAL" foreign-key="fk_projeto_filial" cascade="none"  />

  </class>
</hibernate-mapping>