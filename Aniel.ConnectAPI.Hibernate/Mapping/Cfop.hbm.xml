<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Cfop" table="TB_CFOP" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="sequence">
        <param name="sequence">GN_CFOP</param>
      </generator> 
    </id>

    <property name="Codigo" column="CODIGO" type="String" length="20" />
    <property name="Descricao" column="DESCRICAO" type="String" length="100" />
    
  </class>
</hibernate-mapping>