<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Area_Modulo" table="TB_AREA_MODULO" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <property name="Sigla_Modulo" column="SIGLA_MODULO" type="String" length="10"/>
    <property name="Cod_Area" column="COD_AREA" type="String" length="4" />
    <property name="Descricao" column="DESCRICAO" type="String" length="50" />
    <property name="Sub_Acesso" column="SUB_ACESSO" type="String" length="2" />
    
  </class>
</hibernate-mapping>