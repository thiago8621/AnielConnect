<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Funcionario" table="TB_FUNCIONARIO" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <property name="Num_Fre" column="NUM_FRE" type="String" length="6" />
    <property name="Nome" column="NOME" type="String" length="50" />
    <property name="Tel_Celular" column="TEL_CELULAR" type="String" length="15" />
    <property name="Situacao" column="SITUACAO" type="Int16" />

    <property name="Cpf" column="CPF" type="String" />

    <property name="Id_Centro_Custo" column="Id_Centro_Custo" type="Int64" />

    <property name="Supervisor" column="E_SUPERVISOR" type="Int16" />

    <property name="Id_Filial" column="ID_FILIAL" type="Int64" />

    <!--many-to-one name="Filial" class="Filial" column="ID_FILIAL" foreign-key="fk_funcionario_filial" cascade="none"  />-->

    <property name="Id_Departamento" column="ID_DEPARTAMENTO" type="Int64" />
    
  </class>
</hibernate-mapping>