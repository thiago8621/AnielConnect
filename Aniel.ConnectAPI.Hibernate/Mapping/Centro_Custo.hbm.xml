<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Centro_Custo" table="TB_CENTRO_CUSTO" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="sequence">
        <param name="sequence">GN_CENTRO_CUSTO</param>
      </generator>
    </id>
    <property name="Codigo" column="CODIGO" type="Int32" />
    <property name="Cod_Aux" column="COD_AUX" type="String" />
    <property name="Descricao" column="DESCRICAO" type="String" length="30" />
    <property name="Status" column="STATUS" type="Int32" />
  </class>
</hibernate-mapping>