<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Departamento" table="TB_DEPARTAMENTO" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="assigned" />
    </id>

    <property name="Cod_Depto" column="COD_DEPTO" type="Int16" />
    <property name="Num_Depto" column="NUM_DEPTO" type="String" length="10" />
    <property name="Descricao" column="DESCRICAO" type="String" length="30" />
    
  </class>
</hibernate-mapping>