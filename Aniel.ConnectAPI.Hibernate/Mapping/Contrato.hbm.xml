<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Contrato" table="TB_CONTRATO" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <property name="CodCt" column="CODCT" type="String" length="4" />
    <property name="Descricao" column="DESCRICAO" type="String" length="30" />
    <property name="Localidade" column="LOCALIDADE" type="String" length="40" />    
    <property name="Fornec_Mat_Padrao" column="FORNEC_MAT_PADRAO" type="String" length="1" />        
    <property name="TipoSaldo" column="TIPOSALDO" type="String" length="10" />    
    <property name="TipoSaldoAplic" column="TIPOSALDOAPLIC" type="String" length="10" />    

    <many-to-one name="Projeto_Regulador" class="Projeto" column="ID_PROJETOREGULADOR" foreign-key="fk_contrato_projetoreg" cascade="none"  />
    <many-to-one name="Filial" class="Filial" column="ID_FILIAL" foreign-key="fk_contrato_filial" cascade="none"  />

  </class>
</hibernate-mapping>