<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Filial" table="TB_FILIAL" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <property name="CodFilial" column="CODFILIAL" type="Int16" />
    <property name="Nome" column="NOME" type="String" length="40" />
    
    <property name="CodigoCedente" column="CODIGOCEDENTE" type="String" length="40" />
    <property name="DigitoVerificadorCedente" column="DIGITOVERIFICADORCEDENTE" type="String" length="2" />
    <property name="Carteira" column="CARTEIRA" type="String" length="10" />
    <property name="Cnpj" column="CNPJ" type="String" length="14" />
    
    <property name="Endereco" column="ENDERECO" type="String" length="50" />
    <property name="Numero" column="NUMERO" type="Int32" />
    <property name="Bairro" column="BAIRRO" type="String" length="20" />
    <property name="Cidade" column="CIDADE" type="String" length="20" />
    <property name="Cep" column="CEP" type="String" length="10" />
    <property name="Uf" column="UF" type="String" length="2" />

    <property name="Natureza_tributacao" column="NATUREZA_TRIBUTACAO" type="Int32" />
    <property name="Razao_Social" column="RAZAO_SOCIAL" type="String" length="100"/>
    <property name="Optante_Simples_Nacional" column="OPTANTE_SIMPLES" type="Boolean" />
    <property name="Regime_Tributario" column="REGIME_TRIBUTARIO" type="Int32" />
    <property name="Incentivo_Cultural" column="INCENTIVO_CULTURAL" type="Boolean" />
    <property name="Incentivo_Fiscal" column="INCENTIVO_FISCAL" type="Boolean" />
    <property name="Regime_Tributario_Especial" column="REGIME_TRIBUTARIO_ESPECIAL" type="Int32" />
    <property name="DDD" column="DDD" type="String" length="5"/>
    <property name="Email" column="EMAIL_NFE" type="String" length="100"/>
    <property name="CNAE_Fiscal" column="CENAE_FISCAL" type="String" length="20"/>
    <property name="Tipo_Tributacao_ISS" column="TIPO_TRIBUTACAO_ISS" type="Int32" />
    <property name="Exigibilidade_ISS" column="EXIGIBILIDADE_ISS" type="Int32" />
    <property name="Num_Processo_Suspensao" column="NUM_PROCESSO_SUSPENSAO" type="String" length="20" />
    <property name="Inscricao_Estadual" column="INSCRICAO" type="String" length="100" />
    <property name="Inscricao_Municipal" column="INSCRICAO_MUNICIPAL" type="String" length="100" />
    
    <many-to-one name="Empresa" class="Empresa" column="ID_EMPRESA" foreign-key="fk_filial_empresa" cascade="none"  />
    

  </class>
</hibernate-mapping>