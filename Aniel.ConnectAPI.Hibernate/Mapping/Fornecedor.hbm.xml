<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Fornecedor" table="TB_FORNECEDOR" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="sequence">
        <param name="sequence">GN_FORNECEDOR</param>
      </generator>
    </id>

    <property name="Cod_Fornecedor" column="COD_FORNECEDOR" type="String" length="6" />
    <property name="RazaoSocial" column="RAZAO_SOCIAL" type="String" length="50" />
    <property name="Descricao" column="DESCRICAO" type="String" length="100" />

    <property name="Cnpj" column="CNPJ" type="String" />
    <property name="Endereco" column="ENDERECO" type="String" />
    <property name="Complemento" column="COMPLEMENTO" type="String" />
    <property name="Numero" column="ENDERECO_NUMERO" type="Int32" />
    <property name="Bairro" column="BAIRRO" type="String" />
    <property name="Municipio" column="MUNICIPIO" type="String" />
    <property name="Cep" column="CEP" type="String" />
    <property name="Uf" column="UF" type="String" />
    <property name="Pais" column="PAIS" type="String" />
    <property name="Insc_Estadual" column="INSC_ESTADUAL" type="String" />
    <property name="Telefone" column="TELEFONE" type="String" />
    <property name="Email" column="EMAIL" type="String" />
    
  </class>
</hibernate-mapping>