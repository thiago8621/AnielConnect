<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Localidade" table="TB_LOCALIDADE" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <property name="LocalidadeStr" column="LOCALIDADE" type="String" length="30" />
    <property name="Cod_Localidade" column="COD_LOCALIDADE" type="Int32" />

    <many-to-one name="Area" class="Area" column="ID_AREA" foreign-key="fk_localidade_area" cascade="none"  />

  </class>
</hibernate-mapping>