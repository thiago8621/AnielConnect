<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Usuario" table="ASPNETUSERS" lazy="false">

    <id name="Id" column="ID" type="String" length="255">
      <generator class="assigned" />
    </id>

    <property name="Usuario_Aniel" column="EMAIL" type="String" length="255" />
    <property name="Nome" column="USERNAME" type="String" length="255" />
    <property name="Senha_Aniel" column="SENHA_ANIEL" type="String" length="40" />
    <property name="SecurityStamp" column="SECURITYSTAMP" type="String" length="255" />

    <property name="IdFuncionario" column="ID_FUNCIONARIO" type="Int64" />

    <property name="IdDepartamento" column="ID_DEPARTAMENTO" type="Int64" />

    <property name="Ativo" column="ATIVO" type="Int16" />
  </class>
</hibernate-mapping>