<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Perfil_Equipe" table="TB_PERFIL_EQUIPE" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <property name="Cod_Perfil_Equipe" column="COD_PERFIL_EQUIPE" type="Int32" />
    
    <property name="Nome" column="NOME" type="String" length="30" />    
    
  </class>
</hibernate-mapping>