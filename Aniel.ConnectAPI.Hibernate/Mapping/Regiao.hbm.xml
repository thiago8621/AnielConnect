<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Regiao" table="TB_REGIAO" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <property name="Cod_Regiao" column="COD_REGIAO" type="Int16" />
    <property name="Nome" column="NOME" type="String" length="50" />    

  </class>
</hibernate-mapping>