<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Empresa" table="TB_EMPRESA" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="assigned" />
    </id>

    <property name="CodEmpresa" column="CODEMPRESA" type="Int16" />
    <property name="Nome" column="NOME" type="String" length="30" />
    <property name="Razao_Social" column="RAZAO_SOCIAL" type="String" length="60" />


    <property name="Logotipo" column="LOGOTIPO" />
    <property name="Data_Alteracao" column="DATA_ALTERACAO" type="DateTime" />
    
  </class>
</hibernate-mapping>