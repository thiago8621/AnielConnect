<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Tipo_Servico_Equipe" table="TB_TIPO_SERVICO_EQUIPE" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <property name="Cod_Tipo_Serv" column="COD_TIPO_SERV" type="Int32" />
    <property name="Descricao" column="DESCRICAO" type="String" length="150"/>
    <property name="Descricao_Aux" column="DESCRICAO_AUX" type="String" length="50" />
    <property name="Cod_Natureza" column="COD_NATUREZA" type="Int32"/>
    
  </class>
</hibernate-mapping>