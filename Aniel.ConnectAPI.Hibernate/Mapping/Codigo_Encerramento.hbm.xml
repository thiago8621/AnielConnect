<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Codigo_Encerramento" table="TB_CODIGO_ENCERRAMENTO" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <property name="Cod_Encerramento" column="COD_ENCERRAMENTO" type="String" length="6" />
    <property name="Descricao" column="DESCRICAO" type="String" length="95" />
    <property name="Status_Execucao" column="STATUS_EXECUCAO" type="Int16" />

    <many-to-one name="Contrato" class="Contrato, Aniel.Hibernate" column="ID_CONTRATO" foreign-key="fk_cencerramento_contrato" cascade="none"  />
  </class>
</hibernate-mapping>