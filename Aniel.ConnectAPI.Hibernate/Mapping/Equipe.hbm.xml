<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Equipe" table="TB_EQUIPE" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <property name="Matricula" column="MATRICULA" type="String" length="10" />
    <property name="EquipeAux" column="EQUIPEAUX" type="String" length="10" />
    <property name="Nome" column="NOME" type="String" length="50" />    
    <property name="Encerramento" column="ENCERRAMENTO" type="DateTime" />

    <many-to-one name="Funcionario" class="Funcionario" column="ID_FUNCIONARIO" foreign-key="fk_equipe_funcionario" cascade="none"  />
    <many-to-one name="Supervisor" class="Funcionario" column="ID_SUPERVISOR" foreign-key="fk_equipe_supervisor" cascade="none"  />
    <many-to-one name="Perfil_Equipe" class="Perfil_Equipe" column="ID_PERFIL_EQUIPE" foreign-key="fk_equipe_perfil" cascade="none"  />
    <many-to-one name="Regiao" class="Regiao" column="ID_REGIAO" foreign-key="fk_equipe_regiao" cascade="none"  />
  </class>
</hibernate-mapping>