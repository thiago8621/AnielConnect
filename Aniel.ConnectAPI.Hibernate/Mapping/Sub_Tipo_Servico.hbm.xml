<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Sub_Tipo_Servico" table="TB_SUB_TIPO_SERVICO" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    
    <property name="Codigo" column="COD_SUB_TIPO_SERV" type="String" length="6" />
    <property name="Descricao" column="DESCRICAO" type="String" length="70" />

    <many-to-one name="Tipo_Servico_Equipe" class="Tipo_Servico_Equipe" column="ID_TIPO_SERV" foreign-key="fk_subtipo_tiposerv" cascade="none"  />

  </class>
</hibernate-mapping>