<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Area" table="TB_AREA" lazy="false">

    <id name="Id" column="ID" type="Int64">
      <generator class="increment" />
    </id>

    <property name="Cod_Area" column="COD_AREA" type="String" length="4" />
    <property name="Descricao" column="DESCRICAO" type="String" length="20" />

    <many-to-one name="Escritorio" class="Escritorio" column="ID_ESCRITORIO" foreign-key="fk_area_escritorio" cascade="none"  />

  </class>
</hibernate-mapping>