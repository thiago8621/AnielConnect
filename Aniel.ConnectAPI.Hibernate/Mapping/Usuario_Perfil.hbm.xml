<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="Aniel.Hibernate" namespace="Aniel.Hibernate.Entity">
  <class name="Usuario_Perfil" table="TB_USUARIO_PERFIL" lazy="false">

    <id name="Id" column="ID" type="Int64">
    </id>

    <many-to-one name="Usuario_Aniel" class="Usuario" column="ID_USUARIO" foreign-key="fk_usuperfil_usuario" cascade="none"  />
    <many-to-one name="Perfil_Usuario" class="Perfil_Usuario" column="ID_PERFIL_USUARIO" foreign-key="fk_usuperfil_perfil" cascade="none"  />
    
  </class>
</hibernate-mapping>