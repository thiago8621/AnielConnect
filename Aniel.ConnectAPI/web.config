<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="aspNetCore" />
        <remove name="WebDAV" />
        <!-- I removed the following handlers too, but these
                 can probably be ignored for most installations -->
        <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
        <remove name="OPTIONSVerbHandler" />
        <remove name="TRACEVerbHandler" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModule" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />
    </system.webServer>
    <!--
      <system.webServer>
      <handlers>
        <add name="aspNetCore" path="C:\Program Files\dotnet" verb="*" modules="AspNetCoreModule" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="bin\IISSupport\VSIISExeLauncher.exe" arguments="-argFile IISExeLauncherArgs.txt" stdoutLogEnabled="true" stdoutLogFile=".\log\stdout">
        <environmentVariables />
      </aspNetCore>
     
    </system.webServer> -->
  </location>
  <log4net noNamespaceSchemaLocation="http://csharptest.net/downloads/schema/log4net.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <!-- loggers-->
    <logger name="Aniel.ConnectAPI">
      <level value="ERROR" />
      <appender-ref ref="LogErro" />
    </logger>
    <logger name="NHibernate">
      <level value="ERROR" />
      <appender-ref ref="LogSql" />
    </logger>
    <logger name="Sinapse">
      <level value="ERROR" />
      <appender-ref ref="LogErro" />
    </logger>
    <appender name="LogErro" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogErro.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    </appender>
    <appender name="LogSql" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log/LogSql.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{dd MMM yyyy HH:mm:ss}; %X{sessionId}; %X{trilha}; (%file:%line) [%t]; %-5p; %c; %m%n" />
      </layout>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    </appender>
  </log4net>
</configuration>